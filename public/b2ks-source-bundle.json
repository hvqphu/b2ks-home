Unlocked}:${r.isDisabled}:${r.wall}`).join('|') +\n          `|${wardrobeOpenedRoomId}|` +\n          state.members\n            .map((m) => `${m.roomWall || ''}:${JSON.stringify(m.roomSlots || {})}:${(m.roomDecor || []).map((d) => `${d.id}@${d.x},${d.y}`).join(',')}`)\n            .join(';')\n        : me.scene === 'private_room'\n          ? `${me.privateRoomId}|${wardrobeOpenedRoomId}|` +\n            JSON.stringify(state.members.find((m) => m.id === (houseRooms.find((r) => r.id === me.privateRoomId)?.ownerIds?.[0]))?.roomSlots || {}) +\n            '|' +\n            (state.members.find((m) => m.id === (houseRooms.find((r) => r.id === me.privateRoomId)?.ownerIds?.[0]))?.roomWall || '')\n          : `${locSig}|${state.house?.plotIndex}|${state.house?.style}|${state.familyName}|${weather?.condition}|${arcadeRoom?.status}|${soccerRoom?.status}`;\n    const worldSig = `${me.scene}|${lighting.phase}|${roomSig}`;\n\n    if (worldSig !== lastWorldSignature) {\n      lastWorldSignature = worldSig;\n      clearGroupChildren(worldGroup);\n      if (me.scene === 'neighborhood') {\n        worldGroup.add(buildNeighborhoodGroup(state, lighting, weather, locations, arcadeRoom, arcadeCatalog, soccerRoom));\n      } else if (me.scene === 'house') {\n        animatedProps.length = 0;\n        labelTargets.length = 0;\n        worldGroup.add(\n          buildHouseInterior3D(THREE, mats, textures, houseRooms, state, wardrobeOpenedRoomId, lighting.isNight, findAnyCatalogItem, roomDecorSlots)\n        );\n        houseRooms.forEach((r) => {\n          const isBedroomOrClosed = r.isDisabled || r.id === 'f2_parents' || (!r.id.startsWith('f1_') && !r.id.startsWith('f2_'));\n          labelTargets.push({\n            x: (r.x + r.w / 2) * WORLD_SCALE,\n            y: isBedroomOrClosed ? 3.85 : 3.6,\n            z: (isBedroomOrClosed ? r.y + r.h * 0.48 : r.y + 24) * WORLD_SCALE,\n            text: r.name + (r.isDisabled ? ' 🚫' : r.ownerIds?.length ? (r.isUnlocked ? ' 🔓' : ' 🔒') : ''),\n            kind: 'building',\n          });\n        });\n      } else {\n        animatedProps.length = 0;\n        labelTargets.length = 0;\n        const room = houseRooms.find((r) => r.id === (me.privateRoomId || '')) || null;\n        const ownerMember = (room && room.ownerIds && state.members.find((m) => m.id === room.ownerIds[0])) || null;\n        worldGroup.add(\n          buildPrivateRoom3D(THREE, mats, textures, room, houseRooms, ownerMember, wardrobeOpenedRoomId, lighting.isNight, roomDecorSlots, findAnyCatalogItem)\n        );\n        const exitX = room?.doorSide === 'right' ? 742 : 18;\n        labelTargets.push({ x: 68 * WORLD_SCALE, y: 2.2, z: 68 * WORLD_SCALE, text: '🛏️ Giường ngủ', kind: 'building' });\n        labelTargets.push({ x: 706 * WORLD_SCALE, y: 4.5, z: 46 * WORLD_SCALE, text: '🧥 Tủ quần áo', kind: 'building' });\n        labelTargets.push({ x: exitX * WORLD_SCALE, y: 2.2, z: 310 * WORLD_SCALE, text: '🚪 Ra hành lang', kind: 'building' });\n      }\n    }\n\n    // 2. Animate world props (trees, portal, fountain spray, soccer ball, barber pole)\n    animatedProps.forEach((obj) => {\n      if (obj.userData.canopy) {\n        obj.userData.canopy.rotation.z = Math.sin(nowMs * 0.0016 + (obj.userData.swayPhase || 0)) * 0.04;\n      }\n      if (obj.userData.portalRing) {\n        obj.userData.portalRing.rotation.z = nowMs * 0.0018;\n      }\n      if (obj.userData.floatingEgg) {\n        obj.userData.floatingEgg.position.y = 5.85 + Math.sin(nowMs * 0.003) * 0.18;\n        obj.userData.floatingEgg.rotation.y = nowMs * 0.0012;\n      }\n      if (obj.userData.floatingCrystal) {\n        obj.userData.floatingCrystal.position.y = 6.45 + Math.sin(nowMs * 0.0028) * 0.22;\n        obj.userData.floatingCrystal.rotation.y = nowMs * 0.0018;\n      }\n      if (obj.userData.beacon) {\n        obj.userData.beacon.scale.setScalar(1 + Math.sin(nowMs * 0.006) * 0.18);\n      }\n      if (obj.userData.barberPole) {\n        obj.userData.barberPole.rotation.y = nowMs * 0.005;\n      }\n      if (obj.userData.waterSpray) {\n        obj.userData.waterSpray.position.y = 5.45 + Math.sin(nowMs * 0.008) * 0.24;\n        obj.userData.waterSpray.scale.setScalar(0.92 + Math.sin(nowMs * 0.01) * 0.16);\n      }\n      if (obj.userData.waterDroplets) {\n        obj.userData.waterDroplets.forEach((drop) => {\n          const ud = drop.userData;\n          const cyc = ((nowMs * 0.0014 + ud.phase) % 1 + 1) % 1;\n          drop.position.set(\n            Math.cos(ud.ang) * (ud.radius + cyc * 1.15),\n            0.85 + Math.sin(cyc * Math.PI) * 3.1,\n            Math.sin(ud.ang) * (ud.radius + cyc * 1.15)\n          );\n          drop.scale.setScalar(0.65 + (1 - Math.abs(cyc - 0.5) * 2) * 0.55);\n        });\n      }\n      if (obj.userData.waterRipples) {\n        obj.userData.waterRipples.forEach((ring) => {\n          const s = 0.88 + (((nowMs * 0.0008 + ring.userData.phase) % 1) * 0.35);\n          ring.scale.setScalar(s);\n        });\n      }\n      if (obj.userData.butterflies) {\n        obj.userData.butterflies.forEach((bf) => {\n          const ud = bf.userData;\n          const t = nowMs * 0.0016 + ud.angle;\n          bf.position.set(Math.cos(t) * ud.radius, ud.baseY + Math.sin(t * 2.4) * 0.32, Math.sin(t) * ud.radius);\n          bf.rotation.y = -t;\n          if (bf.children[0] && bf.children[1]) {\n            const fl = Math.sin(nowMs * 0.022 + ud.angle) * 0.65;\n            bf.children[0].rotation.z = fl;\n            bf.children[1].rotation.z = -fl;\n          }\n        });\n      }\n      if (obj.userData.soccerBall) {\n        obj.userData.soccerBall.position.x = Math.sin(nowMs * 0.0025) * 1.6;\n        obj.userData.soccerBall.position.y = 0.45 + Math.abs(Math.sin(nowMs * 0.005)) * 0.25;\n      }\n    });\n\n    // 3. Update & render 3D Vehicles + Pedestrians in neighborhood\n    const inNeighborhood = me.scene === 'neighborhood';\n    vehiclesGroup.visible = inNeighborhood;\n    pedestriansGroup.visible = inNeighborhood;\n    if (inNeighborhood) {\n      if (lastVehicleNightState !== Boolean(lighting.isNight)) {\n        lastVehicleNightState = Boolean(lighting.isNight);\n        vehicleMeshes.forEach((vm) => vehiclesGroup.remove(vm));\n        vehicleMeshes.clear();\n      }\n      streetCars.forEach((car, idx) => {\n        if (car.axis === 'h') {\n          car.x += car.speed;\n          if (car.x > STREET_WORLD.width + 110) car.x = -110;\n          if (car.x < -110) car.x = STREET_WORLD.width + 110;\n        } else {\n          car.y += car.speed;\n          if (car.y > STREET_WORLD.height + 110) car.y = 220;\n          if (car.y < 220) car.y = STREET_WORLD.height + 110;\n        }\n        const key = `car_${idx}`;\n        let mesh = vehicleMeshes.get(key);\n        if (!mesh) {\n          mesh = buildVehicle3D(THREE, mats, car, Boolean(lighting.isNight));\n          vehicleMeshes.set(key, mesh);\n          vehiclesGroup.add(mesh);\n        }\n        mesh.position.set(car.x * WORLD_SCALE, 0.17, car.y * WORLD_SCALE);\n        mesh.rotation.y = car.axis === 'h' ? (car.dir > 0 ? 0 : Math.PI) : car.dir > 0 ? -Math.PI / 2 : Math.PI / 2;\n      });\n\n      // Update Sidewalk Pedestrians\n      pedestrianEntries.forEach(({ mesh, route, phaseOffset }) => {\n        if (route.axis === 'h') {\n          route.x += route.dir * route.speed * deltaSec;\n          if (route.x > route.max) {\n            route.x = route.max;\n            route.dir = -1;\n          } else if (route.x < route.min) {\n            route.x = route.min;\n            route.dir = 1;\n          }\n          mesh.userData.targetYaw = route.dir > 0 ? Math.PI / 2 : -Math.PI / 2;\n        } else {\n          route.y += route.dir * route.speed * deltaSec;\n          if (route.y > route.max) {\n            route.y = route.max;\n            route.dir = -1;\n          } else if (route.y < route.min) {\n            route.y = route.min;\n            route.dir = 1;\n          }\n          mesh.userData.targetYaw = route.dir > 0 ? 0 : Math.PI;\n        }\n        mesh.position.set(route.x * WORLD_SCALE, 0.08, route.y * WORLD_SCALE);\n        const ud = mesh.userData;\n        let diff = ud.targetYaw - ud.currentYaw;\n        while (diff > Math.PI) diff -= Math.PI * 2;\n        while (diff < -Math.PI) diff += Math.PI * 2;\n        ud.currentYaw += diff * Math.min(1, deltaSec * 10);\n        ud.bodyRoot.rotation.y = ud.currentYaw;\n        const walkPhase = nowMs * 0.011 + phaseOffset;\n        const swing = Math.sin(walkPhase) * 0.55;\n        ud.leftLegPivot.rotation.x = swing;\n        ud.rightLegPivot.rotation.x = -swing;\n        ud.leftArmPivot.rotation.x = -swing * 0.78;\n        ud.rightArmPivot.rotation.x = swing * 0.78;\n        ud.upperGroup.position.y = 0.48 + Math.abs(Math.sin(walkPhase)) * 0.07;\n      });\n    }\n\n    // 4. Sync 3D Chibi Characters & Companion Pets\n    const visibleMembers = state.members.filter((m) => {\n      if (m.scene !== me.scene) return false;\n      if (me.scene === 'private_room') {\n        return (m.privateRoomId || null) === (me.privateRoomId || null);\n      }\n      return true;\n    });\n    const visibleIds = new Set(visibleMembers.map((m) => m.id));\n\n    memberMeshes.forEach((entry, id) => {\n      if (!visibleIds.has(id)) {\n        actorsGroup.remove(entry.mesh);\n        memberMeshes.delete(id);\n      }\n    });\n    petMeshes.forEach((entry, id) => {\n      if (!visibleIds.has(id)) {\n        actorsGroup.remove(entry.mesh);\n        petMeshes.delete(id);\n      }\n    });\n\n    const dynamicLabels = [];\n\n    visibleMembers.forEach((m) => {\n      const appearanceSig = `${m.role}|${m.hairStyle}|${m.hairColor}|${m.shirtColor}|${m.shirtPattern}|${m.pantsColor}|${m.pantsStyle}|${m.outfit}|${m.id === me.id}`;\n      let entry = memberMeshes.get(m.id);\n      if (!entry || entry.sig !== appearanceSig) {\n        if (entry) actorsGroup.remove(entry.mesh);\n        const charMesh = buildChibiCharacter3D(THREE, mats, textures.shadowTex, m, m.id === me.id);\n        charMesh.position.set(m.x * WORLD_SCALE, 0.1, m.y * WORLD_SCALE);\n        actorsGroup.add(charMesh);\n        entry = { mesh: charMesh, sig: appearanceSig, prevX: m.x, prevY: m.y };\n        memberMeshes.set(m.id, entry);\n      }\n\n      const targetX = m.x * WORLD_SCALE;\n      const targetZ = m.y * WORLD_SCALE;\n      const moveDX = m.x - entry.prevX;\n      const moveDY = m.y - entry.prevY;\n      entry.prevX = m.x;\n      entry.prevY = m.y;\n\n      // Smoothly position & rotate Chibi to face movement direction!\n      entry.mesh.position.x = THREE.MathUtils.damp(entry.mesh.position.x, targetX, 20, deltaSec);\n      entry.mesh.position.z = THREE.MathUtils.damp(entry.mesh.position.z, targetZ, 20, deltaSec);\n      entry.mesh.position.y = me.scene === 'neighborhood' ? 0.08 : 0.1;\n\n      const ud = entry.mesh.userData;\n      const isMoving = Boolean(memberMovingMap.get(m.id));\n      if (Math.hypot(moveDX, moveDY) > 0.05) {\n        ud.targetYaw = Math.atan2(moveDX, moveDY);\n      } else {\n        if (m.dir === 'left') ud.targetYaw = -Math.PI / 2;\n        else if (m.dir === 'right') ud.targetYaw = Math.PI / 2;\n        else if (m.dir === 'up') ud.targetYaw = Math.PI;\n        else ud.targetYaw = 0;\n      }\n\n      // Shortest-angle yaw damping\n      let diff = ud.targetYaw - ud.currentYaw;\n      while (diff > Math.PI) diff -= Math.PI * 2;\n      while (diff < -Math.PI) diff += Math.PI * 2;\n      ud.currentYaw += diff * Math.min(1, deltaSec * 14);\n      ud.bodyRoot.rotation.y = ud.currentYaw;\n\n      // Walk cycle or gentle idle breathing\n      if (isMoving) {\n        const phase = nowMs * 0.015;\n        const swing = Math.sin(phase) * 0.65;\n        ud.leftLegPivot.rotation.x = swing;\n        ud.rightLegPivot.rotation.x = -swing;\n        ud.leftArmPivot.rotation.x = -swing * 0.85;\n        ud.rightArmPivot.rotation.x = swing * 0.85;\n        ud.upperGroup.position.y = 0.48 + Math.abs(Math.sin(phase)) * 0.09;\n      } else {\n        ud.leftLegPivot.rotation.x = THREE.MathUtils.damp(ud.leftLegPivot.rotation.x, 0, 12, deltaSec);\n        ud.rightLegPivot.rotation.x = THREE.MathUtils.damp(ud.rightLegPivot.rotation.x, 0, 12, deltaSec);\n        ud.leftArmPivot.rotation.x = THREE.MathUtils.damp(ud.leftArmPivot.rotation.x, 0, 12, deltaSec);\n        ud.rightArmPivot.rotation.x = THREE.MathUtils.damp(ud.rightArmPivot.rotation.x, 0, 12, deltaSec);\n        ud.upperGroup.position.y = 0.48 + Math.sin(nowMs * 0.003 + m.x) * 0.025;\n      }\n\n      dynamicLabels.push({\n        x: entry.mesh.position.x,\n        y: entry.mesh.position.y + 2.45,\n        z: entry.mesh.position.z,\n        text: m.name,\n        kind: m.id === me.id ? 'name-me' : 'name',\n      });\n      if (m.speech && nowMs < m.speech.expiresAt) {\n        dynamicLabels.push({\n          x: entry.mesh.position.x,\n          y: entry.mesh.position.y + 3.05,\n          z: entry.mesh.position.z,\n          text: m.speech.isEng ? `${m.speech.text} (+5⭐)` : m.speech.text,\n          kind: m.speech.isEng ? 'speech-eng' : 'speech',\n        });\n      }\n\n      // Companion Pet 3D\n      const pet = getPetForMember(m);\n      if (pet) {\n        const sp = getPetSpecies(pet.speciesId);\n        const col = getPetResolvedColors(sp, pet.variant);\n        const petSig = `${pet.id}|${pet.speciesId}|${pet.stage}|${pet.hatched}|${pet.variant}|${pet.accessoryId}`;\n        let pEntry = petMeshes.get(m.id);\n        if (!pEntry || pEntry.sig !== petSig) {\n          if (pEntry) actorsGroup.remove(pEntry.mesh);\n          const pm = buildPet3D(THREE, mats, textures.shadowTex, pet, sp, col);\n          pm.position.set(entry.mesh.position.x - 1.2, 0.08, entry.mesh.position.z + 0.6);\n          actorsGroup.add(pm);\n          pEntry = { mesh: pm, sig: petSig };\n          petMeshes.set(m.id, pEntry);\n        }\n        const followAngle = ud.currentYaw + Math.PI * 0.72;\n        const pTargetX = entry.mesh.position.x + Math.sin(followAngle) * 1.45;\n        const pTargetZ = entry.mesh.position.z + Math.cos(followAngle) * 1.45;\n        const pdx = pTargetX - pEntry.mesh.position.x;\n        const pdz = pTargetZ - pEntry.mesh.position.z;\n        pEntry.mesh.position.x = THREE.MathUtils.damp(pEntry.mesh.position.x, pTargetX, 7, deltaSec);\n        pEntry.mesh.position.z = THREE.MathUtils.damp(pEntry.mesh.position.z, pTargetZ, 7, deltaSec);\n        if (Math.hypot(pdx, pdz) > 0.03) {\n          pEntry.mesh.userData.actor.rotation.y = Math.atan2(pdx, pdz);\n        }\n        const pud = pEntry.mesh.userData;\n        const bounce = isMoving ? Math.abs(Math.sin(nowMs * 0.012)) * 0.25 : Math.sin(nowMs * 0.004) * 0.08;\n        pud.actor.position.y = bounce;\n        if (pud.leftWingPivot && pud.rightWingPivot) {\n          const spd = pud.leftWingPivot.userData.flapSpeed || 0.009;\n          const amp = pud.leftWingPivot.userData.flapAmp || 0.24;\n          const fl = Math.sin(nowMs * spd) * amp;\n          pud.leftWingPivot.rotation.z = (pud.leftWingPivot.userData.baseZ || 0) - fl;\n          pud.rightWingPivot.rotation.z = (pud.rightWingPivot.userData.baseZ || 0) + fl;\n        }\n        if (pud.variantOrbit) {\n          pud.variantOrbit.rotation.y = nowMs * 0.0018;\n        }\n        if (pud.variantWheel) {\n          pud.variantWheel.rotation.z = nowMs * 0.0014;\n        }\n        if (pud.auraRing) {\n          pud.auraRing.rotation.z = nowMs * 0.0022;\n          pud.auraRing.scale.setScalar(1 + Math.sin(nowMs * 0.005) * 0.08);\n        }\n      } else if (petMeshes.has(m.id)) {\n        actorsGroup.remove(petMeshes.get(m.id).mesh);\n        petMeshes.delete(m.id);\n      }\n    });\n\n    // 4b. Sync Roaming Foreign NPCs (Mr. Alex & Ms. Emma) in neighborhood\n    const visibleNpcs = me.scene === 'neighborhood' && Array.isArray(foreignNpcs) ? foreignNpcs : [];\n    const visibleNpcIds = new Set(visibleNpcs.map((n) => n.id));\n    foreignNpcMeshes.forEach((entry, id) => {\n      if (!visibleNpcIds.has(id)) {\n        actorsGroup.remove(entry.mesh);\n        foreignNpcMeshes.delete(id);\n      }\n    });\n    visibleNpcs.forEach((npc) => {\n      let nEntry = foreignNpcMeshes.get(npc.id);\n      if (!nEntry) {\n        const nm = buildForeignNpc3D(THREE, mats, textures.shadowTex, npc);\n        nm.position.set(npc.x * WORLD_SCALE, 0.08, npc.y * WORLD_SCALE);\n        actorsGroup.add(nm);\n        nEntry = { mesh: nm };\n        foreignNpcMeshes.set(npc.id, nEntry);\n      }\n      nEntry.mesh.position.x = THREE.MathUtils.damp(nEntry.mesh.position.x, npc.x * WORLD_SCALE, 16, deltaSec);\n      nEntry.mesh.position.z = THREE.MathUtils.damp(nEntry.mesh.position.z, npc.y * WORLD_SCALE, 16, deltaSec);\n      nEntry.mesh.position.y = 0.08;\n      const ud = nEntry.mesh.userData;\n      ud.targetYaw = typeof npc.facingYaw === 'number' ? npc.facingYaw : 0;\n      let ndiff = ud.targetYaw - ud.currentYaw;\n      while (ndiff > Math.PI) ndiff -= Math.PI * 2;\n      while (ndiff < -Math.PI) ndiff += Math.PI * 2;\n      ud.currentYaw += ndiff * Math.min(1, deltaSec * 12);\n      ud.bodyRoot.rotation.y = ud.currentYaw;\n      if (npc.isMoving) {\n        const phase = nowMs * 0.012;\n        const swing = Math.sin(phase) * 0.55;\n        ud.leftLegPivot.rotation.x = swing;\n        ud.rightLegPivot.rotation.x = -swing;\n        ud.leftArmPivot.rotation.x = -swing * 0.75;\n        ud.rightArmPivot.rotation.x = swing * 0.75;\n      } else {\n        ud.leftLegPivot.rotation.x = THREE.MathUtils.damp(ud.leftLegPivot.rotation.x, 0, 12, deltaSec);\n        ud.rightLegPivot.rotation.x = THREE.MathUtils.damp(ud.rightLegPivot.rotation.x, 0, 12, deltaSec);\n        ud.leftArmPivot.rotation.x = THREE.MathUtils.damp(ud.leftArmPivot.rotation.x, 0, 12, deltaSec);\n        ud.rightArmPivot.rotation.x = -2.2 + Math.sin(nowMs * 0.01) * 0.35;\n      }\n      dynamicLabels.push({\n        x: nEntry.mesh.position.x,\n        y: nEntry.mesh.position.y + 2.55,\n        z: nEntry.mesh.position.z,\n        text: `${npc.gender === 'female' ? '👩‍🏫' : '👨‍🏫'} ${npc.name}`,\n        kind: 'name',\n      });\n      dynamicLabels.push({\n        x: nEntry.mesh.position.x,\n        y: nEntry.mesh.position.y + 3.15,\n        z: nEntry.mesh.position.z,\n        text: npc.speechText || 'Speak to me! 💬',\n        kind: 'speech-eng',\n      });\n    });\n\n    // 4c. Sync Child Helper Robots (follow active schedule with raised scrolling sign, or rest in private room)\n    const visibleRobots = Array.isArray(helperRobots)\n      ? helperRobots.filter((r) => {\n          if (r.scene !== me.scene) return false;\n          if (me.scene === 'private_room') return (r.privateRoomId || null) === (me.privateRoomId || null);\n          return true;\n        })\n      : [];\n    const visibleRobotKeys = new Set(visibleRobots.map((r) => r.childId));\n    helperRobotMeshes.forEach((entry, cid) => {\n      if (!visibleRobotKeys.has(cid)) {\n        actorsGroup.remove(entry.mesh);\n        helperRobotMeshes.delete(cid);\n      }\n    });\n    visibleRobots.forEach((r) => {\n      const bTex = getOrCreateRobotBannerTex(r.childId, r.reminderText);\n      bTex.offset.x = (nowMs * 0.00028) % 1;\n      let rEntry = helperRobotMeshes.get(r.childId);\n      if (!rEntry || rEntry.skin !== r.skin) {\n        if (rEntry) actorsGroup.remove(rEntry.mesh);\n        const rm = buildHelperRobot3D(THREE, mats, textures.shadowTex, r.skin, bTex);\n        rm.position.set(r.x * WORLD_SCALE, 0.08, r.y * WORLD_SCALE);\n        actorsGroup.add(rm);\n        rEntry = { mesh: rm, skin: r.skin };\n        helperRobotMeshes.set(r.childId, rEntry);\n      }\n      rEntry.mesh.position.x = THREE.MathUtils.damp(rEntry.mesh.position.x, r.x * WORLD_SCALE, 14, deltaSec);\n      rEntry.mesh.position.z = THREE.MathUtils.damp(rEntry.mesh.position.z, r.y * WORLD_SCALE, 14, deltaSec);\n      rEntry.mesh.position.y = me.scene === 'neighborhood' ? 0.08 : 0.1;\n\n      const ud = rEntry.mesh.userData;\n      const targetYaw = typeof r.facingYaw === 'number' ? r.facingYaw : 0.35;\n      let curYaw = typeof ud.currentYaw === 'number' ? ud.currentYaw : targetYaw;\n      let yawDiff = targetYaw - curYaw;\n      while (yawDiff > Math.PI) yawDiff -= Math.PI * 2;\n      while (yawDiff < -Math.PI) yawDiff += Math.PI * 2;\n      curYaw += yawDiff * Math.min(1, deltaSec * 10);\n      ud.currentYaw = curYaw;\n      ud.actor.rotation.y = curYaw;\n\n      const movingNow = Boolean(r.isMoving);\n      ud.actor.position.y = movingNow\n        ? Math.abs(Math.sin(nowMs * 0.011)) * 0.14\n        : r.isFollowing\n          ? Math.abs(Math.sin(nowMs * 0.0065)) * 0.07\n          : Math.sin(nowMs * 0.003) * 0.04;\n      ud.actor.rotation.z = movingNow ? Math.sin(nowMs * 0.011) * 0.05 : 0;\n      ud.actor.rotation.x = THREE.MathUtils.damp(ud.actor.rotation.x || 0, movingNow ? 0.075 : 0, 10, deltaSec);\n\n      if (ud.propeller) {\n        ud.propeller.rotation.y += deltaSec * (movingNow ? 16 : r.isFollowing ? 11 : 4.5);\n      }\n      if (ud.ribbonBow) {\n        ud.ribbonBow.rotation.z = Math.sin(nowMs * (movingNow ? 0.011 : 0.0045)) * (movingNow ? 0.14 : 0.06);\n      }\n      ud.bannerHolder.visible = Boolean(r.isFollowing && r.reminderText);\n      // Keep floating reminder board cleanly facing camera while robot turns behind character\n      ud.bannerHolder.rotation.y = camState.yaw - curYaw;\n\n      const walkSwing = movingNow ? Math.sin(nowMs * 0.011) * 0.42 : 0;\n      const targetLeftArmX = r.isFollowing ? -2.55 : walkSwing;\n      const targetRightArmX = r.isFollowing ? -2.55 : -walkSwing;\n      ud.leftArmPivot.rotation.x = THREE.MathUtils.damp(ud.leftArmPivot.rotation.x, targetLeftArmX, 12, deltaSec);\n      ud.rightArmPivot.rotation.x = THREE.MathUtils.damp(ud.rightArmPivot.rotation.x, targetRightArmX, 12, deltaSec);\n\n      dynamicLabels.push({\n        x: rEntry.mesh.position.x,\n        y: rEntry.mesh.position.y + (r.isFollowing ? 3.08 : 2.32),\n        z: rEntry.mesh.position.z,\n        text: `🤖 Robot (${r.childName})`,\n        kind: 'name',\n      });\n    });\n\n    // 5. Tap-to-move visual marker animation\n    if (tapTarget) {\n      tapMarker.visible = true;\n      tapMarker.position.set(tapTarget.x * WORLD_SCALE, 0.02, tapTarget.y * WORLD_SCALE);\n      const pulse = 0.85 + Math.sin(nowMs * 0.01) * 0.18;\n      tapRing.scale.setScalar(pulse);\n      tapDiamond.position.y = 0.85 + Math.sin(nowMs * 0.008) * 0.22;\n      tapDiamond.rotation.y = nowMs * 0.004;\n    } else {\n      tapMarker.visible = false;\n    }\n\n    // 6. Camera follow + smooth exponential damping (Isometric 45° or Perspective XCity)\n    const followX = me.x * WORLD_SCALE + camState.panX;\n    const followZ = me.y * WORLD_SCALE + camState.panZ;\n    camState.targetX = THREE.MathUtils.damp(camState.targetX, followX, 10, deltaSec);\n    camState.targetZ = THREE.MathUtils.damp(camState.targetZ, followZ, 10, deltaSec);\n    camState.yaw = THREE.MathUtils.damp(camState.yaw, camState.targetYaw, 10, deltaSec);\n    camState.pitch = THREE.MathUtils.damp(camState.pitch, camState.targetPitch, 10, deltaSec);\n    camState.zoom = THREE.MathUtils.damp(camState.zoom, camState.targetZoom, 12, deltaSec);\n\n    const activeCamera = getActiveCamera();\n    if (camState.mode === 'ortho' && Math.abs(orthoCamera.zoom - camState.zoom) > 0.001) {\n      orthoCamera.zoom = camState.zoom;\n      orthoCamera.updateProjectionMatrix();\n    }\n\n    const inInterior = me.scene !== 'neighborhood';\n    const effectivePitch =\n      camState.mode === 'perspective' && inInterior ? Math.max(0.58, camState.pitch) : camState.pitch;\n    const camDist =\n      camState.mode === 'perspective'\n        ? (inInterior ? 32 : 38) / Math.max(0.45, camState.zoom)\n        : 90;\n    const cosP = Math.cos(effectivePitch);\n    activeCamera.position.set(\n      camState.targetX + camDist * cosP * Math.sin(camState.yaw),\n      camDist * Math.sin(effectivePitch),\n      camState.targetZ + camDist * cosP * Math.cos(camState.yaw)\n    );\n    activeCamera.lookAt(camState.targetX, camState.mode === 'perspective' ? 1.45 : 0.8, camState.targetZ);\n\n    // Keep Sky Dome centered around camera look target so horizon & stars never clip\n    skyDome.mesh.position.set(camState.targetX, -2, camState.targetZ);\n\n    // Anchor DirectionalLight shadow frustum around camera target so soft shadows stay razor-sharp everywhere!\n    sunLight.position.set(camState.targetX + 36, 48, camState.targetZ + 30);\n    sunLight.target.position.set(camState.targetX, 0, camState.targetZ);\n    sunLight.target.updateMatrixWorld();\n\n    // Update dynamic real PointLights for streetlamps, buildings, cars, player, and cozy interiors\n    const nightBoost = lighting.phase === 'night' ? 1.0 : lighting.isNight ? 0.65 : 0.0;\n    if (inNeighborhood && nightBoost > 0) {\n      const refX = camState.targetX;\n      const refZ = camState.targetZ;\n\n      const nearestLamps = nightLampAnchors\n        .map((a) => ({ a, d2: (a.x - refX) * (a.x - refX) + (a.z - refZ) * (a.z - refZ) }))\n        .filter((x) => x.d2 < 2400)\n        .sort((x, y) => x.d2 - y.d2);\n      lampPointLights.forEach((pl, idx) => {\n        const pick = nearestLamps[idx];\n        if (pick) {\n          pl.position.set(pick.a.x, pick.a.y, pick.a.z);\n          pl.intensity = 22 * nightBoost;\n        } else {\n          pl.intensity = 0;\n        }\n      });\n\n      const nearestBuildings = nightBuildingAnchors\n        .map((a) => ({ a, d2: (a.x - refX) * (a.x - refX) + (a.z - refZ) * (a.z - refZ) }))\n        .filter((x) => x.d2 < 2600)\n        .sort((x, y) => x.d2 - y.d2);\n      buildingPointLights.forEach((pl, idx) => {\n        const pick = nearestBuildings[idx];\n        if (pick) {\n          pl.color.set(pick.a.color);\n          pl.position.set(pick.a.x, pick.a.y, pick.a.z);\n          pl.intensity = pick.a.intensity * nightBoost;\n        } else {\n          pl.intensity = 0;\n        }\n      });\n\n      const nearestCars = streetCars\n        .filter((c) => c.kind !== 'bike')\n        .map((c) => {\n          const cx = c.x * WORLD_SCALE;\n          const cz = c.y * WORLD_SCALE;\n          return { c, cx, cz, d2: (cx - refX) * (cx - refX) + (cz - refZ) * (cz - refZ) };\n        })\n        .filter((x) => x.d2 < 2400)\n        .sort((x, y) => x.d2 - y.d2);\n      carPointLights.forEach((pl, idx) => {\n        const pick = nearestCars[idx];\n        if (pick) {\n          const aheadX = pick.cx + (pick.c.axis === 'h' ? pick.c.dir * 2.8 : 0);\n          const aheadZ = pick.cz + (pick.c.axis === 'v' ? pick.c.dir * 2.8 : 0);\n          pl.position.set(aheadX, 1.05, aheadZ);\n          pl.intensity = 16 * nightBoost;\n        } else {\n          pl.intensity = 0;\n        }\n      });\n\n      playerNightLight.position.set(me.x * WORLD_SCALE, 2.4, me.y * WORLD_SCALE);\n      playerNightLight.intensity = 2.4 * nightBoost;\n      interiorPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n    } else if (!inNeighborhood && lighting.isNight) {\n      lampPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n      buildingPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n      carPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n      playerNightLight.intensity = 0;\n      if (me.scene === 'house') {\n        interiorPointLights[0].color.set('#FFE4A0');\n        interiorPointLights[0].position.set(28, 7.5, 16);\n        interiorPointLights[0].intensity = 22;\n        interiorPointLights[1].color.set('#FFD98A');\n        interiorPointLights[1].position.set(28, 7.5, 31);\n        interiorPointLights[1].intensity = 22;\n      } else {\n        interiorPointLights[0].color.set('#FFE082');\n        interiorPointLights[0].position.set(6.82, 3.2, 2.2);\n        interiorPointLights[0].intensity = 16;\n        interiorPointLights[1].color.set('#FFE8B3');\n        interiorPointLights[1].position.set(20, 6.2, 11);\n        interiorPointLights[1].intensity = 14;\n      }\n    } else {\n      lampPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n      buildingPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n      carPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n      playerNightLight.intensity = 0;\n      interiorPointLights.forEach((pl) => {\n        pl.intensity = 0;\n      });\n    }\n\n    // Update weather particles around camera target\n    if (weatherParticles.length > 0) {\n      weatherGroup.position.set(camState.targetX, 0, camState.targetZ);\n      weatherParticles.forEach((wp) => {\n        if (weatherMode === 'rain' || weatherMode === 'thunder') {\n          wp.mesh.position.y -= deltaSec * 22;\n          if (wp.mesh.position.y < 0.2) wp.mesh.position.y = 16;\n        } else if (weatherMode === 'snow') {\n          wp.mesh.position.y -= deltaSec * 2.5;\n          wp.mesh.position.x += Math.sin(nowMs * 0.002 + wp.offset) * deltaSec * 0.8;\n          if (wp.mesh.position.y < 0.2) wp.mesh.position.y = 16;\n        } else if (weatherMode === 'fireflies') {\n          wp.mesh.position.y = 1.6 + Math.sin(nowMs * 0.003 + wp.offset) * 0.9;\n        }\n      });\n    }\n\n    renderer.render(scene, activeCamera);\n\n    // 7. Project 3D floating labels cleanly onto HTML overlay\n    if (labelLayerEl) {\n      const allLabels = [...labelTargets, ...dynamicLabels];\n      const viewW = window.innerWidth;\n      const viewH = window.innerHeight;\n      while (labelLayerEl.children.length < allLabels.length) {\n        const el = document.createElement('div');\n        el.className = 'world-float-label';\n        labelLayerEl.appendChild(el);\n      }\n      for (let i = 0; i < labelLayerEl.children.length; i++) {\n        const el = labelLayerEl.children[i];\n        if (i >= allLabels.length) {\n          el.style.display = 'none';\n          continue;\n        }\n        const lbl = allLabels[i];\n        projVec.set(lbl.x, lbl.y, lbl.z).project(activeCamera);\n        if (projVec.z > 1 || projVec.x < -1.15 || projVec.x > 1.15 || projVec.y < -1.15 || projVec.y > 1.15) {\n          el.style.display = 'none';\n          continue;\n        }\n        const sx = (projVec.x * 0.5 + 0.5) * viewW;\n        const sy = (-projVec.y * 0.5 + 0.5) * viewH;\n        el.style.display = 'block';\n        el.style.left = `${sx.toFixed(1)}px`;\n        el.style.top = `${sy.toFixed(1)}px`;\n        if (el.textContent !== lbl.text) el.textContent = lbl.text;\n        const cls =\n          lbl.kind === 'name-me'\n            ? 'world-float-label world-name-pill me'\n            : lbl.kind === 'name'\n              ? 'world-float-label world-name-pill'\n              : lbl.kind === 'speech-eng'\n                ? 'world-float-label world-speech-bubble eng'\n                : lbl.kind === 'speech'\n                  ? 'world-float-label world-speech-bubble'\n                  : lbl.kind === 'live'\n                    ? 'world-float-label world-live-banner'\n                    : lbl.kind === 'lobby'\n                      ? 'world-float-label world-live-banner lobby'\n                      : 'world-float-label world-building-sign';\n        if (el.className !== cls) el.className = cls;\n      }\n    }\n  }\n\n  function setCameraMode(nextMode) {\n    const resolved = nextMode === 'perspective' ? 'perspective' : 'ortho';\n    camState.mode = resolved;\n    camState.targetPitch = resolved === 'perspective' ? 0.5 : Math.PI / 4;\n    try {\n      if (typeof localStorage !== 'undefined') {\n        localStorage.setItem(CAMERA_MODE_STORAGE_KEY, resolved);\n      }\n    } catch {\n      // ignore\n    }\n    resize();\n    return resolved;\n  }\n\n  return {\n    THREE,\n    camState,\n    resize,\n    raycastGround,\n    renderFrame,\n    getCameraMode() {\n      return camState.mode;\n    },\n    setCameraMode,\n    toggleCameraMode() {\n      return setCameraMode(camState.mode === 'perspective' ? 'ortho' : 'perspective');\n    },\n    setZoom(nextZoom) {\n      camState.targetZoom = Math.max(0.55, Math.min(2.2, nextZoom));\n    },\n    resetCamera() {\n      camState.targetYaw = Math.PI / 4;\n      camState.targetPitch = camState.mode === 'perspective' ? 0.5 : Math.PI / 4;\n      camState.panX = 0;\n      camState.panZ = 0;\n      camState.targetZoom = 1.0;\n    },\n    dispose() {\n      mats.disposeAll();\n      Object.values(textures).forEach((t) => t.dispose());\n      skyDome.mesh.geometry.dispose();\n      skyDome.mat.dispose();\n      leaderTex.dispose();\n      ledAdTex.dispose();\n      billboardHeaderTex.dispose();\n      robotBannerCache.forEach((b) => b.tex.dispose());\n      robotBannerCache.clear();\n      _petGeoCache.forEach((g) => g.dispose());\n      _petGeoCache.clear();\n      renderer.dispose();\n    },\n  };\n}\n"},{"path":"src/game/soccerGame.ts","encoding":"utf8","content":"import {\n  B2KSState,\n  Member,\n  PenaltyPickPayload,\n  PenaltyZoneId,\n  SoccerOnlineRoom,\n  SoccerPlayerInput\n} from '../types/b2ks';\nimport {\n  formatFamilyBrand,\n  getFamilyFirebaseRoot,\n  normalizeFamilySlug,\n  resolveNeighborhoodLocations\n} from './constants';\nimport { drawDetailedChibiOnContext } from './worldRenderer';\n\nexport interface SoccerEngineDeps {\n  getState: () => B2KSState;\n  getCurrentUser: () => Member;\n  getFirebaseUrl: () => string;\n  playClick: () => void;\n  playCoin: () => void;\n  playSuccess: () => void;\n  playError: () => void;\n  triggerConfetti: () => void;\n  triggerSpeechBubble: (member: Member, text: string, isEng: boolean) => void;\n  showToast: (msg: string) => void;\n  openModal?: (id: string) => void;\n  closeModal?: (id: string) => void;\n}\n\nconst LOCAL_SOCCER_ROOM_KEY = 'b2ks_soccer_online_room';\nconst LOCAL_PEN_SHOT_KEY = 'b2ks_soccer_pen_shot';\nconst LOCAL_PEN_SAVE_KEY = 'b2ks_soccer_pen_save';\n\nconst PENALTY_ZONES: Array<{\n  id: PenaltyZoneId;\n  label: string;\n  shortLabel: string;\n  icon: string;\n  gx: number;\n  gy: number;\n  kx: number;\n  ky: number;\n  diveTilt: number;\n}> = [\n  { id: 'TL', label: 'Trái Cao', shortLabel: 'Trái Cao', icon: '↖️', gx: 145, gy: 58, kx: 158, ky: 74, diveTilt: -0.75 },\n  { id: 'BL', label: 'Trái Sệt', shortLabel: 'Trái Sệt', icon: '↙️', gx: 145, gy: 120, kx: 162, ky: 112, diveTilt: -1.05 },\n  { id: 'C', label: 'Chính Giữa', shortLabel: 'Giữa', icon: '⬆️', gx: 260, gy: 82, kx: 260, ky: 92, diveTilt: 0 },\n  { id: 'BR', label: 'Phải Sệt', shortLabel: 'Phải Sệt', icon: '↘️', gx: 375, gy: 120, kx: 358, ky: 112, diveTilt: 1.05 },\n  { id: 'TR', label: 'Phải Cao', shortLabel: 'Phải Cao', icon: '↗️', gx: 375, gy: 58, kx: 362, ky: 74, diveTilt: 0.75 }\n];\n\nconst PENALTY_ZONE_LIST: PenaltyZoneId[] = ['TL', 'BL', 'C', 'BR', 'TR'];\nconst TURN_SECONDS = 15;\nconst ANIM_DURATION_MS = 2150;\n\nfunction getZoneDef(zone?: PenaltyZoneId | null) {\n  return PENALTY_ZONES.find((z) => z.id === zone) || PENALTY_ZONES[2];\n}\n\nfunction pickRandomZone(): PenaltyZoneId {\n  return PENALTY_ZONE_LIST[Math.floor(Math.random() * PENALTY_ZONE_LIST.length)];\n}\n\nfunction createDefaultOnlineRoom(): SoccerOnlineRoom {\n  return {\n    status: 'idle',\n    rev: 0,\n    matchId: '',\n    modeKind: 'penalty',\n    hostId: '',\n    p1Id: '',\n    p1Name: '',\n    p2Id: null,\n    p2Name: null,\n    p1Goals: 0,\n    p2Goals: 0,\n    timeLeft: TURN_SECONDS,\n    p1x: 260,\n    p1y: 295,\n    p1Dir: 'up',\n    p1Moving: false,\n    p2x: 260,\n    p2y: 65,\n    p2Dir: 'down',\n    p2Moving: false,\n    bx: 260,\n    by: 280,\n    bvx: 0,\n    bvy: 0,\n    goalBannerText: '',\n    goalBannerUntil: 0,\n    readyMap: {},\n    phase: 'choosing',\n    kickIndex: 0,\n    maxKicks: 10,\n    p1History: [],\n    p2History: [],\n    turnDeadlineAt: 0,\n    animStartedAt: 0,\n    lastShotZone: null,\n    lastSaveZone: null,\n    lastResult: null,\n    lastShooterId: null,\n    shotLockedBy: null,\n    saveLockedBy: null,\n    updatedAt: 0\n  };\n}\n\nexport function createSoccerMiniGame(deps: SoccerEngineDeps) {\n  const W = 520;\n  const H = 360;\n  const GOAL_X1 = 185;\n  const GOAL_X2 = 335;\n  const GOAL_Y = 26;\n\n  // Penalty Goal Frame dimensions\n  const PEN_GOAL_X1 = 100;\n  const PEN_GOAL_X2 = 420;\n  const PEN_GOAL_Y1 = 24;\n  const PEN_GOAL_Y2 = 148;\n  const PEN_BALL_START_X = 260;\n  const PEN_BALL_START_Y = 278;\n\n  let rafId: number | null = null;\n  let timerId: number | null = null;\n  let syncPollId: number | null = null;\n  let hostAdvanceTimer: number | null = null;\n  let active = false;\n  let mode: 'menu' | 'solo' | 'online_2p' | 'spectator' = 'menu';\n\n  const heldDir = { up: false, down: false, left: false, right: false };\n\n  // Solo match state (1P vs AI dribble & shoot)\n  let solo = {\n    playerGoals: 0,\n    aiGoals: 0,\n    timeLeft: 45,\n    finished: false,\n    goalBannerUntil: 0,\n    goalBannerText: '',\n    px: 260,\n    py: 295,\n    pDir: 'up',\n    pMoving: false,\n    bx: 260,\n    by: 255,\n    bvx: 0,\n    bvy: 0,\n    bAngle: 0,\n    gkX: 260,\n    gkVx: 2.2,\n    defX: 260,\n    defY: 165,\n    defVx: 2.0,\n    kickCooldownUntil: 0\n  };\n\n  // Online 2P & Spectator Penalty Shootout state\n  let roomState: SoccerOnlineRoom = createDefaultOnlineRoom();\n  let lastRoomPushAt = 0;\n  let lastLobbySignature = '';\n  let lastPenaltyUiSignature = '';\n  let lastSoundPlayedKickIndex = -1;\n  let myLocalPick: { kickIndex: number; zone: PenaltyZoneId; matchId: string } | null = null;\n  let remoteShotPayload: PenaltyPickPayload | null = null;\n  let remoteSavePayload: PenaltyPickPayload | null = null;\n  let resolvingKickIndex = -1;\n  let localWriteSeq = 0;\n  let pullInFlight = false;\n  let pullStartedAt = 0;\n  let localAnimKickKey = '';\n  let localAnimStartedAt = 0;\n\n  function clearHostAdvanceTimer() {\n    if (hostAdvanceTimer !== null) {\n      clearTimeout(hostAdvanceTimer);\n      hostAdvanceTimer = null;\n    }\n  }\n\n  function getCurrentShooterId(r: SoccerOnlineRoom = roomState): string {\n    const idx = r.kickIndex || 0;\n    return idx % 2 === 0 ? r.p1Id : r.p2Id || '';\n  }\n\n  function getCurrentKeeperId(r: SoccerOnlineRoom = roomState): string {\n    const idx = r.kickIndex || 0;\n    return idx % 2 === 0 ? r.p2Id || '' : r.p1Id;\n  }\n\n  function pushOnlineRoom(immediate = false, revBump = 1) {\n    const now = Date.now();\n    if (!immediate && now - lastRoomPushAt < 105) return;\n    lastRoomPushAt = now;\n    localWriteSeq += 1;\n    const slug = normalizeFamilySlug(deps.getState().familyName);\n    const fbRoot = getFamilyFirebaseRoot(deps.getState().familyName);\n    roomState.rev = (roomState.rev || 0) + revBump;\n    roomState.updatedAt = Math.max(now, (roomState.updatedAt || 0) + 1);\n    try {\n      localStorage.setItem(`${LOCAL_SOCCER_ROOM_KEY}_${slug}`, JSON.stringify(roomState));\n    } catch {\n      // ignore\n    }\n    const fb = deps.getFirebaseUrl();\n    if (fb) {\n      fetch(`${fb}/${fbRoot}/soccer_room.json`, {\n        method: 'PUT',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(roomState)\n      }).catch(() => {});\n    }\n  }\n\n  function pushPenaltyPick(role: 'shot' | 'save', payload: PenaltyPickPayload) {\n    const slug = normalizeFamilySlug(deps.getState().familyName);\n    const fbRoot = getFamilyFirebaseRoot(deps.getState().familyName);\n    const localKey = role === 'shot' ? `${LOCAL_PEN_SHOT_KEY}_${slug}` : `${LOCAL_PEN_SAVE_KEY}_${slug}`;\n    try {\n      localStorage.setItem(localKey, JSON.stringify(payload));\n    } catch {\n      // ignore\n    }\n    if (role === 'shot') remoteShotPayload = payload;\n    else remoteSavePayload = payload;\n\n    const fb = deps.getFirebaseUrl();\n    if (fb) {\n      const node = role === 'shot' ? 'soccer_penalty_shot.json' : 'soccer_penalty_save.json';\n      fetch(`${fb}/${fbRoot}/${node}`, {\n        method: 'PUT',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(payload)\n      }).catch(() => {});\n    }\n  }\n\n  function clearPenaltyPickNodes() {\n    const slug = normalizeFamilySlug(deps.getState().familyName);\n    const fbRoot = getFamilyFirebaseRoot(deps.getState().familyName);\n    remoteShotPayload = null;\n    remoteSavePayload = null;\n    try {\n      localStorage.removeItem(`${LOCAL_PEN_SHOT_KEY}_${slug}`);\n      localStorage.removeItem(`${LOCAL_PEN_SAVE_KEY}_${slug}`);\n    } catch {\n      // ignore\n    }\n    const fb = deps.getFirebaseUrl();\n    if (fb) {\n      fetch(`${fb}/${fbRoot}/soccer_penalty_shot.json`, { method: 'DELETE' }).catch(() => {});\n      fetch(`${fb}/${fbRoot}/soccer_penalty_save.json`, { method: 'DELETE' }).catch(() => {});\n    }\n  }\n\n  function shouldAcceptRemoteRoom(remote: SoccerOnlineRoom, local: SoccerOnlineRoom): boolean {\n    if (!remote || typeof remote !== 'object') return false;\n    const rStatus = remote.status || 'idle';\n    const lStatus = local?.status || 'idle';\n    if (lStatus === 'idle' && rStatus !== 'idle') return true;\n    if (lStatus === 'lobby' && (rStatus === 'playing' || rStatus === 'finished')) {\n      if (!remote.hostId || !local.hostId || remote.hostId === local.hostId) return true;\n    }\n    if (lStatus === 'finished' && rStatus === 'playing' && remote.matchId && remote.matchId !== local.matchId) {\n      return true;\n    }\n    if (remote.matchId && remote.matchId !== local.matchId && rStatus === 'playing') {\n      return true;\n    }\n    const rRev = remote.rev || 0;\n    const lRev = local?.rev || 0;\n    if (rRev > lRev) return true;\n    if (rRev === lRev && (remote.updatedAt || 0) > (local?.updatedAt || 0)) return true;\n    if (lStatus === 'lobby' && rStatus === 'lobby') {\n      if (remote.p2Id !== local.p2Id) return true;\n      if (JSON.stringify(remote.readyMap || {}) !== JSON.stringify(local.readyMap || {})) return true;\n    }\n    return false;\n  }\n\n  function pullPenaltyPicksForHost() {\n    const slug = normalizeFamilySlug(deps.getState().familyName);\n    const fbRoot = getFamilyFirebaseRoot(deps.getState().familyName);\n    const fb = deps.getFirebaseUrl();\n    const curKick = roomState.kickIndex || 0;\n    const shooterId = getCurrentShooterId();\n    const keeperId = getCurrentKeeperId();\n\n    const handleShot = (shot: PenaltyPickPayload | null) => {\n      if (shot && shot.kickIndex === curKick && shot.playerId === shooterId) {\n        remoteShotPayload = shot;\n        if (roomState.shotLockedBy !== shooterId) {\n          roomState.shotLockedBy = shooterId;\n          pushOnlineRoom(true);\n          renderPenaltyControlsPanel();\n        }\n      }\n      tryHostResolvePenaltyKick();\n    };\n\n    const handleSave = (save: PenaltyPickPayload | null) => {\n      if (save && save.kickIndex === curKick && save.playerId === keeperId) {\n        remoteSavePayload = save;\n        if (roomState.saveLockedBy !== keeperId) {\n          roomState.saveLockedBy = keeperId;\n          pushOnlineRoom(true);\n          renderPenaltyControlsPanel();\n        }\n      }\n      tryHostResolvePenaltyKick();\n    };\n\n    if (fb) {\n      fetch(`${fb}/${fbRoot}/soccer_penalty_shot.json`, { cache: 'no-store' })\n        .then((r) => r.json())\n        .then((d: PenaltyPickPayload | null) => handleShot(d))\n        .catch(() => {});\n      fetch(`${fb}/${fbRoot}/soccer_penalty_save.json`, { cache: 'no-store' })\n        .then((r) => r.json())\n        .then((d: PenaltyPickPayload | null) => handleSave(d))\n        .catch(() => {});\n    } else {\n      try {\n        const sRaw = localStorage.getItem(`${LOCAL_PEN_SHOT_KEY}_${slug}`);\n        if (sRaw) handleShot(JSON.parse(sRaw));\n        const kRaw = localStorage.getItem(`${LOCAL_PEN_SAVE_KEY}_${slug}`);\n        if (kRaw) handleSave(JSON.parse(kRaw));\n      } catch {\n        // ignore\n      }\n    }\n  }\n\n  function pullSoccerRoomFromFirebase() {\n    const slug = normalizeFamilySlug(deps.getState().familyName);\n    const fbRoot = getFamilyFirebaseRoot(deps.getState().familyName);\n    const fb = deps.getFirebaseUrl();\n    if (fb) {\n      const now = Date.now();\n      if (!pullInFlight || now - pullStartedAt >= 2500) {\n        pullInFlight = true;\n        pullStartedAt = now;\n        const seqAtStart = localWriteSeq;\n        fetch(`${fb}/${fbRoot}/soccer_room.json`, { cache: 'no-store' })\n          .then((r) => r.json())\n          .then((remote: SoccerOnlineRoom | null) => {\n            if (!remote) return;\n            if (seqAtStart !== localWriteSeq && roomState.status === 'playing' && remote.status === 'lobby') {\n              return;\n            }\n            if (shouldAcceptRemoteRoom(remote, roomState)) {\n              onRemoteSoccerRoomUpdate(remote);\n            }\n          })\n          .catch(() => {})\n          .finally(() => {\n            pullInFlight = false;\n          });\n      }\n\n      const me = deps.getCurrentUser();\n      if (\n        active &&\n        mode === 'online_2p' &&\n        roomState.status === 'playing' &&\n        roomState.phase === 'choosing' &&\n        roomState.hostId === me.id\n      ) {\n        pullPenaltyPicksForHost();\n      }\n    } else {\n      try {\n        const localStr = localStorage.getItem(`${LOCAL_SOCCER_ROOM_KEY}_${slug}`);\n        if (localStr) {\n          const parsed = JSON.parse(localStr) as SoccerOnlineRoom;\n          if (parsed && shouldAcceptRemoteRoom(parsed, roomState)) {\n            onRemoteSoccerRoomUpdate(parsed);\n          }\n        }\n        const me = deps.getCurrentUser();\n        if (\n          active &&\n          mode === 'online_2p' &&\n          roomState.status === 'playing' &&\n          roomState.phase === 'choosing' &&\n          roomState.hostId === me.id\n        ) {\n          pullPenaltyPicksForHost();\n        }\n      } catch {\n        // ignore\n      }\n    }\n  }\n\n  function playPenaltyAnimationSoundIfNew(r: SoccerOnlineRoom) {\n    if (r.status !== 'playing' || r.phase !== 'animating') return;\n    const kickIdx = r.kickIndex || 0;\n    if (lastSoundPlayedKickIndex === kickIdx) return;\n    lastSoundPlayedKickIndex = kickIdx;\n    if (r.lastResult === 'goal') {\n      deps.playCoin();\n    } else {\n      deps.playError();\n    }\n  }\n\n  function onRemoteSoccerRoomUpdate(remote: SoccerOnlineRoom) {\n    const me = deps.getCurrentUser();\n    const isHostAuthoritative =\n      active &&\n      mode === 'online_2p' &&\n      roomState.hostId === me.id &&\n      roomState.status === 'playing' &&\n      remote.matchId === roomState.matchId;\n    if (isHostAuthoritative) return;\n\n    const prevStatus = roomState.status;\n    const prevMatchId = roomState.matchId || '';\n    const prevKick = roomState.kickIndex ?? -1;\n    roomState = {\n      ...createDefaultOnlineRoom(),\n      ...remote,\n      readyMap: remote.readyMap && typeof remote.readyMap === 'object' ? remote.readyMap : {},\n      p1History: Array.isArray(remote.p1History) ? remote.p1History : [],\n      p2History: Array.isArray(remote.p2History) ? remote.p2History : []\n    };\n\n    if (roomState.matchId !== prevMatchId || (roomState.kickIndex ?? 0) !== prevKick) {\n      if (myLocalPick && (myLocalPick.kickIndex !== (roomState.kickIndex ?? 0) || myLocalPick.matchId !== (roomState.matchId || ''))) {\n        myLocalPick = null;\n      }\n      lastPenaltyUiSignature = '';\n    }\n\n    const isParticipant = roomState.p1Id === me.id || roomState.p2Id === me.id;\n    if (prevStatus === 'playing' && roomState.status === 'idle' && mode === 'online_2p') {\n      clearHostAdvanceTimer();\n      if (timerId) {\n        clearInterval(timerId);\n        timerId = null;\n      }\n      deps.showToast('🚪 Chủ phòng đã thoát khỏi phòng bóng đá!');\n    }\n\n    if (\n      roomState.status === 'playing' &&\n      (prevStatus !== 'playing' || (roomState.matchId && roomState.matchId !== prevMatchId)) &&\n      isParticipant\n    ) {\n      mode = 'online_2p';\n      lastSoundPlayedKickIndex = -1;\n      myLocalPick = null;\n      lastPenaltyUiSignature = '';\n      const modalEl = document.getElementById('soccer-modal');\n      if (!modalEl || modalEl.style.display !== 'flex') {\n        if (deps.openModal) {\n          deps.openModal('soccer-modal');\n        } else if (modalEl) {\n          modalEl.style.display = 'flex';\n          openSoccerArena();\n        }\n      } else {\n        renderUIState();\n      }\n      deps.playSuccess();\n      deps.showToast('⚽ Loạt Đá Luân Lưu 1v1 đã bắt đầu!');\n      return;\n    }\n\n    if (roomState.status === 'finished' && prevStatus === 'playing' && isParticipant) {\n      if (roomState.p1Goals > roomState.p2Goals && roomState.p1Id === me.id) {\n        deps.playSuccess();\n        deps.triggerConfetti();\n      } else if (roomState.p2Goals > roomState.p1Goals && roomState.p2Id === me.id) {\n        deps.playSuccess();\n        deps.triggerConfetti();\n      }\n    }\n\n    playPenaltyAnimationSoundIfNew(roomState);\n\n    if (active) {\n      const modalEl = document.getElementById('soccer-modal');\n      if (modalEl && modalEl.style.display === 'flex') {\n        if (roomState.status === 'playing') {\n          if (isParticipant) mode = 'online_2p';\n          else if (mode !== 'solo') mode = 'spectator';\n        } else if (roomState.status === 'idle' && mode === 'spectator') {\n          mode = 'menu';\n        }\n        renderUIState();\n      }\n    }\n  }\n\n  function onRemoteP2InputUpdate(_inp: SoccerPlayerInput) {\n    // Kept as no-op compatibility hook for external bridge\n  }\n\n  function getNearbyMembersAtPitch(): Member[] {\n    const st = deps.getState();\n    const pitchLoc = resolveNeighborhoodLocations(st).find((l) => l.id === 'soccer');\n    const px = pitchLoc ? pitchLoc.x : 2060;\n    const py = pitchLoc ? pitchLoc.y : 1400;\n    return st.members.filter(\n      (m) => m.scene === 'neighborhood' && Math.hypot(m.x - px, m.y - py) <= 220\n    );\n  }\n\n  function resetSoloPositions() {\n    solo.px = 260;\n    solo.py = 300;\n    solo.pDir = 'up';\n    solo.pMoving = false;\n    solo.bx = 260;\n    solo.by = 258;\n    solo.bvx = 0;\n    solo.bvy = 0;\n    solo.gkX = 260;\n    solo.defX = 260;\n    solo.defY = 162;\n  }\n\n  function openSoccerArena() {\n    active = true;\n    lastLobbySignature = '';\n    lastPenaltyUiSignature = '';\n    pullSoccerRoomFromFirebase();\n\n    const me = deps.getCurrentUser();\n    if (roomState.status === 'playing') {\n      if (roomState.p1Id === me.id || roomState.p2Id === me.id) {\n        mode = 'online_2p';\n      } else {\n        mode = 'spectator';\n      }\n    } else if (roomState.status === 'lobby') {\n      mode = 'online_2p';\n    } else {\n      mode = 'solo';\n      startSoloMatchInternal();\n    }\n\n    startLoopAndSync();\n    renderUIState();\n  }\n\n  function startSoloMatchInternal() {\n    mode = 'solo';\n    solo.playerGoals = 0;\n    solo.aiGoals = 0;\n    solo.timeLeft = 45;\n    solo.finished = false;\n    solo.goalBannerUntil = 0;\n    solo.goalBannerText = '';\n    resetSoloPositions();\n\n    if (timerId) clearInterval(timerId);\n    timerId = window.setInterval(() => {\n      if (!active || mode !== 'solo' || solo.finished) return;\n      solo.timeLeft = Math.max(0, solo.timeLeft - 1);\n      updateScoreHUD();\n      if (solo.timeLeft <= 0) {\n        finishSoloMatch();\n      }\n    }, 1000);\n    renderUIState();\n  }\n\n  function startLoopAndSync() {\n    if (syncPollId) clearInterval(syncPollId);\n    syncPollId = window.setInterval(() => {\n      if (!active) return;\n      pullSoccerRoomFromFirebase();\n      if (mode === 'online_2p' && (roomState.status === 'lobby' || roomState.status === 'finished')) {\n        renderLobbyPanel();\n      }\n    }, 140);\n\n    if (rafId) cancelAnimationFrame(rafId);\n    rafId = requestAnimationFrame(loop);\n  }\n\n  function stopMatch() {\n    active = false;\n    heldDir.up = heldDir.down = heldDir.left = heldDir.right = false;\n    clearHostAdvanceTimer();\n    if (timerId) {\n      clearInterval(timerId);\n      timerId = null;\n    }\n    if (syncPollId) {\n      clearInterval(syncPollId);\n      syncPollId = null;\n    }\n    if (rafId) {\n      cancelAnimationFrame(rafId);\n      rafId = null;\n    }\n  }\n\n  function finishSoloMatch() {\n    solo.finished = true;\n    if (timerId) {\n      clearInterval(timerId);\n      timerId = null;\n    }\n    const me = deps.getCurrentUser();\n    const brand = (deps.getState().familyName || 'B2KS').trim() || 'B2KS';\n    if (solo.playerGoals > solo.aiGoals) {\n      deps.playSuccess();\n      deps.triggerConfetti();\n      deps.triggerSpeechBubble(me, formatFamilyBrand(`We won ${solo.playerGoals}-${solo.aiGoals} at B2KS Stadium! ⚽🏆`, brand), true);\n      deps.showToast(formatFamilyBrand(`🏆 Chiến thắng ${solo.playerGoals} - ${solo.aiGoals} tại Sân Bóng Đá B2KS!`, brand));\n    } else if (solo.playerGoals === solo.aiGoals) {\n      deps.playClick();\n      deps.triggerSpeechBubble(me, `Nice draw ${solo.playerGoals}-${solo.aiGoals}! Good game! ⚽`, true);\n    } else {\n      deps.playClick();\n      deps.triggerSpeechBubble(me, `Good match! Let's play again! ⚽`, true);\n    }\n    updateScoreHUD();\n  }\n\n  function checkShouldEndPenaltyMatch(p1Hist: ('G' | 'M')[], p2Hist: ('G' | 'M')[], p1G: number, p2G: number): boolean {\n    const k1 = p1Hist.length;\n    const k2 = p2Hist.length;\n    if (k1 <= 5 && k2 <= 5) {\n      const p1Left = 5 - k1;\n      const p2Left = 5 - k2;\n      if (p1G > p2G + p2Left) return true;\n      if (p2G > p1G + p1Left) return true;\n      if (k1 === 5 && k2 === 5 && p1G !== p2G) return true;\n      return false;\n    }\n    // Sudden death pairs\n    return k1 === k2 && p1G !== p2G;\n  }\n\n  function tryHostResolvePenaltyKick() {\n    const me = deps.getCurrentUser();\n    if (\n      roomState.status !== 'playing' ||\n      roomState.hostId !== me.id ||\n      roomState.phase !== 'choosing'\n    ) {\n      return;\n    }\n    const curKick = roomState.kickIndex || 0;\n    if (resolvingKickIndex === curKick) return;\n\n    const shooterId = getCurrentShooterId();\n    const keeperId = getCurrentKeeperId();\n    const shotValid =\n      remoteShotPayload &&\n      remoteShotPayload.kickIndex === curKick &&\n      remoteShotPayload.playerId === shooterId;\n    const saveValid =\n      remoteSavePayload &&\n      remoteSavePayload.kickIndex === curKick &&\n      remoteSavePayload.playerId === keeperId;\n    const timedOut = roomState.turnDeadlineAt && Date.now() >= roomState.turnDeadlineAt;\n\n    if (!((shotValid && saveValid) || timedOut)) return;\n\n    resolvingKickIndex = curKick;\n    const shotZone: PenaltyZoneId = shotValid ? remoteShotPayload!.zone : pickRandomZone();\n    const saveZone: PenaltyZoneId = saveValid ? remoteSavePayload!.zone : pickRandomZone();\n    const isGoal = shotZone !== saveZone;\n\n    const p1Hist = [...(roomState.p1History || [])];\n    const p2Hist = [...(roomState.p2History || [])];\n    if (shooterId === roomState.p1Id) {\n      p1Hist.push(isGoal ? 'G' : 'M');\n      if (isGoal) roomState.p1Goals += 1;\n    } else {\n      p2Hist.push(isGoal ? 'G' : 'M');\n      if (isGoal) roomState.p2Goals += 1;\n    }\n\n    const shooterName = shooterId === roomState.p1Id ? roomState.p1Name : (roomState.p2Name || 'P2');\n    const keeperName = keeperId === roomState.p1Id ? roomState.p1Name : (roomState.p2Name || 'P2');\n\n    const now = Date.now();\n    roomState.phase = 'animating';\n    roomState.p1History = p1Hist;\n    roomState.p2History = p2Hist;\n    roomState.lastShotZone = shotZone;\n    roomState.lastSaveZone = saveZone;\n    roomState.lastResult = isGoal ? 'goal' : 'saved';\n    roomState.lastShooterId = shooterId;\n    roomState.animStartedAt = now;\n    roomState.goalBannerText = isGoal\n      ? `⚽ VÀOOOO! ${shooterName} sút tung lưới!`\n      : `🧤 CẢN PHÁ! ${keeperName} bay người xuất thần!`;\n    roomState.goalBannerUntil = now + ANIM_DURATION_MS;\n\n    pushOnlineRoom(true, 2);\n    playPenaltyAnimationSoundIfNew(roomState);\n    renderUIState();\n\n    clearHostAdvanceTimer();\n    hostAdvanceTimer = window.setTimeout(() => {\n      if (roomState.status !== 'playing' || roomState.hostId !== deps.getCurrentUser().id) return;\n      const done = checkShouldEndPenaltyMatch(\n        roomState.p1History || [],\n        roomState.p2History || [],\n        roomState.p1Goals,\n        roomState.p2Goals\n      );\n      if (done) {\n        finishOnlineMatch();\n        return;\n      }\n      roomState.kickIndex = curKick + 1;\n      roomState.phase = 'choosing';\n      roomState.timeLeft = TURN_SECONDS;\n      roomState.turnDeadlineAt = Date.now() + TURN_SECONDS * 1000;\n      roomState.shotLockedBy = null;\n      roomState.saveLockedBy = null;\n      roomState.goalBannerText = '';\n      roomState.goalBannerUntil = 0;\n      myLocalPick = null;\n      remoteShotPayload = null;\n      remoteSavePayload = null;\n      resolvingKickIndex = -1;\n      clearPenaltyPickNodes();\n      pushOnlineRoom(true, 2);\n      renderUIState();\n    }, ANIM_DURATION_MS);\n  }\n\n  function finishOnlineMatch() {\n    clearHostAdvanceTimer();\n    roomState.status = 'finished';\n    roomState.readyMap = {\n      ...(roomState.p1Id ? { [roomState.p1Id]: false } : {}),\n      ...(roomState.p2Id ? { [roomState.p2Id]: false } : {})\n    };\n    if (timerId) {\n      clearInterval(timerId);\n      timerId = null;\n    }\n    pushOnlineRoom(true, 3);\n    const me = deps.getCurrentUser();\n    if (roomState.p1Goals > roomState.p2Goals) {\n      deps.playSuccess();\n      deps.triggerConfetti();\n      deps.showToast(`🏆 ${roomState.p1Name} thắng luân lưu ${roomState.p1Goals} - ${roomState.p2Goals}!`);\n      if (me.id === roomState.p1Id) {\n        deps.triggerSpeechBubble(me, `Penalty Victory ${roomState.p1Goals}-${roomState.p2Goals}! ⚽🏆`, true);\n      }\n    } else if (roomState.p2Goals > roomState.p1Goals) {\n      deps.playSuccess();\n      deps.triggerConfetti();\n      deps.showToast(`🏆 ${roomState.p2Name} thắng luân lưu ${roomState.p2Goals} - ${roomState.p1Goals}!`);\n      if (me.id === roomState.p2Id) {\n        deps.triggerSpeechBubble(me, `Penalty Victory ${roomState.p2Goals}-${roomState.p1Goals}! ⚽🏆`, true);\n      }\n    } else {\n      deps.playClick();\n      deps.showToast(`🤝 Trận hòa ${roomState.p1Goals} - ${roomState.p2Goals}!`);\n    }\n    lastLobbySignature = '';\n    renderUIState();\n  }\n\n  // Lobby & Mode Controls\n  function switchToSoloMode() {\n    deps.playClick();\n    startSoloMatchInternal();\n  }\n\n  function switchTo2PMode() {\n    deps.playClick();\n    mode = 'online_2p';\n    pullSoccerRoomFromFirebase();\n    renderUIState();\n  }\n\n  function create2PRoom() {\n    const me = deps.getCurrentUser();\n    deps.playClick();\n    clearHostAdvanceTimer();\n    const prevRev = roomState?.rev || 0;\n    roomState = createDefaultOnlineRoom();\n    roomState.rev = prevRev;\n    roomState.status = 'lobby';\n    roomState.modeKind = 'penalty';\n    roomState.hostId = me.id;\n    roomState.p1Id = me.id;\n    roomState.p1Name = me.name;\n    roomState.readyMap = { [me.id]: false };\n    clearPenaltyPickNodes();\n    mode = 'online_2p';\n    lastLobbySignature = '';\n    pushOnlineRoom(true);\n    renderUIState();\n    deps.showToast('⚽ Đã tạo phòng Đá Luân Lưu 1v1! Đợi người thứ 2 bấm Tham Gia...');\n  }\n\n  function join2PRoom() {\n    const me = deps.getCurrentUser();\n    if (roomState.status !== 'lobby' && roomState.status !== 'finished') return;\n    if (roomState.p1Id === me.id) return deps.showToast('ℹ️ Bạn đang là Chủ phòng (Đội Xanh P1)!');\n    if (roomState.p2Id && roomState.p2Id !== me.id) return deps.showToast('⚠️ Phòng đã đủ 2 người! Bạn có thể làm Khán giả xem trực tiếp.');\n    deps.playSuccess();\n    roomState.p2Id = me.id;\n    roomState.p2Name = me.name;\n    roomState.readyMap = {\n      ...(roomState.readyMap || {}),\n      [roomState.p1Id]: Boolean(roomState.readyMap?.[roomState.p1Id]),\n      [me.id]: false\n    };\n    mode = 'online_2p';\n    lastLobbySignature = '';\n    pushOnlineRoom(true);\n    renderUIState();\n    deps.showToast(`🔴 ${me.name} đã vào Đội Đỏ (P2)!`);\n  }\n\n  function toggle2PReady() {\n    const me = deps.getCurrentUser();\n    if (roomState.status !== 'lobby' && roomState.status !== 'finished') return;\n    if (roomState.p1Id !== me.id && roomState.p2Id !== me.id) return;\n    localWriteSeq += 1;\n    deps.playClick();\n    const nextReady = !Boolean(roomState.readyMap?.[me.id]);\n    const nextRev = (roomState.rev || 0) + 1;\n    const nextTs = Math.max(Date.now(), (roomState.updatedAt || 0) + 1);\n    roomState.readyMap = {\n      ...(roomState.readyMap || {}),\n      [me.id]: nextReady\n    };\n    roomState.rev = nextRev;\n    roomState.updatedAt = nextTs;\n\n    const slug = normalizeFamilySlug(deps.getState().familyName);\n    const fbRoot = getFamilyFirebaseRoot(deps.getState().familyName);\n    try {\n      localStorage.setItem(`${LOCAL_SOCCER_ROOM_KEY}_${slug}`, JSON.stringify(roomState));\n    } catch {\n      // ignore\n    }\n    const fb = deps.getFirebaseUrl();\n    if (fb) {\n      Promise.all([\n        fetch(`${fb}/${fbRoot}/soccer_room/readyMap/${me.id}.json`, {\n          method: 'PUT',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify(nextReady)\n        }),\n        fetch(`${fb}/${fbRoot}/soccer_room.json`, {\n          method: 'PATCH',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ rev: nextRev, updatedAt: nextTs })\n        })\n      ]).catch(() => {});\n    }\n\n    lastLobbySignature = '';\n    renderLobbyPanel();\n  }\n\n  function start2PMatch() {\n    const me = deps.getCurrentUser();\n    if ((roomState.status !== 'lobby' && roomState.status !== 'finished') || roomState.hostId !== me.id) {\n      if (roomState.hostId !== me.id) {\n        deps.playError();\n        deps.showToast('⚠️ Chỉ người tạo phòng mới có thể bấm Vào Game!');\n      }\n      return;\n    }\n    if (!roomState.p2Id) return deps.showToast('⏳ Cần có Người chơi 2 tham gia trước!');\n    const p1Ready = Boolean(roomState.readyMap?.[roomState.p1Id]);\n    const p2Ready = Boolean(roomState.readyMap?.[roomState.p2Id]);\n    if (!p1Ready || !p2Ready) {\n      deps.playError();\n      return deps.showToast('⚠️ Cả 2 người chơi phải bấm \"✅ Sẵn Sàng\" mới có thể vào game!');\n    }\n\n    clearHostAdvanceTimer();\n    clearPenaltyPickNodes();\n    deps.playSuccess();\n    const now = Date.now();\n    roomState.status = 'playing';\n    roomState.modeKind = 'penalty';\n    roomState.matchId = `pen_${now}_${Math.random().toString(36).slice(2, 6)}`;\n    roomState.p1Goals = 0;\n    roomState.p2Goals = 0;\n    roomState.p1History = [];\n    roomState.p2History = [];\n    roomState.kickIndex = 0;\n    roomState.maxKicks = 10;\n    roomState.phase = 'choosing';\n    roomState.timeLeft = TURN_SECONDS;\n    roomState.turnDeadlineAt = now + TURN_SECONDS * 1000;\n    roomState.animStartedAt = 0;\n    roomState.lastShotZone = null;\n    roomState.lastSaveZone = null;\n    roomState.lastResult = null;\n    roomState.lastShooterId = null;\n    roomState.shotLockedBy = null;\n    roomState.saveLockedBy = null;\n    roomState.goalBannerText = '';\n    roomState.goalBannerUntil = 0;\n    myLocalPick = null;\n    resolvingKickIndex = -1;\n    lastSoundPlayedKickIndex = -1;\n    lastPenaltyUiSignature = '';\n    pushOnlineRoom(true, 10);\n\n    if (timerId) clearInterval(timerId);\n    timerId = window.setInterval(() => {\n      if (\n        !active ||\n        mode !== 'online_2p' ||\n        roomState.status !== 'playing' ||\n        roomState.hostId !== deps.getCurrentUser().id\n      ) {\n        return;\n      }\n      if (roomState.phase === 'choosing' && roomState.turnDeadlineAt) {\n        const rem = Math.max(0, Math.ceil((roomState.turnDeadlineAt - Date.now()) / 1000));\n        if (rem !== roomState.timeLeft) {\n          roomState.timeLeft = rem;\n          pushOnlineRoom(true);\n          updateScoreHUD();\n        }\n        if (rem <= 0) {\n          tryHostResolvePenaltyKick();\n        }\n      }\n    }, 350);\n\n    renderUIState();\n  }\n\n  function leave2PRoom() {\n    const me = deps.getCurrentUser();\n    deps.playClick();\n    clearHostAdvanceTimer();\n    if (timerId) {\n      clearInterval(timerId);\n      timerId = null;\n    }\n    const prevRev = roomState?.rev || 0;\n    if (roomState.p1Id === me.id || roomState.hostId === me.id) {\n      roomState = createDefaultOnlineRoom();\n      roomState.rev = prevRev;\n      clearPenaltyPickNodes();\n    } else if (roomState.p2Id === me.id) {\n      const nextReady = { ...(roomState.readyMap || {}) };\n      delete nextReady[me.id];\n      roomState.readyMap = nextReady;\n      roomState.p2Id = null;\n      roomState.p2Name = null;\n      if (roomState.status === 'playing' || roomState.status === 'finished') {\n        roomState.status = 'lobby';\n      }\n    }\n    pushOnlineRoom(true);\n    mode = 'online_2p';\n    lastLobbySignature = '';\n    lastPenaltyUiSignature = '';\n    renderUIState();\n  }\n\n  function spectateMatch() {\n    deps.playClick();\n    mode = 'spectator';\n    renderUIState();\n  }\n\n  function pickPenaltyZone(zone: PenaltyZoneId) {\n    if (!active || mode !== 'online_2p' || roomState.status !== 'playing') return;\n    if (roomState.phase !== 'choosing') {\n      return deps.showToast('⏳ Đang thực hiện cú sút, chờ lượt tiếp theo nhé!');\n    }\n    const me = deps.getCurrentUser();\n    const curKick = roomState.kickIndex || 0;\n    const shooterId = getCurrentShooterId();\n    const keeperId = getCurrentKeeperId();\n    if (me.id !== shooterId && me.id !== keeperId) return;\n\n    if (\n      myLocalPick &&\n      myLocalPick.kickIndex === curKick &&\n      myLocalPick.matchId === (roomState.matchId || '')\n    ) {\n      return deps.showToast(`✅ Bạn đã khóa hướng ${getZoneDef(myLocalPick.zone).label} cho lượt này rồi!`);\n    }\n\n    const role: 'shot' | 'save' = me.id === shooterId ? 'shot' : 'save';\n    const payload: PenaltyPickPayload = {\n      kickIndex: curKick,\n      playerId: me.id,\n      zone,\n      ts: Date.now()\n    };\n    myLocalPick = { kickIndex: curKick, zone, matchId: roomState.matchId || '' };\n    deps.playClick();\n    pushPenaltyPick(role, payload);\n\n    if (role === 'shot') roomState.shotLockedBy = me.id;\n    else roomState.saveLockedBy = me.id;\n\n    if (roomState.hostId === me.id) {\n      pushOnlineRoom(true);\n      tryHostResolvePenaltyKick();\n    }\n    lastPenaltyUiSignature = '';\n    renderPenaltyControlsPanel();\n  }\n\n  function renderUIState() {\n    const btn1p = document.getElementById('soccer-mode-1p-btn');\n    const btn2p = document.getElementById('soccer-mode-2p-btn');\n    const btnSpec = document.getElementById('soccer-mode-spec-btn');\n    const lobbyPanel = document.getElementById('soccer-2p-lobby');\n    const pitchWrap = document.getElementById('soccer-pitch-wrap');\n    const controlsWrap = document.getElementById('soccer-controls-wrap');\n    const soloControls = document.getElementById('soccer-solo-controls');\n    const penaltyControls = document.getElementById('soccer-penalty-controls');\n    const restartBtn = document.getElementById('soccer-restart-btn');\n\n    const hasLiveOnline = roomState.status === 'playing' || roomState.status === 'lobby';\n    if (btn1p) btn1p.style.background = mode === 'solo' ? '#15803D' : '#64748B';\n    if (btn2p) btn2p.style.background = mode === 'online_2p' ? '#0284C7' : '#64748B';\n    if (btnSpec) {\n      btnSpec.style.display = hasLiveOnline ? 'inline-flex' : 'none';\n      btnSpec.style.background = mode === 'spectator' ? '#DC2626' : '#64748B';\n    }\n\n    const showLobby =\n      mode === 'online_2p' &&\n      (roomState.status === 'idle' || roomState.status === 'lobby' || roomState.status === 'finished');\n    if (lobbyPanel) {\n      lobbyPanel.style.display = showLobby ? 'block' : 'none';\n      if (showLobby) renderLobbyPanel();\n    }\n\n    const showPitch =\n      mode === 'solo' ||\n      (mode === 'online_2p' && roomState.status === 'playing') ||\n      mode === 'spectator';\n    if (pitchWrap) pitchWrap.style.display = showPitch ? 'flex' : 'none';\n\n    const showPlayerControls =\n      mode === 'solo' ||\n      (mode === 'online_2p' && roomState.status === 'playing');\n    if (controlsWrap) controlsWrap.style.display = showPlayerControls ? 'flex' : 'none';\n\n    if (soloControls) soloControls.style.display = mode === 'solo' ? 'flex' : 'none';\n    if (penaltyControls) {\n      const showPen = mode === 'online_2p' && roomState.status === 'playing';\n      penaltyControls.style.display = showPen ? 'block' : 'none';\n      if (showPen) renderPenaltyControlsPanel();\n    }\n\n    if (restartBtn) {\n      restartBtn.style.display = mode === 'solo' ? 'inline-flex' : 'none';\n    }\n\n    updateScoreHUD();\n  }\n\n  function renderPenaltyControlsPanel() {\n    const el = document.getElementById('soccer-penalty-controls');\n    if (!el || mode !== 'online_2p' || roomState.status !== 'playing') return;\n\n    const me = deps.getCurrentUser();\n    const curKick = roomState.kickIndex || 0;\n    const shooterId = getCurrentShooterId();\n    const keeperId = getCurrentKeeperId();\n    const isShooter = me.id === shooterId;\n    const isKeeper = me.id === keeperId;\n    const shooterName = shooterId === roomState.p1Id ? roomState.p1Name : (roomState.p2Name || 'P2');\n    const keeperName = keeperId === roomState.p1Id ? roomState.p1Name : (roomState.p2Name || 'P2');\n\n    const pickedZone =\n      myLocalPick &&\n      myLocalPick.kickIndex === curKick &&\n      myLocalPick.matchId === (roomState.matchId || '')\n        ? myLocalPick.zone\n        : '';\n\n    const oppLocked = isShooter\n      ? roomState.saveLockedBy === keeperId\n      : roomState.shotLockedBy === shooterId;\n    const sig = `${roomState.matchId}|${curKick}|${roomState.phase}|${pickedZone}|${oppLocked ? 1 : 0}|${me.id}`;\n    if (sig === lastPenaltyUiSignature) return;\n    lastPenaltyUiSignature = sig;\n\n    const canPick = roomState.phase === 'choosing' && (isShooter || isKeeper) && !pickedZone;\n    const roleBanner =\n      roomState.phase === 'animating'\n        ? roomState.lastResult === 'goal'\n          ? '⚽ VÀOOOOO! Đang chờ lượt sút tiếp theo...'\n          : '🧤 THỦ MÔN CẢN PHÁ THÀNH CÔNG!'\n        : isShooter\n        ? `⚽ LƯỢT SÚT CỦA BẠN (${me.name}) — Chọn 1 góc để dứt điểm vào lưới ${keeperName}!`\n        : `🧤 BẠN LÀM THỦ MÔN (${me.name}) — Đoán góc bay người cản cú sút của ${shooterName}!`;\n\n    const lockHint =\n      roomState.phase === 'animating'\n        ? ''\n        : pickedZone\n        ? `✅ Bạn đã khóa hướng: ${getZoneDef(pickedZone).icon} ${getZoneDef(pickedZone).label} • ${oppLocked ? 'Đủ 2 bên, đang xử lý...' : '⏳ Đang chờ đối thủ chọn...'}`\n        : oppLocked\n        ? '⚡ Đối thủ đã khóa hướng rồi! Hãy bấm chọn hướng ngay!'\n        : '💡 Bấm trực tiếp vào khung thành ở trên hoặc chọn nhanh 1 trong 5 hướng bên dưới:';\n\n    el.innerHTML = `\n      <div style=\"width:100%; display:flex; flex-direction:column; gap:8px;\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px; background:${isShooter ? '#EFF6FF' : '#FEF3C7'}; border:2px solid ${isShooter ? '#2563EB' : '#D97706'}; border-radius:10px; padding:7px 10px;\">\n          <span style=\"font-size:12.5px; font-weight:700; color:${isShooter ? '#1E3A8A' : '#92400E'};\">${roleBanner}</span>\n          <span class=\"tag\" style=\"background:#FFF; color:#0F172A; font-size:11px;\">Lượt ${curKick + 1}${curKick >= 10 ? ' (Sudden Death)' : '/10'}</span>\n        </div>\n        <div style=\"display:grid; grid-template-columns:repeat(5, minmax(0, 1fr)); gap:6px;\">\n          ${PENALTY_ZONES.map((z) => {\n            const selected = pickedZone === z.id;\n            return `\n              <button\n                type=\"button\"\n                ${!canPick ? 'disabled' : ''}\n                onclick=\"soccerPickPenaltyZone('${z.id}')\"\n                class=\"btn btn-sm\"\n                style=\"padding:8px 4px; font-size:11.5px; flex-direction:column; gap:2px; background:${selected ? '#16A34A' : canPick ? (isShooter ? '#0284C7' : '#D97706') : '#94A3B8'}; color:#FFF; border:2px solid #0F172A; opacity:${!canPick && !selected ? '0.55' : '1'}; cursor:${canPick ? 'pointer' : 'default'};\"\n              >\n                <span style=\"font-size:16px; line-height:1;\">${z.icon}</span>\n                <span>${z.shortLabel}</span>\n              </button>\n            `;\n          }).join('')}\n        </div>\n        <div style=\"display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; font-size:11.5px; color:#334155;\">\n          <span>${lockHint}</span>\n          <button type=\"button\" class=\"btn btn-sm btn-danger\" onclick=\"leaveSoccer2PRoom()\">🚪 Rời Trận</button>\n        </div>\n      </div>\n    `;\n  }\n\n  function renderHistoryDots(history: ('G' | 'M')[] = []): string {\n    const slots = Math.max(5, history.length);\n    let out = '';\n    for (let i = 0; i < slots; i++) {\n      const h = history[i];\n      if (h === 'G') out += '⚽';\n      else if (h === 'M') out += '❌';\n      else out += '⬜';\n    }\n    return out;\n  }\n\n  function renderLobbyPanel() {\n    const lobbyPanel = document.getElementById('soccer-2p-lobby');\n    if (!lobbyPanel) return;\n    const me = deps.getCurrentUser();\n    const nearby = getNearbyMembersAtPitch();\n    const p1Ready = Boolean(roomState.p1Id && roomState.readyMap?.[roomState.p1Id]);\n    const p2Ready = Boolean(roomState.p2Id && roomState.readyMap?.[roomState.p2Id]);\n    const sig = `${roomState.status}|${roomState.rev || 0}|${roomState.p1Id}|${roomState.p2Id}|${p1Ready ? 1 : 0}|${p2Ready ? 1 : 0}|${roomState.p1Goals}|${roomState.p2Goals}|${me.id}|${nearby.map((m) => m.id).join(',')}`;\n    if (sig === lastLobbySignature) return;\n    lastLobbySignature = sig;\n\n    const nearbyHtml = nearby.length > 0\n      ? nearby.map((m) => `<span class=\"tag\" style=\"background:#D1FAE5; color:#065F46; border-color:#10B981;\">${m.name}</span>`).join(' ')\n      : '<span style=\"font-size:11.5px; color:#64748B;\">Chưa có thêm thành viên nào đứng cạnh sân</span>';\n\n    if (roomState.status === 'idle') {\n      lobbyPanel.innerHTML = `\n        <div style=\"text-align:center; padding:10px;\">\n          <div style=\"font-size:30px;\">⚽🧤</div>\n          <div style=\"font-weight:700; font-size:15px; color:#0F172A; margin-top:4px;\">Đá Luân Lưu Penalty 2 Người Online (Miễn Phí 0⭐)</div>\n          <div style=\"font-size:12px; color:#475569; margin:4px 0 8px;\">1 người Sút phạt đền — 1 người làm Thủ môn bay người cản phá, luân phiên đổi vai qua từng lượt (5 lượt/người)!</div>\n          <div style=\"font-size:12px; color:#475569; margin-bottom:10px;\">Thành viên đang có mặt tại Sân Bóng: ${nearbyHtml}</div>\n          <button type=\"button\" class=\"btn btn-primary\" style=\"padding:10px 18px; font-size:14px;\" onclick=\"createSoccer2PRoom()\">🏟️ Tạo Phòng Đá Luân Lưu 1v1</button>\n        </div>\n      `;\n      return;\n    }\n\n    const isP1 = roomState.p1Id === me.id;\n    const isP2 = roomState.p2Id === me.id;\n    const isHost = roomState.hostId === me.id;\n    const isFinished = roomState.status === 'finished';\n    const myReady = Boolean(roomState.readyMap?.[me.id]);\n    const bothReady = Boolean(roomState.p1Id && roomState.p2Id && p1Ready && p2Ready);\n\n    lobbyPanel.innerHTML = `\n      <div style=\"display:flex; flex-direction:column; gap:10px;\">\n        ${isFinished ? `\n          <div style=\"background:#FEF3C7; border:2px solid #F59E0B; border-radius:10px; padding:8px; text-align:center; font-weight:700; color:#92400E;\">\n            🏆 KẾT QUẢ LUÂN LƯU: 🔵 ${roomState.p1Name} (${roomState.p1Goals}) — (${roomState.p2Goals}) ${roomState.p2Name || 'P2'} 🔴\n            <div style=\"font-size:12px; margin-top:4px;\">${renderHistoryDots(roomState.p1History)} &nbsp;vs&nbsp; ${renderHistoryDots(roomState.p2History)}</div>\n          </div>\n        ` : ''}\n        <div style=\"display:grid; grid-template-columns:1fr auto 1fr; gap:8px; align-items:center;\">\n          <div style=\"background:#EFF6FF; border:2.5px solid ${p1Ready ? '#16A34A' : '#2563EB'}; border-radius:10px; padding:10px; text-align:center;\">\n            <div style=\"font-size:11px; font-weight:700; color:#1D4ED8;\">🔵 ĐỘI XANH (P1 • Chủ phòng)</div>\n            <div style=\"font-size:15px; font-weight:700; color:#0F172A; margin-top:4px;\">${roomState.p1Name}</div>\n            <div style=\"font-size:11px; color:#64748B;\">Sút trước lượt 1 • Luân phiên</div>\n            <div style=\"margin-top:6px;\">\n              <span class=\"tag\" style=\"background:${p1Ready ? '#16A34A' : '#F59E0B'}; color:#FFF; font-size:11px;\">\n                ${p1Ready ? '✅ Đã sẵn sàng' : '⏳ Chưa sẵn sàng'}\n              </span>\n            </div>\n          </div>\n          <div style=\"font-weight:700; font-size:16px; color:#0F172A;\">VS</div>\n          <div style=\"background:#FEF2F2; border:2.5px solid ${p2Ready ? '#16A34A' : '#DC2626'}; border-radius:10px; padding:10px; text-align:center;\">\n            <div style=\"font-size:11px; font-weight:700; color:#B91C1C;\">🔴 ĐỘI ĐỎ (P2)</div>\n            <div style=\"font-size:15px; font-weight:700; color:#0F172A; margin-top:4px;\">${roomState.p2Name || '⏳ Đang chờ P2...'}</div>\n            <div style=\"font-size:11px; color:#64748B;\">Chụp trước lượt 1 • Luân phiên</div>\n            <div style=\"margin-top:6px;\">\n              ${roomState.p2Id ? `<span class=\"tag\" style=\"background:${p2Ready ? '#16A34A' : '#F59E0B'}; color:#FFF; font-size:11px;\">${p2Ready ? '✅ Đã sẵn sàng' : '⏳ Chưa sẵn sàng'}</span>` : ''}\n            </div>\n          </div>\n        </div>\n        <div style=\"font-size:11.5px; color:#475569; text-align:center;\">Đang ở Sân Bóng: ${nearbyHtml}</div>\n        <div style=\"display:flex; gap:8px; justify-content:center; align-items:center; flex-wrap:wrap;\">\n          ${!isP1 && !isP2 && !roomState.p2Id ? `<button type=\"button\" class=\"btn btn-primary\" onclick=\"joinSoccer2PRoom()\">🙋 Tham Gia Đội Đỏ (P2)</button>` : ''}\n          ${(isP1 || isP2) ? `<button type=\"button\" class=\"btn ${myReady ? 'btn-accent' : 'btn-primary'}\" onclick=\"toggleSoccer2PReady()\">${myReady ? '✅ Đã Sẵn Sàng (Hủy)' : '✋ Xác Nhận Sẵn Sàng'}</button>` : ''}\n          ${isHost ? `<button type=\"button\" class=\"btn\" ${!bothReady ? 'disabled' : ''} style=\"background:${bothReady ? '#16A34A' : '#94A3B8'}; color:#FFF; ${!bothReady ? 'opacity:0.45; cursor:not-allowed; filter:grayscale(0.35);' : 'box-shadow:0 3px 0 #14532D;'}\" onclick=\"startSoccer2PMatch()\">🚀 ${isFinished ? 'Đá Lại Trận Mới' : 'Vào Game (Bắt Đầu!)'}</button>` : ''}\n          ${isP2 ? `<span class=\"tag\" style=\"background:#FEF9C3; color:#854D0E; border:1.5px solid #CA8A04; padding:7px 10px;\">⏳ Chờ chủ phòng (${roomState.p1Name}) bấm Vào Game khi cả 2 Sẵn Sàng...</span>` : ''}\n          ${(isP1 || isP2) ? `<button type=\"button\" class=\"btn btn-danger btn-sm\" onclick=\"leaveSoccer2PRoom()\">🚪 Rời Phòng</button>` : ''}\n          <button type=\"button\" class=\"btn btn-sm\" style=\"background:#7C3AED;\" onclick=\"spectateSoccerMatch()\">📺 Xem Đá (Khán giả)</button>\n        </div>\n      </div>\n    `;\n  }\n\n  function updateScoreHUD() {\n    const scoreEl = document.getElementById('soccer-scoreboard');\n    const timeEl = document.getElementById('soccer-timer');\n    const statusEl = document.getElementById('soccer-status-text');\n    const me = deps.getCurrentUser();\n    const brand = (deps.getState().familyName || 'B2KS').trim() || 'B2KS';\n\n    if (mode === 'solo') {\n      if (scoreEl) {\n        scoreEl.innerHTML = `<span style=\"color:#0369A1;\">⚽ ${me.name}: <b>${solo.playerGoals}</b></span> <span style=\"color:#64748B;\">—</span> <span style=\"color:#B91C1C;\"><b>${solo.aiGoals}</b> :Thủ môn ${brand} 🧤</span>`;\n      }\n      if (timeEl) timeEl.textContent = `⏱️ ${solo.timeLeft}s`;\n      if (statusEl) {\n        if (solo.finished) {\n          statusEl.textContent =\n            solo.playerGoals > solo.aiGoals\n              ? `🏆 HẾT GIỜ! ${me.name} thắng ${solo.playerGoals} - ${solo.aiGoals}!`\n              : solo.playerGoals === solo.aiGoals\n              ? `🤝 HẾT GIỜ! Hòa ${solo.playerGoals} - ${solo.aiGoals}!`\n              : `🧤 HẾT GIỜ! Đội ${brand} thắng ${solo.aiGoals} - ${solo.playerGoals}!`;\n          statusEl.style.color = solo.playerGoals > solo.aiGoals ? '#15803D' : '#B45309';\n        } else {\n          statusEl.textContent = '🆓 Đá Solo 0⭐ • Rê bóng vượt hậu vệ & bấm ⚡ Sút vào lưới!';\n          statusEl.style.color = '#1E293B';\n        }\n      }\n      return;\n    }\n\n    if (scoreEl) {\n      const p1Dots = renderHistoryDots(roomState.p1History);\n      const p2Dots = renderHistoryDots(roomState.p2History);\n      scoreEl.innerHTML = `\n        <div style=\"display:flex; flex-direction:column; gap:2px;\">\n          <div>\n            <span style=\"color:#1D4ED8;\">🔵 ${roomState.p1Name || 'P1'}: <b>${roomState.p1Goals}</b></span>\n            <span style=\"color:#64748B;\">—</span>\n            <span style=\"color:#DC2626;\"><b>${roomState.p2Goals}</b> :${roomState.p2Name || 'P2'} 🔴</span>\n          </div>\n          ${roomState.status === 'playing' || roomState.status === 'finished' ? `<div style=\"font-size:11px; letter-spacing:1px;\">${p1Dots} &nbsp;|&nbsp; ${p2Dots}</div>` : ''}\n        </div>\n      `;\n    }\n\n    const displaySec =\n      roomState.status === 'playing' && roomState.phase === 'choosing' && roomState.turnDeadlineAt\n        ? Math.max(0, Math.ceil((roomState.turnDeadlineAt - Date.now()) / 1000))\n        : roomState.timeLeft;\n    if (timeEl) {\n      timeEl.textContent = roomState.status === 'playing' ? `⏱️ ${displaySec}s` : '⚽ Luân Lưu';\n    }\n\n    if (statusEl) {\n      if (mode === 'spectator') {\n        statusEl.textContent =\n          roomState.status === 'playing'\n            ? `📺 KHÁN GIẢ TRỰC TIẾP: Đang theo dõi luân lưu ${roomState.p1Name} vs ${roomState.p2Name}!`\n            : roomState.status === 'finished'\n            ? `🏁 Trận đấu kết thúc (${roomState.p1Goals} - ${roomState.p2Goals})!`\n            : `🟡 Đang chờ ${roomState.p1Name || 'Chủ phòng'} bắt đầu loạt sút luân lưu...`;\n        statusEl.style.color = '#7C3AED';\n      } else if (roomState.status === 'playing') {\n        const shooterId = getCurrentShooterId();\n        const shooterName = shooterId === roomState.p1Id ? roomState.p1Name : (roomState.p2Name || 'P2');\n        const keeperId = getCurrentKeeperId();\n        const keeperName = keeperId === roomState.p1Id ? roomState.p1Name : (roomState.p2Name || 'P2');\n        statusEl.textContent = `⚽ ĐÁ LUÂN LƯU LƯỢT ${(roomState.kickIndex || 0) + 1}: ${shooterName} SÚT 🆚 ${keeperName} CHỤP`;\n        statusEl.style.color = '#0369A1';\n      } else {\n        statusEl.textContent = '👥 Đá Luân Lưu 1v1 Miễn Phí (0⭐) — Thay phiên Sút & Chụp cực gay cấn!';\n        statusEl.style.color = '#1E293B';\n      }\n    }\n  }\n\n  function mapCanvasCoordsToPenaltyZone(tx: number, ty: number): PenaltyZoneId | null {\n    if (ty > 178 || tx < 60 || tx > 460) return null;\n    let best = PENALTY_ZONES[2];\n    let minDist = Infinity;\n    for (const z of PENALTY_ZONES) {\n      const d = Math.hypot(tx - z.gx, ty - z.gy);\n      if (d < minDist) {\n        minDist = d;\n        best = z;\n      }\n    }\n    return best.id;\n  }\n\n  function kickBall(targetX?: number, targetY?: number) {\n    if (!active) return;\n    const now = Date.now();\n\n    if (mode === 'online_2p' && roomState.status === 'playing') {\n      if (typeof targetX === 'number' && typeof targetY === 'number') {\n        const z = mapCanvasCoordsToPenaltyZone(targetX, targetY);\n        if (z) pickPenaltyZone(z);\n      } else {\n        pickPenaltyZone('C');\n      }\n      return;\n    }\n\n    if (mode !== 'solo' || solo.finished || now < solo.kickCooldownUntil) return;\n    const d = Math.hypot(solo.bx - solo.px, solo.by - solo.py);\n    if (d > 58) {\n      deps.showToast('🏃 Lại gần quả bóng hơn rồi mới sút nhé!');\n      return;\n    }\n    solo.kickCooldownUntil = now + 260;\n    let dx = 0;\n    let dy = -1;\n    if (typeof targetX === 'number' && typeof targetY === 'number') {\n      dx = targetX - solo.bx;\n      dy = targetY - solo.by;\n    } else if (solo.pDir === 'left') {\n      dx = -0.35;\n      dy = -0.95;\n    } else if (solo.pDir === 'right') {\n      dx = 0.35;\n      dy = -0.95;\n    } else if (solo.pDir === 'down') {\n      dx = 0;\n      dy = 1;\n    } else {\n      const goalMid = (GOAL_X1 + GOAL_X2) / 2;\n      dx = (goalMid - solo.bx) * 0.004;\n      dy = -1;\n    }\n    const len = Math.hypot(dx, dy) || 1;\n    solo.bvx = (dx / len) * 9.4;\n    solo.bvy = (dy / len) * 9.4;\n    deps.playClick();\n  }\n\n  function getLocalDirVector() {\n    let dx = 0;\n    let dy = 0;\n    if (heldDir.up) dy -= 1;\n    if (heldDir.down) dy += 1;\n    if (heldDir.left) dx -= 1;\n    if (heldDir.right) dx += 1;\n    const len = Math.hypot(dx, dy);\n    if (len > 1) { dx /= len; dy /= len; }\n    return { dx, dy };\n  }\n\n  function setTouchDir(dir: 'up' | 'down' | 'left' | 'right', down: boolean) {\n    heldDir[dir] = down;\n  }\n\n  function handleKey(key: string, down: boolean): boolean {\n    if (!active || typeof key !== 'string') return false;\n    const k = key.toLowerCase();\n    if (mode === 'online_2p' && roomState.status === 'playing') {\n      if (!down) return false;\n      if (k === '1' || k === 'q') { pickPenaltyZone('TL'); return true; }\n      if (k === '2' || k === 'a') { pickPenaltyZone('BL'); return true; }\n      if (k === '3' || k === 'w' || k === ' ') { pickPenaltyZone('C'); return true; }\n      if (k === '4' || k === 'd') { pickPenaltyZone('BR'); return true; }\n      if (k === '5' || k === 'e') { pickPenaltyZone('TR'); return true; }\n      return false;\n    }\n\n    if (k === 'arrowup' || k === 'w') { heldDir.up = down; return true; }\n    if (k === 'arrowdown' || k === 's') { heldDir.down = down; return true; }\n    if (k === 'arrowleft' || k === 'a') { heldDir.left = down; return true; }\n    if (k === 'arrowright' || k === 'd') { heldDir.right = down; return true; }\n    if (down && (k === ' ' || k === 'enter')) {\n      kickBall();\n      return true;\n    }\n    return false;\n  }\n\n  function loop() {\n    if (!active) return;\n    const canvas = document.getElementById('soccer-canvas') as HTMLCanvasElement | null;\n    const ctx = canvas?.getContext('2d');\n    const now = Date.now();\n\n    if (mode === 'solo' && ctx) {\n      stepSoloPhysics(now);\n      drawPitchBase(ctx);\n      drawSoloEntities(ctx, now);\n    } else if ((mode === 'online_2p' || mode === 'spectator') && ctx) {\n      drawPenaltyArena(ctx, now);\n      updateScoreHUD();\n      if (mode === 'online_2p' && roomState.status === 'playing') {\n        renderPenaltyControlsPanel();\n      }\n    }\n\n    rafId = requestAnimationFrame(loop);\n  }\n\n  function stepSoloPhysics(now: number) {\n    if (solo.finished || now < solo.goalBannerUntil) return;\n    const { dx, dy } = getLocalDirVector();\n    solo.pMoving = dx !== 0 || dy !== 0;\n\n    if (solo.pMoving) {\n      solo.px = Math.max(26, Math.min(W - 26, solo.px + dx * 3.8));\n      solo.py = Math.max(46, Math.min(H - 22, solo.py + dy * 3.8));\n      if (Math.abs(dx) > Math.abs(dy)) solo.pDir = dx < 0 ? 'left' : 'right';\n      else solo.pDir = dy < 0 ? 'up' : 'down';\n    }\n\n    const distPB = Math.hypot(solo.bx - solo.px, solo.by - solo.py);\n    if (distPB < 27 && now >= solo.kickCooldownUntil) {\n      const px = solo.bx - solo.px;\n      const py = solo.by - solo.py;\n      const plen = Math.hypot(px, py) || 1;\n      solo.bvx = (px / plen) * 3.6 + dx * 1.4;\n      solo.bvy = (py / plen) * 3.6 + dy * 1.4;\n    }\n\n    const targetGkX = Math.max(GOAL_X1 + 16, Math.min(GOAL_X2 - 16, solo.bx));\n    const gkDiff = targetGkX - solo.gkX;\n    solo.gkX += Math.sign(gkDiff) * Math.min(Math.abs(gkDiff), 2.35);\n\n    solo.defX += solo.defVx;\n    if (solo.defX < 105 || solo.defX > W - 105) solo.defVx *= -1;\n    if (solo.by > 90 && solo.by < 250) {\n      solo.defX += Math.sign(solo.bx - solo.defX) * 0.9;\n    }\n\n    solo.bx += solo.bvx;\n    solo.by += solo.bvy;\n    solo.bvx *= 0.968;\n    solo.bvy *= 0.968;\n    const spd = Math.hypot(solo.bvx, solo.bvy);\n    if (spd < 0.08) { solo.bvx = 0; solo.bvy = 0; }\n    else solo.bAngle += spd * 0.09;\n\n    if (solo.by <= GOAL_Y + 8 && solo.bx >= GOAL_X1 + 8 && solo.bx <= GOAL_X2 - 8) {\n      solo.playerGoals += 1;\n      solo.goalBannerUntil = now + 1500;\n      solo.goalBannerText = '⚽ VÀOOO! GHI BÀN TUYỆT ĐẸP!';\n      deps.playCoin();\n      updateScoreHUD();\n      setTimeout(() => { if (active && mode === 'solo' && !solo.finished) resetSoloPositions(); }, 1200);\n    } else if (solo.by >= H - 22 && solo.bx >= GOAL_X1 + 8 && solo.bx <= GOAL_X2 - 8) {\n      solo.aiGoals += 1;\n      solo.goalBannerUntil = now + 1400;\n      solo.goalBannerText = '🧤 Ôi! Đối phương phản công!';\n      deps.playError();\n      updateScoreHUD();\n      setTimeout(() => { if (active && mode === 'solo' && !solo.finished) resetSoloPositions(); }, 1200);\n    }\n\n    if (solo.bx < 20) { solo.bx = 20; solo.bvx = Math.abs(solo.bvx) * 0.78; }\n    if (solo.bx > W - 20) { solo.bx = W - 20; solo.bvx = -Math.abs(solo.bvx) * 0.78; }\n    if (solo.by < 24 && (solo.bx < GOAL_X1 || solo.bx > GOAL_X2)) { solo.by = 24; solo.bvy = Math.abs(solo.bvy) * 0.78; }\n    if (solo.by > H - 18 && (solo.bx < GOAL_X1 || solo.bx > GOAL_X2)) { solo.by = H - 18; solo.bvy = -Math.abs(solo.bvy) * 0.78; }\n\n    if (Math.hypot(solo.bx - solo.gkX, solo.by - (GOAL_Y + 26)) < 24) {\n      solo.bvx = (solo.bx - solo.gkX) * 0.25 + (Math.random() - 0.5) * 3.5;\n      solo.bvy = 5.4;\n      deps.playClick();\n    }\n    if (Math.hypot(solo.bx - solo.defX, solo.by - solo.defY) < 24) {\n      solo.bvx = (solo.bx - solo.defX) * 0.28 + (Math.random() - 0.5) * 3;\n      solo.bvy = 4.6;\n      deps.playClick();\n    }\n  }\n\n  function drawPitchBase(ctx: CanvasRenderingContext2D) {\n    ctx.clearRect(0, 0, W, H);\n    const stripeCount = 9;\n    const stripeH = H / stripeCount;\n    for (let i = 0; i < stripeCount; i++) {\n      ctx.fillStyle = i % 2 === 0 ? '#1E8449' : '#239B56';\n      ctx.fillRect(0, i * stripeH, W, stripeH + 1);\n    }\n\n    ctx.strokeStyle = 'rgba(255,255,255,0.9)';\n    ctx.lineWidth = 3;\n    ctx.strokeRect(14, 24, W - 28, H - 38);\n\n    ctx.beginPath();\n    ctx.moveTo(14, H / 2);\n    ctx.lineTo(W - 14, H / 2);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(W / 2, H / 2, 42, 0, Math.PI * 2);\n    ctx.stroke();\n    ctx.fillStyle = '#FFF';\n    ctx.beginPath();\n    ctx.arc(W / 2, H / 2, 3.5, 0, Math.PI * 2);\n    ctx.fill();\n\n    ctx.strokeRect(140, 24, 240, 68);\n    ctx.strokeRect(140, H - 82, 240, 68);\n\n    ctx.fillStyle = 'rgba(255,255,255,0.18)';\n    ctx.fillRect(GOAL_X1, 4, GOAL_X2 - GOAL_X1, GOAL_Y - 2);\n    ctx.strokeStyle = 'rgba(255,255,255,0.45)';\n    ctx.lineWidth = 1;\n    for (let gx = GOAL_X1 + 10; gx < GOAL_X2; gx += 12) {\n      ctx.beginPath(); ctx.moveTo(gx, 4); ctx.lineTo(gx, GOAL_Y); ctx.stroke();\n    }\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.lineWidth = 4;\n    ctx.strokeRect(GOAL_X1, 4, GOAL_X2 - GOAL_X1, GOAL_Y - 2);\n\n    ctx.strokeStyle = 'rgba(255,255,255,0.75)';\n    ctx.lineWidth = 3;\n    ctx.strokeRect(GOAL_X1, H - 14, GOAL_X2 - GOAL_X1, 12);\n  }\n\n  function drawSoccerBall(ctx: CanvasRenderingContext2D, bx: number, by: number, angle: number, scale = 1) {\n    ctx.save();\n    ctx.fillStyle = 'rgba(0,0,0,0.28)';\n    ctx.beginPath();\n    ctx.ellipse(bx, by + 8 * scale, 9 * scale, 4 * scale, 0, 0, Math.PI * 2);\n    ctx.fill();\n\n    ctx.translate(bx, by);\n    ctx.scale(scale, scale);\n    ctx.rotate(angle);\n    ctx.fillStyle = '#FFFFFF';\n    ctx.strokeStyle = '#0F172A';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(0, 0, 9.5, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#0F172A';\n    ctx.beginPath();\n    ctx.arc(0, 0, 3.6, 0, Math.PI * 2);\n    ctx.fill();\n    [0, 120, 240].forEach((deg) => {\n      const r = (deg * Math.PI) / 180;\n      ctx.beginPath();\n      ctx.arc(Math.cos(r) * 6.5, Math.sin(r) * 6.5, 2, 0, Math.PI * 2);\n      ctx.fill();\n    });\n    ctx.restore();\n  }\n\n  function drawGoalBannerOverlay(ctx: CanvasRenderingContext2D, text: string) {\n    ctx.fillStyle = 'rgba(15, 23, 42, 0.80)';\n    ctx.beginPath();\n    ctx.roundRect(45, H / 2 + 12, W - 90, 52, 14);\n    ctx.fill();\n    ctx.strokeStyle = '#FACC15';\n    ctx.lineWidth = 3;\n    ctx.stroke();\n    ctx.fillStyle = '#FACC15';\n    ctx.font = 'bold 18px Fredoka, sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(text, W / 2, H / 2 + 44);\n  }\n\n  function drawSoloEntities(ctx: CanvasRenderingContext2D, now: number) {\n    const brand = (deps.getState().familyName || 'B2KS').trim() || 'B2KS';\n    drawDetailedChibiOnContext(ctx, {\n      x: solo.gkX, y: GOAL_Y + 26, dir: 'down', name: `Thủ môn ${brand}`,\n      hairStyle: 'short', hairColor: '#1E293B', shirtColor: '#F59E0B', shirtPattern: 'collar',\n      pantsColor: '#1E293B', pantsStyle: 'shorts', outfit: '🧤', speech: null\n    }, false, 0.72, false, true);\n\n    drawDetailedChibiOnContext(ctx, {\n      x: solo.defX, y: solo.defY, dir: solo.defVx >= 0 ? 'right' : 'left', name: 'Hậu vệ',\n      hairStyle: 'spiky', hairColor: '#DC2626', shirtColor: '#B91C1C', shirtPattern: 'stripe',\n      pantsColor: '#1F2937', pantsStyle: 'shorts', outfit: '', speech: null\n    }, false, 0.74, true, true);\n\n    drawSoccerBall(ctx, solo.bx, solo.by, solo.bAngle);\n\n    const me = deps.getCurrentUser();\n    drawDetailedChibiOnContext(ctx, { ...me, x: solo.px, y: solo.py, dir: solo.pDir, speech: null }, true, 0.82, true, solo.pMoving);\n\n    if (now < solo.goalBannerUntil) {\n      drawGoalBannerOverlay(ctx, solo.goalBannerText);\n    }\n  }\n\n  function drawPenaltyArena(ctx: CanvasRenderingContext2D, now: number) {\n    ctx.clearRect(0, 0, W, H);\n    // Stadium crowd top backdrop\n    ctx.fillStyle = '#0F172A';\n    ctx.fillRect(0, 0, W, 62);\n    for (let sx = 12; sx < W; sx += 18) {\n      ctx.fillStyle = sx % 36 === 0 ? '#38BDF8' : sx % 54 === 0 ? '#FACC15' : '#FB7185';\n      ctx.beginPath();\n      ctx.arc(sx, 14 + (sx % 7), 4.5, 0, Math.PI * 2);\n      ctx.fill();\n    }\n\n    // Lush striped penalty box grass\n    const grassTop = 62;\n    const stripeCount = 7;\n    const sh = (H - grassTop) / stripeCount;\n    for (let i = 0; i < stripeCount; i++) {\n      ctx.fillStyle = i % 2 === 0 ? '#1E8449' : '#239B56';\n      ctx.fillRect(0, grassTop + i * sh, W, sh + 1);\n    }\n\n    // Penalty box lines & spot\n    ctx.strokeStyle = 'rgba(255,255,255,0.88)';\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.moveTo(0, 152);\n    ctx.lineTo(W, 152);\n    ctx.stroke();\n    ctx.strokeRect(64, 152, W - 128, 175);\n    ctx.beginPath();\n    ctx.arc(PEN_BALL_START_X, PEN_BALL_START_Y, 44, Math.PI * 0.12, Math.PI * 0.88);\n    ctx.stroke();\n\n    // Penalty spot\n    ctx.fillStyle = '#FFFFFF';\n    ctx.beginPath();\n    ctx.ellipse(PEN_BALL_START_X, PEN_BALL_START_Y + 6, 8, 4, 0, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Goal net & posts\n    ctx.fillStyle = 'rgba(255,255,255,0.16)';\n    ctx.fillRect(PEN_GOAL_X1, PEN_GOAL_Y1, PEN_GOAL_X2 - PEN_GOAL_X1, PEN_GOAL_Y2 - PEN_GOAL_Y1);\n    ctx.strokeStyle = 'rgba(255,255,255,0.38)';\n    ctx.lineWidth = 1;\n    for (let gx = PEN_GOAL_X1 + 16; gx < PEN_GOAL_X2; gx += 16) {\n      ctx.beginPath(); ctx.moveTo(gx, PEN_GOAL_Y1); ctx.lineTo(gx, PEN_GOAL_Y2); ctx.stroke();\n    }\n    for (let gy = PEN_GOAL_Y1 + 16; gy < PEN_GOAL_Y2; gy += 16) {\n      ctx.beginPath(); ctx.moveTo(PEN_GOAL_X1, gy); ctx.lineTo(PEN_GOAL_X2, gy); ctx.stroke();\n    }\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.lineWidth = 5;\n    ctx.beginPath();\n    ctx.moveTo(PEN_GOAL_X1, PEN_GOAL_Y2);\n    ctx.lineTo(PEN_GOAL_X1, PEN_GOAL_Y1);\n    ctx.lineTo(PEN_GOAL_X2, PEN_GOAL_Y1);\n    ctx.lineTo(PEN_GOAL_X2, PEN_GOAL_Y2);\n    ctx.stroke();\n\n    if (roomState.status === 'lobby') {\n      drawSoccerBall(ctx, PEN_BALL_START_X, PEN_BALL_START_Y, 0, 1.1);\n      drawGoalBannerOverlay(ctx, `🟡 Chờ ${roomState.p1Name} bắt đầu Đá Luân Lưu...`);\n      return;\n    }\n\n    const st = deps.getState();\n    const me = deps.getCurrentUser();\n    const curKick = roomState.kickIndex || 0;\n    const isAnim = roomState.phase === 'animating';\n    const shooterId = isAnim ? (roomState.lastShooterId || getCurrentShooterId()) : getCurrentShooterId();\n    const keeperId = shooterId === roomState.p1Id ? (roomState.p2Id || '') : roomState.p1Id;\n    const shooterMember = st.members.find((m) => m.id === shooterId);\n    const keeperMember = st.members.find((m) => m.id === keeperId);\n\n    // Draw 5 clickable penalty target rings while choosing\n    const pickedZone =\n      myLocalPick &&\n      myLocalPick.kickIndex === curKick &&\n      myLocalPick.matchId === (roomState.matchId || '')\n        ? myLocalPick.zone\n        : null;\n\n    if (roomState.phase === 'choosing' && mode === 'online_2p' && (me.id === shooterId || me.id === keeperId)) {\n      const pulse = 1 + Math.sin(now / 180) * 0.08;\n      PENALTY_ZONES.forEach((z) => {\n        const isMine = pickedZone === z.id;\n        ctx.save();\n        ctx.translate(z.gx, z.gy);\n        ctx.scale(isMine ? 1.15 : pulse, isMine ? 1.15 : pulse);\n        ctx.fillStyle = isMine ? 'rgba(22, 163, 74, 0.85)' : 'rgba(15, 23, 42, 0.52)';\n        ctx.strokeStyle = isMine ? '#FACC15' : '#FFFFFF';\n        ctx.lineWidth = isMine ? 3 : 2;\n        ctx.beginPath();\n        ctx.arc(0, 0, 19, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n        ctx.fillStyle = '#FFFFFF';\n        ctx.font = 'bold 14px Fredoka, sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(z.icon, 0, 0);\n        ctx.restore();\n      });\n    }\n\n    // Compute animated ball & keeper positions\n    let keeperX = 260;\n    let keeperY = 122;\n    let keeperTilt = 0;\n    let ballX = PEN_BALL_START_X;\n    let ballY = PEN_BALL_START_Y;\n    let ballScale = 1.15;\n    let ballAngle = 0;\n    let shooterY = PEN_BALL_START_Y + 34;\n\n    if (isAnim && roomState.lastShotZone && roomState.lastSaveZone) {\n      const animKey = `${roomState.matchId || ''}|${curKick}`;\n      if (localAnimKickKey !== animKey) {\n        localAnimKickKey = animKey;\n        localAnimStartedAt = now;\n      }\n      const elapsed = Math.max(0, now - (localAnimStartedAt || now));\n      const t = Math.min(1, elapsed / 760);\n      const easeOut = 1 - Math.pow(1 - t, 3);\n      const sz = getZoneDef(roomState.lastShotZone);\n      const kz = getZoneDef(roomState.lastSaveZone);\n\n      // Shooter run-up\n      shooterY = PEN_BALL_START_Y + 34 - Math.min(1, elapsed / 220) * 18;\n\n      // Keeper dive\n      keeperX = 260 + (kz.kx - 260) * easeOut;\n      keeperY = 122 + (kz.ky - 122) * easeOut;\n      keeperTilt = kz.diveTilt * easeOut;\n\n      // Ball curve + save rebound\n      if (roomState.lastResult === 'saved' && t > 0.72) {\n        const reboundT = (t - 0.72) / 0.28;\n        ballX = sz.gx + (sz.gx < 260 ? -36 : 36) * reboundT;\n        ballY = sz.gy + 46 * reboundT;\n        ballScale = 0.78 + reboundT * 0.22;\n      } else {\n        const arc = Math.sin(t * Math.PI) * -28;\n        ballX = PEN_BALL_START_X + (sz.gx - PEN_BALL_START_X) * easeOut;\n        ballY = PEN_BALL_START_Y + (sz.gy - PEN_BALL_START_Y) * easeOut + arc;\n        ballScale = 1.15 - easeOut * 0.42;\n      }\n      ballAngle = elapsed * 0.02;\n    } else if (roomState.phase === 'choosing') {\n      keeperX = 260 + Math.sin(now / 360) * 12;\n    }\n\n    // Draw Goalkeeper\n    ctx.save();\n    ctx.translate(keeperX, keeperY);\n    ctx.rotate(keeperTilt);\n    if (keeperMember) {\n      drawDetailedChibiOnContext(\n        ctx,\n        {\n          ...keeperMember,\n          x: 0,\n          y: 0,\n          dir: 'down',\n          shirtColor: '#F59E0B',\n          outfit: '🧤',\n          speech: null\n        },\n        keeperMember.id === me.id,\n        0.84,\n        true,\n        isAnim\n      );\n    }\n    ctx.restore();\n\n    // Draw Ball\n    drawSoccerBall(ctx, ballX, ballY, ballAngle, ballScale);\n\n    // Draw Shooter\n    if (shooterMember) {\n      drawDetailedChibiOnContext(\n        ctx,\n        {\n          ...shooterMember,\n          x: PEN_BALL_START_X - 6,\n          y: shooterY,\n          dir: 'up',\n          shirtColor: shooterMember.id === roomState.p1Id ? '#2563EB' : '#DC2626',\n          speech: null\n        },\n        shooterMember.id === me.id,\n        0.9,\n        true,\n        isAnim\n      );\n    }\n\n    if (isAnim && roomState.goalBannerText && localAnimStartedAt && now < localAnimStartedAt + ANIM_DURATION_MS) {\n      drawGoalBannerOverlay(ctx, roomState.goalBannerText);\n    }\n  }\n\n  function checkZoneAutoExit() {\n    if (roomState.status !== 'lobby' && roomState.status !== 'playing' && roomState.status !== 'finished') return;\n    const me = deps.getCurrentUser();\n    if (roomState.p1Id !== me.id && roomState.p2Id !== me.id) return;\n    const st = deps.getState();\n    const pitchLoc = resolveNeighborhoodLocations(st).find((l) => l.id === 'soccer');\n    const px = pitchLoc ? pitchLoc.x : 2060;\n    const py = pitchLoc ? pitchLoc.y : 1400;\n    const dist = Math.hypot(me.x - px, me.y - py);\n    if (me.scene !== 'neighborhood' || dist > 220) {\n      leave2PRoom();\n      stopMatch();\n      if (deps.closeModal) {\n        deps.closeModal('soccer-modal');\n      } else {\n        const modalEl = document.getElementById('soccer-modal');\n        if (modalEl) modalEl.style.display = 'none';\n      }\n      deps.showToast('🚶 Bạn đã rời Sân Bóng Đá nên tự động thoát phòng!');\n    }\n  }\n\n  return {\n    openSoccerArena,\n    startMatch: openSoccerArena,\n    restartSoloMatch: startSoloMatchInternal,\n    stopMatch,\n    kickBall,\n    pickPenaltyZone,\n    setTouchDir,\n    handleKey,\n    switchToSoloMode,\n    switchTo2PMode,\n    create2PRoom,\n    join2PRoom,\n    toggle2PReady,\n    start2PMatch,\n    leave2PRoom,\n    spectateMatch,\n    pullSoccerRoomFromFirebase,\n    onRemoteSoccerRoomUpdate,\n    onRemoteP2InputUpdate,\n    checkZoneAutoExit,\n    getRoomState: () => roomState,\n    isActive: () => active\n  };\n}\n"},{"path":"src/game/speakingAndAchievements.ts","encoding":"utf8","content":"import {\n  AchievementDef,\n  AchievementId,\n  Member,\n  RobotSkinId,\n  SpeakingBankQuestion,\n  SpeakingLevel,\n  TaskItem,\n} from '../types/b2ks';\n\nexport const SPEAKING_BANK_VERSION = 1;\n\nexport const ROBOT_SKIN_OPTIONS: Array<{\n  id: RobotSkinId;\n  name: string;\n  icon: string;\n  badgeColor: string;\n  desc: string;\n}> = [\n  {\n    id: 'doraemon',\n    name: 'Robot Mèo Máy (Doraemon)',\n    icon: '🐱',\n    badgeColor: '#0284C7',\n    desc: 'Tròn trĩnh xanh dương, chuông vàng & túi thần kỳ trước bụng',\n  },\n  {\n    id: 'doraemi',\n    name: 'Robot Mèo Vàng (Doraemi)',\n    icon: '🎀',\n    badgeColor: '#EAB308',\n    desc: 'Màu vàng tươi đáng yêu, nơ đỏ lớn trên đầu, chuông vàng & túi thần kỳ',\n  },\n  {\n    id: 'gundam',\n    name: 'Robot Chiến Binh (Gundam)',\n    icon: '🤖',\n    badgeColor: '#2563EB',\n    desc: 'Giáp V-Fin trắng xanh đỏ mạnh mẽ, vai giáp cánh phản lực',\n  },\n  {\n    id: 'walle',\n    name: 'Robot Thám Hiểm (WALL-E)',\n    icon: '🦾',\n    badgeColor: '#D97706',\n    desc: 'Thân khối vàng đất thân thiện, đôi mắt ống nhòm đáng yêu',\n  },\n];\n\nexport const ACHIEVEMENT_CATALOG: AchievementDef[] = [\n  {\n    id: 'first_task',\n    title: 'Khởi Đầu Chăm Chỉ',\n    description: 'Hoàn thành nhiệm vụ đầu tiên (1st Task)',\n    icon: '🌟',\n    category: 'tasks',\n    color: '#F59E0B',\n    target: 1,\n  },\n  {\n    id: 'tasks_10',\n    title: 'Chiến Binh Chăm Chỉ',\n    description: 'Hoàn thành tổng cộng 10 nhiệm vụ',\n    icon: '🧹',\n    category: 'tasks',\n    color: '#10B981',\n    target: 10,\n  },\n  {\n    id: 'tasks_50',\n    title: 'Siêu Sao Nhiệm Vụ',\n    description: 'Hoàn thành tổng cộng 50 nhiệm vụ',\n    icon: '🏅',\n    category: 'tasks',\n    color: '#2563EB',\n    target: 50,\n  },\n  {\n    id: 'tasks_100',\n    title: 'Huyền Thoại Gia Đình',\n    description: 'Hoàn thành tổng cộng 100 nhiệm vụ',\n    icon: '👑',\n    category: 'tasks',\n    color: '#7C3AED',\n    target: 100,\n  },\n  {\n    id: 'eng_words_50',\n    title: 'Nhà Sưu Tầm Từ Vựng',\n    description: 'Sử dụng 50 từ tiếng Anh khác nhau',\n    icon: '🔤',\n    category: 'english',\n    color: '#0EA5E9',\n    target: 50,\n  },\n  {\n    id: 'eng_words_200',\n    title: 'Học Giả Song Ngữ',\n    description: 'Sử dụng 200 từ tiếng Anh khác nhau',\n    icon: '📘',\n    category: 'english',\n    color: '#4F46E5',\n    target: 200,\n  },\n  {\n    id: 'eng_words_500',\n    title: 'Bậc Thầy Ngôn Ngữ',\n    description: 'Sử dụng 500 từ tiếng Anh khác nhau',\n    icon: '🎓',\n    category: 'english',\n    color: '#DB2777',\n    target: 500,\n  },\n  {\n    id: 'eng_quiz_perfect',\n    title: 'Điểm 10 Hoàn Hảo',\n    description: 'Đạt điểm tuyệt đối 10/10 trong bài kiểm tra Tiếng Anh',\n    icon: '💯',\n    category: 'english',\n    color: '#E11D48',\n    target: 1,\n  },\n  {\n    id: 'eng_quiz_10',\n    title: 'Học Sinh Chăm Chỉ',\n    description: 'Hoàn thành 10 lượt bài tập tại Trung Tâm Tiếng Anh',\n    icon: '✏️',\n    category: 'english',\n    color: '#0D9488',\n    target: 10,\n  },\n  {\n    id: 'speak_first',\n    title: 'Lời Chào Đầu Tiên',\n    description: 'Giao tiếp với người nước ngoài đạt >= 80% lần đầu',\n    icon: '🗣️',\n    category: 'english',\n    color: '#0284C7',\n    target: 1,\n  },\n  {\n    id: 'speak_95',\n    title: 'Phát Âm Chuẩn Xác',\n    description: 'Đạt độ chính xác phát âm >= 95% với bạn nước ngoài',\n    icon: '🎙️',\n    category: 'english',\n    color: '#16A34A',\n    target: 1,\n  },\n  {\n    id: 'speak_lv3',\n    title: 'Giao Tiếp Tự Tin',\n    description: 'Thăng hạng đạt Speaking Level 3',\n    icon: '🌍',\n    category: 'english',\n    color: '#EA580C',\n    target: 3,\n  },\n  {\n    id: 'speak_lv5',\n    title: 'Sứ Giả Tiếng Anh',\n    description: 'Chinh phục Speaking Level 5 (cấp độ cao nhất)',\n    icon: '🏆',\n    category: 'english',\n    color: '#CA8A04',\n    target: 5,\n  },\n  {\n    id: 'comic_5',\n    title: 'Mọt Sách Tiếng Anh',\n    description: 'Đọc hoàn thành 5 cuốn truyện tranh Tiếng Anh',\n    icon: '📚',\n    category: 'world',\n    color: '#9333EA',\n    target: 5,\n  },\n  {\n    id: 'pet_first',\n    title: 'Người Bạn Thú Cưng',\n    description: 'Ấp nở thành công thú cưng đầu tiên',\n    icon: '🐾',\n    category: 'world',\n    color: '#F97316',\n    target: 1,\n  },\n  {\n    id: 'zoo_10',\n    title: 'Nhà Khám Phá Sở Thú',\n    description: 'Mở khóa 10 loài động vật trong Sở Thú Ảo',\n    icon: '🦁',\n    category: 'world',\n    color: '#059669',\n    target: 10,\n  },\n];\n\nexport const DEFAULT_SPEAKING_BANK: SpeakingBankQuestion[] = [\n  // ================= LEVEL 1: Basic Greetings & Daily Life =================\n  { id: 'spk_1_01', level: 1, topic: 'Greetings', sentence: 'Hello, nice to meet you today.', meaningVi: 'Xin chào, rất vui được gặp bạn hôm nay.' },\n  { id: 'spk_1_02', level: 1, topic: 'Greetings', sentence: 'Good morning, how are you doing?', meaningVi: 'Chào buổi sáng, bạn có khỏe không?' },\n  { id: 'spk_1_03', level: 1, topic: 'Greetings', sentence: 'I am very happy to see you.', meaningVi: 'Mình rất vui khi được gặp bạn.' },\n  { id: 'spk_1_04', level: 1, topic: 'Introduction', sentence: 'My name is Anna and I live here.', meaningVi: 'Tên mình là Anna và mình sống ở đây.' },\n  { id: 'spk_1_05', level: 1, topic: 'Daily Life', sentence: 'The weather is sunny and warm today.', meaningVi: 'Thời tiết hôm nay có nắng và ấm áp.' },\n  { id: 'spk_1_06', level: 1, topic: 'Daily Life', sentence: 'I like playing football in the park.', meaningVi: 'Mình thích chơi bóng đá ở công viên.' },\n  { id: 'spk_1_07', level: 1, topic: 'Family', sentence: 'I love my family very much.', meaningVi: 'Mình yêu gia đình của mình rất nhiều.' },\n  { id: 'spk_1_08', level: 1, topic: 'School', sentence: 'This is my favorite English book.', meaningVi: 'Đây là quyển sách tiếng Anh yêu thích của mình.' },\n  { id: 'spk_1_09', level: 1, topic: 'Pets', sentence: 'My cute puppy likes to eat snacks.', meaningVi: 'Chú cún dễ thương của mình thích ăn đồ ăn vặt.' },\n  { id: 'spk_1_10', level: 1, topic: 'Food', sentence: 'I drink a glass of fresh milk.', meaningVi: 'Mình uống một ly sữa tươi.' },\n  { id: 'spk_1_11', level: 1, topic: 'Colors', sentence: 'Look at the big blue sky above.', meaningVi: 'Hãy nhìn bầu trời xanh rộng lớn ở trên cao.' },\n  { id: 'spk_1_12', level: 1, topic: 'Polite', sentence: 'Thank you so much for your help.', meaningVi: 'Cảm ơn bạn rất nhiều vì sự giúp đỡ.' },\n  { id: 'spk_1_13', level: 1, topic: 'Home', sentence: 'My bedroom is clean and tidy now.', meaningVi: 'Phòng ngủ của mình bây giờ sạch sẽ và gọn gàng.' },\n  { id: 'spk_1_14', level: 1, topic: 'Friends', sentence: 'We are best friends in this town.', meaningVi: 'Chúng ta là những người bạn thân nhất ở thị trấn này.' },\n  { id: 'spk_1_15', level: 1, topic: 'Hobbies', sentence: 'I like drawing colorful flowers and trees.', meaningVi: 'Mình thích vẽ hoa và cây nhiều màu sắc.' },\n  { id: 'spk_1_16', level: 1, topic: 'Greetings', sentence: 'See you again tomorrow morning, friend.', meaningVi: 'Hẹn gặp lại bạn vào sáng mai nhé, bạn ơi.' },\n\n  // ================= LEVEL 2: Routines, Home & Neighborhood =================\n  { id: 'spk_2_01', level: 2, topic: 'Routines', sentence: 'I brush my teeth after eating breakfast.', meaningVi: 'Mình đánh răng sau khi ăn bữa sáng.' },\n  { id: 'spk_2_02', level: 2, topic: 'Routines', sentence: 'Every morning I wake up at six.', meaningVi: 'Mỗi buổi sáng mình thức dậy lúc sáu giờ.' },\n  { id: 'spk_2_03', level: 2, topic: 'Chores', sentence: 'I always help my parents clean the floor.', meaningVi: 'Mình luôn giúp bố mẹ lau dọn sàn nhà.' },\n  { id: 'spk_2_04', level: 2, topic: 'Neighborhood', sentence: 'There is a supermarket next to the street.', meaningVi: 'Có một siêu thị ở ngay bên cạnh con đường.' },\n  { id: 'spk_2_05', level: 2, topic: 'School', sentence: 'My English teacher is kind and funny.', meaningVi: 'Cô giáo tiếng Anh của mình rất tốt bụng và vui tính.' },\n  { id: 'spk_2_06', level: 2, topic: 'Hobbies', sentence: 'On Sundays I enjoy reading comic stories.', meaningVi: 'Vào Chủ nhật mình thích đọc truyện tranh.' },\n  { id: 'spk_2_07', level: 2, topic: 'Food', sentence: 'My mom cooks delicious noodles for dinner.', meaningVi: 'Mẹ mình nấu món mì thật ngon cho bữa tối.' },\n  { id: 'spk_2_08', level: 2, topic: 'Animals', sentence: 'We can see giraffes and lions at the zoo.', meaningVi: 'Chúng ta có thể thấy hươu cao cổ và sư tử ở sở thú.' },\n  { id: 'spk_2_09', level: 2, topic: 'Weather', sentence: 'Take an umbrella because it might rain.', meaningVi: 'Hãy mang theo ô vì trời có thể sẽ mưa.' },\n  { id: 'spk_2_10', level: 2, topic: 'Direction', sentence: 'Walk straight ahead and turn left here.', meaningVi: 'Đi thẳng về phía trước rồi rẽ trái ở đây.' },\n  { id: 'spk_2_11', level: 2, topic: 'Sports', sentence: 'Swimming in summer keeps my body strong.', meaningVi: 'Bơi lội vào mùa hè giúp cơ thể mình khỏe mạnh.' },\n  { id: 'spk_2_12', level: 2, topic: 'Music', sentence: 'She plays the piano in the living room.', meaningVi: 'Cô ấy chơi đàn piano ở trong phòng khách.' },\n  { id: 'spk_2_13', level: 2, topic: 'Shopping', sentence: 'How many stars does this cute hat cost?', meaningVi: 'Chiếc mũ dễ thương này có giá bao nhiêu sao?' },\n  { id: 'spk_2_14', level: 2, topic: 'Time', sentence: 'We usually finish our homework before eight.', meaningVi: 'Chúng mình thường làm xong bài tập trước tám giờ.' },\n  { id: 'spk_2_15', level: 2, topic: 'Nature', sentence: 'Green trees give us fresh air every day.', meaningVi: 'Cây xanh mang lại cho chúng ta không khí trong lành mỗi ngày.' },\n  { id: 'spk_2_16', level: 2, topic: 'Pets', sentence: 'Do not forget to feed your little cat.', meaningVi: 'Đừng quên cho chú mèo nhỏ của bạn ăn nhé.' },\n\n  // ================= LEVEL 3: Descriptions, Travel & Stories =================\n  { id: 'spk_3_01', level: 3, topic: 'Neighborhood', sentence: 'Our neighborhood looks lively with colorful trees and bright lamps.', meaningVi: 'Khu phố của chúng mình trông thật sinh động với cây cối rực rỡ và đèn đường sáng.' },\n  { id: 'spk_3_02', level: 3, topic: 'Learning', sentence: 'Practicing English every single day makes me feel more confident.', meaningVi: 'Luyện tập tiếng Anh mỗi ngày khiến mình cảm thấy tự tin hơn.' },\n  { id: 'spk_3_03', level: 3, topic: 'Teamwork', sentence: 'Working together with my sister helps us finish chores quickly.', meaningVi: 'Làm việc cùng chị em giúp chúng mình hoàn thành việc nhà thật nhanh.' },\n  { id: 'spk_3_04', level: 3, topic: 'Science', sentence: 'I visited the invention lab to build a shiny spaceship.', meaningVi: 'Mình đã ghé phòng thí nghiệm để chế tạo một con tàu vũ trụ lấp lánh.' },\n  { id: 'spk_3_05', level: 3, topic: 'Travel', sentence: 'Last weekend my family went camping near a peaceful river.', meaningVi: 'Cuối tuần trước gia đình mình đã đi cắm trại gần một dòng sông yên bình.' },\n  { id: 'spk_3_06', level: 3, topic: 'Health', sentence: 'Eating fresh vegetables and drinking enough water keeps us healthy.', meaningVi: 'Ăn rau tươi và uống đủ nước giúp chúng ta luôn khỏe mạnh.' },\n  { id: 'spk_3_07', level: 3, topic: 'Culture', sentence: 'People from different countries speak many interesting languages.', meaningVi: 'Mọi người từ các quốc gia khác nhau nói nhiều ngôn ngữ thú vị.' },\n  { id: 'spk_3_08', level: 3, topic: 'School', sentence: 'My favorite subject at school is science because we do experiments.', meaningVi: 'Môn học yêu thích ở trường của mình là khoa học vì chúng mình được làm thí nghiệm.' },\n  { id: 'spk_3_09', level: 3, topic: 'Dreams', sentence: 'When I grow up I want to design smart helper robots.', meaningVi: 'Khi lớn lên mình muốn thiết kế những chú robot trợ lý thông minh.' },\n  { id: 'spk_3_10', level: 3, topic: 'Kindness', sentence: 'Sharing toys and smiling at neighbors brings joy to everyone.', meaningVi: 'Chia sẻ đồ chơi và mỉm cười với hàng xóm mang lại niềm vui cho mọi người.' },\n  { id: 'spk_3_11', level: 3, topic: 'Festivals', sentence: 'During Lunar New Year our house is decorated with yellow blossoms.', meaningVi: 'Vào dịp Tết Nguyên Đán nhà mình được trang trí bằng hoa mai vàng.' },\n  { id: 'spk_3_12', level: 3, topic: 'Technology', sentence: 'Modern tablets can help students learn new vocabulary faster.', meaningVi: 'Máy tính bảng hiện đại có thể giúp học sinh học từ vựng mới nhanh hơn.' },\n  { id: 'spk_3_13', level: 3, topic: 'Environment', sentence: 'Remember to turn off the lights before leaving your room.', meaningVi: 'Hãy nhớ tắt đèn trước khi rời khỏi phòng của bạn nhé.' },\n  { id: 'spk_3_14', level: 3, topic: 'Reading', sentence: 'Reading adventure stories before bedtime sparks my imagination.', meaningVi: 'Đọc truyện phiêu lưu trước giờ đi ngủ khơi gợi trí tưởng tượng của mình.' },\n  { id: 'spk_3_15', level: 3, topic: 'Sports', sentence: 'Even when we lose a match, we always cheer for good sportsmanship.', meaningVi: 'Ngay cả khi thua một trận đấu, chúng mình vẫn cổ vũ tinh thần thể thao đẹp.' },\n  { id: 'spk_3_16', level: 3, topic: 'Friends', sentence: 'Excuse me, could you tell me the way to the English center?', meaningVi: 'Xin lỗi, bạn có thể chỉ cho mình đường tới Trung tâm Tiếng Anh được không?' },\n\n  // ================= LEVEL 4: Opinions, Planning & Explanations =================\n  { id: 'spk_4_01', level: 4, topic: 'Planning', sentence: 'If I finish my homework early tonight, I will visit the virtual zoo.', meaningVi: 'Nếu tối nay mình làm xong bài tập sớm, mình sẽ đi thăm sở thú ảo.' },\n  { id: 'spk_4_02', level: 4, topic: 'Opinions', sentence: 'I believe learning to speak fluently is just as important as writing.', meaningVi: 'Mình tin rằng học nói trôi chảy cũng quan trọng ngang với kỹ năng viết.' },\n  { id: 'spk_4_03', level: 4, topic: 'Environment', sentence: 'Planting more trees along the sidewalks reduces heat during sunny afternoons.', meaningVi: 'Trồng thêm cây dọc theo vỉa hè giúp giảm nhiệt độ vào những buổi chiều nắng.' },\n  { id: 'spk_4_04', level: 4, topic: 'Responsibility', sentence: 'Completing every task before the deadline earns us full star rewards.', meaningVi: 'Hoàn thành mọi nhiệm vụ trước hạn chót giúp chúng ta nhận trọn vẹn điểm thưởng.' },\n  { id: 'spk_4_05', level: 4, topic: 'Pets', sentence: 'Taking care of a pet teaches children patience and responsibility every day.', meaningVi: 'Việc chăm sóc thú cưng dạy cho trẻ em tính kiên nhẫn và trách nhiệm mỗi ngày.' },\n  { id: 'spk_4_06', level: 4, topic: 'Conversation', sentence: 'Would you mind repeating that sentence a little more slowly for me?', meaningVi: 'Bạn có phiền nhắc lại câu đó chậm hơn một chút cho mình nghe được không?' },\n  { id: 'spk_4_07', level: 4, topic: 'Achievement', sentence: 'Unlocking new achievement badges motivates me to explore every corner of town.', meaningVi: 'Việc mở khóa các huy hiệu thành tựu mới tạo động lực để mình khám phá khắp thị trấn.' },\n  { id: 'spk_4_08', level: 4, topic: 'History', sentence: 'Visiting museums lets us discover amazing inventions from past centuries.', meaningVi: 'Đi thăm bảo tàng giúp chúng ta khám phá những phát minh kỳ diệu từ các thế kỷ trước.' },\n  { id: 'spk_4_09', level: 4, topic: 'Community', sentence: 'Although we live in a busy city, neighbors always look out for one another.', meaningVi: 'Mặc dù sống trong thành phố bận rộn, hàng xóm vẫn luôn quan tâm lẫn nhau.' },\n  { id: 'spk_4_10', level: 4, topic: 'Study Tips', sentence: 'Whenever I hear a new word, I write it down and use it in a sentence.', meaningVi: 'Bất cứ khi nào nghe một từ mới, mình đều ghi lại và đặt câu với từ đó.' },\n  { id: 'spk_4_11', level: 4, topic: 'Robotics', sentence: 'Our family helper robot reminds us gently whenever an important chore begins.', meaningVi: 'Robot trợ lý gia đình nhắc nhở chúng mình nhẹ nhàng mỗi khi tới giờ làm việc quan trọng.' },\n  { id: 'spk_4_12', level: 4, topic: 'Nutrition', sentence: 'A balanced breakfast gives students steady energy throughout the morning classes.', meaningVi: 'Một bữa sáng cân bằng dinh dưỡng mang lại năng lượng bền bỉ suốt buổi học sáng.' },\n  { id: 'spk_4_13', level: 4, topic: 'Creativity', sentence: 'Mixing two ordinary objects together in the lab can create something extraordinary.', meaningVi: 'Kết hợp hai đồ vật bình thường trong phòng thí nghiệm có thể tạo ra thứ phi thường.' },\n  { id: 'spk_4_14', level: 4, topic: 'Travel', sentence: 'We should check the local weather forecast before organizing an outdoor picnic.', meaningVi: 'Chúng ta nên kiểm tra dự báo thời tiết trước khi tổ chức buổi dã ngoại ngoài trời.' },\n  { id: 'spk_4_15', level: 4, topic: 'Cooperation', sentence: 'Because both siblings cooperated well, the living room looked spotless in ten minutes.', meaningVi: 'Vì cả hai anh chị em phối hợp ăn ý, phòng khách đã sạch bong chỉ trong mười phút.' },\n  { id: 'spk_4_16', level: 4, topic: 'Respect', sentence: 'Always knock politely and ask permission before entering someone else’s private room.', meaningVi: 'Luôn gõ cửa lịch sự và xin phép trước khi bước vào phòng riêng của người khác.' },\n\n  // ================= LEVEL 5: Fluent Expression & Global Perspectives =================\n  { id: 'spk_5_01', level: 5, topic: 'Communication', sentence: 'Speaking directly with international visitors is one of the best ways to master pronunciation.', meaningVi: 'Trò chuyện trực tiếp với du khách quốc tế là một trong những cách tốt nhất để làm chủ phát âm.' },\n  { id: 'spk_5_02', level: 5, topic: 'Sustainability', sentence: 'If every household recycled plastic bottles and conserved electricity, our planet would become cleaner.', meaningVi: 'Nếu mỗi hộ gia đình đều tái chế chai nhựa và tiết kiệm điện, hành tinh của chúng ta sẽ sạch đẹp hơn.' },\n  { id: 'spk_5_03', level: 5, topic: 'Self-Growth', sentence: 'Making mistakes while practicing a foreign language is completely natural on the path to fluency.', meaningVi: 'Mắc lỗi khi luyện tập ngoại ngữ là điều hoàn toàn tự nhiên trên con đường hướng tới sự trôi chảy.' },\n  { id: 'spk_5_04', level: 5, topic: 'Digital Habits', sentence: 'Managing screen time wisely allows children to balance entertainment with physical exercise and reading.', meaningVi: 'Quản lý thời gian dùng thiết bị hợp lý giúp trẻ cân bằng giữa giải trí với vận động và đọc sách.' },\n  { id: 'spk_5_05', level: 5, topic: 'Global Village', sentence: 'Understanding different traditions encourages mutual respect and builds lasting friendships across borders.', meaningVi: 'Thấu hiểu các truyền thống khác nhau khuyến khích sự tôn trọng lẫn nhau và xây dựng tình bạn bền lâu.' },\n  { id: 'spk_5_06', level: 5, topic: 'Curiosity', sentence: 'Scientists stay curious by asking thoughtful questions about how everyday things actually work.', meaningVi: 'Các nhà khoa học giữ sự tò mò bằng cách đặt câu hỏi sâu sắc về cách mọi thứ quanh ta vận hành.' },\n  { id: 'spk_5_07', level: 5, topic: 'Time Management', sentence: 'Prioritizing urgent assignments before playtime prevents unnecessary stress right before the deadline.', meaningVi: 'Ưu tiên bài tập gấp trước giờ chơi giúp tránh căng thẳng không cần thiết ngay sát hạn chót.' },\n  { id: 'spk_5_08', level: 5, topic: 'Persistence', sentence: 'Achieving five consecutive successful conversations proves how dedicated you have been to learning.', meaningVi: 'Đạt năm cuộc hội thoại thành công liên tiếp chứng minh bạn đã kiên trì học tập đến nhường nào.' },\n  { id: 'spk_5_09', level: 5, topic: 'Empathy', sentence: 'Listening attentively when others share their feelings strengthens trust within the whole family.', meaningVi: 'Lắng nghe chăm chú khi người khác chia sẻ cảm xúc giúp củng cố niềm tin trong cả gia đình.' },\n  { id: 'spk_5_10', level: 5, topic: 'Innovation', sentence: 'Future cities will combine green parks with clean energy and helpful autonomous assistants.', meaningVi: 'Các thành phố tương lai sẽ kết hợp công viên xanh với năng lượng sạch và trợ lý tự hành hữu ích.' },\n  { id: 'spk_5_11', level: 5, topic: 'Wildlife', sentence: 'Protecting endangered wildlife habitats ensures future generations can admire biodiversity in person.', meaningVi: 'Bảo vệ môi trường sống của động vật quý hiếm đảm bảo thế hệ tương lai được chiêm ngưỡng đa dạng sinh học.' },\n  { id: 'spk_5_12', level: 5, topic: 'Gratitude', sentence: 'Appreciating small daily moments with loved ones turns an ordinary afternoon into a cherished memory.', meaningVi: 'Trân trọng những khoảnh khắc nhỏ mỗi ngày bên người thân biến buổi chiều bình thường thành kỷ niệm quý giá.' },\n  { id: 'spk_5_13', level: 5, topic: 'Leadership', sentence: 'A great team leader inspires everyone to contribute their unique strengths toward a shared goal.', meaningVi: 'Một trưởng nhóm giỏi truyền cảm hứng để mọi người đóng góp thế mạnh riêng hướng tới mục tiêu chung.' },\n  { id: 'spk_5_14', level: 5, topic: 'Critical Thinking', sentence: 'Before believing everything we read online, we should carefully verify facts from reliable sources.', meaningVi: 'Trước khi tin mọi thứ đọc trên mạng, chúng ta nên kiểm chứng thông tin cẩn thận từ nguồn đáng tin cậy.' },\n  { id: 'spk_5_15', level: 5, topic: 'Culture Exchange', sentence: 'I would love to introduce traditional Vietnamese cuisine and warm hospitality to travelers worldwide.', meaningVi: 'Mình rất muốn giới thiệu ẩm thực truyền thống Việt Nam và lòng hiếu khách tới du khách khắp thế giới.' },\n  { id: 'spk_5_16', level: 5, topic: 'Confidence', sentence: 'Regardless of how challenging a sentence seems at first, steady practice eventually makes it effortless.', meaningVi: 'Dù một câu ban đầu có vẻ khó đến đâu, luyện tập đều đặn cuối cùng cũng giúp bạn nói nhẹ nhàng.' },\n];\n\nexport function extractEnglishWords(text: string): string[] {\n  const matches = String(text || '')\n    .toLowerCase()\n    .match(/[a-z]{2,}/g);\n  if (!matches) return [];\n  return Array.from(new Set(matches));\n}\n\nexport function getTotalCompletedTasksForMember(member: Member, tasks: TaskItem[]): number {\n  const taskListCount = (tasks || []).filter(\n    (t) =>\n      t.status === 'completed' &&\n      (t.assigneeId === member.id || (t.participantIds || []).includes(member.id))\n  ).length;\n  return Math.max(Number(member.completedTaskCount) || 0, taskListCount);\n}\n\nexport function getAchievementProgress(\n  achId: AchievementId | string,\n  member: Member,\n  tasks: TaskItem[]\n): { current: number; target: number; unlocked: boolean } {\n  const def = ACHIEVEMENT_CATALOG.find((a) => a.id === achId);\n  const target = def?.target || 1;\n  const unlockedArr = Array.isArray(member.unlockedAchievements) ? member.unlockedAchievements : [];\n  const alreadyUnlocked = unlockedArr.some((u) => u && u.id === achId);\n\n  const tasksDone = getTotalCompletedTasksForMember(member, tasks);\n  const wordsCount = Array.isArray(member.englishWordsUsed) ? member.englishWordsUsed.length : 0;\n  const quizHist = member.englishQuizHistory || [];\n  const hasPerfectQuiz = quizHist.some((q) => q.total > 0 && q.score >= q.total);\n  const speakHist = member.speakingHistory || [];\n  const passSpeakCount = speakHist.filter((s) => s.accuracy >= 80).length;\n  const hasSpeak95 = speakHist.some((s) => s.accuracy >= 95);\n  const speakLv = Math.max(1, Number(member.speakingLevel) || 1);\n  const comicCount = member.comicReadStats?.completedIds?.length || 0;\n  const hatchedPetsCount = (member.pets || []).filter((p) => p.hatched).length;\n  const zooCount = (member.unlockedZooAnimals || []).length;\n\n  let current = 0;\n  switch (achId) {\n    case 'first_task':\n    case 'tasks_10':\n    case 'tasks_50':\n    case 'tasks_100':\n      current = tasksDone;\n      break;\n    case 'eng_words_50':\n    case 'eng_words_200':\n    case 'eng_words_500':\n      current = wordsCount;\n      break;\n    case 'eng_quiz_perfect':\n      current = hasPerfectQuiz || alreadyUnlocked ? 1 : 0;\n      break;\n    case 'eng_quiz_10':\n      current = quizHist.length;\n      break;\n    case 'speak_first':\n      current = passSpeakCount > 0 || alreadyUnlocked ? 1 : 0;\n      break;\n    case 'speak_95':\n      current = hasSpeak95 || alreadyUnlocked ? 1 : 0;\n      break;\n    case 'speak_lv3':\n    case 'speak_lv5':\n      current = speakLv;\n      break;\n    case 'comic_5':\n      current = comicCount;\n      break;\n    case 'pet_first':\n      current = hatchedPetsCount > 0 || alreadyUnlocked ? 1 : 0;\n      break;\n    case 'zoo_10':\n      current = zooCount;\n      break;\n    default:\n      current = alreadyUnlocked ? target : 0;\n  }\n\n  return {\n    current: Math.min(target, Math.max(0, current)),\n    target,\n    unlocked: alreadyUnlocked || current >= target,\n  };\n}\n\nexport function evaluateMemberAchievements(member: Member, tasks: TaskItem[]): AchievementDef[] {\n  if (!Array.isArray(member.unlockedAchievements)) {\n    member.unlockedAchievements = [];\n  }\n  const existing = new Set(member.unlockedAchievements.map((u) => u.id));\n  const newlyUnlocked: AchievementDef[] = [];\n  ACHIEVEMENT_CATALOG.forEach((def) => {\n    if (existing.has(def.id)) return;\n    const prog = getAchievementProgress(def.id, member, tasks);\n    if (prog.current >= prog.target) {\n      newlyUnlocked.push(def);\n    }\n  });\n  return newlyUnlocked;\n}\n\nfunction normalizeSpeechToken(tok: string): string {\n  return String(tok || '')\n    .toLowerCase()\n    .replace(/['’]s\\b/g, 's')\n    .replace(/[^a-z0-9]/g, '');\n}\n\nfunction levenshteinDist(a: string, b: string): number {\n  if (a === b) return 0;\n  if (!a.length) return b.length;\n  if (!b.length) return a.length;\n  const dp: number[] = Array.from({ length: b.length + 1 }, (_, i) => i);\n  for (let i = 1; i <= a.length; i++) {\n    let prev = i - 1;\n    dp[0] = i;\n    for (let j = 1; j <= b.length; j++) {\n      const tmp = dp[j];\n      const cost = a[i - 1] === b[j - 1] ? 0 : 1;\n      dp[j] = Math.min(dp[j] + 1, dp[j - 1] + 1, prev + cost);\n      prev = tmp;\n    }\n  }\n  return dp[b.length];\n}\n\nexport function scoreSpeakingPronunciation(\n  targetSentence: string,\n  spokenText: string\n): {\n  accuracy: number;\n  wordMatches: Array<{ word: string; hit: boolean }>;\n  feedback: string;\n} {\n  const rawWords = String(targetSentence || '')\n    .split(/\\s+/)\n    .map((w) => w.trim())\n    .filter(Boolean);\n  const targetTokens = rawWords.map((w) => normalizeSpeechToken(w));\n  const spokenTokens = String(spokenText || '')\n    .split(/\\s+/)\n    .map(normalizeSpeechToken)\n    .filter(Boolean);\n\n  if (targetTokens.length === 0 || spokenTokens.length === 0) {\n    return {\n      accuracy: 0,\n      wordMatches: rawWords.map((w) => ({ word: w, hit: false })),\n      feedback: 'Chưa nhận được giọng nói tiếng Anh.',\n    };\n  }\n\n  const remainingSpoken = [...spokenTokens];\n  let totalWeight = 0;\n  let validTargetCount = 0;\n  const wordMatches: Array<{ word: string; hit: boolean }> = [];\n\n  targetTokens.forEach((t, idx) => {\n    const displayWord = rawWords[idx] || t;\n    if (!t) {\n      wordMatches.push({ word: displayWord, hit: true });\n      return;\n    }\n    validTargetCount += 1;\n    const exactIdx = remainingSpoken.indexOf(t);\n    if (exactIdx !== -1) {\n      totalWeight += 1;\n      wordMatches.push({ word: displayWord, hit: true });\n      remainingSpoken.splice(exactIdx, 1);\n      return;\n    }\n    let bestIdx = -1;\n    let bestSim = 0;\n    remainingSpoken.forEach((s, sIdx) => {\n      const maxLen = Math.max(t.length, s.length);\n      if (maxLen === 0) return;\n      const d = levenshteinDist(t, s);\n      const sim = 1 - d / maxLen;\n      if (sim > bestSim) {\n        bestSim = sim;\n        bestIdx = sIdx;\n      }\n    });\n    if (bestIdx !== -1 && bestSim >= 0.7) {\n      totalWeight += bestSim >= 0.85 ? 0.92 : 0.78;\n      wordMatches.push({ word: displayWord, hit: true });\n      remainingSpoken.splice(bestIdx, 1);\n    } else {\n      wordMatches.push({ word: displayWord, hit: false });\n    }\n  });\n\n  const denom = Math.max(1, validTargetCount);\n  const lengthRatio = Math.min(1, denom / Math.max(1, spokenTokens.length * 0.85));\n  const rawPct = (totalWeight / denom) * (0.85 + 0.15 * lengthRatio) * 100;\n  const accuracy = Math.max(0, Math.min(100, Math.round(rawPct)));\n\n  let feedback = 'Hãy cố gắng đọc chậm, rõ từng từ và thử lại nhé!';\n  if (accuracy >= 95) feedback = 'Xuất sắc! Phát âm cực kỳ tự nhiên và chuẩn xác!';\n  else if (accuracy >= 80) feedback = 'Tuyệt vời! Bạn đã giao tiếp đạt chuẩn >= 80%!';\n  else if (accuracy >= 60) feedback = 'Khá tốt rồi, nhưng cần >= 80% mới được cộng sao nhé!';\n\n  return { accuracy, wordMatches, feedback };\n}\n\nfunction escapeCsvCell(val: string | number): string {\n  const s = String(val ?? '');\n  if (/[\",\\n\\r]/.test(s)) {\n    return `\"${s.replace(/\"/g, '\"\"')}\"`;\n  }\n  return s;\n}\n\nfunction parseCsvRows(csvText: string): string[][] {\n  const text = csvText.replace(/^\\uFEFF/, '');\n  const rows: string[][] = [];\n  let row: string[] = [];\n  let cell = '';\n  let inQuotes = false;\n\n  for (let i = 0; i < text.length; i++) {\n    const ch = text[i];\n    if (inQuotes) {\n      if (ch === '\"') {\n        if (text[i + 1] === '\"') {\n          cell += '\"';\n          i += 1;\n        } else {\n          inQuotes = false;\n        }\n      } else {\n        cell += ch;\n      }\n    } else if (ch === '\"') {\n      inQuotes = true;\n    } else if (ch === ',') {\n      row.push(cell);\n      cell = '';\n    } else if (ch === '\\n' || ch === '\\r') {\n      if (ch === '\\r' && text[i + 1] === '\\n') i += 1;\n      row.push(cell);\n      if (row.some((c) => c.trim() !== '')) rows.push(row);\n      row = [];\n      cell = '';\n    } else {\n      cell += ch;\n    }\n  }\n  row.push(cell);\n  if (row.some((c) => c.trim() !== '')) rows.push(row);\n  return rows;\n}\n\nexport function exportSpeakingBankToCsv(items: SpeakingBankQuestion[]): string {\n  const header = ['id', 'level', 'topic', 'sentence', 'meaningVi'];\n  const lines = [header.join(',')];\n  items.forEach((s) => {\n    lines.push(\n      [\n        escapeCsvCell(s.id),\n        escapeCsvCell(s.level),\n        escapeCsvCell(s.topic),\n        escapeCsvCell(s.sentence),\n        escapeCsvCell(s.meaningVi),\n      ].join(',')\n    );\n  });\n  return '\\uFEFF' + lines.join('\\r\\n');\n}\n\nexport function parseSpeakingBankCsv(csvText: string): {\n  questions: SpeakingBankQuestion[];\n  errors: number;\n} {\n  const rows = parseCsvRows(csvText);\n  if (rows.length < 2) {\n    return { questions: [], errors: 1 };\n  }\n  const header = rows[0].map((h) => String(h || '').trim().toLowerCase());\n  const idxOf = (names: string[]) => header.findIndex((h) => names.includes(h));\n  const idCol = idxOf(['id']);\n  const lvCol = idxOf(['level', 'lv', 'cap_do']);\n  const topicCol = idxOf(['topic', 'chu_de']);\n  const textCol = idxOf(['sentence', 'text', 'cau_tieng_anh']);\n  const viCol = idxOf(['meaningvi', 'vi', 'meaning', 'nghia']);\n\n  if (textCol === -1) {\n    return { questions: [], errors: 1 };\n  }\n\n  const questions: SpeakingBankQuestion[] = [];\n  let errors = 0;\n\n  for (let r = 1; r < rows.length; r++) {\n    const cols = rows[r];\n    const txt = (cols[textCol] || '').trim();\n    if (!txt || txt.split(/\\s+/).length < 2) {\n      errors += 1;\n      continue;\n    }\n    const rawLv = lvCol >= 0 ? Number(cols[lvCol]) : 1;\n    const level = Math.max(1, Math.min(5, Math.round(rawLv || 1))) as SpeakingLevel;\n    const topic = (topicCol >= 0 ? cols[topicCol] : 'Daily Life')?.trim() || 'Daily Life';\n    const meaningVi = (viCol >= 0 ? cols[viCol] : '')?.trim() || '';\n    const id =\n      (idCol >= 0 ? cols[idCol]?.trim() : '') ||\n      `spk_csv_${level}_${r}_${Date.now().toString(36).slice(-4)}`;\n    questions.push({ id, level, topic, sentence: txt, meaningVi, custom: true });\n  }\n\n  return { questions, errors };\n}\n"},{"path":"src/game/svgHelpers.ts","encoding":"utf8","content":"export function renderHairIconSVG(style: string, color: string): string {\n  const faceBase = `\n    <circle cx=\"30\" cy=\"34\" r=\"15.5\" fill=\"#FFE0BD\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n    <ellipse cx=\"21.5\" cy=\"37\" rx=\"2.6\" ry=\"1.5\" fill=\"rgba(255,118,117,0.55)\"/>\n    <ellipse cx=\"38.5\" cy=\"37\" rx=\"2.6\" ry=\"1.5\" fill=\"rgba(255,118,117,0.55)\"/>\n    <circle cx=\"24.5\" cy=\"34.5\" r=\"2.2\" fill=\"#2C3E50\"/><circle cx=\"23.9\" cy=\"33.8\" r=\"0.8\" fill=\"#FFF\"/>\n    <circle cx=\"35.5\" cy=\"34.5\" r=\"2.2\" fill=\"#2C3E50\"/><circle cx=\"34.9\" cy=\"33.8\" r=\"0.8\" fill=\"#FFF\"/>\n    <path d=\"M27 39.5 Q30 42 33 39.5\" fill=\"none\" stroke=\"#C0392B\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n  `;\n  const shineArc = `<path d=\"M21 22 Q30 16 39 22\" fill=\"none\" stroke=\"rgba(255,255,255,0.35)\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>`;\n\n  if (style === 'spiky') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      ${faceBase}\n      <path d=\"M14 31 C14 14, 46 14, 46 31 L43 10 L35 18 L30 6 L24 18 L17 10 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\" stroke-linejoin=\"round\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'sidepart') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      ${faceBase}\n      <path d=\"M14 31 A16 16 0 0 1 46 28 Q39 21 33 25 Q22 29 14 31 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n      <path d=\"M29 16 Q32 23 36 24\" fill=\"none\" stroke=\"#2C3E50\" stroke-width=\"1.6\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'undercut') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      ${faceBase}\n      <rect x=\"13\" y=\"24\" width=\"4\" height=\"9\" rx=\"2\" fill=\"#2C3E50\" opacity=\"0.35\"/>\n      <rect x=\"43\" y=\"24\" width=\"4\" height=\"9\" rx=\"2\" fill=\"#2C3E50\" opacity=\"0.35\"/>\n      <path d=\"M16 26 Q18 11 32 10 Q44 11 45 25 Q35 20 26 24 Q20 22 16 26 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'bob') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <path d=\"M11 34 Q10 15 30 15 Q50 15 49 34 Q49 47 41 47 L19 47 Q11 47 11 34 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n      ${faceBase}\n      <path d=\"M15 30 A15 15 0 0 1 45 30 Q39 27 34 30 Q30 27 26 30 Q21 27 15 30 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.2\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'curly') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <circle cx=\"15\" cy=\"28\" r=\"8\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.2\"/>\n      <circle cx=\"45\" cy=\"28\" r=\"8\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.2\"/>\n      <circle cx=\"20\" cy=\"18\" r=\"8.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.2\"/>\n      <circle cx=\"40\" cy=\"18\" r=\"8.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.2\"/>\n      <circle cx=\"30\" cy=\"15\" r=\"9\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.2\"/>\n      ${faceBase}\n      <path d=\"M16 27 Q23 22 30 26 Q37 22 44 27 Q42 18 30 17 Q18 18 16 27 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n    </svg>`;\n  }\n  if (style === 'long') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <rect x=\"10\" y=\"18\" width=\"40\" height=\"36\" rx=\"12\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n      ${faceBase}\n      <path d=\"M14.5 30 A15.5 15.5 0 0 1 45.5 30 Q38 25 30 29 Q22 25 14.5 30 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'wavy') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <path d=\"M12 24 Q8 32 12 40 Q8 48 14 54 L46 54 Q52 48 48 40 Q52 32 48 24 Q44 13 30 13 Q16 13 12 24 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n      ${faceBase}\n      <path d=\"M15 29 A15.5 15.5 0 0 1 45 29 Q35 23 30 28 Q23 24 15 29 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      <circle cx=\"42\" cy=\"24\" r=\"3\" fill=\"#FF6B6B\" stroke=\"#2C3E50\" stroke-width=\"1.2\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'pigtails') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <circle cx=\"10\" cy=\"28\" r=\"8.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n      <circle cx=\"50\" cy=\"28\" r=\"8.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n      ${faceBase}\n      <path d=\"M14.5 30 A15.5 15.5 0 0 1 45.5 30 Q37 25 30 28 Q23 25 14.5 30 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      <circle cx=\"15\" cy=\"25\" r=\"3\" fill=\"#FF6B6B\" stroke=\"#2C3E50\" stroke-width=\"1.3\"/>\n      <circle cx=\"45\" cy=\"25\" r=\"3\" fill=\"#FF6B6B\" stroke=\"#2C3E50\" stroke-width=\"1.3\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'ponytail') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <path d=\"M32 10 Q48 8 50 28 Q47 36 42 33 Q42 20 32 16 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      ${faceBase}\n      <path d=\"M14.5 30 A15.5 15.5 0 0 1 45.5 30 Q37 26 30 28 Q23 26 14.5 30 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      <rect x=\"28\" y=\"12\" width=\"7\" height=\"4.5\" rx=\"2\" fill=\"#FACC15\" stroke=\"#2C3E50\" stroke-width=\"1.4\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'bun') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <circle cx=\"17\" cy=\"14\" r=\"7.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      <circle cx=\"43\" cy=\"14\" r=\"7.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      <path d=\"M14 19 L22 17\" stroke=\"#EC4899\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n      <path d=\"M38 17 L46 19\" stroke=\"#EC4899\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n      ${faceBase}\n      <path d=\"M14.5 30 A15.5 15.5 0 0 1 45.5 30 Q38 25 30 28 Q22 25 14.5 30 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  if (style === 'braids') {\n    return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n      <circle cx=\"13\" cy=\"36\" r=\"4.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <circle cx=\"12.5\" cy=\"43\" r=\"4.2\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <circle cx=\"12\" cy=\"50\" r=\"3.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <circle cx=\"47\" cy=\"36\" r=\"4.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <circle cx=\"47.5\" cy=\"43\" r=\"4.2\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <circle cx=\"48\" cy=\"50\" r=\"3.5\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      ${faceBase}\n      <path d=\"M14.5 30 A15.5 15.5 0 0 1 45.5 30 L30 26 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.3\"/>\n      <circle cx=\"12.5\" cy=\"46.5\" r=\"2\" fill=\"#38BDF8\"/>\n      <circle cx=\"47.5\" cy=\"46.5\" r=\"2\" fill=\"#38BDF8\"/>\n      ${shineArc}\n    </svg>`;\n  }\n  return `<svg width=\"50\" height=\"50\" viewBox=\"0 0 60 60\">\n    ${faceBase}\n    <path d=\"M14 31 A16 16 0 0 1 46 31 Q39 26 30 29 Q21 26 14 31 Z\" fill=\"${color}\" stroke=\"#2C3E50\" stroke-width=\"2.4\"/>\n    ${shineArc}\n  </svg>`;\n}\n\nexport function renderShirtIconSVG(opt: { color: string; pattern: string }): string {\n  let detail = '';\n  if (opt.pattern === 'collar') {\n    detail = `<polygon points=\"24,14 30,22 36,14\" fill=\"#FFFFFF\" stroke=\"#2C3E50\" stroke-width=\"1.5\"/>`;\n  } else if (opt.pattern === 'stripe') {\n    detail = `<rect x=\"17\" y=\"27\" width=\"26\" height=\"5\" fill=\"rgba(255,255,255,0.75)\"/>`;\n  } else if (opt.pattern === 'star') {\n    detail = `<text x=\"30\" y=\"34\" font-size=\"13\" text-anchor=\"middle\" fill=\"#FFE66D\">★</text>`;\n  } else if (opt.pattern === 'heart') {\n    detail = `<text x=\"30\" y=\"34\" font-size=\"13\" text-anchor=\"middle\" fill=\"#FFCDD2\">♥</text>`;\n  } else if (opt.pattern === 'vest') {\n    detail = `<polygon points=\"24,14 30,32 36,14\" fill=\"#FFFFFF\" stroke=\"#2C3E50\" stroke-width=\"1.5\"/><line x1=\"30\" y1=\"32\" x2=\"30\" y2=\"46\" stroke=\"#2C3E50\" stroke-width=\"2\"/>`;\n  }\n  return `<svg width=\"46\" height=\"46\" viewBox=\"0 0 60 60\">\n    <path d=\"M18 14 L8 22 L13 30 L17 26 L17 46 L43 46 L43 26 L47 30 L52 22 L42 14 L36 14 Q30 20 24 14 Z\" fill=\"${opt.color}\" stroke=\"#2C3E50\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n    ${detail}\n  </svg>`;\n}\n\nexport function renderPantsIconSVG(opt: { color: string; style: string }): string {\n  if (opt.style === 'skirt') {\n    return `<svg width=\"46\" height=\"46\" viewBox=\"0 0 60 60\">\n      <polygon points=\"20,14 40,14 48,44 12,44\" fill=\"${opt.color}\" stroke=\"#2C3E50\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <rect x=\"20\" y=\"14\" width=\"20\" height=\"5\" fill=\"rgba(255,255,255,0.3)\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <line x1=\"25\" y1=\"20\" x2=\"22\" y2=\"44\" stroke=\"rgba(0,0,0,0.25)\" stroke-width=\"2\"/>\n      <line x1=\"35\" y1=\"20\" x2=\"38\" y2=\"44\" stroke=\"rgba(0,0,0,0.25)\" stroke-width=\"2\"/>\n    </svg>`;\n  }\n  if (opt.style === 'shorts') {\n    return `<svg width=\"46\" height=\"46\" viewBox=\"0 0 60 60\">\n      <path d=\"M18 14 L42 14 L45 34 L32 34 L30 25 L28 34 L15 34 Z\" fill=\"${opt.color}\" stroke=\"#2C3E50\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <rect x=\"18\" y=\"14\" width=\"24\" height=\"5\" fill=\"rgba(255,255,255,0.25)\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n    </svg>`;\n  }\n  return `<svg width=\"46\" height=\"46\" viewBox=\"0 0 60 60\">\n    <path d=\"M18 14 L42 14 L44 48 L33 48 L30 27 L27 48 L16 48 Z\" fill=\"${opt.color}\" stroke=\"#2C3E50\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n    <rect x=\"18\" y=\"14\" width=\"24\" height=\"5\" fill=\"rgba(255,255,255,0.25)\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n  </svg>`;\n}\n\nexport function renderFashionItemPreviewMini(item: {\n  sub?: string;\n  shirtColor?: string;\n  shirtPattern?: string;\n  pantsColor?: string;\n  pantsStyle?: string;\n  icon?: string;\n}): string {\n  if (item.sub === 'set' && item.shirtColor && item.shirtPattern && item.pantsColor && item.pantsStyle) {\n    return `\n      <div style=\"display:flex; align-items:center; gap:2px; background:#F8F9F9; border:1.5px solid #D5D8DC; border-radius:8px; padding:3px 5px; flex-shrink:0;\">\n        ${renderShirtIconSVG({ color: item.shirtColor, pattern: item.shirtPattern }).replace('width=\"46\" height=\"46\"', 'width=\"36\" height=\"36\"')}\n        ${renderPantsIconSVG({ color: item.pantsColor, style: item.pa