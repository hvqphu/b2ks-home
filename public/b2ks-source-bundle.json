priscilla: 'Bê-rít-sin',\n  produced: 'đã sinh ra / kết quả',\n  prophecy: 'lời tiên tri',\n  prophesied: 'đã nói tiên tri',\n  prophetess: 'nữ tiên tri',\n  prosper: 'thịnh vượng',\n  purim: 'lễ Pu-rim',\n  pyramids: 'kim tự tháp',\n  quick: 'nhanh nhẹn',\n  quickly: 'mau chóng',\n  quietest: 'yên tĩnh nhất',\n  rachel: 'Ra-chên',\n  raindrops: 'những giọt mưa',\n  raise: 'khiến sống lại / nâng lên',\n  raphael: 'Ra-pha-ên',\n  reach: 'đạt tới / vươn tới',\n  reached: 'đã tới',\n  reaching: 'đang vươn tới',\n  react: 'phản ứng lại',\n  rebuilding: 'xây dựng lại',\n  rebuking: 'quở trách',\n  recorded: 'được ghi chép lại',\n  reeds: 'cây sậy',\n  refused: 'đã từ chối',\n  refusing: 'từ chối',\n  reluctant: 'ngần ngại / miễn cưỡng',\n  renew: 'đổi mới',\n  rephidim: 'Rê-phi-đim',\n  report: 'báo cáo / tin tức',\n  require: 'đòi hỏi',\n  reuben: 'Ru-bên',\n  revelation: 'Khải-huyền / sự mặc khải',\n  risked: 'đã liều mạng',\n  rocky: 'đầy đá sỏi',\n  rode: 'đã cưỡi',\n  roman: 'thuộc La Mã',\n  romans: 'Rô-ma / người La Mã',\n  rome: 'thành Rô-ma',\n  rooster: 'con gà trống',\n  rushing: 'gấp rút / thổi mạnh',\n  safely: 'bình an vô sự',\n  sailors: 'những thủy thủ',\n  scarce: 'khan hiếm',\n  scarlet: 'màu đỏ sẫm / điều',\n  'second-in-command': 'tể tướng / chức thứ hai sau vua',\n  'self-control': 'tự chủ / tiết độ',\n  sermon: 'bài giảng',\n  'seventy-seven': 'bảy mươi bảy',\n  sheba: 'nữ hoàng Sê-ba',\n  shekels: 'siếc-lơ (đơn vị bạc)',\n  shipbuilder: 'thợ đóng tàu',\n  shop: 'cửa hàng',\n  shore: 'bờ biển / bờ hồ',\n  silence: 'sự yên lặng',\n  sincere: 'thành thật / chân thành',\n  single: 'một / duy nhất',\n  sink: 'chìm xuống',\n  sirs: 'các ông / thưa các ngài',\n  sitting: 'đang ngồi',\n  sixth: 'thứ sáu',\n  slow: 'chậm chạp',\n  soar: 'bay bổng lên',\n  sodom: 'Sô-đôm',\n  soft: 'mềm mại / êm dịu',\n  someone: 'ai đó',\n  soothe: 'làm dịu lại / an ủi',\n  soundly: 'ngon giấc / say sưa',\n  soup: 'món súp / canh',\n  sown: 'được gieo ra',\n  sparrow: 'chim