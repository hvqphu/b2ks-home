lf.addEventListener('install', (event) => {\n  event.waitUntil(\n    caches.open(CACHE_NAME).then((cache) => {\n      return cache.addAll(STATIC_ASSETS).catch(() => {});\n    })\n  );\n  self.skipWaiting();\n});\n\nself.addEventListener('activate', (event) => {\n  event.waitUntil(\n    caches.keys().then((keys) =>\n      Promise.all(\n        keys.filter((key) => key !== CACHE_NAME).map((key) => caches.delete(key))\n      )\n    )\n  );\n  self.clients.claim();\n});\n\nself.addEventListener('fetch', (event) => {\n  const req = event.request;\n  if (req.method !== 'GET') return;\n  const url = new URL(req.url);\n\n  // Never cache Firebase RTDB or translation/wiki APIs aggressively; network-first with fallback\n  if (\n    url.hostname.includes('firebasedatabase.app') ||\n    url.hostname.includes('firebaseio.com') ||\n    url.hostname.includes('wikipedia.org') ||\n    url.hostname.includes('mymemory.translated.net') ||\n    url.hostname.includes('dictionaryapi.dev')\n  ) {\n    event.respondWith(\n      fetch(req).catch(() => caches.match(req))\n    );\n    return;\n  }\n\n  event.respondWith(\n    caches.match(req).then((cached) => {\n      const fetchPromise = fetch(req)\n        .then((networkResp) => {\n          if (networkResp && networkResp.status === 200 && url.origin === self.location.origin) {\n            const copy = networkResp.clone();\n            caches.open(CACHE_NAME).then((cache) => cache.put(req, copy));\n          }\n          return networkResp;\n        })\n        .catch(() => cached);\n      return cached || fetchPromise;\n    })\n  );\n});\n\nself.addEventListener('notificationclick', (event) => {\n  event.notification.close();\n  const payload = event.notification.data || {};\n  event.waitUntil(\n    self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then((clients) => {\n      for (const client of clients) {\n        if ('focus' in client) {\n          client.focus();\n          client.postMessage({ type: 'B2KS_OPEN_TASKS', taskId: payload.taskId || null });\n          return;\n        }\n      }\n      if (self.clients.openWindow) {\n        return self.clients.openWindow('./');\n      }\n      return undefined;\n    })\n  );\n});\n"},{"path":"README.md","encoding":"utf8","content":"# B2KS Daily Routines — Webgame RPG Gia Đình & Học Tập\n\nWebgame nhập vai (RPG) dành cho gia đình (Bố, Mẹ và các con) kết hợp rèn luyện thói quen hằng ngày, học Tiếng Anh, nuôi thú cưng, sáng tạo vật phẩm và đồng bộ thời gian thực trên nhiều thiết bị (điện thoại, máy tính bảng, PC).\n\n---\n\n## 1. Tính năng nổi bật\n\n- **Cổng đăng nhập theo Tên Gia Đình & Mật Khẩu riêng (Bảo mật tạo khu phố)**:\n  - Mỗi gia đình đăng nhập bằng **Tên gia đình** (mặc định: `B2KS`) và **Mật khẩu vào khu phố** (mặc định lần đầu: **`1111`**).\n  - Cổng đăng nhập chỉ cho phép vào các **khu phố đã được cấp phép**; người chơi không thể tự tạo khu phố mới tùy tiện từ màn hình đăng nhập.\n  - Sau khi đăng nhập, game tự hiển thị gợi ý vị trí nút **❓ Hướng dẫn** để người chơi mới dễ tra cứu.\n- **Khu phố tương tác & Ngôi nhà mở rộng linh hoạt theo số con**:\n  - Di chuyển tự do bằng bàn phím (`W A S D` / Mũi tên) hoặc **Joystick** cảm ứng trên điện thoại.\n  - Ngôi nhà gia đình có phòng sinh hoạt chung, bàn ăn đố vui Tiếng Anh, tivi YouTube, **Tủ sách Truyện Tranh Tiếng Anh** (lật trang, phóng to/thu nhỏ, thưởng sao + buff thú cưng khi đọc xong) và **phòng riêng** cho từng thành viên (khóa/mở cửa, trưng bày vật phẩm).\n  - **Tự động co giãn số tầng & phòng ngủ**: Gia đình mới khởi tạo với **Bố & Mẹ** sẽ khóa 2 phòng ngủ tầng 3; có **1 bé** sẽ khóa 1 phòng còn lại; có **2 bé** mở đủ 3 tầng; có từ **3 bé trở lên** nhà tự động nâng thêm tầng trên.\n  - **Minimap & Chỉ đường GPS** trên Điện thoại cá nhân.\n  - **Thời tiết thực tế ngoài đời**: Tự động cập nhật thời tiết khu vực (nắng, mây, mưa, dông, sương mù, tuyết) phản ánh lên bầu trời và hiệu ứng trong game.\n- **Hệ thống Nhiệm vụ & Đổi quà thực tế**:\n  - Phụ huynh giao việc nhà, bài tập học tập (hỗ trợ đính kèm đề bài & chấm điểm), hoặc **Nhiệm vụ Đồng đội**.\n  - **Trung tâm Giao dịch Xuyên Thế Giới**: Các bé đổi điểm sao (`⭐`) lấy tiền mặt/đặc quyền ngoài đời thực và gửi yêu cầu chờ Phụ Huynh duyệt.\n- **Trung Tâm Tiếng Anh (Chuẩn Bộ GD&ĐT Global Success Lớp 6–9)**:\n  - Ngân hàng **1.920 câu hỏi** đầy đủ **4 khối lớp (Lớp 6, 7, 8, 9) × 12 Unit × (20 Từ vựng + 20 Ngữ pháp)** có phát âm tự động.\n  - Mỗi lượt thi rút ngẫu nhiên **10 câu (5 Từ vựng + 5 Ngữ pháp)** thuộc Unit hiện tại của bé ở lớp đang chọn.\n  - **Thăng cấp Unit theo chuỗi**: Đạt **> 8 điểm (9 hoặc 10/10) liên tiếp 3 lần** tại một Unit sẽ tự động mở khóa lên **Unit kế tiếp**; nếu `<= 8` điểm chuỗi sẽ về `0`.\n  - **Sở Thú Ảo** & **Phòng Thí Nghiệm Sáng Tạo (Pro Lab v2)**: Mở khóa động vật phát âm Tiếng Anh và sáng tạo vật phẩm độc bản trưng bày trong phòng riêng.\n- **Thú Cưng Đồng Hành & Cơ chế Độ No / Buff Sao**:\n  - **10 loài × 5 giai đoạn tiến hóa**: Đổi trứng, ấp nở ngẫu nhiên giới tính (`♂️/♀️`) & 5 biến thể màu hiếm, đặt tên, đeo **Phụ kiện** và dẫn đi dạo ngoài khu phố (thú cưng tự xoay hướng theo hướng di chuyển của chủ).\n  - **Cơ chế Độ No & Thưởng**: Khi dắt thú cưng đi cùng ngoài bản đồ, Độ No giảm nhẹ theo từng loài. Chỉ khi **đang dắt đi cùng** và **Độ No > 0%**, thú cưng mới kích hoạt **buff tăng tốc độ di chuyển** và **cộng thêm sao thưởng** (khi làm việc nhà, chấm bài tập, hoàn thành nhiệm vụ đồng đội, đọc xong truyện tranh). Nếu Độ No về `0%`, thú cưng hiện cảnh báo **❗ ĐÓI!** và tạm tắt toàn bộ buff cho tới khi được cho ăn.\n- **Giải trí & Xã hội gia đình**:\n  - **Sân Bóng Đá (Miễn phí 0⭐)** (vs AI, 1v1 Online, Khán giả), **Khu Arcade Online**, **Siêu Thị**, **Fashion Boutique**, **Salon Tóc**, **Chợ Trời gia đình**, và **Điện thoại Smartphone**.\n- **Bảng Điều Khiển Phụ Huynh, Công Cụ Admin & Mini Window**:\n  - Mở bảng Phụ Huynh bằng nút **📊 Phụ Huynh** (Passcode mặc định: **`1234`**).\n  - **Quản lý Tên gia đình, 2 Mật khẩu & Thành viên**: Hiển thị rõ cả *Mật khẩu vào Khu Phố* và *Passcode Phụ Huynh*, thêm/bớt/sửa tên & tuổi thành viên, kéo thả vị trí công trình và chọn **4 kiểu kiến trúc công trình**, chọn 5 chủ đề Nhạc nền, xem tiến độ Lớp/Unit Tiếng Anh của từng bé, quản lý **Ngân Hàng Tiếng Anh dùng chung (Xuất/Nhập CSV UTF-8 BOM)**, xem Sổ tay thú cưng và Xuất File ZIP GitHub. *(Riêng tab tùy chỉnh \"Hoạt động & điểm\" chỉ hiển thị cho Phụ Huynh khu phố `B2KS` để bảo đảm công bằng giữa các khu phố).*\n  - **🛠️ Công cụ Admin (Dành riêng cho Nhân vật Bố của khu phố B2KS trong thanh công cụ mở rộng `>`)**:\n    - **Quản lý các khu phố**: Xem danh sách toàn bộ khu phố, tạo khu phố mới (mặc định có Bố & Mẹ), xóa khu phố (trừ `B2KS`), và reset cả 2 mật khẩu của bất kỳ khu phố nào về mặc định (`1111` / `1234`).\n    - **Điều chỉnh điểm Phụ huynh**: Xem và điều chỉnh **điểm sao hiện có** cũng như **điểm nhận hằng ngày** của Bố/Mẹ ở tất cả các khu phố.\n  - **🪟 Thu nhỏ (Mini Window Always-On-Top)**: Cửa sổ siêu gọn hiển thị trạng thái **🟢 Online / ⚫ Offline** và lọc riêng hoạt động của các con.\n\n---\n\n## 2. Thông tin mặc định khi khởi chạy lần đầu\n\n| Hạng mục | Giá trị mặc định | Nơi thay đổi |\n| :--- | :--- | :--- |\n| **Tên gia đình chính** | `B2KS` | **📊 Phụ Huynh → Gia Đình & Bản Đồ** |\n| **Mật khẩu vào khu phố** *(Dùng chung cả nhà)* | `1111` | **📊 Phụ Huynh → Gia Đình & Bản Đồ** (hoặc Admin reset) |\n| **Passcode Phụ Huynh** *(Khóa bảng Phụ Huynh & đổi người)* | `1234` | **📊 Phụ Huynh → Gia Đình & Bản Đồ** hoặc **🔗 Gia đình & PIN** |\n\n> Lưu ý: Hệ thống không cho phép đặt *Mật khẩu vào khu phố* trùng với *Passcode Phụ Huynh* để bảo đảm trẻ em không dùng mật khẩu vào game để mở quyền Phụ Huynh.\n\n---\n\n## 3. Hướng dẫn tạo & chia sẻ cho gia đình khác\n\nGame tách biệt dữ liệu từng khu phố (không giao lưu giữa các khu phố với nhau, ngoại trừ **Ngân hàng câu hỏi Tiếng Anh** dùng chung), giúp mỗi gia đình chơi độc lập và an toàn.\n\n### Cách 1: Cấp khu phố mới trực tiếp qua Công cụ Admin *(Khuyên dùng)*\n1. Đăng nhập vào khu phố **`B2KS`** bằng nhân vật **Bố** (`Dad`).\n2. Mở rộng thanh công cụ bằng nút **`>`** → chọn **🛠️ Admin**.\n3. Tại tab **Quản lý các khu phố**, nhập tên khu phố mới (ví dụ: `MinhAn`, `GiaDinhTiti`) rồi bấm **Tạo khu phố**.\n4. Gửi link web đang chạy + **Tên khu phố mới** + mật khẩu vào game mặc định (**`1111`**) cho gia đình đó.\n5. Khi gia đình mới đăng nhập lần đầu, nhà sẽ có sẵn **Bố & Mẹ**. Phụ huynh nhà họ mở **📊 Phụ Huynh** (PIN **`1234`**) để:\n   - Thêm các thành viên con của nhà mình (ngôi nhà tự động mở tầng/phòng tương ứng).\n   - Đổi lại Mật khẩu vào game, Passcode Phụ Huynh và sắp xếp bản đồ khu phố riêng.\n\n### Cách 2: Chia sẻ trọn bộ File ZIP để tự host riêng *(Riêng tư 100%)*\n1. Vào **📊 Phụ Huynh → Nhật Ký & Xuất ZIP → Tải File ZIP GitHub** để tải `b2ks-daily-routines-github.zip`.\n2. Gia đình kia đẩy mã nguồn trong ZIP lên GitHub repository riêng của họ và bật GitHub Pages.\n3. Tạo một dự án **Firebase Realtime Database** miễn phí riêng (xem Mục 5 bên dưới) rồi cấu hình link Firebase riêng cho các máy trong nhà.\n\n---\n\n## 4. Triển khai lên GitHub Pages\n\n1. Giải nén file `b2ks-daily-routines-github.zip` và đẩy toàn bộ mã nguồn lên repository GitHub của bạn (nhánh `main`).\n2. Trên GitHub, vào **Settings → Pages → Build and deployment → Source**:\n   - **Cách khuyến nghị:** Chọn **GitHub Actions** (workflow `.github/workflows/deploy.yml` có sẵn sẽ tự động build và deploy mỗi khi có commit mới).\n   - **Hoặc Deploy from a branch:** Chọn nhánh `main` và thư mục **`/docs`** (gói ZIP đã build sẵn bản tĩnh mới nhất trong `docs/`). Nếu chọn `/ (root)`, trang chủ cũng có cơ chế tự chuyển hướng sang `./docs/`.\n\n---\n\n## 5. Tạo & cấu hình Firebase Realtime Database (Đồng bộ nhiều máy)\n\nĐể Bố, Mẹ và các con nhìn thấy nhau di chuyển theo thời gian thực, nhắn tin Messenger, đồng bộ điểm sao, thú cưng và duyệt quà trên nhiều điện thoại:\n\n1. Truy cập [Firebase Console](https://console.firebase.google.com/) → **Create a project** (gói Spark miễn phí).\n2. Vào **Build → Realtime Database → Create Database** (chọn khu vực `asia-southeast1` cho tốc độ tốt tại Việt Nam).\n3. Trong tab **Rules**, cấu hình quyền đọc/ghi (nếu chỉ dùng nội bộ gia đình với URL riêng + mật khẩu khu phố):\n   ```json\n   {\n     \"rules\": {\n       \".read\": true,\n       \".write\": true\n     }\n   }\n   ```\n   *(Khuyến nghị bật thêm cấu trúc bảo mật nâng cao hoặc giữ bí mật URL dự án Firebase của gia đình bạn).*\n4. Copy **Database URL** (dạng `https://your-family-default-rtdb.asia-southeast1.firebasedatabase.app`).\n5. **Áp dụng vào game** bằng 1 trong 2 cách:\n   - **Trực tiếp trong game:** Mở **🔗 Gia đình & PIN** (trên từng máy) → dán Database URL → bấm **Kết nối**.\n   - **Đổi mặc định trong mã nguồn (nếu tự host cho gia đình riêng):** Mở `src/game/constants.ts`, sửa giá trị `DEFAULT_FIREBASE_URL` thành Database URL của gia đình bạn rồi build lại.\n\n### Các nhánh dữ liệu tự động trên Firebase\n- Gia đình `B2KS`: `/b2ks_family_rpg_v16/`\n- Gia đình tên khác (ví dụ `MinhAn`): `/b2ks_family_ns_minhan/` *(dữ liệu tách riêng từng gia đình)*\n- Danh bạ khu phố Admin: `/b2ks_family_directory/`\n- Ngân hàng Tiếng Anh dùng chung (Global Success Lớp 6–9): `/b2ks_shared_english_bank.json` & `/b2ks_shared_english_bank_meta.json`\n- Các nút trong từng khu phố: `shared.json`, `auth_meta.json`, `member_data/`, `live_pos/`, `cross_world_requests.json`, `flea_market.json`, `activity_logs.json`, `arcade_room.json`, `soccer_room.json`.\n\n---\n\n## 6. Chạy & Build trên máy cá nhân (Dành cho Developer)\n\nYêu cầu cài đặt **Node.js 20+** trở lên:\n\n```bash\n# Cài đặt thư viện\nnpm install\n\n# Chạy môi trường phát triển (mặc định http://localhost:3000)\nnpm run dev\n\n# Kiểm tra kiểu dữ liệu TypeScript\nnpm run lint\n\n# Build bản sản phẩm tĩnh vào thư mục dist/ và đồng bộ docs/\nnpm run build\n```\n\n> Lưu ý cho chế độ **Khóa máy trẻ em**: Trên điện thoại của các con, Phụ Huynh có thể chọn nhân vật của bé rồi vào **🔗 Gia đình & PIN → Bật Khóa Máy Cho Nhân Vật Này** để tránh bé chuyển nhầm sang tài khoản của Bố/Mẹ hoặc anh/chị/em khác.\n"},{"path":"src/App.tsx","encoding":"utf8","content":"import { useCallback, useEffect, useState } from 'react';\nimport { createPortal } from 'react-dom';\nimport { HelpCircle, X } from 'lucide-react';\nimport { ActiveReactModal, B2KSBridge } from './types/b2ks';\nimport { CrossWorldModal } from './components/CrossWorldModal';\nimport { FleaMarketModal } from './components/FleaMarketModal';\nimport { VirtualZooModal } from './components/VirtualZooModal';\nimport { ParentalDashboardModal } from './components/ParentalDashboardModal';\nimport { ParentMiniWindow } from './components/ParentMiniWindow';\nimport { OfflineIndicator, PWAInstallButton } from './components/PWAInstallButton';\nimport { ComicLibraryModal } from './components/ComicLibraryModal';\nimport { GamePasswordGate } from './components/GamePasswordGate';\nimport { SoundThemePicker } from './components/SoundThemePicker';\nimport { AdminPanelModal } from './components/AdminPanelModal';\nimport { AchievementsModal } from './components/AchievementsModal';\nimport { SpeakingPracticeModal } from './components/SpeakingPracticeModal';\nimport { ChurchBibleModal } from './components/ChurchBibleModal';\n\nexport default function App() {\n  const [activeModal, setActiveModal] = useState<ActiveReactModal>(null);\n  const [bridge, setBridge] = useState<B2KSBridge | undefined>(() => window.B2KS);\n  const [hudPwaHost, setHudPwaHost] = useState<HTMLElement | null>(null);\n  const [hudSoundHost, setHudSoundHost] = useState<HTMLElement | null>(null);\n  const [unlocked, setUnlocked] = useState(false);\n  const [showGuideHint, setShowGuideHint] = useState(false);\n  const [guideAnchor, setGuideAnchor] = useState<{ left: number; top?: number; bottom?: number; arrowOffset: number; above: boolean } | null>(null);\n\n  const updateGuideAnchor = useCallback(() => {\n    const btn = document.getElementById('hud-guide-btn');\n    if (!btn) {\n      setGuideAnchor({ left: Math.max(12, window.innerWidth - 280), bottom: 76, arrowOffset: 120, above: true });\n      return;\n    }\n    const r = btn.getBoundingClientRect();\n    const boxWidth = 256;\n    const clampedLeft = Math.max(10, Math.min(window.innerWidth - boxWidth - 10, r.left + r.width / 2 - boxWidth / 2));\n    const arrowOffset = Math.max(18, Math.min(boxWidth - 22, r.left + r.width / 2 - clampedLeft));\n    const above = r.top > window.innerHeight * 0.5;\n    setGuideAnchor(\n      above\n        ? { left: clampedLeft, bottom: Math.max(68, window.innerHeight - r.top + 10), arrowOffset, above: true }\n        : { left: clampedLeft, top: r.bottom + 10, arrowOffset, above: false }\n    );\n  }, []);\n\n  useEffect(() => {\n    setHudPwaHost(document.getElementById('hud-pwa-slot'));\n    setHudSoundHost(document.getElementById('hud-sound-slot'));\n\n    window.__OPEN_B2KS_MODAL__ = (modal: ActiveReactModal) => {\n      if (window.B2KS) setBridge(window.B2KS);\n      setActiveModal(modal);\n    };\n\n    const syncBridge = (b: B2KSBridge) => {\n      b.setGameUnlocked?.(false);\n      setBridge(b);\n      setHudPwaHost(document.getElementById('hud-pwa-slot'));\n      setHudSoundHost(document.getElementById('hud-sound-slot'));\n    };\n\n    if (window.B2KS) {\n      syncBridge(window.B2KS);\n    }\n\n    const timer = window.setInterval(() => {\n      if (window.B2KS) {\n        syncBridge(window.B2KS);\n        window.clearInterval(timer);\n      }\n    }, 80);\n\n    return () => {\n      window.clearInterval(timer);\n    };\n  }, []);\n\n  useEffect(() => {\n    if (!showGuideHint) return;\n    updateGuideAnchor();\n    const onResize = () => updateGuideAnchor();\n    const onGuideClick = () => setShowGuideHint(false);\n    const guideBtn = document.getElementById('hud-guide-btn');\n    guideBtn?.addEventListener('click', onGuideClick);\n    window.addEventListener('resize', onResize);\n    const timeout = window.setTimeout(() => setShowGuideHint(false), 8500);\n    return () => {\n      window.clearTimeout(timeout);\n      window.removeEventListener('resize', onResize);\n      guideBtn?.removeEventListener('click', onGuideClick);\n    };\n  }, [showGuideHint, updateGuideAnchor]);\n\n  const handleUnlocked = () => {\n    setUnlocked(true);\n    setShowGuideHint(true);\n    window.setTimeout(updateGuideAnchor, 80);\n  };\n\n  const close = () => setActiveModal(null);\n\n  return (\n    <>\n      {hudPwaHost && createPortal(<PWAInstallButton />, hudPwaHost)}\n      {hudSoundHost && bridge && unlocked && createPortal(<SoundThemePicker bridge={bridge} />, hudSoundHost)}\n      <OfflineIndicator />\n\n      {bridge && !unlocked && (\n        <GamePasswordGate bridge={bridge} onUnlocked={handleUnlocked} />\n      )}\n\n      {unlocked && showGuideHint && guideAnchor && (\n        <div\n          style={{\n            left: guideAnchor.left,\n            ...(guideAnchor.above ? { bottom: guideAnchor.bottom } : { top: guideAnchor.top }),\n          }}\n          className=\"fixed z-[350] w-64 rounded-2xl border border-amber-300 bg-amber-50/95 text-slate-900 shadow-2xl p-2.5 animate-bounce\"\n        >\n          <div\n            style={{ left: guideAnchor.arrowOffset - 6 }}\n            className={\n              guideAnchor.above\n                ? 'absolute -bottom-2 w-3.5 h-3.5 rotate-45 bg-amber-50 border-r border-b border-amber-300'\n                : 'absolute -top-2 w-3.5 h-3.5 rotate-45 bg-amber-50 border-l border-t border-amber-300'\n            }\n          />\n          <div className=\"flex items-start justify-between gap-2\">\n            <div className=\"flex items-start gap-2 text-xs leading-snug\">\n              <HelpCircle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n              <div>\n                <div className=\"font-extrabold text-amber-950\">Cần xem Hướng dẫn chơi?</div>\n                <div className=\"text-[11px] text-slate-700 mt-0.5\">\n                  Bấm nút <b>❓ Hướng dẫn</b> {guideAnchor.above ? 'ngay phía dưới' : 'ngay phía trên'} bất cứ lúc nào nhé!\n                </div>\n              </div>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => setShowGuideHint(false)}\n              className=\"p-0.5 rounded hover:bg-amber-200/60 text-slate-600 cursor-pointer shrink-0\"\n              aria-label=\"Đóng gợi ý\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      )}\n\n      {bridge && unlocked && <ParentMiniWindow bridge={bridge} />}\n\n      {bridge && unlocked && activeModal === 'cross_world' && (\n        <CrossWorldModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'flea_market' && (\n        <FleaMarketModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'virtual_zoo' && (\n        <VirtualZooModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'parental_dashboard' && (\n        <ParentalDashboardModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'comic_library' && (\n        <ComicLibraryModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'admin_panel' && (\n        <AdminPanelModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'achievements' && (\n        <AchievementsModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'speaking_practice' && (\n        <SpeakingPracticeModal bridge={bridge} onClose={close} />\n      )}\n      {bridge && unlocked && activeModal === 'church_bible' && (\n        <ChurchBibleModal bridge={bridge} onClose={close} />\n      )}\n    </>\n  );\n}\n"},{"path":"src/assets/images/comic_cover_ada_telescope_1795099901297.jpg","encoding"