 (promptEl) {\n      currentInteractTarget = null;\n      promptEl.style.display = 'none';\n    }\n\n    const nowMs = Date.now();\n    const visibleMembers = state.members.filter((m) => {\n      if (m.scene !== me.scene) return false;\n      if (me.scene === 'private_room') {\n        const myRoomId = me.privateRoomId || activePrivateRoomId;\n        return (m.privateRoomId || null) === myRoomId;\n      }\n      return true;\n    });\n    const memberMovingMap = new Map<string, boolean>();\n    visibleMembers.forEach((m) => {\n      if (m.id === me.id) {\n        memberMovingMap.set(m.id, isMeMoving);\n      } else {\n        const prev = memberMoveState.get(m.id);\n        if (!prev) {\n          memberMoveState.set(m.id, { x: m.x, y: m.y, scene: m.scene, movingUntil: 0 });\n          memberMovingMap.set(m.id, false);\n        } else {\n          const moved = prev.scene === m.scene && Math.hypot(m.x - prev.x, m.y - prev.y) > 0.5;\n          if (moved) prev.movingUntil = nowMs + 1350;\n          prev.x = m.x;\n          prev.y = m.y;\n          prev.scene = m.scene;\n          memberMovingMap.set(m.id, nowMs < prev.movingUntil);\n        }\n      }\n    });\n\n    // Update Helper Robots for every child (smooth breadcrumb pursuit trailing behind subject)\n    const helperRobots: HelperRobotRenderItem[] = [];\n    state.members\n      .filter((m) => !isParent(m))\n      .forEach((kid) => {\n        ensureMemberProps(kid);\n        const cfg = kid.helperRobot!;\n        const activeRem = (cfg.reminders || []).find((r) => nowMs >= r.startAt && nowMs <= r.endAt) || null;\n        const myRoom = getMemberPrivateRoom(kid);\n        const targetScene = activeRem ? kid.scene : 'private_room';\n        const targetPrivateRoomId = activeRem ? (kid.privateRoomId || null) : (myRoom?.id || null);\n\n        const dirAng = cardinalWorldAngle(kid.dir || 'down');\n        const dirHx = Math.cos(dirAng);\n        const dirHy = Math.sin(dirAng);\n\n        let rt = helperRobotRuntimeMap.get(kid.id);\n        const sceneChanged = !rt || rt.scene !== targetScene || rt.privateRoomId !== targetPrivateRoomId;\n\n        if (sceneChanged || !rt) {\n          const initHx = dirHx;\n          const initHy = dirHy;\n          const initX = activeRem ? kid.x - initHx * 48 - initHy * 12 : 185;\n          const initY = activeRem ? kid.y - initHy * 48 + initHx * 12 : 112;\n          rt = {\n            x: initX,\n            y: initY,\n            scene: targetScene,\n            privateRoomId: targetPrivateRoomId,\n            headingX: initHx,\n            headingY: initHy,\n            lastKidX: kid.x,\n            lastKidY: kid.y,\n            yaw: activeRem ? Math.atan2(kid.x - initX, kid.y - initY) : 0.35,\n            trail: [{ x: kid.x, y: kid.y }]\n          };\n          helperRobotRuntimeMap.set(kid.id, rt);\n        }\n\n        // Track subject heading & breadcrumbs inside current scene\n        const kidStepDx = kid.x - rt.lastKidX;\n        const kidStepDy = kid.y - rt.lastKidY;\n        const kidStepDist = Math.hypot(kidStepDx, kidStepDy);\n        if (kidStepDist > 0.6 && kidStepDist < 240) {\n          const nx = kidStepDx / kidStepDist;\n          const ny = kidStepDy / kidStepDist;\n          const hBlend = Math.min(1, deltaSec * 12);\n          const mx = rt.headingX + (nx - rt.headingX) * hBlend;\n          const my = rt.headingY + (ny - rt.headingY) * hBlend;\n          const mLen = Math.hypot(mx, my) || 1;\n          rt.headingX = mx / mLen;\n          rt.headingY = my / mLen;\n\n          const lastPt = rt.trail[rt.trail.length - 1];\n          if (!lastPt || Math.hypot(kid.x - lastPt.x, kid.y - lastPt.y) >= 10) {\n            rt.trail.push({ x: kid.x, y: kid.y });\n            if (rt.trail.length > 28) rt.trail.shift();\n          }\n        } else if (kidStepDist > 240) {\n          rt.trail = [{ x: kid.x, y: kid.y }];\n          rt.headingX = dirHx;\n          rt.headingY = dirHy;\n        }\n        rt.lastKidX = kid.x;\n        rt.lastKidY = kid.y;\n\n        // Compute follow point behind the subject along breadcrumb path\n        let targetX = 185;\n        let targetY = 112;\n        if (activeRem) {\n          const followDist = 48;\n          let bx = kid.x - rt.headingX * followDist;\n          let by = kid.y - rt.headingY * followDist;\n\n          if (rt.trail.length >= 2) {\n            let accDist = 0;\n            let curX = kid.x;\n            let curY = kid.y;\n            let foundOnTrail = false;\n            for (let i = rt.trail.length - 1; i >= 0; i--) {\n              const pt = rt.trail[i];\n              const segLen = Math.hypot(curX - pt.x, curY - pt.y);\n              if (accDist + segLen >= followDist && segLen > 0.01) {\n                const remain = followDist - accDist;\n                const t = remain / segLen;\n                bx = curX + (pt.x - curX) * t;\n                by = curY + (pt.y - curY) * t;\n                foundOnTrail = true;\n                break;\n              }\n              accDist += segLen;\n              curX = pt.x;\n              curY = pt.y;\n            }\n            if (!foundOnTrail && accDist > 4) {\n              const tail = rt.trail[0];\n              const vx = tail.x - kid.x;\n              const vy = tail.y - kid.y;\n              const vLen = Math.hypot(vx, vy) || 1;\n              bx = kid.x + (vx / vLen) * followDist;\n              by = kid.y + (vy / vLen) * followDist;\n            }\n          }\n\n          // Subtle shoulder offset perpendicular to heading so robot stays visible behind child\n          targetX = bx - rt.headingY * 14;\n          targetY = by + rt.headingX * 14;\n\n          if (targetScene === 'neighborhood') {\n            targetX = Math.max(40, Math.min(STREET_WORLD.width - 40, targetX));\n            targetY = Math.max(260, Math.min(STREET_WORLD.height - 40, targetY));\n          } else if (targetScene === 'private_room') {\n            targetX = Math.max(20, Math.min(PRIVATE_ROOM_WORLD.width - 20, targetX));\n            targetY = Math.max(24, Math.min(PRIVATE_ROOM_WORLD.height - 20, targetY));\n          } else {\n            targetX = Math.max(36, Math.min(HOUSE_WORLD.width - 36, targetX));\n            targetY = Math.max(40, Math.min(houseMetrics.houseHeight - 24, targetY));\n          }\n        }\n\n        const prevRx = rt.x;\n        const prevRy = rt.y;\n        const distToTarget = Math.hypot(targetX - rt.x, targetY - rt.y);\n        if (distToTarget > 380) {\n          rt.x = targetX;\n          rt.y = targetY;\n        } else if (distToTarget > 0.5) {\n          const maxStep = Math.max(195, distToTarget * 5.2) * Math.max(0.008, deltaSec);\n          const step = Math.min(distToTarget, maxStep);\n          rt.x += ((targetX - rt.x) / distToTarget) * step;\n          rt.y += ((targetY - rt.y) / distToTarget) * step;\n        }\n\n        // Maintain personal space bubble when following so robot never overlaps child\n        if (activeRem) {\n          const sepDx = rt.x - kid.x;\n          const sepDy = rt.y - kid.y;\n          const sepDist = Math.hypot(sepDx, sepDy);\n          if (sepDist < 34) {\n            const pushX = sepDist > 0.5 ? sepDx / sepDist : -rt.headingX;\n            const pushY = sepDist > 0.5 ? sepDy / sepDist : -rt.headingY;\n            rt.x = kid.x + pushX * 34;\n            rt.y = kid.y + pushY * 34;\n          }\n        }\n\n        const moveDx = rt.x - prevRx;\n        const moveDy = rt.y - prevRy;\n        const movedDist = Math.hypot(moveDx, moveDy);\n        const isRobotMoving = movedDist > 0.35 && movedDist < 120;\n\n        let desiredYaw = 0.35;\n        if (isRobotMoving) {\n          desiredYaw = Math.atan2(moveDx, moveDy);\n        } else if (activeRem) {\n          desiredYaw = Math.atan2(kid.x - rt.x, kid.y - rt.y);\n        }\n        let yawDelta = desiredYaw - rt.yaw;\n        while (yawDelta > Math.PI) yawDelta -= Math.PI * 2;\n        while (yawDelta < -Math.PI) yawDelta += Math.PI * 2;\n        rt.yaw += yawDelta * Math.min(1, deltaSec * 9);\n\n        helperRobots.push({\n          childId: kid.id,\n          childName: kid.name,\n          skin: cfg.skin,\n          x: rt.x,\n          y: rt.y,\n          scene: targetScene as HelperRobotRenderItem['scene'],\n          privateRoomId: targetPrivateRoomId,\n          isFollowing: Boolean(activeRem),\n          isMoving: isRobotMoving,\n          reminderText: activeRem ? activeRem.text : '',\n          facingYaw: rt.yaw\n        });\n      });\n\n    // Build Kids Leaderboard summary for 3D Leader Board\n    const kidsLeaderboard = state.members\n      .filter((m) => !isParent(m))\n      .slice()\n      .sort((a, b) => b.points - a.points)\n      .map((k) => {\n        const prog6 = k.englishProgress?.[6]?.unit || 1;\n        const maxU = Math.max(\n          k.englishProgress?.[6]?.unit || 1,\n          k.englishProgress?.[7]?.unit || 1,\n          k.englishProgress?.[8]?.unit || 1,\n          k.englishProgress?.[9]?.unit || 1\n        );\n        return {\n          name: k.name,\n          points: k.points,\n          unitLabel: `U.${maxU || prog6}`,\n          speakingLevel: k.speakingLevel || 1,\n          achievementCount: (k.unlockedAchievements || []).length,\n          achievementTotal: ACHIEVEMENT_CATALOG.length\n        };\n      });\n\n    controller3d?.render({\n      deltaSec,\n      nowMs,\n      state,\n      me,\n      lighting,\n      weather: currentWeather,\n      locations: resolveNeighborhoodLocations(state),\n      streetCars,\n      arcadeRoom: arcadeEngine.getRoomState(),\n      arcadeCatalog: ARCADE_GAME_CATALOG,\n      soccerRoom: soccerGame.getRoomState(),\n      houseRooms: getHouseRooms(),\n      wardrobeOpenedRoomId,\n      roomDecorSlots: ROOM_DECOR_SLOTS,\n      findAnyCatalogItem,\n      memberMovingMap,\n      foreignNpcs: foreignNpcStates,\n      helperRobots,\n      kidsLeaderboard,\n      getPetForMember: getActivePet,\n      getPetSpecies,\n      getPetResolvedColors\n    });\n\n    // Render Neighborhood Minimap & Collapse Pill & Active Navigation Banner\n    const mmContainer = document.getElementById('minimap-container');\n    const mmCollapsedPill = document.getElementById('minimap-collapsed-pill');\n    const mmCollapsedNav = document.getElementById('minimap-collapsed-nav');\n    const mmCanvas = document.getElementById('minimap-canvas') as HTMLCanvasElement | null;\n    const mmBanner = document.getElementById('minimap-nav-banner');\n    const mmLabel = document.getElementById('minimap-nav-label');\n    const mmZoneLabel = document.getElementById('minimap-zone-label');\n    const canShowNeighborhoodMap = isGameUnlocked && me.scene === 'neighborhood' && !document.body.classList.contains('parent-mini-minimized');\n    const activeTarget = getResolvedNavTarget();\n    if (mmCollapsedPill) {\n      mmCollapsedPill.style.display = canShowNeighborhoodMap && minimapCollapsed ? 'inline-flex' : 'none';\n      if (mmCollapsedNav) {\n        if (activeTarget) {\n          const distM = Math.round(Math.hypot(me.x - activeTarget.x, me.y - activeTarget.y) / 10);\n          mmCollapsedNav.style.display = 'inline';\n          mmCollapsedNav.textContent = `${activeTarget.icon}${distM}m`;\n        } else {\n          mmCollapsedNav.style.display = 'none';\n        }\n      }\n    }\n    if (mmContainer) {\n      const showMinimap = canShowNeighborhoodMap && !minimapCollapsed;\n      mmContainer.style.display = showMinimap ? 'flex' : 'none';\n      if (showMinimap && mmCanvas) {\n        const mmCtx = mmCanvas.getContext('2d');\n        const resolvedLocs = resolveNeighborhoodLocations(state);\n        if (mmCtx) {\n          drawNeighborhoodMinimap(\n            mmCtx,\n            mmCanvas.width,\n            mmCanvas.height,\n            state,\n            me,\n            activeTarget,\n            resolvedLocs,\n            {\n              camYaw: controller3d?.getCamYaw() ?? Math.PI / 4,\n              playerWorldAngle: smoothPlayerWorldAngle,\n              orientMode: minimapOrientMode,\n              zoomScale: MINIMAP_ZOOM_STEPS[minimapZoomIdx] ?? 1.0,\n              streetCars,\n              foreignNpcs: foreignNpcStates,\n              outPinHits: minimapPinHits\n            }\n          );\n        }\n        if (mmZoneLabel) {\n          let nearestLoc: NavDestination | null = null;\n          let nearestDist = 170;\n          for (const loc of resolvedLocs) {\n            const d = Math.hypot(me.x - loc.x, me.y - loc.y);\n            if (d < nearestDist) {\n              nearestDist = d;\n              nearestLoc = loc;\n            }\n          }\n          if (nearestLoc) {\n            mmZoneLabel.textContent = `${nearestLoc.icon} ${nearestLoc.name}`;\n          } else if (Math.abs(me.x - 1245) <= 115) {\n            mmZoneLabel.textContent = '🛣️ Trục Trung tâm';\n          } else if (me.y >= 415 && me.y <= 645) {\n            mmZoneLabel.textContent = '🛣️ Đại lộ Bắc';\n          } else if (me.y >= 975 && me.y <= 1205) {\n            mmZoneLabel.textContent = '🛣️ Đại lộ Nam';\n          } else {\n            mmZoneLabel.textContent = '🌳 Công viên Khu phố';\n          }\n        }\n        if (mmBanner && mmLabel) {\n          if (activeTarget) {\n            const distM = Math.round(Math.hypot(me.x - activeTarget.x, me.y - activeTarget.y) / 10);\n            mmBanner.style.display = 'flex';\n            mmLabel.textContent = `${activeTarget.icon} ${activeTarget.name} · ${distM}m`;\n          } else {\n            mmBanner.style.display = 'none';\n          }\n        }\n      }\n    }\n\n    updateHUD();\n    requestAnimationFrame(gameLoop);\n  }\n\n  loadGame();\n  fetchLiveWeatherInfo(false)\n    .then((wInfo) => {\n      currentWeather = wInfo;\n      updateHUD();\n    })\n    .catch(() => {});\n  updateHUD();\n  renderChatLog();\n  requestAnimationFrame(gameLoop);\n}\n"},{"path":"src/game/bibleDataNT.ts","encoding":"utf8","content":"import { BibleQuestion } from '../types/b2ks';\n\n// 100 New Testament Questions (NIV English + Kinh Thánh Tin Lành Truyền Thống 1925 Vietnamese)\nexport const BIBLE_NT_QUESTIONS: BibleQuestion[] = [\n  {\n    id: 'nt_001',\n    category: 'fact',\n    q: 'What angel announced to Mary (Ma-ri) in Nazareth (Na-xa-rét) that she would give birth to Jesus (Đức Chúa Jêsus)?',\n    opts: ['Michael (Mi-cha-ên)', 'Gabriel (Gáp-ri-ên)', 'Raphael (Ra-pha-ên)', 'Samuel (Sa-mu-ên)'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '1:26-31',\n    verseEn: 'God sent the angel Gabriel to Nazareth... \"You will conceive and give birth to a son, and you are to call him Jesus.\"',\n    verseVi: 'Đức Chúa Trời sai thiên sứ Gáp-ri-ên đến thành Na-xa-rét... Ngươi sẽ chịu thai và sanh một con trai mà đặt tên là Jêsus.',\n  },\n  {\n    id: 'nt_002',\n    category: 'fact',\n    q: 'What does the name \"Jesus\" (Jêsus) mean as explained by the angel to Joseph (Giô-sép)?',\n    opts: ['Great builder', 'He will save his people from their sins', 'King of the sea', 'Mighty traveler'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '1:21',\n    verseEn: 'You are to give him the name Jesus, because he will save his people from their sins.',\n    verseVi: 'Ngươi hãy đặt tên là Jêsus, vì chính con trai ấy sẽ cứu dân mình ra khỏi tội.',\n  },\n  {\n    id: 'nt_003',\n    category: 'image',\n    visualId: 'star_manger',\n    q: 'Look at the picture. In which town was Jesus (Đức Chúa Jêsus) born and placed in a manger?',\n    opts: ['Nazareth (Na-xa-rét)', 'Bethlehem (Bết-lê-hem)', 'Jerusalem (Giê-ru-sa-lem)', 'Capernaum (Ca-bê-na-um)'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '2:4-7',\n    verseEn: 'She wrapped him in cloths and placed him in a manger, because there was no guest room available for them.',\n    verseVi: 'Rồi lấy khăn bọc con mình, đặt nằm trong máng cỏ, vì nhà quán không có đủ chỗ ở.',\n  },\n  {\n    id: 'nt_004',\n    category: 'fact',\n    q: 'Who were the first people outside the family to hear the angels announce Jesus (Đức Chúa Jêsus)\\'s birth and visit the manger?',\n    opts: ['Roman soldiers', 'Shepherds keeping watch over their flocks at night', 'Fishermen from Galilee (Ga-li-lê)', 'Merchants from Babylon (Ba-by-lôn)'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '2:8-16',\n    verseEn: 'And there were shepherds living out in the fields nearby, keeping watch over their flocks at night.',\n    verseVi: 'Vả, cũng trong miền đó, có mấy kẻ chăn chiên trú ngoài đồng, thức đêm canh giữ bầy mình.',\n  },\n  {\n    id: 'nt_005',\n    category: 'fact',\n    q: 'What three gifts did the Magi (các thầy bác-sĩ) from the east bring to the young child Jesus (Đức Chúa Jêsus)?',\n    opts: ['Silver, wheat, and olive oil', 'Gold, frankincense, and myrrh', 'Pearls, robes, and honey', 'Scrolls, bread, and wine'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '2:11',\n    verseEn: 'Then they opened their treasures and presented him with gifts of gold, frankincense and myrrh.',\n    verseVi: 'Rồi mở tráp ra, dâng cho Ngài những lễ vật, là vàng, nhũ hương, và một dược.',\n  },\n  {\n    id: 'nt_006',\n    category: 'fact',\n    q: 'At twelve years old, where did Mary (Ma-ri) and Joseph (Giô-sép) find Jesus (Đức Chúa Jêsus) after searching Jerusalem (Giê-ru-sa-lem) for three days?',\n    opts: ['In the marketplace', 'In the temple courts, sitting among the teachers', 'By the Jordan (Giô-đanh) River', 'At a carpenter\\'s shop'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '2:46',\n    verseEn: 'After three days they found him in the temple courts, sitting among the teachers, listening to them and asking them questions.',\n    verseVi: 'Khỏi ba ngày, mới thấy con ở trong đền thờ, đương ngồi giữa các thầy, vừa nghe vừa hỏi.',\n  },\n  {\n    id: 'nt_007',\n    category: 'fact',\n    q: 'What did John the Baptist (Giăng Báp-tít) eat while preaching in the wilderness of Judea (Giu-đê)?',\n    opts: ['Bread and cheese', 'Locusts and wild honey', 'Grapes and figs', 'Fish and olives'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '3:4',\n    verseEn: 'His food was locusts and wild honey.',\n    verseVi: 'Người mặc áo bằng lông lạc đà, thắt lưng bằng dây da; và ăn những châu chấu cùng mật ong rừng.',\n  },\n  {\n    id: 'nt_008',\n    category: 'fact',\n    q: 'Who baptized Jesus (Đức Chúa Jêsus) in the Jordan (Giô-đanh) River?',\n    opts: ['Peter (Phi-e-rơ)', 'John the Baptist (Giăng Báp-tít)', 'Paul (Phao-lô)', 'Matthew (Ma-thi-ơ)'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '3:13, 16',\n    verseEn: 'Then Jesus came from Galilee to the Jordan to be baptized by John.',\n    verseVi: 'Khi ấy, Đức Chúa Jêsus từ xứ Ga-li-lê đến cùng Giăng tại sông Giô-đanh, đặng chịu người làm phép báp-tem.',\n  },\n  {\n    id: 'nt_009',\n    category: 'image',\n    visualId: 'dove_olive',\n    q: 'When Jesus (Đức Chúa Jêsus) came up out of the water after baptism, like what creature did the Spirit of God (Thần Đức Chúa Trời) descend on Him?',\n    opts: ['A white dove', 'A golden eagle', 'A lamb', 'A sparrow'],\n    ans: 0,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '3:16',\n    verseEn: 'He saw the Spirit of God descending like a dove and alighting on him.',\n    verseVi: 'Ngài thấy Thánh Linh của Đức Chúa Trời ngự xuống như chim bồ câu, đậu trên Ngài.',\n  },\n  {\n    id: 'nt_010',\n    category: 'fact',\n    q: 'How many days did Jesus (Đức Chúa Jêsus) fast in the wilderness before being tempted by the devil?',\n    opts: ['7 days', '12 days', '40 days and 40 nights', '50 days'],\n    ans: 2,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '4:2',\n    verseEn: 'After fasting forty days and forty nights, he was hungry.',\n    verseVi: 'Ngài đã kiêng ăn bốn mươi ngày bốn mươi đêm rồi, sau thì đói.',\n  },\n  {\n    id: 'nt_011',\n    category: 'fact',\n    q: 'What trade were Simon Peter (Si-môn Phi-e-rơ) and his brother Andrew (Anh-rê) doing when Jesus (Đức Chúa Jêsus) called them to follow Him?',\n    opts: ['Tax collectors', 'Fishermen', 'Carpenters', 'Shepherds'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '4:18-19',\n    verseEn: '\"Come, follow me,\" Jesus said, \"and I will send you out to fish for people.\"',\n    verseVi: 'Ngài phán cùng hai người rằng: Hãy theo ta, ta sẽ cho các ngươi nên tay đánh lưới người.',\n  },\n  {\n    id: 'nt_012',\n    category: 'fact',\n    q: 'How many apostles (sứ đồ) did Jesus (Đức Chúa Jêsus) choose to travel and learn closely with Him?',\n    opts: ['7', '10', '12', '24'],\n    ans: 2,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '10:1-2',\n    verseEn: 'Jesus called his twelve disciples to him... These are the names of the twelve apostles.',\n    verseVi: 'Đức Chúa Jêsus gọi mười hai môn đồ đến... Nầy là tên mười hai sứ đồ.',\n  },\n  {\n    id: 'nt_013',\n    category: 'image',\n    visualId: 'water_jars',\n    q: 'Look at the six stone water jars. What was Jesus (Đức Chúa Jêsus)\\'s very first recorded miracle at a wedding in Cana (Ca-na)?',\n    opts: ['Walking on a lake', 'Turning water into wine', 'Multiplying bread', 'Calming a storm'],\n    ans: 1,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '2:1-11',\n    verseEn: 'What Jesus did here in Cana of Galilee was the first of the signs through which he revealed his glory.',\n    verseVi: 'Ấy là tại Ca-na, trong xứ Ga-li-lê, mà Đức Chúa Jêsus làm phép lạ thứ nhứt, và tỏ sự vinh hiển Ngài như vậy.',\n  },\n  {\n    id: 'nt_014',\n    category: 'verse',\n    q: 'In the Sermon on the Mount (Bài Giảng Trên Núi), Jesus (Đức Chúa Jêsus) told His followers: \"You are the ___ of the earth\" and \"the ___ of the world.\"',\n    opts: ['gold ... silver', 'salt ... light', 'rain ... wind', 'trees ... rivers'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '5:13-14',\n    verseEn: 'You are the salt of the earth... You are the light of the world.',\n    verseVi: 'Các ngươi là muối của đất... Các ngươi là sự sáng của thế gian.',\n  },\n  {\n    id: 'nt_015',\n    category: 'verse',\n    q: 'Complete the Beatitude in Matthew (Ma-thi-ơ) 5:9: \"Blessed are the peacemakers, for they will be called ___ of God (Đức Chúa Trời).\"',\n    opts: ['rulers', 'children', 'teachers', 'builders'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '5:9',\n    verseEn: 'Blessed are the peacemakers, for they will be called children of God.',\n    verseVi: 'Phước cho những kẻ làm cho người hòa thuận, vì sẽ được gọi là con Đức Chúa Trời!',\n  },\n  {\n    id: 'nt_016',\n    category: 'verse',\n    q: 'Complete the opening of the Lord\\'s Prayer (Bài Cầu Nguyện Chung): \"Our Father in heaven, hallowed be your ___.\"',\n    opts: ['name', 'palace', 'throne', 'city'],\n    ans: 0,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '6:9',\n    verseEn: 'This, then, is how you should pray: \"Our Father in heaven, hallowed be your name.\"',\n    verseVi: 'Vậy các ngươi hãy cầu như vầy: Lạy Cha chúng tôi ở trên trời; Danh Cha được thánh.',\n  },\n  {\n    id: 'nt_017',\n    category: 'verse',\n    q: 'Complete Matthew (Ma-thi-ơ) 6:33: \"But seek first his kingdom and his ___, and all these things will be given to you as well.\"',\n    opts: ['treasure', 'righteousness', 'gold', 'earthly fame'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '6:33',\n    verseEn: 'But seek first his kingdom and his righteousness, and all these things will be given to you as well.',\n    verseVi: 'Nhưng trước hết, hãy tìm kiếm nước Đức Chúa Trời và sự công bình của Ngài, thì Ngài sẽ cho thêm các ngươi mọi điều ấy nữa.',\n  },\n  {\n    id: 'nt_018',\n    category: 'verse',\n    q: 'Complete Matthew (Ma-thi-ơ) 7:7: \"Ask and it will be given to you; seek and you will find; ___ and the door will be opened to you.\"',\n    opts: ['knock', 'shout', 'wait', 'run'],\n    ans: 0,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '7:7',\n    verseEn: 'Ask and it will be given to you; seek and you will find; knock and the door will be opened to you.',\n    verseVi: 'Hãy xin, sẽ được; hãy tìm, sẽ gặp; hãy gõ cửa, sẽ mở cho.',\n  },\n  {\n    id: 'nt_019',\n    category: 'verse',\n    q: 'Complete the Golden Rule taught by Jesus (Đức Chúa Jêsus): \"So in everything, do to others what you would have them ___ to you.\"',\n    opts: ['give', 'do', 'promise', 'say'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '7:12',\n    verseEn: 'So in everything, do to others what you would have them do to you, for this sums up the Law and the Prophets.',\n    verseVi: 'Ấy vậy, hễ điều chi mà các ngươi muốn người ta làm cho mình, thì cũng hãy làm điều đó cho họ, vì ấy là luật pháp và lời tiên tri.',\n  },\n  {\n    id: 'nt_020',\n    category: 'parable',\n    q: 'In Jesus (Đức Chúa Jêsus)\\'s parable, what did the wise man build his house upon so it stood firm in the storm?',\n    opts: ['Soft sand', 'The rock', 'Dry grass', 'Wooden logs'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '7:24-25',\n    verseEn: 'Everyone who hears these words of mine and puts them into practice is like a wise man who built his house on the rock.',\n    verseVi: 'Vậy, kẻ nào nghe và làm theo lời ta phán đây, thì giống như một người khôn ngoan cất nhà mình trên vầng đá.',\n  },\n  {\n    id: 'nt_021',\n    category: 'fact',\n    q: 'When a furious storm threatened the boat on the Sea of Galilee (Biển Ga-li-lê), what did Jesus (Đức Chúa Jêsus) say to the wind and waves?',\n    opts: ['Sail faster!', 'Quiet! Be still!', 'Jump into the sea!', 'Drop the anchor!'],\n    ans: 1,\n    bookEn: 'Mark',\n    bookVi: 'Mác',\n    ref: '4:39',\n    verseEn: 'He got up, rebuked the wind and said to the waves, \"Quiet! Be still!\" Then the wind died down and it was completely calm.',\n    verseVi: 'Ngài bèn thức dậy, quở gió và phán cùng biển rằng: Hãy êm đi, lặng đi! Gió liền dứt, và đều yên lặng như tờ.',\n  },\n  {\n    id: 'nt_022',\n    category: 'fact',\n    q: 'How did four faithful friends bring a paralyzed man to Jesus (Đức Chúa Jêsus) when the house in Capernaum (Ca-bê-na-um) was too crowded?',\n    opts: ['Dug a tunnel under the floor', 'Made an opening in the roof and lowered his mat', 'Waited outside for a month', 'Called him through a window'],\n    ans: 1,\n    bookEn: 'Mark',\n    bookVi: 'Mác',\n    ref: '2:4',\n    verseEn: 'Since they could not get him to Jesus because of the crowd, they made an opening in the roof above Jesus by digging through it and then lowered the mat.',\n    verseVi: 'Bởi tại đông người quá, không đem đến gần Ngài được, họ bèn dỡ mái nhà ngay chỗ Ngài ở; và khi đã đánh trống rồi, thì thòng giường kẻ bại nằm xuống.',\n  },\n  {\n    id: 'nt_023',\n    category: 'fact',\n    q: 'Before becoming an apostle, what job did Matthew (Ma-thi-ơ) (also called Levi (Lê-vi)) have?',\n    opts: ['Carpenter', 'Tax collector', 'Soldier', 'Baker'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '9:9',\n    verseEn: 'As Jesus went on from there, he saw a man named Matthew sitting at the tax collector\\'s booth. \"Follow me,\" he told him.',\n    verseVi: 'Đức Chúa Jêsus đi khỏi nơi đó, thấy một người tên là Ma-thi-ơ đương ngồi tại sở thâu thuế, Ngài bèn phán rằng: Hãy theo ta.',\n  },\n  {\n    id: 'nt_024',\n    category: 'image',\n    visualId: 'loaves_fish',\n    q: 'Look at the basket. How many barley loaves and small fish did a boy share so Jesus (Đức Chúa Jêsus) could feed over 5,000 people?',\n    opts: ['3 loaves and 5 fish', '5 loaves and 2 fish', '7 loaves and 7 fish', '12 loaves and 1 fish'],\n    ans: 1,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '6:9, 11',\n    verseEn: 'Here is a boy with five small barley loaves and two small fish, but how far will they go among so many?',\n    verseVi: 'Đây có một đứa con trai nhỏ, có năm cái bánh mạch nha và hai con cá; nhưng đông người ngần nầy thì ngần ấy có thấm vào đâu!',\n  },\n  {\n    id: 'nt_025',\n    category: 'fact',\n    q: 'After Jesus (Đức Chúa Jêsus) fed the 5,000 with five loaves and two fish, how many basketfuls of leftovers were gathered?',\n    opts: ['3 baskets', '7 baskets', '12 baskets', '20 baskets'],\n    ans: 2,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '6:13',\n    verseEn: 'So they gathered them and filled twelve baskets with the pieces of the five barley loaves left over.',\n    verseVi: 'Vậy họ lượm lấy những miếng bánh mạch nha của năm cái bánh ấy mà người ta ăn còn dư, chứa đầy mười hai giỏ.',\n  },\n  {\n    id: 'nt_026',\n    category: 'fact',\n    q: 'Which disciple walked on the water briefly toward Jesus (Đức Chúa Jêsus) before starting to sink when he looked at the wind?',\n    opts: ['John (Giăng)', 'Peter (Phi-e-rơ)', 'Thomas (Thô-ma)', 'James (Gia-cơ)'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '14:29-30',\n    verseEn: 'Then Peter got down out of the boat, walked on the water and came toward Jesus.',\n    verseVi: 'Phi-e-rơ ở trên thuyền bước xuống, đi bộ trên mặt nước mà đến cùng Đức Chúa Jêsus.',\n  },\n  {\n    id: 'nt_027',\n    category: 'parable',\n    q: 'In the Parable of the Sower (Người Gieo Giống), what kind of soil produced a crop 30, 60, or 100 times what was sown?',\n    opts: ['Rocky ground', 'Thorny ground', 'The path', 'Good soil'],\n    ans: 3,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '13:8, 23',\n    verseEn: 'Still other seed fell on good soil, where it produced a crop—a hundred, sixty or thirty times what was sown.',\n    verseVi: 'Hạt khác lại rơi nhằm chỗ đất tốt, thì sanh trái; hoặc một hột ra một trăm, hoặc một hột ra sáu chục, hoặc một hột ra ba chục.',\n  },\n  {\n    id: 'nt_028',\n    category: 'image',\n    visualId: 'mustard_tree',\n    q: 'Look at the tiny seed growing into a big tree. What small seed did Jesus (Đức Chúa Jêsus) compare the Kingdom of Heaven (Nước Thiên Đàng) to?',\n    opts: ['An acorn', 'A mustard seed', 'An olive pit', 'A date seed'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '13:31-32',\n    verseEn: 'The kingdom of heaven is like a mustard seed... Though it is the smallest of all seeds, yet when it grows, it is the largest of garden plants.',\n    verseVi: 'Nước thiên đàng giống như một hột cải... Hột ấy thật nhỏ hơn cả các giống khác; song khi đã mọc lên, thì lớn hơn các thứ rau.',\n  },\n  {\n    id: 'nt_029',\n    category: 'image',\n    visualId: 'pearl_treasure',\n    q: 'Look at this precious pearl. In Matthew (Ma-thi-ơ) 13, what did the merchant do when he found one pearl of great value?',\n    opts: ['Hid it in the sea', 'Sold everything he had and bought it', 'Gave it back to the fisherman', 'Put it in a wooden box'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '13:45-46',\n    verseEn: 'When he found one of great value, he went away and sold everything he had and bought it.',\n    verseVi: 'Khi đã gặp một hột châu quí giá, thì đi bán hết gia tài mình mà mua hột châu ấy.',\n  },\n  {\n    id: 'nt_030',\n    category: 'parable',\n    q: 'In the Parable of the Good Samaritan (Người Sa-ma-ri Nhơn Lành), who stopped to care for the injured traveler?',\n    opts: ['A priest', 'A Levite (người Lê-vi)', 'A Samaritan (người Sa-ma-ri)', 'A tax collector'],\n    ans: 2,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '10:33-34',\n    verseEn: 'But a Samaritan, as he traveled, came where the man was; and when he saw him, he took pity on him.',\n    verseVi: 'Song có một người Sa-ma-ri đi đường, đến gần người đó, ngó thấy thì động lòng thương xót.',\n  },\n  {\n    id: 'nt_031',\n    category: 'parable',\n    q: 'In Luke (Lu-ca) 15, if a shepherd has 100 sheep and loses 1, what does he do?',\n    opts: ['Forgets about the lost one', 'Leaves the 99 and goes after the lost sheep until he finds it', 'Buys a new goat', 'Goes home to sleep'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '15:4',\n    verseEn: 'Does he not leave the ninety-nine in the open country and go after the lost sheep until he finds it?',\n    verseVi: 'Há chẳng để chín mươi chín con lại nơi đồng vắng, đặng đi tìm con đã mất cho kỳ được sao?',\n  },\n  {\n    id: 'nt_032',\n    category: 'parable',\n    q: 'In the Parable of the Prodigal Son (Đứa Con Trai Hoang Đàng), how did the father react when he saw his lost son returning from afar?',\n    opts: ['Locked the gate', 'Was filled with compassion, ran to his son, threw his arms around him and kissed him', 'Made him pay back every coin first', 'Sent a servant to turn him away'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '15:20',\n    verseEn: 'While he was still a long way off, his father saw him and was filled with compassion for him; he ran to his son, threw his arms around him and kissed him.',\n    verseVi: 'Khi còn ở đằng xa, cha nó thấy thì động lòng thương xót, chạy ra ôm lấy cổ mà hôn.',\n  },\n  {\n    id: 'nt_033',\n    category: 'fact',\n    q: 'Who climbed a sycamore-fig tree in Jericho (Giê-ri-cô) so he could see Jesus (Đức Chúa Jêsus) over the crowd?',\n    opts: ['Nicodemus (Ni-cô-đem)', 'Zacchaeus (Xa-chê)', 'Lazarus (La-xa-rơ)', 'Bartholomew (Ba-thê-lê-mi)'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '19:2-4',\n    verseEn: 'So he ran ahead and climbed a sycamore-fig tree to see him, since Jesus was coming that way.',\n    verseVi: 'Vậy người chạy trước, trèo lên cây sung đặng xem Đức Chúa Jêsus, vì Ngài sắp đi ngang qua đó.',\n  },\n  {\n    id: 'nt_034',\n    category: 'fact',\n    q: 'After welcoming Jesus (Đức Chúa Jêsus) into his home, what did Zacchaeus (Xa-chê) promise to give to the poor?',\n    opts: ['One coin', 'Half of his possessions', 'An old coat', 'A basket of figs'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '19:8',\n    verseEn: 'Look, Lord! Here and now I give half of my possessions to the poor.',\n    verseVi: 'Lạy Chúa, nầy tôi lấy nửa gia tài mình mà cho kẻ nghèo.',\n  },\n  {\n    id: 'nt_035',\n    category: 'fact',\n    q: 'Out of the ten men healed of leprosy by Jesus (Đức Chúa Jêsus), how many came back to thank Him?',\n    opts: ['All 10', '5', 'Only 1 (a Samaritan (người Sa-ma-ri))', 'None'],\n    ans: 2,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '17:15-17',\n    verseEn: 'One of them, when he saw he was healed, came back, praising God in a loud voice.',\n    verseVi: 'Trong bọn đó, có một người thấy mình đã được lành, bèn quay lại, lớn tiếng ngợi khen Đức Chúa Trời.',\n  },\n  {\n    id: 'nt_036',\n    category: 'fact',\n    q: 'When the disciples tried to send little children away, what did Jesus (Đức Chúa Jêsus) say?',\n    opts: ['Children must wait outside', 'Let the little children come to me, and do not hinder them', 'Come back next year', 'Only quiet adults may stay'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '19:14',\n    verseEn: 'Jesus said, \"Let the little children come to me, and do not hinder them, for the kingdom of heaven belongs to such as these.\"',\n    verseVi: 'Đức Chúa Jêsus phán rằng: Hãy để con trẻ đến cùng ta, đừng ngăn trở chúng nó; vì nước thiên đàng thuộc về những kẻ giống như con trẻ ấy.',\n  },\n  {\n    id: 'nt_037',\n    category: 'fact',\n    q: 'Whose two small copper coins did Jesus (Đức Chúa Jêsus) say were worth more than all the rich offerings put into the temple treasury?',\n    opts: ['A Roman governor', 'A poor widow', 'A young merchant', 'A fisherman'],\n    ans: 1,\n    bookEn: 'Mark',\n    bookVi: 'Mác',\n    ref: '12:42-43',\n    verseEn: 'Truly I tell you, this poor widow has put more into the treasury than all the others.',\n    verseVi: 'Quả thật, ta nói cùng các ngươi, mụ góa nghèo nầy đã bỏ tiền vào rương nhiều hơn hết mọi người đã bỏ.',\n  },\n  {\n    id: 'nt_038',\n    category: 'fact',\n    q: 'In Martha (Ma-thê) and Mary (Ma-ri)\\'s home in Bethany (Bê-tha-ni), what did Mary (Ma-ri) choose that Jesus (Đức Chúa Jêsus) called \"what is better\"?',\n    opts: ['Cooking a giant feast', 'Sitting at the Lord\\'s feet listening to what He said', 'Sweeping the courtyard', 'Counting coins'],\n    ans: 1,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '10:39, 42',\n    verseEn: 'Mary has chosen what is better, and it will not be taken away from her.',\n    verseVi: 'Ma-ri đã lựa phần tốt, là phần không có ai cất lấy được.',\n  },\n  {\n    id: 'nt_039',\n    category: 'fact',\n    q: 'Who did Jesus (Đức Chúa Jêsus) raise from the dead in Bethany (Bê-tha-ni) after he had been in the tomb four days?',\n    opts: ['Nicodemus (Ni-cô-đem)', 'Lazarus (La-xa-rơ)', 'Zacchaeus (Xa-chê)', 'Stephen (Ê-tiên)'],\n    ans: 1,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '11:43-44',\n    verseEn: 'Jesus called in a loud voice, \"Lazarus, come out!\" The dead man came out.',\n    verseVi: 'Ngài kêu lớn tiếng rằng: Hỡi La-xa-rơ, hãy ra! Người chết đi ra.',\n  },\n  {\n    id: 'nt_040',\n    category: 'verse',\n    q: 'Complete John (Giăng) 3:16: \"For God (Đức Chúa Trời) so ___ the world that he gave his one and only Son.\"',\n    opts: ['loved', 'judged', 'forgot', 'measured'],\n    ans: 0,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '3:16',\n    verseEn: 'For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life.',\n    verseVi: 'Vì Đức Chúa Trời yêu thương thế gian, đến nỗi đã ban Con một của Ngài, hầu cho hễ ai tin Con ấy không bị hư mất mà được sự sống đời đời.',\n  },\n  {\n    id: 'nt_041',\n    category: 'verse',\n    q: 'Complete Jesus (Đức Chúa Jêsus)\\'s words in John (Giăng) 14:6: \"I am the ___, and the truth and the life.\"',\n    opts: ['road', 'way', 'door', 'bridge'],\n    ans: 1,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '14:6',\n    verseEn: 'Jesus answered, \"I am the way and the truth and the life. No one comes to the Father except through me.\"',\n    verseVi: 'Đức Chúa Jêsus đáp rằng: Ta là đường đi, lẽ thật, và sự sống; chẳng bởi ta thì không ai được đến cùng Cha.',\n  },\n  {\n    id: 'nt_042',\n    category: 'image',\n    visualId: 'shepherd_staff',\n    q: 'In John (Giăng) 10:11, what did Jesus (Đức Chúa Jêsus) say the good shepherd does for the sheep?',\n    opts: ['Sells the wool', 'Lays down his life for the sheep', 'Builds a tall castle', 'Leaves them in the hills'],\n    ans: 1,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '10:11',\n    verseEn: 'I am the good shepherd. The good shepherd lays down his life for the sheep.',\n    verseVi: 'Ta là người chăn hiền lành; người chăn hiền lành vì chiên mình phó sự sống mình.',\n  },\n  {\n    id: 'nt_043',\n    category: 'verse',\n    q: 'In John (Giăng) 15:5, Jesus (Đức Chúa Jêsus) says: \"I am the ___; you are the branches.\"',\n    opts: ['oak', 'vine', 'cedar', 'olive tree'],\n    ans: 1,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '15:5',\n    verseEn: 'I am the vine; you are the branches. If you remain in me and I in you, you will bear much fruit.',\n    verseVi: 'Ta là gốc nho, các ngươi là nhánh. Ai cứ ở trong ta và ta trong họ thì sinh ra lắm trái.',\n  },\n  {\n    id: 'nt_044',\n    category: 'verse',\n    q: 'What new command did Jesus (Đức Chúa Jêsus) give His disciples in John (Giăng) 13:34?',\n    opts: ['Love one another as I have loved you', 'Never speak to strangers', 'Travel only at night', 'Collect silver coins'],\n    ans: 0,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '13:34',\n    verseEn: 'A new command I give you: Love one another. As I have loved you, so you must love one another.',\n    verseVi: 'Ta ban cho các ngươi một điều răn mới, nghĩa là các ngươi phải yêu nhau; như ta đã yêu các ngươi thể nào, thì các ngươi cũng hãy yêu nhau thể ấy.',\n  },\n  {\n    id: 'nt_045',\n    category: 'fact',\n    q: 'On Palm Sunday, what animal did Jesus (Đức Chúa Jêsus) ride as He entered Jerusalem (Giê-ru-sa-lem) while crowds shouted \"Hosanna!\"?',\n    opts: ['A white warhorse', 'A young donkey (colt)', 'A camel', 'A chariot'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '21:7-9',\n    verseEn: 'They brought the donkey and the colt and placed their cloaks on them for Jesus to sit on.',\n    verseVi: 'Hai môn đồ dắt lừa cái và lừa con lại, trải áo trên lưng, rồi Ngài cỡi lên.',\n  },\n  {\n    id: 'nt_046',\n    category: 'fact',\n    q: 'At the Last Supper, what humble act did Jesus (Đức Chúa Jêsus) perform for His twelve disciples to teach servant leadership?',\n    opts: ['Built a table', 'Washed His disciples\\' feet', 'Swept the floor', 'Sang three hymns'],\n    ans: 1,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '13:5, 14',\n    verseEn: 'After that, he poured water into a basin and began to wash his disciples\\' feet.',\n    verseVi: 'Kế đó, Ngài đổ nước vào chậu, và khởi sự rửa chơn cho môn đồ.',\n  },\n  {\n    id: 'nt_047',\n    category: 'fact',\n    q: 'Which disciple betrayed Jesus (Đức Chúa Jêsus) to the chief priests for thirty pieces of silver?',\n    opts: ['Peter (Phi-e-rơ)', 'Judas Iscariot (Giu-đa Ích-ca-ri-ốt)', 'Thomas (Thô-ma)', 'Philip (Phi-líp)'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '26:14-15',\n    verseEn: 'So they counted out for him thirty pieces of silver.',\n    verseVi: 'Các thầy ấy bèn trả cho hắn ba mươi miếng bạc.',\n  },\n  {\n    id: 'nt_048',\n    category: 'fact',\n    q: 'Before the rooster crowed, how many times did Peter (Phi-e-rơ) deny knowing Jesus (Đức Chúa Jêsus)?',\n    opts: ['Once', 'Twice', 'Three times', 'Seven times'],\n    ans: 2,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '26:34, 75',\n    verseEn: '\"Before the rooster crows, you will disown me three times.\" And he went outside and wept bitterly.',\n    verseVi: 'Trước khi gà gáy, ngươi sẽ chối ta ba lần. Người bèn đi ra ngoài, khóc lóc thảm thiết.',\n  },\n  {\n    id: 'nt_049',\n    category: 'fact',\n    q: 'What was the name of the garden where Jesus (Đức Chúa Jêsus) prayed earnestly the night He was arrested?',\n    opts: ['Eden (Ê-đen)', 'Gethsemane (Ghết-sê-ma-nê)', 'Galilee (Ga-li-lê)', 'Carmel (Cạt-mên)'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '26:36',\n    verseEn: 'Then Jesus went with his disciples to a place called Gethsemane, and he said to them, \"Sit here while I go over there and pray.\"',\n    verseVi: 'Đoạn, Đức Chúa Jêsus cùng môn đồ đi đến một nơi gọi là Ghết-sê-ma-nê, Ngài phán cùng môn đồ rằng: Hãy ngồi đây đợi ta đi đằng kia cầu nguyện.',\n  },\n  {\n    id: 'nt_050',\n    category: 'image',\n    visualId: 'empty_tomb',\n    q: 'Look at the empty tomb at dawn. On which day after His crucifixion did Jesus (Đức Chúa Jêsus) rise from the dead?',\n    opts: ['The first day', 'The second day', 'The third day', 'The seventh day'],\n    ans: 2,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '24:6-7',\n    verseEn: 'He is not here; he has risen! Remember how he told you... \"the Son of Man must... on the third day be raised again.\"',\n    verseVi: 'Ngài không ở đây đâu, song Ngài đã sống lại rồi. Hãy nhớ khi Ngài còn ở xứ Ga-li-lê, đã phán cùng các ngươi thể nào... đến ngày thứ ba phải sống lại.',\n  },\n  {\n    id: 'nt_051',\n    category: 'fact',\n    q: 'Which disciple doubted Jesus (Đức Chúa Jêsus)\\'s resurrection until he could see the nail marks in His hands?',\n    opts: ['Thomas (Thô-ma)', 'Andrew (Anh-rê)', 'Matthew (Ma-thi-ơ)', 'John (Giăng)'],\n    ans: 0,\n    bookEn: 'John',\n    bookVi: 'Giăng',\n    ref: '20:25, 28',\n    verseEn: 'Thomas said to him, \"My Lord and my God!\"',\n    verseVi: 'Thô-ma thưa rằng: Lạy Chúa tôi và Đức Chúa Trời tôi!',\n  },\n  {\n    id: 'nt_052',\n    category: 'verse',\n    q: 'In the Great Commission (Đại Mạng Lệnh) in Matthew (Ma-thi-ơ) 28:19, what did Jesus (Đức Chúa Jêsus) command His followers to do?',\n    opts: ['Build stone towers', 'Go and make disciples of all nations', 'Stay hidden indoors', 'Forget what they learned'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '28:19-20',\n    verseEn: 'Therefore go and make disciples of all nations, baptizing them in the name of the Father and of the Son and of the Holy Spirit.',\n    verseVi: 'Vậy, hãy đi dạy dỗ muôn dân, hãy nhân danh Đức Cha, Đức Con, và Đức Thánh Linh mà làm phép báp-tem cho họ.',\n  },\n  {\n    id: 'nt_053',\n    category: 'parable',\n    q: 'In the Parable of the Ten Virgins (Mười Người Nữ Đồng Trinh), what did the five wise virgins remember to bring along with their lamps?',\n    opts: ['Extra loaves of bread', 'Extra oil in jars', 'Silver trumpets', 'Warm blankets'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '25:4',\n    verseEn: 'The wise ones, however, took oil in jars along with their lamps.',\n    verseVi: 'Nhưng những kẻ khôn, khi cầm đèn đi thì có đem dầu theo trong bình.',\n  },\n  {\n    id: 'nt_054',\n    category: 'image',\n    visualId: 'oil_lamp',\n    q: 'Look at the glowing oil lamp. In Matthew (Ma-thi-ơ) 5:15-16, where do people put a lighted lamp instead of under a bowl?',\n    opts: ['Inside a closet', 'On its stand, so it gives light to everyone in the house', 'Under the bed', 'Outside in the rain'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '5:15-16',\n    verseEn: 'Instead they put it on its stand, and it gives light to everyone in the house. In the same way, let your light shine before others.',\n    verseVi: 'Nhưng người ta để trên chơn đèn, thì nó soi sáng mọi người ở trong nhà. Sự sáng các ngươi hãy soi trước mặt người ta như vậy.',\n  },\n  {\n    id: 'nt_055',\n    category: 'parable',\n    q: 'In the Parable of the Talents (Các Ta-lâng), what did the master say to the servants who faithfully doubled their bags of gold?',\n    opts: ['Well done, good and faithful servant!', 'Why did you work so hard?', 'Go away empty-handed', 'Keep it a secret'],\n    ans: 0,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '25:21',\n    verseEn: 'His master replied, \"Well done, good and faithful servant! You have been faithful with a few things; I will put you in charge of many things.\"',\n    verseVi: 'Chủ nói với người rằng: Hỡi đầy tớ ngay lành trung tín kia, được lắm; ngươi đã trung tín trong việc nhỏ, ta sẽ lập ngươi coi sóc nhiều.',\n  },\n  {\n    id: 'nt_056',\n    category: 'fact',\n    q: 'How many times did Jesus (Đức Chúa Jêsus) tell Peter (Phi-e-rơ) we should forgive someone who sins against us (meaning endlessly)?',\n    opts: ['Up to three times', 'Not seven times, but seventy-seven times', 'Once a month', 'Only ten times'],\n    ans: 1,\n    bookEn: 'Matthew',\n    bookVi: 'Ma-thi-ơ',\n    ref: '18:21-22',\n    verseEn: 'Jesus answered, \"I tell you, not seven times, but seventy-seven times.\"',\n    verseVi: 'Đức Chúa Jêsus đáp rằng: Ta không nói cùng ngươi rằng đến bảy lần đâu, nhưng đến bảy mươi lần bảy.',\n  },\n  {\n    id: 'nt_057',\n    category: 'fact',\n    q: 'In Acts (Công-vụ các Sứ-đồ) 2, what came down like tongues of fire on the believers on the Day of Pentecost (Lễ Ngũ Tuần)?',\n    opts: ['Falling stars', 'The Holy Spirit (Đức Thánh Linh)', 'Raindrops', 'White doves'],\n    ans: 1,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '2:3-4',\n    verseEn: 'All of them were filled with the Holy Spirit and began to speak in other tongues as the Spirit enabled them.',\n    verseVi: 'Hết thảy đều được đầy dẫy Đức Thánh Linh, khởi sự nói các thứ tiếng khác, theo như Đức Thánh Linh cho mình nói.',\n  },\n  {\n    id: 'nt_058',\n    category: 'fact',\n    q: 'What did Peter (Phi-e-rơ) say to the lame beggar at the temple gate called Beautiful instead of giving silver or gold?',\n    opts: ['Come back tomorrow', 'In the name of Jesus Christ (Đức Chúa Jêsus Christ) of Nazareth (Na-xa-rét), walk', 'Wait for the priests', 'Here is some bread'],\n    ans: 1,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '3:6',\n    verseEn: 'Silver or gold I do not have, but what I do have I give you. In the name of Jesus Christ of Nazareth, walk.',\n    verseVi: 'Ta chẳng có vàng bạc chi hết, nhưng điều ta có thì ta cho ngươi: Nhân danh Đức Chúa Jêsus Christ ở Na-xa-rét, hãy bước đi!',\n  },\n  {\n    id: 'nt_059',\n    category: 'fact',\n    q: 'Who was the first Christian martyr in Acts (Công-vụ các Sứ-đồ), who prayed for those stoning him to be forgiven?',\n    opts: ['Barnabas (Ba-na-ba)', 'Stephen (Ê-tiên)', 'Silas (Si-la)', 'Timothy (Ti-mô-thê)'],\n    ans: 1,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '7:59-60',\n    verseEn: 'Then he fell on his knees and cried out, \"Lord, do not hold this sin against them.\"',\n    verseVi: 'Đoạn, người quì xuống, kêu lớn tiếng rằng: Lạy Chúa, xin đừng đổ tội nầy cho họ!',\n  },\n  {\n    id: 'nt_060',\n    category: 'fact',\n    q: 'Where was Saul (Sau-lơ) (later called Paul (Phao-lô)) traveling when a bright light from heaven flashed around him and Jesus (Đức Chúa Jêsus) spoke to him?',\n    opts: ['On the road to Damascus (Đa-mách)', 'On a ship to Nineveh (Ni-ni-ve)', 'In Bethlehem (Bết-lê-hem)', 'In Egypt (Ê-díp-tô)'],\n    ans: 0,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '9:3-5',\n    verseEn: 'As he neared Damascus on his journey, suddenly a light from heaven flashed around him.',\n    verseVi: 'Đương đi đường gần đến thành Đa-mách, thình lình có ánh sáng từ trời chói lòa chung quanh người.',\n  },\n  {\n    id: 'nt_061',\n    category: 'fact',\n    q: 'Which brave Christian disciple named Dorcas / Tabitha (Ta-bi-tha / Đô-ca) was known for always doing good and making robes for widows?',\n    opts: ['Tabitha / Dorcas (Ta-bi-tha / Đô-ca)', 'Lydia (Ly-đi)', 'Priscilla (Bê-rít-sin)', 'Eunice (Ơ-nít)'],\n    ans: 0,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '9:36, 39',\n    verseEn: 'In Joppa there was a disciple named Tabitha (in Greek her name is Dorcas); she was always doing good and helping the poor.',\n    verseVi: 'Tại thành Giốp-bê có một người nữ môn đồ tên là Ta-bi-tha, nghĩa là Đô-ca; người ấy làm nhiều việc lành và hay bố thí lắm.',\n  },\n  {\n    id: 'nt_062',\n    category: 'fact',\n    q: 'In Philippi (Phi-líp), who was a dealer in purple cloth who listened to Paul (Phao-lô) and welcomed the missionaries into her home?',\n    opts: ['Lydia (Ly-đi)', 'Martha (Ma-thê)', 'Miriam (Mi-ri-am)', 'Rahab (Ra-háp)'],\n    ans: 0,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '16:14-15',\n    verseEn: 'One of those listening was a woman from the city of Thyatira named Lydia, a dealer in purple cloth. The Lord opened her heart.',\n    verseVi: 'Có một người đàn bà tên là Ly-đi, quê ở thành Thi-a-ti-rơ, làm nghề bán vải điều... Chúa mở lòng cho người đặng chăm chỉ nghe lời Phao-lô nói.',\n  },\n  {\n    id: 'nt_063',\n    category: 'fact',\n    q: 'What were Paul (Phao-lô) and Silas (Si-la) doing in prison at midnight right before an earthquake opened all the doors?',\n    opts: ['Digging a tunnel', 'Praying and singing hymns to God (Đức Chúa Trời)', 'Arguing with the jailer', 'Sleeping soundly'],\n    ans: 1,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '16:25-26',\n    verseEn: 'About midnight Paul and Silas were praying and singing hymns to God, and the other prisoners were listening to them.',\n    verseVi: 'Lối nửa đêm, Phao-lô và Si-la đương cầu nguyện, hát ngợi khen Đức Chúa Trời; những người tù đều lắng tai nghe.',\n  },\n  {\n    id: 'nt_064',\n    category: 'verse',\n    q: 'What did Paul (Phao-lô) and Silas (Si-la) answer when the Philippian (Phi-líp) jailer asked, \"Sirs, what must I do to be saved?\"',\n    opts: ['Pay a fine to the king', 'Believe in the Lord Jesus (Đức Chúa Jêsus), and you will be saved', 'Run to Jerusalem (Giê-ru-sa-lem)', 'Build a stone altar'],\n    ans: 1,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '16:31',\n    verseEn: 'They replied, \"Believe in the Lord Jesus, and you will be saved—you and your household.\"',\n    verseVi: 'Hai người trả lời rằng: Hãy tin Đức Chúa Jêsus, thì ngươi và cả nhà ngươi đều sẽ được cứu rỗi.',\n  },\n  {\n    id: 'nt_065',\n    category: 'fact',\n    q: 'On a stormy sea voyage to Rome (Rô-ma), after Paul (Phao-lô)\\'s ship wrecked on Malta (Man-tơ), everyone safely reached shore. How many died?',\n    opts: ['Half of them', 'Twenty sailors', 'Not a single person died', 'Only the captain'],\n    ans: 2,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '27:44',\n    verseEn: 'In this way everyone reached land safely.',\n    verseVi: 'Nhờ vậy, ai nấy đều lên bờ được bình yên cả.',\n  },\n  {\n    id: 'nt_066',\n    category: 'verse',\n    q: 'Complete Romans (Rô-ma) 8:28: \"And we know that in all things God (Đức Chúa Trời) works for the ___ of those who love him.\"',\n    opts: ['wealth', 'good', 'power', 'fame'],\n    ans: 1,\n    bookEn: 'Romans',\n    bookVi: 'Rô-ma',\n    ref: '8:28',\n    verseEn: 'And we know that in all things God works for the good of those who love him, who have been called according to his purpose.',\n    verseVi: 'Vả, chúng ta biết rằng mọi sự hiệp lại làm ích cho kẻ yêu mến Đức Chúa Trời, tức là cho kẻ được gọi theo ý muốn Ngài đã định.',\n  },\n  {\n    id: 'nt_067',\n    category: 'verse',\n    q: 'Complete Romans (Rô-ma) 12:21: \"Do not be overcome by evil, but overcome evil with ___.\"',\n    opts: ['anger', 'good', 'silence', 'strength'],\n    ans: 1,\n    bookEn: 'Romans',\n    bookVi: 'Rô-ma',\n    ref: '12:21',\n    verseEn: 'Do not be overcome by evil, but overcome evil with good.',\n    verseVi: 'Đừng để điều ác thắng mình, nhưng hãy lấy điều thiện thắng điều ác.',\n  },\n  {\n    id: 'nt_068',\n    category: 'verse',\n    q: 'According to Romans (Rô-ma) 3:23 and 6:23, what is the free gift of God (Đức Chúa Trời) in Christ Jesus (Đức Chúa Jêsus Christ) our Lord?',\n    opts: ['Silver and gold', 'Eternal life', 'An earthly crown', 'A big house'],\n    ans: 1,\n    bookEn: 'Romans',\n    bookVi: 'Rô-ma',\n    ref: '6:23',\n    verseEn: 'For the wages of sin is death, but the gift of God is eternal life in Christ Jesus our Lord.',\n    verseVi: 'Vì tiền công của tội lỗi là sự chết; nhưng sự ban cho của Đức Chúa Trời là sự sống đời đời trong Đức Chúa Jêsus Christ, Chúa chúng ta.',\n  },\n  {\n    id: 'nt_069',\n    category: 'verse',\n    q: 'In 1 Corinthians (I Cô-rinh-tô) 13:13, among faith, hope, and love, which is the greatest?',\n    opts: ['Faith', 'Hope', 'Love', 'Knowledge'],\n    ans: 2,\n    bookEn: '1 Corinthians',\n    bookVi: 'I Cô-rinh-tô',\n    ref: '13:13',\n    verseEn: 'And now these three remain: faith, hope and love. But the greatest of these is love.',\n    verseVi: 'Nên bây giờ còn có ba điều nầy: đức tin, sự trông cậy, tình yêu thương; nhưng điều trọng hơn trong ba điều ấy là tình yêu thương.',\n  },\n  {\n    id: 'nt_070',\n    category: 'verse',\n    q: 'Complete 1 Corinthians (I Cô-rinh-tô) 13:4: \"Love is ___, love is kind. It does not envy, it does not boast.\"',\n    opts: ['fast', 'patient', 'loud', 'proud'],\n    ans: 1,\n    bookEn: '1 Corinthians',\n    bookVi: 'I Cô-rinh-tô',\n    ref: '13:4',\n    verseEn: 'Love is patient, love is kind. It does not envy, it does not boast, it is not proud.',\n    verseVi: 'Tình yêu thương hay nhịn nhục; tình yêu thương hay nhơn từ; tình yêu thương chẳng ghen tị, chẳng khoe mình, chẳng lên mình kiêu ngạo.',\n  },\n  {\n    id: 'nt_071',\n    category: 'verse',\n    q: 'According to 2 Corinthians (II Cô-rinh-tô) 9:7, what kind of giver does God (Đức Chúa Trời) love?',\n    opts: ['A reluctant giver', 'A cheerful giver', 'A proud giver', 'A noisy giver'],\n    ans: 1,\n    bookEn: '2 Corinthians',\n    bookVi: 'II Cô-rinh-tô',\n    ref: '9:7',\n    verseEn: 'Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion, for God loves a cheerful giver.',\n    verseVi: 'Mỗi người nên tùy theo lòng mình đã định mà quyên ra, không phải phàn nàn hay là vì ép uổng; vì Đức Chúa Trời yêu kẻ dâng của cách vui lòng.',\n  },\n  {\n    id: 'nt_072',\n    category: 'verse',\n    q: 'In Galatians (Ga-la-ti) 5:22-23, what is the \"fruit of the Spirit\" (trái của Thánh Linh)?',\n    opts: ['Gold, silver, and pearls', 'Love, joy, peace, forbearance (patience), kindness, goodness, faithfulness, gentleness and self-control', 'Strength, speed, and wisdom', 'Bread, wine, and honey'],\n    ans: 1,\n    bookEn: 'Galatians',\n    bookVi: 'Ga-la-ti',\n    ref: '5:22-23',\n    verseEn: 'But the fruit of the Spirit is love, joy, peace, forbearance, kindness, goodness, faithfulness, gentleness and self-control.',\n    verseVi: 'Nhưng trái của Thánh Linh, ấy là lòng yêu thương, sự vui mừng, bình an, nhịn nhục, nhơn từ, hiền lành, trung tín, mềm mại, tiết độ.',\n  },\n  {\n    id: 'nt_073',\n    category: 'verse',\n    q: 'Complete Ephesians (Ê-phê-sô) 6:1: \"Children, ___ your parents in the Lord, for this is right.\"',\n    opts: ['ignore', 'obey', 'question', 'avoid'],\n    ans: 1,\n    bookEn: 'Ephesians',\n    bookVi: 'Ê-phê-sô',\n    ref: '6:1',\n    verseEn: 'Children, obey your parents in the Lord, for this is right.',\n    verseVi: 'Hỡi kẻ làm con cái, hãy vâng phục cha mẹ mình trong Chúa, vì điều đó là phải lắm.',\n  },\n  {\n    id: 'nt_074',\n    category: 'verse',\n    q: 'Complete Ephesians (Ê-phê-sô) 4:32: \"Be ___ and compassionate to one another, forgiving each other, just as in Christ (Đấng Christ) God (Đức Chúa Trời) forgave you.\"',\n    opts: ['kind', 'strict', 'quiet', 'fast'],\n    ans: 0,\n    bookEn: 'Ephesians',\n    bookVi: 'Ê-phê-sô',\n    ref: '4:32',\n    verseEn: 'Be kind and compassionate to one another, forgiving each other, just as in Christ God forgave you.',\n    verseVi: 'Hãy ở với nhau cách nhơn từ, đầy dẫy lòng thương xót, tha thứ nhau như Đức Chúa Trời đã tha thứ anh em trong Đấng Christ vậy.',\n  },\n  {\n    id: 'nt_075',\n    category: 'image',\n    visualId: 'armor_shield',\n    q: 'Look at the full armor of God (Đức Chúa Trời) in Ephesians (Ê-phê-sô) 6. Which piece is called the \"sword of the Spirit\"?',\n    opts: ['The golden shield', 'The word of God (lời Đức Chúa Trời)', 'The iron helmet', 'The bronze belt'],\n    ans: 1,\n    bookEn: 'Ephesians',\n    bookVi: 'Ê-phê-sô',\n    ref: '6:17',\n    verseEn: 'Take the helmet of salvation and the sword of the Spirit, which is the word of God.',\n    verseVi: 'Cũng hãy lấy sự cứu chuộc làm mão trụ, và cầm gươm của Đức Thánh Linh, là lời Đức Chúa Trời.',\n  },\n  {\n    id: 'nt_076',\n    category: 'image',\n    visualId: 'armor_shield',\n    q: 'In the armor of God (Đức Chúa Trời) (Ephesians (Ê-phê-sô) 6:16), which piece extinguishes all the flaming arrows of the evil one?',\n    opts: ['The sandals of peace', 'The shield of faith', 'The belt of truth', 'The trumpet'],\n    ans: 1,\n    bookEn: 'Ephesians',\n    bookVi: 'Ê-phê-sô',\n    ref: '6:16',\n    verseEn: 'In addition to all this, take up the shield of faith, with which you can extinguish all the flaming arrows of the evil one.',\n    verseVi: 'Lại phải lấy thêm đức tin làm thuẫn, nhờ đó anh em có thể dập tắt được các tên lửa của kẻ dữ.',\n  },\n  {\n    id: 'nt_077',\n    category: 'verse',\n    q: 'Complete Philippians (Phi-líp) 4:13: \"I can do all this through him who gives me ___.\"',\n    opts: ['money', 'strength', 'fame', 'wings'],\n    ans: 1,\n    bookEn: 'Philippians',\n    bookVi: 'Phi-líp',\n    ref: '4:13',\n    verseEn: 'I can do all this through him who gives me strength.',\n    verseVi: 'Tôi làm được mọi sự nhờ Đấng ban thêm sức cho tôi.',\n  },\n  {\n    id: 'nt_078',\n    category: 'verse',\n    q: 'Complete Philippians (Phi-líp) 4:4: \"___ in the Lord always. I will say it again: Rejoice!\"',\n    opts: ['Worry', 'Rejoice', 'Sleep', 'Hurry'],\n    ans: 1,\n    bookEn: 'Philippians',\n    bookVi: 'Phi-líp',\n    ref: '4:4',\n    verseEn: 'Rejoice in the Lord always. I will say it again: Rejoice!',\n    verseVi: 'Hãy vui mừng trong Chúa luôn luôn. Tôi lại còn nói nữa: hãy vui mừng đi!',\n  },\n  {\n    id: 'nt_079',\n    category: 'verse',\n    q: 'According to Colossians (Cô-lô-se) 3:23, how should we do whatever work we have?',\n    opts: ['Only when people watch', 'Work at it with all your heart, as working for the Lord', 'Quickly without care', 'Wait for someone else'],\n    ans: 1,\n    bookEn: 'Colossians',\n    bookVi: 'Cô-lô-se',\n    ref: '3:23',\n    verseEn: 'Whatever you do, work at it with all your heart, as working for the Lord, not for human masters.',\n    verseVi: 'Hễ làm việc gì, hãy hết lòng mà làm, như làm cho Chúa, chớ không phải làm cho người ta.',\n  },\n  {\n    id: 'nt_080',\n    category: 'verse',\n    q: 'Complete 1 Thessalonians (I Tê-sa-lô-ni-ca) 5:16-18: \"Rejoice always, pray continually, give ___ in all circumstances.\"',\n    opts: ['orders', 'thanks', 'money', 'speeches'],\n    ans: 1,\n    bookEn: '1 Thessalonians',\n    bookVi: 'I Tê-sa-lô-ni-ca',\n    ref: '5:16-18',\n    verseEn: 'Rejoice always, pray continually, give thanks in all circumstances; for this is God\\'s will for you in Christ Jesus.',\n    verseVi: 'Hãy vui mừng mãi mãi, cầu nguyện không thôi, phàm việc gì cũng phải tạ ơn Chúa; vì ý muốn của Đức Chúa Trời trong Đức Chúa Jêsus Christ đối với anh em là như vậy.',\n  },\n  {\n    id: 'nt_081',\n    category: 'verse',\n    q: 'What encouragement did Paul (Phao-lô) write to young Timothy (Ti-mô-thê) in 1 Timothy (I Ti-mô-thê) 4:12?',\n    opts: ['Wait until you are older to serve', 'Don\\'t let anyone look down on you because you are young, but set an example for the believers', 'Stay silent in church', 'Never travel by ship'],\n    ans: 1,\n    bookEn: '1 Timothy',\n    bookVi: 'I Ti-mô-thê',\n    ref: '4:12',\n    verseEn: 'Don\\'t let anyone look down on you because you are young, but set an example for the believers in speech, in conduct, in love, in faith and in purity.',\n    verseVi: 'Chớ để người ta khinh con vì trẻ tuổi; nhưng phải lấy lời nói, nết làm, sự yêu thương, đức tin và sự tinh sạch mà làm gương cho các tín đồ.',\n  },\n  {\n    id: 'nt_082',\n    category: 'verse',\n    q: 'According to 2 Timothy (II Ti-mô-thê) 3:16, all Scripture (Kinh Thánh) is God-breathed and useful for what?',\n    opts: ['Teaching, rebuking, correcting and training in righteousness', 'Only reading once a year', 'Telling jokes', 'Predicting weather'],\n    ans: 0,\n    bookEn: '2 Timothy',\n    bookVi: 'II Ti-mô-thê',\n    ref: '3:16',\n    verseEn: 'All Scripture is God-breathed and is useful for teaching, rebuking, correcting and training in righteousness.',\n    verseVi: 'Cả Kinh Thánh đều là bởi Đức Chúa Trời soi dẫn, có ích cho sự dạy dỗ, bẻ trách, sửa trị, dạy người trong sự công bình.',\n  },\n  {\n    id: 'nt_083',\n    category: 'verse',\n    q: 'Complete Hebrews (Hê-bơ-rơ) 11:1: \"Now ___ is confidence in what we hope for and assurance about what we do not see.\"',\n    opts: ['wealth', 'faith', 'luck', 'pride'],\n    ans: 1,\n    bookEn: 'Hebrews',\n    bookVi: 'Hê-bơ-rơ',\n    ref: '11:1',\n    verseEn: 'Now faith is confidence in what we hope for and assurance about what we do not see.',\n    verseVi: 'Vả, đức tin là sự biết chắc vững vàng của những điều mình đương trông mong, là bằng cớ của những điều mình chẳng xem thấy.',\n  },\n  {\n    id: 'nt_084',\n    category: 'verse',\n    q: 'Complete Hebrews (Hê-bơ-rơ) 13:8: \"Jesus Christ (Đức Chúa Jêsus Christ) is the ___ yesterday and today and forever.\"',\n    opts: ['same', 'newest', 'quietest', 'furthest'],\n    ans: 0,\n    bookEn: 'Hebrews',\n    bookVi: 'Hê-bơ-rơ',\n    ref: '13:8',\n    verseEn: 'Jesus Christ is the same yesterday and today and forever.',\n    verseVi: 'Đức Chúa Jêsus Christ hôm qua, ngày nay, và cho đến đời đời không hề thay đổi.',\n  },\n  {\n    id: 'nt_085',\n    category: 'verse',\n    q: 'According to James (Gia-cơ) 1:19, how should every believer behave?',\n    opts: ['Quick to listen, slow to speak and slow to become angry', 'Quick to shout and argue', 'Slow to forgive', 'Always rushing'],\n    ans: 0,\n    bookEn: 'James',\n    bookVi: 'Gia-cơ',\n    ref: '1:19',\n    verseEn: 'Everyone should be quick to listen, slow to speak and slow to become angry.',\n    verseVi: 'Mọi người đều phải mau nghe mà chậm nói, chậm giận.',\n  },\n  {\n    id: 'nt_086',\n    category: 'verse',\n    q: 'Complete 1 Peter (I Phi-e-rơ) 5:7: \"Cast all your ___ on him because he cares for you.\"',\n    opts: ['shoes', 'anxiety (worries)', 'coats', 'stones'],\n    ans: 1,\n    bookEn: '1 Peter',\n    bookVi: 'I Phi-e-rơ',\n    ref: '5:7',\n    verseEn: 'Cast all your anxiety on him because he cares for you.',\n    verseVi: 'Hãy trao mọi điều lo lắng mình cho Ngài, vì Ngài hay săn sóc anh em.',\n  },\n  {\n    id: 'nt_087',\n    category: 'verse',\n    q: 'Complete 1 John (I Giăng) 4:8: \"Whoever does not love does not know God (Đức Chúa Trời), because God is ___.\"',\n    opts: ['anger', 'love', 'winter', 'silence'],\n    ans: 1,\n    bookEn: '1 John',\n    bookVi: 'I Giăng',\n    ref: '4:8',\n    verseEn: 'Whoever does not love does not know God, because God is love.',\n    verseVi: 'Ai chẳng yêu, thì không biết Đức Chúa Trời; vì Đức Chúa Trời là sự yêu thương.',\n  },\n  {\n    id: 'nt_088',\n    category: 'verse',\n    q: 'Complete 1 John (I Giăng) 1:9: \"If we confess our sins, he is faithful and just and will ___ us our sins.\"',\n    opts: ['remember', 'forgive', 'double', 'hide'],\n    ans: 1,\n    bookEn: '1 John',\n    bookVi: 'I Giăng',\n    ref: '1:9',\n    verseEn: 'If we confess our sins, he is faithful and just and will forgive us our sins and purify us from all unrighteousness.',\n    verseVi: 'Còn nếu chúng ta xưng tội mình, thì Ngài là thành tín công bình để tha tội cho chúng ta, và làm cho chúng ta sạch mọi điều gian ác.',\n  },\n  {\n    id: 'nt_089',\n    category: 'fact',\n    q: 'Which book is the very last book of the New Testament and the entire Bible?',\n    opts: ['Acts (Công-vụ các Sứ-đồ)', 'Jude (Giu-đe)', 'Revelation (Khải-huyền)', 'Romans (Rô-ma)'],\n    ans: 2,\n    bookEn: 'Revelation',\n    bookVi: 'Khải-huyền',\n    ref: '1:1; 22:21',\n    verseEn: 'The revelation from Jesus Christ, which God gave him...',\n    verseVi: 'Sự mặc thị của Đức Chúa Jêsus Christ mà Đức Chúa Trời đã ban cho Ngài...',\n  },\n  {\n    id: 'nt_090',\n    category: 'fact',\n    q: 'On which island was the apostle John (Giăng) when he wrote the Book of Revelation (Khải-huyền)?',\n    opts: ['Cyprus (Chíp-rơ)', 'Patmos (Bát-mô)', 'Crete (Cơ-rết)', 'Malta (Man-tơ)'],\n    ans: 1,\n    bookEn: 'Revelation',\n    bookVi: 'Khải-huyền',\n    ref: '1:9',\n    verseEn: 'I, John, your brother and companion... was on the island of Patmos because of the word of God.',\n    verseVi: 'Tôi là Giăng, là anh em và bạn hữu với các ngươi... trước đã ở đảo Bát-mô vì cớ lời Đức Chúa Trời.',\n  },\n  {\n    id: 'nt_091',\n    category: 'verse',\n    q: 'In Revelation (Khải-huyền) 21:4, what does God (Đức Chúa Trời) promise to do for His people in the New Jerusalem (Giê-ru-sa-lem mới)?',\n    opts: ['He will wipe every tear from their eyes', 'Give everyone a chariot', 'Build taller mountains', 'Turn the sky green'],\n    ans: 0,\n    bookEn: 'Revelation',\n    bookVi: 'Khải-huyền',\n    ref: '21:4',\n    verseEn: 'He will wipe every tear from their eyes. There will be no more death or mourning or crying or pain.',\n    verseVi: 'Ngài sẽ lau ráo hết nước mắt khỏi mắt chúng, sẽ không có sự chết, cũng không có than khóc, kêu ca, hay là đau đớn nữa.',\n  },\n  {\n    id: 'nt_092',\n    category: 'fact',\n    q: 'What are the four Gospels (Bốn sách Tin Lành) at the beginning of the New Testament?',\n    opts: ['Genesis (Sáng-thế Ký), Exodus (Xuất Ê-díp-tô Ký), Leviticus (Lê-vi Ký), Numbers (Dân-số Ký)', 'Matthew (Ma-thi-ơ), Mark (Mác), Luke (Lu-ca), John (Giăng)', 'Romans (Rô-ma), Galatians (Ga-la-ti), Ephesians (Ê-phê-sô), Philippians (Phi-líp)', 'James (Gia-cơ), Peter (Phi-e-rơ), John (Giăng), Jude (Giu-đe)'],\n    ans: 1,\n    bookEn: 'Mark',\n    bookVi: 'Mác',\n    ref: '1:1',\n    verseEn: 'The beginning of the good news about Jesus the Messiah, the Son of God.',\n    verseVi: 'Đầu Tin Lành của Đức Chúa Jêsus Christ, là Con Đức Chúa Trời.',\n  },\n  {\n    id: 'nt_093',\n    category: 'fact',\n    q: 'Which Gospel writer was a beloved physician (doctor) who also wrote the Book of Acts (Công-vụ các Sứ-đồ)?',\n    opts: ['Mark (Mác)', 'Luke (Lu-ca)', 'Matthew (Ma-thi-ơ)', 'John (Giăng)'],\n    ans: 1,\n    bookEn: 'Colossians',\n    bookVi: 'Cô-lô-se',\n    ref: '4:14',\n    verseEn: 'Our dear friend Luke, the doctor, and Demas send greetings.',\n    verseVi: 'Lu-ca, là thầy thuốc rất yêu dấu, cùng Đê-ma chào thăm anh em.',\n  },\n  {\n    id: 'nt_094',\n    category: 'fact',\n    q: 'Which two brothers among the twelve apostles were called \"Sons of Thunder\" (Con của sấm sét) by Jesus (Đức Chúa Jêsus)?',\n    opts: ['Peter (Phi-e-rơ) and Andrew (Anh-rê)', 'James (Gia-cơ) and John (Giăng)', 'Philip (Phi-líp) and Thomas (Thô-ma)', 'Matthew (Ma-thi-ơ) and Simon (Si-môn)'],\n    ans: 1,\n    bookEn: 'Mark',\n    bookVi: 'Mác',\n    ref: '3:17',\n    verseEn: 'James son of Zebedee and his brother John (to them he gave the name Boanerges, which means \"sons of thunder\").',\n    verseVi: 'Gia-cơ, con Xê-bê-đê, với Giăng là em Gia-cơ, Ngài đặt tên cho hai người là Bô-a-nẹt, nghĩa là con của sấm sét.',\n  },\n  {\n    id: 'nt_095',\n    category: 'fact',\n    q: 'Who helped carry Jesus (Đức Chúa Jêsus)\\'s cross along the road to Golgotha (Gô-gô-tha)?',\n    opts: ['Simon of Cyrene (Si-môn người Sy-ren)', 'Barnabas (Ba-na-ba)', 'Timothy (Ti-mô-thê)', 'Silas (Si-la)'],\n    ans: 0,\n    bookEn: 'Mark',\n    bookVi: 'Mác',\n    ref: '15:21',\n    verseEn: 'A certain man from Cyrene, Simon... was passing by on his way in from the country, and they forced him to carry the cross.',\n    verseVi: 'Có một người quê ở Sy-ren tên là Si-môn... từ ngoài đồng đi ngang qua đó, chúng ép người vác cây thập tự của Ngài.',\n  },\n  {\n    id: 'nt_096',\n    category: 'fact',\n    q: 'On the day Jesus (Đức Chúa Jêsus) rose from the dead, who were the two disciples walking to Emmaus (Em-ma-út) when Jesus walked beside them?',\n    opts: ['Cleopas (Clê-ô-ba) and another disciple', 'Paul (Phao-lô) and Barnabas (Ba-na-ba)', 'Stephen (Ê-tiên) and Philip (Phi-líp)', 'Mark (Mác) and Luke (Lu-ca)'],\n    ans: 0,\n    bookEn: 'Luke',\n    bookVi: 'Lu-ca',\n    ref: '24:13-18',\n    verseEn: 'Now that same day two of them were going to a village called Emmaus... Jesus himself came up and walked along with them.',\n    verseVi: 'Cũng trong ngày đó, có hai môn đồ đi đến một làng kia gọi là Em-ma-út... chính Đức Chúa Jêsus đến gần, cùng đi với hai người.',\n  },\n  {\n    id: 'nt_097',\n    category: 'fact',\n    q: 'Who was the Roman centurion in Caesarea (Sê-sa-rê) who prayed, gave generously, and received the gospel when Peter (Phi-e-rơ) visited?',\n    opts: ['Cornelius (Cọt-nây)', 'Pilate (Phi-lát)', 'Herod (Hê-rốt)', 'Felix (Phê-lích)'],\n    ans: 0,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '10:1-2, 44',\n    verseEn: 'At Caesarea there was a man named Cornelius, a centurion... He and all his family were devout and God-fearing.',\n    verseVi: 'Tại thành Sê-sa-rê có một người tên là Cọt-nây, làm thầy đội... Người và cả nhà đều tin kính, sợ Đức Chúa Trời.',\n  },\n  {\n    id: 'nt_098',\n    category: 'fact',\n    q: 'What craft did the apostle Paul (Phao-lô) work at to support himself alongside Aquila (A-qui-la) and Priscilla (Bê-rít-sin)?',\n    opts: ['Stone carver', 'Tentmaker', 'Ship captain', 'Potter'],\n    ans: 1,\n    bookEn: 'Acts',\n    bookVi: 'Công-vụ các Sứ-đồ',\n    ref: '18:2-3',\n    verseEn: 'Because he was a tentmaker as they were, he stayed and worked with them.',\n    verseVi: 'Vì đồng nghề với hai người là nghề làm trại, nên Phao-lô ở lại nhà họ mà làm việc.',\n  },\n  {\n    id: 'nt_099',\n    category: 'fact',\n    q: 'What did the mother Eunice (Ơ-nít) and grandmother Lois (Lô-ít) pass down to young Timothy (Ti-mô-thê)?',\n    opts: ['A large vineyard', 'Their sincere faith and knowledge of the Holy Scriptures (Kinh Thánh)', 'Ten silver talents', 'A chariot'],\n    ans: 1,\n    bookEn: '2 Timothy',\n    bookVi: 'II Ti-mô-thê',\n    ref: '1:5; 3:15',\n    verseEn: 'I am reminded of your sincere faith, which first lived in your grandmother Lois and in your mother Eunice.',\n    verseVi: 'Ta nhớ đến đức tin thành thật của con, là đức tin trước đã ở trong Lô-ít, bà ngoại con, và trong Ơ-nít, mẹ con.',\n  },\n  {\n    id: 'nt_100',\n    category: 'verse',\n    q: 'In Revelation (Khải-huyền) 3:20, what does Jesus (Đức Chúa Jêsus) say He is doing at the door?',\n    opts: ['Here I am! I stand at the door and knock', 'I have locked the door forever', 'Wait outside until night', 'Walk away quickly'],\n    ans: 0,\n    bookEn: 'Revelation',\n    bookVi: 'Khải-huyền',\n    ref: '3:20',\n    verseEn: 'Here I am! I stand at the door and knock. If anyone hears my voice and opens the door, I will come in and eat with that person, and they with me.',\n    verseVi: 'Nầy, ta đứng ngoài cửa mà gõ; nếu ai nghe tiếng ta mà mở cửa cho, thì ta sẽ vào cùng người ấy, ăn bữa tối với người, và người với ta.',\n  },\n];\n"},{"path":"src/game/bibleDataOT.ts","encoding":"utf8","content":"import { BibleQuestion } from '../types/b2ks';\n\n// 100 Old Testament Questions (NIV English + Kinh Thánh Tin Lành Truyền Thống 1925 Vietnamese)\nexport const BIBLE_OT_QUESTIONS: BibleQuestion[] = [\n  {\n    id: 'ot_001',\n    category: 'verse',\n    q: 'Complete the very first verse of the Bible: \"In the beginning God (Đức Chúa Trời) created the heavens and the ___.\"',\n    opts: ['earth', 'oceans', 'mountains', 'angels'],\n    ans: 0,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '1:1',\n    verseEn: 'In the beginning God created the heavens and the earth.',\n    verseVi: 'Ban đầu Đức Chúa Trời dựng nên trời đất.',\n  },\n  {\n    id: 'ot_002',\n    category: 'fact',\n    q: 'What did God (Đức Chúa Trời) create on the very first day?',\n    opts: ['Trees', 'Light', 'Animals', 'Stars'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '1:3',\n    verseEn: 'And God said, \"Let there be light,\" and there was light.',\n    verseVi: 'Đức Chúa Trời phán rằng: Phải có sự sáng; thì có sự sáng.',\n  },\n  {\n    id: 'ot_003',\n    category: 'fact',\n    q: 'On which day of creation did God (Đức Chúa Trời) rest and bless the day?',\n    opts: ['Fifth day', 'Sixth day', 'Seventh day', 'First day'],\n    ans: 2,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '2:2-3',\n    verseEn: 'By the seventh day God had finished the work he had been doing; so on the seventh day he rested.',\n    verseVi: 'Ngày thứ bảy, Đức Chúa Trời làm xong các công việc Ngài đã làm, và ngày thứ bảy Ngài nghỉ.',\n  },\n  {\n    id: 'ot_004',\n    category: 'fact',\n    q: 'What was the name of the beautiful garden where Adam (A-đam) and Eve (Ê-va) first lived?',\n    opts: ['Canaan (Ca-na-an)', 'Eden (Ê-đen)', 'Galilee (Ga-li-lê)', 'Sinai (Si-na-i)'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '2:8',\n    verseEn: 'Now the LORD God had planted a garden in the east, in Eden; and there he put the man he had formed.',\n    verseVi: 'Đoạn, Giê-hô-va Đức Chúa Trời lập một cảnh vườn tại Ê-đen, ở về hướng đông, và đặt người mà Ngài vừa dựng nên ở đó.',\n  },\n  {\n    id: 'ot_005',\n    category: 'fact',\n    q: 'Who were the first two sons of Adam (A-đam) and Eve (Ê-va)?',\n    opts: ['Cain (Ca-in) and Abel (A-ben)', 'Jacob (Gia-cốp) and Esau (Ê-sau)', 'Shem (Sem) and Ham (Cham)', 'Isaac (Y-sác) and Ishmael (Ích-ma-ên)'],\n    ans: 0,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '4:1-2',\n    verseEn: 'She gave birth to Cain... Later she gave birth to his brother Abel.',\n    verseVi: 'Người sanh Ca-in... Người lại sanh em là A-ben.',\n  },\n  {\n    id: 'ot_006',\n    category: 'image',\n    visualId: 'noah_ark',\n    q: 'Look at the picture. Whom did God (Đức Chúa Trời) command to build this giant wooden ark?',\n    opts: ['Abraham (Áp-ra-ham)', 'Noah (Nô-ê)', 'Moses (Môi-se)', 'Solomon (Sa-lô-môn)'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '6:14',\n    verseEn: 'So make yourself an ark of cypress wood; make rooms in it and coat it with pitch inside and out.',\n    verseVi: 'Ngươi hãy đóng một chiếc tàu bằng cây gô-phe, đóng có từng phòng, rồi trét chai bề trong lẫn bề ngoài.',\n  },\n  {\n    id: 'ot_007',\n    category: 'fact',\n    q: 'How many days and nights did it rain during the great flood in the days of Noah (Nô-ê)?',\n    opts: ['7 days and 7 nights', '12 days and 12 nights', '40 days and 40 nights', '100 days and 100 nights'],\n    ans: 2,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '7:12',\n    verseEn: 'And rain fell on the earth forty days and forty nights.',\n    verseVi: 'Mưa xuống trên mặt đất bốn mươi ngày và bốn mươi đêm.',\n  },\n  {\n    id: 'ot_008',\n    category: 'image',\n    visualId: 'dove_olive',\n    q: 'Look at the bird in the picture. What leaf did the dove bring back to Noah (Nô-ê) in its beak?',\n    opts: ['A fig leaf', 'A freshly plucked olive leaf', 'A palm branch', 'A cedar needle'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '8:11',\n    verseEn: 'When the dove returned to him in the evening, there in its beak was a freshly plucked olive leaf!',\n    verseVi: 'Đến chiều, chim bồ câu bay về cùng người; kìa, trong mỏ nó tha một lá ô-li-ve tươi.',\n  },\n  {\n    id: 'ot_009',\n    category: 'image',\n    visualId: 'rainbow_covenant',\n    q: 'Look at the sky in the picture. What sign did God (Đức Chúa Trời) put in the clouds as a covenant promise after the flood?',\n    opts: ['A bright comet', 'A rainbow', 'A golden cloud', 'A new moon'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '9:13',\n    verseEn: 'I have set my rainbow in the clouds, and it will be the sign of the covenant between me and the earth.',\n    verseVi: 'Ta đặt cái mống của ta trên từng mây, dùng làm dấu chỉ sự giao ước của ta với đất.',\n  },\n  {\n    id: 'ot_010',\n    category: 'fact',\n    q: 'Why did God (Đức Chúa Trời) confuse the language of the people building the Tower of Babel (Ba-bên)?',\n    opts: ['They wanted to reach heaven and make a name for themselves', 'They ran out of bricks', 'The river flooded the city', 'It was too cold to work'],\n    ans: 0,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '11:4, 7',\n    verseEn: 'Come, let us build ourselves a city, with a tower that reaches to the heavens, so that we may make a name for ourselves.',\n    verseVi: 'Nào! chúng ta hãy xây một cái thành và dựng lên một cái tháp, chót cao đến tận trời, để làm cho rạng danh chúng ta.',\n  },\n  {\n    id: 'ot_011',\n    category: 'fact',\n    q: 'What did God (Đức Chúa Trời) tell Abraham (Áp-ra-ham) to count when promising how many descendants he would have?',\n    opts: ['Leaves in the forest', 'Drops in the sea', 'Stars in the sky', 'Birds in the air'],\n    ans: 2,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '15:5',\n    verseEn: 'Look up at the sky and count the stars—if indeed you can count them... So shall your offspring be.',\n    verseVi: 'Hãy ngó lên trời, và nếu ngươi đếm được các ngôi sao thì hãy đếm đi... Dòng dõi ngươi cũng sẽ như vậy.',\n  },\n  {\n    id: 'ot_012',\n    category: 'fact',\n    q: 'Who was the promised son born to Abraham (Áp-ra-ham) and Sarah (Sa-ra) in their old age?',\n    opts: ['Isaac (Y-sác)', 'Jacob (Gia-cốp)', 'Joseph (Giô-sép)', 'Moses (Môi-se)'],\n    ans: 0,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '21:3',\n    verseEn: 'Abraham gave the name Isaac to the son Sarah bore him.',\n    verseVi: 'Áp-ra-ham đặt tên đứa con trai mà Sa-ra mới sanh cho mình là Y-sác.',\n  },\n  {\n    id: 'ot_013',\n    category: 'fact',\n    q: 'What animal did God (Đức Chúa Trời) provide in a thicket as a sacrifice instead of Isaac (Y-sác)?',\n    opts: ['A white dove', 'A young bull', 'A ram caught by its horns', 'A wild goat'],\n    ans: 2,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '22:13',\n    verseEn: 'There in a thicket he saw a ram caught by its horns.',\n    verseVi: 'Kìa, sau lưng có một con chiên đực sừng mắc trong bụi cây.',\n  },\n  {\n    id: 'ot_014',\n    category: 'fact',\n    q: 'What kind of stew did Esau (Ê-sau) trade his birthright to Jacob (Gia-cốp) for?',\n    opts: ['Barley porridge', 'Red lentil stew', 'Fish soup', 'Honey cakes'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '25:30, 34',\n    verseEn: 'Then Jacob gave Esau some bread and some lentil stew.',\n    verseVi: 'Gia-cốp bèn trao bánh và canh đậu phạn cho Ê-sau.',\n  },\n  {\n    id: 'ot_015',\n    category: 'fact',\n    q: 'In his dream at Bethel (Bê-tên), what did Jacob (Gia-cốp) see angels of God (Đức Chúa Trời) ascending and descending on?',\n    opts: ['A golden bridge', 'A stairway resting on earth and reaching heaven', 'A giant oak tree', 'A fiery chariot'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '28:12',\n    verseEn: 'He had a dream in which he saw a stairway resting on the earth, with its top reaching to heaven.',\n    verseVi: 'Người chiêm bao thấy một cái thang bắc từ dưới đất, đầu đến tận trời, các thiên sứ của Đức Chúa Trời đi lên xuống trên thang đó.',\n  },\n  {\n    id: 'ot_016',\n    category: 'fact',\n    q: 'What new name did God (Đức Chúa Trời) give to Jacob (Gia-cốp)?',\n    opts: ['Israel (Y-sơ-ra-ên)', 'Judah (Giu-đa)', 'Canaan (Ca-na-an)', 'David (Đa-vít)'],\n    ans: 0,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '32:28',\n    verseEn: 'Your name will no longer be Jacob, but Israel, because you have struggled with God and with humans and have overcome.',\n    verseVi: 'Tên ngươi sẽ chẳng là Gia-cốp nữa, nhưng tên là Y-sơ-ra-ên, vì ngươi đã có vật lộn cùng Đức Chúa Trời và người ta, và ngươi đều được thắng.',\n  },\n  {\n    id: 'ot_017',\n    category: 'image',\n    visualId: 'coat_colors',\n    q: 'Look at this colorful robe. Which son of Jacob (Gia-cốp) received an ornate colorful coat from his father?',\n    opts: ['Reuben (Ru-bên)', 'Joseph (Giô-sép)', 'Benjamin (Bên-gia-min)', 'Levi (Lê-vi)'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '37:3',\n    verseEn: 'Now Israel loved Joseph more than any of his other sons... and he made an ornate robe for him.',\n    verseVi: 'Vả, Y-sơ-ra-ên thương yêu Giô-sép hơn hết các con trai mình... nên may cho chàng một cái áo tràng nhiều sắc.',\n  },\n  {\n    id: 'ot_018',\n    category: 'fact',\n    q: 'What special ability did God (Đức Chúa Trời) give Joseph (Giô-sép) in Egypt (Ê-díp-tô), helping him become second-in-command?',\n    opts: ['Building pyramids', 'Interpreting dreams', 'Sailing warships', 'Playing the trumpet'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '41:15-16',\n    verseEn: 'Joseph replied to Pharaoh, \"I cannot do it, but God will give Pharaoh the answer he desires.\"',\n    verseVi: 'Giô-sép tâu lại rằng: Điều đó chẳng phải tại tôi, nhưng Đức Chúa Trời sẽ ban cho Pha-ra-ôn một lời đáp bình an.',\n  },\n  {\n    id: 'ot_019',\n    category: 'fact',\n    q: 'How many years of plenty followed by famine did Joseph (Giô-sép) predict from Pharaoh (Pha-ra-ôn)\\'s dreams?',\n    opts: ['3 years each', '7 years each', '10 years each', '12 years each'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '41:29-30',\n    verseEn: 'Seven years of great abundance are coming throughout the land of Egypt, but seven years of famine will follow them.',\n    verseVi: 'Trong khắp xứ Ê-díp-tô sẽ có bảy năm được mùa lớn lắm. Sau đó, kế tiếp bảy năm đói kém.',\n  },\n  {\n    id: 'ot_020',\n    category: 'verse',\n    q: 'What did Joseph (Giô-sép) tell his brothers when he forgave them for selling him into Egypt (Ê-díp-tô)?',\n    opts: ['You will pay me gold', 'God (Đức Chúa Trời) intended it for good', 'Never return to this palace', 'I do not know you'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '50:20',\n    verseEn: 'You intended to harm me, but God intended it for good to accomplish what is now being done, the saving of many lives.',\n    verseVi: 'Các anh toan hại tôi, nhưng Đức Chúa Trời lại toan làm điều ích cho tôi, hầu cho cứu sự sống cho nhiều người như ngày nay.',\n  },\n  {\n    id: 'ot_021',\n    category: 'fact',\n    q: 'Where did baby Moses (Môi-se)\\'s mother hide him in a papyrus basket to keep him safe?',\n    opts: ['In a desert cave', 'Among the reeds along the bank of the Nile (sông Ni-lơ)', 'Under a palm tree', 'Inside the temple'],\n    ans: 1,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '2:3',\n    verseEn: 'She got a papyrus basket for him... and placed it among the reeds along the bank of the Nile.',\n    verseVi: 'Người bèn lấy một cái rương bằng sậy... để con nhỏ vào, rồi đem đặt trong đám sậy ở mé sông.',\n  },\n  {\n    id: 'ot_022',\n    category: 'image',\n    visualId: 'burning_bush',\n    q: 'Look at the picture. From inside what strange sight did God (Đức Chúa Trời) speak to Moses (Môi-se) at Mount Horeb (Hô-rếp)?',\n    opts: ['A burning bush that did not burn up', 'A silver waterfall', 'A cracked rock', 'A flying scroll'],\n    ans: 0,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '3:2',\n    verseEn: 'Moses saw that though the bush was on fire it did not burn up.',\n    verseVi: 'Môi-se nhìn xem, thấy bụi gai cháy lửa, nhưng chẳng hề tàn.',\n  },\n  {\n    id: 'ot_023',\n    category: 'fact',\n    q: 'What did Moses (Môi-se)\\'s brother Aaron (A-rôn) do to help him speak before Pharaoh (Pha-ra-ôn)?',\n    opts: ['He spoke for Moses (Môi-se)', 'He cooked meals', 'He rode a chariot', 'He guarded the door'],\n    ans: 0,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '4:14-16',\n    verseEn: 'He will speak to the people for you, and it will be as if he were your mouth.',\n    verseVi: 'Người sẽ thay ngươi nói cùng dân sự; ấy vậy người sẽ làm miệng cho ngươi.',\n  },\n  {\n    id: 'ot_024',\n    category: 'fact',\n    q: 'How many plagues did God (Đức Chúa Trời) send upon Egypt (Ê-díp-tô) before Pharaoh (Pha-ra-ôn) let Israel (Y-sơ-ra-ên) go?',\n    opts: ['5', '7', '10', '12'],\n    ans: 2,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '11:1',\n    verseEn: 'Now the LORD had said to Moses, \"I will bring one more plague on Pharaoh and on Egypt. After that, he will let you go.\"',\n    verseVi: 'Đức Giê-hô-va phán cùng Môi-se rằng: Ta sẽ giáng thêm một tai vạ nữa trên Pha-ra-ôn và trên xứ Ê-díp-tô; rồi sau đó người sẽ tha các ngươi đi.',\n  },\n  {\n    id: 'ot_025',\n    category: 'fact',\n    q: 'What special feast remembers the night the angel of death passed over the Israelites (dân Y-sơ-ra-ên)\\' houses in Egypt (Ê-díp-tô)?',\n    opts: ['Passover (Lễ Vượt Qua)', 'Pentecost (Lễ Ngũ Tuần)', 'Purim (Lễ Pu-rim)', 'Tabernacles (Lễ Lều Tạm)'],\n    ans: 0,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '12:27',\n    verseEn: 'It is the Passover sacrifice to the LORD, who passed over the houses of the Israelites in Egypt.',\n    verseVi: 'Ấy là lễ tế Vượt Qua cho Đức Giê-hô-va, là Đấng đã vượt qua nhà dân Y-sơ-ra-ên tại xứ Ê-díp-tô.',\n  },\n  {\n    id: 'ot_026',\n    category: 'fact',\n    q: 'How did the LORD (Đức Giê-hô-va) guide the Israelites (dân Y-sơ-ra-ên) by day and by night in the wilderness?',\n    opts: ['A trumpet and a bell', 'A pillar of cloud by day and a pillar of fire by night', 'Eagles and doves', 'Maps and torches'],\n    ans: 1,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '13:21',\n    verseEn: 'By day the LORD went ahead of them in a pillar of cloud to guide them on their way and by night in a pillar of fire.',\n    verseVi: 'Ban ngày Đức Giê-hô-va đi trước họ, ở trong một trụ mây để dẫn đường, và ban đêm ở trong một trụ lửa để soi sáng.',\n  },\n  {\n    id: 'ot_027',\n    category: 'image',\n    visualId: 'red_sea',\n    q: 'Look at the sea parting in the picture. Which sea did God (Đức Chúa Trời) divide so Moses (Môi-se) and the people could walk across on dry ground?',\n    opts: ['Sea of Galilee (Biển Ga-li-lê)', 'Red Sea (Biển Đỏ)', 'Dead Sea (Biển Chết)', 'Mediterranean Sea (Địa Trung Hải)'],\n    ans: 1,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '14:21-22',\n    verseEn: 'All that night the LORD drove the sea back with a strong east wind and turned it into dry land.',\n    verseVi: 'Đức Giê-hô-va dẫn cơn gió đông thổi mạnh suốt đêm làm cho biển rút xuống, bày ra đất khô, và nước phân rẽ ra.',\n  },\n  {\n    id: 'ot_028',\n    category: 'fact',\n    q: 'What white, honey-tasting bread from heaven did God (Đức Chúa Trời) provide every morning in the desert?',\n    opts: ['Manna (Ma-na)', 'Leavened loaves', 'Figs and dates', 'Barley cakes'],\n    ans: 0,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '16:31',\n    verseEn: 'The people of Israel called the bread manna. It was white like coriander seed and tasted like wafers made with honey.',\n    verseVi: 'Nhà Y-sơ-ra-ên đặt tên vật đó là ma-na; nó giống như hột ngò sắc trắng, mùi vị như bánh tráng pha mật.',\n  },\n  {\n    id: 'ot_029',\n    category: 'image',\n    visualId: 'stone_tablets',\n    q: 'Look at the two stone tablets. On what mountain did God (Đức Chúa Trời) give Moses (Môi-se) the Ten Commandments?',\n    opts: ['Mount Carmel (Núi Cạt-mên)', 'Mount Sinai (Núi Si-na-i)', 'Mount Olive (Núi Ô-li-ve)', 'Mount Ararat (Núi A-ra-rát)'],\n    ans: 1,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '19:20; 20:1-17',\n    verseEn: 'The LORD descended to the top of Mount Sinai and called Moses to the top of the mountain.',\n    verseVi: 'Đức Giê-hô-va ngự xuống trên chót núi Si-na-i và gọi Môi-se lên chót núi.',\n  },\n  {\n    id: 'ot_030',\n    category: 'verse',\n    q: 'Complete the fifth commandment: \"___ your father and your mother, so that you may live long in the land.\"',\n    opts: ['Ignore', 'Honor', 'Question', 'Leave'],\n    ans: 1,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '20:12',\n    verseEn: 'Honor your father and your mother, so that you may live long in the land the LORD your God is giving you.',\n    verseVi: 'Hãy hiếu kính cha mẹ ngươi, hầu cho ngươi được sống lâu trên đất mà Giê-hô-va Đức Chúa Trời ngươi ban cho.',\n  },\n  {\n    id: 'ot_031',\n    category: 'fact',\n    q: 'Out of the 12 spies Moses (Môi-se) sent into Canaan (Ca-na-an), which two gave a faithful report trusting God (Đức Chúa Trời)?',\n    opts: ['Joshua (Giô-suê) and Caleb (Ca-lép)', 'Aaron (A-rôn) and Hur (Hu-rơ)', 'David (Đa-vít) and Jonathan (Giô-na-than)', 'Gideon (Ghê-đê-ôn) and Samson (Sam-sôn)'],\n    ans: 0,\n    bookEn: 'Numbers',\n    bookVi: 'Dân-số Ký',\n    ref: '14:6-8',\n    verseEn: 'Joshua son of Nun and Caleb son of Jephunneh... said, \"If the LORD is pleased with us, he will lead us into that land.\"',\n    verseVi: 'Giô-suê, con trai của Nun, và Ca-lép, con trai của Giê-phu-nê... nói rằng: Nếu Đức Giê-hô-va đẹp lòng chúng ta, thì Ngài sẽ dẫn chúng ta vào xứ đó.',\n  },\n  {\n    id: 'ot_032',\n    category: 'verse',\n    q: 'Complete the blessing given to Aaron (A-rôn): \"The LORD (Đức Giê-hô-va) bless you and ___ you.\"',\n    opts: ['keep', 'forget', 'hide', 'judge'],\n    ans: 0,\n    bookEn: 'Numbers',\n    bookVi: 'Dân-số Ký',\n    ref: '6:24',\n    verseEn: 'The LORD bless you and keep you; the LORD make his face shine on you and be gracious to you.',\n    verseVi: 'Cầu xin Đức Giê-hô-va ban phước cho ngươi và giữ gìn ngươi! Cầu xin Đức Giê-hô-va chiếu sáng mặt Ngài trên ngươi và làm ơn cho ngươi!',\n  },\n  {\n    id: 'ot_033',\n    category: 'verse',\n    q: 'According to Deuteronomy (Phục-truyền Luật-lệ Ký) 6:5, how should we love the LORD (Đức Giê-hô-va) our God (Đức Chúa Trời)?',\n    opts: ['Only on Sundays', 'With all our heart, all our soul, and all our strength', 'When we need food', 'In secret only'],\n    ans: 1,\n    bookEn: 'Deuteronomy',\n    bookVi: 'Phục-truyền Luật-lệ Ký',\n    ref: '6:5',\n    verseEn: 'Love the LORD your God with all your heart and with all your soul and with all your strength.',\n    verseVi: 'Ngươi phải hết lòng, hết ý, hết sức kính mến Giê-hô-va Đức Chúa Trời ngươi.',\n  },\n  {\n    id: 'ot_034',\n    category: 'verse',\n    q: 'What did God (Đức Chúa Trời) tell Joshua (Giô-suê) three times before leading Israel (Y-sơ-ra-ên) into the promised land?',\n    opts: ['Build big walls', 'Be strong and courageous', 'Run away quickly', 'Stay inside your tent'],\n    ans: 1,\n    bookEn: 'Joshua',\n    bookVi: 'Giô-suê',\n    ref: '1:9',\n    verseEn: 'Have I not commanded you? Be strong and courageous. Do not be afraid; do not be discouraged.',\n    verseVi: 'Ta há chẳng có phán dặn ngươi sao? Hãy vững lòng bền chí, chớ run sợ, chớ kinh khủng.',\n  },\n  {\n    id: 'ot_035',\n    category: 'fact',\n    q: 'Who hid the two Israelite (Y-sơ-ra-ên) spies in Jericho (Giê-ri-cô) and hung a scarlet cord in her window?',\n    opts: ['Ruth (Ru-tơ)', 'Rahab (Ra-háp)', 'Esther (Ê-xơ-tê)', 'Deborah (Đê-bô-ra)'],\n    ans: 1,\n    bookEn: 'Joshua',\n    bookVi: 'Giô-suê',\n    ref: '2:1, 21',\n    verseEn: 'So they went and entered the house of a woman named Rahab... And she tied the scarlet cord in the window.',\n    verseVi: 'Hai người bèn đi, vào nhà một người kỵ nữ tên là Ra-háp... Rồi nàng cột sợi dây đỏ điều vào cửa sổ.',\n  },\n  {\n    id: 'ot_036',\n    category: 'image',\n    visualId: 'jericho_trumpets',\n    q: 'Look at the picture. Which city\\'s walls fell flat after Israel (Y-sơ-ra-ên) marched around it for seven days and blew trumpets?',\n    opts: ['Babylon (Ba-by-lôn)', 'Jericho (Giê-ri-cô)', 'Nineveh (Ni-ni-ve)', 'Bethel (Bê-tên)'],\n    ans: 1,\n    bookEn: 'Joshua',\n    bookVi: 'Giô-suê',\n    ref: '6:20',\n    verseEn: 'When the trumpets sounded, the army shouted, and at the sound of the trumpet, when the men gave a loud shout, the wall collapsed.',\n    verseVi: 'Khi các thầy tế lễ thổi kèn, dân sự bèn la lớn lên... thì vách thành đổ sụp xuống.',\n  },\n  {\n    id: 'ot_037',\n    category: 'verse',\n    q: 'Finish Joshua (Giô-suê)\\'s famous declaration: \"But as for me and my household, we will ___ the LORD (Đức Giê-hô-va).\"',\n    opts: ['serve', 'forget', 'hide from', 'question'],\n    ans: 0,\n    bookEn: 'Joshua',\n    bookVi: 'Giô-suê',\n    ref: '24:15',\n    verseEn: 'But as for me and my household, we will serve the LORD.',\n    verseVi: 'Nhưng ta và nhà ta sẽ phục sự Đức Giê-hô-va.',\n  },\n  {\n    id: 'ot_038',\n    category: 'fact',\n    q: 'Who was the only female prophetess and judge who led Israel (Y-sơ-ra-ên) from under a palm tree?',\n    opts: ['Miriam (Mi-ri-am)', 'Deborah (Đê-bô-ra)', 'Hannah (An-ne)', 'Naomi (Na-ô-mi)'],\n    ans: 1,\n    bookEn: 'Judges',\n    bookVi: 'Các Quan Xét',\n    ref: '4:4-5',\n    verseEn: 'Now Deborah, a prophet, the wife of Lappidoth, was leading Israel at that time.',\n    verseVi: 'Lúc bấy giờ, Đê-bô-ra, nữ tiên tri, vợ của La-bi-đốt, làm quan xét cho dân Y-sơ-ra-ên.',\n  },\n  {\n    id: 'ot_039',\n    category: 'fact',\n    q: 'How many soldiers did God (Đức Chúa Trời) leave with Gideon (Ghê-đê-ôn) to defeat the huge Midianite (Ma-đi-an) army?',\n    opts: ['300 men', '3,000 men', '10,000 men', '32,000 men'],\n    ans: 0,\n    bookEn: 'Judges',\n    bookVi: 'Các Quan Xét',\n    ref: '7:7',\n    verseEn: 'The LORD said to Gideon, \"With the three hundred men that lapped I will save you and give the Midianites into your hands.\"',\n    verseVi: 'Đức Giê-hô-va phán cùng Ghê-đê-ôn rằng: Ta sẽ dùng ba trăm người đã tợp nước đó giải cứu các ngươi và phó dân Ma-đi-an vào tay ngươi.',\n  },\n  {\n    id: 'ot_040',\n    category: 'fact',\n    q: 'What secret was linked to Samson (Sam-sôn)\\'s extraordinary God-given physical strength?',\n    opts: ['His iron helmet', 'His hair had never been cut under his Nazirite vow', 'A golden belt', 'A magic ring'],\n    ans: 1,\n    bookEn: 'Judges',\n    bookVi: 'Các Quan Xét',\n    ref: '16:17',\n    verseEn: 'No razor has ever been used on my head, because I have been a Nazirite dedicated to God from my mother\\'s womb.',\n    verseVi: 'Dao cạo chẳng hề đưa qua đầu ta; vì từ trong lòng mẹ, ta đã làm người Na-xi-rê biệt riêng ra cho Đức Chúa Trời.',\n  },\n  {\n    id: 'ot_041',\n    category: 'fact',\n    q: 'Who stayed faithfully with her mother-in-law Naomi (Na-ô-mi), saying \"Where you go I will go\"?',\n    opts: ['Ruth (Ru-tơ)', 'Esther (Ê-xơ-tê)', 'Sarah (Sa-ra)', 'Rebekah (Rê-bê-ca)'],\n    ans: 0,\n    bookEn: 'Ruth',\n    bookVi: 'Ru-tơ',\n    ref: '1:16',\n    verseEn: 'Where you go I will go, and where you stay I will stay. Your people will be my people and your God my God.',\n    verseVi: 'Mẹ đi đâu, tôi sẽ đi đó; mẹ ở nơi nào, tôi sẽ ở nơi đó. Dân sự của mẹ tức là dân sự của tôi; Đức Chúa Trời của mẹ tức là Đức Chúa Trời của tôi.',\n  },\n  {\n    id: 'ot_042',\n    category: 'fact',\n    q: 'Whose fields did Ruth (Ru-tơ) glean leftover grain in before he kindly married her?',\n    opts: ['Saul (Sau-lơ)', 'Boaz (Bô-ô)', 'Eli (Hê-li)', 'Laban (La-ban)'],\n    ans: 1,\n    bookEn: 'Ruth',\n    bookVi: 'Ru-tơ',\n    ref: '2:8; 4:13',\n    verseEn: 'So Boaz took Ruth and she became his wife.',\n    verseVi: 'Vậy, Bô-ô cưới Ru-tơ làm vợ mình.',\n  },\n  {\n    id: 'ot_043',\n    category: 'fact',\n    q: 'When young Samuel (Sa-mu-ên) heard God (Đức Chúa Trời) calling his name at night, what did Eli (Hê-li) teach him to answer?',\n    opts: ['Wait until morning', 'Speak, LORD (Đức Giê-hô-va), for your servant is listening', 'I am sleeping now', 'Go away please'],\n    ans: 1,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '3:9-10',\n    verseEn: 'Then Samuel said, \"Speak, for your servant is listening.\"',\n    verseVi: 'Sa-mu-ên thưa rằng: Xin hãy phán, kẻ tôi tớ Ngài đương nghe.',\n  },\n  {\n    id: 'ot_044',\n    category: 'fact',\n    q: 'Who was the very first king of Israel (Y-sơ-ra-ên)?',\n    opts: ['David (Đa-vít)', 'Saul (Sau-lơ)', 'Solomon (Sa-lô-môn)', 'Samuel (Sa-mu-ên)'],\n    ans: 1,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '10:1, 24',\n    verseEn: 'Samuel said to all the people, \"Do you see the man the LORD has chosen? There is no one like him among all the people.\"',\n    verseVi: 'Sa-mu-ên nói với cả dân sự rằng: Các ngươi có thấy người mà Đức Giê-hô-va đã chọn chăng? Trong cả dân sự chẳng có ai bằng người.',\n  },\n  {\n    id: 'ot_045',\n    category: 'verse',\n    q: 'When Samuel (Sa-mu-ên) went to anoint David (Đa-vít), what did the LORD (Đức Giê-hô-va) say He looks at instead of outward appearance?',\n    opts: ['Height and armor', 'The heart', 'Wealth and gold', 'Fine clothes'],\n    ans: 1,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '16:7',\n    verseEn: 'People look at the outward appearance, but the LORD looks at the heart.',\n    verseVi: 'Loài người xem bề ngoài, nhưng Đức Giê-hô-va nhìn thấy trong lòng.',\n  },\n  {\n    id: 'ot_046',\n    category: 'image',\n    visualId: 'sling_stones',\n    q: 'Look at the sling and 5 smooth stones. Who used these to defeat the giant Goliath (Gô-li-át)?',\n    opts: ['Jonathan (Giô-na-than)', 'David (Đa-vít)', 'Samson (Sam-sôn)', 'Joshua (Giô-suê)'],\n    ans: 1,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '17:40, 49',\n    verseEn: 'He chose five smooth stones from the stream... and with a sling and a stone, David triumphed over the Philistine.',\n    verseVi: 'Người lựa năm hòn đá trơn dưới suối... Vậy, Đa-vít dùng trành và một hòn đá thắng hơn người Phi-li-tin.',\n  },\n  {\n    id: 'ot_047',\n    category: 'fact',\n    q: 'What musical instrument did David (Đa-vít) play to soothe King Saul (Sau-lơ)?',\n    opts: ['A silver flute', 'A lyre / harp', 'A war drum', 'A bronze horn'],\n    ans: 1,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '16:23',\n    verseEn: 'David would take up his lyre and play. Then relief would come to Saul; he would feel better.',\n    verseVi: 'Đa-vít bèn lấy đàn cầm mà gảy; Sau-lơ liền được khuây khỏa, bớt bệnh.',\n  },\n  {\n    id: 'ot_048',\n    category: 'fact',\n    q: 'Who was King Saul (Sau-lơ)\\'s son and David (Đa-vít)\\'s loyal best friend?',\n    opts: ['Absalom (Áp-sa-lôm)', 'Jonathan (Giô-na-than)', 'Nathan (Na-than)', 'Joab (Giô-áp)'],\n    ans: 1,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '18:1, 3',\n    verseEn: 'Jonathan became one in spirit with David, and he loved him as himself.',\n    verseVi: 'Lòng Giô-na-than quyến luyến với lòng Đa-vít, và Giô-na-than yêu người như mạng sống mình.',\n  },\n  {\n    id: 'ot_049',\n    category: 'fact',\n    q: 'Which city did King David (Đa-vít) make the capital of Israel (Y-sơ-ra-ên), often called the City of David?',\n    opts: ['Jericho (Giê-ri-cô)', 'Jerusalem (Giê-ru-sa-lem)', 'Damascus (Đa-mách)', 'Nazareth (Na-xa-rét)'],\n    ans: 1,\n    bookEn: '2 Samuel',\n    bookVi: 'II Sa-mu-ên',\n    ref: '5:7',\n    verseEn: 'Nevertheless, David captured the fortress of Zion—which is the City of David.',\n    verseVi: 'Song Đa-vít chiếm lấy đồn Si-ôn, tức là thành Đa-vít.',\n  },\n  {\n    id: 'ot_050',\n    category: 'fact',\n    q: 'What did young King Solomon (Sa-lô-môn) ask God (Đức Chúa Trời) for instead of riches or long life?',\n    opts: ['A huge palace', 'A discerning heart / wisdom to govern', 'Fast horses', 'Rainbows'],\n    ans: 1,\n    bookEn: '1 Kings',\n    bookVi: 'I Các Vua',\n    ref: '3:9',\n    verseEn: 'So give your servant a discerning heart to govern your people and to distinguish between right and wrong.',\n    verseVi: 'Vậy xin Chúa ban cho kẻ tôi tớ Chúa một tấm lòng khôn sáng, để xét đoán dân sự Chúa, và phân biệt điều lành điều dữ.',\n  },\n  {\n    id: 'ot_051',\n    category: 'fact',\n    q: 'What magnificent house of worship did King Solomon (Sa-lô-môn) build in Jerusalem (Giê-ru-sa-lem)?',\n    opts: ['The Temple (Đền Thờ)', 'The Tower of Babel (Tháp Ba-bên)', 'Noah (Nô-ê)\\'s Ark', 'The Red Palace'],\n    ans: 0,\n    bookEn: '1 Kings',\n    bookVi: 'I Các Vua',\n    ref: '6:1',\n    verseEn: 'In the fourth year of Solomon\\'s reign over Israel... he began to build the temple of the LORD.',\n    verseVi: 'Vào năm thứ tư đời Sa-lô-môn cai trị Y-sơ-ra-ên... vua khởi công xây cất đền thờ Đức Giê-hô-va.',\n  },\n  {\n    id: 'ot_052',\n    category: 'fact',\n    q: 'Which famous queen traveled from afar to test King Solomon (Sa-lô-môn) with hard questions?',\n    opts: ['Queen of Sheba (Nữ hoàng Sê-ba)', 'Queen Esther (Hoàng hậu Ê-xơ-tê)', 'Queen Vashti (Hoàng hậu Vả-thi)', 'Miriam (Mi-ri-am)'],\n    ans: 0,\n    bookEn: '1 Kings',\n    bookVi: 'I Các Vua',\n    ref: '10:1',\n    verseEn: 'When the queen of Sheba heard about the fame of Solomon and his relationship to the LORD, she came to test Solomon with hard questions.',\n    verseVi: 'Nữ hoàng Sê-ba nghe danh tiếng của Sa-lô-môn về danh Đức Giê-hô-va, thì đến đặng thử người bằng những câu đố khó.',\n  },\n  {\n    id: 'ot_053',\n    category: 'fact',\n    q: 'During a drought, what birds did God (Đức Chúa Trời) command to bring bread and meat to the prophet Elijah (Ê-li)?',\n    opts: ['Eagles', 'Ravens', 'Sparrows', 'Storks'],\n    ans: 1,\n    bookEn: '1 Kings',\n    bookVi: 'I Các Vua',\n    ref: '17:6',\n    verseEn: 'The ravens brought him bread and meat in the morning and bread and meat in the evening.',\n    verseVi: 'Mỗi buổi mai và mỗi buổi chiều, chim quạ tha bánh và thịt đến cho người.',\n  },\n  {\n    id: 'ot_054',\n    category: 'fact',\n    q: 'On Mount Carmel (Núi Cạt-mên), how did the LORD (Đức Giê-hô-va) answer Elijah (Ê-li)\\'s prayer?',\n    opts: ['Sent heavy snow', 'Sent fire from heaven that burned up the sacrifice', 'Parted a river', 'Sent a swarm of bees'],\n    ans: 1,\n    bookEn: '1 Kings',\n    bookVi: 'I Các Vua',\n    ref: '18:38',\n    verseEn: 'Then the fire of the LORD fell and burned up the sacrifice, the wood, the stones and the soil.',\n    verseVi: 'Bấy giờ lửa của Đức Giê-hô-va giáng xuống, thiêu hủy của lễ, củi, đá, và bụi đất.',\n  },\n  {\n    id: 'ot_055',\n    category: 'fact',\n    q: 'How was the prophet Elijah (Ê-li) taken up to heaven at the end of his earthly ministry?',\n    opts: ['By a wooden boat', 'In a whirlwind with a chariot of fire and horses of fire', 'Walking up stairs', 'Carried by ravens'],\n    ans: 1,\n    bookEn: '2 Kings',\n    bookVi: 'II Các Vua',\n    ref: '2:11',\n    verseEn: 'Suddenly a chariot of fire and horses of fire appeared and separated the two of them, and Elijah went up to heaven in a whirlwind.',\n    verseVi: 'Thình lình có một cái xe lửa và ngựa lửa phân rẽ hai người ra; và Ê-li lên trời trong một cơn gió lốc.',\n  },\n  {\n    id: 'ot_056',\n    category: 'fact',\n    q: 'What did the prophet Elisha (Ê-li-sê) tell the Syrian commander Naaman (Na-a-man) to do to be healed of leprosy?',\n    opts: ['Climb a mountain three times', 'Wash in the Jordan (Giô-đanh) River seven times', 'Fast for forty days', 'Give away his chariot'],\n    ans: 1,\n    bookEn: '2 Kings',\n    bookVi: 'II Các Vua',\n    ref: '5:10, 14',\n    verseEn: 'Go, wash yourself seven times in the Jordan, and your flesh will be restored and you will be cleansed.',\n    verseVi: 'Hãy đi tắm bảy lần dưới sông Giô-đanh, thì thịt ngươi sẽ lành lại, và ngươi sẽ được sạch.',\n  },\n  {\n    id: 'ot_057',\n    category: 'fact',\n    q: 'What brave Israelite (Y-sơ-ra-ên) woman became queen and risked her life to save her people from Haman (Ha-man)\\'s plot?',\n    opts: ['Esther (Ê-xơ-tê)', 'Ruth (Ru-tơ)', 'Deborah (Đê-bô-ra)', 'Martha (Ma-thê)'],\n    ans: 0,\n    bookEn: 'Esther',\n    bookVi: 'Ê-xơ-tê',\n    ref: '4:14, 16',\n    verseEn: 'And who knows but that you have come to your royal position for such a time as this?',\n    verseVi: 'Biết đâu chẳng phải vì cơ hội hiện nay mà ngươi được lên ngôi hoàng hậu sao?',\n  },\n  {\n    id: 'ot_058',\n    category: 'fact',\n    q: 'Who led the rebuilding of the broken city walls of Jerusalem (Giê-ru-sa-lem) in just 52 days?',\n    opts: ['Nehemiah (Nê-hê-mi)', 'Jonah (Giô-na)', 'Lot (Lót)', 'Samson (Sam-sôn)'],\n    ans: 0,\n    bookEn: 'Nehemiah',\n    bookVi: 'Nê-hê-mi',\n    ref: '6:15',\n    verseEn: 'So the wall was completed on the twenty-fifth of Elul, in fifty-two days.',\n    verseVi: 'Vậy, vách thành xây xong ngày hai mươi lăm tháng Ê-lun, trọn năm mươi hai ngày.',\n  },\n  {\n    id: 'ot_059',\n    category: 'fact',\n    q: 'Even after losing his wealth, children, and health, who refused to curse God (Đức Chúa Trời) and later had everything restored?',\n    opts: ['Job (Gióp)', 'Cain (Ca-in)', 'Ahab (A-háp)', 'Balaam (Ba-la-am)'],\n    ans: 0,\n    bookEn: 'Job',\n    bookVi: 'Gióp',\n    ref: '1:21; 42:10',\n    verseEn: 'The LORD gave and the LORD has taken away; may the name of the LORD be praised.',\n    verseVi: 'Đức Giê-hô-va đã ban cho, Đức Giê-hô-va lại cất đi; đáng ngợi khen danh Đức Giê-hô-va!',\n  },\n  {\n    id: 'ot_060',\n    category: 'image',\n    visualId: 'shepherd_staff',\n    q: 'Look at the shepherd\\'s staff and sheep. Complete Psalm (Thi-thiên) 23:1: \"The LORD (Đức Giê-hô-va) is my ___, I lack nothing.\"',\n    opts: ['carpenter', 'shepherd', 'captain', 'builder'],\n    ans: 1,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '23:1',\n    verseEn: 'The LORD is my shepherd, I lack nothing.',\n    verseVi: 'Đức Giê-hô-va là Đấng chăn giữ tôi: tôi sẽ chẳng thiếu thốn gì.',\n  },\n  {\n    id: 'ot_061',\n    category: 'verse',\n    q: 'In Psalm (Thi-thiên) 119:105, what is God (Đức Chúa Trời)\\'s word compared to?',\n    opts: ['A silver crown', 'A lamp for my feet and a light on my path', 'A strong wind', 'An iron sword'],\n    ans: 1,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '119:105',\n    verseEn: 'Your word is a lamp for my feet, a light on my path.',\n    verseVi: 'Lời Chúa là ngọn đèn cho chân tôi, ánh sáng cho đường lối tôi.',\n  },\n  {\n    id: 'ot_062',\n    category: 'verse',\n    q: 'Complete Psalm (Thi-thiên) 100:4: \"Enter his gates with ___ and his courts with praise.\"',\n    opts: ['thanksgiving', 'fear', 'silence', 'tears'],\n    ans: 0,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '100:4',\n    verseEn: 'Enter his gates with thanksgiving and his courts with praise; give thanks to him and praise his name.',\n    verseVi: 'Hãy cảm tạ mà vào các cửa Ngài, hãy ngợi khen mà vào hành lang Ngài. Hãy cảm tạ Ngài, chúc tụng danh của Ngài.',\n  },\n  {\n    id: 'ot_063',\n    category: 'verse',\n    q: 'Complete Psalm (Thi-thiên) 136:1: \"Give thanks to the LORD (Đức Giê-hô-va), for he is good. His ___ endures forever.\"',\n    opts: ['anger', 'love', 'winter', 'silence'],\n    ans: 1,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '136:1',\n    verseEn: 'Give thanks to the LORD, for he is good. His love endures forever.',\n    verseVi: 'Hãy cảm tạ Đức Giê-hô-va, vì Ngài là thiện; sự nhơn từ Ngài còn đến đời đời.',\n  },\n  {\n    id: 'ot_064',\n    category: 'verse',\n    q: 'Complete Psalm (Thi-thiên) 46:1: \"God (Đức Chúa Trời) is our ___ and strength, an ever-present help in trouble.\"',\n    opts: ['refuge', 'palace', 'mountain', 'garden'],\n    ans: 0,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '46:1',\n    verseEn: 'God is our refuge and strength, an ever-present help in trouble.',\n    verseVi: 'Đức Chúa Trời là nơi nương náu và sức lực của chúng tôi, Ngài sẵn giúp đỡ trong cơn gian truân.',\n  },\n  {\n    id: 'ot_065',\n    category: 'verse',\n    q: 'Who wrote most of the Psalms (Thi-thiên), including Psalm 23?',\n    opts: ['Moses (Môi-se)', 'David (Đa-vít)', 'Jonah (Giô-na)', 'Daniel (Đa-ni-ên)'],\n    ans: 1,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '23:1',\n    verseEn: 'A psalm of David. The LORD is my shepherd, I lack nothing.',\n    verseVi: 'Thơ của Đa-vít. Đức Giê-hô-va là Đấng chăn giữ tôi: tôi sẽ chẳng thiếu thốn gì.',\n  },\n  {\n    id: 'ot_066',\n    category: 'verse',\n    q: 'According to Proverbs (Châm-ngôn) 1:7, what is the beginning of knowledge?',\n    opts: ['Reading many stories', 'The fear of the LORD (Đức Giê-hô-va)', 'Collecting gold', 'Winning battles'],\n    ans: 1,\n    bookEn: 'Proverbs',\n    bookVi: 'Châm-ngôn',\n    ref: '1:7',\n    verseEn: 'The fear of the LORD is the beginning of knowledge, but fools despise wisdom and instruction.',\n    verseVi: 'Sự kính sợ Đức Giê-hô-va là khởi đầu sự tri thức; còn kẻ ngu muội khinh bỉ sự khôn ngoan và lời khuyên dạy.',\n  },\n  {\n    id: 'ot_067',\n    category: 'verse',\n    q: 'Complete Proverbs (Châm-ngôn) 3:5: \"Trust in the LORD (Đức Giê-hô-va) with all your ___ and lean not on your own understanding.\"',\n    opts: ['money', 'heart', 'sword', 'hands'],\n    ans: 1,\n    bookEn: 'Proverbs',\n    bookVi: 'Châm-ngôn',\n    ref: '3:5',\n    verseEn: 'Trust in the LORD with all your heart and lean not on your own understanding.',\n    verseVi: 'Hãy hết lòng tin cậy Đức Giê-hô-va, chớ nương cậy nơi sự thông sáng của con.',\n  },\n  {\n    id: 'ot_068',\n    category: 'verse',\n    q: 'According to Proverbs (Châm-ngôn) 15:1, what turns away wrath (anger)?',\n    opts: ['A loud shout', 'A gentle answer', 'Running fast', 'Closing the door'],\n    ans: 1,\n    bookEn: 'Proverbs',\n    bookVi: 'Châm-ngôn',\n    ref: '15:1',\n    verseEn: 'A gentle answer turns away wrath, but a harsh word stirs up anger.',\n    verseVi: 'Lời đáp êm nhẹ làm nguôi cơn giận; còn lời xẳng xớm trêu thạnh nộ thêm.',\n  },\n  {\n    id: 'ot_069',\n    category: 'verse',\n    q: 'According to Proverbs (Châm-ngôn) 22:1, what is more desirable than great riches?',\n    opts: ['A big crown', 'A good name', 'A tall tower', 'A fast chariot'],\n    ans: 1,\n    bookEn: 'Proverbs',\n    bookVi: 'Châm-ngôn',\n    ref: '22:1',\n    verseEn: 'A good name is more desirable than great riches; to be esteemed is better than silver or gold.',\n    verseVi: 'Danh tiếng lành còn hơn của cải nhiều, và ơn nghĩa quí hơn bạc cùng vàng.',\n  },\n  {\n    id: 'ot_070',\n    category: 'fact',\n    q: 'In Proverbs (Châm-ngôn) 6:6, which tiny insect are lazy people told to observe and learn wisdom from?',\n    opts: ['A butterfly', 'An ant', 'A cricket', 'A spider'],\n    ans: 1,\n    bookEn: 'Proverbs',\n    bookVi: 'Châm-ngôn',\n    ref: '6:6',\n    verseEn: 'Go to the ant, you sluggard; consider its ways and be wise!',\n    verseVi: 'Hỡi kẻ biếng nhác, hãy đi đến loài kiến; khá xem xét cách ăn ở nó mà học khôn ngoan.',\n  },\n  {\n    id: 'ot_071',\n    category: 'verse',\n    q: 'Complete Isaiah (Ê-sai) 40:31: \"Those who hope in the LORD (Đức Giê-hô-va) will renew their strength. They will soar on wings like ___.\"',\n    opts: ['doves', 'eagles', 'sparrows', 'swans'],\n    ans: 1,\n    bookEn: 'Isaiah',\n    bookVi: 'Ê-sai',\n    ref: '40:31',\n    verseEn: 'But those who hope in the LORD will renew their strength. They will soar on wings like eagles.',\n    verseVi: 'Nhưng ai trông đợi Đức Giê-hô-va thì chắc được sức mới, cất cánh bay cao như chim ưng.',\n  },\n  {\n    id: 'ot_072',\n    category: 'verse',\n    q: 'Complete the prophecy in Isaiah (Ê-sai) 9:6: \"For to us a child is born, to us a ___ is given.\"',\n    opts: ['king', 'son', 'crown', 'scroll'],\n    ans: 1,\n    bookEn: 'Isaiah',\n    bookVi: 'Ê-sai',\n    ref: '9:6',\n    verseEn: 'For to us a child is born, to us a son is given, and the government will be on his shoulders.',\n    verseVi: 'Vì có một con trẻ sanh cho chúng ta, tức là một con trai ban cho chúng ta; quyền cai trị sẽ nấy trên vai Ngài.',\n  },\n  {\n    id: 'ot_073',\n    category: 'fact',\n    q: 'In Isaiah (Ê-sai) 7:14, what name meaning \"God with us\" (Đức Chúa Trời ở cùng chúng ta) was prophesied for the child?',\n    opts: ['Emmanuel / Immanuel (Em-ma-nu-ên)', 'Samuel (Sa-mu-ên)', 'Daniel (Đa-ni-ên)', 'Israel (Y-sơ-ra-ên)'],\n    ans: 0,\n    bookEn: 'Isaiah',\n    bookVi: 'Ê-sai',\n    ref: '7:14',\n    verseEn: 'The virgin will conceive and give birth to a son, and will call him Immanuel.',\n    verseVi: 'Nầy, một gái đồng trinh sẽ chịu thai, sanh ra một trai, và đặt tên là Em-ma-nu-ên.',\n  },\n  {\n    id: 'ot_074',\n    category: 'verse',\n    q: 'What encouraging promise did God (Đức Chúa Trời) give through Jeremiah (Giê-rê-mi) 29:11?',\n    opts: ['I know the plans I have for you, plans to prosper you and give you hope and a future', 'You will build a tower to the moon', 'Winter will never come', 'All rivers will turn to milk'],\n    ans: 0,\n    bookEn: 'Jeremiah',\n    bookVi: 'Giê-rê-mi',\n    ref: '29:11',\n    verseEn: '\"For I know the plans I have for you,\" declares the LORD, \"plans to prosper you and not to harm you, plans to give you hope and a future.\"',\n    verseVi: 'Đức Giê-hô-va phán: Vì ta biết ý tưởng ta nghĩ đối cùng các ngươi, là ý tưởng bình an, không phải tai họa, để cho các ngươi được sự trông cậy trong lúc cuối cùng của mình.',\n  },\n  {\n    id: 'ot_075',\n    category: 'fact',\n    q: 'Why did Daniel (Đa-ni-ên) and his three friends ask to eat only vegetables and water in Babylon (Ba-by-lôn)?',\n    opts: ['They disliked sweet fruit', 'They wanted to honor God (Đức Chúa Trời) and not defile themselves with royal food', 'They had no money', 'The palace kitchen was closed'],\n    ans: 1,\n    bookEn: 'Daniel',\n    bookVi: 'Đa-ni-ên',\n    ref: '1:8, 12',\n    verseEn: 'But Daniel resolved not to defile himself with the royal food and wine.',\n    verseVi: 'Nhưng Đa-ni-ên quyết định trong lòng không chịu ô uế bởi đồ ăn ngon của vua và rượu vua uống.',\n  },\n  {\n    id: 'ot_076',\n    category: 'fact',\n    q: 'Who were Daniel (Đa-ni-ên)\\'s three friends thrown into the blazing fiery furnace for refusing to bow to the gold image?',\n    opts: ['Shadrach (Sa-đơ-rắc), Meshach (Mê-sắc), and Abednego (A-bết-nê-gô)', 'Peter (Phi-e-rơ), James (Gia-cơ), and John (Giăng)', 'Shem (Sem), Ham (Cham), and Japheth (Gia-phết)', 'Aaron (A-rôn), Caleb (Ca-lép), and Joshua (Giô-suê)'],\n    ans: 0,\n    bookEn: 'Daniel',\n    bookVi: 'Đa-ni-ên',\n    ref: '3:16-18, 25',\n    verseEn: 'Look! I see four men walking around in the fire, unbound and unharmed, and the fourth looks like a son of the gods.',\n    verseVi: 'Kìa, ta thấy bốn người không trói, bước đi giữa lửa, chẳng có hại gì hết; và hình dạng người thứ tư giống như con của các thần!',\n  },\n  {\n    id: 'ot_077',\n    category: 'image',\n    visualId: 'lion_den',\n    q: 'Look at the picture. Why was Daniel (Đa-ni-ên) not harmed when he was thrown into the den of lions?',\n    opts: ['The lions were asleep all day', 'God (Đức Chúa Trời) sent His angel and shut the mouths of the lions', 'Daniel (Đa-ni-ên) brought meat for them', 'He climbed out through the roof'],\n    ans: 1,\n    bookEn: 'Daniel',\n    bookVi: 'Đa-ni-ên',\n    ref: '6:22',\n    verseEn: 'My God sent his angel, and he shut the mouths of the lions. They have not hurt me.',\n    verseVi: 'Đức Chúa Trời tôi đã sai thiên sứ Ngài đến bịt miệng các sư tử, nên chúng nó không làm hại tôi.',\n  },\n  {\n    id: 'ot_078',\n    category: 'fact',\n    q: 'How many times a day did Daniel (Đa-ni-ên) kneel and pray toward Jerusalem (Giê-ru-sa-lem), even when it became forbidden?',\n    opts: ['Once a week', 'Three times a day', 'Once a month', 'Only at midnight'],\n    ans: 1,\n    bookEn: 'Daniel',\n    bookVi: 'Đa-ni-ên',\n    ref: '6:10',\n    verseEn: 'Three times a day he got down on his knees and prayed, giving thanks to his God, just as he had done before.',\n    verseVi: 'Mỗi ngày ba lần, người quì gối xuống, cầu nguyện và tạ ơn Đức Chúa Trời mình, như đã làm khi trước.',\n  },\n  {\n    id: 'ot_079',\n    category: 'fact',\n    q: 'Which great city did God (Đức Chúa Trời) command the prophet Jonah (Giô-na) to go and preach to?',\n    opts: ['Jericho (Giê-ri-cô)', 'Nineveh (Ni-ni-ve)', 'Egypt (Ê-díp-tô)', 'Sodom (Sô-đôm)'],\n    ans: 1,\n    bookEn: 'Jonah',\n    bookVi: 'Giô-na',\n    ref: '1:2',\n    verseEn: 'Go to the great city of Nineveh and preach against it, because its wickedness has come up before me.',\n    verseVi: 'Ngươi hãy chỗi dậy, đi đến thành lớn Ni-ni-ve, và kêu la nghịch cùng nó, vì tội ác chúng nó đã lên thấu trước mặt ta.',\n  },\n  {\n    id: 'ot_080',\n    category: 'image',\n    visualId: 'big_fish',\n    q: 'Look at the picture. Who spent three days and three nights inside a huge fish after running away from God (Đức Chúa Trời)?',\n    opts: ['Jonah (Giô-na)', 'Elijah (Ê-li)', 'Peter (Phi-e-rơ)', 'Moses (Môi-se)'],\n    ans: 0,\n    bookEn: 'Jonah',\n    bookVi: 'Giô-na',\n    ref: '1:17',\n    verseEn: 'Now the LORD provided a huge fish to swallow Jonah, and Jonah was in the belly of the fish three days and three nights.',\n    verseVi: 'Đức Giê-hô-va sắm sửa một con cá lớn đặng nuốt Giô-na; và Giô-na ở trong bụng cá ba ngày ba đêm.',\n  },\n  {\n    id: 'ot_081',\n    category: 'fact',\n    q: 'According to the prophet Micah (Mi-chê), which small town would the ruler of Israel (Y-sơ-ra-ên) be born in?',\n    opts: ['Nazareth (Na-xa-rét)', 'Bethlehem (Bết-lê-hem)', 'Damascus (Đa-mách)', 'Jericho (Giê-ri-cô)'],\n    ans: 1,\n    bookEn: 'Micah',\n    bookVi: 'Mi-chê',\n    ref: '5:2',\n    verseEn: 'But you, Bethlehem Ephrathah, though you are small among the clans of Judah, out of you will come for me one who will be ruler over Israel.',\n    verseVi: 'Hỡi Bết-lê-hem Ép-ra-ta, ngươi ở trong hàng ngàn Giu-đa là nhỏ lắm, song từ nơi ngươi sẽ ra cho ta một Đấng cai trị trong Y-sơ-ra-ên.',\n  },\n  {\n    id: 'ot_082',\n    category: 'verse',\n    q: 'Complete Micah (Mi-chê) 6:8: \"And what does the LORD (Đức Giê-hô-va) require of you? To act justly and to love ___ and to walk humbly with your God (Đức Chúa Trời).\"',\n    opts: ['mercy', 'wealth', 'fame', 'battle'],\n    ans: 0,\n    bookEn: 'Micah',\n    bookVi: 'Mi-chê',\n    ref: '6:8',\n    verseEn: 'To act justly and to love mercy and to walk humbly with your God.',\n    verseVi: 'Chỉ làm sự công bình, ưa sự nhơn từ, và bước đi cách khiêm nhường với Đức Chúa Trời ngươi.',\n  },\n  {\n    id: 'ot_083',\n    category: 'fact',\n    q: 'Which book of the Old Testament is filled with 150 songs, prayers, and praises to God (Đức Chúa Trời)?',\n    opts: ['Genesis (Sáng-thế Ký)', 'Psalms (Thi-thiên)', 'Jonah (Giô-na)', 'Ruth (Ru-tơ)'],\n    ans: 1,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '150:6',\n    verseEn: 'Let everything that has breath praise the LORD. Praise the LORD.',\n    verseVi: 'Phàm vật chi thở, hãy ngợi khen Đức Giê-hô-va! Ha-lê-lu-gia!',\n  },\n  {\n    id: 'ot_084',\n    category: 'fact',\n    q: 'Who was the father of King David (Đa-vít) in Bethlehem (Bết-lê-hem)?',\n    opts: ['Jesse (Gie-sê)', 'Boaz (Bô-ô)', 'Saul (Sau-lơ)', 'Eli (Hê-li)'],\n    ans: 0,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '16:1, 11-13',\n    verseEn: 'Fill your horn with oil and be on your way; I am sending you to Jesse of Bethlehem.',\n    verseVi: 'Hãy đổ dầu đầy sừng ngươi, và đi đi; ta sai ngươi đến nhà Gie-sê, người Bết-lê-hem.',\n  },\n  {\n    id: 'ot_085',\n    category: 'fact',\n    q: 'Where was Moses (Môi-se) tending sheep when he saw the burning bush?',\n    opts: ['Midian (Ma-đi-an)', 'Jericho (Giê-ri-cô)', 'Babylon (Ba-by-lôn)', 'Nineveh (Ni-ni-ve)'],\n    ans: 0,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '3:1',\n    verseEn: 'Now Moses was tending the flock of Jethro his father-in-law, the priest of Midian.',\n    verseVi: 'Vả, Môi-se chăn bầy chiên cho Giê-trô, nhạc phụ mình, làm thầy tế lễ tại xứ Ma-đi-an.',\n  },\n  {\n    id: 'ot_086',\n    category: 'fact',\n    q: 'Who watched over baby Moses (Môi-se)\\'s basket along the Nile (sông Ni-lơ) and offered to get a nurse for Pharaoh (Pha-ra-ôn)\\'s daughter?',\n    opts: ['His sister Miriam (Mi-ri-am)', 'Ruth (Ru-tơ)', 'Deborah (Đê-bô-ra)', 'Esther (Ê-xơ-tê)'],\n    ans: 0,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '2:4, 7',\n    verseEn: 'His sister stood at a distance to see what would happen to him.',\n    verseVi: 'Chị đứa trẻ đứng xa xa, xem thử việc chi sẽ xảy đến cho nó.',\n  },\n  {\n    id: 'ot_087',\n    category: 'fact',\n    q: 'In Genesis (Sáng-thế Ký), what did Noah (Nô-ê) send out first before the dove?',\n    opts: ['An eagle', 'A raven', 'A sparrow', 'A swallow'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '8:7',\n    verseEn: 'And he sent out a raven, and it kept flying back and forth until the water had dried up from the earth.',\n    verseVi: 'Người thả một con quạ, nó bay đi bay lại cho đến khi nước khô ráo trên mặt đất.',\n  },\n  {\n    id: 'ot_088',\n    category: 'fact',\n    q: 'How many sons did Jacob (Gia-cốp) have, who became the ancestors of the tribes of Israel (Y-sơ-ra-ên)?',\n    opts: ['7', '10', '12', '14'],\n    ans: 2,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '35:22; 49:28',\n    verseEn: 'Jacob had twelve sons... All these are the twelve tribes of Israel.',\n    verseVi: 'Gia-cốp có mười hai con trai... Ấy đó là mười hai chi phái của Y-sơ-ra-ên.',\n  },\n  {\n    id: 'ot_089',\n    category: 'fact',\n    q: 'Who was the mother of Samuel (Sa-mu-ên) who prayed earnestly for a child and dedicated him to serve God (Đức Chúa Trời)?',\n    opts: ['Hannah (An-ne)', 'Sarah (Sa-ra)', 'Rachel (Ra-chên)', 'Naomi (Na-ô-mi)'],\n    ans: 0,\n    bookEn: '1 Samuel',\n    bookVi: 'I Sa-mu-ên',\n    ref: '1:20, 27-28',\n    verseEn: 'I prayed for this child, and the LORD has granted me what I asked of him. So now I give him to the LORD.',\n    verseVi: 'Ấy vì cầu xin đứa trẻ nầy, nên Đức Giê-hô-va đã ban cho tôi điều tôi cầu xin Ngài. Vậy nên tôi cũng dâng nó cho Đức Giê-hô-va.',\n  },\n  {\n    id: 'ot_090',\n    category: 'fact',\n    q: 'When water was scarce in the wilderness at Rephidim (Rê-phi-đim), what did God (Đức Chúa Trời) tell Moses (Môi-se) to strike with his staff?',\n    opts: ['A palm tree', 'The rock at Horeb (Hô-rếp)', 'The sand dune', 'An iron jar'],\n    ans: 1,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '17:6',\n    verseEn: 'Strike the rock, and water will come out of it for the people to drink.',\n    verseVi: 'Ngươi hãy đập hòn đá, nước sẽ từ hòn đá chảy ra, và dân sự sẽ uống.',\n  },\n  {\n    id: 'ot_091',\n    category: 'fact',\n    q: 'During the battle with the Amalekites (dân A-ma-léc), who held up Moses (Môi-se)\\'s tired hands so Israel (Y-sơ-ra-ên) would prevail?',\n    opts: ['Aaron (A-rôn) and Hur (Hu-rơ)', 'David (Đa-vít) and Saul (Sau-lơ)', 'Cain (Ca-in) and Abel (A-ben)', 'Jacob (Gia-cốp) and Esau (Ê-sau)'],\n    ans: 0,\n    bookEn: 'Exodus',\n    bookVi: 'Xuất Ê-díp-tô Ký',\n    ref: '17:12',\n    verseEn: 'Aaron and Hur held his hands up—one on one side, one on the other—so that his hands remained steady till sunset.',\n    verseVi: 'A-rôn và Hu-rơ bèn đỡ tay người, mỗi người một bên; vậy tay người cứ giơ lên vững vàng cho đến khi mặt trời lặn.',\n  },\n  {\n    id: 'ot_092',\n    category: 'fact',\n    q: 'Which young boy was sold into Egypt (Ê-díp-tô) for twenty shekels of silver by his jealous brothers?',\n    opts: ['Benjamin (Bên-gia-min)', 'Joseph (Giô-sép)', 'Isaac (Y-sác)', 'Samuel (Sa-mu-ên)'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '37:28',\n    verseEn: 'His brothers pulled Joseph up out of the cistern and sold him for twenty shekels of silver to the Ishmaelites.',\n    verseVi: 'Các anh bèn kéo Giô-sép từ dưới hố lên, và bán cho dân Ích-ma-ên giá hai mươi miếng bạc.',\n  },\n  {\n    id: 'ot_093',\n    category: 'verse',\n    q: 'Complete Ecclesiastes (Truyền-đạo) 3:1: \"There is a time for everything, and a ___ for every activity under the heavens.\"',\n    opts: ['season', 'price', 'mountain', 'crown'],\n    ans: 0,\n    bookEn: 'Ecclesiastes',\n    bookVi: 'Truyền-đạo',\n    ref: '3:1',\n    verseEn: 'There is a time for everything, and a season for every activity under the heavens.',\n    verseVi: 'Phàm sự gì có thì tiết; mọi việc dưới trời có kỳ định.',\n  },\n  {\n    id: 'ot_094',\n    category: 'verse',\n    q: 'According to Ecclesiastes (Truyền-đạo) 12:1, when should we remember our Creator (Đấng Tạo Hóa)?',\n    opts: ['Only when old', 'In the days of your youth', 'Once a year', 'Only at night'],\n    ans: 1,\n    bookEn: 'Ecclesiastes',\n    bookVi: 'Truyền-đạo',\n    ref: '12:1',\n    verseEn: 'Remember your Creator in the days of your youth.',\n    verseVi: 'Trong buổi còn thơ ấu hãy tưởng nhớ Đấng Tạo Hóa ngươi.',\n  },\n  {\n    id: 'ot_095',\n    category: 'fact',\n    q: 'What did God (Đức Chúa Trời) form the very first man Adam (A-đam) from?',\n    opts: ['Stone from a mountain', 'Dust of the ground', 'Gold from a river', 'Leaves of a tree'],\n    ans: 1,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '2:7',\n    verseEn: 'Then the LORD God formed a man from the dust of the ground and breathed into his nostrils the breath of life.',\n    verseVi: 'Giê-hô-va Đức Chúa Trời bèn lấy bụi đất nắn nên hình người, hà sanh khí vào lỗ mũi; thì người trở nên một loài sanh linh.',\n  },\n  {\n    id: 'ot_096',\n    category: 'fact',\n    q: 'What was the name of Abraham (Áp-ra-ham)\\'s nephew who lived in Sodom (Sô-đôm) and was rescued by angels?',\n    opts: ['Lot (Lót)', 'Laban (La-ban)', 'Esau (Ê-sau)', 'Eli (Hê-li)'],\n    ans: 0,\n    bookEn: 'Genesis',\n    bookVi: 'Sáng-thế Ký',\n    ref: '19:15-16',\n    verseEn: 'The men grasped his hand and the hands of his wife and of his two daughters and led them safely out of the city.',\n    verseVi: 'Hai người nắm tay Lót, tay vợ người, và tay hai con gái người, dẫn ra ngoài thành.',\n  },\n  {\n    id: 'ot_097',\n    category: 'fact',\n    q: 'How many years did the Israelites (dân Y-sơ-ra-ên) wander in the wilderness before entering Canaan (Ca-na-an)?',\n    opts: ['7 years', '12 years', '40 years', '70 years'],\n    ans: 2,\n    bookEn: 'Numbers',\n    bookVi: 'Dân-số Ký',\n    ref: '14:33-34',\n    verseEn: 'For forty years—one year for each of the forty days you explored the land—you will suffer for your sins.',\n    verseVi: 'Theo số bốn mươi ngày các ngươi đã đi do thám xứ, mỗi ngày kể một năm, các ngươi sẽ mang lấy tội lỗi mình trong bốn mươi năm.',\n  },\n  {\n    id: 'ot_098',\n    category: 'verse',\n    q: 'Complete Psalm (Thi-thiên) 118:24: \"The LORD (Đức Giê-hô-va) has done it this very day; let us ___ today and be glad.\"',\n    opts: ['sleep', 'rejoice', 'hide', 'complain'],\n    ans: 1,\n    bookEn: 'Psalms',\n    bookVi: 'Thi-thiên',\n    ref: '118:24',\n    verseEn: 'The LORD has done it this very day; let us rejoice today and be glad.',\n    verseVi: 'Nầy là ngày Đức Giê-hô-va đã làm nên; chúng tôi sẽ mừng rỡ và vui vẻ trong ngày ấy.',\n  },\n  {\n    id: 'ot_099',\n    category: 'verse',\n    q: 'According to Proverbs (Châm-ngôn) 17:17, what does a friend do at all times?',\n    opts: ['Brings expensive gifts', 'Loves at all times', 'Travels far away', 'Never speaks'],\n    ans: 1,\n    bookEn: 'Proverbs',\n    bookVi: 'Châm-ngôn',\n    ref: '17:17',\n    verseEn: 'A friend loves at all times, and a brother is born for a time of adversity.',\n    verseVi: 'Bằng hữu thương mến nhau luôn luôn; và anh em sanh ra để giúp đỡ trong lúc hoạn nạn.',\n  },\n  {\n    id: 'ot_100',\n    category: 'fact',\n    q: 'In Malachi (Ma-la-chi), the last book of the Old Testament, who did God (Đức Chúa Trời) promise to send to prepare the way before the Lord?',\n    opts: ['His messenger', 'A mighty soldier', 'A rich merchant', 'A shipbuilder'],\n    ans: 0,\n    bookEn: 'Malachi',\n    bookVi: 'Ma-la-chi',\n    ref: '3:1',\n    verseEn: '\"I will send my messenger, who will prepare the way before me.\"',\n    verseVi: 'Nầy, ta sai sứ giả ta, người sẽ dọn đường trước mặt ta.',\n  },\n];\n"},{"path":"src/game/bibleGlossary.ts","encoding":"utf8","content":"// English-to-Vietnamese clickable word lookup & NIV / 1925 Vietnamese Traditional Bible book directory\n\nexport interface BibleBookNamePair {\n  en: string;\n  vi: string;\n}\n\nexport const BIBLE_BOOK_PAIRS: BibleBookNamePair[] = [\n  { en: 'Genesis', vi: 'Sáng-thế Ký' },\n  { en: 'Exodus', vi: 'Xuất Ê-díp-tô Ký' },\n  { en: 'Leviticus', vi: 'Lê-vi Ký' },\n  { en: 'Numbers', vi: 'Dân-số Ký' },\n  { en: 'Deuteronomy', vi: 'Phục-truyền Luật-lệ Ký' },\n  { en: 'Joshua', vi: 'Giô-suê' },\n  { en: 'Judges', vi: 'Các Quan Xét' },\n  { en: 'Ruth', vi: 'Ru-tơ' },\n  { en: '1 Samuel', vi: 'I Sa-mu-ên' },\n  { en: '2 Samuel', vi: 'II Sa-mu-ên' },\n  { en: '1 Kings', vi: 'I Các Vua' },\n  { en: '2 Kings', vi: 'II Các Vua' },\n  { en: '1 Chronicles', vi: 'I Sử-ký' },\n  { en: '2 Chronicles', vi: 'II Sử-ký' },\n  { en: 'Ezra', vi: 'E-xơ-ra' },\n  { en: 'Nehemiah', vi: 'Nê-hê-mi' },\n  { en: 'Esther', vi: 'Ê-xơ-tê' },\n  { en: 'Job', vi: 'Gióp' },\n  { en: 'Psalms', vi: 'Thi-thiên' },\n  { en: 'Proverbs', vi: 'Châm-ngôn' },\n  { en: 'Ecclesiastes', vi: 'Truyền-đạo' },\n  { en: 'Isaiah', vi: 'Ê-sai' },\n  { en: 'Jeremiah', vi: 'Giê-rê-mi' },\n  { en: 'Ezekiel', 