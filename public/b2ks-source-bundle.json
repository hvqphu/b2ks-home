he actual cache\n       * key is `'/index.html?__WB_REVISION__=1234abcd'`.\n       *\n       * @param {string|Request} request The key (without revisioning parameters)\n       * to look up in the precache.\n       * @return {Promise<Response|undefined>}\n       */\n      async matchPrecache(request) {\n        const url = request instanceof Request ? request.url : request;\n        const cacheKey = this.getCacheKeyForURL(url);\n        if (cacheKey) {\n          const cache = await self.caches.open(this.strategy.cacheName);\n          return cache.match(cacheKey);\n        }\n        return undefined;\n      }\n      /**\n       * Returns a function that looks up `url` in the precache (taking into\n       * account revision information), and returns the corresponding `Response`.\n       *\n       * @param {string} url The precached URL which will be used to lookup the\n       * `Response`.\n       * @return {workbox-routing~handlerCallback}\n       */\n      createHandlerBoundToURL(url) {\n        const cacheKey = this.getCacheKeyForURL(url);\n        if (!cacheKey) {\n          throw new WorkboxError('non-precached-url', {\n            url\n          });\n        }\n        return options => {\n          options.request = new Request(url);\n          options.params = Object.assign({\n            cacheKey\n          }, options.params);\n          return this.strategy.handle(options);\n        };\n      }\n    }\n\n    /*\n      Copyright 2019 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    let precacheController;\n    /**\n     * @return {PrecacheController}\n     * @private\n     */\n    const getOrCreatePrecacheController = () => {\n      if (!precacheController) {\n        precacheController = new PrecacheController();\n      }\n      return precacheController;\n    };\n\n    /*\n      Copyright 2018 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * Removes any URL search parameters that should be ignored.\n     *\n     * @param {URL} urlObject The original URL.\n     * @param {Array<RegExp>} ignoreURLParametersMatching RegExps to test against\n     * each search parameter name. Matches mean that the search parameter should be\n     * ignored.\n     * @return {URL} The URL with any ignored search parameters removed.\n     *\n     * @private\n     * @memberof workbox-precaching\n     */\n    function removeIgnoredSearchParams(urlObject, ignoreURLParametersMatching = []) {\n      // Convert the iterable into an array at the start of the loop to make sure\n      // deletion doesn't mess up iteration.\n      for (const paramName of [...urlObject.searchParams.keys()]) {\n        if (ignoreURLParametersMatching.some(regExp => regExp.test(paramName))) {\n          urlObject.searchParams.delete(paramName);\n        }\n      }\n      return urlObject;\n    }\n\n    /*\n      Copyright 2019 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * Generator function that yields possible variations on the original URL to\n     * check, one at a time.\n     *\n     * @param {string} url\n     * @param {Object} options\n     *\n     * @private\n     * @memberof workbox-precaching\n     */\n    function* generateURLVariations(url, {\n      ignoreURLParametersMatching = [/^utm_/, /^fbclid$/],\n      directoryIndex = 'index.html',\n      cleanURLs = true,\n      urlManipulation\n    } = {}) {\n      const urlObject = new URL(url, location.href);\n      urlObject.hash = '';\n      yield urlObject.href;\n      const urlWithoutIgnoredParams = removeIgnoredSearchParams(urlObject, ignoreURLParametersMatching);\n      yield urlWithoutIgnoredParams.href;\n      if (directoryIndex && urlWithoutIgnoredParams.pathname.endsWith('/')) {\n        const directoryURL = new URL(urlWithoutIgnoredParams.href);\n        directoryURL.pathname += directoryIndex;\n        yield directoryURL.href;\n      }\n      if (cleanURLs) {\n        const cleanURL = new URL(urlWithoutIgnoredParams.href);\n        cleanURL.pathname += '.html';\n        yield cleanURL.href;\n      }\n      if (urlManipulation) {\n        const additionalURLs = urlManipulation({\n          url: urlObject\n        });\n        for (const urlToAttempt of additionalURLs) {\n          yield urlToAttempt.href;\n        }\n      }\n    }\n\n    /*\n      Copyright 2020 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * A subclass of {@link workbox-routing.Route} that takes a\n     * {@link workbox-precaching.PrecacheController}\n     * instance and uses it to match incoming requests and handle fetching\n     * responses from the precache.\n     *\n     * @memberof workbox-precaching\n     * @extends workbox-routing.Route\n     */\n    class PrecacheRoute extends Route {\n      /**\n       * @param {PrecacheController} precacheController A `PrecacheController`\n       * instance used to both match requests and respond to fetch events.\n       * @param {Object} [options] Options to control how requests are matched\n       * against the list of precached URLs.\n       * @param {string} [options.directoryIndex=index.html] The `directoryIndex` will\n       * check cache entries for a URLs ending with '/' to see if there is a hit when\n       * appending the `directoryIndex` value.\n       * @param {Array<RegExp>} [options.ignoreURLParametersMatching=[/^utm_/, /^fbclid$/]] An\n       * array of regex's to remove search params when looking for a cache match.\n       * @param {boolean} [options.cleanURLs=true] The `cleanURLs` option will\n       * check the cache for the URL with a `.html` added to the end of the end.\n       * @param {workbox-precaching~urlManipulation} [options.urlManipulation]\n       * This is a function that should take a URL and return an array of\n       * alternative URLs that should be checked for precache matches.\n       */\n      constructor(precacheController, options) {\n        const match = ({\n          request\n        }) => {\n          const urlsToCacheKeys = precacheController.getURLsToCacheKeys();\n          for (const possibleURL of generateURLVariations(request.url, options)) {\n            const cacheKey = urlsToCacheKeys.get(possibleURL);\n            if (cacheKey) {\n              const integrity = precacheController.getIntegrityForCacheKey(cacheKey);\n              return {\n                cacheKey,\n                integrity\n              };\n            }\n          }\n          {\n            logger.debug(`Precaching did not find a match for ` + getFriendlyURL(request.url));\n          }\n          return;\n        };\n        super(match, precacheController.strategy);\n      }\n    }\n\n    /*\n      Copyright 2019 Google LLC\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * Add a `fetch` listener to the service worker that will\n     * respond to\n     * [network requests]{@link https://developer.mozilla.org/en-US/docs/Web/API/Service_Worker_API/Using_Service_Workers#Custom_responses_to_requests}\n     * with precached assets.\n     *\n     * Requests for assets that aren't precached, the `FetchEvent` will not be\n     * responded to, allowing the event to fall through to other `fetch` event\n     * listeners.\n     *\n     * @param {Object} [options] See the {@link workbox-precaching.PrecacheRoute}\n     * options.\n     *\n     * @memberof workbox-precaching\n     */\n    function addRoute(options) {\n      const precacheController = getOrCreatePrecacheController();\n      const precacheRoute = new PrecacheRoute(precacheController, options);\n      registerRoute(precacheRoute);\n    }\n\n    /*\n      Copyright 2019 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * Adds items to the precache list, removing any duplicates and\n     * stores the files in the\n     * {@link workbox-core.cacheNames|\"precache cache\"} when the service\n     * worker installs.\n     *\n     * This method can be called multiple times.\n     *\n     * Please note: This method **will not** serve any of the cached files for you.\n     * It only precaches files. To respond to a network request you call\n     * {@link workbox-precaching.addRoute}.\n     *\n     * If you have a single array of files to precache, you can just call\n     * {@link workbox-precaching.precacheAndRoute}.\n     *\n     * @param {Array<Object|string>} [entries=[]] Array of entries to precache.\n     *\n     * @memberof workbox-precaching\n     */\n    function precache(entries) {\n      const precacheController = getOrCreatePrecacheController();\n      precacheController.precache(entries);\n    }\n\n    /*\n      Copyright 2019 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * This method will add entries to the precache list and add a route to\n     * respond to fetch events.\n     *\n     * This is a convenience method that will call\n     * {@link workbox-precaching.precache} and\n     * {@link workbox-precaching.addRoute} in a single call.\n     *\n     * @param {Array<Object|string>} entries Array of entries to precache.\n     * @param {Object} [options] See the\n     * {@link workbox-precaching.PrecacheRoute} options.\n     *\n     * @memberof workbox-precaching\n     */\n    function precacheAndRoute(entries, options) {\n      precache(entries);\n      addRoute(options);\n    }\n\n    /*\n      Copyright 2018 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    const SUBSTRING_TO_FIND = '-precache-';\n    /**\n     * Cleans up incompatible precaches that were created by older versions of\n     * Workbox, by a service worker registered under the current scope.\n     *\n     * This is meant to be called as part of the `activate` event.\n     *\n     * This should be safe to use as long as you don't include `substringToFind`\n     * (defaulting to `-precache-`) in your non-precache cache names.\n     *\n     * @param {string} currentPrecacheName The cache name currently in use for\n     * precaching. This cache won't be deleted.\n     * @param {string} [substringToFind='-precache-'] Cache names which include this\n     * substring will be deleted (excluding `currentPrecacheName`).\n     * @return {Array<string>} A list of all the cache names that were deleted.\n     *\n     * @private\n     * @memberof workbox-precaching\n     */\n    const deleteOutdatedCaches = async (currentPrecacheName, substringToFind = SUBSTRING_TO_FIND) => {\n      const cacheNames = await self.caches.keys();\n      const cacheNamesToDelete = cacheNames.filter(cacheName => {\n        return cacheName.includes(substringToFind) && cacheName.includes(self.registration.scope) && cacheName !== currentPrecacheName;\n      });\n      await Promise.all(cacheNamesToDelete.map(cacheName => self.caches.delete(cacheName)));\n      return cacheNamesToDelete;\n    };\n\n    /*\n      Copyright 2019 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * Adds an `activate` event listener which will clean up incompatible\n     * precaches that were created by older versions of Workbox.\n     *\n     * @memberof workbox-precaching\n     */\n    function cleanupOutdatedCaches() {\n      // See https://github.com/Microsoft/TypeScript/issues/28357#issuecomment-436484705\n      self.addEventListener('activate', event => {\n        const cacheName = cacheNames.getPrecacheName();\n        event.waitUntil(deleteOutdatedCaches(cacheName).then(cachesDeleted => {\n          {\n            if (cachesDeleted.length > 0) {\n              logger.log(`The following out-of-date precaches were cleaned up ` + `automatically:`, cachesDeleted);\n            }\n          }\n        }));\n      });\n    }\n\n    /*\n      Copyright 2018 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * NavigationRoute makes it easy to create a\n     * {@link workbox-routing.Route} that matches for browser\n     * [navigation requests]{@link https://developers.google.com/web/fundamentals/primers/service-workers/high-performance-loading#first_what_are_navigation_requests}.\n     *\n     * It will only match incoming Requests whose\n     * {@link https://fetch.spec.whatwg.org/#concept-request-mode|mode}\n     * is set to `navigate`.\n     *\n     * You can optionally only apply this route to a subset of navigation requests\n     * by using one or both of the `denylist` and `allowlist` parameters.\n     *\n     * @memberof workbox-routing\n     * @extends workbox-routing.Route\n     */\n    class NavigationRoute extends Route {\n      /**\n       * If both `denylist` and `allowlist` are provided, the `denylist` will\n       * take precedence and the request will not match this route.\n       *\n       * The regular expressions in `allowlist` and `denylist`\n       * are matched against the concatenated\n       * [`pathname`]{@link https://developer.mozilla.org/en-US/docs/Web/API/HTMLHyperlinkElementUtils/pathname}\n       * and [`search`]{@link https://developer.mozilla.org/en-US/docs/Web/API/HTMLHyperlinkElementUtils/search}\n       * portions of the requested URL.\n       *\n       * *Note*: These RegExps may be evaluated against every destination URL during\n       * a navigation. Avoid using\n       * [complex RegExps](https://github.com/GoogleChrome/workbox/issues/3077),\n       * or else your users may see delays when navigating your site.\n       *\n       * @param {workbox-routing~handlerCallback} handler A callback\n       * function that returns a Promise resulting in a Response.\n       * @param {Object} options\n       * @param {Array<RegExp>} [options.denylist] If any of these patterns match,\n       * the route will not handle the request (even if a allowlist RegExp matches).\n       * @param {Array<RegExp>} [options.allowlist=[/./]] If any of these patterns\n       * match the URL's pathname and search parameter, the route will handle the\n       * request (assuming the denylist doesn't match).\n       */\n      constructor(handler, {\n        allowlist = [/./],\n        denylist = []\n      } = {}) {\n        {\n          finalAssertExports.isArrayOfClass(allowlist, RegExp, {\n            moduleName: 'workbox-routing',\n            className: 'NavigationRoute',\n            funcName: 'constructor',\n            paramName: 'options.allowlist'\n          });\n          finalAssertExports.isArrayOfClass(denylist, RegExp, {\n            moduleName: 'workbox-routing',\n            className: 'NavigationRoute',\n            funcName: 'constructor',\n            paramName: 'options.denylist'\n          });\n        }\n        super(options => this._match(options), handler);\n        this._allowlist = allowlist;\n        this._denylist = denylist;\n      }\n      /**\n       * Routes match handler.\n       *\n       * @param {Object} options\n       * @param {URL} options.url\n       * @param {Request} options.request\n       * @return {boolean}\n       *\n       * @private\n       */\n      _match({\n        url,\n        request\n      }) {\n        if (request && request.mode !== 'navigate') {\n          return false;\n        }\n        const pathnameAndSearch = url.pathname + url.search;\n        for (const regExp of this._denylist) {\n          if (regExp.test(pathnameAndSearch)) {\n            {\n              logger.log(`The navigation route ${pathnameAndSearch} is not ` + `being used, since the URL matches this denylist pattern: ` + `${regExp.toString()}`);\n            }\n            return false;\n          }\n        }\n        if (this._allowlist.some(regExp => regExp.test(pathnameAndSearch))) {\n          {\n            logger.debug(`The navigation route ${pathnameAndSearch} ` + `is being used.`);\n          }\n          return true;\n        }\n        {\n          logger.log(`The navigation route ${pathnameAndSearch} is not ` + `being used, since the URL being navigated to doesn't ` + `match the allowlist.`);\n        }\n        return false;\n      }\n    }\n\n    /*\n      Copyright 2019 Google LLC\n\n      Use of this source code is governed by an MIT-style\n      license that can be found in the LICENSE file or at\n      https://opensource.org/licenses/MIT.\n    */\n    /**\n     * Helper function that calls\n     * {@link PrecacheController#createHandlerBoundToURL} on the default\n     * {@link PrecacheController} instance.\n     *\n     * If you are creating your own {@link PrecacheController}, then call the\n     * {@link PrecacheController#createHandlerBoundToURL} on that instance,\n     * instead of using this function.\n     *\n     * @param {string} url The precached URL which will be used to lookup the\n     * `Response`.\n     * @param {boolean} [fallbackToNetwork=true] Whether to attempt to get the\n     * response from the network if there's a precache miss.\n     * @return {workbox-routing~handlerCallback}\n     *\n     * @memberof workbox-precaching\n     */\n    function createHandlerBoundToURL(url) {\n      const precacheController = getOrCreatePrecacheController();\n      return precacheController.createHandlerBoundToURL(url);\n    }\n\n    exports.CacheFirst = CacheFirst;\n    exports.CacheableResponsePlugin = CacheableResponsePlugin;\n    exports.ExpirationPlugin = ExpirationPlugin;\n    exports.NavigationRoute = NavigationRoute;\n    exports.cleanupOutdatedCaches = cleanupOutdatedCaches;\n    exports.clientsClaim = clientsClaim;\n    exports.createHandlerBoundToURL = createHandlerBoundToURL;\n    exports.precacheAndRoute = precacheAndRoute;\n    exports.registerRoute = registerRoute;\n\n}));\n"},{"path":"index.html","encoding":"utf8","content":"<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>B2KS Daily Routines</title>\n    <meta name=\"description\" content=\"Game RPG Gia Đình B2KS: Nhiệm vụ hằng ngày, Sở thú ảo học tiếng Anh, Trung tâm giao dịch, Chợ trời, Phòng thí nghiệm sáng tạo và Khu vui chơi đối kháng.\">\n    <meta property=\"og:title\" content=\"B2KS Daily Routines\">\n    <meta property=\"og:description\" content=\"Game RPG Gia Đình B2KS: Nhiệm vụ hằng ngày, Sở thú ảo học tiếng Anh, Trung tâm giao dịch, Chợ trời, Phòng thí nghiệm sáng tạo và Khu vui chơi đối kháng.\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\n    <meta name=\"theme-color\" content=\"#2C3E50\">\n    <meta name=\"mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"B2KS Game\">\n    <link rel=\"apple-touch-icon\" href=\"./apple-touch-icon.png\">\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"./icon.svg\">\n    <script type=\"importmap\">\n        {\n            \"imports\": {\n                \"three\": \"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\n                \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"\n            }\n        }\n    </script>\n    <script type=\"module\">\n        window.__THREE_READY__ = (async () => {\n            try {\n                const [THREE, envMod] = await Promise.all([\n                    import('https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js'),\n                    import('https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/environments/RoomEnvironment.js')\n                ]);\n                window.THREE = THREE;\n                window.THREE_ROOM_ENV = envMod.RoomEnvironment;\n                return THREE;\n            } catch (err) {\n                const [THREE, envMod] = await Promise.all([\n                    import('https://unpkg.com/three@0.170.0/build/three.module.js'),\n                    import('https://unpkg.com/three@0.170.0/examples/jsm/environments/RoomEnvironment.js')\n                ]);\n                window.THREE = THREE;\n                window.THREE_ROOM_ENV = envMod.RoomEnvironment;\n                return THREE;\n            }\n        })();\n    </script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap');\n\n        :root {\n            --primary: #F43F5E;\n            --secondary: #0D9488;\n            --accent: #FACC15;\n            --dark: #0F172A;\n            --panel-bg: #FFFFFF;\n            --border-color: #0F172A;\n        }\n\n        * {\n            box-sizing: border-box;\n            user-select: none;\n            -webkit-user-select: none;\n            font-family: 'Fredoka', sans-serif;\n        }\n\n        input, textarea, select {\n            user-select: text;\n            -webkit-user-select: text;\n        }\n\n        body {\n            margin: 0;\n            padding: 0;\n            background-color: #0F172A;\n            overflow: hidden;\n            width: 100vw;\n            height: 100dvh;\n        }\n\n        .pixel-box {\n            background: var(--panel-bg);\n            border: 3px solid var(--border-color);\n            box-shadow: 0 6px 0 var(--border-color);\n            border-radius: 14px;\n        }\n\n        .btn {\n            background: #0D9488;\n            color: #FFFFFF;\n            border: 2px solid #0F172A;\n            box-shadow: 0 3px 0 #0F172A;\n            padding: 6px 11px;\n            border-radius: 9px;\n            font-weight: 700;\n            cursor: pointer;\n            transition: transform 0.08s, filter 0.1s;\n            font-size: 13px;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            gap: 4px;\n            white-space: nowrap;\n        }\n\n        .btn:hover { filter: brightness(1.06); }\n        .btn:active {\n            transform: translateY(2px);\n            box-shadow: 0 1px 0 #0F172A;\n        }\n\n        .btn-primary { background: #F43F5E; color: #FFFFFF; }\n        .btn-accent { background: #FACC15; color: #422006; }\n        .btn-purple { background: #8B5CF6; color: #FFFFFF; }\n        .btn-danger { background: #DC2626; color: #FFFFFF; }\n        .btn-sm { padding: 4px 9px; font-size: 12px; }\n\n        /* Top HUD - High-Contrast Vibrant Compact Pills */\n        #top-hud {\n            position: fixed;\n            top: 10px;\n            left: 12px;\n            right: 12px;\n            z-index: 100;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            pointer-events: none;\n            gap: 8px;\n            flex-wrap: wrap;\n        }\n\n        .hud-pill-row {\n            pointer-events: auto;\n            display: flex;\n            align-items: center;\n            gap: 7px;\n            flex-wrap: wrap;\n            max-width: 100%;\n        }\n\n        .hud-pill {\n            display: inline-flex;\n            align-items: center;\n            gap: 7px;\n            height: 36px;\n            padding: 4px 12px;\n            border-radius: 999px;\n            background: #FFFFFF;\n            border: 2px solid #0F172A;\n            box-shadow: 0 3px 0 #0F172A;\n            color: #0F172A;\n            font-size: 12.5px;\n            font-weight: 700;\n            white-space: nowrap;\n        }\n\n        .hud-pill-compact {\n            padding: 4px 12px;\n            background: #E0F2FE;\n            border-color: #0369A1;\n            box-shadow: 0 3px 0 #0369A1;\n            color: #0C4A6E;\n        }\n\n        .hud-role-text {\n            color: #475569;\n            font-size: 11.5px;\n            font-weight: 600;\n        }\n\n        .points-pill {\n            background: linear-gradient(135deg, #FEF08A, #FACC15);\n            border: 1.5px solid #B45309;\n            padding: 2px 9px;\n            border-radius: 999px;\n            font-weight: 700;\n            color: #451A03;\n            font-size: 12px;\n            font-variant-numeric: tabular-nums;\n        }\n\n        .hud-lock-tag {\n            background: #FEE2E2;\n            border: 1.5px solid #DC2626;\n            color: #991B1B;\n            padding: 2px 8px;\n            border-radius: 999px;\n            font-size: 11px;\n            font-weight: 700;\n        }\n\n        /* Bottom High-Contrast Rounded-Square Icon Dock */\n        #hud-bottom-dock {\n            position: fixed;\n            bottom: 12px;\n            left: 50%;\n            transform: translateX(-50%);\n            z-index: 100;\n            pointer-events: auto;\n            max-width: calc(100vw - 220px);\n        }\n\n        .hud-dock-surface {\n            display: flex;\n            align-items: center;\n            gap: 6px;\n            padding: 6px 8px;\n            border-radius: 18px;\n            background: #FFFFFF;\n            border: 2px solid #0F172A;\n            box-shadow: 0 4px 0 #0F172A;\n            overflow-x: auto;\n            scrollbar-width: none;\n        }\n        .hud-dock-surface::-webkit-scrollbar {\n            display: none;\n        }\n\n        .hud-tile-btn {\n            position: relative;\n            display: inline-flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            gap: 2px;\n            min-width: 50px;\n            height: 48px;\n            padding: 4px 6px;\n            border-radius: 12px;\n            border: 1.5px solid #0F172A;\n            background: #F1F5F9;\n            color: #0F172A;\n            cursor: pointer;\n            flex-shrink: 0;\n            transition: transform 0.14s cubic-bezier(0.16, 1, 0.3, 1), filter 0.14s ease;\n        }\n\n        .hud-tile-btn:hover {\n            transform: translateY(-2px);\n            filter: brightness(1.04);\n        }\n\n        .hud-tile-btn:active {\n            transform: scale(0.95);\n        }\n\n        .hud-tile-btn.tone-amber { background: #FDE68A; border-color: #D97706; color: #78350F; }\n        .hud-tile-btn.tone-orange { background: #FDBA74; border-color: #EA580C; color: #7C2D12; }\n        .hud-tile-btn.tone-sky { background: #BAE6FD; border-color: #0284C7; color: #0C4A6E; }\n        .hud-tile-btn.tone-emerald { background: #A7F3D0; border-color: #059669; color: #064E3B; }\n        .hud-tile-btn.tone-violet { background: #DDD6FE; border-color: #7C3AED; color: #4C1D95; }\n        .hud-tile-btn.tone-teal { background: #99F6E4; border-color: #0D9488; color: #134E4A; }\n        .hud-tile-btn.tone-slate { background: #CBD5E1; border-color: #475569; color: #0F172A; }\n        .hud-tile-btn.tone-dark { background: #1E293B; border-color: #38BDF8; color: #FFFFFF; }\n\n        .hud-tile-ico {\n            font-size: 18px;\n            line-height: 1;\n        }\n\n        .hud-tile-lbl {\n            font-size: 9.5px;\n            font-weight: 700;\n            line-height: 1.1;\n            white-space: nowrap;\n            letter-spacing: -0.01em;\n        }\n\n        canvas#gameCanvas {\n            display: block;\n            width: 100vw;\n            height: 100dvh;\n            touch-action: none;\n        }\n\n        #world-labels-layer {\n            position: fixed;\n            inset: 0;\n            pointer-events: none;\n            z-index: 45;\n            overflow: hidden;\n        }\n\n        .world-float-label {\n            position: absolute;\n            transform: translate(-50%, -100%);\n            white-space: nowrap;\n            font-family: 'Fredoka', sans-serif;\n            pointer-events: none;\n            user-select: none;\n            will-change: transform;\n        }\n\n        .world-name-pill {\n            padding: 2px 9px;\n            border-radius: 999px;\n            font-size: 11px;\n            font-weight: 700;\n            color: #FFF;\n            background: rgba(15, 23, 42, 0.82);\n            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.22);\n        }\n\n        .world-name-pill.me {\n            background: #FF6B6B;\n        }\n\n        .world-building-sign {\n            padding: 3px 10px;\n            border-radius: 999px;\n            font-size: 11px;\n            font-weight: 700;\n            color: #0F172A;\n            background: #FFFFFF;\n            border: 1.5px solid #0F172A;\n            box-shadow: 0 2px 0 #0F172A;\n        }\n\n        .world-live-banner {\n            padding: 3px 10px;\n            border-radius: 999px;\n            font-size: 11px;\n            font-weight: 700;\n            color: #FFF;\n            background: #DC2626;\n            box-shadow: 0 3px 10px rgba(220, 38, 38, 0.35);\n        }\n\n        .world-live-banner.lobby {\n            background: #D97706;\n        }\n\n        .world-speech-bubble {\n            max-width: 190px;\n            white-space: normal;\n            text-align: center;\n            padding: 5px 10px;\n            border-radius: 12px;\n            font-size: 11.5px;\n            font-weight: 700;\n            line-height: 1.3;\n            color: #0F172A;\n            background: #FFFFFF;\n            border: 1.5px solid #0F172A;\n            box-shadow: 0 3px 0 #0F172A;\n        }\n\n        .world-speech-bubble.eng {\n            background: #BBF7D0;\n            color: #14532D;\n            border-color: #15803D;\n        }\n\n        #rpg-chat-bar {\n            position: fixed;\n            bottom: 78px;\n            left: 50%;\n            transform: translateX(-50%);\n            z-index: 95;\n            display: flex;\n            align-items: center;\n            gap: 6px;\n            padding: 5px 8px;\n            width: 420px;\n            max-width: calc(100vw - 140px);\n            border-radius: 999px;\n            background: #FFFFFF;\n            border: 2px solid #0F172A;\n            box-shadow: 0 4px 0 #0F172A;\n        }\n\n        #rpg-chat-bar input {\n            flex: 1;\n            min-width: 0;\n            border: 1.5px solid #94A3B8;\n            border-radius: 999px;\n            padding: 5px 12px;\n            font-size: 12.5px;\n            outline: none;\n            background: #F8FAFC;\n            color: #0F172A;\n        }\n\n        #rpg-chat-bar button {\n            flex-shrink: 0;\n            border-radius: 999px;\n        }\n\n        #chat-log-popup {\n            position: fixed;\n            bottom: 128px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 420px;\n            max-width: calc(100vw - 24px);\n            max-height: 200px;\n            overflow-y: auto;\n            z-index: 96;\n            padding: 10px 12px;\n            display: none;\n            font-size: 13px;\n            border-radius: 16px;\n            background: #FFFFFF;\n            border: 2.5px solid #0F172A;\n            box-shadow: 0 6px 0 #0F172A;\n        }\n\n        #interact-prompt {\n            position: fixed;\n            bottom: 84px;\n            left: 50%;\n            transform: translateX(-50%);\n            z-index: 94;\n            display: none;\n            transition: bottom 0.16s ease;\n        }\n\n        #interact-btn {\n            border-radius: 999px;\n            padding: 8px 18px;\n            font-size: 13.5px;\n            font-weight: 700;\n            background: #0F172A;\n            color: #FACC15;\n            border: 2px solid #FACC15;\n            box-shadow: 0 4px 0 #020617;\n        }\n\n        .phone-unread-channel {\n            background: #FEF2F2 !important;\n            color: #991B1B !important;\n            border-color: #EF4444 !important;\n            box-shadow: 0 3px 0 #DC2626 !important;\n        }\n        .msg-bubble-row.msg-unread-new .msg-bubble {\n            background: #FEF9C3 !important;\n            border-color: #EAB308 !important;\n            color: #1E293B !important;\n            box-shadow: 0 2px 8px rgba(234, 179, 8, 0.35);\n        }\n\n        #mobile-controls {\n            position: fixed;\n            bottom: 14px;\n            left: 12px;\n            width: 84px;\n            height: 84px;\n            z-index: 95;\n            touch-action: none;\n        }\n\n        #joystick-base {\n            width: 100%;\n            height: 100%;\n            border-radius: 50%;\n            background: rgba(15, 23, 42, 0.26);\n            border: 2px solid rgba(255, 255, 255, 0.72);\n            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.16);\n            position: relative;\n        }\n\n        #joystick-knob {\n            width: 32px;\n            height: 32px;\n            border-radius: 50%;\n            background: rgba(255, 255, 255, 0.94);\n            border: 1.5px solid rgba(15, 23, 42, 0.25);\n            box-shadow: 0 3px 8px rgba(15, 23, 42, 0.22);\n            position: absolute;\n            top: 24px;\n            left: 24px;\n            pointer-events: none;\n        }\n\n        .modal-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(15, 23, 42, 0.72);\n            z-index: 200;\n            display: none;\n            justify-content: center;\n            align-items: center;\n            padding: 10px;\n        }\n\n        .modal-content {\n            width: 100%;\n            max-width: 660px;\n            max-height: 88dvh;\n            overflow-y: auto;\n            padding: 16px;\n            position: relative;\n        }\n\n        .modal-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background: linear-gradient(90deg, #0284C7, #2563EB);\n            color: #FFFFFF;\n            margin: -16px -16px 12px -16px;\n            padding: 12px 16px;\n            border-radius: 11px 11px 0 0;\n            border-bottom: 3px solid #0F172A;\n        }\n\n        .modal-header h2 { margin: 0; font-size: 17px; color: #FFFFFF; }\n\n        .grid-2 {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n            gap: 10px;\n        }\n\n        .card-item {\n            border: 2.5px solid var(--dark);\n            border-radius: 10px;\n            padding: 10px;\n            background: white;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            gap: 6px;\n        }\n\n        .form-group { margin-bottom: 10px; }\n        .form-group label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 13px; }\n        .form-group input, .form-group select, .form-group textarea {\n            width: 100%;\n            padding: 7px;\n            border: 2px solid var(--dark);\n            border-radius: 6px;\n            font-size: 14px;\n        }\n\n        .tag {\n            display: inline-block;\n            padding: 2px 6px;\n            border-radius: 10px;\n            font-size: 10.5px;\n            font-weight: 700;\n            background: #eee;\n            border: 1px solid #999;\n        }\n\n        .room-tabs { display: flex; gap: 6px; flex-wrap: wrap; }\n\n        .visual-grid {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 8px;\n        }\n\n        .visual-option-card {\n            border: 2.5px solid #BDC3C7;\n            border-radius: 10px;\n            padding: 6px 4px;\n            background: #F8F9F9;\n            cursor: pointer;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 3px;\n            transition: all 0.12s;\n            text-align: center;\n            font-size: 11px;\n            font-weight: 600;\n        }\n\n        .visual-option-card.selected {\n            border-color: #FF6B6B;\n            background: #FFF0F0;\n            box-shadow: 0 2px 0 #FF6B6B;\n            transform: translateY(-1px);\n        }\n\n        .swatch-grid {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 8px;\n        }\n\n        .color-swatch {\n            width: 32px;\n            height: 32px;\n            border-radius: 50%;\n            border: 3px solid #2C3E50;\n            cursor: pointer;\n            transition: transform 0.1s;\n        }\n\n        .color-swatch.selected {\n            transform: scale(1.18);\n            box-shadow: 0 0 0 3px #FFE66D, 0 0 0 5px #2C3E50;\n        }\n\n        #toast-container {\n            position: fixed;\n            top: 86px;\n            left: 50%;\n            transform: translateX(-50%);\n            z-index: 300;\n            display: flex;\n            flex-direction: column;\n            gap: 6px;\n            pointer-events: none;\n            width: 90%;\n            max-width: 380px;\n        }\n\n        .toast {\n            background: var(--dark);\n            color: var(--accent);\n            padding: 8px 14px;\n            border-radius: 20px;\n            border: 2.5px solid white;\n            font-weight: 600;\n            font-size: 13px;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.35);\n            animation: fadeInOut 3.2s forwards;\n            text-align: center;\n        }\n\n        @keyframes fadeInOut {\n            0% { opacity: 0; transform: translateY(-10px); }\n            15% { opacity: 1; transform: translateY(0); }\n            85% { opacity: 1; transform: translateY(0); }\n            100% { opacity: 0; transform: translateY(-10px); }\n        }\n\n        .preview-img {\n            max-width: 100%;\n            max-height: 160px;\n            border-radius: 8px;\n            border: 2px solid var(--dark);\n            object-fit: contain;\n        }\n\n        .member-switcher-wrap {\n            position: relative;\n        }\n        .member-switch-btn {\n            height: 36px;\n            background: #0EA5E9;\n            color: #FFFFFF;\n            border: 2px solid #0369A1;\n            border-radius: 999px;\n            padding: 4px 13px;\n            font-weight: 700;\n            font-size: 12px;\n            cursor: pointer;\n            display: inline-flex;\n            align-items: center;\n            gap: 5px;\n            box-shadow: 0 3px 0 #0369A1;\n            transition: transform 0.12s ease, filter 0.12s ease;\n        }\n        .member-switch-btn:hover {\n            filter: brightness(1.06);\n        }\n        .member-switch-btn:active {\n            transform: scale(0.96);\n        }\n        .member-dropdown-menu {\n            position: absolute;\n            top: calc(100% + 6px);\n            left: 0;\n            right: auto;\n            min-width: 176px;\n            max-width: calc(100vw - 24px);\n            background: #FFFFFF;\n            border: 2.5px solid #0F172A;\n            border-radius: 14px;\n            box-shadow: 0 6px 0 #0F172A;\n            padding: 6px;\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            z-index: 250;\n        }\n        .member-dropdown-menu.open {\n            display: flex;\n        }\n        .member-option-item {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 8px;\n            padding: 8px 11px;\n            border-radius: 10px;\n            border: 1.5px solid #CBD5E1;\n            background: #F1F5F9;\n            cursor: pointer;\n            font-size: 13px;\n            font-weight: 700;\n            color: #0F172A;\n            text-align: left;\n            transition: background 0.1s;\n        }\n        .member-option-item:hover {\n            background: #BAE6FD;\n            border-color: #0284C7;\n        }\n        .member-option-item.active {\n            background: #FDE047;\n            border-color: #B45309;\n            color: #422006;\n        }\n\n        .smartphone-hud-btn {\n            height: 36px;\n            background: linear-gradient(135deg, #6366F1, #4338CA);\n            color: #FFFFFF;\n            border: 2px solid #1E1B4B;\n            box-shadow: 0 3px 0 #1E1B4B;\n            border-radius: 999px;\n            padding: 4px 13px;\n            font-weight: 700;\n            font-size: 12px;\n            cursor: pointer;\n            display: inline-flex;\n            align-items: center;\n            gap: 5px;\n            position: relative;\n            transition: transform 0.12s ease, filter 0.12s ease;\n        }\n        .smartphone-hud-btn:hover {\n            filter: brightness(1.08);\n        }\n        .smartphone-hud-btn:active {\n            transform: scale(0.96);\n        }\n        .unread-badge-dot {\n            position: absolute;\n            top: -5px;\n            right: -5px;\n            background: #EF4444;\n            color: #FFF;\n            border: 2px solid #FFF;\n            border-radius: 999px;\n            font-size: 9.5px;\n            font-weight: 700;\n            padding: 0 4px;\n            min-width: 17px;\n            height: 17px;\n            line-height: 13px;\n            text-align: center;\n            box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);\n        }\n\n        .phone-frame {\n            width: 100%;\n            max-width: 390px;\n            height: 84dvh;\n            max-height: 690px;\n            background: #1C2833;\n            border: 5px solid #111827;\n            border-radius: 34px;\n            padding: 10px;\n            box-shadow: 0 14px 32px rgba(0,0,0,0.55), inset 0 0 0 2px #4B5563;\n            display: flex;\n            flex-direction: column;\n            position: relative;\n        }\n        .phone-notch {\n            width: 110px;\n            height: 16px;\n            background: #111827;\n            border-radius: 0 0 12px 12px;\n            margin: 0 auto 4px auto;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 6px;\n        }\n        .phone-notch span {\n            width: 32px;\n            height: 4px;\n            background: #374151;\n            border-radius: 4px;\n        }\n        .phone-screen {\n            flex: 1;\n            background: linear-gradient(160deg, #EBF5FB 0%, #FDF2E9 55%, #EAFAF1 100%);\n            border-radius: 24px;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n            border: 2px solid #2C3E50;\n        }\n        .phone-status-bar {\n            background: rgba(44, 62, 80, 0.92);\n            color: #FFF;\n            padding: 5px 14px;\n            font-size: 11.5px;\n            font-weight: 700;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n        .phone-app-icon-btn {\n            background: #FFF;\n            border: 2.5px solid #2C3E50;\n            border-radius: 18px;\n            padding: 12px 8px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 6px;\n            cursor: pointer;\n            box-shadow: 0 4px 0 #2C3E50;\n            position: relative;\n            transition: transform 0.08s;\n        }\n        .phone-app-icon-btn:active {\n            transform: translateY(2px);\n            box-shadow: 0 2px 0 #2C3E50;\n        }\n        .phone-home-bar {\n            padding: 7px 0 3px 0;\n            display: flex;\n            justify-content: center;\n        }\n\n        .msg-bubble-row {\n            display: flex;\n            flex-direction: column;\n            max-width: 82%;\n        }\n        .msg-bubble-row.me {\n            align-self: flex-end;\n            align-items: flex-end;\n        }\n        .msg-bubble-row.other {\n            align-self: flex-start;\n            align-items: flex-start;\n        }\n        .msg-bubble {\n            padding: 7px 11px;\n            border-radius: 14px;\n            font-size: 13px;\n            line-height: 1.35;\n            word-break: break-word;\n            border: 2px solid #2C3E50;\n        }\n        .msg-bubble-row.me .msg-bubble {\n            background: #3498DB;\n            color: #FFF;\n            border-bottom-right-radius: 4px;\n        }\n        .msg-bubble-row.other .msg-bubble {\n            background: #FFF;\n            color: #2C3E50;\n            border-bottom-left-radius: 4px;\n        }\n\n        .puzzle-letter-slot {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            width: 34px;\n            height: 40px;\n            border: 2.5px solid #2C3E50;\n            border-radius: 8px;\n            font-size: 20px;\n            font-weight: 700;\n            background: #FFF;\n            color: #2C3E50;\n            text-transform: uppercase;\n        }\n        .puzzle-letter-slot.missing {\n            background: #FEF9E7;\n            border-color: #E67E22;\n            color: #D35400;\n            box-shadow: inset 0 -3px 0 #F39C12;\n        }\n\n        .zoom-pill-btn {\n            width: 38px;\n            height: 36px;\n            border-radius: 12px;\n            border: 2px solid #0F172A;\n            background: #FFFFFF;\n            color: #0F172A;\n            font-size: 15px;\n            font-weight: 700;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            box-shadow: 0 3px 0 #0F172A;\n            font-variant-numeric: tabular-nums;\n            transition: transform 0.12s ease, background-color 0.12s ease;\n        }\n        .zoom-pill-btn:hover {\n            background: #F1F5F9;\n        }\n        .zoom-pill-btn:active {\n            transform: scale(0.94);\n        }\n        .zoom-pill-btn.dark {\n            background: #1E293B;\n            color: #FACC15;\n            border-color: #0F172A;\n            font-size: 11px;\n        }\n        .zoom-pill-btn.teal {\n            background: #0D9488;\n            color: #FFFFFF;\n            border-color: #0F172A;\n        }\n        .zoom-pill-btn.sky {\n            background: #0284C7;\n            color: #FFFFFF;\n            border-color: #0F172A;\n            font-size: 11px;\n        }\n\n        @media (max-width: 720px) {\n            #top-hud {\n                top: 8px;\n                left: 8px;\n                right: 8px;\n            }\n            .hud-pill {\n                height: 33px;\n                font-size: 11.5px;\n                padding: 3px 10px;\n                gap: 5px;\n            }\n            .hud-pill-compact, .member-switch-btn, .smartphone-hud-btn {\n                height: 33px;\n                font-size: 11.5px;\n                padding: 3px 10px;\n            }\n            #hud-bottom-dock {\n                bottom: 10px;\n                left: 102px;\n                right: 54px;\n                transform: none;\n                max-width: none;\n            }\n            .hud-tile-btn {\n                min-width: 44px;\n                height: 44px;\n                padding: 3px 5px;\n                border-radius: 11px;\n            }\n            .hud-tile-ico { font-size: 16px; }\n            .hud-tile-lbl { font-size: 9px; }\n            #rpg-chat-bar {\n                left: 102px;\n                right: 54px;\n                transform: none;\n                width: auto;\n                max-width: none;\n                bottom: 70px;\n            }\n            #mobile-controls {\n                width: 78px;\n                height: 78px;\n                bottom: 10px;\n                left: 10px;\n            }\n            #joystick-knob {\n                width: 28px;\n                height: 28px;\n                top: 23px;\n                left: 23px;\n            }\n            .btn {\n                padding: 4px 7px;\n                font-size: 11.5px;\n            }\n            .visual-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n            #minimap-container {\n                width: 146px !important;\n                top: 88px !important;\n                right: 8px !important;\n                padding: 5px !important;\n            }\n            #minimap-canvas {\n                width: 132px !important;\n                height: 110px !important;\n            }\n            #minimap-zone-label {\n                font-size: 9.5px !important;\n                max-width: 68px !important;\n            }\n            #minimap-mode-btn {\n                font-size: 9px !important;\n                padding: 2px 5px !important;\n            }\n            #minimap-collapsed-pill {\n                top: 88px !important;\n                right: 8px !important;\n            }\n        }\n\n        #minimap-container {\n            position: fixed;\n            top: 58px;\n            right: 12px;\n            z-index: 92;\n            width: 196px;\n            padding: 6px;\n            display: none;\n            flex-direction: column;\n            gap: 5px;\n            border-radius: 16px;\n            background: #FFFFFF;\n            border: 2px solid #0F172A;\n            box-shadow: 0 4px 0 #0F172A;\n        }\n        #minimap-header {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 4px;\n            padding: 1px 2px;\n        }\n        #minimap-zone-label {\n            font-size: 10.5px;\n            font-weight: 700;\n            color: #0F172A;\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            max-width: 86px;\n        }\n        #minimap-header-actions {\n            display: flex;\n            align-items: center;\n            gap: 3px;\n            flex-shrink: 0;\n        }\n        #minimap-mode-btn {\n            border: 1.5px solid #0284C7;\n            background: #E0F2FE;\n            color: #0369A1;\n            border-radius: 8px;\n            padding: 2px 6px;\n            font-size: 9.5px;\n            font-weight: 700;\n            line-height: 1.15;\n            white-space: nowrap;\n            cursor: pointer;\n            transition: transform 0.14s ease, background 0.14s ease;\n        }\n        #minimap-mode-btn.heading-active {\n            border-color: #D97706;\n            background: #FEF3C7;\n            color: #92400E;\n        }\n        #minimap-collapse-btn {\n            border: 1.5px solid #64748B;\n            background: #F1F5F9;\n            color: #0F172A;\n            border-radius: 8px;\n            width: 20px;\n            height: 20px;\n            padding: 0;\n            font-size: 11px;\n            font-weight: 700;\n            line-height: 1;\n            cursor: pointer;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n        }\n        #minimap-viewport {\n            position: relative;\n            border-radius: 11px;\n            overflow: hidden;\n            border: 1.5px solid #0F172A;\n            background: #4ADE80;\n        }\n        #minimap-canvas {\n            display: block;\n            width: 180px;\n            height: 150px;\n            background: #4ADE80;\n            cursor: pointer;\n        }\n        #minimap-dest-btn {\n            position: absolute;\n            left: 5px;\n            bottom: 5px;\n            border: 1.5px solid #0F172A;\n            background: rgba(255, 255, 255, 0.94);\n            color: #0F172A;\n            border-radius: 8px;\n            padding: 2px 6px;\n            font-size: 9.5px;\n            font-weight: 700;\n            line-height: 1.2;\n            cursor: pointer;\n            box-shadow: 0 1.5px 0 #0F172A;\n            white-space: nowrap;\n        }\n        #minimap-zoom-stack {\n            position: absolute;\n            right: 5px;\n            bottom: 5px;\n            display: inline-flex;\n            align-items: center;\n            gap: 2px;\n            background: rgba(15, 23, 42, 0.88);\n            border: 1px solid rgba(255, 255, 255, 0.25);\n            border-radius: 8px;\n            padding: 1px 3px;\n        }\n        .minimap-z-btn {\n            border: none;\n            background: transparent;\n            color: #FFFFFF;\n            width: 16px;\n            height: 16px;\n            padding: 0;\n            font-size: 11px;\n            font-weight: 700;\n            line-height: 1;\n            cursor: pointer;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 5px;\n        }\n        .minimap-z-btn:hover {\n            background: rgba(255, 255, 255, 0.16);\n        }\n        #minimap-zoom-readout {\n            color: #FACC15;\n            font-size: 8.5px;\n            font-weight: 700;\n            padding: 0 2px;\n            font-variant-numeric: tabular-nums;\n            white-space: nowrap;\n        }\n        #minimap-nav-banner {\n            display: none;\n            background: #FEF3C7;\n            border: 1.5px solid #D97706;\n            border-radius: 9px;\n            padding: 3px 6px;\n            font-size: 10px;\n            font-weight: 700;\n            color: #92400E;\n            align-items: center;\n            justify-content: space-between;\n            gap: 4px;\n        }\n        #minimap-nav-label {\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            font-variant-numeric: tabular-nums;\n        }\n        #minimap-collapsed-pill {\n            position: fixed;\n            top: 58px;\n            right: 12px;\n            z-index: 92;\n            display: none;\n            align-items: center;\n            gap: 6px;\n            padding: 6px 11px;\n            border-radius: 999px;\n            background: #FFFFFF;\n            border: 2px solid #0F172A;\n            box-shadow: 0 3px 0 #0F172A;\n            font-size: 11px;\n            font-weight: 700;\n            color: #0F172A;\n            cursor: pointer;\n            white-space: nowrap;\n        }\n        body.parent-mini-minimized #top-hud,\n        body.parent-mini-minimized #hud-bottom-dock,\n        body.parent-mini-minimized #minimap-container,\n        body.parent-mini-minimized #minimap-collapsed-pill,\n        body.parent-mini-minimized #zoom-controls,\n        body.parent-mini-minimized #mobile-controls,\n        body.parent-mini-minimized #interact-prompt,\n        body.parent-mini-minimized #rpg-chat-bar {\n            display: none !important;\n        }\n    </style>\n</head>\n<body>\n\n    <!-- TOP HUD: Ultra-Compact High-Contrast Pill Bar -->\n    <div id=\"top-hud\">\n        <div class=\"hud-pill-row\">\n            <div class=\"hud-pill\">\n                <span id=\"hud-name\" style=\"font-weight:700;\">Bố</span>\n                <span class=\"hud-role-text\" id=\"hud-role\"></span>\n                <span class=\"points-pill\" id=\"hud-points\">200⭐</span>\n            </div>\n\n            <div class=\"hud-pill hud-pill-compact\" id=\"hud-weather-pill\" title=\"Thời tiết thực tế ngoài đời\">🌤️ ...</div>\n        </div>\n\n        <div class=\"hud-pill-row\">\n            <div class=\"member-switcher-wrap\" id=\"member-switcher-wrap\" style=\"display:flex; gap:6px; align-items:center;\">\n                <span id=\"hud-device-lock-tag\" class=\"hud-lock-tag\" style=\"display:none;\">🔒 Khóa máy</span>\n                <button type=\"button\" class=\"member-switch-btn\" id=\"member-switch-btn\" onclick=\"requestParentAccess(() => toggleMemberDropdown(event))\">\n                    🔄 Đổi người ▾\n                </button>\n                <div class=\"member-dropdown-menu\" id=\"member-dropdown-menu\"></div>\n            </div>\n\n            <button type=\"button\" class=\"smartphone-hud-btn\" id=\"hud-smartphone-btn\" onclick=\"openSmartphoneModal()\" title=\"Mở Smartphone cá nhân\">\n                <span>📱</span>\n                <span>Điện thoại</span>\n                <span class=\"unread-badge-dot\" id=\"hud-phone-unread-badge\" style=\"display:none;\">0</span>\n            </button>\n        </div>\n    </div>\n\n    <!-- BOTTOM DOCK: Uniform Rounded-Square Action Icons -->\n    <div id=\"hud-bottom-dock\">\n        <div class=\"hud-dock-surface\" id=\"hud-actions-group\">\n            <button type=\"button\" class=\"hud-tile-btn tone-sky\" id=\"hud-tasks-btn\" onclick=\"openTasksModal()\" title=\"Bảng Nhiệm vụ & Bài tập\">\n                <span class=\"hud-tile-ico\">📋</span>\n                <span class=\"hud-tile-lbl\">Nhiệm vụ</span>\n                <span class=\"unread-badge-dot\" id=\"hud-tasks-notice-badge\" style=\"display:none;\">0</span>\n            </button>\n            <button type=\"button\" class=\"hud-tile-btn tone-amber\" onclick=\"openModal('bag-modal')\" title=\"Túi đồ cá nhân\">\n                <span class=\"hud-tile-ico\">🎒</span>\n                <span class=\"hud-tile-lbl\">Túi đồ</span>\n            </button>\n            <button type=\"button\" class=\"hud-tile-btn tone-orange\" onclick=\"openPetCollectionModal()\" title=\"Bộ sưu tập & chăm sóc thú cưng\">\n                <span class=\"hud-tile-ico\">🐾</span>\n                <span class=\"hud-tile-lbl\">Thú cưng</span>\n            </button>\n            <button type=\"button\" class=\"hud-tile-btn tone-violet\" id=\"hud-custom-btn\" onclick=\"openModal('custom-modal')\" title=\"Tùy chỉnh phòng, nhà phố & trang phục\">\n                <span class=\"hud-tile-ico\">🎨</span>\n                <span class=\"hud-tile-lbl\">Tùy chỉnh</span>\n            </button>\n            <button type=\"button\" class=\"hud-tile-btn tone-dark\" id=\"hud-guide-btn\" onclick=\"openModal('guide-modal')\" title=\"Hướng dẫn chơi 3D\">\n                <span class=\"hud-tile-ico\">❓</span>\n                <span class=\"hud-tile-lbl\">Hướng dẫn</span>\n            </button>\n            <button type=\"button\" class=\"hud-tile-btn tone-slate\" id=\"hud-more-toggle-btn\" onclick=\"toggleHudTools()\" title=\"Mở rộng / Thu gọn tiện ích\">\n                <span class=\"hud-tile-ico\" id=\"hud-more-ico\">⋯</span>\n                <span class=\"hud-tile-lbl\" id=\"hud-more-lbl\">Thêm</span>\n            </button>\n\n            <span id=\"hud-extra-tools\" style=\"display:none; gap:5px; align-items:center;\">\n                <button type=\"button\" class=\"hud-tile-btn tone-amber\" id=\"hud-achievements-btn\" onclick=\"openReactModal('achievements')\" title=\"Bảng Huy Hiệu & Thành Tựu\">\n                    <span class=\"hud-tile-ico\">🏆</span>\n                    <span class=\"hud-tile-lbl\">Thành tựu</span>\n                </button>\n                <button type=\"button\" class=\"hud-tile-btn tone-amber\" id=\"hud-parental-btn\" onclick=\"requestParentAccess(() => openReactModal('parental_dashboard'))\" title=\"Bảng điều khiển Phụ huynh\">\n                    <span class=\"hud-tile-ico\">📊</span>\n                    <span class=\"hud-tile-lbl\">Phụ huynh</span>\n                    <span class=\"unread-badge-dot\" id=\"hud-parent-pending-badge\" style=\"display:none;\">0</span>\n                </button>\n                <button type=\"button\" class=\"hud-tile-btn tone-sky\" id=\"hud-mini-window-btn\" style=\"display:none;\" onclick=\"openParentMiniWindow()\" title=\"Thu nhỏ nổi trên cùng theo dõi thành viên\">\n                    <span class=\"hud-tile-ico\">🪟</span>\n                    <span class=\"hud-tile-lbl\">Thu nhỏ</span>\n                </button>\n                <button type=\"button\" class=\"hud-tile-btn tone-teal\" onclick=\"openModal('donate-modal')\" title=\"Tặng điểm cho thành viên\">\n                    <span class=\"hud-tile-ico\">🎁</span>\n                    <span class=\"hud-tile-lbl\">Tặng điểm</span>\n                </button>\n                <button type=\"button\" class=\"hud-tile-btn tone-teal\" id=\"hud-family-sync-btn\" onclick=\"requestParentAccess(() => openModal('family-sync-modal'))\" title=\"Đồng bộ gia đình & mã PIN\">\n                    <span class=\"hud-tile-ico\">🔗</span>\n                    <span class=\"hud-tile-lbl\">Gia đình</span>\n                </button>\n                <button type=\"button\" class=\"hud-tile-btn tone-violet\" id=\"hud-admin-btn\" style=\"display:none;\" onclick=\"openReactModal('admin_panel')\" title=\"Quản trị Admin\">\n                    <span class=\"hud-tile-ico\">🛠️</span>\n                    <span class=\"hud-tile-lbl\">Admin</span>\n                </button>\n                <button type=\"button\" class=\"hud-tile-btn tone-emerald\" id=\"audio-toggle-btn\" onclick=\"toggleAudio()\" title=\"Bật / Tắt âm thanh\">\n                    <span class=\"hud-tile-ico\" id=\"audio-toggle-ico\">🔊</span>\n                    <span class=\"hud-tile-lbl\" id=\"audio-toggle-lbl\">Nhạc</span>\n                </button>\n                <button type=\"button\" class=\"hud-tile-btn tone-sky\" id=\"hud-notif-btn\" onclick=\"toggleTaskNotifications()\" title=\"Bật / Kiểm tra thông báo bài tập mới\">\n                    <span class=\"hud-tile-ico\" id=\"hud-notif-ico\">🔔</span>\n                    <span class=\"hud-tile-lbl\" id=\"hud-notif-lbl\">Thông báo</span>\n                </button>\n                <span id=\"hud-sound-slot\" style=\"display:inline-flex; align-items:center;\"></span>\n                <span id=\"hud-pwa-slot\" style=\"display:inline-flex; align-items:center;\"></span>\n            </span>\n        </div>\n    </div>\n\n    <div id=\"toast-container\"></div>\n\n    <!-- NEIGHBORHOOD MINIMAP + NAVIGATION OVERLAY -->\n    <button type=\"button\" id=\"minimap-collapsed-pill\" onclick=\"toggleMinimapCollapsed()\" title=\"Mở lại bản đồ nhỏ\">\n        <span>🗺️ Bản đồ</span>\n        <span id=\"minimap-collapsed-nav\" style=\"display:none; color:#DC2626; font-variant-numeric:tabular-nums;\"></span>\n        <span>▾</span>\n    </button>\n    <div id=\"minimap-container\">\n        <div id=\"minimap-header\">\n            <span id=\"minimap-zone-label\" title=\"Khu vực hiện tại\">🗺️ Khu phố</span>\n            <div id=\"minimap-header-actions\">\n                <button type=\"button\" id=\"minimap-mode-btn\" onclick=\"toggleMinimapMode()\" title=\"Đổi chế độ hướng bản đồ (Theo góc nhìn 3D / Xoay theo nhân vật)\">🎥 3D</button>\n                <button type=\"button\" id=\"minimap-collapse-btn\" onclick=\"toggleMinimapCollapsed()\" title=\"Thu nhỏ Minimap\">－</button>\n            </div>\n        </div>\n        <div id=\"minimap-viewport\">\n            <canvas id=\"minimap-canvas\" width=\"360\" height=\"300\" title=\"Bấm vào biểu tượng tòa nhà để chỉ đường nhanh, hoặc bấm vùng trống để mở Bản đồ\"></canvas>\n            <button type=\"button\" id=\"minimap-dest-btn\" onclick=\"openSmartphoneModal('maps')\" title=\"Mở danh sách địa điểm chỉ đường\">🧭 Tìm</button>\n            <div id=\"minimap-zoom-stack\" title=\"Thu phóng bản đồ nhỏ\">\n                <button type=\"button\" class=\"minimap-z-btn\" onclick=\"zoomMinimap(-1)\" title=\"Thu nhỏ góc nhìn bản đồ\">－</button>\n                <span id=\"minimap-zoom-readout\">1×</span>\n                <button type=\"button\" class=\"minimap-z-btn\" onclick=\"zoomMinimap(1)\" title=\"Phóng to chi tiết bản đồ\">＋</button>\n            </div>\n        </div>\n        <div id=\"minimap-nav-banner\">\n            <span id=\"minimap-nav-label\"></span>\n            <button type=\"button\" onclick=\"cancelNavigationTarget()\" title=\"Hủy chỉ đường\" style=\"border:none; background:#EF4444; color:#FFF; border-radius:999px; width:16px; height:16px; padding:0; font-size:9px; font-weight:700; cursor:pointer; flex-shrink:0;\">✖</button>\n        </div>\n    </div>\n\n    <!-- MAIN 3D CANVAS & FLOATING LABELS -->\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"world-labels-layer\"></div>\n\n    <!-- ZOOM & CAMERA CONTROLS -->\n    <div id=\"zoom-controls\" style=\"position:fixed; right:12px; bottom:88px; z-index:95; display:flex; flex-direction:column; gap:5px;\">\n        <button class=\"zoom-pill-btn\" onclick=\"changeZoom(0.15)\" title=\"Phóng to (Zoom In)\">＋</button>\n        <button class=\"zoom-pill-btn dark\" id=\"zoom-level-btn\" onclick=\"resetZoom()\" title=\"Đặt lại thu phóng\">100%</button>\n        <button class=\"zoom-pill-btn\" onclick=\"changeZoom(-0.15)\" title=\"Thu nhỏ (Zoom Out)\">－</button>\n        <button class=\"zoom-pill-btn teal\" id=\"camera-reset-btn\" onclick=\"resetCameraView && resetCameraView()\" title=\"Khóa lại góc nhìn theo nhân vật\">🧭</button>\n        <button class=\"zoom-pill-btn\" id=\"camera-mode-btn\" onclick=\"toggleCameraViewMode && toggleCameraViewMode()\" title=\"Đổi góc nhìn: Isometric 45° ↔ Phối cảnh XCity\">ISO</button>\n    </div>\n\n    <!-- FLOATING INTERACTION PROMPT -->\n    <div id=\"interact-prompt\">\n        <button class=\"btn\" id=\"interact-btn\" onclick=\"triggerInteraction()\">\n            🏠 Vào nhà\n        </button>\n    </div>\n\n    <!-- ROBLOX-STYLE JOYSTICK -->\n    <div id=\"mobile-controls\">\n        <div id=\"joystick-base\">\n            <div id=\"joystick-knob\"></div>\n        </div>\n    </div>\n\n    <!-- RPG CHAT LOG POPUP -->\n    <div id=\"chat-log-popup\">\n        <div style=\"display:flex; justify-content:space-between; border-bottom:1px solid rgba(15,23,42,0.1); padding-bottom:6px; margin-bottom:6px;\">\n            <b>📜 Nhật ký hội thoại</b>\n            <span style=\"cursor:pointer; font-weight:bold;\" onclick=\"toggleChatLog()\">✖</span>\n        </div>\n        <div id=\"chat-log-list\" style=\"display:flex; flex-direction:column; gap:4px;\"></div>\n    </div>\n\n    <!-- RPG SPEECH INPUT BAR (Contextual) -->\n    <div id=\"rpg-chat-bar\" style=\"display: none;\">\n        <button class=\"btn btn-sm\" style=\"background:#334155; border:none; box-shadow:none;\" onclick=\"toggleChatLog()\" title=\"Xem lịch sử chat\">📜</button>\n        <input type=\"text\" id=\"chat-input\" placeholder=\"Nói tiếng Anh +2⭐...\" onkeypress=\"if(event.key==='Enter') sendChat()\">\n        <button class=\"btn btn-sm btn-accent\" style=\"border:none; box-shadow:none;\" onclick=\"sendChat()\">💬 Nói</button>\n        <button class=\"btn btn-sm\" style=\"background:#64748B; border:none; box-shadow:none; padding:4px 8px;\" onclick=\"hideContextualChatBar()\" title=\"Ẩn khung chat\">✖</button>\n    </div>\n\n    <!-- ==================== MODALS ==================== -->\n\n    <!-- 1. GUIDE MODAL -->\n    <div class=\"modal-overlay\" id=\"guide-modal\" style=\"display: none;\">\n        <div class=\"modal-content pixel-box\" style=\"max-width: 780px;\">\n            <div class=\"modal-header\" style=\"align-items:flex-start; gap:10px;\">\n                <div>\n                    <h2 id=\"guide-title-brand\" style=\"margin:0;\">🏡 B2KS Daily Routines — Khu Phố Gia Đình</h2>\n                    <div style=\"display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-top:4px; font-size:12px; color:#475569; font-weight:700;\">\n                        <span>Phiên bản: <b id=\"guide-app-version\" style=\"color:#0369A1;\">v2.6.0</b></span>\n                        <span aria-hidden=\"true\">·</span>\n                        <span>Cập nhật mới nhất: <b id=\"guide-updated-at\" style=\"color:#0F766E;\">26/11/2026 — 20:05</b></span>\n                    </div>\n                </div>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('guide-modal'); startAudioOnce();\">Bắt đầu chơi ▶</button>\n            </div>\n\n            <!-- Categorized Tabs -->\n            <div id=\"guide-cat-tabs\" style=\"display:flex; flex-wrap:wrap; gap:6px; padding:8px; background:#E2E8F0; border:2px solid var(--dark); border-radius:10px; margin-bottom:12px;\">\n                <button type=\"button\" class=\"btn btn-sm guide-tab-btn\" data-guide-tab=\"all\" onclick=\"switchGuideTab('all')\" style=\"background:#0F766E; color:#FFF;\">📚 Tất cả hạng mục</button>\n                <button type=\"button\" class=\"btn btn-sm guide-tab-btn\" data-guide-tab=\"controls\" onclick=\"switchGuideTab('controls')\" style=\"background:#FFF; color:#1E293B;\">🕹️ Điều khiển &amp; 3D</button>\n                <button type=\"button\" class=\"btn btn-sm guide-tab-btn\" data-guide-tab=\"map\" onclick=\"switchGuideTab('map')\" style=\"background:#FFF; color:#1E293B;\">🗺️ Khu phố &amp; Phòng riêng</button>\n                <button type=\"button\" class=\"btn btn-sm guide-tab-btn\" data-guide-tab=\"tasks\" onclick=\"switchGuideTab('tasks')\" style=\"background:#FFF; color:#1E293B;\">📋 Nhiệm vụ &amp; Đổi quà</button>\n                <button type=\"button\" class=\"btn btn-sm guide-tab-btn\" data-guide-tab=\"learn\" onclick=\"switchGuideTab('learn')\" style=\"background:#FFF; color:#1E293B;\">🎓 Học tập &amp; Kinh Thánh</button>\n                <button type=\"button\" class=\"btn btn-sm guide-tab-btn\" data-guide-tab=\"play\" onclick=\"switchGuideTab('play')\" style=\"background:#FFF; color:#1E293B;\">🎮 Game, Pet &amp; Lab</button>\n                <button type=\"button\" class=\"btn btn-sm guide-tab-btn\" data-guide-tab=\"online\" onclick=\"switchGuideTab('online')\" style=\"background:#FFF; color:#1E293B;\">👨‍👩‍👧‍👦 Online &amp; Phụ huynh</button>\n            </div>\n\n            <div style=\"font-size: 13.5px; line-height: 1.55; display:flex; flex-direction:column; gap:10px;\">\n                <section class=\"guide-section\" data-guide-cat=\"controls\" style=\"background:#F8FAFC; border:2px solid #CBD5E1; border-radius:10px; padding:10px 12px;\">\n                    <h3 style=\"margin:0 0 6px; font-size:14.5px; color:#0F172A;\">🕹️ 1. Di Chuyển, Camera 3D &amp; Âm Thanh</h3>\n                    <ul style=\"margin:0; padding-left:18px;\">\n                        <li><b>Di chuyển nhân vật:</b> Dùng phím <b>Mũi tên / W A S D</b> trên máy tính, <b>Joystick</b> góc dưới bên trái trên cảm ứng, hoặc <b>Chạm trực tiếp vào mặt đất (Tap-to-move)</b> để tự bước tới điểm chọn.</li>\n                        <li><b>Điều khiển Camera 3D Isometric:</b> Kéo/vuốt màn hình để xoay góc nhìn, cuộn chuột hoặc chụm ngón để phóng to/thu nhỏ, bấm nút <b>🧭</b> góc phải để quay lại góc nhìn 45° chuẩn.</li>\n                        <li><b>Tương tác công trình:</b> Đi lại gần cửa các tòa nhà hoặc nhân vật NPC, nhấn phím <b>Space / Enter</b> hoặc bấm nút hành động hiện ra phía dưới màn hình.</li>\n                        <li><b>Nhạc nền &amp; Thời tiết:</b> Chọn chủ đề nhạc nền riêng biệt ở góc trên bên phải; ánh sáng Ngày/Đêm và Thời tiết tự động cập nhật theo thời gian thực.</li>\n                    </ul>\n                </section>\n\n                <section class=\"guide-section\" data-guide-cat=\"map\" style=\"background:#F0F9FF; border:2px solid #BAE6FD; border-radius:10px; padding:10px 12px;\">\n                    <h3 style=\"margin:0 0 6px; font-size:14.5px; color:#0C4A6E;\">🗺️ 2. Bản Đồ Khu Phố, Nhà Phố &amp; Phòng Riêng</h3>\n                    <ul style=\"margin:0; padding-left:18px;\">\n                        <li><b>Bản đồ thu nhỏ (Minimap) &amp; Chỉ đường GPS:</b> Thu gọn/mở rộng, phóng to hoặc xoay Minimap ở góc phải; mở <b>📱 Điện thoại ➔ Bản đồ</b> để chọn công trình và bật mũi tên dẫn đường trực tiếp.</li>\n                        <li><b>Nhà Phố Gia Đình:</b> Bước vào sảnh chung (Ăn tối kiếm sao, xem TV giải trí), dùng thang máy hoặc cửa hành lang lên <b>Phòng riêng</b> của từng thành viên.</li>\n                        <li><b>Trang trí &amp; Cất đồ Phòng riêng:</b> Dùng vật phẩm mua ở Siêu Thị hoặc chế tạo từ Phòng Thí Nghiệm để đặt lên nhiều vị trí trong phòng (số lượng trong túi sẽ trừ đúng số đã đặt). Có thể <b>nhặt/thu hồi đồ trang trí</b> cất lại vào túi bất cứ lúc nào!</li>\n                        <li><b>Thời trang &amp; Salon:</b> Ghé <b>👗 Thời Trang</b> &amp; <b>💇 Salon Tóc</b> đổi kiểu tóc, trang phục và đồng bộ ngay diện mạo sang các máy khác.</li>\n                    </ul>\n                </section>\n\n                <section class=\"guide-section\" data-guide-cat=\"tasks\" style=\"background:#FFFBEB; border:2px solid #FDE68A; border-radius:10px; padding:10px 12px;\">\n                    <h3 style=\"margin:0 0 6px; font-size:14.5px; color:#78350F;\">📋 3. Nhiệm Vụ, Điểm Sao &amp; Quy Đổi Ngoài Đời</h3>\n                    <ul style=\"margin:0; padding-left:18px;\">\n                        <li><b>Bảng Nhiệm Vụ (📋):</b> Bố mẹ giao <b>Việc nhà</b>, <b>Bài tập học tập</b> (đính kèm ảnh/tệp &amp; chấm điểm), hoặc <b>Nhiệm vụ Đồng đội</b> cho các con cùng hoàn thành.</li>\n                        <li><b>Giới hạn điểm Phụ Huynh:</b> Điểm bố mẹ tối đa mặc định <b>500⭐</b> (Admin có thể tùy chỉnh giới hạn này cho từng gia đình).</li>\n                        <li><b>🌌 Trung Tâm Xuyên Thế Giới:</b> Các con dùng điểm sao tích lũy gửi yêu cầu đổi quà/tiền thưởng/đặc quyền thật ngoài đời để bố mẹ duyệt.</li>\n                        <li><b>🎪 Chợ Trời &amp; 🏪 Siêu Thị Gia Đình:</b> Mua nội thất, thẻ TV, phụ kiện thú cưng hoặc đăng bán/mua trao đổi vật phẩm giữa các thành viên.</li>\n                    </ul>\n                </section>\n\n                <section class=\"guide-section\" data-guide-cat=\"learn\" style=\"background:#F0FDF4; border:2px solid #BBF7D0; border-radius:10px; padding:10px 12px;\">\n                    <h3 style=\"margin:0 0 6px; font-size:14.5px; color:#14532D;\">🎓 4. Học Tập Song Ngữ &amp; Nhà Thờ Tin Lành (Đố Kinh Thánh)</h3>\n                    <ul style=\"margin:0; padding-left:18px;\">\n                        <li><b>⛪ Nhà Thờ Tin Lành — Đố Kinh Thánh (200 câu NIV &amp; Truyền Thống 1925):</b>\n                            <ul style=\"margin:4px 0; padding-left:18px;\">\n                                <li>Trả lời đúng mỗi câu nhận <b>+1⭐</b>; đúng <b>3 câu liên tiếp</b> được thưởng thêm <b>+1⭐</b>.</li>\n                                <li>Chạm trực tiếp vào bất kỳ từ tiếng Anh nào trên câu hỏi (hoặc bật <b>Tra từ đáp án</b>) để xem nghĩa tiếng Việt ngay; tên riêng có chú thích tiếng Việt theo bản 1925.</li>\n                                <li>Trả lời sai sẽ không lộ đáp án mà hiển thị <b>gợi ý tên Sách Kinh Thánh</b> (Anh &amp; Việt) để tự tìm; trả lời đúng sẽ hiện nguyên văn câu Kinh Thánh song ngữ (NIV &amp; 1925).</li>\n                                <li>Mỗi câu trả lời đúng đủ <b>3 lần</b> sẽ được lưu đồng bộ và không hỏi lại thành viên đó nữa.</li>\n                            </ul>\n                        </li>\n                        <li><b>🎓 Trung Tâm Tiếng Anh (Global Success Lớp 6–9):</b> Bộ 1,920 câu Từ vựng &amp; Ngữ pháp phân chia theo Lớp 6–9 và Unit 1–12.</li>\n                        <li><b>🗣️ Luyện Nói (Speaking Practice):</b> Nói chuyện trực tiếp với <b>Mr. Alex</b> &amp; <b>Ms. Emma</b> trên phố qua Micro (Level 1–5) để thăng cấp &amp; nhận sao.</li>\n                        <li><b>💬 Chat Tiếng Anh &amp; 📚 Góc Đọc Sách / Truyện Tranh:</b> Gõ câu tiếng Anh không trùng lặp hoặc đọc truyện tranh song ngữ để nhận thưởng &amp; mở huy hiệu Thành tựu (🏆).</li>\n                    </ul>\n                </section>\n\n                <section class=\"guide-section\" data-guide-cat=\"play\" style=\"background:#FAF5FF; border:2px solid #E9D5FF; border-radius:10px; padding:10px 12px;\">\n                    <h3 style=\"margin:0 0 6px; font-size:14.5px; color:#581C87;\">🎮 5. Khu Vui Chơi, Đá Luân Lưu, Thú Cưng &amp; Phòng Thí Nghiệm</h3>\n                    <ul style=\"margin:0; padding-left:18px;\">\n                        <li><b>⚽ Sân Bóng Đá Đá Luân Lưu (Miễn phí):</b> Chơi 1 người với máy hoặc tạo phòng <b>2P Online</b> thay phiên nhau Sút bóng &amp; làm Thủ môn bắt gôn (chỉ chủ phòng mới bấm Bắt đầu khi cả hai đã Sẵn sàng, tự thoát phòng khi rời sân).</li>\n                        <li><b>🕹️ Khu Vui Chơi Arcade (1⭐):</b> Chơi các mini-game (Caro, Đua xe, Rắn, Đua Toán, Cờ Vua...) cùng bạn trong phòng chờ Online đồng bộ cả 2 máy.</li>\n                        <li><b>🐾 Cửa Hàng Thú Cưng &amp; 🦁 Sở Thú Ảo:</b> Nhận trứng 10 loài thú cưng, ấp nở, cho ăn để tiến hóa 4 cấp bậc, đeo phụ kiện &amp; khám phá thế giới động vật Wiki.</li>\n                        <li><b>🧪 Phòng Thí Nghiệm Sáng Tạo:</b> Mô tả đồ vật bằng tiếng Anh để chế tạo vật phẩm 2D trong túi đồ đồng nhất với mô hình 3D đặt ngoài bản đồ/phòng riêng.</li>\n                    </ul>\n                </section>\n\n                <section class=\"guide-section\" data-guide-cat=\"online\" style=\"background:#FFF1F2; border:2px solid #FECDD3; border-radius:10px; padding:10px 12px;\">\n                    <h3 style=\"margin:0 0 6px; font-size:14.5px; color:#881337;\">👨‍👩‍👧‍👦 6. Đồng Bộ Online, Thông Báo &amp; Bảng Điều Khiển Phụ Huynh</h3>\n                    <ul style=\"margin:0; padding-left:18px;\">\n                        <li><b>Đồng bộ đa thiết bị (Realtime):</b> Tự động đồng bộ tên nhân vật, diện mạo, túi đồ, đồ trang trí phòng riêng, tiến độ học &amp; phòng chơi giữa các máy.</li>\n                        <li><b>🔔 Thông báo Push Notification:</b> Mở khóa thông báo để máy con tự nhận chuông &amp; thông báo ngay khi ba mẹ giao bài tập/nhiệm vụ mới.</li>\n                        <li><b>🤖 Robot Trợ Lý &amp; Mini Window:</b> Nhắn tin nhắc việc qua Robot đi theo con và theo dõi hoạt động nhanh qua cửa sổ phụ huynh thu gọn.</li>\n                        <li><b>📊 Bảng Điều Khiển Phụ Huynh (PIN mặc định 1234):</b> Xem biểu đồ tiến độ, nhật ký gia đình, duyệt đổi quà, nhập/xuất CSV ngân hàng <b>Tiếng Anh</b>, <b>Speaking</b> &amp; <b>Đố Kinh Thánh</b> và tùy chỉnh vị trí/hình dáng công trình bản đồ (Admin có thêm mục Xuất ZIP mã nguồn).</li>\n                    </ul>\n                </section>\n            </div>\n        </div>\n    </div>\n\n    <!-- 2. HOUSE INFO MODAL -->\n    <div class=\"modal-overlay\" id=\"house-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:520px;\">\n            <div class=\"modal-header\">\n                <h2 id=\"house-modal-title\">🏢 Nhà Phố Gia Đình B2KS</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('house-modal')\">Đóng</button>\n            </div>\n            <p style=\"margin-top:0;\"><b>👨‍👩‍👧‍👦 Thành viên &amp; Vị trí hiện tại:</b></p>\n            <div id=\"family-members-list\" class=\"grid-2\" style=\"margin-bottom: 15px;\"></div>\n            <button class=\"btn btn-accent\" style=\"width:100%; justify-content:center; font-size:15px; padding:10px;\" onclick=\"enterHouseScene()\">\n                🚪 Bước vào bên trong Nhà ➔\n            </button>\n        </div>\n    </div>\n\n    <!-- 3. TASKS & HOMEWORK MODAL -->\n    <div class=\"modal-overlay\" id=\"tasks-modal\">\n        <div class=\"modal-content pixel-box\">\n            <div class=\"modal-header\">\n                <h2>📋 Bảng Nhiệm Vụ &amp; Bài Tập</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('tasks-modal')\">Đóng</button>\n            </div>\n\n            <div id=\"parent-task-creator\" style=\"background:#FFF8E7; padding:12px; border:2px solid var(--dark); border-radius:8px; margin-bottom:15px;\">\n                <h3 style=\"margin-top:0; font-size:15px;\">➕ Giao việc / Nhiệm vụ đồng đội mới</h3>\n                <div class=\"grid-2\">\n                    <div class=\"form-group\">\n                        <label>Loại nhiệm vụ:</label>\n                        <select id=\"task-type\" onchange=\"toggleHomeworkUpload()\">\n                            <option value=\"chore\">🧹 Việc nhà / Thói quen tốt</option>\n                            <option value=\"homework\">📚 Bài tập học tập (Chấm điểm 10)</option>\n                            <option value=\"family_quest\">🤝 Nhiệm vụ Đồng đội (Các con cùng làm)</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\" id=\"task-assignee-group\">\n                        <label>Giao cho con:</label>\n                        <select id=\"task-assignee\"></select>\n                    </div>\n                </div>\n                <div class=\"grid-2\">\n                    <div class=\"form-group\">\n                        <label>Tên nhiệm vụ / Bài tập:</label>\n                        <input type=\"text\" id=\"task-title\" placeholder=\"VD: Quét nhà tầng 1, Cùng dọn đồ chơi...\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label>Điểm thưởng (Mỗi bé):</label>\n                        <input type=\"number\" id=\"task-reward\" value=\"20\" min=\"5\" max=\"100\">\n                    </div>\n                </div>\n                <div class=\"form-group\">\n                    <label>⏰ Hạn hoàn thành (tùy chọn — trễ hạn nhận 1/3 điểm):</label>\n                    <input type=\"datetime-local\" id=\"task-deadline\">\n                </div>\n                <div class=\"form-group\" id=\"parent-file-group\" style=\"display:none;\">\n                    <label>📎 Đính kèm ảnh/tài liệu đề bài:</label>\n                    <input type=\"file\" id=\"task-parent-file\" accept=\"image/*,.pdf,.doc,.docx,.txt\">\n                </div>\n                <button class=\"btn btn-primary\" onclick=\"createTask()\">Giao nhiệm vụ ngay</button>\n            </div>\n\n            <h3 style=\"font-size:15px;\">📌 Danh sách nhiệm vụ hiện tại</h3>\n            <div id=\"tasks-list\" style=\"display:flex; flex-direction:column; gap:10px;\"></div>\n        </div>\n    </div>\n\n    <!-- 4. SUPERMARKET MODAL -->\n    <div class=\"modal-overlay\" id=\"shop-modal\">\n        <div class=\"modal-content pixel-box\" style=\"background:linear-gradient(180deg,#FFFDF2 0%,#FEF5E7 100%); border-color:#D35400;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#E67E22,#D35400); color:#FFF; margin:-16px -16px 12px -16px; padding:12px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #2C3E50;\">\n                <h2 id=\"shop-modal-title\" style=\"color:#FFF; text-shadow:1px 1px 0 #7E5109;\">🏪 Siêu Thị Gia Đình B2KS — Khu Mua Sắm</h2>\n                <button class=\"btn btn-sm\" style=\"background:#FFF; color:#D35400;\" onclick=\"closeModal('shop-modal')\">✖ Đóng</button>\n            </div>\n            <div id=\"shop-npc-banner\" style=\"background:#FFF; border:2.5px solid #F39C12; border-radius:12px; padding:10px 12px; margin-bottom:10px; font-size:13px; display:flex; align-items:center; gap:10px; box-shadow:0 3px 0 rgba(243,156,18,0.25);\">\n                <span style=\"font-size:28px; background:#FEF9E7; padding:6px; border-radius:50%; border:2px solid #F39C12;\">👩‍💼</span>\n                <div>\n                    <div style=\"font-weight:700; color:#D35400;\">Quầy Thu Ngân • Cô Linh</div>\n                    <div id=\"shop-npc-greeting\">&ldquo;Chào mừng quý khách tới Siêu Thị B2KS! Chọn kệ hàng bên dưới để đổi điểm lấy nội thất phòng &amp; thẻ xem YouTube nhé! (Đặc quyền ngoài đời hãy ghé <b>🌌 Trung Tâm Xuyên Thế Giới</b>)&rdquo;</div>\n                </div>\n            </div>\n            <div class=\"room-tabs\" style=\"margin-bottom:12px; background:#FDEBD0; padding:6px; border-radius:10px; border:2px solid #E67E22;\">\n                <button class=\"btn btn-sm btn-accent\" onclick=\"renderShop('decor')\">🛋️ Kệ Nội Thất Phòng</button>\n                <button class=\"btn btn-sm btn-danger\" onclick=\"renderShop('tv_card')\">📺 Quầy Thẻ YouTube</button>\n            </div>\n            <div id=\"shop-items-grid\" class=\"grid-2\"></div>\n        </div>\n    </div>\n\n    <!-- 4B. PERSONAL BAG / INVENTORY MODAL -->\n    <div class=\"modal-overlay\" id=\"bag-modal\">\n        <div class=\"modal-content pixel-box\">\n            <div class=\"modal-header\">\n                <h2>🎒 Túi Đồ Cá Nhân (<span id=\"bag-owner-name\"></span>)</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('bag-modal')\">Đóng</button>\n            </div>\n            <div class=\"room-tabs\" style=\"margin-bottom:12px;\">\n                <button class=\"btn btn-sm btn-accent\" onclick=\"renderBagModal('decor')\">🛋️ Đồ trang trí</button>\n                <button class=\"btn btn-sm btn-purple\" onclick=\"renderBagModal('lab')\">🧪 Vật phẩm chế tạo</button>\n                <button class=\"btn btn-sm btn-danger\" onclick=\"renderBagModal('tv_card')\">📺 Thẻ YouTube</button>\n                <button class=\"btn btn-sm btn-primary\" onclick=\"renderBagModal('outfit')\">👗 Trang phục</button>\n                <button class=\"btn btn-sm\" style=\"background:#E67E22;\" onclick=\"renderBagModal('voucher')\">🎟️ Phiếu quà</button>\n            </div>\n            <div id=\"bag-items-grid\" class=\"grid-2\"></div>\n        </div>\n    </div>\n\n    <!-- 4C. FASHION BOUTIQUE MODAL -->\n    <div class=\"modal-overlay\" id=\"fashion-modal\">\n        <div class=\"modal-content pixel-box\" style=\"background:linear-gradient(180deg,#FFF5F8 0%,#FCE4EC 100%); border-color:#C2185B;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#EC407A,#AD1457); color:#FFF; margin:-16px -16px 12px -16px; padding:12px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #2C3E50;\">\n                <h2 id=\"fashion-modal-title\" style=\"color:#FFF;\">👗 B2KS Fashion Boutique &amp; Sàn Thử Đồ</h2>\n                <button class=\"btn btn-sm\" style=\"background:#FFF; color:#AD1457;\" onclick=\"closeFashionModal()\">✖ Đóng</button>\n            </div>\n            <div style=\"display:flex; gap:12px; align-items:center; background:#FFF; border:2.5px solid #E91E63; border-radius:14px; padding:10px; margin-bottom:10px; flex-wrap:wrap; box-shadow:0 4px 10px rgba(233,30,99,0.12);\">\n                <div style=\"text-align:center; margin:0 auto;\">\n                    <div style=\"padding:4px; background:linear-gradient(135deg,#F8BBD0,#F48FB1); border-radius:12px;\">\n                        <canvas id=\"fashion-tryon-canvas\" width=\"104\" height=\"120\" style=\"width:104px; height:120px; background:#FFF; border-radius:9px; border:2.5px solid #880E4F;\"></canvas>\n                    </div>\n                    <div id=\"fashion-tryon-status\" style=\"font-size:11px; font-weight:700; color:#AD1457; margin-top:4px;\">🪞 Gương Soi Thời Trang</div>\n                </div>\n                <div style=\"flex:1; min-width:200px; font-size:12.5px; line-height:1.45;\">\n                    <div><span style=\"font-size:20px;\">💃</span> <b style=\"color:#AD1457;\">Nhà Thiết Kế Vy:</b> &ldquo;Bấm <b>👀 Try on</b> để ướm thử lên gương trước khi đổi điểm nhé! Đồ mua xong sẽ tự động treo trong <b>Tủ quần áo phòng riêng</b>.&rdquo;</div>\n                    <div id=\"fashion-tryon-controls\" style=\"margin-top:8px; display:flex; gap:6px; flex-wrap:wrap; align-items:center;\">\n                        <span class=\"tag\" style=\"background:#FCE4EC; border-color:#E91E63;\">Đang mặc trang phục hiện tại</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"room-tabs\" style=\"margin-bottom:12px; background:#F8BBD0; padding:6px; border-radius:10px;\">\n                <button class=\"btn btn-sm\" id=\"fashion-tab-set\" style=\"background:#C2185B;\" onclick=\"renderFashionStore('set')\">👔 Bộ Set Đầy Đủ</button>\n                <button class=\"btn btn-sm\" id=\"fashion-tab-shirt\" style=\"background:#E91E63;\" onclick=\"renderFashionStore('shirt')\">👕 Áo Riêng</button>\n                <button class=\"btn btn-sm\" id=\"fashion-tab-pants\" style=\"background:#3B82F6;\" onclick=\"renderFashionStore('pants')\">👖 Quần &amp; Váy</button>\n                <button class=\"btn btn-sm btn-accent\" id=\"fashion-tab-hat\" onclick=\"renderFashionStore('hat')\">🧢 Mũ &amp; Vương Miện</button>\n                <button class=\"btn btn-sm btn-purple\" id=\"fashion-tab-acc\" onclick=\"renderFashionStore('acc')\">🕶️ Phụ Kiện</button>\n            </div>\n            <div id=\"fashion-items-grid\" class=\"grid-2\"></div>\n        </div>\n    </div>\n\n    <!-- 4D. HAIR SALON MODAL -->\n    <div class=\"modal-overlay\" id=\"salon-modal\">\n        <div class=\"modal-content pixel-box\" style=\"background:linear-gradient(180deg,#FAF5FF 0%,#EDE7F6 100%); border-color:#6C3483;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#8E44AD,#5B2C6F); color:#FFF; margin:-16px -16px 12px -16px; padding:12px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #2C3E50;\">\n                <h2 id=\"salon-modal-title\" style=\"color:#FFF;\">💇 B2KS Hair Studio &amp; Nhuộm Nghệ Thuật</h2>\n                <button class=\"btn btn-sm\" style=\"background:#FFF; color:#6C3483;\" onclick=\"closeModal('salon-modal')\">✖ Đóng</button>\n            </div>\n            <div style=\"background:#FFF; border:2px solid #9B59B6; border-radius:12px; padding:8px 12px; margin-bottom:10px; font-size:13px; display:flex; align-items:center; gap:10px;\">\n                <span style=\"font-size:26px;\">💇‍♂️</span>\n                <div><b style=\"color:#6C3483;\">Hair Stylist Tuấn Anh:</b> &ldquo;Ngồi vào ghế gương tạo kiểu nào! Cắt tạo kiểu mới (<b>15⭐</b>) hoặc nhuộm màu thời trang (<b>10⭐</b>) ngay tại Studio!&rdquo;</div>\n            </div>\n            <div style=\"display:flex; gap:14px; align-items:center; background:#FFF; padding:10px; border-radius:12px; border:2.5px solid #8E44AD; margin-bottom:12px; flex-wrap:wrap;\">\n                <canvas id=\"salon-preview-canvas\" width=\"100\" height=\"115\" style=\"width:100px; height:115px; background:#F5EEF8; border-radius:10px; border:2px solid #6C3483; margin:0 auto;\"></canvas>\n                <div style=\"flex:1; min-width:200px; font-size:13px;\">\n                    <div><b>Hóa đơn dịch vụ ghế cắt:</b> <span class=\"points-pill\" id=\"salon-cost-pill\">0⭐</span></div>\n                    <div style=\"color:#555; margin-top:4px;\">• Cắt &amp; Tạo kiểu tóc mới: <b>15⭐</b><br>• Nhuộm màu tóc mới: <b>10⭐</b></div>\n                    <button class=\"btn btn-purple\" style=\"margin-top:8px; width:100%;\" onclick=\"confirmSalonChange()\">✂️ Thanh toán &amp; Tạo kiểu ngay</button>\n                </div>\n            </div>\n            <div class=\"form-group\" style=\"background:#FFF; padding:10px; border-radius:10px; border:2px solid #D2B4DE;\">\n                <label style=\"color:#6C3483;\">1. Bảng Mẫu Kiểu Tóc (15⭐ nếu thay đổi):</label>\n                <div class=\"visual-grid\" id=\"salon-hair-grid\"></div>\n            </div>\n            <div class=\"form-group\" style=\"background:#FFF; padding:10px; border-radius:10px; border:2px solid #D2B4DE;\">\n                <label style=\"color:#6C3483;\">2. Bảng Thuốc Nhuộm Thời Thượng (10⭐ nếu thay đổi):</label>\n                <div class=\"swatch-grid\" id=\"salon-haircolor-grid\"></div>\n            </div>\n        </div>\n    </div>\n\n    <!-- 4F. ENGLISH CENTER GLOBAL SUCCESS 6-9 QUIZ MODAL -->\n    <div class=\"modal-overlay\" id=\"english-center-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:650px; background:linear-gradient(180deg,#F4FBF9 0%,#E8F6F3 100%); border-color:#117864;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#16A085,#0E6251); color:#FFF; margin:-16px -16px 12px -16px; padding:12px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #2C3E50;\">\n                <h2 id=\"english-modal-title\" style=\"color:#FFF;\">🎓 B2KS English Academy — Global Success (Lớp 6–9)</h2>\n                <button class=\"btn btn-sm\" style=\"background:#FFF; color:#0E6251;\" onclick=\"closeModal('english-center-modal')\">✖ Đóng</button>\n            </div>\n            <div style=\"background:#1E4620; color:#ECF0F1; border:4px solid #8D6E63; border-radius:12px; padding:12px 14px; margin-bottom:12px; font-size:13px; display:flex; align-items:center; gap:12px; box-shadow:inset 0 0 12px rgba(0,0,0,0.35);\">\n                <span style=\"font-size:30px;\">👩‍🏫</span>\n                <div>\n                    <div style=\"color:#F9E79F; font-weight:700; margin-bottom:2px;\">CHALKBOARD • MS. MAI'S CLASSROOM (GLOBAL SUCCESS 6–9)</div>\n                    <div>&ldquo;Chọn lớp bên dưới để làm bài kiểm tra 10 câu (5 Từ vựng + 5 Ngữ pháp) theo Unit hiện tại! Đạt <b>&gt;8 điểm (9–10/10) 3 lần liên tiếp</b> để mở khóa Unit tiếp theo nhé!&rdquo;</div>\n                </div>\n            </div>\n            <div id=\"eng-topic-bar\" style=\"display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; background:#D1F2EB; padding:8px; border-radius:10px; border:2px solid #16A085;\"></div>\n            <div id=\"eng-quiz-body\"></div>\n        </div>\n    </div>\n\n    <!-- 4G. MULTIPLAYER ONLINE ARCADE ZONE MODAL -->\n    <div class=\"modal-overlay\" id=\"arcade-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:720px; background:linear-gradient(180deg,#1B2631 0%,#212F3D 100%); color:#ECF0F1; border-color:#F39C12;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#C0392B,#D35400); color:#FFF; margin:-16px -16px 12px -16px; padding:12px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #F1C40F;\">\n                <h2 style=\"display:flex; align-items:center; gap:8px; flex-wrap:wrap; color:#FFF;\"><span id=\"arcade-modal-title\">🕹️ B2KS eSports &amp; Arcade Arena</span> <span id=\"arcade-online-badge\" class=\"tag\" style=\"background:#27AE60; color:#FFF; font-size:11px;\">🟢 ONLINE</span></h2>\n                <button class=\"btn btn-sm\" style=\"background:#F1C40F; color:#2C3E50;\" onclick=\"closeArcadeModal()\">✖ Đóng</button>\n            </div>\n            <div id=\"arcade-dynamic-container\" style=\"color:#2C3E50; background:#FDFEFE; border-radius:12px; padding:10px;\"></div>\n        </div>\n    </div>\n\n    <!-- 4H. B2KS INVENTION & FUSION LAB MODAL -->\n    <div class=\"modal-overlay\" id=\"invention-lab-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:700px; background:linear-gradient(180deg,#0F172A 0%,#1E293B 100%); color:#F8FAFC; border:3px solid #38BDF8;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#0284C7,#0D9488); color:#FFF; margin:-16px -16px 12px -16px; padding:12px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #38BDF8;\">\n                <h2 style=\"color:#FFF; display:flex; align-items:center; gap:8px;\"><span id=\"lab-modal-title\">🧪 Phòng Thí Nghiệm Sáng Tạo B2KS</span> <span class=\"tag\" style=\"background:#0F172A; color:#38BDF8; border-color:#38BDF8;\">PRO LAB v2</span></h2>\n                <button class=\"btn btn-sm\" style=\"background:#FFF; color:#0F172A;\" onclick=\"closeModal('invention-lab-modal')\">✖ Đóng</button>\n            </div>\n\n            <div style=\"background:rgba(15,23,42,0.85); border:2px solid #0EA5E9; border-radius:12px; padding:10px 12px; margin-bottom:12px; font-size:13px; display:flex; align-items:center; gap:10px;\">\n                <span style=\"font-size:28px;\">🤖</span>\n                <div>\n                    <div style=\"font-weight:700; color:#38BDF8;\">Giáo Sư Robot Neo (Phiên bản nâng cấp 30+ hình thái):</div>\n                    <div style=\"color:#E2E8F0;\">&ldquo;Nhập bất kỳ ý tưởng Tiếng Anh nào (kết hợp chất liệu, sinh vật, vũ khí, nội thất, hào quang...) để tạo vật phẩm độc bản hoàn toàn khác biệt!&rdquo;</div>\n                </div>\n            </div>\n\n            <div class=\"room-tabs\" style=\"margin-bottom:12px; background:#0F172A; padding:6px; border-radius:10px; border:1.5px solid #334155;\">\n                <button class=\"btn btn-sm\" id=\"lab-tab-prompt-btn\" style=\"background:#0284C7;\" onclick=\"switchInventionLabMode('prompt')\">✨ Chế tạo từ Tiếng Anh (10⭐)</button>\n                <button class=\"btn btn-sm\" id=\"lab-tab-fusion-btn\" style=\"background:#475569;\" onclick=\"switchInventionLabMode('fusion')\">🧬 Hợp nhất 2 Vật Phẩm (15⭐)</button>\n            </div>\n\n            <div id=\"lab-fusion-panel\" style=\"display:none; background:#0F172A; border:2px dashed #38BDF8; border-radius:12px; padding:10px; margin-bottom:12px;\">\n                <div style=\"font-size:12.5px; font-weight:700; color:#38BDF8; margin-bottom:4px;\">🔬 Chọn 2 vật phẩm nguyên liệu đang có sẵn trong túi đồ để lai ghép:</div>\n                <div style=\"font-size:11.5px; color:#FBBF24; background:rgba(245, 158, 11, 0.14); border:1px solid rgba(251, 191, 36, 0.45); border-radius:8px; padding:6px 8px; margin-bottom:8px;\">\n                    ⚠️ <b>Lưu ý:</b> Sau khi hợp nhất thành công, <b>2 vật phẩm nguyên liệu này sẽ mất đi</b> để tạo thành vật phẩm mới!\n                </div>\n                <div id=\"lab-fusion-empty-msg\" style=\"display:none; font-size:12px; color:#FCA5A5; background:rgba(239, 68, 68, 0.14); border:1px solid rgba(248, 113, 113, 0.45); border-radius:8px; padding:8px; margin-bottom:4px;\">\n                    🎒 Bạn cần có ít nhất <b>2 vật phẩm khả dụng trong túi đồ</b> để thực hiện hợp nhất!\n                </div>\n                <div id=\"lab-fusion-selectors\" style=\"display:grid; grid-template-columns:1fr auto 1fr; gap:8px; align-items:center;\">\n                    <div>\n                        <label style=\"font-size:11.5px; color:#94A3B8; display:block; margin-bottom:4px;\">Nguyên liệu A (Dáng chính):</label>\n                        <select id=\"lab-item-a\" onchange=\"syncLabFusionDropdowns('a')\" style=\"width:100%; padding:7px; border-radius:8px; border:2px solid #0284C7; background:#1E293B; color:#FFF; font-weight:600;\"></select>\n                    </div>\n                    <div style=\"font-size:22px; font-weight:700; color:#38BDF8; padding-top:16px;\">➕</div>\n                    <div>\n                        <label style=\"font-size:11.5px; color:#94A3B8; display:block; margin-bottom:4px;\">Nguyên liệu B (Đặc tính lai):</label>\n                        <select id=\"lab-item-b\" onchange=\"syncLabFusionDropdowns('b')\" style=\"width:100%; padding:7px; border-radius:8px; border:2px solid #0D9488; background:#1E293B; color:#FFF; font-weight:600;\"></select>\n                    </div>\n                </div>\n            </div>\n\n            <div id=\"lab-prompt-panel\" style=\"background:#0F172A; border:2px solid #334155; border-radius:12px; padding:12px; margin-bottom:12px;\">\n                <label style=\"display:block; font-size:13px; font-weight:700; color:#7DD3FC; margin-bottom:6px;\">\n                    ✍️ Nhập dòng lệnh mô tả bằng Tiếng Anh (hỗ trợ ô tô có cánh, tàu hỏa, tên lửa, rồng, robot, kích thước...):\n                </label>\n                <div style=\"display:flex; gap:8px; flex-wrap:wrap;\">\n                    <input type=\"text\" id=\"lab-english-prompt\" placeholder=\"Ví dụ: a golden car with two rainbow wings...\" style=\"flex:1; min-width:210px; padding:9px 12px; border-radius:9px; border:2px solid #38BDF8; background:#1E293B; color:#FFF; font-size:13.5px;\" onkeypress=\"if(event.key==='Enter') runInventionLabSynthesis()\">\n                    <select id=\"lab-size-select\" title=\"Chọn kích thước vật phẩm trong phòng\" style=\"padding:8px 10px; border-radius:9px; border:2px solid #38BDF8; background:#1E293B; color:#FFF; font-weight:700; font-size:12.5px;\">\n                        <option value=\"auto\">📏 Cỡ: Tự động</option>\n                        <option value=\"small\">🔹 Nhỏ (Small)</option>\n                        <option value=\"medium\">🔸 Vừa (Medium)</option>\n                        <option value=\"large\">🔶 Lớn (Large)</option>\n                        <option value=\"giant\">💥 Khổng Lồ (Giant)</option>\n                    </select>\n                    <button class=\"btn\" style=\"background:linear-gradient(90deg,#0284C7,#10B981); padding:9px 16px;\" onclick=\"runInventionLabSynthesis()\" id=\"lab-synthesize-btn\">⚡ Chế tạo (10⭐)</button>\n                </div>\n                <div style=\"margin-top:8px; display:flex; gap:6px; flex-wrap:wrap; align-items:center;\">\n                    <span style=\"font-size:11.5px; color:#94A3B8;\">💡 Thử nhiều mẫu:</span>\n                    <button type=\"button\" class=\"btn btn-sm\" style=\"background:#0F766E; font-size:11px; padding:3px 8px;\" onclick=\"pickRandomLabIdea()\">🎲 Ý tưởng ngẫu nhiên</button>\n                    <button type=\"button\" class=\"btn btn-sm\" style=\"background:#334155; font-size:11px; padding:3px 7px;\" onclick=\"fillLabSamplePrompt('a golden sports car with two rainbow wings')\">🚗 Car With 2 Wings</button>\n                    <button type=\"button\" class=\"btn btn-sm\" style=\"background:#334155; font-size:11px; padding:3px 7px;\" onclick=\"fillLabSamplePrompt('a giant cyber robot dinosaur with dragon wings')\">🦖 Giant Winged Dino</button>\n                    <button type=\"button\" class=\"btn btn-sm\" style=\"background:#334155; font-size:11px; padding:3px 7px;\" onclick=\"fillLabSamplePrompt('a large crystal volcano guitar with fire stars')\">🎸 Large Volcano Guitar</button>\n                </div>\n            </div>\n\n            <div id=\"lab-fusion-action-bar\" style=\"display:none; margin-bottom:12px; text-align:center;\">\n                <button class=\"btn\" style=\"width:100%; padding:11px 18px; font-size:14.5px; background:linear-gradient(90deg,#0D9488,#0284C7,#6366F1); border:2px solid #7DD3FC; box-shadow:0 4px 14px rgba(14,165,233,0.4);\" onclick=\"runInventionLabSynthesis()\" id=\"lab-fusion-submit-btn\">🧬 Hợp nhất 2 Vật Phẩm Ngay (15⭐)</button>\n            </div>\n\n            <div id=\"lab-result-area\"></div>\n        </div>\n    </div>\n\n    <!-- 4E. PRIVATE ROOM FLOATING TOOLBAR & DECOR PICKER -->\n    <div id=\"private-room-toolbar\" style=\"display:none; position:fixed; top:86px; left:50%; transform:translateX(-50%); z-index:92; padding:4px 8px; gap:6px; align-items:center; flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; max-width:calc(100vw - 16px); height:36px; border-radius:999px; background:#FFFFFF; border:2px solid #0F172A; box-shadow:0 4px 0 #0F172A; white-space:nowrap;\">\n        <span id=\"pr-room-badge\" style=\"font-weight:700; font-size:11.5px; color:#0F172A; flex-shrink:0;\">🛏️ Phòng</span>\n        <button type=\"button\" id=\"pr-privacy-btn\" onclick=\"togglePrivateRoomLockFromToolbar()\" style=\"display:inline-flex; align-items:center; gap:4px; font-weight:700; font-size:11px; cursor:pointer; background:#FEE2E2; border:1.5px solid #DC2626; padding:2px 9px; border-radius:999px; flex-shrink:0; height:25px; color:#991B1B;\">🔒 Khóa</button>\n        <select id=\"pr-wall-select\" onchange=\"changePrivateRoomWallFromToolbar()\" style=\"padding:2px 8px; border:1.5px solid #0284C7; border-radius:999px; font-weight:700; font-size:11px; background:#E0F2FE; color:#0C4A6E; height:25px; flex-shrink:0;\">\n            <option value=\"#FADBD8\">🎨 Hồng</option>\n            <option value=\"#D6EAF8\">🎨 Xanh trời</option>\n            <option value=\"#FCF3CF\">🎨 Vàng kem</option>\n            <option value=\"#EBDEF0\">🎨 Tím nhạt</option>\n            <option value=\"#D5F5E3\">🎨 Bạc hà</option>\n        </select>\n        <button type=\"button\" id=\"pr-decor-manage-btn\" onclick=\"openPrivateRoomSlotOverview()\" style=\"display:none; align-items:center; gap:4px; font-weight:700; font-size:11px; cursor:pointer; background:#FEF3C7; border:1.5px solid #D97706; padding:2px 9px; border-radius:999px; flex-shrink:0; height:25px; color:#92400E;\">📌 Slot (0/16)</button>\n        <button class=\"btn btn-primary btn-sm\" style=\"padding:2px 10px; font-size:11px; height:25px; border-radius:999px; border:1.5px solid #0F172A; box-shadow:none; flex-shrink:0;\" onclick=\"exitPrivateRoomToHallway()\">🚪 Ra</button>\n    </div>\n\n    <div class=\"modal-overlay\" id=\"slot-picker-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:440px;\">\n            <div class=\"modal-header\">\n                <h2 id=\"slot-picker-title\">📌 Trang Trí Vị Trí</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('slot-picker-modal')\">Đóng</button>\n            </div>\n            <div style=\"font-size:13px; margin-bottom:10px;\" id=\"pr-slot-instruction\">\n                Chọn vật phẩm trang trí từ túi đồ để đặt vào vị trí này:\n            </div>\n            <div id=\"pr-slot-items-bar\" style=\"display:flex; gap:8px; flex-wrap:wrap;\"></div>\n        </div>\n    </div>\n\n    <!-- 4F. LIVING ROOM YOUTUBE TV MODAL -->\n    <div class=\"modal-overlay\" id=\"tv-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:620px;\">\n            <div class=\"modal-header\">\n                <h2>📺 Tivi Thông Minh Phòng Khách (YouTube Kids &amp; Family)</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeTvModal()\">Tắt Tivi</button>\n            </div>\n            <div id=\"tv-status-bar\" style=\"display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; background:#EBF5FB; border:2px solid #2980B9; border-radius:10px; padding:8px 12px; margin-bottom:10px; font-size:13px;\">\n                <div id=\"tv-time-remaining\">⏳ Thời gian còn lại hôm nay: <b>30:00</b></div>\n                <div id=\"tv-card-action\"></div>\n            </div>\n            <div class=\"room-tabs\" style=\"margin-bottom:10px;\">\n                <button class=\"btn btn-sm btn-danger\" onclick=\"switchTvChannel('XqZsoesa55w', '🎵 Baby Shark & Nhạc Thiếu Nhi')\">🎵 Nhạc Vui Nhộn</button>\n                <button class=\"btn btn-sm btn-accent\" onclick=\"switchTvChannel('tVlcKp3bWH8', '🇬🇧 Hello Song - English Kids')\">🇬🇧 English Songs</button>\n                <button class=\"btn btn-sm btn-purple\" onclick=\"switchTvChannel('aqz-KE-bpKQ', '🎬 Phim Hoạt Hình 3D')\">🎬 Hoạt Hình 3D</button>\n                <a id=\"tv-external-yt-link\" href=\"https://www.youtube.com/watch?v=XqZsoesa55w\" target=\"_blank\" rel=\"noopener\" class=\"btn btn-sm\" style=\"background:#2C3E50; text-decoration:none;\">↗ Mở trên YouTube</a>\n            </div>\n            <div id=\"tv-screen-container\" style=\"position:relative; width:100%; aspect-ratio:16/9; background:#111; border:3px solid #2C3E50; border-radius:12px; overflow:hidden;\">\n                <iframe id=\"youtube-iframe\" width=\"100%\" height=\"100%\" src=\"\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\n            </div>\n            <div id=\"tv-local-hint\" style=\"display:none; background:#FEF9E7; border:1.5px solid #F39C12; border-radius:8px; padding:6px 10px; margin-top:8px; font-size:12px; color:#7E5109;\">\n                💡 Nếu mở file trực tiếp trên điện thoại mà khung video báo lỗi, hãy bấm nút <b>↗ Mở trên YouTube</b> ở trên hoặc mở game qua link <b>GitHub Pages</b>!\n            </div>\n        </div>\n    </div>\n\n    <!-- 5. VISUAL CUSTOMIZE CHARACTER, ROOM & HOUSE MODAL -->\n    <div class=\"modal-overlay\" id=\"custom-modal\">\n        <div class=\"modal-content pixel-box\">\n            <div class=\"modal-header\">\n                <h2>🎨 Tùy Chỉnh Nhân Vật, Nhà &amp; Phòng</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('custom-modal')\">Đóng</button>\n            </div>\n\n            <div class=\"room-tabs\" style=\"margin-bottom:14px;\">\n                <button class=\"btn btn-sm btn-accent\" onclick=\"switchCustomTab('char')\">🧑 Nhân vật &amp; Quần áo</button>\n                <button class=\"btn btn-sm btn-purple\" onclick=\"switchCustomTab('room')\">🛏️ Phòng riêng</button>\n                <button class=\"btn btn-sm btn-primary\" onclick=\"switchCustomTab('house')\">🏢 Nhà phố gia đình</button>\n            </div>\n\n            <div id=\"custom-tab-char\">\n                <div id=\"wardrobe-locked-banner\" style=\"display:none; background:#FDEDEC; border:2.5px solid #E74C3C; border-radius:10px; padding:12px; margin-bottom:12px; color:#922B21; font-size:13px; line-height:1.5;\">\n                    <div style=\"font-weight:700; font-size:14px; margin-bottom:4px;\">🔒 Tủ quần áo chưa được mở!</div>\n                    Hãy tự điều khiển nhân vật đi vào <b>Nhà phố ➔ Hành lang cầu thang ➔ Phòng riêng của mình</b> và bấm <b>🧥 Mở tủ quần áo</b> để thay đổi trang phục nhé!\n                </div>\n                <div id=\"wardrobe-controls-wrapper\">\n                <div style=\"display:flex; gap:14px; align-items:center; background:#EBF5FB; padding:12px; border-radius:12px; border:2.5px solid #2C3E50; margin-bottom:14px; flex-wrap:wrap;\">\n                    <div style=\"text-align:center; margin:0 auto;\">\n                        <canvas id=\"char-preview-canvas\" width=\"110\" height=\"125\" style=\"width:110px; height:125px; background:#FFF; border-radius:12px; border:2.5px solid #2C3E50;\"></canvas>\n                        <div style=\"font-size:11px; font-weight:700; color:#2C3E50; margin-top:3px;\">Xem trước</div>\n                    </div>\n                    <div style=\"flex:1; min-width:200px;\">\n                        <div class=\"form-group\">\n                            <label>Tên hiển thị:</label>\n                            <input type=\"text\" id=\"custom-char-name\" oninput=\"drawCharPreview()\">\n                        </div>\n                        <div class=\"form-group\" style=\"margin-bottom:0;\">\n                            <label>Mũ &amp; Phụ kiện trong tủ đồ:</label>\n                            <div id=\"visual-outfit-grid\" style=\"display:flex; gap:6px; flex-wrap:wrap;\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                <div style=\"background:#F5EEF8; border:1.5px solid #9B59B6; border-radius:8px; padding:7px 10px; margin-bottom:10px; font-size:12px; color:#5B2C6F;\">\n                    💇 <i>Muốn đổi kiểu tóc hoặc nhuộm màu tóc? Hãy ghé <b>Salon Tóc</b> trên khu phố nhé!</i>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>1. Chọn Set Trang Phục đã mua trong Tủ đồ:</label>\n                    <div class=\"visual-grid\" id=\"visual-fashion-set-grid\"></div>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>2. Phối Áo (Cơ bản &amp; Áo đã mua ở Boutique):</label>\n                    <div class=\"visual-grid\" id=\"visual-shirt-grid\"></div>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>3. Phối Quần / Váy (Cơ bản &amp; Đồ đã mua ở Boutique):</label>\n                    <div class=\"visual-grid\" id=\"visual-pants-grid\"></div>\n                </div>\n\n                <button class=\"btn btn-primary\" style=\"width:100%; justify-content:center; padding:10px; font-size:14px;\" onclick=\"saveCharCustom()\">💾 Lưu ngoại hình &amp; trang phục</button>\n                </div>\n            </div>\n\n            <div id=\"custom-tab-room\" style=\"display:none;\">\n                <div style=\"background:#EEF2F7; padding:10px; border-radius:8px; margin-bottom:12px;\">\n                    <label style=\"display:flex; align-items:center; gap:8px; font-weight:700; cursor:pointer;\">\n                        <input type=\"checkbox\" id=\"room-privacy-toggle\" onchange=\"toggleRoomPrivacy()\" style=\"width:18px; height:18px;\">\n                        🔓 Mở cửa phòng riêng (Cho phép thành viên khác bước vào)\n                    </label>\n                </div>\n                <div class=\"form-group\">\n                    <label>Màu tường phòng riêng:</label>\n                    <select id=\"room-wall-color\" onchange=\"changeRoomWall()\">\n                        <option value=\"#FADBD8\">Hồng phấn ấm áp</option>\n                        <option value=\"#D6EAF8\">Xanh bầu trời</option>\n                        <option value=\"#FCF3CF\">Vàng kem tươi sáng</option>\n                        <option value=\"#EBDEF0\">Tím Lavender</option>\n                        <option value=\"#D5F5E3\">Xanh bạc hà</option>\n                    </select>\n                </div>\n                <p style=\"font-size:13px;\"><b>🛋️ Đặt nội thất vào phòng riêng:</b> Bấm đặt vật phẩm tại vị trí nhân vật của bạn đang đứng trong phòng riêng:</p>\n                <div id=\"room-decor-inventory\" class=\"grid-2\"></div>\n            </div>\n\n            <div id=\"custom-tab-house\" style=\"display:none;\">\n                <div id=\"house-builder-locked\" style=\"color:red; font-weight:600; display:none;\">\n                    ⚠️ Chỉ có Bố hoặc Mẹ mới có quyền chọn vị trí xây nhà và kiểu dáng ngôi nhà!\n                </div>\n                <div id=\"house-builder-controls\">\n                    <div class=\"form-group\">\n                        <label>Vị trí lô đất trên đường phố:</label>\n                        <select id=\"house-plot-select\">\n                            <option value=\"0\">Lô số 1 (Khu Tây - Cạnh Công viên)</option>\n                            <option value=\"1\">Lô số 2 (Trung tâm Khu phố)</option>\n                            <option value=\"2\">Lô số 3 (Khu Đông - Cạnh Cửa hàng)</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label>Kiểu dáng Nhà Phố Gia Đình:</label>\n                        <select id=\"house-style-select\">\n                            <option value=\"modern\">🏢 Nhà Phố Hiện Đại (Tường kem, ban công kính)</option>\n                            <option value=\"classic\">🏛️ Nhà Phố Tân Cổ Điển (Mái ngói đỏ, cột trắng)</option>\n                            <option value=\"pastel\">🏡 Nhà Phố Pastel Xanh Mint Dễ Thương</option>\n                        </select>\n                    </div>\n                    <button class=\"btn btn-primary\" onclick=\"updateHouseDesign()\">🏗️ Cập nhật Nhà Phố Gia Đình</button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- 6. DONATE POINTS MODAL -->\n    <div class=\"modal-overlay\" id=\"donate-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:420px;\">\n            <div class=\"modal-header\">\n                <h2>🎁 Tặng Điểm Cho Thành Viên</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('donate-modal')\">Đóng</button>\n            </div>\n            <div class=\"form-group\">\n                <label>Chọn người nhận:</label>\n                <select id=\"donate-recipient\"></select>\n            </div>\n            <div class=\"form-group\">\n                <label>Số điểm muốn tặng (Bạn có: <span id=\"donate-avail\">0</span>⭐):</label>\n                <input type=\"number\" id=\"donate-amount\" value=\"10\" min=\"1\">\n            </div>\n            <div class=\"form-group\">\n                <label>Lời nhắn:</label>\n                <input type=\"text\" id=\"donate-note\" placeholder=\"VD: Thưởng con chăm ngoan!\">\n            </div>\n            <button class=\"btn btn-accent\" style=\"width:100%; justify-content:center;\" onclick=\"sendDonation()\">💸 Chuyển điểm ngay</button>\n        </div>\n    </div>\n\n    <!-- 7. HOMEWORK SUBMISSION & GRADING MODAL -->\n    <div class=\"modal-overlay\" id=\"hw-action-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:500px;\">\n            <div class=\"modal-header\">\n                <h2 id=\"hw-modal-title\">📚 Chi tiết Bài tập</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('hw-action-modal')\">Đóng</button>\n            </div>\n            <div id=\"hw-modal-body\"></div>\n        </div>\n    </div>\n\n    <!-- 8. PASSCODE GATE MODAL -->\n    <div class=\"modal-overlay\" id=\"pin-modal\" style=\"z-index:260;\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:340px; text-align:center;\">\n            <div class=\"modal-header\">\n                <h2>🔐 Passcode Phụ Huynh</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('pin-modal')\">Hủy</button>\n            </div>\n            <p style=\"font-size:12.5px; color:#555; margin-top:0;\">Vui lòng nhập mã PIN 4 số của Bố/Mẹ để tiếp tục:</p>\n            <div id=\"pin-display-box\" style=\"font-size:26px; font-weight:700; letter-spacing:10px; background:#EBF5FB; border:2.5px solid #2C3E50; border-radius:10px; padding:8px; margin:10px 0;\">____</div>\n            <div style=\"display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; max-width:240px; margin:0 auto;\">\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('1')\">1</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('2')\">2</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('3')\">3</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('4')\">4</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('5')\">5</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('6')\">6</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('7')\">7</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('8')\">8</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('9')\">9</button>\n                <button type=\"button\" class=\"btn btn-danger\" style=\"font-size:16px; padding:10px;\" onclick=\"clearPinDigit()\">⌫</button>\n                <button type=\"button\" class=\"btn btn-accent\" style=\"font-size:18px; padding:10px;\" onclick=\"pressPinDigit('0')\">0</button>\n                <button type=\"button\" class=\"btn btn-primary\" style=\"font-size:15px; padding:10px;\" onclick=\"verifyPin()\">OK</button>\n            </div>\n            <div id=\"pin-reset-container\" style=\"margin-top:12px; display:none;\">\n                <button type=\"button\" style=\"background:none; border:none; color:#7F8C8D; text-decoration:underline; font-size:11.5px; cursor:pointer;\" onclick=\"resetPinToDefault()\">Quên PIN? Khôi phục mặc định</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- 9. FAMILY SYNC & DEVICE LOCK MODAL -->\n    <div class=\"modal-overlay\" id=\"family-sync-modal\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:540px;\">\n            <div class=\"modal-header\">\n                <h2>🔗 Kết Nối Gia Đình &amp; Khóa PIN Thiết Bị</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('family-sync-modal')\">Đóng</button>\n            </div>\n\n            <div style=\"background:#FDEDEC; border:2px solid #E74C3C; border-radius:10px; padding:10px; margin-bottom:12px;\">\n                <div style=\"font-weight:700; font-size:14px; color:#922B21; margin-bottom:4px;\">🔒 Khóa cố định thiết bị này cho nhân vật hiện tại</div>\n                <div style=\"font-size:12px; color:#78281F; margin-bottom:8px;\">\n                    Đang điều khiển: <b id=\"sync-cur-member-label\">Bố</b>. Khi bật khóa máy (dùng cho điện thoại của <b>các con</b>), máy sẽ luôn giữ nhân vật đó và yêu cầu mã PIN nếu bấm Đổi người hoặc mở Bảng Phụ Huynh.\n                </div>\n                <button type=\"button\" id=\"btn-toggle-device-lock\" class=\"btn btn-danger\" style=\"width:100%;\" onclick=\"toggleDeviceLock()\">\n                    🔒 Bật Khóa Máy Cho Nhân Vật Này\n                </button>\n            </div>\n\n            <div style=\"background:#FEF9E7; border:2px solid #F39C12; border-radius:10px; padding:10px; margin-bottom:12px;\">\n                <div style=\"font-weight:700; font-size:13.5px; margin-bottom:6px;\">🔑 Đổi mã PIN Phụ huynh <span id=\"current-pin-label\" style=\"color:#D35400;\"></span></div>\n                <div style=\"display:flex; gap:6px;\">\n                    <input type=\"password\" inputmode=\"numeric\" pattern=\"[0-9]*\" id=\"new-pin-input\" maxlength=\"4\" placeholder=\"Nhập 4 chữ số PIN mới...\" style=\"flex:1; padding:6px; border:2px solid #2C3E50; border-radius:6px;\">\n                    <button type=\"button\" class=\"btn btn-primary\" onclick=\"changeParentPin()\">Lưu PIN</button>\n                </div>\n            </div>\n\n            <div style=\"background:#EBF5FB; border:2px solid #2980B9; border-radius:10px; padding:10px; margin-bottom:12px;\">\n                <div style=\"font-weight:700; font-size:13.5px; color:#1B4F72; margin-bottom:4px;\">☁️ Đồng bộ tự động các máy qua Firebase (Map chung thời gian thực)</div>\n                <div style=\"font-size:12px; color:#21618C; margin-bottom:6px;\">\n                    Nhập chung 1 link <b>Firebase Realtime Database</b> trên các điện thoại để bố, mẹ và các con thấy nhau đi lại ngoài khu phố &amp; trong nhà, đồng bộ điểm sao và nhiệm vụ tự động:\n                </div>\n                <div style=\"display:flex; gap:6px;\">\n                    <input type=\"text\" id=\"firebase-url-input\" placeholder=\"https://family-home-default-rtdb.firebaseio.com\" style=\"flex:1; padding:6px; border:2px solid #2C3E50; border-radius:6px;\">\n                    <button type=\"button\" class=\"btn btn-accent\" onclick=\"saveFirebaseUrl()\">Kết nối</button>\n                </div>\n                <div id=\"firebase-status-text\" style=\"font-size:11.5px; color:#555; margin-top:6px;\">Trạng thái: Đang lưu cục bộ trên máy này</div>\n            </div>\n\n            <div style=\"background:#EAFAF1; border:2px solid #27AE60; border-radius:10px; padding:10px;\">\n                <div style=\"font-weight:700; font-size:13.5px; color:#145A32; margin-bottom:6px;\">📋 Hoặc chia sẻ nhanh dữ liệu qua Mã Gia Đình</div>\n                <button type=\"button\" class=\"btn\" style=\"background:#27AE60; width:100%; margin-bottom:6px;\" onclick=\"exportFamilyCode()\">📤 Copy Mã Dữ Liệu Gia Đình</button>\n                <div style=\"display:flex; gap:6px;\">\n                    <input type=\"text\" id=\"import-code-input\" placeholder=\"Dán mã dữ liệu từ máy kia...\" style=\"flex:1; padding:6px; border:2px solid #2C3E50; border-radius:6px;\">\n                    <button type=\"button\" class=\"btn btn-primary\" onclick=\"importFamilyCode()\">Nạp</button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- 10. CHARACTER SMARTPHONE MODAL -->\n    <div class=\"modal-overlay\" id=\"smartphone-modal\" style=\"z-index:220;\">\n        <div class=\"phone-frame\">\n            <div class=\"phone-notch\"><span></span></div>\n            <div class=\"phone-screen\">\n                <div class=\"phone-status-bar\">\n                    <span id=\"phone-status-time\">☀️ 13:00</span>\n                    <span id=\"phone-carrier-label\">📶 B2KS-5G 🔋100%</span>\n                </div>\n                <div id=\"phone-screen-body\" style=\"flex:1; overflow-y:auto; padding:12px; display:flex; flex-direction:column;\"></div>\n                <div class=\"phone-home-bar\" style=\"background:rgba(255,255,255,0.85); border-top:1px solid #D5D8DC; gap:14px; align-items:center;\">\n                    <button type=\"button\" class=\"btn btn-sm\" style=\"background:#34495E; padding:3px 10px; font-size:11px;\" onclick=\"switchSmartphoneView('home')\">🏠 Màn hình chính</button>\n                    <button type=\"button\" class=\"btn btn-sm btn-danger\" style=\"padding:3px 10px; font-size:11px;\" onclick=\"closeModal('smartphone-modal')\">✖ Đóng máy</button>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- 11. DINING ROOM ENGLISH FOOD PUZZLE MODAL -->\n    <div class=\"modal-overlay\" id=\"dining-puzzle-modal\" style=\"z-index:215;\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:460px; text-align:center;\">\n            <div class=\"modal-header\">\n                <h2>🍽️ Bữa Ăn &amp; Đố Vui Tiếng Anh</h2>\n                <button class=\"btn btn-primary btn-sm\" onclick=\"closeModal('dining-puzzle-modal')\">Đóng</button>\n            </div>\n            <div id=\"dining-puzzle-body\"></div>\n        </div>\n    </div>\n\n    <!-- 12. FREE B2KS SOCCER STADIUM MINI-GAME MODAL (1P + 2P ONLINE + SPECTATOR) -->\n    <div class=\"modal-overlay\" id=\"soccer-modal\" style=\"z-index:225;\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:610px; background:linear-gradient(180deg,#ECFDF5 0%,#D1FAE5 100%); border-color:#065F46;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#15803D,#047857); color:#FFF; margin:-16px -16px 10px -16px; padding:11px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #2C3E50;\">\n                <h2 id=\"soccer-modal-title\" style=\"color:#FFF;\">⚽ Sân Bóng Đá B2KS (Miễn Phí 0⭐)</h2>\n                <button class=\"btn btn-sm\" style=\"background:#FFF; color:#065F46;\" onclick=\"closeSoccerModal()\">✖ Đóng</button>\n            </div>\n\n            <div class=\"room-tabs\" style=\"margin-bottom:8px; background:#A7F3D0; padding:6px; border-radius:10px; border:2px solid #059669;\">\n                <button type=\"button\" id=\"soccer-mode-1p-btn\" class=\"btn btn-sm\" style=\"background:#15803D;\" onclick=\"switchSoccerToSolo()\">🤖 Đấu 1 Người (vs AI)</button>\n                <button type=\"button\" id=\"soccer-mode-2p-btn\" class=\"btn btn-sm\" style=\"background:#64748B;\" onclick=\"switchSoccerTo2P()\">👥 Đấu 2 Người Online</button>\n                <button type=\"button\" id=\"soccer-mode-spec-btn\" class=\"btn btn-sm\" style=\"background:#DC2626; display:none;\" onclick=\"spectateSoccerMatch()\">📺 Xem Trực Tiếp</button>\n            </div>\n\n            <div style=\"display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; background:#FFF; border:2.5px solid #065F46; border-radius:12px; padding:8px 12px; margin-bottom:8px;\">\n                <div id=\"soccer-scoreboard\" style=\"font-size:14px; font-weight:700;\">⚽ 0 — 0</div>\n                <div style=\"display:flex; gap:8px; align-items:center;\">\n                    <span id=\"soccer-timer\" class=\"points-pill\" style=\"font-size:13px; padding:3px 9px;\">⏱️ 45s</span>\n                    <button type=\"button\" id=\"soccer-restart-btn\" class=\"btn btn-sm btn-accent\" onclick=\"restartSoccerMatch()\">🔄 Đá lại</button>\n                </div>\n            </div>\n\n            <div id=\"soccer-status-text\" style=\"font-size:12px; font-weight:600; text-align:center; margin-bottom:8px; color:#1E293B;\">\n                🆓 Đá Solo 0⭐ • Rê bóng vượt hậu vệ &amp; bấm ⚡ Sút vào lưới!\n            </div>\n\n            <div id=\"soccer-2p-lobby\" style=\"display:none; background:#FFF; border:2.5px solid #0284C7; border-radius:12px; padding:10px; margin-bottom:10px;\"></div>\n\n            <div id=\"soccer-pitch-wrap\" style=\"display:flex; justify-content:center; margin-bottom:10px;\">\n                <canvas id=\"soccer-canvas\" width=\"520\" height=\"360\" style=\"width:100%; max-width:520px; height:auto; aspect-ratio:520/360; border:3px solid #064E3B; border-radius:12px; background:#1E8449; touch-action:none; cursor:crosshair;\" onclick=\"soccerCanvasKick(event)\"></canvas>\n            </div>\n\n            <div id=\"soccer-controls-wrap\" style=\"display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; background:#FFF; border:2px solid #10B981; border-radius:12px; padding:8px 12px;\">\n                <div id=\"soccer-solo-controls\" style=\"display:flex; width:100%; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;\">\n                    <div style=\"display:grid; grid-template-columns:repeat(3, 38px); grid-template-rows:repeat(2, 34px); gap:4px; align-items:center; justify-items:center;\">\n                        <span></span>\n                        <button type=\"button\" class=\"btn btn-sm btn-accent\" style=\"width:38px; height:34px; padding:0;\" onmousedown=\"soccerTouchDir('up', true)\" onmouseup=\"soccerTouchDir('up', false)\" onmouseleave=\"soccerTouchDir('up', false)\" ontouchstart=\"event.preventDefault(); soccerTouchDir('up', true)\" ontouchend=\"soccerTouchDir('up', false)\">▲</button>\n                        <span></span>\n                        <button type=\"button\" class=\"btn btn-sm btn-accent\" style=\"width:38px; height:34px; padding:0;\" onmousedown=\"soccerTouchDir('left', true)\" onmouseup=\"soccerTouchDir('left', false)\" onmouseleave=\"soccerTouchDir('left', false)\" ontouchstart=\"event.preventDefault(); soccerTouchDir('left', true)\" ontouchend=\"soccerTouchDir('left', false)\">◀</button>\n                        <button type=\"button\" class=\"btn btn-sm btn-accent\" style=\"width:38px; height:34px; padding:0;\" onmousedown=\"soccerTouchDir('down', true)\" onmouseup=\"soccerTouchDir('down', false)\" onmouseleave=\"soccerTouchDir('down', false)\" ontouchstart=\"event.preventDefault(); soccerTouchDir('down', true)\" ontouchend=\"soccerTouchDir('down', false)\">▼</button>\n                        <button type=\"button\" class=\"btn btn-sm btn-accent\" style=\"width:38px; height:34px; padding:0;\" onmousedown=\"soccerTouchDir('right', true)\" onmouseup=\"soccerTouchDir('right', false)\" onmouseleave=\"soccerTouchDir('right', false)\" ontouchstart=\"event.preventDefault(); soccerTouchDir('right', true)\" ontouchend=\"soccerTouchDir('right', false)\">▶</button>\n                    </div>\n                    <div style=\"font-size:11.5px; color:#475569; flex:1; min-width:140px; text-align:center;\">\n                        Dùng phím <b>Mũi tên / WASD</b> + <b>Space</b> (hoặc chạm lên sân để sút về hướng đó!)\n                    </div>\n                    <button type=\"button\" class=\"btn btn-primary\" style=\"padding:12px 18px; font-size:15px;\" onclick=\"soccerKick()\">⚡ SÚT BÓNG!</button>\n                </div>\n                <div id=\"soccer-penalty-controls\" style=\"display:none; width:100%;\"></div>\n            </div>\n        </div>\n    </div>\n\n    <!-- 13. PET SHOP & COMPANION PET CARE MODAL -->\n    <div class=\"modal-overlay\" id=\"pet-shop-modal\" style=\"z-index:226;\">\n        <div class=\"modal-content pixel-box\" style=\"max-width:680px; background:linear-gradient(180deg,#FFFBEB 0%,#FEF3C7 100%); border-color:#B45309;\">\n            <div class=\"modal-header\" style=\"background:linear-gradient(90deg,#F59E0B,#EC4899); color:#FFF; margin:-16px -16px 12px -16px; padding:12px 16px; border-radius:13px 13px 0 0; border-bottom:3px solid #2C3E50;\">\n                <h2 id=\"pet-modal-title\" style=\"color:#FFF;\">🐾 Cửa Hàng &amp; Chăm Sóc Thú Cưng B2KS</h2>\n                <button class=\"btn btn-sm\" style=\"background:#FFF; color:#B45309;\" onclick=\"closeModal('pet-shop-modal')\">✖ Đóng</button>\n            </div>\n            <div id=\"pet-shop-npc-banner\" style=\"background:#FFF; border:2px solid #F59E0B; border-radius:12px; padding:9px 12px; margin-bottom:10px; font-size:12.5px; display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;\">\n                <div style=\"display:flex; align-items:center; gap:9px; flex:1; min-width:210px;\">\n                    <span style=\"font-size:26px;\">👩‍🔬</span>\n                    <div>\n                        <b style=\"color:#B45309;\">Cô My (Pet Master):</b>\n                        <span>Đổi sao nhận Trứng Thú Cưng (10 loài), ấp nở &amp; cho ăn để thú cưng tiến hóa đồng hành, tăng <b>Tốc độ</b> &amp; <b>+Sao thưởng</b>!</span>\n                    </div>\n                </div>\n                <span class=\"points-pill\" id=\"pet-shop-points-pill\" style=\"font-size:13px;\">0⭐</span>\n            </div>\n            <div id=\"pet-hud-guide-banner\" style=\"display:none; background:#E0F2FE; border:2px solid #0284C7; border-radius:12px; padding:9px 12px; margin-bottom:10px; font-size:12.5px; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;\">\n                <div style=\"flex:1; min-width:210px; color:#0C4A6E;\">\n                    <b>🐾 Quản lý Thú Cưng Đang Sở Hữu:</b> Xem trạng thái ấp trứng, cho ăn bằng thức ăn đang có hoặc chọn thú cưng đi cùng! Muốn mua thêm trứng mới hoặc thức ăn, hãy ghé <b>🐾 Cửa Hàng Thú Cưng</b> trên bản đồ.\n                </div>\n                <button type=\"button\" class=\"btn btn-sm btn-accent\" onclick=\"navigateToPetShopFromHud()\">🧭 Chỉ đường tới Cửa Hàng</button>\n            </div>\n            <div id=\"pet-shop-tabs\" class=\"room-tabs\" style=\"margin-bottom:12px; background:#FDE68A; padding:6px; border-radius:10px; border:2px solid #D97706;\">\n                <button type=\"button\" class=\"btn btn-sm\" id=\"pet-tab-eggs\" style=\"background:#D97706;\" onclick=\"switchPetShopTab('eggs')\">🥚 Nhận Trứng Thú Cưng</button>\n                <button type=\"button\" class=\"btn btn-sm\" id=\"pet-tab-food\" style=\"background:#64748B;\" onclick=\"switchPetShopTab('food')\">🍖 Mua Thức Ăn</button>\n                <button type=\"button\" class=\"btn btn-sm\" id=\"pet-tab-accessories\" style=\"background:#64748B;\" onclick=\"switchPetShopTab('accessories')\">🎀 Phụ Kiện</button>\n                <button type=\"button\" class=\"btn btn-sm\" id=\"pet-tab-my_pets\" style=\"background:#64748B;\" onclick=\"switchPetShopTab('my_pets')\">🐾 Bộ Sưu Tập &amp; Chăm Nuôi</button>\n            </div>\n            <div id=\"pet-shop-body\"></div>\n        </div>\n    </div>\n\n    <!-- REACT OVERLAY ROOT FOR CROSS-WORLD, FLEA MARKET, VIRTUAL ZOO, PARENTAL DASHBOARD & PWA -->\n    <div id=\"root\"></div>\n\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n    <script>\n      (function () {\n        if (typeof window.closeModal !== 'function') {\n          window.closeModal = function (id) {\n            var el = document.getElementById(id);\n            if (el) el.style.display = 'none';\n          };\n        }\n        if (typeof window.startAudioOnce !== 'function') {\n          window.startAudioOnce = function () {};\n        }\n        window.switchGuideTab = function (tabId) {\n          var btns = document.querySelectorAll('.guide-tab-btn');\n          btns.forEach(function (b) {\n            var isAct = b.getAttribute('data-guide-tab') === tabId;\n            b.style.background = isAct ? '#0F766E' : '#FFFFFF';\n            b.style.color = isAct ? '#FFFFFF' : '#1E293B';\n          });\n          var secs = document.querySelectorAll('.guide-section');\n          secs.forEach(function (s) {\n            var cat = s.getAttribute('data-guide-cat');\n            s.style.display = tabId === 'all' || cat === tabId ? 'block' : 'none';\n          });\n        };\n        setTimeout(function () {\n          if (window.__B2KS_BOOTED__ || /^(localhost|127\\.0\\.0\\.1)$/i.test(window.location.hostname)) return;\n          fetch('./docs/index.html', { method: 'HEAD' })\n            .then(function (res) {\n              if (res && res.ok) {\n                window.location.replace('./docs/' + window.location.search + window.location.hash);\n              } else {\n                throw new Error('No docs fallback');\n              }\n            })\n            .catch(function () {\n              var guide = document.querySelector('#guide-modal .modal-content');\n              if (guide && !document.getElementById('gh-pages-warning')) {\n                var warn = document.createElement('div');\n                warn.id = 'gh-pages-warning';\n                warn.style.cssText = 'margin-top:10px;padding:10px 12px;border-radius:10px;background:#FEF3C7;border:2px solid #D97706;color:#78350F;font-size:13px;line-height:1.45;';\n                warn.innerHTML = '<b>⚠️ Lưu ý triển khai GitHub Pages:</b> Bạn đang mở mã nguồn Vite chưa build trực tiếp từ nhánh <code>main / root</code>. Hãy vào <b>Settings → Pages → Build and deployment → Source</b> và chọn <b>GitHub Actions</b> (hoặc chọn thư mục <code>/docs</code>) để game khởi chạy đầy đủ!';\n                guide.appendChild(warn);\n              }\n            });\n        }, 2500);\n      })();\n    </script>\n</body>\n</html>\n"},{"path":"metadata.json","encoding":"utf8","content":"{\n  \"name\": \"B2KS Daily Routines\",\n  \"description\": \"Game RPG Gia Đình B2KS: Nhiệm vụ hằng ngày, Sở thú ảo học tiếng Anh, Trung tâm giao dịch, Chợ trời, Phòng thí nghiệm sáng tạo và Khu vui chơi đối kháng.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"]\n}\n"},{"path":"package.json","encoding":"utf8","content":"{\n  \"name\": \"react-example\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite --port=3000 --host=0.0.0.0\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"clean\": \"rm -rf dist server.js\",\n    \"lint\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@google/genai\": \"^2.4.0\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"@types/canvas-confetti\": \"^1.9.0\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"canvas-confetti\": \"^1.9.4\",\n    \"chart.js\": \"^4.6.1\",\n    \"dotenv\": \"^17.2.3\",\n    \"express\": \"^4.21.2\",\n    \"jszip\": \"^3.10.2\",\n    \"lucide-react\": \"^0.546.0\",\n    \"motion\": \"^12.23.24\",\n    \"react\": \"^19.0.1\",\n    \"react-dom\": \"^19.0.1\",\n    \"vite\": \"^8.3.0\",\n    \"vite-plugin-pwa\": \"^2.0.0\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.14.0\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"esbuild\": \"^0.28.2\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"tsx\": \"^4.21.0\",\n    \"typescript\": \"^7.0.2\",\n    \"@types/express\": \"^4.17.21\"\n  }\n}\n"},{"path":"public/animals.json","encoding":"utf8","content":"[\n  {\n    \"id\": \"giant_panda\",\n    \"nameEn\": \"Giant Panda\",\n    \"nameVi\": \"Gấu Trúc Khổng Lồ\",\n    \"wikiTitle\": \"Giant_panda\",\n    \"ecosystem\": \"Rừng nhiệt đới\",\n    \"emoji\": \"🐼\",\n    \"unlockCost\": 25,\n    \"description\": \"The giant panda lives in misty bamboo forests in China. It spends almost twelve hours every single day eating fresh green bamboo shoots. Although it looks round and gentle, this black-and-white bear is a very good tree climber.\"\n  },\n  {\n    \"id\": \"toco_toucan\",\n    \"nameEn\": \"Toco Toucan\",\n    \"nameVi\": \"Chim Toucan\",\n    \"wikiTitle\": \"Toco_toucan\",\n    \"ecosystem\": \"Rừng nhiệt đới\",\n    \"emoji\": \"🦜\",\n    \"unlockCost\": 20,\n    \"description\": \"The toco toucan is famous for its huge bright orange beak. Even though its beak looks very heavy, it is actually hollow and light inside. This colorful bird hops between tall jungle branches to eat sweet fruit and berries.\"\n  },\n  {\n    \"id\": \"red_eyed_tree_frog\",\n    \"nameEn\": \"Red-Eyed Tree Frog\",\n    \"nameVi\": \"Ếch Cây Mắt Đỏ\",\n    \"wikiTitle\": \"Red-eyed_tree_frog\",\n    \"ecosystem\": \"Rừng nhiệt đới\",\n    \"emoji\": \"🐸\",\n    \"unlockCost\": 18,\n    \"description\": \"This tiny bright green frog sleeps under rainforest leaves during the daytime. When it wakes up at night, it opens its big ruby-red eyes to surprise hungry predators. Its sticky orange toes help it climb smooth wet leaves effortlessly.\"\n  },\n  {\n    \"id\": \"orangutan\",\n    \"nameEn\": \"Orangutan\",\n    \"nameVi\": \"Đười Ươi\",\n    \"wikiTitle\": \"Orangutan\",\n    \"ecosystem\": \"Rừng nhiệt đới\",\n    \"emoji\": \"🦧\",\n    \"unlockCost\": 35,\n    \"description\": \"The orangutan is a clever red-haired ape that lives high in the rainforest canopy. It builds a cozy new nest out of leaves and branches every evening before going to sleep. Baby orangutans stay close to their mothers for many years to learn survival skills.\"\n  },\n  {\n    \"id\": \"african_lion\",\n    \"nameEn\": \"African Lion\",\n    \"nameVi\": \"Sư Tử Châu Phi\",\n    \"wikiTitle\": \"Lion\",\n    \"ecosystem\": \"Thảo nguyên\",\n    \"emoji\": \"🦁\",\n    \"unlockCost\": 40,\n    \"description\": \"Known as the king of the savanna, the lion lives in family groups called prides. Male lions grow a thick golden mane around their heads to look strong and brave. Their mighty roar can be heard across the grassy plains from miles away.\"\n  },\n  {\n    \"id\": \"giraffe\",\n    \"nameEn\": \"Giraffe\",\n    \"nameVi\": \"Hươu Cao Cổ\",\n    \"wikiTitle\": \"Giraffe\",\n    \"ecosystem\": \"Thảo nguyên\",\n    \"emoji\": \"🦒\",\n    \"unlockCost\": 30,\n    \"description\": \"The giraffe is the tallest animal walking on Earth today. Its extra-long neck helps it reach tender leaves at the very top of acacia trees. It also has a long dark tongue to protect it from the bright sunshine.\"\n  },\n  {\n    \"id\": \"african_elephant\",\n    \"nameEn\": \"African Elephant\",\n    \"nameVi\": \"Voi Châu Phi\",\n    \"wikiTitle\": \"African_bush_elephant\",\n    \"ecosystem\": \"Thảo nguyên\",\n    \"emoji\": \"🐘\",\n    \"unlockCost\": 45,\n    \"description\": \"The African elephant is the largest land mammal in the world. It uses its flexible trunk to drink water, pick up food, and give itself cool dust baths. Elephants have giant ears that help keep their bodies cool under the hot sun.\"\n  },\n  {\n    \"id\": \"cheetah\",\n    \"nameEn\": \"Cheetah\",\n    \"nameVi\": \"Báo Gê-pa\",\n    \"wikiTitle\": \"Cheetah\",\n    \"ecosystem\": \"Thảo nguyên\",\n    \"emoji\": \"🐆\",\n    \"unlockCost\": 35,\n    \"description\": \"The cheetah is the fastest runner on land and can sprint faster than a highway car. Black tear marks below its eyes protect it from the bright savanna sun while hunting. Its long tail helps it balance and turn sharply at high speed.\"\n  },\n  {\n    \"id\": \"bottlenose_dolphin\",\n    \"nameEn\": \"Bottlenose Dolphin\",\n    \"nameVi\": \"Cá Heo Mũi Chai\",\n    \"wikiTitle\": \"Common_bottlenose_dolphin\",\n    \"ecosystem\": \"Đại dương\",\n    \"emoji\": \"🐬\",\n    \"unlockCost\": 35,\n    \"description\": \"The dolphin is a friendly and playful ocean mammal that breathes air through a blowhole. Dolphins talk to each other using special clicks, whistles, and joyful jumps above the waves. They live together in smart groups called pods and help each other find fish.\"\n  },\n  {\n    \"id\": \"green_sea_turtle\",\n    \"nameEn\": \"Green Sea Turtle\",\n    \"nameVi\": \"Rùa Biển Xanh\",\n    \"wikiTitle\": \"Green_sea_turtle\",\n    \"ecosystem\": \"Đại dương\",\n    \"emoji\": \"🐢\",\n    \"unlockCost\": 25,\n    \"description\": \"The green sea turtle glides gracefully through warm tropical oceans using its strong front flippers. It can hold its breath underwater for hours while resting beside colorful coral reefs. Amazingly, mother turtles swim thousands of miles back to the exact beach where they were born.\"\n  },\n  {\n    \"id\": \"blue_whale\",\n    \"nameEn\": \"Blue Whale\",\n    \"nameVi\": \"Cá Voi Xanh\",\n    \"wikiTitle\": \"Blue_whale\",\n    \"ecosystem\": \"Đại dương\",\n    \"emoji\": \"🐋\",\n    \"unlockCost\": 55,\n    \"description\": \"The blue whale is the biggest animal to have ever lived on our planet. Its heart alone is nearly as large as a small family car! Despite its enormous size, this gentle giant feeds mostly on tiny ocean creatures called krill.\"\n  },\n  {\n    \"id\": \"clownfish\",\n    \"nameEn\": \"Clownfish\",\n    \"nameVi\": \"Cá Hề\",\n    \"wikiTitle\": \"Amphiprioninae\",\n    \"ecosystem\": \"Đại dương\",\n    \"emoji\": \"🐠\",\n    \"unlockCost\": 20,\n    \"description\": \"The bright orange clownfish wears white stripes just like a tiny ocean costume. It lives safely inside stinging sea anemones that protect it from bigger hungry fish. Clownfish gently fan the water around their home to keep it healthy and clean.\"\n  },\n  {\n    \"id\": \"polar_bear\",\n    \"nameEn\": \"Polar Bear\",\n    \"nameVi\": \"Gấu Bắc Cực\",\n    \"wikiTitle\": \"Polar_bear\",\n    \"ecosystem\": \"Bắc Cực\",\n    \"emoji\": \"🐻‍❄️\",\n    \"unlockCost\": 45,\n    \"description\": \"The polar bear thrives on freezing Arctic sea ice thanks to its thick warm fur coat. Beneath its white fur, it actually has black skin that absorbs precious heat from the sun. Polar bears are powerful swimmers that can paddle across icy water for many miles.\"\n  },\n  {\n    \"id\": \"arctic_fox\",\n    \"nameEn\": \"Arctic Fox\",\n    \"nameVi\": \"Cáo Tuyết Bắc Cực\",\n    \"wikiTitle\": \"Arctic_fox\",\n    \"ecosystem\": \"Bắc Cực\",\n    \"emoji\": \"🦊\",\n    \"unlockCost\": 30,\n    \"description\": \"The arctic fox changes its coat color with the seasons to stay hidden from danger. In snowy winter it wears pure white fur, while in summer its fur turns brown and gray. Its fluffy tail wraps around its nose like a warm scarf during freezing storms.\"\n  },\n  {\n    \"id\": \"snowy_owl\",\n    \"nameEn\": \"Snowy Owl\",\n    \"nameVi\": \"Cú Tuyết\",\n    \"wikiTitle\": \"Snowy_owl\",\n    \"ecosystem\": \"Bắc Cực\",\n    \"emoji\": \"🦉\",\n    \"unlockCost\": 30,\n    \"description\": \"The snowy owl has bright golden eyes and snow-white feathers that blend into icy landscapes. Even its toes are covered in thick feathers to keep them cozy in freezing snow. Unlike many other owls, the snowy owl loves to hunt during the bright Arctic daytime.\"\n  },\n  {\n    \"id\": \"narwhal\",\n    \"nameEn\": \"Narwhal\",\n    \"nameVi\": \"Kỳ Lân Biển\",\n    \"wikiTitle\": \"Narwhal\",\n    \"ecosystem\": \"Bắc Cực\",\n    \"emoji\": \"🦄\",\n    \"unlockCost\": 50,\n    \"description\": \"Often called the unicorn of the sea, the narwhal has a long spiral tusk growing from its head. That famous tusk is actually a giant sensitive tooth filled with millions of tiny nerve endings. Narwhals dive deep beneath Arctic ice sheets to hunt for fish in dark cold water.\"\n  }\n]\n"},{"path":"public