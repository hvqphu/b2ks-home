Math.cos(nowMs / 520 + i) * 12;\n      ctx.beginPath();\n      ctx.arc(fx, fy, 2.2 + Math.sin(nowMs / 240 + i) * 0.8, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.restore();\n  }\n}\n\nexport function drawHouseInteriorWorld(\n  ctx: CanvasRenderingContext2D,\n  lighting: LightingInfo,\n  rooms: HouseRoomDef[],\n  wardrobeOpenedRoomId: string | null,\n  me: Member,\n  state: B2KSState,\n  findAnyCatalogItem: (id: string) => any\n) {\n  const f1Living = rooms.find((r) => r.id === 'f1_living');\n  const yShift = f1Living ? Math.max(0, f1Living.y - 570) : 0;\n  const totalFloors = 3 + Math.round(yShift / 230);\n  const W = HOUSE_WORLD.width;\n  const H = HOUSE_WORLD.height + yShift;\n  const brand = ((state.familyName || 'B2KS').trim() || 'B2KS').toUpperCase();\n\n  ctx.fillStyle = '#1C2833';\n  ctx.fillRect(-100, -100, W + 200, H + 200);\n\n  ctx.fillStyle = '#F8F9F9';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 6;\n  ctx.fillRect(85, 95, 950, 670 + yShift);\n  ctx.strokeRect(85, 95, 950, 670 + yShift);\n\n  ctx.fillStyle = '#C0392B';\n  ctx.beginPath();\n  ctx.moveTo(60, 95); ctx.lineTo(560, 20); ctx.lineTo(1060, 95);\n  ctx.closePath(); ctx.fill(); ctx.stroke();\n  ctx.fillStyle = '#FFF';\n  ctx.font = 'bold 17px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText(`🏢 NHÀ PHỐ GIA ĐÌNH ${brand} (${totalFloors} TẦNG)`, 560, 68);\n\n  ctx.fillStyle = '#EBEDEF';\n  ctx.fillRect(500, 110, 120, 640 + yShift);\n  ctx.fillStyle = '#D5DBDB';\n  for (let sy = 175; sy < 720 + yShift; sy += 24) {\n    ctx.fillRect(528, sy, 64, 10);\n    ctx.strokeStyle = '#AEB6BF';\n    ctx.lineWidth = 1.5;\n    ctx.strokeRect(528, sy, 64, 10);\n  }\n\n  ctx.fillStyle = '#8E44AD';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 3;\n  ctx.fillRect(528, 718 + yShift, 64, 34);\n  ctx.strokeRect(528, 718 + yShift, 64, 34);\n  ctx.fillStyle = '#FFF';\n  ctx.font = 'bold 11px Fredoka, sans-serif';\n  ctx.fillText('🚪 RA PHỐ', 560, 739 + yShift);\n\n  rooms.forEach((r) => {\n    ctx.fillStyle = r.isDisabled ? '#CBD5E1' : r.wall;\n    ctx.fillRect(r.x, r.y, r.w, r.h);\n\n    ctx.fillStyle = r.isDisabled ? '#94A3B8' : r.floor;\n    ctx.fillRect(r.x, r.y + r.h - 65, r.w, 65);\n\n    ctx.strokeStyle = '#2C3E50';\n    ctx.lineWidth = 4;\n    ctx.strokeRect(r.x, r.y, r.w, r.h);\n\n    ctx.fillStyle = r.isDisabled ? 'rgba(51, 65, 85, 0.85)' : 'rgba(44, 62, 80, 0.85)';\n    ctx.beginPath();\n    ctx.roundRect(r.x + 12, r.y + 8, r.w - 24, 24, 6);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px Fredoka, sans-serif';\n    ctx.textAlign = 'center';\n    const lockBadge = r.isDisabled\n      ? ' 🚫'\n      : r.ownerIds && r.ownerIds.length > 0\n        ? (r.isUnlocked ? ' 🔓' : ' 🔒')\n        : '';\n    ctx.fillText(r.name + lockBadge, r.x + r.w / 2, r.y + 24);\n\n    const doorX = r.doorSide === 'right' ? r.x + r.w - 6 : r.x - 6;\n    const doorY = r.y + r.h - 90;\n    const doorH = 85;\n\n    if (r.isDisabled) {\n      // Blocked vacant bedroom (wooden boards + frosted overlay)\n      ctx.fillStyle = 'rgba(15, 23, 42, 0.28)';\n      ctx.fillRect(r.x + 2, r.y + 2, r.w - 4, r.h - 4);\n      ctx.fillStyle = '#64748B';\n      ctx.fillRect(doorX, doorY, 12, doorH);\n      ctx.strokeStyle = '#1E293B';\n      ctx.lineWidth = 2.5;\n      ctx.strokeRect(doorX, doorY, 12, doorH);\n      ctx.fillStyle = 'rgba(255,255,255,0.88)';\n      ctx.beginPath();\n      ctx.roundRect(r.x + 48, r.y + 82, r.w - 96, 48, 10);\n      ctx.fill();\n      ctx.strokeStyle = '#475569';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n      ctx.fillStyle = '#334155';\n      ctx.font = 'bold 12px Fredoka, sans-serif';\n      ctx.fillText('🚫 PHÒNG CHƯA SỬ DỤNG', r.x + r.w / 2, r.y + 104);\n      ctx.font = '10.5px Fredoka, sans-serif';\n      ctx.fillStyle = '#64748B';\n      ctx.fillText('Tự mở khi gia đình thêm thành viên', r.x + r.w / 2, r.y + 121);\n    } else if (r.ownerIds && r.ownerIds.length > 0 && !r.isUnlocked) {\n      ctx.fillStyle = '#873600';\n      ctx.fillRect(doorX, doorY, 12, doorH);\n      ctx.strokeStyle = '#2C3E50';\n      ctx.lineWidth = 2.5;\n      ctx.strokeRect(doorX, doorY, 12, doorH);\n      ctx.font = '18px Arial';\n      ctx.fillText('🔒', doorX + 6, doorY + 45);\n    } else {\n      ctx.fillStyle = r.floor;\n      ctx.fillRect(doorX - 2, doorY, 16, doorH);\n      ctx.fillStyle = '#A04000';\n      ctx.fillRect(r.doorSide === 'right' ? doorX - 24 : doorX + 12, doorY, 24, 9);\n    }\n  });\n\n  // Phòng khách (Tầng 1 trái)\n  ctx.fillStyle = '#E74C3C';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 2.5;\n  ctx.beginPath(); ctx.roundRect(135, 670 + yShift, 125, 45, 8); ctx.fill(); ctx.stroke();\n  ctx.fillStyle = '#2C3E50';\n  ctx.fillRect(295, 595 + yShift, 50, 26);\n  ctx.fillStyle = '#3498DB';\n  ctx.fillRect(298, 598 + yShift, 44, 18);\n  ctx.fillStyle = '#FFF';\n  ctx.font = 'bold 9px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText('📺 TV', 320, 610 + yShift);\n  ctx.fillStyle = '#2C3E50';\n  ctx.fillRect(405, 620 + yShift, 44, 34);\n  ctx.fillStyle = '#FFF';\n  ctx.font = 'bold 10px Fredoka, sans-serif';\n  ctx.fillText('📋 BẢNG', 427, 640 + yShift);\n\n  // Phòng ăn (Tầng 1 phải)\n  ctx.fillStyle = '#A04000';\n  ctx.beginPath(); ctx.ellipse(830, 665 + yShift, 62, 32, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n  ctx.font = '20px Arial';\n  ctx.fillText('🍲 🍗 🥗', 830, 671 + yShift);\n\n  // Phòng bố mẹ (Tầng 2 phải)\n  ctx.fillStyle = '#8E44AD';\n  ctx.beginPath(); ctx.roundRect(875, 405 + yShift, 115, 78, 8); ctx.fill(); ctx.stroke();\n  ctx.fillStyle = '#FFF';\n  ctx.fillRect(888, 412 + yShift, 36, 16);\n  ctx.fillRect(938, 412 + yShift, 36, 16);\n\n  // Các phòng ngủ của con (Tầng 3, 4, 5...) - chỉ vẽ giường cho phòng đang hoạt động\n  const kidPalette = ['#3498DB', '#2ECC71', '#EC4899', '#F59E0B', '#8B5CF6', '#14B8A6'];\n  let kidBedIdx = 0;\n  rooms.forEach((r) => {\n    if (r.id.startsWith('f1_') || r.id.startsWith('f2_')) return;\n    if (r.isDisabled) return;\n    const bedColor = kidPalette[kidBedIdx % kidPalette.length];\n    kidBedIdx++;\n    const bedX = r.doorSide === 'right' ? r.x + 30 : r.x + r.w - 125;\n    const bedY = r.y + 65;\n    ctx.fillStyle = bedColor;\n    ctx.strokeStyle = '#2C3E50';\n    ctx.lineWidth = 2.5;\n    ctx.beginPath(); ctx.roundRect(bedX, bedY, 85, 68, 8); ctx.fill(); ctx.stroke();\n    ctx.fillStyle = '#FFF';\n    ctx.fillRect(bedX + 13, bedY + 7, 42, 14);\n  });\n\n  rooms.forEach((r) => {\n    if (!r.wardrobe || r.isDisabled) return;\n    const wx = r.wardrobe.x;\n    const wy = r.wardrobe.y;\n    const isOpen = wardrobeOpenedRoomId === r.id;\n    const isOwner = r.ownerIds && r.ownerIds.includes(me.id);\n\n    ctx.save();\n    ctx.fillStyle = '#873600';\n    ctx.strokeStyle = '#2C3E50';\n    ctx.lineWidth = 2.4;\n    ctx.beginPath();\n    ctx.roundRect(wx - 24, wy, 48, 56, 5);\n    ctx.fill();\n    ctx.stroke();\n\n    if (isOpen) {\n      ctx.fillStyle = '#3E2723';\n      ctx.fillRect(wx - 20, wy + 5, 40, 44);\n      ['#E74C3C', '#3498DB', '#F1C40F', '#2ECC71'].forEach((col, ci) => {\n        ctx.fillStyle = col;\n        ctx.fillRect(wx - 17 + ci * 9, wy + 10, 7, 18);\n      });\n    } else {\n      ctx.fillStyle = '#A04000';\n      ctx.fillRect(wx - 20, wy + 5, 18, 44);\n      ctx.strokeRect(wx - 20, wy + 5, 18, 44);\n      ctx.fillRect(wx + 2, wy + 5, 18, 44);\n      ctx.strokeRect(wx + 2, wy + 5, 18, 44);\n      ctx.fillStyle = '#F1C40F';\n      ctx.beginPath();\n      ctx.arc(wx - 4, wy + 27, 2.2, 0, Math.PI * 2);\n      ctx.arc(wx + 4, wy + 27, 2.2, 0, Math.PI * 2);\n      ctx.fill();\n    }\n\n    ctx.fillStyle = isOwner ? '#27AE60' : '#34495E';\n    ctx.beginPath();\n    ctx.roundRect(wx - 26, wy - 15, 52, 13, 4);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 8.5px Fredoka, sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(isOwner ? '🧥 Tủ đồ' : '🔒 Tủ riêng', wx, wy - 5.5);\n    ctx.restore();\n  });\n\n  // Phòng sinh hoạt chung (Tầng 2 trái) — Tủ Sách Truyện Tranh Tiếng Anh Gia Đình\n  const f2CommonRoom = rooms.find((r) => r.id === 'f2_common');\n  const bx = 165;\n  const by = f2CommonRoom ? f2CommonRoom.y + 46 : 386 + yShift;\n\n  ctx.save();\n  // Thảm đọc sách ấm áp\n  ctx.fillStyle = '#FCE7F3';\n  ctx.strokeStyle = '#EC4899';\n  ctx.lineWidth = 2.5;\n  ctx.beginPath();\n  ctx.ellipse(bx + 110, by + 102, 92, 26, 0, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.stroke();\n\n  // Tủ sách gỗ 3 tầng lớn\n  ctx.fillStyle = '#78350F';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 3;\n  ctx.beginPath();\n  ctx.roundRect(bx, by, 118, 82, 8);\n  ctx.fill();\n  ctx.stroke();\n\n  ctx.fillStyle = '#451A03';\n  [by + 10, by + 34, by + 58].forEach((sy) => {\n    ctx.fillRect(bx + 7, sy, 104, 18);\n  });\n\n  const bookColors = ['#EF4444', '#F59E0B', '#10B981', '#3B82F6', '#8B5CF6', '#EC4899', '#06B6D4'];\n  [by + 12, by + 36, by + 60].forEach((sy, rowIdx) => {\n    for (let bi = 0; bi < 8; bi++) {\n      ctx.fillStyle = bookColors[(bi + rowIdx * 2) % bookColors.length];\n      ctx.fillRect(bx + 10 + bi * 12, sy, 9, 15);\n      ctx.strokeStyle = '#1E293B';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(bx + 10 + bi * 12, sy, 9, 15);\n    }\n  });\n\n  // Bàn trà nhỏ & truyện tranh đang mở\n  ctx.fillStyle = '#D97706';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 2.5;\n  ctx.beginPath();\n  ctx.roundRect(bx + 146, by + 54, 62, 34, 8);\n  ctx.fill();\n  ctx.stroke();\n  ctx.fillStyle = '#FEF3C7';\n  ctx.fillRect(bx + 158, by + 60, 18, 14);\n  ctx.fillRect(bx + 178, by + 60, 18, 14);\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(bx + 158, by + 60, 18, 14);\n  ctx.strokeRect(bx + 178, by + 60, 18, 14);\n\n  // Nhãn tủ sách\n  ctx.fillStyle = '#0F766E';\n  ctx.beginPath();\n  ctx.roundRect(bx + 4, by - 19, 110, 16, 6);\n  ctx.fill();\n  ctx.fillStyle = '#FFF';\n  ctx.font = 'bold 9.5px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText('📚 TỦ SÁCH TRUYỆN', bx + 59, by - 8);\n  ctx.restore();\n\n  state.members.forEach((m) => {\n    m.roomDecor.forEach((d) => {\n      if (d.id === 'd_bookshelf') return;\n      drawWorldDecorItem(ctx, d.id, d.x, d.y + yShift, findAnyCatalogItem);\n    });\n  });\n\n  if (lighting.isNight) {\n    rooms.forEach((r) => {\n      if (r.isDisabled) return;\n      const grad = ctx.createRadialGradient(r.x + r.w / 2, r.y + 45, 10, r.x + r.w / 2, r.y + 80, 180);\n      grad.addColorStop(0, 'rgba(255, 243, 176, 0.36)');\n      grad.addColorStop(1, 'rgba(255, 243, 176, 0)');\n      ctx.fillStyle = grad;\n      ctx.fillRect(r.x, r.y, r.w, r.h);\n    });\n  }\n}\n\nexport function drawPrivateRoomWorld(\n  ctx: CanvasRenderingContext2D,\n  lighting: LightingInfo,\n  room: HouseRoomDef | null,\n  ownerMember: Member | null,\n  me: Member,\n  wardrobeOpenedRoomId: string | null,\n  findAnyCatalogItem: (id: string) => any\n) {\n  const W = PRIVATE_ROOM_WORLD.width;\n  const H = PRIVATE_ROOM_WORLD.height;\n  const isOwner = Boolean(room && room.ownerIds && room.ownerIds.includes(me.id));\n\n  ctx.fillStyle = '#1C2833';\n  ctx.fillRect(-100, -100, W + 200, H + 200);\n\n  const wallColor = (ownerMember && ownerMember.roomWall) || (room && room.wall) || '#D5F5E3';\n  ctx.fillStyle = wallColor;\n  ctx.fillRect(0, 0, W, 200);\n\n  ctx.fillStyle = '#E59866';\n  ctx.fillRect(0, 200, W, H - 200);\n\n  ctx.strokeStyle = 'rgba(135, 54, 0, 0.16)';\n  ctx.lineWidth = 2;\n  for (let fy = 235; fy < H; fy += 35) {\n    ctx.beginPath(); ctx.moveTo(0, fy); ctx.lineTo(W, fy); ctx.stroke();\n  }\n\n  ctx.fillStyle = '#873600';\n  ctx.fillRect(0, 192, W, 10);\n\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 6;\n  ctx.strokeRect(0, 0, W, H);\n\n  ctx.fillStyle = lighting.isNight ? '#1C2541' : '#AED6F1';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 3.5;\n  ctx.fillRect(265, 42, 115, 88);\n  ctx.strokeRect(265, 42, 115, 88);\n  if (lighting.isNight) {\n    ctx.fillStyle = '#F9E79F';\n    ctx.beginPath(); ctx.arc(345, 68, 10, 0, Math.PI * 2); ctx.fill();\n  }\n  ctx.beginPath();\n  ctx.moveTo(322.5, 42); ctx.lineTo(322.5, 130);\n  ctx.moveTo(265, 86); ctx.lineTo(380, 86);\n  ctx.stroke();\n\n  ctx.fillStyle = '#8E44AD';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 3;\n  ctx.beginPath(); ctx.roundRect(35, 145, 145, 110, 12); ctx.fill(); ctx.stroke();\n  ctx.fillStyle = '#F5EEF8';\n  ctx.fillRect(44, 180, 127, 68);\n  ctx.fillStyle = '#FFFFFF';\n  ctx.fillRect(55, 154, 48, 20);\n  ctx.fillRect(112, 154, 48, 20);\n  ctx.fillStyle = '#2C3E50';\n  ctx.font = 'bold 11px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText('🛏️ Giường ngủ', 107, 136);\n\n  const isWardrobeOpen = Boolean(room && wardrobeOpenedRoomId === room.id);\n  ctx.fillStyle = '#873600';\n  ctx.beginPath(); ctx.roundRect(625, 95, 95, 135, 8); ctx.fill(); ctx.stroke();\n  if (isWardrobeOpen) {\n    ctx.fillStyle = '#3E2723';\n    ctx.fillRect(634, 105, 77, 110);\n    ['#E74C3C', '#3498DB', '#F1C40F', '#2ECC71'].forEach((col, i) => {\n      ctx.fillStyle = col;\n      ctx.fillRect(640 + i * 17, 115, 13, 38);\n    });\n  } else {\n    ctx.fillStyle = '#A04000';\n    ctx.fillRect(633, 105, 37, 108); ctx.strokeRect(633, 105, 37, 108);\n    ctx.fillRect(674, 105, 37, 108); ctx.strokeRect(674, 105, 37, 108);\n    ctx.fillStyle = '#F1C40F';\n    ctx.beginPath(); ctx.arc(665, 158, 3.5, 0, Math.PI * 2); ctx.arc(679, 158, 3.5, 0, Math.PI * 2); ctx.fill();\n  }\n  ctx.fillStyle = isOwner ? '#27AE60' : '#34495E';\n  ctx.beginPath(); ctx.roundRect(628, 68, 88, 20, 6); ctx.fill();\n  ctx.fillStyle = '#FFF';\n  ctx.font = 'bold 11px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText(isOwner ? '🧥 Tủ quần áo' : '🔒 Tủ riêng', 672, 82);\n\n  ctx.fillStyle = '#FADBD8';\n  ctx.strokeStyle = '#E6B0AA';\n  ctx.lineWidth = 3;\n  ctx.beginPath(); ctx.ellipse(380, 290, 155, 52, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n\n  const slotsMap = (ownerMember && ownerMember.roomSlots) || {};\n  ROOM_DECOR_SLOTS.forEach((slot) => {\n    const placedId = slotsMap[slot.id];\n    const placedItem = placedId ? findAnyCatalogItem(placedId) : null;\n    const slotScale = placedItem?.sizeScale || (placedItem?.labSpec?.sizeScale) || 1;\n    const rx = Math.round(32 * Math.max(0.85, Math.min(1.45, slotScale)));\n    const ry = Math.round(12 * Math.max(0.85, Math.min(1.45, slotScale)));\n    ctx.save();\n    ctx.strokeStyle = placedId ? 'rgba(44, 62, 80, 0.35)' : 'rgba(44, 62, 80, 0.55)';\n    ctx.lineWidth = 2;\n    ctx.setLineDash([5, 4]);\n    ctx.beginPath();\n    ctx.ellipse(slot.x, slot.y + 18, rx, ry, 0, 0, Math.PI * 2);\n    ctx.stroke();\n    ctx.setLineDash([]);\n\n    if (placedId) {\n      drawWorldDecorItem(ctx, placedId, slot.x, slot.y, findAnyCatalogItem);\n    } else if (isOwner) {\n      ctx.fillStyle = 'rgba(255,255,255,0.8)';\n      ctx.beginPath();\n      ctx.arc(slot.x, slot.y, 15, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = '#2C3E50';\n      ctx.font = 'bold 14px Fredoka, sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('+', slot.x, slot.y + 5);\n    }\n    ctx.restore();\n  });\n\n  ctx.fillStyle = '#6E2C00';\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 3;\n  ctx.beginPath();\n  ctx.roundRect(330, H - 36, 100, 36, [8, 8, 0, 0]);\n  ctx.fill();\n  ctx.stroke();\n\n  ctx.fillStyle = '#F9E79F';\n  ctx.fillRect(342, H - 30, 32, 14);\n  ctx.fillRect(386, H - 30, 32, 14);\n  ctx.fillStyle = '#FFF';\n  ctx.font = 'bold 10.5px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  ctx.fillText('🚪 RA HÀNH LANG', 380, H - 5);\n\n  if (lighting.isNight) {\n    const grad = ctx.createRadialGradient(380, 120, 15, 380, 160, 260);\n    grad.addColorStop(0, 'rgba(255, 243, 176, 0.34)');\n    grad.addColorStop(1, 'rgba(255, 243, 176, 0)');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, W, H);\n  }\n}\n\nexport type MinimapOrientationMode = 'camera' | 'heading';\n\nexport interface MinimapPinHit {\n  id: string;\n  name: string;\n  icon: string;\n  nx: number;\n  ny: number;\n  distM: number;\n}\n\nexport interface MinimapRenderOptions {\n  camYaw?: number;\n  playerWorldAngle?: number;\n  orientMode?: MinimapOrientationMode;\n  zoomScale?: number;\n  streetCars?: StreetCar[];\n  foreignNpcs?: Array<{ id: string; name: string; gender: 'male' | 'female'; x: number; y: number }>;\n  outPinHits?: MinimapPinHit[];\n}\n\nexport function drawNeighborhoodMinimap(\n  ctx: CanvasRenderingContext2D,\n  mw: number,\n  mh: number,\n  state: B2KSState,\n  me: Member,\n  navTarget: NavDestination | null,\n  locations: NavDestination[],\n  opts: MinimapRenderOptions = {}\n) {\n  const now = Date.now();\n  const logicalW = 180;\n  const dprScale = mw / logicalW;\n  const logicalH = mh / dprScale;\n  const cx = logicalW / 2;\n  const cy = logicalH / 2;\n\n  const camYaw = typeof opts.camYaw === 'number' ? opts.camYaw : Math.PI / 4;\n  const playerWorldAngle = typeof opts.playerWorldAngle === 'number' ? opts.playerWorldAngle : Math.PI / 2;\n  const orientMode: MinimapOrientationMode = opts.orientMode === 'heading' ? 'heading' : 'camera';\n  const zoomScale = Math.max(0.65, Math.min(1.6, opts.zoomScale ?? 1.0));\n  const zoom = 0.145 * zoomScale;\n\n  // In 'camera' mode, mapRot = camYaw mirrors the exact 3D screen axes:\n  //   screenRight =  dx * cos(yaw) - dy * sin(yaw)\n  //   screenDown  =  dx * sin(yaw) + dy * cos(yaw)\n  // In 'heading' mode, player's facing direction always points straight UP (-PI/2 on canvas).\n  const mapRot = orientMode === 'heading' ? -Math.PI / 2 - playerWorldAngle : camYaw;\n  const cosR = Math.cos(mapRot);\n  const sinR = Math.sin(mapRot);\n\n  const worldToScreen = (wx: number, wy: number) => {\n    const dx = (wx - me.x) * zoom;\n    const dy = (wy - me.y) * zoom;\n    return {\n      x: cx + dx * cosR - dy * sinR,\n      y: cy + dx * sinR + dy * cosR\n    };\n  };\n\n  ctx.save();\n  ctx.setTransform(1, 0, 0, 1, 0, 0);\n  ctx.clearRect(0, 0, mw, mh);\n  ctx.scale(dprScale, dprScale);\n\n  // Outer grass backdrop\n  ctx.fillStyle = '#4ADE80';\n  ctx.fillRect(0, 0, logicalW, logicalH);\n\n  // World-space map geometry rotated by mapRot\n  ctx.save();\n  ctx.translate(cx, cy);\n  ctx.rotate(mapRot);\n  ctx.scale(zoom, zoom);\n  ctx.translate(-me.x, -me.y);\n\n  // Northern horizon sky & main neighborhood park pasture\n  ctx.fillStyle = '#BAE6FD';\n  ctx.fillRect(-700, -700, STREET_WORLD.width + 1400, 925);\n  ctx.fillStyle = '#5ECA47';\n  ctx.fillRect(-700, 225, STREET_WORLD.width + 1400, STREET_WORLD.height + 700);\n\n  // Subtle grass lawn bands so motion across open park feels crisp\n  ctx.fillStyle = 'rgba(22, 163, 74, 0.14)';\n  for (let gx = 0; gx < STREET_WORLD.width; gx += 240) {\n    ctx.fillRect(gx, 225, 120, STREET_WORLD.height);\n  }\n\n  // Warm light-brown brick sidewalks along all avenues\n  ctx.fillStyle = '#E6C29F';\n  ctx.fillRect(0, 415, STREET_WORLD.width, 230);\n  ctx.fillRect(0, 975, STREET_WORLD.width, 230);\n  ctx.fillRect(0, 1590, STREET_WORLD.width, 230);\n  ctx.fillRect(1130, 225, 230, STREET_WORLD.height - 225);\n  ctx.fillRect(2490, 225, 230, STREET_WORLD.height - 225);\n\n  ctx.strokeStyle = '#C49363';\n  ctx.lineWidth = 6;\n  ctx.strokeRect(1, 416, STREET_WORLD.width - 2, 228);\n  ctx.strokeRect(1, 976, STREET_WORLD.width - 2, 228);\n  ctx.strokeRect(1, 1591, STREET_WORLD.width - 2, 228);\n  ctx.strokeRect(1131, 226, 228, STREET_WORLD.height - 226);\n  ctx.strokeRect(2491, 226, 228, STREET_WORLD.height - 226);\n\n  // Asphalt roads\n  ctx.fillStyle = '#334155';\n  ctx.fillRect(0, 465, STREET_WORLD.width, 130);\n  ctx.fillRect(0, 1025, STREET_WORLD.width, 130);\n  ctx.fillRect(0, 1640, STREET_WORLD.width, 130);\n  ctx.fillRect(1180, 225, 130, STREET_WORLD.height - 225);\n  ctx.fillRect(2540, 225, 130, STREET_WORLD.height - 225);\n\n  // Crisp crosswalk stripes near main intersections\n  ctx.fillStyle = 'rgba(248, 250, 252, 0.72)';\n  [468, 1028, 1643].forEach((ry) => {\n    for (let s = 10; s < 120; s += 24) {\n      ctx.fillRect(1148, ry + s, 26, 12);\n      ctx.fillRect(1316, ry + s, 26, 12);\n      ctx.fillRect(2508, ry + s, 26, 12);\n      ctx.fillRect(2676, ry + s, 26, 12);\n    }\n  });\n\n  // Yellow dashed road centerlines\n  ctx.strokeStyle = '#FACC15';\n  ctx.lineWidth = 7;\n  ctx.setLineDash([30, 28]);\n  ctx.beginPath();\n  ctx.moveTo(0, 530); ctx.lineTo(STREET_WORLD.width, 530);\n  ctx.moveTo(0, 1090); ctx.lineTo(STREET_WORLD.width, 1090);\n  ctx.moveTo(0, 1705); ctx.lineTo(STREET_WORLD.width, 1705);\n  ctx.moveTo(1245, 230); ctx.lineTo(1245, STREET_WORLD.height);\n  ctx.moveTo(2605, 230); ctx.lineTo(2605, STREET_WORLD.height);\n  ctx.stroke();\n  ctx.setLineDash([]);\n\n  // Soccer pitch with field markings\n  const soccerLoc = locations.find((l) => l.id === 'soccer');\n  const sPitchX = soccerLoc ? soccerLoc.x : 2060;\n  const sPitchY = soccerLoc ? soccerLoc.y : 1400;\n  ctx.fillStyle = '#15803D';\n  ctx.fillRect(sPitchX - 170, sPitchY - 105, 340, 210);\n  ctx.strokeStyle = 'rgba(255,255,255,0.82)';\n  ctx.lineWidth = 6;\n  ctx.strokeRect(sPitchX - 156, sPitchY - 92, 312, 184);\n  ctx.beginPath();\n  ctx.moveTo(sPitchX, sPitchY - 92);\n  ctx.lineTo(sPitchX, sPitchY + 92);\n  ctx.stroke();\n  ctx.beginPath();\n  ctx.arc(sPitchX, sPitchY, 34, 0, Math.PI * 2);\n  ctx.stroke();\n\n  // Central Fountain Plaza\n  const plazaLoc = locations.find((l) => l.id === 'fountain_plaza');\n  const plazaX = plazaLoc ? plazaLoc.x : 280;\n  const plazaY = plazaLoc ? plazaLoc.y : 1420;\n  ctx.fillStyle = '#E2E8F0';\n  ctx.beginPath();\n  ctx.arc(plazaX, plazaY, 85, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#38BDF8';\n  ctx.beginPath();\n  ctx.arc(plazaX, plazaY, 44, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Central Leader Board & LED Billboard footprints\n  ctx.fillStyle = '#7C4D2B';\n  ctx.fillRect(670 - 38, 695 - 16, 76, 32);\n  ctx.fillStyle = '#FACC15';\n  ctx.fillRect(670 - 32, 695 - 10, 64, 20);\n\n  // Building footprints in world space (so building orientation aligns 1:1 with 3D buildings)\n  locations.forEach((loc) => {\n    if (loc.id === 'soccer' || loc.id === 'fountain_plaza') return;\n    const isTarget = loc.id === navTarget?.id;\n    const bw = loc.id === 'house' ? 148 : 118;\n    const bh = loc.id === 'house' ? 104 : 84;\n    ctx.fillStyle = 'rgba(15, 23, 42, 0.25)';\n    ctx.fillRect(loc.x - bw / 2 + 8, loc.y - bh / 2 + 10, bw, bh);\n    ctx.fillStyle = loc.color;\n    ctx.strokeStyle = isTarget ? '#FACC15' : '#0F172A';\n    ctx.lineWidth = isTarget ? 12 : 7;\n    ctx.fillRect(loc.x - bw / 2, loc.y - bh / 2, bw, bh);\n    ctx.strokeRect(loc.x - bw / 2, loc.y - bh / 2, bw, bh);\n  });\n\n  // Live Moving Street Vehicles (oriented along exact road travel vector)\n  const cars = Array.isArray(opts.streetCars) ? opts.streetCars : [];\n  cars.forEach((car) => {\n    const carAngle =\n      car.axis === 'h'\n        ? car.dir > 0\n          ? 0\n          : Math.PI\n        : car.dir > 0\n          ? Math.PI / 2\n          : -Math.PI / 2;\n    const carLen = car.kind === 'bus' ? 54 : car.kind === 'truck' ? 48 : car.kind === 'moto' || car.kind === 'bike' ? 28 : 38;\n    const carWid = car.kind === 'moto' || car.kind === 'bike' ? 16 : 22;\n\n    ctx.save();\n    ctx.translate(car.x, car.y);\n    ctx.rotate(carAngle);\n    // Vehicle body\n    ctx.fillStyle = car.color || '#EF4444';\n    ctx.strokeStyle = '#0F172A';\n    ctx.lineWidth = 5;\n    ctx.fillRect(-carLen / 2, -carWid / 2, carLen, carWid);\n    ctx.strokeRect(-carLen / 2, -carWid / 2, carLen, carWid);\n    // Front windshield / headlight nose indicator\n    ctx.fillStyle = '#E0F2FE';\n    ctx.fillRect(carLen * 0.12, -carWid * 0.34, carLen * 0.22, carWid * 0.68);\n    ctx.fillStyle = '#FEF08A';\n    ctx.fillRect(carLen * 0.42, -carWid * 0.36, 5, 6);\n    ctx.fillRect(carLen * 0.42, carWid * 0.36 - 6, 5, 6);\n    ctx.restore();\n  });\n\n  // Navigation Target Route & Animated Beacon in World Space\n  if (navTarget) {\n    const ringR = 46 + Math.sin(now / 160) * 14;\n    ctx.strokeStyle = '#EF4444';\n    ctx.lineWidth = 10;\n    ctx.beginPath();\n    ctx.arc(navTarget.x, navTarget.y, ringR, 0, Math.PI * 2);\n    ctx.stroke();\n\n    ctx.strokeStyle = '#FACC15';\n    ctx.lineWidth = 12;\n    ctx.setLineDash([32, 24]);\n    ctx.lineDashOffset = -(now / 6) % 112;\n    ctx.beginPath();\n    ctx.moveTo(me.x, me.y);\n    ctx.lineTo(navTarget.x, navTarget.y);\n    ctx.stroke();\n    ctx.setLineDash([]);\n  }\n\n  ctx.restore(); // back to logical screen-space (0..logicalW, 0..logicalH)\n\n  // Subtle radar distance ring centered on player\n  ctx.save();\n  ctx.strokeStyle = 'rgba(15, 23, 42, 0.16)';\n  ctx.lineWidth = 1;\n  ctx.setLineDash([3, 3]);\n  ctx.beginPath();\n  ctx.arc(cx, cy, 42, 0, Math.PI * 2);\n  ctx.stroke();\n  ctx.setLineDash([]);\n  ctx.restore();\n\n  // Upright Building / Landmark Icon Pins (and collect clickable hit targets)\n  if (opts.outPinHits) opts.outPinHits.length = 0;\n  locations.forEach((loc) => {\n    const scr = worldToScreen(loc.x, loc.y);\n    const isTarget = loc.id === navTarget?.id;\n    const distM = Math.round(Math.hypot(me.x - loc.x, me.y - loc.y) / 10);\n\n    if (opts.outPinHits && scr.x >= -10 && scr.x <= logicalW + 10 && scr.y >= -10 && scr.y <= logicalH + 10) {\n      opts.outPinHits.push({\n        id: loc.id,\n        name: loc.name,\n        icon: loc.icon,\n        nx: scr.x / logicalW,\n        ny: scr.y / logicalH,\n        distM\n      });\n    }\n\n    if (scr.x < -14 || scr.x > logicalW + 14 || scr.y < -14 || scr.y > logicalH + 14) return;\n    const pinR = isTarget ? 9.5 : 7.5;\n    ctx.save();\n    ctx.fillStyle = isTarget ? '#FEF08A' : '#FFFFFF';\n    ctx.strokeStyle = isTarget ? '#DC2626' : loc.color;\n    ctx.lineWidth = isTarget ? 2.2 : 1.8;\n    ctx.beginPath();\n    ctx.arc(scr.x, scr.y, pinR, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n    ctx.font = `${isTarget ? 10 : 8.5}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(loc.icon, scr.x, scr.y + 0.5);\n    ctx.restore();\n  });\n\n  // Upright Family Member Markers outside\n  state.members.forEach((m) => {\n    if (m.id === me.id || m.scene !== 'neighborhood') return;\n    const scr = worldToScreen(m.x, m.y);\n    if (scr.x < -10 || scr.x > logicalW + 10 || scr.y < -10 || scr.y > logicalH + 10) return;\n    ctx.save();\n    ctx.fillStyle = '#0EA5E9';\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.lineWidth = 1.8;\n    ctx.beginPath();\n    ctx.arc(scr.x, scr.y, 6.2, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n    ctx.strokeStyle = '#0F172A';\n    ctx.lineWidth = 0.9;\n    ctx.stroke();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 6.5px Fredoka, sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText((m.name || '?').slice(0, 1).toUpperCase(), scr.x, scr.y + 0.3);\n    ctx.restore();\n  });\n\n  // Upright Foreign English-speaking NPCs (Mr. Alex & Ms. Emma)\n  const npcs = Array.isArray(opts.foreignNpcs) ? opts.foreignNpcs : [];\n  npcs.forEach((npc) => {\n    const scr = worldToScreen(npc.x, npc.y);\n    if (scr.x < -10 || scr.x > logicalW + 10 || scr.y < -10 || scr.y > logicalH + 10) return;\n    ctx.save();\n    ctx.fillStyle = npc.gender === 'female' ? '#EC4899' : '#2563EB';\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.lineWidth = 1.8;\n    ctx.beginPath();\n    ctx.arc(scr.x, scr.y, 6, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 6px Fredoka, sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(npc.gender === 'female' ? 'E' : 'A', scr.x, scr.y + 0.3);\n    ctx.restore();\n  });\n\n  // Player Field-of-View cone & directional arrow aligned to player's exact 3D screen facing!\n  const playerScreenAngle = playerWorldAngle + mapRot;\n  ctx.save();\n  const fovGrad = ctx.createRadialGradient(cx, cy, 4, cx, cy, 36);\n  fovGrad.addColorStop(0, 'rgba(250, 204, 21, 0.5)');\n  fovGrad.addColorStop(1, 'rgba(250, 204, 21, 0)');\n  ctx.fillStyle = fovGrad;\n  ctx.beginPath();\n  ctx.moveTo(cx, cy);\n  ctx.arc(cx, cy, 36, playerScreenAngle - 0.46, playerScreenAngle + 0.46);\n  ctx.closePath();\n  ctx.fill();\n\n  // Player directional chevron at center (pointing along playerScreenAngle)\n  ctx.translate(cx, cy);\n  ctx.rotate(playerScreenAngle + Math.PI / 2);\n  ctx.fillStyle = '#FACC15';\n  ctx.strokeStyle = '#0F172A';\n  ctx.lineWidth = 1.9;\n  ctx.beginPath();\n  ctx.moveTo(0, -8);\n  ctx.lineTo(6, 6);\n  ctx.lineTo(0, 2.8);\n  ctx.lineTo(-6, 6);\n  ctx.closePath();\n  ctx.fill();\n  ctx.stroke();\n\n  ctx.fillStyle = '#FFFFFF';\n  ctx.beginPath();\n  ctx.arc(0, 0.5, 1.7, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.restore();\n\n  // Edge directional indicator when navigation target is off-canvas\n  if (navTarget) {\n    const scr = worldToScreen(navTarget.x, navTarget.y);\n    const rx = scr.x - cx;\n    const ry = scr.y - cy;\n    const margin = 12;\n    const ang = Math.atan2(ry, rx);\n    const clampedX = Math.max(margin, Math.min(logicalW - margin, scr.x));\n    const clampedY = Math.max(margin, Math.min(logicalH - margin, scr.y));\n    const isOffscreen = scr.x < margin || scr.x > logicalW - margin || scr.y < margin || scr.y > logicalH - margin;\n\n    if (isOffscreen || Math.hypot(rx, ry) > 20) {\n      const distRatio = isOffscreen ? 1 : 0.68;\n      const ax = isOffscreen ? clampedX : cx + Math.cos(ang) * Math.min(28, Math.hypot(rx, ry) * distRatio);\n      const ay = isOffscreen ? clampedY : cy + Math.sin(ang) * Math.min(28, Math.hypot(rx, ry) * distRatio);\n      ctx.save();\n      ctx.translate(ax, ay);\n      ctx.rotate(ang);\n      ctx.fillStyle = '#EF4444';\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 1.7;\n      ctx.beginPath();\n      ctx.moveTo(8, 0);\n      ctx.lineTo(-4.8, -5);\n      ctx.lineTo(-2.2, 0);\n      ctx.lineTo(-4.8, 5);\n      ctx.closePath();\n      ctx.fill();\n      ctx.stroke();\n      ctx.restore();\n    }\n  }\n\n  // Rotating Compass \"N\" marker on top-right corner\n  const northScreenAngle = -Math.PI / 2 + mapRot;\n  const compX = logicalW - 15;\n  const compY = 15;\n  const nx = compX + Math.cos(northScreenAngle) * 8;\n  const ny = compY + Math.sin(northScreenAngle) * 8;\n  ctx.save();\n  ctx.fillStyle = 'rgba(15, 23, 42, 0.88)';\n  ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';\n  ctx.lineWidth = 1;\n  ctx.beginPath();\n  ctx.arc(compX, compY, 10.5, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.stroke();\n  ctx.fillStyle = '#EF4444';\n  ctx.beginPath();\n  ctx.arc(nx, ny, 2.4, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#FFFFFF';\n  ctx.font = 'bold 8px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('N', compX, compY + 0.5);\n  ctx.restore();\n\n  ctx.restore();\n}\n\n\n"},{"path":"src/hooks/usePWAInstall.ts","encoding":"utf8","content":"import { useEffect, useState } from 'react';\n\ninterface BeforeInstallPromptEvent extends Event {\n  prompt: () => Promise<void>;\n  userChoice: Promise<{ outcome: 'accepted' | 'dismissed'; platform: string }>;\n}\n\nexport function usePWAInstall() {\n  const [deferredPrompt, setDeferredPrompt] = useState<BeforeInstallPromptEvent | null>(null);\n  const [isInstalled, setIsInstalled] = useState(false);\n  const [isIOS, setIsIOS] = useState(false);\n\n  useEffect(() => {\n    const isStandalone =\n      window.matchMedia('(display-mode: standalone)').matches ||\n      (window.navigator as unknown as { standalone?: boolean }).standalone === true;\n    setIsInstalled(isStandalone);\n\n    const userAgent = window.navigator.userAgent.toLowerCase();\n    setIsIOS(/iphone|ipad|ipod/.test(userAgent));\n\n    const handleBeforeInstallPrompt = (e: Event) => {\n      e.preventDefault();\n      setDeferredPrompt(e as BeforeInstallPromptEvent);\n    };\n\n    const handleAppInstalled = () => {\n      setIsInstalled(true);\n      setDeferredPrompt(null);\n    };\n\n    window.addEventListener('beforeinstallprompt', handleBeforeInstallPrompt);\n    window.addEventListener('appinstalled', handleAppInstalled);\n\n    return () => {\n      window.removeEventListener('beforeinstallprompt', handleBeforeInstallPrompt);\n      window.removeEventListener('appinstalled', handleAppInstalled);\n    };\n  }, []);\n\n  const install = async () => {\n    if (!deferredPrompt) return false;\n    await deferredPrompt.prompt();\n    const { outcome } = await deferredPrompt.userChoice;\n    if (outcome === 'accepted') {\n      setIsInstalled(true);\n      setDeferredPrompt(null);\n      return true;\n    }\n    return false;\n  };\n\n  return {\n    isInstallable: !!deferredPrompt,\n    isInstalled,\n    isIOS,\n    install,\n  };\n}\n\nexport function useOnlineStatus() {\n  const [isOnline, setIsOnline] = useState(\n    typeof navigator !== 'undefined' ? navigator.onLine : true\n  );\n\n  useEffect(() => {\n    const handleOnline = () => setIsOnline(true);\n    const handleOffline = () => setIsOnline(false);\n\n    window.addEventListener('online', handleOnline);\n    window.addEventListener('offline', handleOffline);\n\n    return () => {\n      window.removeEventListener('online', handleOnline);\n      window.removeEventListener('offline', handleOffline);\n    };\n  }, []);\n\n  return isOnline;\n}\n"},{"path":"src/index.css","encoding":"utf8","content":"@import \"tailwindcss\";\n\n.word-token {\n  display: inline-block;\n  padding: 1px 4px;\n  margin: 1px 1px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: background-color 0.15s ease, transform 0.12s ease;\n  border-bottom: 2px dashed rgba(22, 160, 133, 0.45);\n}\n\n.word-token:hover {\n  background-color: #FEF9E7;\n  color: #D35400;\n  transform: translateY(-1px);\n}\n\n.word-token.active-token {\n  background-color: #FFE66D;\n  color: #2C3E50;\n  font-weight: 700;\n}\n"},{"path":"src/main.tsx","encoding":"utf8","content":"import { createRoot } from 'react-dom/client';\nimport { registerSW } from 'virtual:pwa-register';\nimport App from './App.tsx';\nimport './index.css';\nimport { initB2KSGameEngine } from './game/b2ksGameEngine';\n\n(window as unknown as { __B2KS_BOOTED__?: boolean }).__B2KS_BOOTED__ = true;\n\ntry {\n  const hadController = Boolean(typeof navigator !== 'undefined' && navigator.serviceWorker?.controller);\n  let reloadedForUpdate = false;\n  if (typeof navigator !== 'undefined' && navigator.serviceWorker) {\n    navigator.serviceWorker.addEventListener('controllerchange', () => {\n      if (hadController && !reloadedForUpdate) {\n        reloadedForUpdate = true;\n        window.location.reload();\n      }\n    });\n  }\n  const updateSW = registerSW({\n    immediate: true,\n    onRegisteredSW(_swUrl, registration) {\n      if (registration) {\n        registration.update().catch(() => {});\n      }\n    },\n    onNeedRefresh() {\n      updateSW(true).catch(() => {});\n    },\n  });\n} catch {\n  // ignore service worker registration errors in restricted contexts\n}\n\nfunction bootB2KS() {\n  initB2KSGameEngine();\n  const rootEl = document.getElementById('root');\n  if (rootEl) {\n    createRoot(rootEl).render(<App />);\n  }\n}\n\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', bootB2KS, { once: true });\n} else {\n  bootB2KS();\n}\n"},{"path":"src/types/b2ks.ts","encoding":"utf8","content":"export interface LabItemSpec {\n  primaryShape: string;\n  secondaryTrait?: string | null;\n  color: string;\n  accent: string;\n  isRainbow?: boolean;\n  hasWings?: boolean;\n  hasWheels?: boolean;\n  hasLegs?: boolean;\n  hasFishTail?: boolean;\n  hasCrown?: boolean;\n  hasHalo?: boolean;\n  hasFire?: boolean;\n  hasBubbles?: boolean;\n  hasGlasses?: boolean;\n  hasAntenna?: boolean;\n  hasStars?: boolean;\n  pattern?: string;\n  material?: string;\n  seed?: number;\n  rarity?: string;\n  sizeTier?: 'small' | 'medium' | 'large' | 'giant';\n  sizeScale?: number;\n  wingCount?: 2 | 4;\n  wingStyle?: 'feather' | 'angel' | 'dragon' | 'butterfly' | 'cyber';\n  hasExhaust?: boolean;\n  hasHeadlights?: boolean;\n  hasPropeller?: boolean;\n  hasCape?: boolean;\n}\n\nexport interface CustomLabItem {\n  id: string;\n  category: string;\n  isLabItem: boolean;\n  name: string;\n  icon: string;\n  prompt: string;\n  desc: string;\n  labSpec: LabItemSpec;\n  svgMarkup: string;\n}\n\nexport interface EnglishQuizRecord {\n  date: string;\n  score: number;\n  total: number;\n  stars: number;\n  ts: number;\n  grade?: 6 | 7 | 8 | 9;\n  unit?: number;\n}\n\nexport interface EnglishGradeProgress {\n  unit: number;\n  highScoreStreak: number;\n}\n\nexport type PetStage = 0 | 1 | 2 | 3 | 4;\nexport type PetGender = 'male' | 'female';\nexport type PetVariantId = 'classic' | 'pastel' | 'royal' | 'cosmic' | 'golden';\n\nexport interface PetVariantDef {\n  id: PetVariantId;\n  label: string;\n  rarityLabel: string;\n  chancePercent: number;\n  badgeColor: string;\n}\n\nexport interface PetAccessoryDef {\n  id: string;\n  name: string;\n  icon: string;\n  price: number;\n  desc: string;\n}\n\nexport interface PetStageDef {\n  stage: PetStage;\n  title: string;\n  minXp: number;\n  scale: number;\n  speedBonus: number;\n  starBonus: number;\n}\n\nexport interface PetSpeciesDef {\n  id: string;\n  name: string;\n  eggName: string;\n  eggIcon: string;\n  eggPrice: number;\n  primaryColor: string;\n  accentColor: string;\n  statLabel: string;\n  desc: string;\n  hungerDecayPerMin: number;\n  stages: PetStageDef[];\n}\n\nexport interface PetFoodDef {\n  id: string;\n  name: string;\n  icon: string;\n  price: number;\n  xpGain: number;\n  hungerGain: number;\n  desc: string;\n}\n\nexport interface OwnedPet {\n  id: string;\n  speciesId: string;\n  nickname: string;\n  hatched: boolean;\n  hatchProgress: number; // 0..100 (100 = ready to hatch / hatched)\n  xp: number;\n  level: number;\n  stage: PetStage;\n  hunger: number; // 0..100\n  lastFedAt: number;\n  obtainedAt: number;\n  gender?: PetGender;\n  variant?: PetVariantId;\n  accessoryId?: string | null;\n}\n\nexport type BuildingShape = 'classic' | 'modern' | 'pavilion' | 'castle';\n\nexport interface BuildingLayoutOverride {\n  x: number;\n  y: number;\n  shape?: BuildingShape;\n}\n\nexport interface NavDestination {\n  id: string;\n  name: string;\n  icon: string;\n  category: 'home' | 'shop' | 'learn' | 'play';\n  x: number;\n  y: number;\n  color: string;\n  shape?: BuildingShape;\n}\n\nexport type BgmThemeId =\n  | 'sunny_town'\n  | 'adventure_rpg'\n  | 'cozy_lullaby'\n  | 'retro_chiptune'\n  | 'calm_forest';\n\nexport interface BgmThemeDef {\n  id: BgmThemeId;\n  name: string;\n  icon: string;\n  desc: string;\n  stepMs: number;\n  oscType: OscillatorType;\n  bassType: OscillatorType;\n  melody: number[];\n  bass: number[];\n  chordType?: OscillatorType;\n  chords?: number[][];\n  leadDurFactor?: number;\n  leadGain?: number;\n  bassGain?: number;\n  chordGain?: number;\n  filterFreq?: number;\n  percussion?: ('kick' | 'snare' | 'hat' | 'wood' | null)[];\n}\n\nexport type WeatherCondition = 'clear' | 'cloudy' | 'rain' | 'thunder' | 'fog' | 'snow';\n\nexport interface WeatherInfo {\n  condition: WeatherCondition;\n  label: string;\n  icon: string;\n  tempC: number;\n  windKmh: number;\n  locationLabel: string;\n  isDay: boolean;\n  updatedAt: number;\n}\n\nexport interface SoccerPlayerInput {\n  playerId: string;\n  dx: number;\n  dy: number;\n  kickSeq: number;\n  kickTx?: number;\n  kickTy?: number;\n  ts: number;\n}\n\nexport type PenaltyZoneId = 'TL' | 'BL' | 'C' | 'BR' | 'TR';\n\nexport interface PenaltyPickPayload {\n  kickIndex: number;\n  playerId: string;\n  zone: PenaltyZoneId;\n  ts: number;\n}\n\nexport interface SoccerOnlineRoom {\n  status: 'idle' | 'lobby' | 'playing' | 'finished';\n  rev?: number;\n  matchId?: string;\n  modeKind?: 'penalty' | 'realtime';\n  hostId: string;\n  p1Id: string;\n  p1Name: string;\n  p2Id: string | null;\n  p2Name: string | null;\n  p1Goals: number;\n  p2Goals: number;\n  timeLeft: number;\n  p1x: number;\n  p1y: number;\n  p1Dir: string;\n  p1Moving: boolean;\n  p2x: number;\n  p2y: number;\n  p2Dir: string;\n  p2Moving: boolean;\n  bx: number;\n  by: number;\n  bvx: number;\n  bvy: number;\n  goalBannerText: string;\n  goalBannerUntil: number;\n  readyMap?: Record<string, boolean>;\n  phase?: 'choosing' | 'animating';\n  kickIndex?: number;\n  maxKicks?: number;\n  p1History?: ('G' | 'M')[];\n  p2History?: ('G' | 'M')[];\n  turnDeadlineAt?: number;\n  animStartedAt?: number;\n  lastShotZone?: PenaltyZoneId | null;\n  lastSaveZone?: PenaltyZoneId | null;\n  lastResult?: 'goal' | 'saved' | null;\n  lastShooterId?: string | null;\n  shotLockedBy?: string | null;\n  saveLockedBy?: string | null;\n  updatedAt: number;\n}\n\nexport type AchievementId =\n  | 'first_task'\n  | 'tasks_10'\n  | 'tasks_50'\n  | 'tasks_100'\n  | 'eng_words_50'\n  | 'eng_words_200'\n  | 'eng_words_500'\n  | 'eng_quiz_perfect'\n  | 'eng_quiz_10'\n  | 'speak_first'\n  | 'speak_95'\n  | 'speak_lv3'\n  | 'speak_lv5'\n  | 'comic_5'\n  | 'pet_first'\n  | 'zoo_10';\n\nexport type AchievementCategory = 'tasks' | 'english' | 'world';\n\nexport interface AchievementDef {\n  id: AchievementId;\n  title: string;\n  description: string;\n  icon: string;\n  category: AchievementCategory;\n  color: string;\n  target: number;\n}\n\nexport type SpeakingLevel = 1 | 2 | 3 | 4 | 5;\n\nexport interface SpeakingBankQuestion {\n  id: string;\n  level: SpeakingLevel;\n  topic: string;\n  sentence: string;\n  meaningVi: string;\n  custom?: boolean;\n}\n\nexport type SpeakingSentence = SpeakingBankQuestion;\n\nexport interface SpeakingAttemptRecord {\n  date?: string;\n  sentenceId?: string;\n  sentence: string;\n  spoken?: string;\n  accuracy: number;\n  level: number;\n  stars: number;\n  npcName?: string;\n  ts: number;\n}\n\nexport type RobotSkinId = 'doraemon' | 'doraemi' | 'gundam' | 'walle';\n\nexport interface RobotReminderItem {\n  id: string;\n  text: string;\n  startAt: number;\n  endAt: number;\n  createdBy: string;\n  createdAt?: number;\n}\n\nexport type RobotReminder = RobotReminderItem;\n\nexport interface HelperRobotConfig {\n  skin: RobotSkinId;\n  reminders: RobotReminderItem[];\n  updatedAt: number;\n}\n\nexport interface ForeignNpcState {\n  id: 'npc_alex' | 'npc_emma';\n  name: string;\n  gender: 'male' | 'female';\n  x: number;\n  y: number;\n  dir: string;\n  waypointIdx: number;\n  isPaused: boolean;\n  isMoving: boolean;\n  facingYaw: number;\n  speechText: string;\n}\n\nexport interface HelperRobotRenderItem {\n  childId: string;\n  childName: string;\n  skin: RobotSkinId;\n  scene: 'neighborhood' | 'house' | 'private_room';\n  privateRoomId?: string | null;\n  x: number;\n  y: number;\n  isFollowing: boolean;\n  isMoving?: boolean;\n  reminderText: string;\n  facingYaw: number;\n}\n\nexport interface Member {\n  id: string;\n  name: string;\n  age?: number;\n  role: string;\n  points: number;\n  hairStyle: string;\n  hairColor: string;\n  shirtColor: string;\n  shirtPattern: string;\n  pantsColor: string;\n  pantsStyle: string;\n  outfit: string;\n  inventory: string[];\n  vouchers: string[];\n  roomUnlocked: boolean;\n  roomWall: string;\n  roomDecor: { id: string; icon: string; x: number; y: number }[];\n  roomSlots?: Record<string, string>;\n  roomSlotSpecs?: Record<string, CustomLabItem>;\n  roomDecorSpecs?: Record<string, CustomLabItem>;\n  inventoryConsumedMigrated?: boolean;\n  customLabItems?: CustomLabItem[];\n  unlockedZooAnimals?: string[];\n  englishQuizHistory?: EnglishQuizRecord[];\n  englishProgress?: Record<number, EnglishGradeProgress>;\n  unlockedAchievements?: Array<{ id: AchievementId; unlockedAt: number }>;\n  englishWordsUsed?: string[];\n  completedTaskCount?: number;\n  speakingLevel?: number;\n  speakingStreak?: number;\n  speakingHistory?: SpeakingAttemptRecord[];\n  bibleProgress?: BibleQuizProgress;\n  helperRobot?: HelperRobotConfig;\n  pets?: OwnedPet[];\n  activePetId?: string | null;\n  petFoodInventory?: Record<string, number>;\n  petAccessories?: string[];\n  memberUpdatedAt?: number;\n  nameUpdatedAt?: number;\n  pointsUpdatedAt?: number;\n  adminPointsUpdatedAt?: number;\n  englishChatStats?: {\n    date: string;\n    count: number;\n    lastRewardAt: number;\n    recentPhrases: string[];\n  };\n  comicReadStats?: {\n    date: string;\n    count: number;\n    lastReadAt: number;\n    completedIds: string[];\n  };\n  scene: 'neighborhood' | 'house' | 'private_room';\n  privateRoomId?: string | null;\n  x: number;\n  y: number;\n  dir: string;\n  speech: { text: string; isEng: boolean; expiresAt: number } | null;\n  tvSecondsUsedToday?: number;\n  tvBonusSecondsToday?: number;\n  tvLastDate?: string;\n}\n\nexport interface TaskItem {\n  id: number;\n  type: 'chore' | 'homework' | 'family_quest';\n  title: string;\n  creatorId: string;\n  assigneeId: string;\n  participantIds?: string[];\n  progressMap?: Record<string, 'pending' | 'done'>;\n  reward: number;\n  status: 'pending' | 'submitted' | 'completed';\n  createdAt: number;\n  completedAt: number | null;\n  deadline?: number | null;\n  submittedAt?: number | null;\n  parentFile?: string | null;\n  parentFileName?: string;\n  childFile?: string | null;\n  childFileName?: string;\n  childNote?: string;\n  grade?: number | null;\n}\n\nexport interface CrossWorldItem {\n  id: string;\n  name: string;\n  icon: string;\n  category: 'money' | 'privilege';\n  pointsCost: number;\n  realValue: string;\n  quantity: number;\n}\n\nexport interface CrossWorldRequest {\n  id: string;\n  childId: string;\n  childName: string;\n  itemId: string;\n  itemName: string;\n  itemIcon: string;\n  pointsCost: number;\n  realValue: string;\n  status: 'pending' | 'approved' | 'rejected';\n  createdAt: number;\n  approvedAt?: number | null;\n  approvedBy?: string | null;\n}\n\nexport interface FleaMarketListing {\n  id: string;\n  sellerId: string;\n  sellerName: string;\n  itemId: string;\n  itemName: string;\n  itemIcon: string;\n  itemDesc: string;\n  itemKind: 'inventory' | 'lab';\n  labItemData?: CustomLabItem | null;\n  price: number;\n  createdAt: number;\n}\n\nexport interface ActivityLogEntry {\n  id: string;\n  memberId: string;\n  memberName: string;\n  action:\n    | 'task_done'\n    | 'quest_part'\n    | 'quiz_done'\n    | 'speaking_done'\n    | 'bible_done'\n    | 'achievement_unlock'\n    | 'achievement_unlocked'\n    | 'cross_world'\n    | 'flea_market'\n    | 'zoo_unlock'\n    | 'pet_adopt'\n    | 'pet_evolve'\n    | 'gift_points'\n    | 'admin_points'\n    | 'read_comic'\n    | 'member_add'\n    | 'member_remove';\n  detail: string;\n  taskId?: number;\n  pointsDelta?: number;\n  ts: number;\n}\n\nexport type ActivityConfigId =\n  | 'english_chat'\n  | 'eat'\n  | 'sleep'\n  | 'park_rest'\n  | 'english_quiz_per_correct'\n  | 'english_quiz_high_bonus'\n  | 'homework_high_bonus'\n  | 'read_comic';\n\nexport interface ActivityConfigItem {\n  id: ActivityConfigId;\n  label: string;\n  desc: string;\n  reward: number;\n  enabled: boolean;\n  cooldownMs?: number;\n  maxPerDay?: number;\n  unitLabel?: string;\n}\n\nexport interface EnglishQuestion {\n  id: string;\n  cat: 'grammar' | 'vocab';\n  grade?: 6 | 7 | 8 | 9;\n  unit?: number;\n  unitTitle?: string;\n  q: string;\n  opts: [string, string, string, string];\n  ans: number;\n  exp: string;\n  custom?: boolean;\n}\n\nexport type BibleQuestionCategory = 'fact' | 'image' | 'verse' | 'parable';\n\nexport interface BibleQuestion {\n  id: string;\n  category: BibleQuestionCategory;\n  visualId?: string;\n  q: string;\n  opts: [string, string, string, string];\n  ans: 0 | 1 | 2 | 3;\n  bookEn: string;\n  bookVi: string;\n  ref: string;\n  verseEn: string;\n  verseVi: string;\n  custom?: boolean;\n}\n\nexport interface BibleQuizProgress {\n  correctCounts: Record<string, number>;\n  streak: number;\n  totalCorrect: number;\n  totalAnswered: number;\n  updatedAt?: number;\n}\n\nexport interface ZooAnimal {\n  id: string;\n  nameEn: string;\n  nameVi: string;\n  wikiTitle: string;\n  ecosystem: string;\n  emoji: string;\n  unlockCost: number;\n  description: string;\n}\n\nexport interface B2KSState {\n  currentUserId: string;\n  familyName?: string;\n  familyNameUpdatedAt?: number;\n  gamePassword?: string;\n  gamePasswordUpdatedAt?: number;\n  parentPin: string;\n  parentPinUpdatedAt: number;\n  updatedAt: number;\n  familyMessages: unknown[];\n  house: { plotIndex: number; style: string };\n  houseUpdatedAt?: number;\n  buildingLayouts?: Record<string, BuildingLayoutOverride>;\n  buildingLayoutsUpdatedAt?: number;\n  billboardText?: string;\n  billboardUpdatedAt?: number;\n  bgmTheme?: BgmThemeId;\n  members: Member[];\n  tasks: TaskItem[];\n  tasksUpdatedAt?: number;\n  crossWorldItems: CrossWorldItem[];\n  crossWorldRequests: CrossWorldRequest[];\n  fleaMarketListings: FleaMarketListing[];\n  activityLogs: ActivityLogEntry[];\n  activityConfigs?: Record<ActivityConfigId, ActivityConfigItem>;\n  activityConfigsUpdatedAt?: number;\n  dailyParentAllowance?: number;\n  maxParentPoints?: number;\n  maxParentPointsUpdatedAt?: number;\n  englishQuestions: EnglishQuestion[];\n  chatHistory: { sender: string; text: string; isEng: boolean; ts?: number }[];\n  lastDailyReset: string;\n}\n\nexport interface OtherFamilySummary {\n  slug: string;\n  familyName: string;\n  updatedAt: number;\n  dailyParentAllowance?: number;\n  maxParentPoints?: number;\n  deleted?: boolean;\n  members: Array<{\n    id: string;\n    name: string;\n    role: string;\n    age?: number;\n    outfit?: string;\n    points: number;\n  }>;\n}\n\nexport interface AdminNeighborhoodRecord {\n  slug: string;\n  familyName: string;\n  updatedAt: number;\n  dailyParentAllowance: number;\n  maxParentPoints: number;\n  memberCount: number;\n  kidCount: number;\n  parents: Array<{\n    id: string;\n    name: string;\n    role: string;\n    points: number;\n  }>;\n}\n\nexport type ActiveReactModal =\n  | null\n  | 'cross_world'\n  | 'flea_market'\n  | 'virtual_zoo'\n  | 'parental_dashboard'\n  | 'comic_library'\n  | 'admin_panel'\n  | 'achievements'\n  | 'speaking_practice'\n  | 'church_bible';\n\nexport interface B2KSBridge {\n  getState: () => B2KSState;\n  getCurrentUser: () => Member;\n  isParent: (member: Member) => boolean;\n  getFirebaseUrl: () => string;\n  saveGame: (pushCloud?: boolean) => void;\n  updateHUD: () => void;\n  showToast: (msg: string) => void;\n  requestParentAccess: (cb: () => void) => void;\n  playCoin: () => void;\n  playClick: () => void;\n  playSuccess: () => void;\n  playError: () => void;\n  triggerConfetti: () => void;\n  triggerSpeechBubble: (member: Member, text: string, isEng: boolean) => void;\n  logActivity: (entry: Omit<ActivityLogEntry, 'id' | 'ts'>) => void;\n  speakEnglish: (text: string, rate?: number) => void;\n  speakEnglishWithGender?: (text: string, gender: 'male' | 'female', rate?: number) => void;\n  syncEnglishBankToFirebase: (questions: EnglishQuestion[]) => void;\n  syncCrossWorldRequestsToFirebase: (reqs: CrossWorldRequest[]) => void;\n  syncFleaMarketToFirebase: (listings: FleaMarketListing[]) => void;\n  syncActivityLogsToFirebase: (logs: ActivityLogEntry[]) => void;\n  findCatalogItem: (id: string) => {\n    id: string;\n    name: string;\n    icon?: string;\n    desc?: string;\n    category?: string;\n    sub?: string;\n    labSpec?: LabItemSpec;\n    svgMarkup?: string;\n  } | null;\n  renderItemSVG: (id: string, size?: number) => string;\n  openReactModal: (modal: ActiveReactModal) => void;\n  closeReactModal: () => void;\n  openParentMiniWindow?: () => void;\n  getMemberLocationLabel?: (m: Member) => string;\n  claimComicReadReward?: (comicId: string, comicTitle: string) => { ok: boolean; awarded: number; msg: string };\n  getFamilyName?: () => string;\n  setFamilyName?: (name: string) => { ok: boolean; msg: string };\n  getResolvedLocations?: () => NavDestination[];\n  setBuildingLayouts?: (layouts: Record<string, BuildingLayoutOverride>) => void;\n  resetBuildingLayouts?: () => void;\n  getBillboardText?: () => string;\n  setBillboardText?: (nextText: string) => { ok: boolean; msg: string };\n  setGamePassword?: (nextPw: string) => { ok: boolean; msg: string };\n  setParentPin?: (nextPin: string) => { ok: boolean; msg: string };\n  updateMemberProfile?: (memberId: string, updates: { name?: string; age?: number; role?: string }) => { ok: boolean; msg: string };\n  addMember?: (name: string, role: string, age?: number) => { ok: boolean; msg: string; member?: Member };\n  removeMember?: (memberId: string) => { ok: boolean; msg: string };\n  fetchOtherFamiliesDirectory?: () => Promise<OtherFamilySummary[]>;\n  getBgmTheme?: () => BgmThemeId;\n  setBgmTheme?: (themeId: BgmThemeId) => void;\n  isAudioMuted?: () => boolean;\n  toggleAudioMuted?: () => boolean;\n  setAudioTempPaused?: (paused: boolean) => void;\n  getNotificationStatus?: () => {\n    supported: boolean;\n    permission: NotificationPermission | 'unsupported';\n    hasServiceWorker: boolean;\n    enabled?: boolean;\n  };\n  requestNotificationPermission?: () => Promise<{ ok: boolean; permission: string; msg: string }>;\n  sendTestNotification?: () => Promise<boolean>;\n  setGameUnlocked?: (unlocked: boolean) => void;\n  authenticateFamilyLogin?: (familyName: string, enteredPassword: string) => Promise<{ ok: boolean; msg: string; familyName: string }>;\n  getLastLoginFamilyName?: () => string;\n  getWeatherInfo?: () => WeatherInfo;\n  refreshWeather?: (useGeolocation?: boolean) => Promise<WeatherInfo>;\n  getMemberPresenceMap?: () => Record<string, { online: boolean; lastSeenAt: number }>;\n  getActiveFamilySlug?: () => string;\n  isB2KSDad?: () => boolean;\n  getGlobalEnglishBank?: () => EnglishQuestion[];\n  importEnglishBankQuestions?: (incoming: EnglishQuestion[], mode?: 'merge' | 'replace') => { ok: boolean; added: number; updated: number; total: number; msg: string };\n  resetEnglishBankToDefault?: () => { ok: boolean; total: number; msg: string };\n  approveFamilyQuest?: (taskId: number) => void;\n  evaluateMemberAchievementsById?: (memberId: string) => void;\n  getGlobalSpeakingBank?: () => SpeakingBankQuestion[];\n  addSpeakingSentence?: (input: { level: SpeakingLevel; topic: string; sentence: string; meaningVi: string }) => { ok: boolean; msg: string };\n  deleteSpeakingSentence?: (id: string) => { ok: boolean; msg: string };\n  importSpeakingBankSentences?: (incoming: SpeakingBankQuestion[], mode?: 'merge' | 'replace') => { ok: boolean; added: number; updated: number; total: number; msg: string };\n  resetSpeakingBankToDefault?: () => { ok: boolean; total: number; msg: string };\n  getActiveSpeakingNpc?: () => { id: string; name: string; gender: 'male' | 'female' } | null;\n  submitSpeakingResult?: (payload: {\n    npcId: string;\n    npcName: string;\n    npcGender?: 'male' | 'female';\n    sentenceId: string;\n    sentence?: string;\n    targetText?: string;\n    spokenText: string;\n    accuracy: number;\n  }) => {\n    accuracy: number;\n    awarded: number;\n    starsEarned: number;\n    passed: boolean;\n    newLevel: SpeakingLevel;\n    newStreak: number;\n    leveledUp: boolean;\n    msg: string;\n  };\n  getGlobalBibleBank?: () => BibleQuestion[];\n  addBibleQuestion?: (input: Omit<BibleQuestion, 'id' | 'custom'> & { id?: string }) => { ok: boolean; msg: string; question?: BibleQuestion };\n  deleteBibleQuestion?: (id: string) => { ok: boolean; msg: string };\n  importBibleBankQuestions?: (incoming: BibleQuestion[], mode?: 'merge' | 'replace') => { ok: boolean; added: number; updated: number; total: number; msg: string };\n  resetBibleBankToDefault?: () => { ok: boolean; total: number; msg: string };\n  submitBibleAnswer?: (\n    questionId: string,\n    selectedIndex: number\n  ) => {\n    correct: boolean;\n    awarded: number;\n    baseAwarded: number;\n    streakBonus: number;\n    newStreak: number;\n    questionCorrectCount: number;\n    retired: boolean;\n    bookEn: string;\n    bookVi: string;\n    ref: string;\n    verseEn: string;\n    verseVi: string;\n    msg: string;\n  };\n  getMaxParentPoints?: () => number;\n  adminListNeighborhoods?: () => Promise<AdminNeighborhoodRecord[]>;\n  adminCreateNeighborhood?: (familyName: string, dadName?: string, momName?: string) => Promise<{ ok: boolean; msg: string; slug?: string }>;\n  adminDeleteNeighborhood?: (slug: string) => Promise<{ ok: boolean; msg: string }>;\n  adminResetNeighborhoodPasswords?: (slug: string) => Promise<{ ok: boolean; msg: string }>;\n  adminAdjustParentAccount?: (\n    slug: string,\n    payload: { dailyParentAllowance?: number; maxParentPoints?: number; parentPoints?: Record<string, number> }\n  ) => Promise<{ ok: boolean; msg: string }>;\n  subscribe: (fn: () => void) => () => void;\n}\n\ndeclare global {\n  interface Window {\n    B2KS?: B2KSBridge;\n    __OPEN_B2KS_MODAL__?: (modal: ActiveReactModal) => void;\n    __OPEN_PARENT_MINI__?: () => void;\n    __ON_FAMILY_LOGIN_SUCCESS__?: () => void;\n    openSmartphoneModal?: (view?: 'home' | 'messenger' | 'tasks' | 'maps' | 'robot', targetId?: string) => void;\n    toggleMinimapCollapsed?: () => void;\n  }\n}\n"},{"path":"tsconfig.json","encoding":"utf8","content":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\", \"vite-plugin-pwa/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"exclude\": [\"dist\"]\n}\n"},{"path":"vite.config.ts","encoding":"utf8","content":"import tailwindcss from '@tailwindcss/vite';\nimport react from '@vitejs/plugin-react';\nimport fs from 'fs';\nimport path from 'path';\nimport {defineConfig} from 'vite';\nimport {VitePWA} from 'vite-plugin-pwa';\n\nexport default defineConfig(() => {\n  return {\n    base: './',\n    plugins: [\n      react(),\n      tailwindcss(),\n      VitePWA({\n        registerType: 'autoUpdate',\n        includeAssets: ['icon.svg', 'apple-touch-icon.png', 'animals.json', 'pwa-192x192.png', 'pwa-512x512.png'],\n        manifest: {\n          id: './',\n          name: 'B2KS Daily Routines - RPG Gia Đình',\n          short_name: 'B2KS Game',\n          description: 'Webgame RPG gia đình B2KS: Nhiệm vụ hằng ngày, Sở thú ảo, Trung tâm giao dịch, Chợ trời và Phòng thí nghiệm sáng tạo.',\n          theme_color: '#2C3E50',\n          background_color: '#2C3E50',\n          display: 'standalone',\n          start_url: './',\n          scope: './',\n          icons: [\n            {\n              src: './pwa-192x192.png',\n              sizes: '192x192',\n              type: 'image/png',\n              purpose: 'any',\n            },\n            {\n              src: './pwa-512x512.png',\n              sizes: '512x512',\n              type: 'image/png',\n              purpose: 'any',\n            },\n            {\n              src: './pwa-maskable-512x512.png',\n              sizes: '512x512',\n              type: 'image/png',\n              purpose: 'maskable',\n            },\n          ],\n        },\n        workbox: {\n          globPatterns: ['**/*.{js,css,html,ico,png,svg,json,woff,woff2}'],\n          globIgnores: ['**/b2ks-source-bundle.json', '**/assets/aistudio/**'],\n          navigateFallbackDenylist: [/\\.zip$/i, /b2ks-source-bundle\\.json$/i],\n          maximumFileSizeToCacheInBytes: 6 * 1024 * 1024,\n          runtimeCaching: [\n            {\n              urlPattern: /^https:\\/\\/fonts\\.googleapis\\.com\\/.*/i,\n              handler: 'CacheFirst',\n              options: {\n                cacheName: 'google-fonts-cache',\n                expiration: {\n                  maxEntries: 10,\n                  maxAgeSeconds: 60 * 60 * 24 * 365,\n                },\n                cacheableResponse: {\n                  statuses: [0, 200],\n                },\n              },\n            },\n            {\n              urlPattern: /^https:\\/\\/fonts\\.gstatic\\.com\\/.*/i,\n              handler: 'CacheFirst',\n              options: {\n                cacheName: 'gstatic-fonts-cache',\n                expiration: {\n                  maxEntries: 10,\n                  maxAgeSeconds: 60 * 60 * 24 * 365,\n                },\n                cacheableResponse: {\n                  statuses: [0, 200],\n                },\n              },\n            },\n            {\n              urlPattern: /^https:\\/\\/(cdn\\.jsdelivr\\.net|unpkg\\.com)\\/npm\\/three.*/i,\n              handler: 'CacheFirst',\n              options: {\n                cacheName: 'threejs-cdn-cache',\n                expiration: {\n                  maxEntries: 20,\n                  maxAgeSeconds: 60 * 60 * 24 * 90,\n                },\n                cacheableResponse: {\n                  statuses: [0, 200],\n                },\n              },\n            },\n          ],\n        },\n        devOptions: {\n          enabled: true,\n          type: 'module',\n        },\n      }),\n      {\n        name: 'copy-unbundled-src-assets-and-sync-docs',\n        apply: 'build',\n        closeBundle(error?: Error): void {\n          if (error) {\n            return;\n          }\n          const distDir = path.resolve(__dirname, 'dist');\n          const srcAssets = path.resolve(__dirname, 'src/assets');\n          const distAssets = path.resolve(distDir, 'src/assets');\n          if (fs.existsSync(distDir) && fs.existsSync(srcAssets)) {\n            fs.cpSync(srcAssets, distAssets, {recursive: true, force: true});\n          }\n          const docsDir = path.resolve(__dirname, 'docs');\n          if (fs.existsSync(distDir)) {\n            fs.rmSync(docsDir, {recursive: true, force: true});\n            fs.cpSync(distDir, docsDir, {\n              recursive: true,\n              force: true,\n              filter: (srcPath) => {\n                const normalized = srcPath.replace(/\\\\/g, '/');\n                if (\n                  normalized.endsWith('/b2ks-daily-routines-github.zip') ||\n                  normalized.endsWith('/b2ks-source-bundle.json') ||\n                  normalized.includes('/assets/aistudio')\n                ) {\n                  return false;\n                }\n                return true;\n              },\n            });\n            fs.writeFileSync(path.join(docsDir, '.nojekyll'), '');\n          }\n        },\n      },\n    ],\n    resolve: {\n      alias: {\n        '@': path.resolve(__dirname, '.'),\n      },\n    },\n    server: {\n      host: '0.0.0.0',\n      port: 3000,\n      allowedHosts: true as const,\n      hmr: process.env.DISABLE_HMR !== 'true',\n      watch: process.env.DISABLE_HMR === 'true' ? null : {},\n    },\n  };\n});\n"}]}