, [293.66, 440.0], [],\n      [261.63, 392.0], [], [293.66, 440.0], [],\n      [349.23, 523.25], [], [293.66, 440.0], [],\n      [261.63, 392.0], [], [293.66, 440.0], []\n    ],\n    percussion: ['kick', 'hat', 'snare', 'hat', 'kick', 'kick', 'snare', 'hat', 'kick', 'hat', 'snare', 'hat', 'kick', 'snare', 'kick', 'snare']\n  },\n  {\n    id: 'cozy_lullaby',\n    name: 'Êm Dịu Buổi Tối',\n    icon: '🌙',\n    desc: 'Hộp nhạc Waltz 3/4 chậm rãi êm ái như lời ru trước giờ ngủ',\n    stepMs: 580,\n    oscType: 'sine',\n    bassType: 'sine',\n    chordType: 'sine',\n    leadDurFactor: 1.15,\n    leadGain: 0.019,\n    bassGain: 0.011,\n    chordGain: 0.006,\n    filterFreq: 1150,\n    melody: [659.25, 783.99, 659.25, 587.33, 523.25, 0, 587.33, 659.25, 587.33, 493.88, 392.0, 0],\n    bass: [130.81, 0, 0, 164.81, 0, 0, 146.83, 0, 0, 196.0, 0, 0],\n    chords: [\n      [261.63, 329.63], [329.63, 392.0], [329.63, 392.0],\n      [261.63, 329.63], [329.63, 392.0], [],\n      [293.66, 349.23], [349.23, 440.0], [349.23, 440.0],\n      [246.94, 392.0], [246.94, 392.0], []\n    ],\n    percussion: []\n  },\n  {\n    id: 'retro_chiptune',\n    name: 'Retro Arcade 8-bit',\n    icon: '🕹️',\n    desc: 'Arpeggio 8-bit tốc độ cao phong cách máy điện tử cổ điển',\n    stepMs: 145,\n    oscType: 'square',\n    bassType: 'triangle',\n    chordType: 'square',\n    leadDurFactor: 0.52,\n    leadGain: 0.011,\n    bassGain: 0.019,\n    chordGain: 0.004,\n    filterFreq: 3000,\n    melody: [\n      523.25, 659.25, 783.99, 1046.5, 783.99, 659.25, 523.25, 659.25,\n      587.33, 698.46, 880.0, 1174.66, 880.0, 698.46, 587.33, 698.46,\n      659.25, 783.99, 987.77, 1318.51, 987.77, 783.99, 659.25, 783.99,\n      523.25, 0, 783.99, 0, 1046.5, 0, 783.99, 0\n    ],\n    bass: [\n      130.81, 0, 261.63, 0, 130.81, 0, 196.0, 0,\n      146.83, 0, 293.66, 0, 146.83, 0, 220.0, 0,\n      164.81, 0, 329.63, 0, 196.0, 0, 246.94, 0,\n      130.81, 130.81, 196.0, 0, 261.63, 0, 196.0, 0\n    ],\n    chords: [],\n    percussion: [\n      'kick', 'hat', 'snare', 'hat', 'kick', 'hat', 'snare', 'hat',\n      'kick', 'hat', 'snare', 'hat', 'kick', 'kick', 'snare', 'hat'\n    ]\n  },\n  {\n    id: 'calm_forest',\n    name: 'Vườn Xanh Thiên Nhiên',\n    icon: '🌿',\n    desc: 'Tiếng sáo & đàn hạc Fa-Lydian du dương giữa khu rừng mát',\n    stepMs: 365,\n    oscType: 'triangle',\n    bassType: 'sine',\n    chordType: 'sine',\n    leadDurFactor: 1.05,\n    leadGain: 0.02,\n    bassGain: 0.013,\n    chordGain: 0.008,\n    filterFreq: 1650,\n    melody: [349.23, 440.0, 523.25, 659.25, 587.33, 523.25, 440.0, 392.0, 349.23, 493.88, 523.25, 698.46, 659.25, 523.25, 440.0, 0],\n    bass: [174.61, 0, 0, 261.63, 196.0, 0, 0, 146.83, 174.61, 0, 0, 246.94, 174.61, 0, 130.81, 0],\n    chords: [\n      [349.23, 440.0, 523.25], [], [], [],\n      [392.0, 493.88, 587.33], [], [], [],\n      [349.23, 440.0, 659.25], [], [], [],\n      [349.23, 440.0, 523.25], [], [], []\n    ],\n    percussion: ['wood', null, null, 'wood', null, 'wood', null, null]\n  }\n];\n\nexport const PET_VARIANT_DEFS: PetVariantDef[] = [\n  { id: 'classic', label: 'Nguyên Bản', rarityLabel: 'Phổ thông', chancePercent: 50, badgeColor: '#64748B' },\n  { id: 'pastel', label: 'Pastel Kẹo Ngọt', rarityLabel: 'Ít gặp', chancePercent: 20, badgeColor: '#EC4899' },\n  { id: 'royal', label: 'Hoàng Gia Lam Tím', rarityLabel: 'Hiếm', chancePercent: 15, badgeColor: '#7C3AED' },\n  { id: 'cosmic', label: 'Ngân Hà Huyền Bí', rarityLabel: 'Cực Hiếm', chancePercent: 10, badgeColor: '#0284C7' },\n  { id: 'golden', label: 'Hoàng Kim Lấp Lánh', rarityLabel: 'Siêu Hiếm', chancePercent: 5, badgeColor: '#D97706' }\n];\n\nexport const PET_ACCESSORY_CATALOG: PetAccessoryDef[] = [\n  { id: 'pacc_bow', name: 'Nơ Hồng Xinh Xắn', icon: '🎀', price: 30, desc: 'Chiếc nơ ruy-băng nổi bật cài trên đầu thú cưng' },\n  { id: 'pacc_bell', name: 'Chuông Vàng May Mắn', icon: '🔔', price: 35, desc: 'Vòng cổ chuông vàng leng keng khi chạy nhảy cùng bé' },\n  { id: 'pacc_glasses', name: 'Kính Râm Siêu Ngầu', icon: '🕶️', price: 45, desc: 'Kính mát thời trang cực ngầu cho thú cưng dạo phố' },\n  { id: 'pacc_scarf', name: 'Khăn Choàng Ấm Áp', icon: '🧣', price: 40, desc: 'Khăn len đỏ giữ ấm vào những ngày mưa hoặc trời lạnh' },\n  { id: 'pacc_wizard', name: 'Mũ Phù Thủy Nhí', icon: '🧙', price: 65, desc: 'Mũ chóp sao phép thuật dành cho thú cưng thông thái' },\n  { id: 'pacc_crown', name: 'Vương Miện Nhí', icon: '👑', price: 85, desc: 'Vương miện mini lấp lánh tôn vinh thú cưng cưng nhất' }\n];\n\nexport function normalizeFamilySlug(rawName: string | undefined | null): string {\n  const clean = String(rawName || 'B2KS')\n    .trim()\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9]+/g, '_')\n    .replace(/^_+|_+$/g, '');\n  return clean || 'b2ks';\n}\n\nexport function formatFamilyBrand(text: string, familyName?: string | null): string {\n  const brand = (familyName || 'B2KS').trim() || 'B2KS';\n  return String(text || '').replace(/B2KS/g, brand);\n}\n\nexport function resolveNeighborhoodLocations(state?: Pick<B2KSState, 'house' | 'buildingLayouts' | 'familyName'> | null): NavDestination[] {\n  const brand = (state?.familyName || 'B2KS').trim() || 'B2KS';\n  const activePlot = PLOTS[state?.house?.plotIndex ?? 1] || PLOTS[1];\n  const overrides = state?.buildingLayouts || {};\n\n  return NEIGHBORHOOD_LOCATIONS.map((loc) => {\n    const ov = overrides[loc.id];\n    const baseX = loc.id === 'house' ? activePlot.x : loc.x;\n    const baseY = loc.id === 'house' ? activePlot.y + 85 : loc.y;\n    return {\n      ...loc,\n      name: formatFamilyBrand(loc.name, brand),\n      x: ov && typeof ov.x === 'number' ? Math.max(120, Math.min(STREET_WORLD.width - 120, Math.round(ov.x))) : baseX,\n      y: ov && typeof ov.y === 'number' ? Math.max(300, Math.min(STREET_WORLD.height - 90, Math.round(ov.y))) : baseY,\n      shape: ov?.shape || 'classic'\n    };\n  });\n}\n\nexport function getFamilyFirebaseRoot(familyName?: string | null): string {\n  const slug = normalizeFamilySlug(familyName);\n  return slug === 'b2ks' ? 'b2ks_family_rpg_v16' : `b2ks_family_ns_${slug}`;\n}\n\n\n\n"},{"path":"src/game/englishCurriculum.ts","encoding":"utf8","content":"import { EnglishQuestion } from '../types/b2ks';\nimport { CURRICULUM_GRADES_6_7, RawUnitCurriculum } from './englishData67';\nimport { CURRICULUM_GRADES_8_9 } from './englishData89';\n\nexport const CURRICULUM_BANK_VERSION = 2; // Global Success 6-9 (1920 items)\n\nexport interface GlobalSuccessUnitMeta {\n  grade: 6 | 7 | 8 | 9;\n  unit: number;\n  title: string;\n  grammarFocus: string;\n}\n\nconst ALL_RAW_UNITS: RawUnitCurriculum[] = [...CURRICULUM_GRADES_6_7, ...CURRICULUM_GRADES_8_9];\n\nexport const GLOBAL_SUCCESS_UNITS: GlobalSuccessUnitMeta[] = ALL_RAW_UNITS.map((u) => ({\n  grade: u.grade,\n  unit: u.unit,\n  title: u.title,\n  grammarFocus: u.grammarFocus,\n}));\n\nexport function getGlobalSuccessUnitMeta(grade: number, unit: number): GlobalSuccessUnitMeta | undefined {\n  return GLOBAL_SUCCESS_UNITS.find((u) => u.grade === grade && u.unit === unit);\n}\n\nexport function getGlobalSuccessUnitTitle(grade: number, unit: number): string {\n  const meta = getGlobalSuccessUnitMeta(grade, unit);\n  return meta ? `Unit ${meta.unit}: ${meta.title}` : `Unit ${unit}`;\n}\n\nfunction buildFourOptions<T>(\n  allItems: T[],\n  correctIdx: number,\n  seed: number,\n  getLabel: (item: T) => string\n): { opts: [string, string, string, string]; ans: number } {\n  const correctLabel = getLabel(allItems[correctIdx]);\n  const distractors: string[] = [];\n  const total = allItems.length;\n  for (let offset = 1; offset < total && distractors.length < 3; offset++) {\n    const candidateIdx = (correctIdx + offset * 3 + seed) % total;\n    const label = getLabel(allItems[candidateIdx]);\n    if (label && label !== correctLabel && !distractors.includes(label)) {\n      distractors.push(label);\n    }\n  }\n  for (let i = 0; i < total && distractors.length < 3; i++) {\n    const label = getLabel(allItems[i]);\n    if (label && label !== correctLabel && !distractors.includes(label)) {\n      distractors.push(label);\n    }\n  }\n  const ansPos = (correctIdx * 3 + seed) % 4;\n  const opts: string[] = [];\n  let dPtr = 0;\n  for (let pos = 0; pos < 4; pos++) {\n    if (pos === ansPos) {\n      opts.push(correctLabel);\n    } else {\n      opts.push(distractors[dPtr++] || 'N/A');\n    }\n  }\n  return {\n    opts: [opts[0], opts[1], opts[2], opts[3]],\n    ans: ansPos,\n  };\n}\n\nfunction expandCurriculumBank(): EnglishQuestion[] {\n  const bank: EnglishQuestion[] = [];\n\n  for (const unitDef of ALL_RAW_UNITS) {\n    const unitTitle = `Unit ${unitDef.unit}: ${unitDef.title}`;\n    const vList = unitDef.vocab;\n\n    // 1. 10 Contextual fill-in-the-blank Vocab questions\n    vList.forEach(([word, viMeaning, sentence], idx) => {\n      const { opts, ans } = buildFourOptions(vList, idx, unitDef.unit + unitDef.grade, (item) => item[0]);\n      bank.push({\n        id: `gs_g${unitDef.grade}_u${unitDef.unit}_v${idx + 1}`,\n        cat: 'vocab',\n        grade: unitDef.grade,\n        unit: unitDef.unit,\n        unitTitle,\n        q: sentence,\n        opts,\n        ans,\n        exp: `\"${word}\" nghĩa là \"${viMeaning}\" (${unitTitle} - Lớp ${unitDef.grade}).`,\n      });\n    });\n\n    // 2. 5 English -> Vietnamese + 5 Vietnamese -> English Vocab questions (Total = 20 Vocab / Unit)\n    vList.forEach(([word, viMeaning], idx) => {\n      if (idx < 5) {\n        const { opts, ans } = buildFourOptions(vList, idx, unitDef.unit * 2 + 1, (item) => item[1]);\n        bank.push({\n          id: `gs_g${unitDef.grade}_u${unitDef.unit}_v${idx + 11}`,\n          cat: 'vocab',\n          grade: unitDef.grade,\n          unit: unitDef.unit,\n          unitTitle,\n          q: `What does \"${word}\" mean in Vietnamese? (Global Success ${unitDef.grade} - Unit ${unitDef.unit})`,\n          opts,\n          ans,\n          exp: `Trong ${unitTitle} (Lớp ${unitDef.grade}), \"${word}\" có nghĩa là \"${viMeaning}\".`,\n        });\n      } else {\n        const { opts, ans } = buildFourOptions(vList, idx, unitDef.unit * 3 + 2, (item) => item[0]);\n        bank.push({\n          id: `gs_g${unitDef.grade}_u${unitDef.unit}_v${idx + 11}`,\n          cat: 'vocab',\n          grade: unitDef.grade,\n          unit: unitDef.unit,\n          unitTitle,\n          q: `Which English word or phrase means \"${viMeaning}\"? (Unit ${unitDef.unit}: ${unitDef.title})`,\n          opts,\n          ans,\n          exp: `Từ tiếng Anh tương ứng với \"${viMeaning}\" là \"${word}\".`,\n        });\n      }\n    });\n\n    // 3. 20 Distinct Grammar questions per Unit\n    unitDef.grammar.forEach(([q, opts, ans, exp], idx) => {\n      bank.push({\n        id: `gs_g${unitDef.grade}_u${unitDef.unit}_g${idx + 1}`,\n        cat: 'grammar',\n        grade: unitDef.grade,\n        unit: unitDef.unit,\n        unitTitle,\n        q,\n        opts: [opts[0], opts[1], opts[2], opts[3]],\n        ans,\n        exp,\n      });\n    });\n  }\n\n  return bank;\n}\n\nexport const GLOBAL_SUCCESS_ENGLISH_BANK: EnglishQuestion[] = expandCurriculumBank();\n\nfunction escapeCsvCell(val: string | number | undefined): string {\n  const s = String(val ?? '');\n  if (s.includes('\"') || s.includes(',') || s.includes('\\n') || s.includes('\\r')) {\n    return `\"${s.replace(/\"/g, '\"\"')}\"`;\n  }\n  return s;\n}\n\nexport function exportEnglishBankToCsv(questions: EnglishQuestion[]): string {\n  const header = ['id', 'grade', 'unit', 'cat', 'q', 'optA', 'optB', 'optC', 'optD', 'ans', 'exp'];\n  const ansLetters = ['A', 'B', 'C', 'D'];\n  const lines = [header.join(',')];\n  questions.forEach((item) => {\n    const row = [\n      escapeCsvCell(item.id),\n      escapeCsvCell(item.grade ?? 6),\n      escapeCsvCell(item.unit ?? 1),\n      escapeCsvCell(item.cat),\n      escapeCsvCell(item.q),\n      escapeCsvCell(item.opts[0] || ''),\n      escapeCsvCell(item.opts[1] || ''),\n      escapeCsvCell(item.opts[2] || ''),\n      escapeCsvCell(item.opts[3] || ''),\n      escapeCsvCell(ansLetters[item.ans] || 'A'),\n      escapeCsvCell(item.exp || ''),\n    ];\n    lines.push(row.join(','));\n  });\n  return '\\uFEFF' + lines.join('\\r\\n');\n}\n\nexport function parseCsvRows(rawText: string): string[][] {\n  const text = rawText.replace(/^\\uFEFF/, '');\n  const rows: string[][] = [];\n  let row: string[] = [];\n  let cell = '';\n  let inQuotes = false;\n\n  for (let i = 0; i < text.length; i++) {\n    const ch = text[i];\n    if (inQuotes) {\n      if (ch === '\"') {\n        if (text[i + 1] === '\"') {\n          cell += '\"';\n          i++;\n        } else {\n          inQuotes = false;\n        }\n      } else {\n        cell += ch;\n      }\n    } else {\n      if (ch === '\"') {\n        inQuotes = true;\n      } else if (ch === ',') {\n        row.push(cell);\n        cell = '';\n      } else if (ch === '\\r') {\n        if (text[i + 1] === '\\n') i++;\n        row.push(cell);\n        if (row.some((c) => c.trim() !== '')) rows.push(row);\n        row = [];\n        cell = '';\n      } else if (ch === '\\n') {\n        row.push(cell);\n        if (row.some((c) => c.trim() !== '')) rows.push(row);\n        row = [];\n        cell = '';\n      } else {\n        cell += ch;\n      }\n    }\n  }\n  if (cell.length > 0 || row.length > 0) {\n    row.push(cell);\n    if (row.some((c) => c.trim() !== '')) rows.push(row);\n  }\n  return rows;\n}\n\nexport function parseEnglishBankCsv(csvText: string): { questions: EnglishQuestion[]; errors: number } {\n  const rows = parseCsvRows(csvText);\n  if (rows.length === 0) return { questions: [], errors: 0 };\n\n  let startIdx = 0;\n  const firstRowLower = rows[0].map((c) => String(c || '').trim().toLowerCase());\n  const colIdx = {\n    id: firstRowLower.indexOf('id'),\n    grade: firstRowLower.indexOf('grade'),\n    unit: firstRowLower.indexOf('unit'),\n    cat: firstRowLower.indexOf('cat'),\n    q: firstRowLower.indexOf('q'),\n    optA: firstRowLower.indexOf('opta'),\n    optB: firstRowLower.indexOf('optb'),\n    optC: firstRowLower.indexOf('optc'),\n    optD: firstRowLower.indexOf('optd'),\n    ans: firstRowLower.indexOf('ans'),\n    exp: firstRowLower.indexOf('exp'),\n  };\n\n  if (colIdx.q !== -1 && colIdx.optA !== -1) {\n    startIdx = 1;\n  } else {\n    // Fallback fixed column order: id,grade,unit,cat,q,optA,optB,optC,optD,ans,exp\n    colIdx.id = 0;\n    colIdx.grade = 1;\n    colIdx.unit = 2;\n    colIdx.cat = 3;\n    colIdx.q = 4;\n    colIdx.optA = 5;\n    colIdx.optB = 6;\n    colIdx.optC = 7;\n    colIdx.optD = 8;\n    colIdx.ans = 9;\n    colIdx.exp = 10;\n  }\n\n  const out: EnglishQuestion[] = [];\n  let errors = 0;\n\n  for (let r = startIdx; r < rows.length; r++) {\n    const cells = rows[r];\n    const qText = (cells[colIdx.q] || '').trim();\n    const o0 = (cells[colIdx.optA] || '').trim();\n    const o1 = (cells[colIdx.optB] || '').trim();\n    const o2 = (cells[colIdx.optC] || '').trim();\n    const o3 = (cells[colIdx.optD] || '').trim();\n    if (!qText || !o0 || !o1 || !o2 || !o3) {\n      errors++;\n      continue;\n    }\n\n    const gradeNum = Number((cells[colIdx.grade] || '6').trim());\n    const grade = (gradeNum === 7 || gradeNum === 8 || gradeNum === 9 ? gradeNum : 6) as 6 | 7 | 8 | 9;\n    const unitNum = Math.max(1, Math.min(12, Math.round(Number((cells[colIdx.unit] || '1').trim()) || 1)));\n    const catRaw = String(cells[colIdx.cat] || 'vocab').trim().toLowerCase();\n    const cat: 'grammar' | 'vocab' = catRaw === 'grammar' || catRaw === 'ngữ pháp' ? 'grammar' : 'vocab';\n\n    const ansRaw = (cells[colIdx.ans] || 'A').trim().toUpperCase();\n    let ans = 0;\n    if (ansRaw === 'B' || ansRaw === '1') ans = 1;\n    else if (ansRaw === 'C' || ansRaw === '2') ans = 2;\n    else if (ansRaw === 'D' || ansRaw === '3') ans = 3;\n    else if (ansRaw === '4') ans = 3;\n    else if (ansRaw === 'A' || ansRaw === '0') ans = 0;\n\n    const rawId = (colIdx.id >= 0 ? cells[colIdx.id] : '')?.trim();\n    const exp = (colIdx.exp >= 0 ? cells[colIdx.exp] : '')?.trim() || `Global Success ${grade} - Unit ${unitNum}`;\n\n    out.push({\n      id: rawId || `csv_g${grade}_u${unitNum}_${cat}_${r}_${Date.now()}`,\n      grade,\n      unit: unitNum,\n      unitTitle: getGlobalSuccessUnitTitle(grade, unitNum),\n      cat,\n      q: qText,\n      opts: [o0, o1, o2, o3],\n      ans,\n      exp,\n      custom: !rawId || !rawId.startsWith('gs_'),\n    });\n  }\n\n  return { questions: out, errors };\n}\n"},{"path":"src/game/englishData67.ts","encoding":"utf8","content":"export type RawVocabTuple = [string, string, string]; // [word, viMeaning, sentenceWithBlank]\nexport type RawGrammarTuple = [string, [string, string, string, string], number, string]; // [q, opts, ans, exp]\n\nexport interface RawUnitCurriculum {\n  grade: 6 | 7 | 8 | 9;\n  unit: number;\n  title: string;\n  grammarFocus: string;\n  vocab: RawVocabTuple[]; // 10 items -> 20 distinct questions (10 context + 10 meaning)\n  grammar: RawGrammarTuple[]; // 20 distinct grammar questions\n}\n\nexport const CURRICULUM_GRADES_6_7: RawUnitCurriculum[] = [\n  // ==================== GRADE 6 ====================\n  {\n    grade: 6,\n    unit: 1,\n    title: 'My New School',\n    grammarFocus: 'Present simple & Adverbs of frequency',\n    vocab: [\n      ['compass', 'com-pa vẽ hình tròn', 'I use a ______ to draw circles in my Maths class.'],\n      ['calculator', 'máy tính bỏ túi', 'We need a pocket ______ for difficult Maths problems.'],\n      ['uniform', 'đồng phục', 'All students in our school wear a blue and white ______ on Mondays.'],\n      ['boarding school', 'trường nội trú', 'In a ______, students live and study at school all week.'],\n      ['playground', 'sân chơi', 'During break time, the children play games in the ______.'],\n      ['classmate', 'bạn cùng lớp', 'Nam is my new ______. We sit at the same desk.'],\n      ['textbook', 'sách giáo khoa', 'Please open your English ______ to page 12.'],\n      ['pencil sharpener', 'gọt bút chì', 'Can I borrow your ______? My pencil is broken.'],\n      ['international', 'quốc tế', 'My cousin studies at an ______ school with teachers from many countries.'],\n      ['greenhouse', 'nhà kính trồng cây', 'Our school has a small ______ where students grow vegetables.'],\n    ],\n    grammar: [\n      ['She ______ to school by bicycle every morning.', ['go', 'goes', 'going', 'is go'], 1, 'Chủ ngữ số ít \"She\" ở thì hiện tại đơn dùng \"goes\".'],\n      ['My new classmates ______ very friendly and helpful.', ['is', 'am', 'are', 'be'], 2, 'Chủ ngữ số nhiều \"My new classmates\" dùng \"are\".'],\n      ['______ your brother study at Sunrise Secondary School?', ['Do', 'Does', 'Is', 'Are'], 1, 'Câu hỏi hiện tại đơn với động từ thường \"study\" và chủ ngữ số ít \"your brother\" dùng \"Does\".'],\n      ['We ______ English and Science on Tuesdays and Fridays.', ['has', 'have', 'having', 'are have'], 1, 'Chủ ngữ \"We\" ở thì hiện tại đơn dùng \"have\".'],\n      ['Phong ______ late for school because he gets up early.', ['is never', 'never is', 'are never', 'never are'], 0, 'Trạng từ tần suất \"never\" đứng sau động từ \"to be\" (is).'],\n      ['How often ______ Mai play badminton with her sister?', ['do', 'does', 'is', 'are'], 1, 'Câu hỏi hiện tại đơn với \"Mai\" dùng trợ động từ \"does\".'],\n      ['They ______ usually watch TV before finishing their homework.', ['don’t', 'doesn’t', 'aren’t', 'isn’t'], 0, 'Phủ định hiện tại đơn với \"They\" và động từ thường \"watch\" dùng \"don’t\".'],\n      ['Our school library ______ over two thousand books.', ['have', 'has', 'is having', 'are having'], 1, '\"Our school library\" là số ít -> dùng \"has\".'],\n      ['I ______ go to the school judo club twice a week.', ['always', 'often', 'never', 'rarely'], 1, '\"twice a week\" phù hợp nghĩa thường xuyên -> \"often\".'],\n      ['Look at the timetable! The first lesson ______ at 7:30 a.m.', ['start', 'starts', 'starting', 'to start'], 1, 'Lịch học cố định chia hiện tại đơn: \"The first lesson starts\".'],\n      ['Vy and Duy ______ in the same class, 6A1.', ['is', 'are', 'am', 'does'], 1, 'Chủ ngữ ghép \"Vy and Duy\" là số nhiều -> dùng \"are\".'],\n      ['My father ______ drives me to school when it rains.', ['usually', 'is usually', 'does usually', 'usually is'], 0, 'Trạng từ tần suất \"usually\" đứng trước động từ thường \"drives\".'],\n      ['Where ______ you live? — I live near the park.', ['do', 'does', 'are', 'is'], 0, 'Hỏi với chủ ngữ \"you\" và động từ thường \"live\" dùng \"do\".'],\n      ['Minh ______ like History very much; he prefers Geography.', ['don’t', 'doesn’t', 'isn’t', 'aren’t'], 1, 'Phủ định hiện tại đơn với \"Minh\" dùng \"doesn’t\".'],\n      ['Does your teacher give you much homework? — Yes, she ______.', ['do', 'does', 'is', 'gives'], 1, 'Câu trả lời ngắn cho câu hỏi \"Does...?\" là \"Yes, she does.\"'],\n      ['Students ______ wear their uniforms from Monday to Friday.', ['always', 'always are', 'are always', 'do always'], 0, '\"always\" đứng trước động từ thường \"wear\".'],\n      ['What time ______ the school bus arrive every day?', ['do', 'does', 'is', 'are'], 1, '\"the school bus\" số ít -> dùng \"does\".'],\n      ['I ______ excited about my first day at secondary school.', ['am', 'is', 'are', 'do'], 0, 'Chủ ngữ \"I\" đi với \"am\".'],\n      ['He ______ plays football after school because he loves sports.', ['rarely', 'never', 'often', 'seldom'], 2, 'Vì \"loves sports\" nên chọn \"often\".'],\n      ['______ do you go to school with? — My best friend, Lan.', ['What', 'Who', 'Where', 'When'], 1, 'Hỏi về người dùng \"Who\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 2,\n    title: 'My House',\n    grammarFocus: 'Possessive case & Prepositions of place',\n    vocab: [\n      ['town house', 'nhà phố', 'We live in a three-storey ______ in the city centre.'],\n      ['country house', 'nhà ở nông thôn', 'My grandparents have a quiet ______ with a big garden.'],\n      ['cupboard', 'tủ chén bát', 'Mum keeps the bowls and plates inside the kitchen ______.'],\n      ['chest of drawers', 'tủ ngăn kéo', 'I fold my T-shirts and put them in the ______.'],\n      ['dishwasher', 'máy rửa bát', 'After dinner, we put all dirty plates into the ______.'],\n      ['wardrobe', 'tủ quần áo', 'Hang your school coat neatly inside the ______.'],\n      ['attic', 'gác mái', 'We store old suitcases and boxes in the ______ under the roof.'],\n      ['hallway', 'hành lang', 'Please leave your wet umbrella in the ______ near the front door.'],\n      ['fridge', 'tủ lạnh', 'Keep the milk and fresh fruit inside the ______.'],\n      ['sink', 'bồn rửa', 'Wash your hands at the bathroom ______ before lunch.'],\n    ],\n    grammar: [\n      ['There ______ two bookshelves and a big desk in my bedroom.', ['is', 'are', 'am', 'be'], 1, 'Danh từ đứng ngay sau là số nhiều \"two bookshelves\" -> dùng \"are\".'],\n      ['This is ______ bedroom. It is painted soft pink.', ['Mi', 'Mi’s', 'Mis’', 'of Mi'], 1, 'Sở hữu cách của danh từ riêng số ít: \"Mi’s\".'],\n      ['The cat is sleeping ______ the sofa and the coffee table.', ['between', 'in', 'under', 'on'], 0, 'Cấu trúc \"between A and B\" (ở giữa hai vật).'],\n      ['There ______ a large TV in our living room.', ['is', 'are', 'am', 'have'], 0, '\"a large TV\" là số ít -> dùng \"There is\".'],\n      ['Where are the pillows? — They are ______ the bed.', ['on', 'between', 'in front', 'next'], 0, 'Gối nằm ở trên giường -> \"on the bed\".'],\n      ['My ______ house has a lovely balcony overlooking the river.', ['grandparents', 'grandparent’s', 'grandparents’', 'grandparent'], 2, 'Danh từ số nhiều tận cùng bằng -s -> sở hữu cách thêm dấu nháy đơn: \"grandparents’\".'],\n      ['The clock is hanging ______ the wall above the fireplace.', ['in', 'on', 'under', 'behind'], 1, 'Treo trên tường dùng giới từ \"on the wall\".'],\n      ['Is there a lamp next ______ your bed?', ['with', 'to', 'of', 'at'], 1, 'Cụm giới từ cố định \"next to\" (bên cạnh).'],\n      ['Our dog likes hiding ______ the kitchen table when it thunders.', ['under', 'on', 'between', 'in front'], 0, 'Chú chó trốn dưới gầm bàn -> \"under\".'],\n      ['There aren’t ______ posters on the bedroom wall.', ['a', 'an', 'any', 'some'], 2, 'Câu phủ định dùng \"any\".'],\n      ['The supermarket is ______ front of my aunt’s apartment building.', ['on', 'at', 'in', 'to'], 2, 'Cụm từ cố định \"in front of\" (ở phía trước).'],\n      ['That is my ______ motorbike. He rides it to work.', ['father', 'father’s', 'fathers’', 'of father'], 1, 'Sở hữu cách số ít -> \"father’s\".'],\n      ['Put the dirty clothes ______ the laundry basket, please.', ['in', 'between', 'under', 'behind'], 0, 'Đặt quần áo vào bên trong giỏ -> \"in\".'],\n      ['______ there a microwave in your kitchen?', ['Are', 'Is', 'Do', 'Does'], 1, '\"a microwave\" số ít -> câu hỏi dùng \"Is there\".'],\n      ['The garden is ______ our house, so we can’t see it from the street.', ['in front of', 'behind', 'on', 'above'], 1, 'Không thấy từ ngoài đường -> ở phía sau nhà: \"behind\".'],\n      ['Whose schoolbag is this? — It’s ______.', ['Nam', 'Nam’s', 'Nams', 'of Nam'], 1, 'Trả lời câu hỏi Whose bằng sở hữu cách: \"Nam’s\".'],\n      ['My study corner is ______ the window so it gets plenty of light.', ['under', 'near', 'between', 'inside'], 1, 'Gần cửa sổ dùng \"near\".'],\n      ['There is a picture ______ the bookshelf.', ['above', 'between', 'into', 'among'], 0, 'Phía trên kệ sách dùng \"above\".'],\n      ['How many rooms ______ there in your town house?', ['is', 'are', 'do', 'have'], 1, '\"rooms\" số nhiều -> dùng \"are\".'],\n      ['Look! The broom is standing ______ the door.', ['behind', 'between', 'above', 'over'], 0, 'Đằng sau cánh cửa dùng \"behind\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 3,\n    title: 'My Friends',\n    grammarFocus: 'Present continuous & Personality adjectives',\n    vocab: [\n      ['confident', 'tự tin', 'She is very ______ when speaking English in front of the class.'],\n      ['hard-working', 'chăm chỉ', 'Trung is a ______ student; he finishes all his exercises carefully.'],\n      ['generous', 'hào phóng, rộng lượng', 'My friend is ______; she often shares snacks and pens with everyone.'],\n      ['talkative', 'nói nhiều, hoạt ngôn', 'Nam is quite ______ — he always has funny stories to tell.'],\n      ['creative', 'sáng tạo', 'Linh is very ______; she makes beautiful greeting cards by hand.'],\n      ['curly', 'xoăn (tóc)', 'My baby sister has cute round cheeks and short ______ hair.'],\n      ['ponytail', 'tóc đuôi ngựa', 'Hoa ties her long black hair in a neat ______ for PE class.'],\n      ['friendly', 'thân thiện', 'Everyone likes Bao because he is ______ to new classmates.'],\n      ['shy', 'nhút nhát, rụt rè', 'At first, Tuan was ______ and didn’t say much at the party.'],\n      ['reliable', 'đáng tin cậy', 'You can trust Chau because she is a ______ friend.'],\n    ],\n    grammar: [\n      ['Look! The girls ______ badminton in the schoolyard right now.', ['play', 'plays', 'are playing', 'is playing'], 2, 'Có dấu hiệu \"Look!\", \"right now\" và chủ ngữ số nhiều -> thì hiện tại tiếp diễn \"are playing\".'],\n      ['At the moment, Mai ______ a picture for her mother’s birthday.', ['draw', 'draws', 'is drawing', 'are drawing'], 2, '\"At the moment\" + \"Mai\" số ít -> \"is drawing\".'],\n      ['Be quiet! The baby ______ in the next room.', ['sleeps', 'is sleeping', 'are sleeping', 'sleep'], 1, 'Mệnh lệnh \"Be quiet!\" báo hiệu hành động đang diễn ra -> \"is sleeping\".'],\n      ['What ______ you doing this weekend? — I’m visiting my uncle.', ['do', 'is', 'are', 'does'], 2, 'Hiện tại tiếp diễn diễn tả kế hoạch với \"you\" -> \"What are you doing\".'],\n      ['My sister is tall and she ______ long straight hair.', ['is', 'has', 'have', 'are'], 1, 'Miêu tả đặc điểm bộ phận cơ thể (tóc, mắt) dùng \"have/has\".'],\n      ['Listen! Someone ______ at the front door.', ['knocks', 'knock', 'is knocking', 'are knocking'], 2, 'Có từ \"Listen!\" -> dùng hiện tại tiếp diễn \"is knocking\".'],\n      ['We ______ TV now; we are studying for the English test.', ['don’t watch', 'aren’t watching', 'isn’t watching', 'not watch'], 1, 'Phủ định hiện tại tiếp diễn với \"We\" -> \"aren’t watching\".'],\n      ['Phong and Minh ______ cycling around Hoan Kiem Lake at present.', ['is', 'am', 'are', 'do'], 2, 'Chủ ngữ số nhiều \"Phong and Minh\" -> \"are\".'],\n      ['______ your best friend wearing a red T-shirt today?', ['Do', 'Does', 'Is', 'Are'], 2, 'Câu hỏi hiện tại tiếp diễn với \"your best friend\" -> \"Is\".'],\n      ['Look at Nick! He ______ a book under the big tree.', ['reads', 'reading', 'is reading', 'are reading'], 2, '\"Look at Nick!\" -> đang đọc sách: \"is reading\".'],\n      ['I ______ taking photos of the flowers with my friends.', ['is', 'are', 'am', 'do'], 2, 'Chủ ngữ \"I\" đi với \"am\".'],\n      ['My cousin ______ short and he has bright brown eyes.', ['has', 'is', 'are', 'have'], 1, 'Miêu tả chiều cao/dáng người (\"short\") dùng \"to be\" -> \"is\".'],\n      ['Why ______ Hoa crying? Did she lose her notebook?', ['do', 'does', 'is', 'are'], 2, 'Hành động đang xảy ra -> \"Why is Hoa crying?\".'],\n      ['They ______ making paper lanterns for the Mid-Autumn Festival right now.', ['is', 'are', 'am', 'do'], 1, '\"They\" -> \"are making\".'],\n      ['Look! The school bus ______. Let’s run!', ['come', 'comes', 'is coming', 'coming'], 2, 'Đang đến ngay bây giờ -> \"is coming\".'],\n      ['Today, Ms. Lien ______ a lovely floral dress.', ['wear', 'wears', 'is wearing', 'wearing'], 2, 'Hôm nay đang mặc -> \"is wearing\".'],\n      ['Wait a minute! I ______ putting on my trainers.', ['am', 'is', 'are', 'do'], 0, 'Đang xỏ giày -> \"I am putting\".'],\n      ['Are the students having lunch in the canteen? — Yes, they ______.', ['do', 'have', 'are', 'is'], 2, 'Trả lời ngắn cho \"Are they...?\" là \"Yes, they are.\"'],\n      ['My brother isn’t ______ football; he is playing chess indoors.', ['play', 'plays', 'playing', 'played'], 2, 'Cấu trúc \"isn’t + V-ing\" -> \"playing\".'],\n      ['Who ______ you waiting for at the school gate?', ['do', 'is', 'are', 'does'], 2, 'Câu hỏi hiện tại tiếp diễn với \"you\" -> \"Who are you waiting for\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 4,\n    title: 'My Neighbourhood',\n    grammarFocus: 'Comparative adjectives & Giving directions',\n    vocab: [\n      ['square', 'quảng trường', 'People gather in the main ______ to watch the evening show.'],\n      ['cathedral', 'nhà thờ lớn', 'St. Joseph’s ______ is a famous old building in Ha Noi.'],\n      ['railway station', 'nhà ga xe lửa', 'Walk straight to reach the ______ and catch the morning train.'],\n      ['art gallery', 'phòng triển lãm nghệ thuật', 'We saw many wonderful oil paintings at the city ______.'],\n      ['crossroads', 'ngã tư', 'Turn left at the next ______ and you will see the bank.'],\n      ['suburb', 'vùng ngoại ô', 'It is peaceful to live in a green ______ far from noisy streets.'],\n      ['crowded', 'đông đúc', 'The market is very ______ on Sunday mornings.'],\n      ['convenient', 'tiện lợi', 'Having a bus stop right outside our alley is very ______.'],\n      ['peaceful', 'yên bình', 'My village is quiet and ______, with rice fields all around.'],\n      ['modern', 'hiện đại', 'The new shopping mall has ______ lifts and bright lights.'],\n    ],\n    grammar: [\n      ['Life in the countryside is ______ than life in a big city.', ['peaceful', 'more peaceful', 'most peaceful', 'peacefuller'], 1, 'So sánh hơn của tính từ dài \"peaceful\" dùng \"more peaceful than\".'],\n      ['Ho Chi Minh City is ______ than Da Nang.', ['big', 'more big', 'bigger', 'biggest'], 2, 'Tính từ ngắn CVC \"big\" gấp đôi phụ âm cuối -> \"bigger\".'],\n      ['Turn left ______ the traffic lights, and the post office is on your right.', ['in', 'at', 'on', 'between'], 1, 'Dùng giới từ \"at\" trước \"the traffic lights / crossroads\".'],\n      ['This street is ______ than that one because there are many lorries.', ['noisier', 'more noisy', 'noisy', 'noisiest'], 0, 'Tính từ 2 âm tiết tận cùng bằng -y đổi thành -ier -> \"noisier\".'],\n      ['Go straight ______ for two hundred metres, then take the first turning.', ['right', 'left', 'ahead', 'behind'], 2, 'Cụm chỉ đường cố định \"Go straight ahead\" (Đi thẳng về phía trước).'],\n      ['A flat in the city centre is ______ than a house in the suburbs.', ['expensive', 'more expensive', 'expensiver', 'most expensive'], 1, 'Tính từ dài \"expensive\" -> so sánh hơn \"more expensive\".'],\n      ['The air in the park is much ______ than the air near the factory.', ['fresh', 'fresher', 'more fresh', 'freshest'], 1, 'Tính từ ngắn \"fresh\" -> \"fresher\".'],\n      ['Take the second turning ______ your left to get to the bakery.', ['in', 'at', 'on', 'by'], 2, 'Cụm chỉ đường \"on your left / on your right\".'],\n      ['My new neighbourhood is ______ than my old one.', ['good', 'better', 'gooder', 'best'], 1, 'So sánh hơn bất quy tắc của \"good\" là \"better\".'],\n      ['The river here is ______ than the small stream in my hometown.', ['wider', 'more wide', 'wide', 'widest'], 0, '\"wide\" tận cùng bằng -e chỉ thêm -r -> \"wider\".'],\n      ['______ do I get to the nearest pharmacy from here?', ['What', 'Where', 'How', 'Which'], 2, 'Hỏi đường dùng \"How do I get to...?\".'],\n      ['Summer days are ______ than winter days in Viet Nam.', ['hoter', 'hotter', 'more hot', 'hottest'], 1, '\"hot\" gấp đôi chữ \"t\" -> \"hotter\".'],\n      ['Walking is ______ than taking a taxi for short distances.', ['healthy', 'healthier', 'more healthy', 'healthiest'], 1, '\"healthy\" tận cùng -y -> \"healthier\".'],\n      ['Cross the street ______ the zebra crossing to stay safe.', ['on', 'at', 'into', 'over'], 1, 'Qua đường tại vạch kẻ -> \"at the zebra crossing\".'],\n      ['The new cinema is ______ than the old theatre.', ['more modern', 'moderner', 'most modern', 'modern'], 0, '\"modern\" dùng \"more modern\".'],\n      ['Keep ______ until you see a tall yellow building.', ['walk', 'walks', 'walking', 'to walk'], 2, 'Cấu trúc \"Keep + V-ing\" (Tiếp tục đi bộ).'],\n      ['Traffic during rush hour is ______ than in the afternoon.', ['bad', 'badder', 'worse', 'more bad'], 2, 'So sánh hơn bất quy tắc của \"bad\" là \"worse\".'],\n      ['Is the museum far ______ here? — No, just ten minutes on foot.', ['to', 'from', 'with', 'near'], 1, 'Cấu trúc \"far from\" (xa khỏi).'],\n      ['The blue bridge looks ______ than the wooden one.', ['narrow', 'narrower', 'more narrow', 'narrowest'], 1, 'Tính từ ngắn 2 âm tiết tận cùng -ow dùng \"narrower\".'],\n      ['Go ______ the bridge and the zoo is straight ahead.', ['across', 'between', 'under', 'inside'], 0, 'Đi qua cầu dùng \"Go across the bridge\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 5,\n    title: 'Natural Wonders of Viet Nam',\n    grammarFocus: 'Countable/uncountable nouns & must/mustn’t',\n    vocab: [\n      ['waterfall', 'thác nước', 'Ban Gioc is a magnificent ______ on the northern border.'],\n      ['desert', 'sa mạc', 'Camel rides are popular on the sand dunes of the ______.'],\n      ['island', 'hòn đảo', 'Phu Quoc is a beautiful tropical ______ in southern Viet Nam.'],\n      ['mountain range', 'dãy núi', 'Fansipan belongs to the Hoang Lien Son ______.'],\n      ['backpack', 'ba lô', 'Put your water bottle and map inside your ______ before hiking.'],\n      ['suncream', 'kem chống nắng', 'Remember to put on ______ so your skin doesn’t burn at the beach.'],\n      ['sleeping bag', 'túi ngủ', 'Bring a warm ______ when you camp overnight in the forest.'],\n      ['plaster', 'băng cá nhân', 'If you cut your finger on a rock, put a ______ on it.'],\n      ['cave', 'hang động', 'Son Doong is the largest natural ______ in the world.'],\n      ['landscape', 'phong cảnh', 'Tourists come to Ha Long Bay to admire its limestone ______.'],\n    ],\n    grammar: [\n      ['You ______ drop litter in the national park.', ['must', 'mustn’t', 'can', 'may'], 1, '\"mustn’t\" diễn tả điều bị cấm (không được xả rác).'],\n      ['How ______ water should we bring for the mountain hike?', ['many', 'much', 'few', 'number'], 1, '\"water\" không đếm được -> dùng \"How much\".'],\n      ['Students ______ follow the tour guide’s instructions inside the cave.', ['must', 'mustn’t', 'shouldn’t', 'can’t'], 0, 'Quy tắc bắt buộc tuân theo -> dùng \"must\".'],\n      ['There are ______ tourists visiting Phong Nha Cave today.', ['a little', 'much', 'many', 'an'], 2, '\"tourists\" đếm được số nhiều -> dùng \"many\".'],\n      ['We have ______ time left before the boat leaves, so hurry up!', ['a few', 'a little', 'many', 'few'], 1, '\"time\" không đếm được -> dùng \"a little\".'],\n      ['You ______ pick wild flowers or break tree branches in the forest.', ['must', 'mustn’t', 'should', 'have to'], 1, 'Hành động bị cấm -> \"mustn’t\".'],\n      ['How ______ islands are there in Ha Long Bay?', ['much', 'many', 'long', 'often'], 1, '\"islands\" đếm được số nhiều -> \"How many\".'],\n      ['I need ______ advice on what to pack for my camping trip.', ['a', 'an', 'some', 'many'], 2, '\"advice\" là danh từ không đếm được -> dùng \"some\".'],\n      ['There is very ______ snow on the mountaintop in spring.', ['many', 'few', 'little', 'a few'], 2, '\"snow\" không đếm được -> dùng \"little\".'],\n      ['Everyone ______ wear a life jacket when getting on the boat.', ['must', 'mustn’t', 'may not', 'shouldn’t'], 0, 'Quy định an toàn bắt buộc -> \"must\".'],\n      ['Can I have ______ bottle of mineral water, please?', ['some', 'a', 'much', 'many'], 1, '\"bottle\" đếm được số ít -> dùng \"a\".'],\n      ['We saw ______ amazing rock formations inside Thien Cung Cave.', ['a little', 'much', 'a few', 'an'], 2, '\"rock formations\" đếm được số nhiều -> \"a few\".'],\n      ['You ______ make a campfire in a dry forest without permission.', ['must', 'mustn’t', 'can', 'will'], 1, 'Cấm đốt lửa trong rừng khô -> \"mustn’t\".'],\n      ['Wait! There isn’t ______ suncream left in this tube.', ['many', 'some', 'any', 'a few'], 2, 'Câu phủ định với danh từ không đếm được -> dùng \"any\".'],\n      ['How much ______ do you have for the trip? — Two pairs of socks and three shirts.', ['luggage', 'bags', 'items', 'jackets'], 0, '\"How much\" đi với danh từ không đếm được \"luggage\".'],\n      ['Visitors ______ keep quiet near the bird nesting area.', ['mustn’t', 'must', 'cannot', 'don’t'], 1, 'Bắt buộc giữ trật tự -> \"must\".'],\n      ['There are ______ sand dunes in Mui Ne that look like a mini desert.', ['much', 'a lot of', 'a little', 'an'], 1, '\"a lot of\" đi được với danh từ đếm được số nhiều \"sand dunes\".'],\n      ['Remember to bring ______ compass and a torch.', ['a', 'an', 'some', 'many'], 0, '\"compass\" số ít bắt đầu bằng phụ âm -> \"a\".'],\n      ['You ______ swim too far from the shore when the waves are strong.', ['must', 'mustn’t', 'should', 'are'], 1, 'Cảnh báo nguy hiểm cấm làm -> \"mustn’t\".'],\n      ['Have you got ______ photos of Ban Gioc Waterfall?', ['a', 'much', 'any', 'a little'], 2, 'Câu hỏi với danh từ đếm được số nhiều dùng \"any\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 6,\n    title: 'Our Tet Holiday',\n    grammarFocus: 'should / shouldn’t & some / any',\n    vocab: [\n      ['peach blossom', 'hoa đào', 'Families in northern Viet Nam decorate with pink ______ at Tet.'],\n      ['apricot blossom', 'hoa mai', 'Yellow ______ is a bright symbol of Tet in southern Viet Nam.'],\n      ['lucky money', 'tiền lì xì', 'Children happily receive red envelopes with ______ from their grandparents.'],\n      ['fireworks', 'pháo hoa', 'On New Year’s Eve, colourful ______ light up the midnight sky.'],\n      ['banh chung', 'bánh chưng', 'My family gathers around the pot to boil square ______ overnight.'],\n      ['first-footer', 'người xông đất', 'People believe a cheerful ______ brings good luck for the whole year.'],\n      ['decorate', 'trang trí', 'We clean and ______ the living room with lanterns before Tet.'],\n      ['wish', 'lời chúc / chúc mừng', 'At Tet, everyone says \"I ______ you health and happiness!\"'],\n      ['relative', 'họ hàng', 'During the Tet holiday, we visit our grandparents and other ______.'],\n      ['calendar', 'lịch năm mới', 'Dad hangs a new wall ______ above the dining table.'],\n    ],\n    grammar: [\n      ['You ______ knock before entering your grandparents’ room.', ['should', 'shouldn’t', 'mustn’t', 'aren’t'], 0, 'Lời khuyên lịch sự nên làm -> \"should\".'],\n      ['Children ______ eat too many sweets before meals.', ['should', 'shouldn’t', 'must', 'have to'], 1, 'Lời khuyên không nên làm -> \"shouldn’t\".'],\n      ['My mother bought ______ kumquat trees and red envelopes for Tet.', ['some', 'any', 'a', 'much'], 0, 'Câu khẳng định với danh từ đếm được số nhiều dùng \"some\".'],\n      ['Are there ______ red lanterns left in the shop?', ['some', 'any', 'a', 'little'], 1, 'Câu hỏi dùng \"any\".'],\n      ['At Tet, people ______ break things because they think it brings bad luck.', ['should', 'shouldn’t', 'must', 'do'], 1, 'Theo quan niệm Tết, không nên làm vỡ đồ -> \"shouldn’t\".'],\n      ['Would you like ______ green tea and candied ginger?', ['any', 'some', 'a', 'many'], 1, 'Lời mời lịch sự \"Would you like...?\" dùng \"some\".'],\n      ['We ______ help our parents clean the house before New Year’s Eve.', ['should', 'shouldn’t', 'mustn’t', 'cannot'], 0, 'Nên giúp bố mẹ dọn nhà -> \"should\".'],\n      ['There isn’t ______ sticky rice left in the kitchen.', ['some', 'any', 'many', 'a few'], 1, 'Câu phủ định dùng \"any\".'],\n      ['What ______ I wear to visit my teachers at Tet? — A neat ao dai!', ['should', 'shouldn’t', 'mustn’t', 'do'], 0, 'Hỏi xin lời khuyên dùng \"should\".'],\n      ['You ______ stay up too late on school nights, even after the holiday.', ['should', 'shouldn’t', 'can', 'will'], 1, 'Không nên thức khuya -> \"shouldn’t\".'],\n      ['Can I have ______ more apricot jam, Grandma?', ['any', 'some', 'a', 'few'], 1, 'Lời đề nghị xin thêm dùng \"some\".'],\n      ['People ______ dress neatly and smile when greeting guests at Tet.', ['should', 'shouldn’t', 'mustn’t', 'didn’t'], 0, 'Việc nên làm dịp Tết -> \"should\".'],\n      ['We don’t have ______ fireworks in the yard because it’s unsafe.', ['some', 'any', 'a', 'little'], 1, 'Câu phủ định dùng \"any\".'],\n      ['You ______ say bad words or argue during the New Year.', ['should', 'shouldn’t', 'must', 'are'], 1, 'Điều kiêng kỵ không nên làm -> \"shouldn’t\".'],\n      ['There are ______ delicious spring rolls on the dining table.', ['any', 'some', 'much', 'a little'], 1, 'Câu khẳng định với danh từ số nhiều -> \"some\".'],\n      ['Should kids greet elders politely first? — Yes, they ______.', ['do', 'mustn’t', 'should', 'can’t'], 2, 'Trả lời ngắn cho \"Should...?\" là \"Yes, they should.\"'],\n      ['I have ______ nice New Year cards to send to my penfriends.', ['some', 'any', 'a', 'much'], 0, 'Câu khẳng định số nhiều -> \"some\".'],\n      ['We ______ throw rubbish into the river after the kitchen gods ceremony.', ['should', 'shouldn’t', 'can', 'must'], 1, 'Không nên xả rác xuống sông -> \"shouldn’t\".'],\n      ['Did your uncle bring ______ flowers for the living room?', ['some', 'any', 'a', 'an'], 1, 'Câu hỏi thường dùng \"any\".'],\n      ['You ______ ask for lucky money directly; wait politely for elders to give it.', ['should', 'shouldn’t', 'must', 'have'], 1, 'Không nên đòi tiền lì xì -> \"shouldn’t\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 7,\n    title: 'Television',\n    grammarFocus: 'Wh-questions & Conjunctions (and, but, so)',\n    vocab: [\n      ['animated film', 'phim hoạt hình', 'My younger brother loves watching \"Toy Story\", an exciting ______.'],\n      ['documentary', 'phim tài liệu', 'Last night we watched a ______ about wild elephants in Africa.'],\n      ['game show', 'trò chơi truyền hình', 'Players answer trivia questions to win prizes on that ______.'],\n      ['newsreader', 'người đọc bản tin', 'The ______ speaks clearly on the 7 o’clock evening news.'],\n      ['remote control', 'điều khiển từ xa', 'Pass me the ______ so I can switch to the Sports channel.'],\n      ['educational', 'mang tính giáo dục', 'Discovery programmes are both fun and ______ for students.'],\n      ['viewer', 'khán giả xem TV', 'Millions of ______ watched the national football final on TV.'],\n      ['weather forecast', 'dự báo thời tiết', 'Dad checks the ______ to see if it will rain tomorrow.'],\n      ['comedy', 'phim hài', 'The ______ made our whole family laugh out loud.'],\n      ['schedule', 'lịch phát sóng', 'Let’s check the TV ______ to find out when the quiz starts.'],\n    ],\n    grammar: [\n      ['______ is your favourite cartoon character? — Mickey Mouse!', ['What', 'Who', 'Where', 'When'], 1, 'Hỏi về nhân vật / người dùng \"Who\".'],\n      ['The comedy was funny, ______ it ended too late for me to finish.', ['and', 'but', 'so', 'because'], 1, 'Hai vế tương phản dùng liên từ \"but\".'],\n      ['______ do you watch TV every day? — About one hour after homework.', ['How long', 'How many', 'Who', 'Where'], 0, 'Hỏi khoảng thời gian dùng \"How long\".'],\n      ['I finished my homework early, ______ my parents let me watch a film.', ['but', 'so', 'or', 'although'], 1, 'Vế sau chỉ kết quả dùng \"so\".'],\n      ['______ channel is the animal documentary on? — VTV2.', ['Who', 'Which', 'When', 'How often'], 1, 'Lựa chọn trong tập xác định (kênh nào) dùng \"Which\".'],\n      ['She likes nature programmes ______ science shows.', ['but', 'so', 'and', 'because'], 2, 'Nối hai cụm tương đồng dùng \"and\".'],\n      ['______ does the music talent show start? — At 8:00 p.m. on Saturday.', ['Where', 'When', 'Why', 'Who'], 1, 'Hỏi thời gian dùng \"When\".'],\n      ['He wanted to watch the match, ______ he had to prepare for his test.', ['and', 'so', 'but', 'then'], 2, 'Ý đối lập nhau dùng \"but\".'],\n      ['______ do you like watching cartoons? — Because they make me relaxed.', ['What', 'Why', 'How', 'When'], 1, 'Trả lời \"Because...\" -> câu hỏi bắt đầu bằng \"Why\".'],\n      ['The remote control was out of battery, ______ I changed the channel manually.', ['but', 'so', 'and', 'or'], 1, 'Chỉ nguyên nhân - kết quả dùng \"so\".'],\n      ['______ often does your family watch the evening news together?', ['When', 'How', 'What', 'Which'], 1, 'Cụm hỏi tần suất \"How often\".'],\n      ['My sister watches cartoons on TV, ______ I prefer reading comics.', ['so', 'and', 'but', 'or'], 2, 'So sánh sở thích trái ngược dùng \"but\".'],\n      ['______ is the weather forecast on tonight? — Right after the news.', ['Who', 'What time', 'How many', 'Which'], 1, 'Hỏi giờ cụ thể dùng \"What time\".'],\n      ['Turn off the TV ______ go to bed now, kids!', ['but', 'so', 'and', 'or'], 2, 'Nối hai hành động nối tiếp nhau dùng \"and\".'],\n      ['It was raining heavily outside, ______ we stayed home and watched a movie.', ['but', 'so', 'because', 'if'], 1, 'Kết quả của việc trời mưa -> \"so\".'],\n      ['______ many hours a week do you spend in front of a screen?', ['What', 'How', 'Which', 'When'], 1, 'Hỏi số lượng đếm được \"How many hours\".'],\n      ['Do you prefer animated films ______ wildlife documentaries?', ['so', 'but', 'or', 'because'], 2, 'Câu hỏi lựa chọn A hay B dùng \"or\".'],\n      ['The game show is exciting ______ educational for children.', ['and', 'but', 'so', 'yet'], 0, 'Bổ sung hai tính chất tích cực cùng chiều dùng \"and\".'],\n      ['______ is that funny host on the quiz show? — He is a famous MC.', ['What', 'Who', 'Where', 'When'], 1, 'Hỏi danh tính người dùng \"Who\".'],\n      ['I missed the first part of the cartoon, ______ I watched the replay online.', ['but', 'so', 'or', 'because'], 1, 'Chỉ kết quả giải pháp dùng \"so\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 8,\n    title: 'Sports and Games',\n    grammarFocus: 'Past simple & Imperatives',\n    vocab: [\n      ['badminton', 'cầu lông', 'You need two rackets and a shuttlecock to play ______.'],\n      ['racket', 'vợt (cầu lông/tennis)', 'Hold the tennis ______ firmly before hitting the ball.'],\n      ['goggles', 'kính bơi', 'Wear your swimming ______ to protect your eyes underwater.'],\n      ['aerobics', 'thể dục nhịp điệu', 'Mum does ______ with her friends at the fitness club every evening.'],\n      ['chess', 'cờ vua', 'Playing ______ helps students think carefully and plan ahead.'],\n      ['champion', 'nhà vô địch', 'She won the gold medal and became the school swimming ______.'],\n      ['marathon', 'cuộc đua ma-ra-tông', 'Hundreds of runners joined the city ______ on Sunday morning.'],\n      ['sporty', 'yêu thích / giỏi thể thao', 'Nam is very ______; he plays football, basketball, and volleyball.'],\n      ['equipment', 'dụng cụ, thiết bị', 'Always check your climbing ______ before going to the gym.'],\n      ['score', 'ghi bàn / tỷ số', 'Our team managed to ______ the winning goal in the final minute!'],\n    ],\n    grammar: [\n      ['Yesterday afternoon, we ______ football at the town stadium.', ['play', 'plays', 'played', 'playing'], 2, '\"Yesterday afternoon\" -> thì quá khứ đơn động từ có quy tắc: \"played\".'],\n      ['______ on your helmet before riding your bicycle!', ['Put', 'Putting', 'Puts', 'To put'], 0, 'Câu mệnh lệnh khẳng định bắt đầu bằng động từ nguyên mẫu \"Put\".'],\n      ['Last Sunday, Mai ______ first prize in the 100-metre race.', ['win', 'wins', 'won', 'winning'], 2, 'Quá khứ bất quy tắc của \"win\" là \"won\".'],\n      ['______ swim in the lake alone when there is no lifeguard!', ['No', 'Not', 'Don’t', 'Didn’t'], 2, 'Câu mệnh lệnh phủ định dùng \"Don’t + V nguyên mẫu\".'],\n      ['Where ______ you go for the sports festival last week?', ['do', 'did', 'were', 'was'], 1, 'Câu hỏi quá khứ đơn với động từ thường \"go\" dùng \"did\".'],\n      ['My father ______ me how to swim when I was seven years old.', ['teach', 'teaches', 'taught', 'teaching'], 2, 'Quá khứ bất quy tắc của \"teach\" là \"taught\".'],\n      ['We ______ watch the match last night because we were tired.', ['don’t', 'doesn’t', 'didn’t', 'weren’t'], 2, 'Phủ định quá khứ đơn với động từ thường dùng \"didn’t\".'],\n      ['______ late for morning gym practice again, boys!', ['Don’t be', 'Not be', 'Doesn’t be', 'No be'], 0, 'Mệnh lệnh phủ định với tính từ dùng \"Don’t be\".'],\n      ['Our school team ______ very excited after winning the trophy.', ['is', 'was', 'were', 'did'], 1, '\"Our school team\" số ít ở quá khứ dùng \"was\".'],\n      ['Did Duy join the chess competition yesterday? — Yes, he ______.', ['did', 'do', 'was', 'joined'], 0, 'Trả lời ngắn cho \"Did...?\" là \"Yes, he did.\"'],\n      ['______ up your muscles before you start running!', ['Warm', 'Warmed', 'Warming', 'Warms'], 0, 'Câu mệnh lệnh dùng V nguyên mẫu \"Warm\".'],\n      ['Last summer, they ______ cycling along the coast.', ['go', 'goes', 'went', 'going'], 2, 'Quá khứ của \"go\" là \"went\".'],\n      ['I ______ a pair of new running shoes two days ago.', ['buy', 'buys', 'bought', 'buying'], 2, '\"two days ago\" + quá khứ của \"buy\" -> \"bought\".'],\n      ['______ forget to bring a bottle of water to PE class.', ['Don’t', 'Not', 'No', 'Never did'], 0, 'Mệnh lệnh khuyên nhủ phủ định dùng \"Don’t\".'],\n      ['How many goals ______ Viet Nam score in that game?', ['do', 'does', 'did', 'were'], 2, 'Quá khứ đơn với động từ thường \"score\" dùng \"did\".'],\n      ['He fell off his bike and ______ his knee yesterday.', ['hurt', 'hurted', 'hurts', 'hurting'], 0, 'Quá khứ bất quy tắc của \"hurt\" vẫn là \"hurt\".'],\n      ['______ quiet and listen to the coach’s instructions.', ['Be', 'Are', 'Being', 'Is'], 0, 'Mệnh lệnh với tính từ dùng động từ nguyên thể \"Be\".'],\n      ['The fans ______ loudly when our player kicked the ball into the net.', ['cheer', 'cheers', 'cheered', 'cheering'], 2, 'Quá khứ của \"cheer\" là \"cheered\".'],\n      ['We ______ at the sports centre from 3 p.m. to 5 p.m. yesterday.', ['are', 'was', 'were', 'did'], 2, 'Chủ ngữ \"We\" ở quá khứ dùng \"were\".'],\n      ['______ the ball back to your partner now!', ['Pass', 'Passed', 'Passing', 'Passes'], 0, 'Mệnh lệnh khẳng định dùng \"Pass\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 9,\n    title: 'Cities of the World',\n    grammarFocus: 'Possessive adjectives/pronouns & What...! exclamations',\n    vocab: [\n      ['landmark', 'địa danh nổi tiếng', 'Big Ben is an iconic ______ of London.'],\n      ['street food', 'ẩm thực đường phố', 'Visitors love trying banh mi and pho as delicious Vietnamese ______.'],\n      ['floating market', 'chợ nổi', 'Sellers trade fresh fruit from small boats at a ______ in the Mekong Delta.'],\n      ['palace', 'cung điện', 'The Royal ______ in Bangkok shines brightly with gold roofs.'],\n      ['continent', 'châu lục', 'Asia is the largest ______ on Earth.'],\n      ['postcard', 'bưu thiếp', 'I sent a ______ with a picture of the Eiffel Tower to my cousin.'],\n      ['night market', 'chợ đêm', 'You can buy souvenirs and grilled snacks at the ______.'],\n      ['harbour', 'bến cảng', 'Sydney Opera House stands right beside the blue ______.'],\n      ['double-decker', 'xe buýt hai tầng', 'Tourists enjoy sightseeing from the top of a red ______ bus in London.'],\n      ['helpful', 'hay giúp đỡ', 'The local people in Da Nang are warm and ______ to visitors.'],\n    ],\n    grammar: [\n      ['What ______ nice weather we are having in Da Lat today!', ['a', 'an', 'the', 'Ø (no article)'], 3, '\"weather\" là danh từ không đếm được -> không dùng a/an: \"What nice weather!\".'],\n      ['This suitcase is mine, and that blue one is ______.', ['her', 'hers', 'she', 'she’s'], 1, 'Đứng một mình thay cho \"her suitcase\" dùng đại từ sở hữu \"hers\".'],\n      ['______ an exciting city Tokyo is!', ['How', 'What', 'Which', 'Who'], 1, 'Câu cảm thán với danh từ số ít đếm được: \"What + a/an + adj + N!\".'],\n      ['Ha Noi is famous for ______ delicious pho and peaceful lakes.', ['it', 'its', 'it’s', 'their'], 1, 'Tính từ sở hữu của \"it\" là \"its\" (không có dấu nháy).'],\n      ['Is that camera yours? — No, it isn’t ______; it belongs to Nam.', ['my', 'mine', 'me', 'I'], 1, 'Đại từ sở hữu thay cho \"my camera\" -> \"mine\".'],\n      ['What ______ tall buildings there are in Singapore!', ['a', 'an', 'Ø (no article)', 'how'], 2, '\"tall buildings\" số nhiều -> câu cảm thán không dùng a/an.'],\n      ['We love ______ hometown because the food is fresh and cheap.', ['we', 'us', 'our', 'ours'], 2, 'Đứng trước danh từ \"hometown\" dùng tính từ sở hữu \"our\".'],\n      ['Those bicycles are ______; their children ride them to school.', ['them', 'their', 'theirs', 'they'], 2, 'Cuối câu thay thế danh từ -> đại từ sở hữu \"theirs\".'],\n      ['What a ______ sunset over Phu Quoc Island!', ['beautiful', 'beautifully', 'beauty', 'beautify'], 0, 'Cấu trúc \"What a + ADJ + noun!\" dùng tính từ \"beautiful\".'],\n      ['Look at those boys! ______ backpacks are all decorated with country flags.', ['They', 'Their', 'Theirs', 'Them'], 1, 'Trước danh từ \"backpacks\" dùng tính từ sở hữu \"Their\".'],\n      ['Our city has a famous river, and ______ is very clean too.', ['your', 'yours', 'you', 'you’re'], 1, 'Đại từ sở hữu thay cho \"your city\" -> \"yours\".'],\n      ['What ______ interesting museum we visited in Paris!', ['a', 'an', 'Ø', 'some'], 1, '\"interesting\" bắt đầu bằng nguyên âm /ɪ/ -> \"What an interesting museum!\".'],\n      ['She took ______ umbrella because it started to drizzle in London.', ['she', 'her', 'hers', 'herself'], 1, 'Trước danh từ \"umbrella\" dùng \"her\".'],\n      ['These souvenirs are ______. We bought them at the night market.', ['our', 'ours', 'we', 'us'], 1, 'Đại từ sở hữu thay cho \"our souvenirs\" -> \"ours\".'],\n      ['Look at Nick! Is that blue map ______?', ['he', 'him', 'his', 'he’s'], 2, 'Đại từ sở hữu của \"he\" là \"his\".'],\n      ['What ______ colourful flowers along the street!', ['a', 'an', 'Ø', 'the'], 2, '\"flowers\" số nhiều -> không dùng a/an trong câu cảm thán \"What...!\".'],\n      ['My cousin showed me around ______ neighbourhood in Sydney.', ['he', 'him', 'his', 'himself'], 2, 'Tính từ sở hữu \"his\".'],\n      ['That yellow helmet isn’t Mai’s. ______ is green with white stars.', ['Her', 'Hers', 'She', 'She’s'], 1, 'Làm chủ ngữ thay cho \"Her helmet\" dùng \"Hers\".'],\n      ['What ______ tasty street food!', ['a', 'an', 'Ø', 'many'], 2, '\"food\" không đếm được -> không dùng a/an.'],\n      ['Wait! Don’t take that ticket; take ______ on the desk.', ['my', 'mine', 'I', 'me'], 1, 'Thay cho \"my ticket\" dùng \"mine\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 10,\n    title: 'Our Houses in the Future',\n    grammarFocus: 'Future simple (will) & might for possibility',\n    vocab: [\n      ['solar energy', 'năng lượng mặt trời', 'Future houses will use ______ from roof panels to make electricity.'],\n      ['smart TV', 'tivi thông minh', 'You can connect a ______ to the Internet and control it by voice.'],\n      ['wireless', 'không dây', 'In the future, we will charge our phones with ______ power.'],\n      ['appliance', 'thiết bị gia dụng', 'A washing machine is a helpful household ______ that saves time.'],\n      ['robot', 'rô-bốt', 'A home ______ will help us clean floors and water plants.'],\n      ['helicopter', 'máy bay trực thăng', 'Some sky-high villas might have a landing pad for a ______ on the roof.'],\n      ['moon', 'mặt trăng', 'Maybe scientists will build crystal domes for living on the ______.'],\n      ['automatic', 'tự động', 'An ______ dishwasher washes and dries dishes by itself.'],\n      ['contact', 'liên lạc', 'With smart watches, parents can easily ______ their children anywhere.'],\n      ['space', 'không gian vũ trụ', 'Astronauts train for months before travelling into outer ______.'],\n    ],\n    grammar: [\n      ['In 2050, smart robots ______ help us cook and clean the house.', ['will', 'are', 'did', 'were'], 0, 'Dự đoán tương lai với \"In 2050\" dùng \"will + V\".'],\n      ['We ______ live on Mars in the future, but I am not sure yet.', ['will', 'might', 'must', 'did'], 1, 'Không chắc chắn (\"not sure yet\") dùng \"might\".'],\n      ['Will your future house have a swimming pool? — Yes, it ______.', ['is', 'does', 'will', 'might not'], 2, 'Trả lời ngắn cho \"Will...?\" là \"Yes, it will.\"'],\n      ['People ______ need keys in the future because doors will scan faces.', ['will', 'won’t', 'aren’t', 'didn’t'], 1, 'Sẽ không cần chìa khóa -> \"won’t\".'],\n      ['She ______ buy a smart fridge next year if she saves enough money.', ['might', 'is', 'was', 'does'], 0, 'Khả năng có thể xảy ra dùng \"might\".'],\n      ['How ______ you travel to school in 2040? — Maybe by flying car!', ['do', 'did', 'will', 'are'], 2, 'Hỏi về tương lai năm 2040 dùng \"will\".'],\n      ['Solar panels ______ produce clean energy for the whole house.', ['will', 'is', 'was', 'does'], 0, '\"will\" đứng trước động từ nguyên mẫu \"produce\".'],\n      ['Don’t worry, I think it ______ rain tomorrow; the sky looks clear.', ['might', 'won’t', 'will', 'isn’t'], 1, 'Nghĩ rằng trời sẽ không mưa -> \"won’t\".'],\n      ['Maybe my dream house ______ be under the sea so I can watch fish.', ['might', 'is', 'did', 'has'], 0, 'Có từ \"Maybe\" chỉ khả năng -> dùng \"might\".'],\n      ['In the future, TVs ______ be as thin as a sheet of paper.', ['will', 'are', 'were', 'did'], 0, 'Tương lai dùng \"will be\".'],\n      ['Will robots replace teachers? — No, they ______.', ['won’t', 'will', 'aren’t', 'don’t'], 0, 'Phủ định ngắn của \"will\" là \"won’t\".'],\n      ['They ______ visit the space museum next Sunday, depending on the weather.', ['might', 'did', 'were', 'was'], 0, 'Chưa chắc chắn (phụ thuộc thời tiết) -> \"might\".'],\n      ['Where ______ our family live in ten years’ time?', ['do', 'did', 'will', 'were'], 2, '\"in ten years’ time\" -> dùng \"will\".'],\n      ['Smart lights ______ automatically turn off when everyone leaves the room.', ['will', 'is', 'was', 'were'], 0, 'Thì tương lai đơn: \"will + turn off\".'],\n      ['Look at those dark clouds! It ______ rain in a few minutes.', ['might', 'did', 'was', 'isn’t'], 0, 'Dự đoán khả năng sắp mưa -> \"might\".'],\n      ['We ______ have flying bikes soon, who knows!', ['might', 'were', 'are', 'did'], 0, '\"who knows\" thể hiện chưa chắc chắn -> \"might\".'],\n      ['Tomorrow morning, Dad ______ fix the wireless speaker.', ['will', 'did', 'was', 'is'], 0, '\"Tomorrow morning\" -> tương lai đơn \"will fix\".'],\n      ['Future cars ______ run on petrol; they will use electricity or hydrogen.', ['will', 'won’t', 'don’t', 'didn’t'], 1, 'Sẽ không chạy bằng xăng -> \"won’t\".'],\n      ['Might you come to the tech fair with us? — Yes, I ______.', ['will', 'might', 'do', 'am'], 1, 'Trả lời đồng bộ với \"might\".'],\n      ['With a home computer, students ______ study with friends around the world.', ['will', 'were', 'did', 'are'], 0, 'Tương lai dùng \"will + V\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 11,\n    title: 'Our Greener World',\n    grammarFocus: 'Articles (a/an/the) & First conditional',\n    vocab: [\n      ['recycle', 'tái chế', 'We should ______ empty glass bottles and old newspapers.'],\n      ['reuse', 'tái sử dụng', 'Don’t throw away that shopping bag; you can ______ it next time!'],\n      ['reduce', 'giảm thiểu', 'Using cloth bags helps ______ the amount of plastic waste.'],\n      ['plastic bag', 'túi ni-lông', 'Bring your own canvas tote instead of asking for a ______.'],\n      ['rubbish bin', 'thùng rác', 'Please throw the banana peel into the green ______.'],\n      ['pollution', 'sự ô nhiễm', 'Riding bicycles to school helps lower air ______ in cities.'],\n      ['charity', 'từ thiện', 'We donated our old storybooks to a local ______ for rural kids.'],\n      ['noise', 'tiếng ồn', 'Too much traffic ______ makes it hard for students to focus.'],\n      ['swap', 'trao đổi', 'At our school fair, students ______ used toys and comics with each other.'],\n      ['president', 'chủ tịch (câu lạc bộ)', 'Lan was voted ______ of our school’s Green Club this year.'],\n    ],\n    grammar: [\n      ['If we plant more trees, the air in our city ______ fresher.', ['is', 'will be', 'was', 'being'], 1, 'Câu điều kiện loại 1: If + S + V(hiện tại đơn), S + will + V(nguyên mẫu).'],\n      ['We saw ______ interesting poster about saving sea turtles.', ['a', 'an', 'the', 'Ø'], 1, '\"interesting\" bắt đầu bằng nguyên âm -> dùng \"an\".'],\n      ['If students ______ to school by bike, they will save energy.', ['go', 'went', 'will go', 'going'], 0, 'Mệnh đề \"If\" ở câu điều kiện loại 1 chia thì hiện tại đơn -> \"go\".'],\n      ['______ sun gives us light and warmth every day.', ['A', 'An', 'The', 'Ø'], 2, 'Vật thể duy nhất (Mặt Trời, Trái Đất, Mặt Trăng) dùng \"The\".'],\n      ['If Nam ______ off the lights before leaving, he will save electricity.', ['turn', 'turns', 'turned', 'will turn'], 1, 'Chủ ngữ số ít \"Nam\" ở mệnh đề \"If\" -> \"turns\".'],\n      ['My sister has ______ reusable water bottle made of bamboo.', ['a', 'an', 'the', 'Ø'], 0, '\"reusable\" bắt đầu bằng âm /j/ (phụ âm) -> dùng \"a\".'],\n      ['What will happen if we ______ too much plastic waste into the sea?', ['throw', 'throws', 'threw', 'will throw'], 0, 'Mệnh đề \"If\" với \"we\" chia hiện tại đơn -> \"throw\".'],\n      ['Put the cans in ______ recycling bin next to the gate.', ['a', 'an', 'the', 'Ø'], 2, 'Đã xác định rõ vị trí (\"next to the gate\") -> dùng \"the\".'],\n      ['If it rains heavily tomorrow, we ______ have the picnic in the park.', ['will', 'won’t', 'don’t', 'didn’t'], 1, 'Mệnh đề chính câu ĐK loại 1 phủ định -> \"won’t\".'],\n      ['He wants to be ______ environmental scientist when he grows up.', ['a', 'an', 'the', 'Ø'], 1, '\"environmental\" bắt đầu bằng nguyên âm -> dùng \"an\".'],\n      ['If she ______ old clothes to charity, poor children will be very happy.', ['give', 'gives', 'gave', 'will give'], 1, 'Chủ ngữ \"she\" ở mệnh đề If -> \"gives\".'],\n      ['Look at ______ moon tonight! It is bright and round.', ['a', 'an', 'the', 'Ø'], 2, '\"the moon\" (vật duy nhất) dùng \"the\".'],\n      ['We will have cleaner beaches if everyone ______ up their litter.', ['pick', 'picks', 'picked', 'will pick'], 1, '\"everyone\" là đại từ bất định số ít -> \"picks\".'],\n      ['There is ______ green park near my grandparents’ house.', ['a', 'an', 'the', 'Ø'], 0, 'Nhắc lần đầu danh từ số ít đếm được -> \"a\".'],\n      ['If you use both sides of a sheet of paper, you ______ save many trees.', ['will', 'did', 'were', 'do'], 0, 'Mệnh đề chính ĐK loại 1 dùng \"will\".'],\n      ['Wait! Did you turn off ______ tap in the bathroom?', ['a', 'an', 'the', 'Ø'], 2, 'Cả hai đều biết cái vòi nước trong phòng tắm -> dùng \"the\".'],\n      ['If factories ______ toxic waste into rivers, fish will die.', ['dump', 'dumps', 'dumped', 'will dump'], 0, '\"factories\" số nhiều ở mệnh đề If -> \"dump\".'],\n      ['She bought ______ umbrella and a canvas bag at the eco-shop.', ['a', 'an', 'the', 'Ø'], 1, '\"umbrella\" bắt đầu bằng âm nguyên âm /ʌ/ -> \"an\".'],\n      ['Unless we protect forests, wild animals ______ lose their homes.', ['will', 'don’t', 'did', 'were'], 0, 'Unless = If... not -> mệnh đề chính dùng \"will\".'],\n      ['Can you pass me ______ blue glass jar on the shelf?', ['a', 'an', 'the', 'Ø'], 2, 'Vật xác định cụ thể trên kệ -> \"the\".'],\n    ],\n  },\n  {\n    grade: 6,\n    unit: 12,\n    title: 'Robots',\n    grammarFocus: 'Superlative adjectives (short & long)',\n    vocab: [\n      ['guard', 'canh gác, bảo vệ', 'A security robot can ______ our house and send alerts at night.'],\n      ['repair', 'sửa chữa', 'Worker robots are strong enough to ______ heavy bridges.'],\n      ['space station', 'trạm vũ trụ', 'Special robots help astronauts outside the ______.'],\n      ['helpful', 'hữu ích', 'Home robots are very ______ for elderly people who live alone.'],\n      ['weight', 'trọng lượng, cân nặng', 'This strong machine can lift a ______ of up to 500 kilograms!'],\n      ['feelings', 'cảm xúc', 'Unlike humans, most robots do not have real ______ like joy or sadness.'],\n      ['broken', 'bị hỏng', 'Can the mechanic robot fix a ______ washing machine?'],\n      ['doctor robot', 'rô-bốt bác sĩ', 'A ______ can check a patient’s temperature and heart rate.'],\n      ['height', 'chiều cao', 'That humanoid robot has a ______ of 1.5 metres.'],\n      ['pick', 'hái (quả)', 'Farm robots use soft hands to ______ ripe strawberries gently.'],\n    ],\n    grammar: [\n      ['This AI robot is the ______ machine at our school science fair.', ['smart', 'smarter', 'smartest', 'most smart'], 2, 'So sánh nhất tính từ ngắn \"smart\" -> \"the smartest\".'],\n      ['That golden robot is the ______ expensive model in the exhibition.', ['more', 'most', 'much', 'very'], 1, 'So sánh nhất tính từ dài \"expensive\" -> \"the most expensive\".'],\n      ['Which is the ______ planet in our solar system?', ['big', 'bigger', 'biggest', 'most big'], 2, '\"big\" gấp đôi phụ âm cuối ở so sánh nhất -> \"biggest\".'],\n      ['Doctor robots can do some of the ______ work in hospitals.', ['important', 'more important', 'most important', 'importanter'], 2, 'So sánh nhất tính từ dài -> \"the most important\".'],\n      ['Robo-K9 is the ______ robot in the obstacle race.', ['fast', 'faster', 'fastest', 'most fast'], 2, 'Tính từ ngắn \"fast\" -> \"the fastest\".'],\n      ['This is the ______ useful app I have ever downloaded for learning English.', ['more', 'most', 'very', 'good'], 1, 'Tính từ dài \"useful\" -> \"the most useful\".'],\n      ['Mount Fansipan is the ______ mountain in Viet Nam.', ['high', 'higher', 'highest', 'most high'], 2, 'So sánh nhất với \"high\" -> \"the highest\".'],\n      ['Who is the ______ student in your robotics club?', ['good', 'better', 'best', 'most good'], 2, 'So sánh nhất bất quy tắc của \"good\" là \"best\".'],\n      ['I think space robots have the ______ dangerous job of all.', ['more', 'most', 'very', 'much'], 1, 'Tính từ dài \"dangerous\" -> \"the most dangerous\".'],\n      ['The red robot is the ______ among the three designs.', ['heavy', 'heavier', 'heaviest', 'most heavy'], 2, '\"heavy\" đổi -y thành -iest -> \"the heaviest\".'],\n      ['That old toy robot was the ______ gift I received when I was five.', ['happy', 'happier', 'happiest', 'most happy'], 2, '\"happy\" -> \"the happiest\".'],\n      ['What is the ______ thing a home robot can do for your family?', ['bad', 'worse', 'worst', 'most bad'], 2, 'So sánh nhất bất quy tắc của \"bad\" là \"worst\".'],\n      ['Tiny nanobots are the ______ robots in medical research.', ['small', 'smaller', 'smallest', 'most small'], 2, 'Tính từ ngắn \"small\" -> \"the smallest\".'],\n      ['She built the ______ creative robot in Grade 6.', ['more', 'most', 'much', 'less'], 1, 'So sánh nhất của \"creative\" -> \"the most creative\".'],\n      ['Which robot is the ______ noisy when cleaning the floor?', ['little', 'less', 'least', 'fewest'], 2, 'So sánh nhất của ít ồn nhất -> \"the least noisy\".'],\n      ['Today’s robot race was the ______ exciting event of the semester.', ['more', 'most', 'very', 'so'], 1, 'So sánh nhất \"the most exciting\".'],\n      ['The giant factory arm is the ______ machine in this workshop.', ['strong', 'stronger', 'strongest', 'most strong'], 2, 'Tính từ ngắn \"strong\" -> \"the strongest\".'],\n      ['He chose the ______ comfortable chair in the robot showroom.', ['more', 'most', 'very', 'best'], 1, 'Tính từ dài \"comfortable\" -> \"the most comfortable\".'],\n      ['This is the ______ funny cartoon robot on TV.', ['funny', 'funnier', 'funniest', 'most funny'], 2, '\"funny\" đổi -y thành -iest -> \"the funniest\".'],\n      ['The solar-powered robot is the ______ eco-friendly option here.', ['more', 'most', 'much', 'very'], 1, '\"eco-friendly\" dùng \"the most eco-friendly\".'],\n    ],\n  },\n\n  // ==================== GRADE 7 ====================\n  {\n    grade: 7,\n    unit: 1,\n    title: 'Hobbies',\n    grammarFocus: 'Present simple & Verbs of liking + V-ing',\n    vocab: [\n      ['dollhouse', 'nhà búp bê', 'Trang builds miniature rooms inside a wooden ______ at weekends.'],\n      ['cardboard', 'bìa các-tông', 'We reuse old ______ boxes to craft model castles.'],\n      ['horse riding', 'cưỡi ngựa', 'Last holiday she tried ______ at a farm in the highlands.'],\n      ['gardening', 'làm vườn', 'My grandfather enjoys ______; he grows roses and tomatoes.'],\n      ['judo', 'võ Judo', 'Mark practises ______ twice a week to stay strong and calm.'],\n      ['coin collecting', 'sưu tầm tiền xu', 'His favourite hobby is ______ from different countries.'],\n      ['patient', 'kiên nhẫn', 'Making ship models requires you to be calm and ______.'],\n      ['glue', 'keo dán', 'Use this paper ______ to stick the coloured stars together.'],\n      ['creativity', 'sự sáng tạo', 'Painting landscapes develops children’s imagination and ______.'],\n      ['unusual', 'khác thường, độc đáo', 'Collecting train tickets is an ______ but interesting hobby!'],\n    ],\n    grammar: [\n      ['My sister loves ______ teddy bears and little plastic animals.', ['collect', 'collects', 'collecting', 'collected'], 2, 'Sau động từ chỉ sở thích \"love\" dùng V-ing -> \"collecting\".'],\n      ['Does your brother enjoy ______ model planes in his free time?', ['make', 'makes', 'making', 'to making'], 2, 'Cấu trúc \"enjoy + V-ing\" -> \"making\".'],\n      ['The flight to Ha Noi ______ at 9:15 every morning.', ['leave', 'leaves', 'leaving', 'is leave'], 1, 'Lịch trình cố định chia hiện tại đơn -> \"leaves\".'],\n      ['I hate ______ up early on cold winter Sundays.', ['get', 'gets', 'getting', 'got'], 2, 'Sau \"hate\" dùng V-ing -> \"getting\".'],\n      ['Nam’s hobby is ______ photographs of wild birds.', ['take', 'taking', 'takes', 'took'], 1, 'Danh động từ làm bổ ngữ sau \"is\": \"taking\".'],\n      ['My parents ______ like watching action films; they prefer comedies.', ['don’t', 'doesn’t', 'aren’t', 'isn’t'], 0, 'Hiện tại đơn phủ định với \"My parents\" -> \"don’t\".'],\n      ['What does Mai like ______ after finishing her homework?', ['do', 'does', 'doing', 'did'], 2, '\"like + V-ing\" -> \"doing\".'],\n      ['Water ______ at 100 degrees Celsius.', ['boil', 'boils', 'boiling', 'boiled'], 1, 'Sự thật hiển nhiên chia hiện tại đơn -> \"boils\".'],\n      ['We often ______ jogging in the park before breakfast.', ['go', 'goes', 'going', 'went'], 0, 'Thói quen hiện tại đơn với \"We\" -> \"go\".'],\n      ['He dislikes ______ the dishes after dinner.', ['wash', 'washing', 'washes', 'washed'], 1, 'Sau \"dislike\" dùng V-ing -> \"washing\".'],\n      ['The library ______ at 8:00 a.m. and closes at 5:00 p.m.', ['open', 'opens', 'opening', 'opened'], 1, 'Giờ mở cửa cố định dùng hiện tại đơn -> \"opens\".'],\n      ['Do you fancy ______ badminton with us this afternoon?', ['play', 'playing', 'to play', 'played'], 1, 'Sau \"fancy\" (thích) chỉ dùng V-ing -> \"playing\".'],\n      ['Lan ______ plays the guitar for half an hour every evening.', ['usually', 'is usually', 'does usually', 'usually is'], 0, 'Trạng từ tần suất đứng trước động từ thường \"plays\".'],\n      ['They don’t mind ______ to school when the weather is cool.', ['walk', 'walking', 'walks', 'walked'], 1, 'Sau \"don’t mind\" (không ngại) dùng V-ing -> \"walking\".'],\n      ['______ your cousin share the same hobby with you?', ['Do', 'Does', 'Is', 'Are'], 1, '\"your cousin\" số ít -> dùng \"Does\".'],\n      ['Minh is keen on ______ comic books about space.', ['read', 'reads', 'reading', 'to read'], 2, 'Sau giới từ \"on\" dùng V-ing -> \"reading\".'],\n      ['The Earth ______ around the Sun once every year.', ['move', 'moves', 'moving', 'moved'], 1, 'Chân lý khoa học dùng hiện tại đơn -> \"moves\".'],\n      ['My grandmother loves ______ flowers on the balcony.', ['plant', 'planting', 'plants', 'planted'], 1, '\"loves + V-ing\" -> \"planting\".'],\n      ['We ______ have art club on Thursdays; it’s on Wednesdays.', ['don’t', 'doesn’t', 'aren’t', 'isn’t'], 0, 'Phủ định hiện tại đơn với \"We\" -> \"don’t\".'],\n      ['Playing board games ______ great fun on rainy days.', ['is', 'are', 'am', 'be'], 0, 'Danh động từ làm chủ ngữ (\"Playing...\") chia động từ số ít -> \"is\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 2,\n    title: 'Healthy Living',\n    grammarFocus: 'Simple sentences & Healthy habits',\n    vocab: [\n      ['sunburn', 'cháy nắng', 'Wear a wide-brimmed hat at noon to avoid getting a painful ______.'],\n      ['chapped lips', 'môi nứt nẻ', 'Cold winter wind often causes dry skin and ______.'],\n      ['acne', 'mụn trứng cá', 'Washing your face gently helps reduce ______ in teenagers.'],\n      ['soft drinks', 'nước ngọt có ga', 'Drinking too many ______ adds extra sugar to your diet.'],\n      ['dim light', 'ánh sáng yếu/mờ', 'Never read books in ______ because it harms your eyes.'],\n      ['vegetarian', 'người ăn chay', 'A ______ eats vegetables, beans, and fruit instead of meat.'],\n      ['calories', 'ca-lo (năng lượng)', 'Running for 30 minutes burns a lot of ______.'],\n      ['eyedrops', 'thuốc nhỏ mắt', 'If your eyes feel dry after studying, ask a doctor before using ______.'],\n      ['soybean', 'đậu nành', 'Tofu is a healthy food made from ______.'],\n      ['fit', 'khỏe mạnh, cân đối', 'Exercising every morning keeps you active and ______.'],\n    ],\n    grammar: [\n      ['Which of the following is a complete simple sentence?', ['Drink water and rest.', 'Drinking water.', 'Because I am tired.', 'Fresh vegetables every day.'], 0, 'Câu đơn hoàn chỉnh có động từ chính (câu mệnh lệnh \"Drink water and rest.\").'],\n      ['Fresh fruits ______ plenty of vitamins and fibre.', ['provides', 'provide', 'providing', 'is providing'], 1, 'Chủ ngữ số nhiều \"Fresh fruits\" dùng \"provide\".'],\n      ['My brother eats fish ______ vegetables for dinner.', ['but', 'and', 'so', 'or'], 1, 'Nối hai danh từ cùng bổ ngữ trong câu đơn dùng \"and\".'],\n      ['You shouldn’t ______ too much fast food like chips and burgers.', ['eat', 'eats', 'eating', 'ate'], 0, 'Sau \"shouldn’t\" dùng động từ nguyên mẫu \"eat\".'],\n      ['Eating too much sugar ______ bad for your teeth.', ['is', 'are', 'am', 'were'], 0, 'Chủ ngữ là cụm V-ing \"Eating...\" chia số ít -> \"is\".'],\n      ['Let’s identify the subject in: \"Vietnamese people drink a lot of green tea.\"', ['Vietnamese', 'Vietnamese people', 'drink', 'green tea'], 1, 'Chủ ngữ của câu đơn này là cụm danh từ \"Vietnamese people\".'],\n      ['He washes his hands regularly ______ keeps his room tidy.', ['and', 'so', 'but', 'or'], 0, 'Câu đơn có hai vị ngữ song song nối bằng \"and\".'],\n      ['______ enough sleep every night helps you focus in class.', ['Get', 'Getting', 'Gets', 'Got'], 1, 'Cụm danh động từ làm chủ ngữ -> \"Getting\".'],\n      ['Should I use lip balm for my chapped lips? — Yes, you ______.', ['do', 'are', 'should', 'can’t'], 2, 'Trả lời cho câu hỏi \"Should...?\" dùng \"should\".'],\n      ['Lan ______ jogs around the lake every morning.', ['active', 'actively', 'is active', 'activity'], 1, 'Trạng từ \"actively\" bổ nghĩa cho động từ \"jogs\".'],\n      ['Too much screen time ______ cause tired eyes and headaches.', ['can', 'is', 'are', 'does'], 0, 'Động từ khuyết thiếu \"can + V nguyên mẫu\".'],\n      ['Identify the object in: \"Tofu contains plant protein.\"', ['Tofu', 'contains', 'plant protein', 'protein'], 2, 'Tân ngữ trực tiếp của \"contains\" là \"plant protein\".'],\n      ['My parents and I ______ cycling every Sunday morning.', ['go', 'goes', 'going', 'is going'], 0, 'Chủ ngữ ghép \"My parents and I\" -> \"go\".'],\n      ['Drink at least 1.5 litres of water a day to ______ healthy.', ['stay', 'stays', 'staying', 'stayed'], 0, 'Sau \"to\" chỉ mục đích dùng nguyên mẫu \"stay\".'],\n      ['Avoid ______ salty snacks late at night.', ['eat', 'eats', 'eating', 'to eat'], 2, 'Sau động từ \"Avoid\" dùng V-ing -> \"eating\".'],\n      ['Children need ______ outdoors for at least an hour daily.', ['play', 'to play', 'played', 'plays'], 1, '\"need + to V\" -> \"to play\".'],\n      ['Breakfast gives ______ energy for a whole morning of learning.', ['we', 'our', 'us', 'ours'], 2, 'Sau động từ \"gives\" dùng tân ngữ \"us\".'],\n      ['How ______ hours of sleep does a teenager need each night?', ['much', 'many', 'long', 'often'], 1, '\"hours\" đếm được số nhiều -> \"How many\".'],\n      ['Reading in bright light ______ your eyesight.', ['protect', 'protects', 'protecting', 'protected'], 1, 'Chủ ngữ V-ing \"Reading...\" chia số ít -> \"protects\".'],\n      ['Choose the correct simple sentence:', ['Good health matters.', 'When good health matters.', 'Health and fitness.', 'To be healthy every day.'], 0, '\"Good health matters.\" có đủ Chủ ngữ + Động từ chia thì.'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 3,\n    title: 'Community Service',\n    grammarFocus: 'Past simple & Volunteer activities',\n    vocab: [\n      ['volunteer', 'tình nguyện viên', 'High school students worked as ______ to clean the local beach.'],\n      ['nursing home', 'viện dưỡng lão', 'Last Saturday we sang songs for elderly people at the ______.'],\n      ['donate', 'quyên góp', 'Our class decided to ______ warm coats to children in mountainous areas.'],\n      ['litter', 'rác vứt bừa bãi', 'Students spent Sunday morning picking up ______ along the river.'],\n      ['homeless', 'vô gia cư', 'The charity club provides hot meals for ______ people in winter.'],\n      ['tutor', 'dạy kèm', 'Older teenagers often ______ younger kids in Maths and English.'],\n      ['plant trees', 'trồng cây', 'We joined the Green Sunday event to ______ along the new street.'],\n      ['exchange', 'trao đổi', 'Students can ______ plastic bottles for potted succulents.'],\n      ['flooded', 'bị ngập lụt', 'Volunteers sent clean water and noodles to families in ______ villages.'],\n      ['proud', 'tự hào', 'We felt very ______ after painting the community library walls.'],\n    ],\n    grammar: [\n      ['Last month, our club ______ 200 notebooks to rural primary students.', ['donate', 'donates', 'donated', 'donating'], 2, '\"Last month\" -> thì quá khứ đơn: \"donated\".'],\n      ['They ______ a lot of plastic rubbish at the park yesterday.', ['collect', 'collected', 'collecting', 'collects'], 1, '\"yesterday\" -> quá khứ đơn \"collected\".'],\n      ['We ______ very happy to see the elderly residents smile.', ['was', 'were', 'did', 'are'], 1, 'Chủ ngữ \"We\" ở quá khứ dùng \"were\".'],\n      ['______ Mai join the tree-planting project two weeks ago?', ['Do', 'Does', 'Did', 'Was'], 2, 'Câu hỏi quá khứ đơn với \"join\" dùng \"Did\".'],\n      ['Nick ______ go to the nursing home last Sunday because he had a fever.', ['don’t', 'doesn’t', 'didn’t', 'wasn’t'], 2, 'Phủ định quá khứ đơn dùng \"didn’t\".'],\n      ['Last year, Minh ______ younger children how to read English stories.', ['teach', 'teaches', 'taught', 'teaching'], 2, 'Quá khứ bất quy tắc của \"teach\" là \"taught\".'],\n      ['We ______ old clothes and packed them neatly into boxes.', ['sort', 'sorted', 'sorting', 'sorts'], 1, 'Quá khứ đơn đồng bộ với \"packed\" -> \"sorted\".'],\n      ['How much money ______ your school raise for charity last Tet?', ['do', 'did', 'does', 'were'], 1, 'Hỏi ở quá khứ đơn -> \"did\".'],\n      ['I ______ some cute greeting cards for our community fair yesterday.', ['make', 'made', 'making', 'makes'], 1, 'Quá khứ của \"make\" là \"made\".'],\n      ['They ______ at the community kitchen until 6 p.m. last Saturday.', ['stay', 'stayed', 'staying', 'stays'], 1, 'Quá khứ có quy tắc \"stayed\".'],\n      ['What ______ you do during last summer’s volunteer camp?', ['do', 'did', 'were', 'are'], 1, 'Hỏi hành động quá khứ dùng \"did\".'],\n      ['The villagers ______ thankful for the clean water filters.', ['was', 'were', 'did', 'is'], 1, '\"The villagers\" số nhiều ở quá khứ dùng \"were\".'],\n      ['She ______ a birthday cake for an old lady at the care centre.', ['bake', 'bakes', 'baked', 'baking'], 2, 'Quá khứ của \"bake\" là \"baked\".'],\n      ['Did the boys clean the playground? — No, they ______; it rained.', ['didn’t', 'don’t', 'weren’t', 'did'], 0, 'Trả lời ngắn phủ định \"Did...?\" là \"No, they didn’t.\"'],\n      ['We ______ ten new saplings in the school garden three days ago.', ['plant', 'planted', 'planting', 'plants'], 1, '\"three days ago\" -> \"planted\".'],\n      ['He ______ a big basket of vegetables from his home garden.', ['bring', 'brings', 'brought', 'bringing'], 2, 'Quá khứ của \"bring\" là \"brought\".'],\n      ['Yesterday morning, I ______ up at 6:00 to join the clean-up team.', ['wake', 'wakes', 'woke', 'waking'], 2, 'Quá khứ của \"wake\" là \"woke\".'],\n      ['Who ______ you work with in the street-painting project?', ['did', 'do', 'was', 'were'], 0, 'Hỏi quá khứ động từ thường \"work\" -> \"did\".'],\n      ['Our teacher ______ photos while we were planting flowers.', ['take', 'took', 'taken', 'taking'], 1, 'Quá khứ của \"take\" là \"took\".'],\n      ['Every student ______ a small gift for the children’s hospital.', ['give', 'gives', 'gave', 'giving'], 2, 'Quá khứ của \"give\" là \"gave\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 4,\n    title: 'Music and Arts',\n    grammarFocus: 'Comparisons (like, different from, (not) as...as)',\n    vocab: [\n      ['water puppetry', 'múa rối nước', '______ is a famous traditional performing art of northern Viet Nam.'],\n      ['portrait', 'tranh chân dung', 'The artist painted a realistic ______ of his grandmother.'],\n      ['composer', 'nhà soạn nhạc', 'Trinh Cong Son is a beloved Vietnamese ______.'],\n      ['museum', 'bảo tàng', 'Let’s visit the Fine Arts ______ to admire classic paintings.'],\n      ['orchestra', 'dàn nhạc giao hưởng', 'Dozens of violinists and cellists perform together in the ______.'],\n      ['perform', 'biểu diễn', 'Our class will ______ a folk dance at the school festival.'],\n      ['paintbrush', 'cọ vẽ', 'Wash your ______ with clean water right after painting.'],\n      ['sculpture', 'tác phẩm điêu khắc', 'There is a tall stone ______ standing in the centre of the park.'],\n      ['folk music', 'âm nhạc dân gian', 'Quan Ho Bac Ninh is a treasured form of Vietnamese ______.'],\n      ['exhibition', 'triển lãm', 'The photography ______ opens to the public from Friday to Sunday.'],\n    ],\n    grammar: [\n      ['Classical music is not ______ exciting ______ rock music.', ['as / as', 'more / as', 'different / from', 'like / as'], 0, 'So sánh không bằng dùng \"not as + adj + as\".'],\n      ['My painting style is quite different ______ my sister’s.', ['with', 'from', 'to', 'as'], 1, 'Cấu trúc cố định \"different from\" (khác với).'],\n      ['Your new guitar looks just ______ mine!', ['as', 'from', 'like', 'than'], 2, 'Giống như dùng \"like + N/đại từ\".'],\n      ['This piano concert isn’t as long ______ the violin recital yesterday.', ['so', 'as', 'than', 'from'], 1, 'So sánh bằng / không bằng: \"(not) as... as\".'],\n      ['The City Art Gallery is ______ noisy ______ the night market.', ['not as / as', 'different / as', 'like / from', 'more / as'], 0, 'Ít ồn ào hơn dùng \"not as noisy as\".'],\n      ['Folk songs in the north are different ______ those in the Mekong Delta.', ['as', 'like', 'from', 'than'], 2, 'Cụm từ cố định \"different from\".'],\n      ['She sings like ______ professional pop star!', ['a', 'an', 'from', 'as'], 0, '\"like a + danh từ\" (như một ca sĩ chuyên nghiệp).'],\n      ['Is drawing with charcoal as easy ______ painting with watercolours?', ['than', 'as', 'from', 'like'], 1, 'So sánh ngang bằng: \"as easy as\".'],\n      ['Today’s school play was ______ good as last year’s performance.', ['so', 'as', 'like', 'more'], 1, 'Khẳng định so sánh bằng dùng \"as good as\".'],\n      ['This bamboo flute sounds completely ______ from a brass trumpet.', ['like', 'same', 'different', 'as'], 2, 'Đi với giới từ \"from\" dùng \"different\".'],\n      ['His voice is ______ sweet ______ honey when he sings lullabies.', ['as / as', 'like / as', 'more / than', 'different / from'], 0, 'So sánh ngang bằng: \"as sweet as\".'],\n      ['Pop music today isn’t the same ______ pop music in the 1990s.', ['from', 'as', 'than', 'with'], 1, 'Cấu trúc cố định \"the same as\" (giống hệt với).'],\n      ['The drum looks ______ a traditional Dong Son bronze drum.', ['as', 'from', 'like', 'than'], 2, '\"look like + N\" (trông giống như).'],\n      ['Nam doesn’t play the violin as ______ as his older brother.', ['good', 'well', 'better', 'best'], 1, 'Bổ nghĩa cho động từ thường \"play\" dùng trạng từ \"well\".'],\n      ['The museum ticket isn’t ______ expensive as the theatre ticket.', ['as', 'more', 'than', 'from'], 0, 'So sánh không bằng dùng \"as... as\".'],\n      ['Every traditional puppet is different ______ the others in colour and expression.', ['to', 'from', 'as', 'like'], 1, '\"different from\".'],\n      ['A cello looks ______ a giant violin!', ['as', 'like', 'from', 'same'], 1, '\"looks like\".'],\n      ['Lan can dance ______ gracefully as a ballet dancer.', ['so', 'like', 'as', 'from'], 2, '\"as + adv + as\" -> \"as gracefully as\".'],\n      ['This photo exhibition is not ______ interesting as the 3D art show.', ['so', 'more', 'than', 'like'], 0, 'Trong câu phủ định có thể dùng \"not so/as + adj + as\".'],\n      ['My hobby is different from ______, because I prefer sculpting.', ['her', 'hers', 'she', 'she’s'], 1, 'Sau \"from\" thay cho \"her hobby\" dùng đại từ sở hữu \"hers\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 5,\n    title: 'Food and Drink',\n    grammarFocus: 'some, a lot of, lots of & How much/How many',\n    vocab: [\n      ['omelette', 'trứng ốp-la / rán', 'Beat two eggs with a pinch of salt to cook an ______.'],\n      ['pancake', 'bánh kếp', 'We eat warm ______ with honey and sliced bananas for breakfast.'],\n      ['broth', 'nước dùng (phở/bún)', 'Beef bones are simmered for hours to make sweet pho ______.'],\n      ['turmeric', 'nghệ', 'Yellow ______ powder gives fried fish cakes a lovely golden colour.'],\n      ['spring rolls', 'nem rán / chả giò', 'Crispy Vietnamese ______ are served with fresh herbs and dipping sauce.'],\n      ['teaspoon', 'thìa cà phê', 'Add one ______ of sugar to the cup of lemon tea.'],\n      ['flour', 'bột mì', 'You need 200 grams of white ______ to bake this sponge cake.'],\n      ['ingredient', 'nguyên liệu', 'Fresh lemongrass is a key ______ in many Vietnamese dishes.'],\n      ['pepper', 'hạt tiêu', 'Sprinkle a little black ______ over the hot soup.'],\n      ['mineral water', 'nước khoáng', 'Would you prefer orange juice or a bottle of ______?'],\n    ],\n    grammar: [\n      ['How ______ butter do we need to make these cookies?', ['many', 'much', 'few', 'some'], 1, '\"butter\" không đếm được -> dùng \"How much\".'],\n      ['There is ______ milk in the fridge, enough for three glasses.', ['a lot of', 'many', 'a few', 'any'], 0, '\"a lot of\" dùng được với danh từ không đếm được \"milk\" trong câu khẳng định.'],\n      ['How ______ eggs are left in the carton?', ['much', 'many', 'little', 'a lot'], 1, '\"eggs\" đếm được số nhiều -> \"How many\".'],\n      ['Would you like ______ apple juice with your sandwich?', ['any', 'some', 'many', 'a few'], 1, 'Lời mời lịch sự dùng \"some\".'],\n      ['We don’t have ______ cooking oil left. Let’s buy a bottle.', ['some', 'many', 'any', 'a few'], 2, 'Câu phủ định dùng \"any\".'],\n      ['There are ______ fresh tomatoes in the basket.', ['lots of', 'much', 'a little', 'an'], 0, '\"lots of\" đi với danh từ đếm được số nhiều \"tomatoes\".'],\n      ['Add ______ salt to the soup, just half a teaspoon.', ['many', 'some', 'a few', 'several'], 1, '\"salt\" không đếm được dùng \"some\".'],\n      ['How ______ slices of bread can you eat for breakfast?', ['much', 'many', 'long', 'often'], 1, '\"slices\" đếm được số nhiều -> \"How many\".'],\n      ['Is there ______ rice left in the rice cooker?', ['many', 'some', 'any', 'a few'], 2, 'Câu hỏi dùng \"any\".'],\n      ['She bought ______ cartons of yoghurt at the supermarket.', ['much', 'some', 'a little', 'any'], 1, 'Câu khẳng định dùng \"some\".'],\n      ['How ______ sugar should I put in your iced coffee?', ['many', 'much', 'few', 'number'], 1, '\"sugar\" không đếm được -> \"How much\".'],\n      ['My grandmother grows ______ herbs in pots on the balcony.', ['a lot of', 'much', 'a little', 'an'], 0, '\"a lot of\" dùng được với \"herbs\" số nhiều.'],\n      ['Wait! We haven’t got ______ onions for the beef noodle soup.', ['some', 'any', 'much', 'a little'], 1, 'Câu phủ định với \"onions\" -> \"any\".'],\n      ['Can I have ______ bowl of chicken noodle soup, please?', ['some', 'a', 'any', 'many'], 1, '\"bowl\" số ít đếm được -> dùng \"a\".'],\n      ['There is ______ honey in that glass jar.', ['many', 'a few', 'lots of', 'several'], 2, '\"honey\" không đếm được -> \"lots of\".'],\n      ['How ______ litres of milk does your family drink every week?', ['much', 'many', 'big', 'heavy'], 1, '\"litres\" đếm được số nhiều -> \"How many\".'],\n      ['He doesn’t drink ______ coffee in the evening.', ['some', 'any', 'many', 'a few'], 1, 'Câu phủ định không đếm được -> \"any\".'],\n      ['Please buy ______ flour and a dozen eggs on your way home.', ['some', 'any', 'many', 'a few'], 0, 'Khẳng định không đếm được -> \"some\".'],\n      ['How ______ people are coming to the family dinner tonight?', ['much', 'many', 'little', 'some'], 1, '\"people\" đếm được số nhiều -> \"How many\".'],\n      ['There are ______ strawberries in the fridge if you want a snack.', ['much', 'a little', 'some', 'any'], 2, 'Khẳng định số nhiều -> \"some\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 6,\n    title: 'A Visit to a School',\n    grammarFocus: 'Prepositions of time & place (in, on, at)',\n    vocab: [\n      ['campus', 'khuôn viên trường', 'Our school ______ has green lawns, a library, and a science lab.'],\n      ['entrance exam', 'kỳ thi tuyển sinh', 'Grade 9 students study hard to pass the high school ______.'],\n      ['midterm test', 'bài kiểm tra giữa kỳ', 'We will take the English ______ next Wednesday morning.'],\n      ['laboratory', 'phòng thí nghiệm', 'Students wear safety goggles when doing experiments in the ______.'],\n      ['gifted', 'năng khiếu / chuyên', 'She passed the test to enter the city’s ______ secondary school.'],\n      ['facilities', 'cơ sở vật chất', 'The school has modern sports ______, including an indoor pool.'],\n      ['outdoor', 'ngoài trời', 'Camping and tree planting are popular ______ activities for students.'],\n      ['projector', 'máy chiếu', 'Our teacher uses a ceiling ______ to show slides on the board.'],\n      ['royal', 'thuộc về hoàng gia', 'Quoc Hoc Hue was originally built as a ______ academy.'],\n      ['resource', 'nguồn tài liệu', 'The online library is a wonderful learning ______ for pupils.'],\n    ],\n    grammar: [\n      ['Our school library opens ______ 7:30 a.m. every weekday.', ['in', 'on', 'at', 'for'], 2, 'Giờ giấc cụ thể dùng giới từ \"at\".'],\n      ['The school anniversary festival takes place ______ November 20th.', ['in', 'on', 'at', 'between'], 1, 'Ngày tháng cụ thể dùng giới từ \"on\".'],\n      ['We usually hold our outdoor sports day ______ autumn.', ['in', 'on', 'at', 'by'], 0, 'Mùa trong năm dùng giới từ \"in\".'],\n      ['Students are doing a chemistry experiment ______ the science laboratory.', ['on', 'in', 'at', 'under'], 1, 'Bên trong một phòng kín dùng \"in\".'],\n      ['Wait for me ______ the main school gate after class!', ['in', 'on', 'at', 'between'], 2, 'Điểm cụ thể (cổng trường) dùng \"at\".'],\n      ['Chu Van An School was founded ______ 1908.', ['at', 'on', 'in', 'for'], 2, 'Năm dùng giới từ \"in\".'],\n      ['There are many colourful posters ______ the classroom wall.', ['in', 'on', 'at', 'into'], 1, 'Trên bề mặt tường dùng \"on\".'],\n      ['We don’t have extra lessons ______ Sundays.', ['in', 'on', 'at', 'during'], 1, 'Các thứ trong tuần dùng \"on\".'],\n      ['My classroom is ______ the second floor of Building B.', ['in', 'at', 'on', 'above'], 2, 'Các tầng nhà dùng \"on the second floor\".'],\n      ['The science club meets ______ lunchtime on Fridays.', ['in', 'at', 'on', 'for'], 1, 'Thời điểm bữa trưa/nửa đêm dùng \"at lunchtime\".'],\n      ['She likes reading history books ______ the morning.', ['in', 'on', 'at', 'to'], 0, 'Các buổi trong ngày (morning/afternoon/evening) dùng \"in\".'],\n      ['Students must arrive ______ time for the morning flag-raising ceremony.', ['on', 'at', 'by', 'into'], 0, 'Cụm cố định \"on time\" (đúng giờ).'],\n      ['They hung the school banner right ______ the entrance.', ['in', 'above', 'into', 'at'], 1, 'Treo phía trên lối vào -> \"above\".'],\n      ['We visited the Temple of Literature ______ October.', ['at', 'on', 'in', 'to'], 2, 'Tháng dùng giới từ \"in\".'],\n      ['Look! The principal is standing ______ the stage.', ['in', 'on', 'at', 'under'], 1, 'Trên sân khấu dùng \"on the stage\".'],\n      ['Is your computer room ______ the ground floor?', ['in', 'at', 'on', 'to'], 2, 'Tầng trệt vẫn dùng \"on the ground floor\".'],\n      ['The bell rings ______ noon when morning classes finish.', ['in', 'on', 'at', 'for'], 2, '\"at noon\" (vào buổi trưa 12h).'],\n      ['We learned about solar eclipses ______ Geography class today.', ['in', 'on', 'at', 'over'], 0, 'Trong giờ học môn nào đó dùng \"in Geography class\".'],\n      ['Let’s meet ______ 4:15 p.m. outside the gym.', ['in', 'on', 'at', 'from'], 2, 'Giờ cụ thể dùng \"at\".'],\n      ['Many old trees grow ______ the school yard.', ['in', 'on', 'at', 'under'], 0, 'Trong khuôn viên sân trường dùng \"in\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 7,\n    title: 'Traffic',\n    grammarFocus: 'It indicating distance & should/shouldn’t for traffic',\n    vocab: [\n      ['pavement', 'vỉa hè', 'Pedestrians must walk safely on the ______ rather than the road.'],\n      ['zebra crossing', 'vạch kẻ qua đường', 'Wait for the green light and walk across at the ______.'],\n      ['traffic jam', 'tắc đường', 'Morning rush hour often causes a long ______ on main avenues.'],\n      ['helmet', 'mũ bảo hiểm', 'You must wear a fastened ______ whenever you ride a motorbike or e-bike.'],\n      ['seatbelt', 'dây an toàn', 'Fasten your ______ as soon as you sit inside a car.'],\n      ['roundabout', 'vòng xuyến / bùng binh', 'Take the second exit at the ______ to reach the museum.'],\n      ['speed limit', 'giới hạn tốc độ', 'Drivers must obey the ______ of 40 km/h near schools.'],\n      ['pedestrian', 'người đi bộ', 'Watch out for any ______ crossing the street ahead.'],\n      ['handlebars', 'tay lái xe đạp', 'Keep both hands on the ______ while cycling.'],\n      ['road sign', 'biển báo giao thông', 'That red triangle ______ warns drivers about a sharp bend.'],\n    ],\n    grammar: [\n      ['______ is about two kilometres from my house to the nearest bus stop.', ['There', 'This', 'It', 'That'], 2, 'Cấu trúc chỉ khoảng cách dùng chủ ngữ giả \"It is about...\".'],\n      ['How ______ is it from Ha Noi to Hai Phong? — About 100 km.', ['long', 'far', 'many', 'much'], 1, 'Hỏi khoảng cách dùng \"How far is it...?\".'],\n      ['Cyclists ______ wear a helmet and obey all traffic lights.', ['should', 'shouldn’t', 'mustn’t', 'didn’t'], 0, 'Lời khuyên an toàn nên làm -> \"should\".'],\n      ['You ______ ride side by side on a busy street.', ['should', 'shouldn’t', 'must', 'can'], 1, 'Không nên đi dàn hàng ngang -> \"shouldn’t\".'],\n      ['My grandfather ______ to ride a bicycle to work, but now he takes the bus.', ['use', 'uses', 'used', 'using'], 2, 'Thói quen trong quá khứ không còn nữa: \"used to + V\".'],\n      ['______ it far from your apartment to your school?', ['Is', 'Are', 'Does', 'Do'], 0, 'Câu hỏi khoảng cách dùng \"Is it far...?\".'],\n      ['Drivers ______ use mobile phones while driving a car.', ['should', 'mustn’t', 'can', 'will'], 1, 'Cấm dùng điện thoại khi lái xe -> \"mustn’t\".'],\n      ['______ not cross the road when the pedestrian light is red.', ['Do', 'Don’t', 'Did', 'Should'], 1, 'Mệnh lệnh cảnh báo giao thông -> \"Do not / Don’t\".'],\n      ['How far ______ it from the train station to the central market?', ['is', 'are', 'was', 'does'], 0, 'Cấu trúc cố định \"How far is it...?\".'],\n      ['There ______ to be a narrow wooden bridge here ten years ago.', ['use', 'used', 'uses', 'was used'], 1, '\"There used to be...\" (Trước đây từng có).'],\n      ['Passengers ______ stick their heads out of the bus window.', ['should', 'shouldn’t', 'must', 'will'], 1, 'Không nên thò đầu ra cửa xe -> \"shouldn’t\".'],\n      ['Did your dad ______ to live in a coastal town?', ['used', 'use', 'uses', 'using'], 1, 'Câu hỏi với \"Did\" -> \"use\" trở về nguyên mẫu: \"Did... use to\".'],\n      ['It takes twenty minutes by bike ______ it is five kilometres away.', ['because', 'but', 'although', 'so'], 0, 'Giải thích lý do -> \"because\".'],\n      ['Look carefully both ways ______ crossing the road.', ['before', 'after', 'unless', 'because'], 0, 'Quan sát hai bên trước khi qua đường -> \"before\".'],\n      ['Drivers must stop ______ a red traffic light.', ['in', 'on', 'at', 'between'], 2, 'Dừng tại đèn đỏ -> \"at a red traffic light\".'],\n      ['We ______ leave earlier today to avoid the rush-hour traffic jam.', ['should', 'shouldn’t', 'didn’t', 'aren’t'], 0, 'Khuyên nên đi sớm hơn -> \"should\".'],\n      ['I didn’t ______ to like walking to school, but now I enjoy it.', ['used', 'use', 'uses', 'using'], 1, 'Phủ định \"didn’t + use to\".'],\n      ['It is only 500 metres ______ my school to the library.', ['to', 'from', 'at', 'by'], 1, 'Cấu trúc \"from A to B\".'],\n      ['People ______ follow road signs to keep everyone safe.', ['should', 'shouldn’t', 'mustn’t', 'cannot'], 0, 'Nên tuân thủ biển báo -> \"should\".'],\n      ['It ______ about 30 minutes to get to the airport by taxi.', ['take', 'takes', 'taking', 'is take'], 1, '\"It takes + thời gian + to V\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 8,\n    title: 'Films',\n    grammarFocus: 'although / though & however',\n    vocab: [\n      ['science fiction', 'khoa học viễn tưởng', 'Star Wars is a famous ______ movie set in outer space.'],\n      ['documentary', 'phim tài liệu', 'We learned how whales migrate in a fascinating ocean ______.'],\n      ['animation', 'phim hoạt hình', 'Pixar makes colourful 3D ______ films loved by both kids and adults.'],\n      ['shocking', 'gây sốc, bất ngờ lớn', 'The twist ending of the mystery movie was really ______.'],\n      ['hilarious', 'cực kỳ hài hước', 'The comedy had such ______ jokes that everyone laughed non-stop.'],\n      ['moving', 'cảm động', 'Many viewers cried at the ______ story of the loyal dog.'],\n      ['director', 'đạo diễn', 'The ______ guided the actors carefully during every scene.'],\n      ['critic', 'nhà phê bình', 'That film ______ wrote a glowing 5-star review in the newspaper.'],\n      ['frightening', 'đáng sợ', 'I couldn’t sleep well after watching a ______ ghost story.'],\n      ['must-see', 'bộ phim không thể bỏ lỡ', 'With great music and acting, this family movie is a real ______!'],\n    ],\n    grammar: [\n      ['______ the film was a bit long, we all enjoyed the ending.', ['Although', 'However', 'Because', 'So'], 0, 'Nối hai mệnh đề tương phản không dùng dấu phẩy ngắt hai câu -> \"Although\".'],\n      ['The movie had a huge budget. ______, its plot was quite boring.', ['Although', 'Though', 'However', 'Because'], 2, 'Đứng đầu câu mới sau dấu chấm, có dấu phẩy theo sau -> \"However,\".'],\n      ['He didn’t like scary films, ______ he went to the cinema with his cousins.', ['although', 'yet', 'however', 'because'], 1, 'Nối hai mệnh đề độc lập có nghĩa đối lập dùng \", yet\".'],\n      ['______ she was very busy, Aunt Hoa still took us to watch the animation.', ['However', 'Though', 'So', 'Therefore'], 1, '\"Though\" có nghĩa tương đương \"Although\", đứng đầu mệnh đề phụ.'],\n      ['They spent three months filming the mountain scenes; ______, the weather was awful.', ['although', 'though', 'however', 'because'], 2, 'Sau dấu chấm phẩy và trước dấu phẩy dùng \"however\".'],\n      ['We watched the film to the very end ______ it started quite slowly.', ['although', 'however', 'because', 'so'], 0, '\"although\" đứng trước mệnh đề chỉ sự nhượng bộ.'],\n      ['The acting was brilliant. ______, the sound quality in the hall was poor.', ['Although', 'Though', 'However', 'Despite'], 2, 'Cấu trúc tách câu \". However, ...\".'],\n      ['______ Mai loves musicals, she hasn’t seen that famous Broadway movie yet.', ['However', 'Although', 'Because', 'So'], 1, 'Đầu câu nối trực tiếp hai mệnh đề -> \"Although\".'],\n      ['The trailer looked gripping; ______, the actual film disappointed many fans.', ['although', 'however', 'though', 'so'], 1, 'Giữa \"; ... ,\" dùng \"however\".'],\n      ['He fell asleep during the movie ______ he drank a cup of tea before.', ['even though', 'however', 'so', 'therefore'], 0, '\"even though\" = mặc dù, nối hai mệnh đề tương phản.'],\n      ['______ it rained heavily, fans queued outside the cinema for tickets.', ['However', 'Although', 'Because', 'Therefore'], 1, 'Mệnh đề nhượng bộ -> \"Although\".'],\n      ['I rarely watch horror films. ______, I liked this funny ghost cartoon.', ['Although', 'Though', 'However', 'Because'], 2, 'Chuyển ý giữa hai câu độc lập dùng \"However,\".'],\n      ['Though the main actor is very young, he ______ very naturally.', ['act', 'acts', 'acting', 'to act'], 1, 'Chủ ngữ \"he\" chia hiện tại đơn \"acts\".'],\n      ['The documentary was short; ______, it taught us many amazing facts about Mars.', ['although', 'however', 'because', 'and'], 1, '\"; however,\" diễn tả sự tương phản.'],\n      ['______ being tired, my father watched the football highlights.', ['Although', 'However', 'Despite', 'Though'], 2, 'Trước V-ing (\"being\") dùng giới từ \"Despite\" (mặc dù).'],\n      ['Our seats were near the back, ______ we could still see the screen clearly.', ['although', 'however', 'but', 'because'], 2, 'Nối trực tiếp hai vế sau dấu phẩy dùng \"but\".'],\n      ['______ Nam read the book first, he still loved the film adaptation.', ['However', 'Although', 'So', 'Because'], 1, '\"Although\" ở đầu câu nhượng bộ.'],\n      ['This movie has no famous stars; ______, critics call it a masterpiece.', ['although', 'though', 'however', 'so'], 2, 'Sau dấu chấm phẩy + có dấu phẩy -> \"however\".'],\n      ['The tickets were sold out, ______ we decided to visit the science museum instead.', ['although', 'however', 'so', 'though'], 2, 'Chỉ kết quả -> \"so\".'],\n      ['I found the comedy hilarious, ______ my brother thought it was silly.', ['though', 'however', 'so', 'therefore'], 0, 'Nối vế tương phản dùng \", though\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 9,\n    title: 'Festivals around the World',\n    grammarFocus: 'Yes/No questions (do, did, is, are, can, will)',\n    vocab: [\n      ['parade', 'cuộc diễu hành', 'Colourful floats and marching bands moved down the street in a grand ______.'],\n      ['costume', 'trang phục hóa trang', 'Everyone wore a bright traditional ______ at the carnival.'],\n      ['lantern', 'đèn lồng', 'Hoi An glows softly with hundreds of silk ______ every full moon night.'],\n      ['tulip', 'hoa tuy-líp', 'Spring in the Netherlands is famous for huge fields of red and yellow ______.'],\n      ['feast', 'bữa tiệc thịnh soạn', 'Thanksgiving families gather around a big ______ with roast turkey.'],\n      ['mooncake', 'bánh trung thu', 'We cut sweet ______ and drink tea while admiring the Mid-Autumn moon.'],\n      ['performer', 'người biểu diễn', 'Each street ______ painted their face and danced to drum beats.'],\n      ['symbol', 'biểu tượng', 'The lotus is a national ______ of beauty and purity in Viet Nam.'],\n      ['carve', 'chạm khắc', 'People ______ funny faces on orange pumpkins at Halloween.'],\n      ['celebrate', 'tổ chức ăn mừng', 'Families ______ Lunar New Year with joyful reunions and lucky money.'],\n    ],\n    grammar: [\n      ['______ people in Rio wear colourful costumes during Carnival? — Yes, they do.', ['Do', 'Are', 'Did', 'Were'], 0, 'Trợ động từ hỏi hiện tại đơn số nhiều là \"Do\".'],\n      ['______ your family watch the fireworks in Da Nang last summer? — Yes, we did.', ['Do', 'Does', 'Did', 'Were'], 2, '\"last summer\" -> hỏi quá khứ đơn dùng \"Did\".'],\n      ['______ Thanksgiving celebrated in Viet Nam? — No, it isn’t.', ['Do', 'Does', 'Is', 'Are'], 2, 'Bị động với \"Thanksgiving\" số ít -> \"Is\".'],\n      ['Can tourists join the folk dances at the village festival? — Yes, they ______.', ['do', 'are', 'can', 'will'], 2, 'Trả lời ngắn khớp trợ động từ \"Can\" -> \"can\".'],\n      ['______ there many silk lanterns at Hoi An Festival last month?', ['Is', 'Are', 'Was', 'Were'], 3, '\"last month\" + \"many lanterns\" (số nhiều) -> \"Were\".'],\n      ['Will your class make star lanterns this Mid-Autumn Festival? — Yes, we ______.', ['do', 'will', 'are', 'did'], 1, 'Câu hỏi \"Will...?\" trả lời \"Yes, we will.\"'],\n      ['______ the children enjoying the lion dance right now?', ['Do', 'Did', 'Are', 'Were'], 2, '\"enjoying... right now\" (hiện tại tiếp diễn) -> \"Are\".'],\n      ['______ Mai take part in the rice-cooking contest two days ago?', ['Does', 'Did', 'Is', 'Was'], 1, '\"two days ago\" + động từ \"take part\" -> \"Did\".'],\n      ['Is the Tulip Festival held in spring? — Yes, it ______.', ['do', 'is', 'does', 'has'], 1, 'Trả lời khớp \"Is\" -> \"Yes, it is.\"'],\n      ['______ your grandparents live near Lim Hill where Quan Ho singing takes place?', ['Does', 'Do', 'Are', 'Is'], 1, '\"your grandparents\" số nhiều + \"live\" -> \"Do\".'],\n      ['Did Nick try mooncakes for the first time yesterday? — No, he ______.', ['doesn’t', 'isn’t', 'didn’t', 'wasn’t'], 2, 'Trả lời phủ định của \"Did\" là \"didn’t\".'],\n      ['______ you ever seen a dragon dance in person?', ['Do', 'Did', 'Have', 'Are'], 2, 'Cấu trúc \"Have you ever + V3?\" -> \"Have\".'],\n      ['Should visitors respect local customs during temple festivals? — Yes, they ______.', ['do', 'are', 'should', 'will'], 2, 'Khớp trợ động từ \"Should\" -> \"Yes, they should.\"'],\n      ['______ La Tomatina a food fight festival in Spain? — Yes, it is.', ['Do', 'Is', 'Does', 'Did'], 1, 'Chủ ngữ số ít + danh từ -> dùng \"Is\".'],\n      ['Were you tired after walking in the parade? — No, I ______.', ['didn’t', 'wasn’t', 'weren’t', 'aren’t'], 1, 'Chủ ngữ \"I\" trả lời cho \"Were you...?\" là \"No, I wasn’t.\"'],\n      ['______ your sister going to wear an ao dai to the spring fair?', ['Do', 'Does', 'Is', 'Are'], 2, 'Cấu trúc \"Is + S + going to V?\" -> \"Is\".'],\n      ['Does this music festival happen every October? — Yes, it ______.', ['do', 'does', 'is', 'did'], 1, 'Trả lời cho \"Does...?\" -> \"Yes, it does.\"'],\n      ['______ we bring our cameras to the flower parade?', ['Are', 'Can', 'Were', 'Did'], 1, 'Hỏi xin phép khả năng -> \"Can we bring...\".'],\n      ['Was the Mid-Autumn moon bright last night? — Yes, it ______.', ['did', 'was', 'were', 'is'], 1, 'Câu hỏi \"Was...?\" trả lời \"Yes, it was.\"'],\n      ['______ the locals decorate their streets before Tet?', ['Are', 'Is', 'Do', 'Have'], 2, 'Động từ thường \"decorate\" hiện tại đơn số nhiều -> \"Do\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 10,\n    title: 'Energy Sources',\n    grammarFocus: 'Present continuous for current trends & actions',\n    vocab: [\n      ['solar panel', 'tấm pin mặt trời', 'Workers are installing a blue ______ on the school roof today.'],\n      ['wind turbine', 'tua-bin gió', 'Each tall white ______ turns in the sea breeze to make electricity.'],\n      ['hydro energy', 'năng lượng thủy điện', 'Flowing river water at dams produces clean ______.'],\n      ['nuclear', 'hạt nhân', 'Some countries build ______ power plants, though safety rules are strict.'],\n      ['renewable', 'có thể tái tạo', 'Sun, wind, and water are ______ sources because they never run out.'],\n      ['non-renewable', 'không thể tái tạo', 'Coal, oil, and natural gas are ______ fuels that will eventually finish.'],\n      ['light bulb', 'bóng đèn', 'Swap old lamps for LED ______ to save 80% electricity.'],\n      ['exhaust', 'cạn kiệt / khí thải', 'If we waste fossil fuels, we will ______ them in the near future.'],\n      ['electrical appliance', 'thiết bị điện', 'Remember to unplug every ______ before leaving for vacation.'],\n      ['low energy', 'tiết kiệm năng lượng', 'Buying ______ machines helps lower your monthly electric bill.'],\n    ],\n    grammar: [\n      ['Look! Engineers ______ new wind turbines along the sunny coast.', ['build', 'built', 'are building', 'is building'], 2, 'Có dấu hiệu \"Look!\" + \"Engineers\" số nhiều -> \"are building\".'],\n      ['Nowadays, more families ______ solar panels on their roofs.', ['use', 'are using', 'used', 'was using'], 1, 'Xu hướng đang diễn ra hiện nay (\"Nowadays\") dùng hiện tại tiếp diễn -> \"are using\".'],\n      ['Shh! Dad ______ the electricity meter in the hallway right now.', ['checks', 'is checking', 'checked', 'are checking'], 1, '\"right now\" + \"Dad\" số ít -> \"is checking\".'],\n      ['Students in Grade 7 ______ posters about saving energy this week.', ['design', 'are designing', 'designed', 'is designing'], 1, '\"this week\" chỉ hành động đang triển khai -> \"are designing\".'],\n      ['At present, scientists ______ for greener batteries for electric cars.', ['look', 'looks', 'are looking', 'looked'], 2, '\"At present\" -> hiện tại tiếp diễn \"are looking\".'],\n      ['We ______ wasting water any more; we turn off the tap while brushing.', ['aren’t', 'don’t', 'isn’t', 'didn’t'], 0, 'Cấu trúc tiếp diễn \"aren’t + V-ing\".'],\n      ['What ______ your school doing to save electricity this month?', ['do', 'does', 'is', 'are'], 2, '\"your school\" số ít -> \"is\".'],\n      ['Look at those children! They ______ off the fans before leaving the classroom.', ['turn', 'turns', 'are turning', 'is turning'], 2, '\"Look at...\" -> đang tắt quạt: \"are turning\".'],\n      ['More and more people ______ public buses to reduce petrol use.', ['take', 'are taking', 'took', 'takes'], 1, 'Xu hướng tăng (\"More and more...\") dùng hiện tại tiếp diễn -> \"are taking\".'],\n      ['My uncle ______ an electric motorbike to work these days.', ['rides', 'is riding', 'rode', 'ride'], 1, '\"these days\" -> hiện tại tiếp diễn \"is riding\".'],\n      ['Wait! ______ you using that computer, or can I switch it off?', ['Do', 'Are', 'Is', 'Were'], 1, 'Hỏi hành động đang diễn ra -> \"Are you using\".'],\n      ['The sun ______ brightly, so the solar heater is warming up fast.', ['shines', 'is shining', 'shone', 'shine'], 1, 'Đang chiếu sáng ngay lúc này -> \"is shining\".'],\n      ['I ______ reading an article about hydro power stations.', ['is', 'are', 'am', 'do'], 2, 'Chủ ngữ \"I\" -> \"am\".'],\n      ['Why ______ the air conditioner still running when the window is open?', ['do', 'does', 'is', 'are'], 2, '\"the air conditioner\" số ít + \"running\" -> \"is\".'],\n      ['Cities around the world ______ replacing coal plants with wind farms.', ['is', 'are', 'am', 'do'], 1, '\"Cities\" số nhiều -> \"are\".'],\n      ['Look! The pinwheel ______ fast in the wind.', ['spins', 'is spinning', 'spun', 'spin'], 1, 'Đang quay -> \"is spinning\" (gấp đôi phụ âm n).'],\n      ['They aren’t ______ plastic bags anymore during the eco-week.', ['use', 'uses', 'using', 'used'], 2, '\"aren’t + V-ing\" -> \"using\".'],\n      ['Who ______ repairing the broken street light outside?', ['is', 'are', 'does', 'do'], 0, 'Hỏi \"Who...\" chia số ít -> \"Who is repairing\".'],\n      ['We ______ learning how waves can produce electricity in Science today.', ['is', 'are', 'am', 'did'], 1, '\"We are learning\".'],\n      ['Is the wind blowing strongly at the beach today? — Yes, it ______.', ['does', 'is', 'was', 'will'], 1, 'Trả lời khớp \"Is\" -> \"Yes, it is.\"'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 11,\n    title: 'Travelling in the Future',\n    grammarFocus: 'Future simple & Possessive pronouns',\n    vocab: [\n      ['hyperloop', 'tàu siêu tốc ống chân không', 'A ______ tube train could carry passengers at over 1,000 km/h.'],\n      ['teleporter', 'máy dịch chuyển tức thời', 'In sci-fi movies, a ______ moves you across the world in one second.'],\n      ['bamboo-copter', 'chong chóng tre', 'Kids dream of flying to school with a tiny ______ like Doraemon.'],\n      ['driverless', 'tự hành / không người lái', 'A ______ bus uses cameras and AI sensors instead of a human driver.'],\n      ['skyTran', 'tàu điện trên không', 'A ______ pod glides quietly along an overhead magnetic track.'],\n      ['solowheel', 'xe một bánh tự cân bằng', 'He commutes quickly across the park on an electric ______.'],\n      ['autopilot', 'chế độ lái tự động', 'When the car turns on ______, it steers safely down the lane.'],\n      ['eco-friendly', 'thân thiện môi trường', 'Solar-powered boats are quiet and ______ for river tourism.'],\n      ['fume', 'khói thải độc hại', 'Electric vehicles produce zero exhaust ______ in crowded cities.'],\n      ['run on', 'chạy bằng (nhiên liệu)', 'Future aeroplanes might ______ hydrogen instead of jet fuel.'],\n    ],\n    grammar: [\n      ['In 30 years, flying taxis ______ take commuters above traffic jams.', ['will', 'are', 'did', 'were'], 0, 'Dự đoán tương lai dùng \"will\".'],\n      ['This electric scooter is my brother’s, and the blue solowheel is ______.', ['my', 'mine', 'me', 'I'], 1, 'Đứng một mình thay cho \"my solowheel\" -> \"mine\".'],\n      ['People ______ spend hours stuck in traffic when hyperloops open.', ['will', 'won’t', 'didn’t', 'aren’t'], 1, 'Tương lai phủ định -> \"won’t\".'],\n      ['My flying bike has two wings; ______ has four!', ['your', 'yours', 'you', 'yourself'], 1, 'Làm chủ ngữ thay cho \"your bike\" -> \"yours\".'],\n      ['______ driverless cars become common by 2040?', ['Do', 'Did', 'Will', 'Are'], 2, 'Câu hỏi tương lai đơn dùng \"Will\".'],\n      ['Their eco-bus runs on solar energy, while ______ uses wind power.', ['our', 'ours', 'we', 'us'], 1, 'Đại từ sở hữu thay cho \"our bus\" -> \"ours\".'],\n      ['I think teleporting across oceans ______ be possible in this century.', ['won’t', 'don’t', 'isn’t', 'aren’t'], 0, 'Dự đoán tương lai phủ định dùng \"won’t\".'],\n      ['Look at Mai’s helmet! Is the pink visor ______ too?', ['she', 'her', 'hers', 'herself'], 2, 'Đại từ sở hữu của \"she\" là \"hers\".'],\n      ['How fast ______ future trains travel between Ha Noi and Da Nang?', ['do', 'did', 'will', 'were'], 2, 'Hỏi tốc độ trong tương lai dùng \"will\".'],\n      ['That self-balancing scooter isn’t Nam’s; ______ is parked near the gate.', ['he', 'him', 'his', 'himself'], 2, 'Đại từ sở hữu của \"he\" vẫn là \"his\".'],\n      ['Our class believes solar ships ______ pollute the oceans.', ['will', 'won’t', 'don’t', 'weren’t'], 1, 'Tàu năng lượng mặt trời sẽ không gây ô nhiễm -> \"won’t\".'],\n      ['We brought our tickets, and they brought ______.', ['them', 'their', 'theirs', 'they'], 2, 'Thay cho \"their tickets\" -> \"theirs\".'],\n      ['One day, tourists ______ book weekend trips to space hotels!', ['will', 'did', 'were', 'had'], 0, 'Dự đoán tương lai -> \"will\".'],\n      ['Is that futuristic watch yours or ______?', ['he', 'him', 'his', 'he’s'], 2, 'Đại từ sở hữu của \"he\" -> \"his\".'],\n      ['Wait! ______ we need driving licences for driverless cars?', ['Do', 'Will', 'Did', 'Were'], 1, 'Tương lai dùng \"Will\".'],\n      ['Here is my boarding pass, and where is ______?', ['her', 'hers', 'she', 'she’s'], 1, 'Thay cho \"her boarding pass\" -> \"hers\".'],\n      ['Future cars ______ probably park themselves automatically.', ['will', 'did', 'are', 'were'], 0, '\"probably\" đứng sau \"will\": \"will probably park\".'],\n      ['This charger belongs to you, so it is ______.', ['your', 'you', 'yours', 'yourself'], 2, 'Đại từ sở hữu \"yours\".'],\n      ['Won’t space travel be expensive? — Yes, it ______ at first.', ['won’t', 'will', 'does', 'is'], 1, 'Câu khẳng định dùng \"will\".'],\n      ['Both scooters look cool, but I prefer ______ because it’s lighter.', ['your', 'yours', 'you', 'their'], 1, 'Thay cho \"your scooter\" -> \"yours\".'],\n    ],\n  },\n  {\n    grade: 7,\n    unit: 12,\n    title: 'English-Speaking Countries',\n    grammarFocus: 'Articles (a, an, the) with geographical names',\n    vocab: [\n      ['kangaroo', 'chuột túi', 'The ______ is a famous hopping mammal native to Australia.'],\n      ['kilt', 'váy kẻ sọc Scotland', 'Scottish men traditionally wear a tartan ______ at festivals.'],\n      ['native', 'bản địa / bản ngữ', 'English is the ______ language of people born in New Zealand.'],\n      ['capital', 'thủ đô', 'Canberra, not Sydney, is the ______ city of Australia!'],\n      ['island country', 'đảo quốc', 'New Zealand is a scenic ______ in the Pacific Ocean.'],\n      ['castle', 'lâu đài', 'Edinburgh ______ stands high on a volcanic rock in Scotland.'],\n      ['penguin', 'chim cánh cụt', 'The cute little blue ______ lives along the cool rocky coasts of New Zealand.'],\n      ['accent', 'giọng địa phương', 'Speakers from Ireland and Canada each have their own charming ______.'],\n      ['tattoo', 'hình xăm truyền thống', 'Maori warriors had special cultural patterns known as moko ______.'],\n      ['attraction', 'điểm thu hút du lịch', 'Niagara Falls is a breathtaking natural ______ between Canada and the USA.'],\n    ],\n    grammar: [\n      ['Ottawa is ______ capital city of Canada.', ['a', 'an', 'the', 'Ø'], 2, 'Mỗi quốc gia chỉ có một thủ đô duy nhất -> \"the capital city\".'],\n      ['My penfriend comes from ______ United States of America.', ['a', 'an', 'the', 'Ø'], 2, 'Tên quốc gia có từ \"United/States/Kingdom/Republic\" dùng \"the\".'],\n      ['New Zealand is ______ island country famous for green hills.', ['a', 'an', 'the', 'Ø'], 1, '\"island\" bắt đầu bằng nguyên âm -> dùng \"an\".'],\n      ['______ London is home to Big Ben and the River Thames.', ['A', 'An', 'The', 'Ø'], 3, 'Trước tên thành phố không dùng mạo từ -> \"Ø\".'],\n      ['Did you visit ______ Sydney Opera House when you went to Australia?', ['a', 'an', 'the', 'Ø'], 2, 'Tên công trình nổi tiếng cụ thể dùng \"the\".'],\n      ['She speaks English with ______ Australian accent.', ['a', 'an', 'the', 'Ø'], 1, '\"Australian\" bắt đầu bằng nguyên âm -> \"an\".'],\n      ['We crossed ______ Atlantic Ocean on a big cruise ship.', ['a', 'an', 'the', 'Ø'], 2, 'Tên đại dương dùng mạo từ \"the\".'],\n      ['______ Australia is both a country and a continent.', ['A', 'An', 'The', 'Ø'], 3, 'Tên quốc gia số ít (không có United/Kingdom...) không dùng mạo từ -> \"Ø\".'],\n      ['Look! That’s ______ maple leaf on Canada’s national flag.', ['a', 'an', 'the', 'Ø'], 0, '\"maple\" bắt đầu bằng phụ âm -> \"a\".'],\n      ['Have you ever been to ______ United Kingdom?', ['a', 'an', 'the', 'Ø'], 2, '\"United Kingdom\" phải có \"the\".'],\n      ['My cousin hopes to study at ______ university in Singapore.', ['a', 'an', 'the', 'Ø'], 0, '\"university\" phát âm là /juː.../ (phụ âm) -> dùng \"a\".'],\n      ['Tourists enjoy taking boat rides down ______ River Thames.', ['a', 'an', 'the', 'Ø'], 2, 'Tên các con sông dùng mạo từ \"the\".'],\n      ['______ Kiwi is a tiny flightless bird from New Zealand.', ['A', 'An', 'The', 'Ø'], 2, 'Chỉ một loài vật tiêu biểu (\"The Kiwi\") hoặc \"A kiwi\". Trong văn giới thiệu loài chuẩn Global Success: \"The Kiwi\".'],\n      ['Singapore is ______ clean and green city-state in Southeast Asia.', ['a', 'an', 'the', 'Ø'], 0, 'Danh từ số ít mô tả -> \"a\".'],\n      ['They climbed ______ tallest tower in Toronto during their holiday.', ['a', 'an', 'the', 'Ø'], 2, 'Trước so sánh nhất luôn dùng \"the\".'],\n      ['______ Ireland is nicknamed the Emerald Isle because of its lush grass.', ['A', 'An', 'The', 'Ø'], 3, 'Tên quốc gia đơn lẻ không dùng \"the\" -> \"Ø\".'],\n      ['We saw ______ amazing waterfall on the border with Canada.', ['a', 'an', 'the', 'Ø'], 1, '\"amazing\" bắt đầu bằng nguyên âm -> \"an\".'],\n      ['Many people travel to ______ Philippines to enjoy sunny islands.', ['a', 'an', 'the', 'Ø'], 2, 'Tên quốc gia số nhiều (-s) / quần đảo dùng \"the\".'],\n      ['Canberra isn’t ______ largest city in Australia, Sydney is.', ['a', 'an', 'the', 'Ø'], 2, 'Trước so sánh nhất \"largest\" dùng \"the\".'],\n      ['My uncle stayed in ______ hotel near Hyde Park for three nights.', ['a', 'an', 'the', 'Ø'], 0, '\"hotel\" đọc âm /h/ (phụ âm) -> dùng \"a\".'],\n    ],\n  },\n];\n"},{"path":"src/game/englishData89.ts","encoding":"utf8","content":"import { RawUnitCurriculum } from './englishData67';\n\nexport const CURRICULUM_GRADES_8_9: RawUnitCurriculum[] = [\n  // ==================== GRADE 8 ====================\n  {\n    grade: 8,\n    unit: 1,\n    title: 'Leisure Time',\n    grammarFocus: 'Verbs of liking/disliking + V-ing / to-infinitive',\n    vocab: [\n      ['origami', 'nghệ thuật gấp giấy Nhật Bản', 'My sister enjoys folding paper cranes and frogs in her ______ club.'],\n      ['knitting', 'đan len', 'Grandma teaches Mai ______ so she can make a warm wool scarf.'],\n      ['DIY', 'tự tay làm / sửa chữa đồ', 'Doing ______ projects helps us reuse wooden crates into bookshelves.'],\n      ['puzzle', 'trò chơi xếp hình / giải đố', 'We spent Saturday evening completing a 1,000-piece jigsaw ______.'],\n      ['message', 'nhắn tin', 'Teens often ______ their friends after school to discuss homework.'],\n      ['crazy about', 'rất mê, cuồng', 'Phong is ______ skateboarding; he practises tricks every afternoon.'],\n      ['fond of', 'thích thú, ưa thích', 'My parents are very ______ gardening on the rooftop terrace.'],\n      ['detest', 'căm ghét, rất ghét', 'I ______ waiting in long queues when the weather is boiling hot.'],\n      ['resort', 'khu nghỉ dưỡng', 'Our family stayed at a peaceful seaside ______ during the summer break.'],\n      ['cruising', 'du ngoạn (bằng xe/thuyền)', 'We loved ______ along the canal on small wooden boats.'],\n    ],\n    grammar: [\n      ['Mark is crazy about ______ comics and drawing superhero characters.', ['read', 'reads', 'reading', 'to read'], 2, 'Sau cụm \"be crazy about\" luôn dùng V-ing -> \"reading\".'],\n      ['Do you fancy ______ to the cinema with us this Friday evening?', ['go', 'to go', 'going', 'went'], 2, 'Động từ \"fancy\" chỉ đi với V-ing -> \"going\".'],\n      ['My grandmother detests ______ on noisy highways.', ['drive', 'driving', 'drove', 'to driving'], 1, '\"detest\" (ghét cay đắng) dùng V-ing -> \"driving\".'],\n      ['She likes ______ / ______ badminton after school.', ['playing / to play', 'play / playing', 'played / playing', 'plays / to play'], 0, '\"like\" có thể đi với cả V-ing lẫn to-V -> \"playing / to play\".'],\n      ['Trang prefers ______ paper flowers to playing computer games.', ['make', 'making', 'makes', 'made'], 1, 'Cấu trúc \"prefer V-ing to V-ing\" -> \"making\".'],\n      ['Tom enjoys ______ puzzles with his younger brother on rainy Sundays.', ['do', 'does', 'doing', 'to do'], 2, '\"enjoy\" chỉ dùng V-ing -> \"doing\".'],\n      ['I don’t mind ______ you fold the laundry after dinner.', ['help', 'to help', 'helping', 'helped'], 2, '\"don’t mind + V-ing\" -> \"helping\".'],\n      ['Are you keen on ______ DIY wooden pencil holders?', ['make', 'making', 'made', 'to make'], 1, 'Sau giới từ \"on\" dùng V-ing -> \"making\".'],\n      ['Ann hates ______ up early on chilly winter weekends.', ['getting', 'get', 'gets', 'got'], 0, '\"hate + V-ing / to V\" -> \"getting\".'],\n      ['My cousin is fond of ______ photos of city street art.', ['take', 'taking', 'takes', 'took'], 1, '\"fond of + V-ing\" -> \"taking\".'],\n      ['Would you like ______ origami animals with this coloured paper?', ['make', 'making', 'to make', 'made'], 2, 'Khác với \"like\", cấu trúc \"Would you like...\" đi với \"to V\" -> \"to make\".'],\n      ['They adore ______ cycling through rice fields in the early morning.', ['go', 'going', 'goes', 'went'], 1, '\"adore\" (yêu thích) đi với V-ing -> \"going\".'],\n      ['Minh can’t stand ______ to loud rock music while studying.', ['listen', 'listening', 'listens', 'listened'], 1, '\"can’t stand + V-ing\" -> \"listening\".'],\n      ['What do you enjoy ______ most during your leisure time?', ['do', 'did', 'doing', 'done'], 2, '\"enjoy + V-ing\" -> \"doing\".'],\n      ['We love ______ board games together when Grandma visits.', ['play', 'playing', 'played', 'plays'], 1, '\"love + V-ing\" -> \"playing\".'],\n      ['She dislikes ______ in the queue for concert tickets.', ['stand', 'stands', 'standing', 'stood'], 2, '\"dislike\" chỉ đi với V-ing -> \"standing\".'],\n      ['I prefer ______ at home and baking cookies tonight.', ['stay', 'stayed', 'to stay', 'staying to'], 2, '\"prefer + to V\" -> \"to stay\".'],\n      ['He isn’t interested in ______ long novels; he prefers short stories.', ['read', 'reading', 'reads', 'to read'], 1, 'Sau giới từ \"in\" dùng V-ing -> \"reading\".'],\n      ['Do your brothers love ______ kite-flying competitions?', ['join', 'joining', 'joined', 'joins'], 1, '\"love + V-ing\" -> \"joining\".'],\n      ['Let’s avoid ______ too much time scrolling social media feeds.', ['spend', 'to spend', 'spending', 'spent'], 2, '\"avoid + V-ing\" -> \"spending\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 2,\n    title: 'Life in the Countryside',\n    grammarFocus: 'Comparative forms of adverbs',\n    vocab: [\n      ['harvest', 'thu hoạch / mùa gặt', 'Farmers work from dawn till dusk during the rice ______ season.'],\n      ['combine harvester', 'máy gặt đập liên hợp', 'A ______ cuts and threshes paddy much faster than hand tools.'],\n      ['herd', 'chăn dắt (gia súc)', 'Village boys often help their parents ______ buffaloes in the fields.'],\n      ['paddy field', 'ruộng lúa', 'Golden ______ stretches all the way to the foot of the hills.'],\n      ['orchard', 'vườn cây ăn quả', 'We picked sweet mangoes and rambutans straight from Uncle’s ______.'],\n      ['picturesque', 'đẹp như tranh vẽ', 'The valley with misty mountains and bamboo bridges looks truly ______.'],\n      ['hospitable', 'hiếu khách', 'Country villagers are warm and ______ to travellers from the city.'],\n      ['load', 'chất hàng lên (xe)', 'Men help ______ heavy bags of rice onto the wooden truck.'],\n      ['vast', 'rộng lớn, bao la', 'Cattle graze peacefully across the ______ green grasslands.'],\n      ['well-trained', 'được huấn luyện tốt', 'Sheepdogs are ______ to guide flocks safely back to the barn.'],\n    ],\n    grammar: [\n      ['A combine harvester cuts rice much ______ than farmers using sickles.', ['fast', 'faster', 'more fast', 'fastest'], 1, 'Trạng từ ngắn \"fast\" -> so sánh hơn \"faster\".'],\n      ['People in the countryside live ______ than those in crowded cities.', ['peaceful', 'peacefully', 'more peacefully', 'most peacefully'], 2, 'Trạng từ dài \"peacefully\" -> \"more peacefully\".'],\n      ['Today, Nick got up ______ than he usually does at weekends.', ['early', 'earlier', 'more early', 'earliest'], 1, 'Trạng từ \"early\" -> so sánh hơn \"earlier\".'],\n      ['Mai speaks English ______ than she did last year.', ['fluently', 'more fluently', 'fluent', 'more fluent'], 1, 'Bổ nghĩa cho động từ \"speaks\" dùng trạng từ dài -> \"more fluently\".'],\n      ['Lan dances ______ than most students in her folk club.', ['gracefully', 'more gracefully', 'gracefuller', 'graceful'], 1, 'Trạng từ dài \"gracefully\" -> \"more gracefully\".'],\n      ['My grandfather drives ______ in heavy rain than in sunny weather.', ['careful', 'more carefully', 'carefully', 'carefuller'], 1, 'Bổ nghĩa động từ \"drives\" -> \"more carefully\".'],\n      ['He plays the bamboo flute ______ now than six months ago.', ['good', 'well', 'better', 'best'], 2, 'So sánh hơn bất quy tắc của trạng từ \"well\" là \"better\".'],\n      ['City traffic moves ______ during rush hour than in the countryside.', ['slowly', 'more slowly', 'slowlier', 'most slowly'], 1, 'Trạng từ dài \"slowly\" -> \"more slowly\".'],\n      ['The villagers worked ______ than ever to finish before the storm arrived.', ['hard', 'harder', 'more hard', 'hardly'], 1, 'Trạng từ ngắn \"hard\" -> so sánh hơn \"harder\" (\"hardly\" nghĩa là hầu như không).'],\n      ['Did the team perform ______ in the second round?', ['bad', 'badly', 'worse', 'worst'], 2, 'So sánh hơn bất quy tắc của \"badly\" là \"worse\".'],\n      ['She solved the Maths riddle ______ than I expected.', ['easily', 'more easily', 'easier', 'easy'], 1, 'Bổ nghĩa động từ \"solved\" -> trạng từ \"more easily\".'],\n      ['Can you jump ______ than your cousin?', ['high', 'higher', 'more high', 'highest'], 1, 'Trạng từ ngắn \"high\" -> \"higher\".'],\n      ['Our school bus arrived ten minutes ______ than yesterday.', ['late', 'later', 'more late', 'lately'], 1, 'Trạng từ ngắn \"late\" -> \"later\".'],\n      ['Birds sing ______ at sunrise in the quiet village.', ['sweetly', 'more sweetly', 'sweeter', 'sweet'], 1, 'Khi không có đối tượng so sánh trực tiếp vẫn có thể ngầm so sánh -> \"more sweetly\". (Hoặc check nghĩa: nếu chỉ so với buổi khác -> \"more sweetly\").'],\n      ['This electric tractor runs ______ than the old diesel one.', ['quietly', 'more quietly', 'quieter', 'quiet'], 1, 'Bổ nghĩa cho động từ \"runs\" dùng \"more quietly\".'],\n      ['Minh ran ______ than all the other boys, so he won the race.', ['fast', 'faster', 'fastest', 'more fast'], 1, 'Có \"than\" -> so sánh hơn \"faster\".'],\n      ['Grandma cooks rural dishes ______ than any restaurant chef!', ['deliciously', 'more deliciously', 'more delicious', 'delicious'], 1, 'Bổ nghĩa động từ \"cooks\" -> \"more deliciously\".'],\n      ['They travelled ______ down the foggy mountain road than on the dry highway.', ['slow', 'slowly', 'more slowly', 'slower'], 2, 'Có \"than\" và bổ nghĩa cho động từ \"travelled\" dùng trạng từ so sánh hơn \"more slowly\".'],\n      ['The river flows ______ in summer than in dry winter.', ['strongly', 'more strongly', 'stronger', 'strong'], 1, 'Có \"than\" + bổ nghĩa \"flows\" -> \"more strongly\".'],\n      ['Farmers can sell fresh fruit ______ online than at a small stall.', ['effectively', 'more effectively', 'effective', 'more effective'], 1, 'Có \"than\" + động từ \"sell\" -> \"more effectively\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 3,\n    title: 'Teenagers',\n    grammarFocus: 'Simple, compound & complex sentences',\n    vocab: [\n      ['pressure', 'áp lực', 'Many teenagers feel exam ______ before the final term tests.'],\n      ['forum', 'diễn đàn (trực tuyến)', 'Students share study tips and ask questions on the school ______.'],\n      ['browse', 'lướt xem (mạng/trang web)', 'It’s fun to ______ educational websites for science experiments.'],\n      ['notification', 'thông báo', 'Turn off phone ______ while doing homework so you stay focused.'],\n      ['bully', 'bắt nạt / kẻ bắt nạt', 'Nobody should ______ classmates online or at school.'],\n      ['expectation', 'sự kỳ vọng', 'Parents’ high ______ can sometimes motivate or stress students.'],\n      ['concentrate', 'tập trung', 'Soft instrumental music helps me ______ better on Maths problems.'],\n      ['club leader', 'nhóm trưởng câu lạc bộ', 'Nam became the ______ of the photography club this semester.'],\n      ['stressful', 'gây căng thẳng', 'Having three tests in one week feels really ______.'],\n      ['connect', 'kết nối', 'Joining sports clubs helps teens ______ with friends who share interests.'],\n    ],\n    grammar: [\n      ['I joined the chess club, ______ my best friend prefers the music club.', ['so', 'but', 'therefore', 'for'], 1, 'Câu ghép hai mệnh đề tương phản dùng \", but\".'],\n      ['Nam studied very hard; ______, he got top marks in the English exam.', ['however', 'therefore', 'otherwise', 'but'], 1, 'Từ nối chỉ kết quả đứng giữa \"; ... ,\" là \"therefore\".'],\n      ['Turn off the notifications, ______ you will keep getting distracted.', ['otherwise', 'so', 'and', 'for'], 0, '\"otherwise\" = nếu không thì (cảnh báo hệ quả xấu).'],\n      ['She stayed up late revising for Biology, ______ she feels sleepy now.', ['but', 'so', 'yet', 'or'], 1, 'Chỉ kết quả -> \", so\".'],\n      ['______ she had a busy schedule, Mi still helped her parents cook dinner.', ['Although', 'Therefore', 'However', 'Because'], 0, 'Câu phức nhượng bộ mở đầu bằng \"Although\".'],\n      ['Teenagers need regular exercise, ______ it keeps both body and mind healthy.', ['so', 'for', 'but', 'otherwise'], 1, '\"for\" (bởi vì) dùng làm liên từ kết hợp (FANBOYS) trong câu ghép.'],\n      ['He wanted to buy a new basketball; ______, he didn’t have enough savings.', ['therefore', 'however', 'so', 'moreover'], 1, 'Giữa \"; ... ,\" mang nghĩa đối lập -> \"however\".'],\n      ['You can join the judo club, ______ you can sign up for arts and crafts.', ['so', 'but', 'or', 'yet'], 2, 'Hai lựa chọn tương đương trong câu ghép dùng \", or\".'],\n      ['Because Phong practised speaking daily, his pronunciation improved ______.', ['quick', 'quickly', 'quicker', 'quickness'], 1, 'Bổ nghĩa động từ \"improved\" dùng trạng từ \"quickly\".'],\n      ['The school wifi was down; ______, we played outdoor games instead.', ['however', 'therefore', 'otherwise', 'although'], 1, 'Chỉ kết quả tất yếu sau \"; ... ,\" -> \"therefore\".'],\n      ['I like uploading my paintings to the art blog, ______ my sister never shares hers.', ['and', 'so', 'but', 'for'], 2, 'Tương phản -> \", but\".'],\n      ['Check your essay carefully ______ you hand it in to the teacher.', ['before', 'although', 'therefore', 'however'], 0, 'Mệnh đề trạng ngữ chỉ thời gian -> \"before\".'],\n      ['She felt stressed; ______, she talked to the school counsellor for advice.', ['therefore', 'however', 'otherwise', 'but'], 0, 'Hành động giải pháp tiếp theo -> \"therefore\".'],\n      ['We can finish the group poster today ______ everyone works together.', ['if', 'but', 'so', 'therefore'], 0, 'Mệnh đề điều kiện -> \"if\".'],\n      ['He is a friendly boy, ______ he makes new friends easily at summer camp.', ['so', 'but', 'yet', 'otherwise'], 0, 'Nguyên nhân - kết quả -> \", so\".'],\n      ['Mai tried her best in the badminton match, ______ she lost in the final set.', ['so', 'yet', 'therefore', 'for'], 1, '\"yet\" = nhưng mà (liên từ ghép mang nghĩa tương phản).'],\n      ['______ I finished my assignments early, I went for a bike ride.', ['Although', 'Since', 'However', 'Otherwise'], 1, '\"Since\" = Bởi vì (mở đầu mệnh đề nguyên nhân trong câu phức).'],\n      ['You must wear safety gear when skateboarding, ______ you might hurt yourself.', ['and', 'so', 'otherwise', 'therefore'], 2, '\"otherwise\" = nếu không thì.'],\n      ['My brother enjoys team sports, ______ he joined the school football team.', ['so', 'but', 'however', 'or'], 0, 'Chỉ kết quả dùng \", so\".'],\n      ['Wait until the teacher ______ explaining the project rules.', ['finish', 'finishes', 'finished', 'will finish'], 1, 'Mệnh đề thời gian với \"until\" chia hiện tại đơn -> \"finishes\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 4,\n    title: 'Ethnic Groups of Viet Nam',\n    grammarFocus: 'Questions (Yes/No, Wh-) & Countable/uncountable nouns',\n    vocab: [\n      ['stilt house', 'nhà sàn', 'Many Tay and Thai families live in wooden ______ raised on tall posts.'],\n      ['terraced field', 'ruộng bậc thang', 'Spectacular ______ steps look like golden staircases on northern mountains.'],\n      ['communal house', 'nhà rông / nhà sinh hoạt cộng đồng', 'The tall thatched Rong house is the ______ of Ba Na villages.'],\n      ['gong', 'cồng chiêng', 'The sound of the bronze ______ echoes through the Central Highlands festivals.'],\n      ['bamboo flute', 'sáo trúc', 'She played a gentle folk melody on a traditional ______.'],\n      ['weave', 'dệt (vải)', 'Ethnic women skilfully ______ colourful brocade patterns by hand.'],\n      ['ethnic minority', 'dân tộc thiểu số', 'Viet Nam is home to 54 cultural groups, including 53 ______.'],\n      ['costume', 'trang phục truyền thống', 'Each highland community has its own embroidered traditional ______.'],\n      ['livestock', 'gia súc, vật nuôi', 'Farmers keep pigs, buffaloes, and other ______ beneath or near their homes.'],\n      ['open fire', 'bếp lửa mở', 'Guests sit warmly around an ______ inside the wooden house.'],\n    ],\n    grammar: [\n      ['How ______ ethnic groups live in Viet Nam? — 54 groups!', ['much', 'many', 'long', 'far'], 1, '\"ethnic groups\" đếm được số nhiều -> \"How many\".'],\n      ['How ______ information did you find about the Ede people?', ['many', 'much', 'few', 'a few'], 1, '\"information\" là danh từ KHÔNG đếm được -> dùng \"How much\".'],\n      ['There is ______ sticky rice left in the bamboo steamer.', ['a few', 'many', 'a little', 'several'], 2, '\"sticky rice\" không đếm được -> \"a little\".'],\n      ['______ is the Rong house located? — In the centre of the village.', ['Who', 'Where', 'When', 'Why'], 1, 'Hỏi địa điểm dùng \"Where\".'],\n      ['We saw ______ wooden statues outside the communal house.', ['a little', 'much', 'a few', 'an'], 2, '\"statues\" đếm được số nhiều -> \"a few\".'],\n      ['______ builds the stilt houses in the village? — The local men and neighbours.', ['What', 'Who', 'Where', 'How'], 1, 'Hỏi về người thực hiện -> \"Who\".'],\n      ['Can I have ______ knowledge about Muong folk songs? — Yes, read this booklet.', ['a', 'many', 'some', 'few'], 2, '\"knowledge\" không đếm được -> dùng \"some\".'],\n      ['______ often do the villagers hold the gong festival? — Once a year.', ['What', 'How', 'When', 'Which'], 1, '\"How often\" hỏi mức độ thường xuyên.'],\n      ['There isn’t ______ furniture inside a traditional stilt house.', ['many', 'much', 'a few', 'several'], 1, '\"furniture\" không đếm được (trong câu phủ định) -> \"much\".'],\n      ['______ are terraced fields built on steep hillsides? — To keep rainwater for rice.', ['Why', 'Who', 'Where', 'How many'], 0, 'Trả lời mục đích \"To...\" -> câu hỏi bắt đầu bằng \"Why\".'],\n      ['She bought ______ colourful scarves at the highland market.', ['much', 'a little', 'several', 'an'], 2, '\"scarves\" đếm được số nhiều -> \"several\".'],\n      ['______ traditional dish do you recommend trying in Sa Pa?', ['Who', 'Which', 'Where', 'When'], 1, 'Lựa chọn món ăn dùng \"Which\".'],\n      ['They don’t keep ______ buffaloes under the house anymore.', ['much', 'many', 'a little', 'little'], 1, '\"buffaloes\" đếm được số nhiều -> \"many\".'],\n      ['How ______ does a handwoven brocade bag cost?', ['many', 'much', 'far', 'tall'], 1, 'Hỏi giá tiền dùng \"How much\".'],\n      ['Did the Kinh and Dao students dance together at the camp? — Yes, they ______.', ['do', 'did', 'were', 'had'], 1, 'Trả lời câu hỏi quá khứ \"Did...?\" -> \"Yes, they did.\"'],\n      ['There is very ______ traffic in the quiet mountain valley.', ['many', 'few', 'little', 'a few'], 2, '\"traffic\" không đếm được -> \"little\".'],\n      ['______ is the roof of the Rong house shaped like a giant axe?', ['Why', 'Who', 'Whose', 'How many'], 0, 'Hỏi lý do -> \"Why\".'],\n      ['Each village usually has ______ elder who knows all the folk tales.', ['a', 'an', 'some', 'many'], 1, '\"elder\" số ít bắt đầu bằng nguyên âm -> \"an\".'],\n      ['How ______ water does a paddy field need in spring?', ['many', 'much', 'few', 'often'], 1, '\"water\" không đếm được -> \"How much\".'],\n      ['Were there ______ visitors at the Museum of Ethnology yesterday?', ['a little', 'much', 'any', 'an'], 2, 'Câu hỏi với danh từ đếm được số nhiều -> \"any\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 5,\n    title: 'Our Customs and Traditions',\n    grammarFocus: 'Zero article (Ø) & Articles (a, an, the)',\n    vocab: [\n      ['worship', 'thờ cúng', 'Vietnamese families build an altar to ______ their ancestors.'],\n      ['bamboo pole', 'cây nêu', 'On the 23rd of the last lunar month, some families put up a tall ______.'],\n      ['offering', 'lễ vật cúng', 'Five-fruit trays and incense are placed as an ______ on the altar.'],\n      ['reunion', 'đoàn tụ', 'New Year’s Eve dinner is a cherished family ______ for everyone.'],\n      ['lantern release', 'thả đèn hoa đăng', 'Thousands joined the peaceful ______ ceremony along the river bank.'],\n      ['respect', 'tôn trọng, kính trọng', 'Students greet teachers politely to show ______.'],\n      ['ornament', 'đồ trang trí', 'We hung shiny bells and ribbons as tree ______ before the party.'],\n      ['longevity', 'sự trường thọ', 'Children wish their grandparents health and ______ at Tet.'],\n      ['martial arts', 'võ thuật', 'Traditional Vietnamese ______ is often performed at spring village festivals.'],\n      ['custom', 'phong tục', 'Taking off your shoes before entering a house is a polite ______ in Japan.'],\n    ],\n    grammar: [\n      ['In Viet Nam, people often go to ______ pagoda on the first day of Tet.', ['a', 'an', 'the', 'Ø'], 0, '\"go to a pagoda\" (nói chung một ngôi chùa) hoặc theo chuẩn SGK Unit 5: \"go to a pagoda / visit the pagoda\".'],\n      ['We usually eat ______ dinner together at 7 p.m. every evening.', ['a', 'an', 'the', 'Ø'], 3, 'Trước tên các bữa ăn hàng ngày (breakfast, lunch, dinner) không dùng mạo từ -> \"Ø\".'],\n      ['My aunt gave me ______ useful guidebook about Asian traditions.', ['a', 'an', 'the', 'Ø'], 0, '\"useful\" phát âm bắt đầu bằng âm /j/ -> dùng \"a\".'],\n      ['______ Tet is the most important traditional holiday in Viet Nam.', ['A', 'An', 'The', 'Ø'], 3, 'Trước tên ngày lễ lớn không có từ \"day/festival\" (Tet, Christmas, Easter) dùng Ø (không mạo từ).'],\n      ['Wait! Pass me ______ five-fruit tray on the kitchen counter, please.', ['a', 'an', 'the', 'Ø'], 2, 'Vật đã được xác định rõ vị trí (\"on the kitchen counter\") -> \"the\".'],\n      ['Many children go to ______ school by bicycle in my town.', ['a', 'an', 'the', 'Ø'], 3, 'Đi học với mục đích học tập nói chung dùng \"go to school\" (Ø).'],\n      ['It’s ______ honour to be invited to the village’s longevity celebration.', ['a', 'an', 'the', 'Ø'], 1, '\"honour\" bắt đầu bằng âm \"h\" câm (/ˈɒnər/) -> dùng \"an\".'],\n      ['Look at ______ red envelopes Grandma prepared for the grandchildren!', ['a', 'an', 'the', 'Ø'], 2, 'Đã xác định cụ thể (\"Grandma prepared\") -> \"the\".'],\n      ['People in Britain celebrate ______ Christmas with decorated pine trees.', ['a', 'an', 'the', 'Ø'], 3, 'Trước tên ngày lễ (\"Christmas\") không dùng mạo từ -> \"Ø\".'],\n      ['She plays ______ piano beautifully at every family gathering.', ['a', 'an', 'the', 'Ø'], 2, 'Trước tên nhạc cụ khi chơi nhạc dùng \"the\" (\"play the piano\").'],\n      ['What is ______ traditional greeting in your country?', ['a', 'an', 'the', 'Ø'], 0, 'Giới thiệu khái niệm số ít -> \"a\".'],\n      ['He prefers travelling by ______ train during the holiday.', ['a', 'an', 'the', 'Ø'], 3, '\"by + phương tiện giao thông\" không dùng mạo từ -> \"Ø\".'],\n      ['______ Vietnamese are proud of their long history and hospitality.', ['A', 'An', 'The', 'Ø'], 2, '\"The + quốc tịch\" chỉ toàn thể người dân của nước đó -> \"The Vietnamese\".'],\n      ['Let’s watch ______ dragon dance in front of the town hall!', ['a', 'an', 'the', 'Ø'], 2, 'Đã xác định ở trước tòa thị chính -> \"the\".'],\n      ['My brother plays ______ football after school to stay healthy.', ['a', 'an', 'the', 'Ø'], 3, 'Trước tên môn thể thao không dùng mạo từ -> \"Ø\".'],\n      ['Do you have ______ umbrella? It looks like rain outside the temple.', ['a', 'an', 'the', 'Ø'], 1, '\"umbrella\" bắt đầu bằng nguyên âm -> \"an\".'],\n      ['On Sundays, my family likes having ______ big breakfast with pho.', ['a', 'an', 'the', 'Ø'], 0, 'Khi có tính từ mô tả đứng trước bữa ăn (\"big breakfast\") dùng \"a\".'],\n      ['Look! ______ sun is rising behind the ancient communal roof.', ['A', 'An', 'The', 'Ø'], 2, 'Vật duy nhất -> \"The\".'],\n      ['In ______ afternoon, we will learn how to wrap banh chung.', ['a', 'an', 'the', 'Ø'], 2, 'Cụm cố định \"in the afternoon\".'],\n      ['Young people should learn about ______ culture and traditions of their hometown.', ['a', 'an', 'the', 'Ø'], 2, 'Xác định cụ thể (\"culture... of their hometown\") -> \"the\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 6,\n    title: 'Lifestyles',\n    grammarFocus: 'Future simple & First conditional (if / unless)',\n    vocab: [\n      ['dogsled', 'xe trượt tuyết chó kéo', 'In snowy Alaska, people still sometimes travel across ice on a ______.'],\n      ['igloo', 'lều tuyết', 'Traditionally, Inuit hunters built a warm dome-shaped ______ out of snow blocks.'],\n      ['nomadic', 'du mục', 'People with a ______ lifestyle move tents from place to place with their herds.'],\n      ['online learning', 'học trực tuyến', 'Video calls and digital whiteboards make ______ interactive and flexible.'],\n      ['street food', 'đồ ăn đường phố', 'Busy city workers often grab quick lunches from local ______ stalls.'],\n      ['greet', 'chào hỏi', 'In Thailand, people ______ each other with a polite \"wai\" bow.'],\n      ['maintain', 'duy trì', 'Local artisans try hard to ______ traditional pottery skills.'],\n      ['revive', 'hồi sinh, khôi phục', 'Young chefs are working to ______ forgotten countryside recipes.'],\n      ['experience', 'trải nghiệm', 'Tourists love to ______ making rice paper in small Mekong villages.'],\n      ['interaction', 'sự tương tác', 'Face-to-face ______ with teachers helps students feel supported.'],\n    ],\n    grammar: [\n      ['If you visit Hokkaido in winter, you ______ see amazing ice sculptures.', ['will', 'would', 'did', 'are'], 0, 'Câu điều kiện loại 1: If + hiện tại đơn, S + will + V.'],\n      ['______ we protect traditional crafts, they will disappear in a few decades.', ['If', 'Unless', 'Because', 'When'], 1, '\"Unless\" = If... not (Nếu chúng ta không bảo vệ...).'],\n      ['If Mai ______ free time tonight, she will try the online cooking course.', ['has', 'have', 'had', 'will have'], 0, 'Mệnh đề If ĐK loại 1 chia hiện tại đơn -> \"has\".'],\n      ['What ______ happen if students only study online and never meet friends?', ['did', 'will', 'was', 'does'], 1, 'Câu hỏi mệnh đề chính ĐK loại 1 dùng \"will\".'],\n      ['Unless he ______ earlier, he will miss the morning ferry to the island.', ['leaves', 'leave', 'left', 'will leave'], 0, 'Sau \"Unless\" chia thì hiện tại đơn khẳng định -> \"leaves\".'],\n      ['In the next ten years, more companies ______ offer flexible work from home.', ['will', 'did', 'were', 'had'], 0, 'Dự đoán tương lai với \"In the next ten years\" -> \"will\".'],\n      ['If it doesn’t snow tomorrow, we ______ go dogsledding in the valley.', ['will', 'won’t', 'didn’t', 'don’t'], 1, 'Nếu không có tuyết -> sẽ không thể trượt tuyết: \"won’t\".'],\n      ['You won’t know how delicious pho is ______ you taste a fresh bowl in Ha Noi!', ['if', 'unless', 'because', 'when'], 1, 'Trừ phi / nếu bạn không thử -> \"unless\".'],\n      ['If they ______ local farmers, organic farming will grow faster.', ['support', 'supports', 'supported', 'will support'], 0, '\"they\" ở mệnh đề If chia hiện tại đơn -> \"support\".'],\n      ['I hope robotic chefs ______ replace traditional family cooking!', ['will', 'won’t', 'didn’t', 'aren’t'], 1, 'Hy vọng sẽ không thay thế -> \"won’t\".'],\n      ['If you greet local elders warmly, they ______ smile back at you.', ['will', 'did', 'were', 'had'], 0, 'ĐK loại 1 -> \"will\".'],\n      ['Unless we ______ down on fast food, our health will suffer.', ['cut', 'cuts', 'will cut', 'cutting'], 0, '\"Unless we + V hiện tại đơn\" -> \"cut\".'],\n      ['Will your brother study abroad next year? — Yes, he ______.', ['does', 'will', 'is', 'did'], 1, 'Trả lời ngắn cho \"Will...?\" -> \"Yes, he will.\"'],\n      ['If my cousin comes to Viet Nam, I ______ take her to a night market.', ['will', 'was', 'did', 'am'], 0, 'Mệnh đề chính ĐK loại 1 -> \"will\".'],\n      ['Unless the storm ______, the boat festival will be postponed.', ['stop', 'stops', 'stopped', 'will stop'], 1, '\"the storm\" số ít sau \"Unless\" -> \"stops\".'],\n      ['People in cold regions ______ still wear thick fur coats in the future.', ['will', 'did', 'were', 'have'], 0, 'Tương lai đơn -> \"will\".'],\n      ['If you learn a few local phrases, travelling ______ become much easier.', ['will', 'was', 'did', 'were'], 0, 'ĐK loại 1 -> \"will\".'],\n      ['She won’t pass the culinary test unless she ______ regularly.', ['practise', 'practises', 'practised', 'will practise'], 1, 'Sau \"unless\" với \"she\" -> \"practises\".'],\n      ['When ______ the next online workshop on sustainable living start?', ['did', 'will', 'was', 'has'], 1, 'Hỏi kế hoạch tương lai -> \"will\".'],\n      ['If we ______ solar lamps, camping at night will be super bright.', ['bring', 'brings', 'brought', 'will bring'], 0, '\"we\" ở mệnh đề If -> \"bring\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 7,\n    title: 'Environmental Protection',\n    grammarFocus: 'Complex sentences with adverb clauses of time',\n    vocab: [\n      ['ecosystem', 'hệ sinh thái', 'Coral reefs form a colourful underwater ______ for thousands of sea species.'],\n      ['endangered', 'có nguy cơ tuyệt chủng', 'Giant pandas and saolas are ______ animals that need strict protection.'],\n      ['habitat', 'môi trường sống', 'Deforestation destroys the natural ______ of forest birds and monkeys.'],\n      ['carbon footprint', 'dấu chân các-bon', 'Cycling instead of driving lowers your daily ______.'],\n      ['single-use', 'dùng một lần', 'Say no to ______ plastic straws and bring a metal or bamboo straw!'],\n      ['extinct', 'tuyệt chủng', 'If we don’t stop illegal hunting, some rare tigers may become ______.'],\n      ['rubbish', 'rác thải', 'Volunteers picked up over 50 bags of ______ along the shoreline.'],\n      ['pollutant', 'chất gây ô nhiễm', 'Chemical smoke from factories is a dangerous air ______.'],\n      ['natural park', 'vườn quốc gia / công viên tự nhiên', 'Cuc Phuong is a famous ______ where rare butterflies live safely.'],\n      ['conserve', 'bảo tồn', 'Turning off taps promptly helps ______ clean freshwater.',],\n    ],\n    grammar: [\n      ['______ I arrive at the beach, I always pick up any plastic bottles I see.', ['When', 'Until', 'While', 'Before'], 0, 'Mệnh đề thời gian chỉ lúc đến nơi -> \"When\".'],\n      ['We shouldn’t leave the campsite ______ we have put out the fire completely.', ['after', 'until', 'while', 'when'], 1, 'Không rời đi cho đến khi làm xong -> \"until\".'],\n      ['Turn off the tap ______ you are brushing your teeth to save water.', ['while', 'until', 'after', 'before'], 0, 'Hành động đang xảy ra song song -> \"while\".'],\n      ['______ they finished planting 100 trees, the students took a group photo.', ['Before', 'After', 'Until', 'While'], 1, 'Chụp ảnh sau khi trồng xong -> \"After\".'],\n      ['Remember to unplug your charger ______ you go to sleep.', ['before', 'after', 'while', 'since'], 0, 'Rút sạc trước khi đi ngủ -> \"before\".'],\n      ['As soon as the clean-up bell ______, everyone rushed out with gloves.', ['ring', 'rings', 'rang', 'will ring'], 2, 'Hành động đã xảy ra trong quá khứ đồng bộ với \"rushed\" -> \"rang\".'],\n      ['Fish will return to the river ______ factories stop dumping chemical waste.', ['before', 'until', 'as soon as', 'while'], 2, 'Ngay khi nhà máy ngừng xả thải -> \"as soon as\".'],\n      ['Don’t throw food scraps into the ocean ______ you are on a boat tour.', ['when', 'until', 'after', 'since'], 0, 'Chỉ thời điểm đang đi thuyền -> \"when\".'],\n      ['______ I was walking through the pine forest, I spotted a tiny squirrel.', ['Before', 'After', 'While', 'Until'], 2, 'Kết hợp thì quá khứ tiếp diễn dùng \"While\".'],\n      ['Wait here ______ the park ranger comes to open the eco-trail.', ['until', 'while', 'after', 'as soon as'], 0, 'Đợi cho tới khi kiểm lâm tới -> \"until\".'],\n      ['I will text you as soon as our Eco Club ______ the poster.', ['finish', 'finishes', 'finished', 'will finish'], 1, 'Trong mệnh đề trạng ngữ thời gian tương lai dùng hiện tại đơn (không dùng will) -> \"finishes\".'],\n      ['______ we started using cloth bags, our family cut plastic trash in half.', ['Since', 'Until', 'While', 'Before'], 0, '\"Since\" + quá khứ đơn, mệnh đề chính chia hiện tại hoàn thành/kết quả đến nay (hoặc past).'],\n      ['Wash glass jars cleanly ______ you put them in the recycling bin.', ['before', 'while', 'until', 'since'], 0, 'Rửa sạch trước khi cho vào thùng -> \"before\".'],\n      ['When she ______ a plastic bottle on the ground, she drops it into the bin.', ['see', 'sees', 'saw', 'will see'], 1, 'Thói quen hiện tại đơn với \"she\" -> \"sees\".'],\n      ['They checked the air quality index ______ planning the outdoor marathon.', ['before', 'until', 'while', 'since'], 0, 'Kiểm tra trước khi lên kế hoạch -> \"before\".'],\n      ['______ the volunteers cleaned the canal, the water looked much clearer.', ['After', 'Until', 'Before', 'While'], 0, 'Sau khi dọn dẹp xong -> \"After\".'],\n      ['Stay on the marked wooden path ______ hiking in the national reserve.', ['while', 'until', 'after', 'before'], 0, 'Đi trên lối mòn trong lúc leo núi -> \"while\".'],\n      ['We can’t release the sea turtles ______ the tide comes in safely.', ['after', 'until', 'while', 'when'], 1, 'Không thể thả cho tới khi thủy triều lên -> \"until\".'],\n      ['As soon as I get home, I ______ sort the cardboard boxes.', ['sort', 'sorted', 'will sort', 'am sort'], 2, 'Mệnh đề chính diễn tả hành động tương lai dùng \"will sort\".'],\n      ['Check the list ______ you leave the supermarket so you don’t forget your tote bag.', ['before', 'after', 'until', 'since'], 0, 'Kiểm tra trước khi rời đi -> \"before\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 8,\n    title: 'Shopping',\n    grammarFocus: 'Adverbs of frequency & Present simple for future events',\n    vocab: [\n      ['bargain', 'mặc cả / món hời', 'At traditional markets, buyers sometimes ______ for a lower price.'],\n      ['price tag', 'nhãn giá', 'Every shirt in this supermarket has a fixed ______ attached to it.'],\n      ['convenience store', 'cửa hàng tiện lợi', 'A ______ stays open late so you can buy milk or snacks anytime.'],\n      ['discount', 'giảm giá', 'The bookshop is offering a 20% ______ for students this weekend!'],\n      ['customer', 'khách hàng', 'Polite shop assistants always smile and help every ______.'],\n      ['open-air market', 'chợ ngoài trời', 'Fresh vegetables and flowers are sold every morning at the ______.'],\n      ['shopaholic', 'người nghiện mua sắm', 'My aunt is a bit of a ______ — she buys shoes every single week!'],\n      ['browse', 'xem lướt hàng hóa', 'We love to ______ the comic shelves at the weekend book fair.'],\n      ['complaint', 'lời phàn nàn', 'If a toy is broken, you can make a polite ______ to customer service.'],\n      ['access', 'truy cập / tiếp cận', 'Online shops give rural families easy ______ to books and tools.'],\n    ],\n    grammar: [\n      ['Look at the sign! The new shopping centre ______ at 9:00 a.m. tomorrow.', ['open', 'opens', 'will opening', 'opened'], 1, 'Thời gian biểu/lịch cố định trong tương lai chia hiện tại đơn -> \"opens\".'],\n      ['My mother ______ buys things online without reading reviews first.', ['never', 'is never', 'never is', 'does never'], 0, 'Trạng từ tần suất \"never\" đứng trước động từ thường \"buys\".'],\n      ['What time ______ the holiday sale end next Sunday?', ['will', 'does', 'is', 'did'], 1, 'Lịch trình sự kiện cố định dùng hiện tại đơn -> \"does ... end\".'],\n      ['She ______ late for the weekend farmers’ market.', ['rarely is', 'is rarely', 'does rarely', 'rarely does'], 1, 'Trạng từ tần suất đứng sau động từ \"to be\" -> \"is rarely\".'],\n      ['According to the timetable, the last bus from the mall ______ at 10:15 p.m.', ['leave', 'leaves', 'left', 'is leaving to'], 1, 'Lịch chạy xe cố định chia hiện tại đơn -> \"leaves\".'],\n      ['How often ______ your family shop at the open-air market?', ['do', 'does', 'is', 'are'], 1, '\"your family\" chia số ít hoặc số nhiều? Trong SGK VN \"does your family\" phổ biến nhất -> dùng \"does\".'],\n      ['The summer book fair ______ on June 1st and lasts for five days.', ['start', 'starts', 'started', 'starting'], 1, 'Lịch sự kiện tương lai cố định dùng hiện tại đơn -> \"starts\".'],\n      ['We ______ bring our reusable tote bags whenever we go shopping.', ['always', 'are always', 'always are', 'do always'], 0, '\"always\" đứng trước động từ thường \"bring\".'],\n      ['The electronics shop ______ close until 9:30 p.m. tonight.', ['don’t', 'doesn’t', 'isn’t', 'won’t be'], 1, 'Lịch đóng cửa hàng ngày dùng hiện tại đơn phủ định -> \"doesn’t\".'],\n      ['My cousin ______ compares prices at two stores before buying shoes.', ['usually', 'is usually', 'usually is', 'was usually'], 0, 'Trước động từ thường \"compares\" dùng \"usually\".'],\n      ['When ______ the morning train to the outlet village depart tomorrow?', ['do', 'does', 'is', 'did'], 1, 'Lịch trình tàu chạy dùng hiện tại đơn -> \"does\".'],\n      ['Are those handmade candles ______ on sale at the fair?', ['often', 'often are', 'are often', 'always are'], 0, 'Sau chủ ngữ trong câu hỏi có \"Are\": \"Are... often on sale?\".'],\n      ['The winter fashion exhibition ______ at 5:00 p.m. this Friday.', ['finish', 'finishes', 'finishing', 'finished'], 1, 'Lịch kết thúc triển lãm cố định -> \"finishes\".'],\n      ['I ______ buy plastic water bottles; I carry my stainless-steel flask.', ['seldom', 'am seldom', 'seldom am', 'do seldom'], 0, 'Trước động từ thường \"buy\" -> \"seldom\".'],\n      ['Excuse me, what time ______ the supermarket open on Saturdays?', ['do', 'does', 'is', 'are'], 1, '\"the supermarket\" số ít -> \"does\".'],\n      ['Our neighbourhood flea market ______ takes place on the first Sunday of each month.', ['usually', 'is usually', 'does usually', 'usually is'], 0, 'Trước cụm động từ \"takes place\" -> \"usually\".'],\n      ['Look at the poster: the pottery workshop ______ at 2:30 p.m. tomorrow afternoon.', ['begin', 'begins', 'began', 'beginning'], 1, 'Lịch sự kiện tương lai -> \"begins\".'],\n      ['Customers ______ happy when they find a big discount on winter coats.', ['often are', 'are often', 'often do', 'do often'], 1, 'Sau \"to be\" (are) -> \"are often\".'],\n      ['The charity auction ______ at 8 p.m. tonight in the school hall.', ['starts', 'start', 'is start', 'started'], 0, 'Giờ bắt đầu cố định tối nay -> \"starts\".'],\n      ['Does your dad ______ bargain at the supermarket? — Never! Prices are fixed there.', ['ever', 'never', 'always is', 'often is'], 0, 'Trong câu hỏi \"Does... ever...?\" = có bao giờ... không.'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 9,\n    title: 'Natural Disasters',\n    grammarFocus: 'Past continuous (was / were + V-ing)',\n    vocab: [\n      ['earthquake', 'động đất', 'During an ______, the ground shakes violently, so take cover under a sturdy desk.'],\n      ['volcanic eruption', 'phun trào núi lửa', 'Thick clouds of ash rose high into the sky during the ______.'],\n      ['tornado', 'lốc xoáy', 'A spinning funnel cloud known as a ______ swept across the prairie.'],\n      ['tsunami', 'sóng thần', 'An undersea quake can trigger giant ocean waves called a ______.'],\n      ['landslide', 'sạt lở đất', 'Days of heavy mountain rain caused a muddy ______ across the road.'],\n      ['emergency kit', 'bộ đồ dùng khẩn cấp', 'Every family should prepare an ______ with a torch, water, and a first-aid box.'],\n      ['evacuate', 'sơ tán', 'Rescuers helped villagers ______ safely to higher ground before the flood.'],\n      ['warning', 'cảnh báo', 'Listen carefully to radio storm ______ issued by weather experts.'],\n      ['victim', 'nạn nhân', 'Kind donors sent food and blankets to support flood ______.'],\n      ['property', 'tài sản', 'Strong typhoon winds damaged roofs, fences, and local ______.'],\n    ],\n    grammar: [\n      ['At 8 p.m. yesterday, our family ______ the storm forecast on TV.', ['watched', 'was watching', 'were watching', 'watch'], 1, 'Thời điểm xác định trong quá khứ (\"At 8 p.m. yesterday\") + \"our family\" số ít -> \"was watching\".'],\n      ['While the rescue workers ______ the villagers, the rain stopped.', ['helped', 'were helping', 'was helping', 'are helping'], 1, 'Hành động đang diễn ra (\"were helping\") thì hành động khác xen vào (\"stopped\").'],\n      ['What ______ you doing when the tremor shook the building?', ['was', 'were', 'did', 'are'], 1, 'Câu hỏi quá khứ tiếp diễn với \"you\" -> \"were\".'],\n      ['They ______ walking home from school when a sudden hailstorm began.', ['was', 'were', 'are', 'did'], 1, '\"They\" số nhiều -> \"were walking\".'],\n      ['I was packing the emergency kit while my dad ______ the windows.', ['closed', 'was closing', 'were closing', 'closes'], 1, 'Hai hành động diễn ra song song trong quá khứ nối bằng \"while\" -> cả hai dùng quá khứ tiếp diễn: \"was closing\".'],\n      ['Nam wasn’t sleeping at midnight; he ______ his science project.', ['did', 'was doing', 'were doing', 'does'], 1, 'Tại thời điểm nửa đêm đang làm bài -> \"was doing\".'],\n      ['When the lightning ______, the children were reading inside the tent.', ['strike', 'struck', 'was striking', 'strikes'], 1, 'Hành động ngắn xen vào dùng quá khứ đơn (\"struck\").'],\n      ['______ it raining heavily when your plane landed?', ['Was', 'Were', 'Did', 'Is'], 0, 'Với chủ ngữ \"it\" ở quá khứ tiếp diễn dùng \"Was\".'],\n      ['At this time last week, volunteers ______ clean water to flooded areas.', ['deliver', 'delivered', 'were delivering', 'was delivering'], 2, '\"At this time last week\" + \"volunteers\" số nhiều -> \"were delivering\".'],\n      ['We ______ in the yard when we heard the loud emergency siren.', ['played', 'was playing', 'were playing', 'are playing'], 2, 'Đang chơi khi nghe thấy còi -> \"were playing\".'],\n      ['Why ______ the dog barking so loudly at 3 a.m.?', ['was', 'were', 'did', 'does'], 0, '\"the dog\" số ít + \"barking\" -> \"was\".'],\n      ['While Mai ______ the radio report, power went out across the street.', ['listened to', 'was listening to', 'were listening to', 'is listening to'], 1, 'Đang nghe thì mất điện -> \"was listening to\".'],\n      ['The wind ______ fiercely all night during the typhoon.', ['blow', 'blew', 'was blowing', 'were blowing'], 2, 'Hành động kéo dài suốt đêm (\"all night\") nhấn mạnh quá trình -> \"was blowing\".'],\n      ['Were the students preparing emergency bags at 4 p.m.? — Yes, they ______.', ['did', 'were', 'was', 'are'], 1, 'Trả lời khớp \"Were...?\" -> \"Yes, they were.\"'],\n      ['My grandmother ______ tea when the small earthquake rattled the cups.', ['poured', 'was pouring', 'were pouring', 'is pouring'], 1, 'Đang rót trà thì rung lắc -> \"was pouring\".'],\n      ['Look at the log: two firefighters ______ a trapped kitten from the tree at 10 a.m.', ['saved', 'was saving', 'were saving', 'are saving'], 2, 'Thời điểm cụ thể 10 a.m. + 2 lính cứu hỏa -> \"were saving\".'],\n      ['I didn’t hear your call because I ______ a shower.', ['took', 'was taking', 'were taking', 'am taking'], 1, 'Đang tắm khi bạn gọi -> \"was taking\".'],\n      ['While the storm ______, everyone stayed safely indoors.', ['raged', 'was raging', 'were raging', 'rages'], 1, 'Đang hoành hành -> \"was raging\".'],\n      ['What ______ your parents discussing with the neighbours yesterday afternoon?', ['did', 'was', 'were', 'are'], 2, '\"your parents\" số nhiều + \"discussing\" -> \"were\".'],\n      ['They ______ driving near the hill when a rockslide blocked the lane.', ['was', 'were', 'did', 'are'], 1, '\"They were driving\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 10,\n    title: 'Communication in the Future',\n    grammarFocus: 'Prepositions of time/place & Possessive pronouns',\n    vocab: [\n      ['holography', 'ảnh ba chiều (hologram)', 'With 3D ______, speakers appear like real people standing in your room!'],\n      ['telepathy', 'thần giao cách cảm', '______ means sharing thoughts directly from mind to mind without words.'],\n      ['voice message', 'tin nhắn thoại', 'Instead of typing while walking, send a quick ______ to your mum.'],\n      ['emoji', 'biểu tượng cảm xúc', 'Adding a smiling 😊 ______ makes friendly text messages warmer.'],\n      ['video conference', 'hội nghị truyền hình', 'Our class joined a ______ with partner students in Japan.'],\n      ['translation machine', 'máy dịch tự động', 'A pocket ______ helps travellers understand foreign signs instantly.'],\n      ['internet connection', 'kết nối mạng', 'We need a stable ______ for smooth online group calls.'],\n      ['tablet', 'máy tính bảng', 'Draw your science diagram directly on the ______ screen with a stylus.'],\n      ['carrier pigeon', 'bồ câu đưa thư', 'Centuries ago, people tied rolled letters to a ______ to send news.'],\n      ['social network', 'mạng xã hội', 'Always think twice before posting personal photos on a ______.'],\n    ],\n    grammar: [\n      ['We will have an online meeting with our Australian class ______ 9:30 a.m.', ['in', 'on', 'at', 'for'], 2, 'Giờ giấc cụ thể dùng \"at\".'],\n      ['This smart translator is mine, and that black tablet is ______.', ['her', 'hers', 'she', 'she’s'], 1, 'Thay cho \"her tablet\" dùng đại từ sở hữu \"hers\".'],\n      ['In 2050, holographic classrooms might become common ______ twenty years’ time.', ['at', 'on', 'in', 'by'], 2, '\"in + khoảng thời gian\" (trong vòng ... nữa).'],\n      ['Wait! ______ the future, everyone might wear smart contact lenses.', ['On', 'At', 'In', 'By'], 2, 'Cụm cố định \"in the future\".'],\n      ['Our group finished our slide deck, and the other team finished ______.', ['them', 'their', 'theirs', 'they'], 2, 'Đại từ sở hữu thay cho \"their slide deck\" -> \"theirs\".'],\n      ['Please submit your voice recording ______ Friday afternoon.', ['in', 'at', 'by', 'under'], 2, '\"by + mốc thời gian\" = chậm nhất là vào lúc / trước lúc.'],\n      ['Look! That drone flying ______ the park is delivering a package.', ['in', 'over', 'under', 'between'], 1, 'Bay phía trên công viên -> \"over\".'],\n      ['Is that wireless earpiece yours or ______?', ['he', 'him', 'his', 'he’s'], 2, 'Đại từ sở hữu của \"he\" là \"his\".'],\n      ['We didn’t get any text messages ______ midnight because everyone was asleep.', ['at', 'on', 'in', 'into'], 0, '\"at midnight\" (vào nửa đêm).'],\n      ['My smartphone battery lasts two days; how long does ______ last?', ['your', 'yours', 'you', 'yourself'], 1, 'Thay cho \"your battery/phone\" dùng \"yours\".'],\n      ['Let’s put the webcam right ______ the top of the monitor.', ['in', 'on', 'under', 'between'], 1, 'Đặt trên đỉnh màn hình -> \"on\".'],\n      ['They celebrated World Telecommunication Day ______ May 17th.', ['in', 'at', 'on', 'by'], 2, 'Ngày tháng cụ thể dùng \"on\".'],\n      ['That robot assistant isn’t ours; ______ can speak five languages.', ['their', 'theirs', 'ours', 'its'], 1, 'Làm chủ ngữ thay cho \"their robot assistant\" -> \"theirs\".'],\n      ['Remember to keep a notebook ______ front of you during the lecture.', ['on', 'at', 'in', 'to'], 2, '\"in front of\".'],\n      ['Did the signal drop ______ ten minutes during the thunderstorm?', ['for', 'at', 'on', 'by'], 0, 'Khoảng thời gian kéo dài -> \"for ten minutes\".'],\n      ['Whose stylus pen is lying on the desk? — Oh, it’s ______!', ['my', 'mine', 'I', 'me'], 1, '\"it’s mine!\"'],\n      ['You can sit ______ Mai and Minh so all three appear in the webcam frame.', ['under', 'between', 'opposite', 'over'], 1, '\"between A and B\".'],\n      ['My cousin called me from London ______ Christmas Eve.', ['in', 'at', 'on', 'for'], 2, 'Trước \"Christmas Eve\" (một ngày/buổi tối lễ cụ thể) dùng \"on\".'],\n      ['Our school uses green tablets, and ______ are silver.', ['their', 'theirs', 'them', 'they'], 1, 'Đứng làm chủ ngữ thay cho \"their tablets\" dùng đại từ sở hữu \"theirs\".'],\n      ['The video call with Tokyo starts ______ Monday morning.', ['in', 'on', 'at', 'to'], 1, 'Thứ + buổi (\"Monday morning\") dùng giới từ \"on\".'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 11,\n    title: 'Science and Technology',\n    grammarFocus: 'Reported speech (statements)',\n    vocab: [\n      ['breakthrough', 'bước đột phá', 'Discovering a new clean battery was a huge scientific ______.'],\n      ['fingerprint scanner', 'máy quét vân tay', 'This door unlocks when you touch the ______ with your thumb.'],\n      ['eye-tracking', 'theo dõi ánh mắt', 'Special ______ cameras help students with disabilities type on screens.'],\n      ['experiment', 'thí nghiệm', 'We mixed baking soda and vinegar in a fun Chemistry ______.'],\n      ['robotic', 'thuộc về rô-bốt', 'A ______ arm in the car factory welds metal frames quickly.'],\n      ['biometrics', 'sinh trắc học', 'Face recognition and voice ID are modern forms of ______.'],\n      ['invent', 'phát minh', 'Who helped ______ the light bulb and the telephone?'],\n      ['attend', 'tham dự', 'Students can ______ virtual science lectures from home.'],\n      ['feedback', 'phản hồi, nhận xét', 'The AI tutor gives instant ______ right after you finish a quiz.'],\n      ['available', 'có sẵn', 'Free e-books are now ______ in our online school library.'],\n    ],\n    grammar: [\n      ['Tom said, \"I love science experiments.\" → Tom said that he ______ science experiments.', ['loves', 'loved', 'love', 'is loving'], 1, 'Tường thuật lùi thì hiện tại đơn \"love\" -> quá khứ đơn \"loved\".'],\n      ['Lan told me, \"We are building a solar car now.\" → Lan told me that they were building a solar car ______.', ['now', 'today', 'then', 'tomorrow'], 2, 'Chuyển trạng từ thời gian \"now\" -> \"then\".'],\n      ['\"I will attend the tech fair tomorrow,\" Nam said. → Nam said he ______ attend the tech fair the next day.', ['will', 'would', 'can', 'did'], 1, 'Lùi thì \"will\" -> \"would\".'],\n      ['Ms. Hoa said to us, \"Your robot looks amazing!\" → Ms. Hoa told us that ______ robot looked amazing.', ['your', 'our', 'their', 'my'], 1, 'Đổi đại từ \"Your\" (của chúng tôi) -> \"our\".'],\n      ['\"I can’t solve this coding bug today,\" Minh said. → Minh said he ______ solve that coding bug that day.', ['can’t', 'couldn’t', 'won’t', 'didn’t'], 1, 'Lùi thì \"can’t\" -> \"couldn’t\".'],\n      ['She told me, \"I bought a microscope yesterday.\" → She told me she ______ a microscope the day before.', ['bought', 'had bought', 'buys', 'would buy'], 1, 'Quá khứ đơn \"bought\" trong câu tường thuật lùi thành quá khứ hoàn thành \"had bought\" (hoặc giữ bought, chuẩn SGK 8 dùng had bought).'],\n      ['\"These sensors are very accurate,\" the teacher said. → The teacher said that ______ sensors were very accurate.', ['this', 'that', 'these', 'those'], 3, 'Chuyển đại từ chỉ định \"these\" -> \"those\".'],\n      ['David said he was testing a new app ______.', ['yesterday', 'that day', 'tomorrow', 'now'], 1, 'Trong câu tường thuật, \"today\" đổi thành \"that day\".'],\n      ['\"We must wear safety goggles here,\" said the lab assistant. → The lab assistant said we had to wear safety goggles ______.', ['here', 'there', 'now', 'this'], 1, 'Chuyển trạng từ nơi chốn \"here\" -> \"there\".'],\n      ['Nick ______ me that he wanted to become an aerospace engineer.', ['said', 'told', 'asked', 'spoke'], 1, 'Có tân ngữ \"me\" đi sau -> dùng \"told me\", không dùng \"said me\".'],\n      ['\"My dad works in a robotics company,\" Mi said. → Mi said her dad ______ in a robotics company.', ['work', 'works', 'worked', 'working'], 2, 'Lùi thì \"works\" -> \"worked\".'],\n      ['He said, \"I am going to present my invention next week.\" → He said he was going to present his invention ______.', ['next week', 'the following week', 'last week', 'this week'], 1, '\"next week\" -> \"the following week\".'],\n      ['The scientist said that water ______ at 0 degrees Celsius.', ['freeze', 'freezes', 'froze', 'had frozen'], 1, 'Chân lý khoa học không cần lùi thì -> \"freezes\".'],\n      ['\"I don’t have a 3D printer yet,\" Phong told us. → Phong told us he ______ have a 3D printer yet.', ['doesn’t', 'didn’t', 'hadn’t', 'wouldn’t'], 1, 'Lùi thì \"don’t\" -> \"didn’t\".'],\n      ['She ______ that her brother had won the Young Inventor award.', ['told', 'said', 'asked', 'talked'], 1, 'Không có tân ngữ chỉ người đứng ngay sau -> dùng \"said that...\".'],\n      ['\"We have created a smart plant pot,\" the boys said. → The boys said they ______ a smart plant pot.', ['created', 'have created', 'had created', 'create'], 2, 'Hiện tại hoàn thành \"have created\" lùi thành quá khứ hoàn thành \"had created\".'],\n      ['\"You may try the VR headset now,\" the guide told me. → The guide told me I ______ try the VR headset then.', ['may', 'might', 'can', 'will'], 1, 'Lùi thì \"may\" -> \"might\".'],\n      ['Anna said she ______ visit the Planetarium the next Sunday.', ['will', 'would', 'can', 'is'], 1, 'Tường thuật tương lai -> \"would\".'],\n      ['\"My team is checking the drone battery,\" Duy said. → Duy said his team ______ checking the drone battery.', ['is', 'was', 'were', 'had been'], 1, '\"his team\" số ít -> \"was\".'],\n      ['They told us they ______ finishing the lab report the day before.', ['are', 'were', 'had been', 'will be'], 2, 'Quá khứ tiếp diễn lùi thành \"had been + V-ing\" (hoặc were).'],\n    ],\n  },\n  {\n    grade: 8,\n    unit: 12,\n    title: 'Life on Other Planets',\n    grammarFocus: 'Reported speech (questions)',\n    vocab: [\n      ['galaxy', 'thiên hà', 'Our solar system belongs to the Milky Way ______.'],\n      ['habitable', 'có thể sinh sống được', 'Scientists look for ______ planets that have liquid water and mild temperatures.'],\n      ['telescope', 'kính thiên văn', 'We looked through a powerful ______ to see the bright rings of Saturn.'],\n      ['crater', 'miệng hố va chạm', 'The surface of the Moon is covered in round ______ made by space rocks.'],\n      ['alien', 'người ngoài hành tinh', 'Children love drawing friendly green ______ flying in spaceships.'],\n      ['gravity', 'trọng lực', 'Without ______, astronauts float weightlessly inside the space station.'],\n      ['rocket', 'tên lửa', 'A giant ______ launched the weather satellite into orbit this morning.'],\n      ['atmosphere', 'bầu khí quyển', 'Earth’s ______ protects us from harmful rays and keeps oxygen in.'],\n      ['trace', 'dấu vết', 'Mars rovers search the red soil for any ______ of ancient water.'],\n      ['planet', 'hành tinh', 'Jupiter is the largest ______ in our solar system.'],\n    ],\n    grammar: [\n      ['Nam asked me, \"Do you believe in life on Mars?\" → Nam asked me ______ I believed in life on Mars.', ['that', 'if', 'what', 'did'], 1, 'Tường thuật câu hỏi Yes/No dùng \"if\" hoặc \"whether\".'],\n      ['\"Where is the nearest planetarium?\" the tourist asked. → The tourist asked where the nearest planetarium ______.', ['is', 'was', 'were', 'are'], 1, 'Tường thuật câu hỏi Wh- không đảo ngữ và lùi thì -> \"was\".'],\n      ['She asked him, \"How many moons does Saturn have?\" → She asked him how many moons Saturn ______.', ['has', 'had', 'did have', 'have'], 1, 'Bỏ trợ động từ \"does\" và lùi thì động từ chính \"have\" -> \"had\".'],\n      ['\"Will humans live on the Moon one day?\" Mai asked. → Mai wondered ______ humans would live on the Moon one day.', ['whether', 'that', 'when', 'what'], 0, 'Câu hỏi Yes/No sau \"wondered\" dùng \"whether/if\".'],\n      ['My friend asked me what I ______ doing at the astronomy club then.', ['am', 'was', 'were', 'did'], 1, 'Lùi thì và giữ trật tự chủ ngữ + động từ -> \"I was\".'],\n      ['\"Can you see Venus tonight?\" Dad asked me. → Dad asked me if I ______ see Venus that night.', ['can', 'could', 'will', 'may'], 1, 'Lùi thì \"can\" -> \"could\".'],\n      ['The teacher asked us ______ we had watched the solar eclipse.', ['what', 'if', 'who', 'which'], 1, 'Câu hỏi Yes/No tường thuật dùng \"if\".'],\n      ['\"Why is Mars called the Red Planet?\" Tom asked. → Tom asked why Mars ______ called the Red Planet.', ['is', 'was', 'did', 'were'], 1, 'Trật tự câu khẳng định + lùi thì -> \"was\".'],\n      ['Lan asked Nick, \"Did you visit the space exhibition yesterday?\" → Lan asked Nick if he ______ the space exhibition the day before.', ['visited', 'had visited', 'visits', 'would visit'], 1, 'Quá khứ đơn \"Did visit\" lùi thành quá khứ hoàn thành \"had visited\".'],\n      ['He asked me where ______ from.', ['did the meteorite come', 'came the meteorite', 'the meteorite came', 'was the meteorite come'], 2, 'Câu hỏi tường thuật giữ nguyên trật tự S + V (không đảo ngữ) -> \"the meteorite came\".'],\n      ['\"What are astronauts eating in space?\" the boy asked. → The boy asked what astronauts ______ eating in space.', ['are', 'were', 'was', 'had'], 1, '\"astronauts\" số nhiều + lùi thì -> \"were\".'],\n      ['She wanted to know ______ I liked reading sci-fi novels.', ['whether', 'that', 'did', 'whom'], 0, '\"wanted to know\" câu Yes/No dùng \"whether\".'],\n      ['\"How far is Earth from the Sun?\" Minh asked. → Minh asked how far Earth ______ from the Sun.', ['is', 'was', 'were', 'has'], 1, 'Lùi thì câu tường thuật -> \"was\".'],\n      ['The student asked the astronaut what he ______ most about Earth.', ['misses', 'missed', 'was miss', 'did miss'], 1, 'Bỏ trợ động từ và lùi thì -> \"missed\".'],\n      ['\"Are there any aliens in this movie?\" Hoa asked. → Hoa asked if there ______ any aliens in that movie.', ['are', 'was', 'were', 'had'], 2, '\"any aliens\" số nhiều -> \"were\".'],\n      ['Tom asked his teacher ______ planet had the strongest storms.', ['what', 'which', 'if', 'whether'], 1, 'Hỏi lựa chọn hành tinh nào -> \"which\".'],\n      ['\"Have you ever looked through a telescope?\" he asked me. → He asked me if I ______ ever looked through a telescope.', ['have', 'had', 'did', 'was'], 1, '\"Have\" lùi thì thành \"had\".'],\n      ['Mary asked me when the rocket ______ launch.', ['will', 'would', 'did', 'does'], 1, 'Tường thuật \"will\" -> \"would\".'],\n      ['\"Who discovered Jupiter’s four largest moons?\" the quiz host asked. → The quiz host asked who ______ Jupiter’s four largest moons.', ['discovers', 'discovered', 'had discovered', 'did discover'], 2, 'Quá khứ đơn lùi thành \"had discovered\".'],\n      ['My little brother asked me ______ stars twinkled at night.', ['why', 'if', 'what', 'whether'], 0, 'Hỏi lý do tại sao sao nhấp nháy -> \"why\".'],\n    ],\n  },\n\n  // ==================== GRADE 9 ====================\n  {\n    grade: 9,\n    unit: 1,\n    title: 'Local Community',\n    grammarFocus: 'Question words before to-infinitives & Phrasal verbs',\n    vocab: [\n      ['artisan', 'nghệ nhân', 'A skilled pottery ______ shaped the clay vase on a spinning wheel.'],\n      ['handicraft', 'đồ thủ công mỹ nghệ', 'Tourists love buying bamboo baskets and silk scarves as local ______.'],\n      ['firefighter', 'lính cứu hỏa', 'Brave ______ arrived within minutes to put out the kitchen blaze.'],\n      ['delivery person', 'nhân viên giao hàng', 'The ______ brought our parcel right to the front gate on time.'],\n      ['garbage collector', 'nhân viên thu gom rác', 'Our neighbourhood stays spotless thanks to the hardworking ______.'],\n      ['speciality', 'đặc sản', 'Bun bo Hue is a famous regional ______ loved across Viet Nam.'],\n      ['preserve', 'bảo tồn, giữ gìn', 'Villagers work together to ______ their 300-year-old conical hat craft.'],\n      ['suburb', 'ngoại ô', 'Bat Trang ceramic village is located in a peaceful ______ of Ha Noi.'],\n      ['facility', 'cơ sở vật chất / tiện ích', 'The new community library is a wonderful public ______ for teenagers.'],\n      ['remind', 'gợi nhớ, nhắc nhở', 'The smell of lotus tea always ______ me of my grandmother’s garden.'],\n    ],\n    grammar: [\n      ['I don’t know ______ to buy authentic silk lanterns in Hoi An.', ['where', 'what', 'who', 'which'], 0, 'Hỏi địa điểm trước to-V -> \"where to buy\".'],\n      ['Could you tell me ______ to do when there is a small fire?', ['where', 'what', 'when', 'why'], 1, 'Tân ngữ của động từ \"do\" -> \"what to do\".'],\n      ['Let’s ______ out more about the history of our local pottery village!', ['find', 'look', 'get', 'take'], 0, 'Cụm động từ \"find out\" = tìm hiểu thông tin.'],\n      ['She asked the baker ______ to turn off the oven.', ['when', 'what', 'who', 'which'], 0, 'Hỏi thời điểm -> \"when to turn off\".'],\n      ['Our grandparents ______ down the secret recipe for rice cakes to my mum.', ['passed', 'turned', 'came', 'cut'], 0, 'Cụm động từ \"pass down\" = truyền lại cho thế hệ sau.'],\n      ['We can’t decide ______ to invite to the neighbourhood clean-up day.', ['who', 'what', 'where', 'how'], 0, 'Hỏi về người -> \"who to invite\".'],\n      ['To stay healthy, our family is trying to ______ down on salty snacks.', ['cut', 'look', 'run', 'pass'], 0, 'Cụm động từ \"cut down on\" = cắt giảm.'],\n      ['Do you know ______ to make a traditional bamboo kite?', ['what', 'who', 'how', 'where'], 2, 'Hỏi cách thức -> \"how to make\".'],\n      ['Oh no! We ______ out of milk for breakfast. Could you buy a carton?', ['ran', 'passed', 'found', 'turned'], 0, 'Cụm động từ \"run out of\" = hết sạch.'],\n      ['My cousin and I ______ on very well; we share books every weekend.', ['get', 'go', 'come', 'put'], 0, 'Cụm động từ \"get on (well) with\" = hòa hợp với.'],\n      ['He wondered ______ train to catch to reach Dong Ho painting village.', ['who', 'which', 'how', 'when'], 1, 'Lựa chọn trước danh từ \"train\" -> \"which train to catch\".'],\n      ['Before visiting the museum, ______ around the craft street to see the workshops.', ['look', 'find', 'cut', 'pass'], 0, 'Cụm động từ \"look around\" = đi ngắm nghía xung quanh.'],\n      ['Our community volunteers ______ back from the beach clean-up at noon.', ['came', 'passed', 'cut', 'ran'], 0, '\"come back\" = trở về.'],\n      ['She showed me ______ to weave small bamboo baskets.', ['what', 'how', 'who', 'where'], 1, 'Hướng dẫn cách làm -> \"how to weave\".'],\n      ['Please ______ care of the community garden while we are away.', ['take', 'make', 'do', 'give'], 0, '\"take care of\" = chăm sóc.'],\n      ['We still aren’t sure ______ to go first: the market or the pagoda.', ['what', 'where', 'who', 'whom'], 1, 'Hỏi nơi chốn -> \"where to go\".'],\n      ['Wait! Don’t throw those jars away; we can ______ them to use for herbs.', ['turn', 'put', 'get', 'find'], 1, 'Cụm \"put something to use\".'],\n      ['The villagers ______ with flu after the sudden cold snap, so we brought soup.', ['came down', 'passed down', 'cut down', 'looked around'], 0, '\"come down with\" = mắc bệnh nhẹ (cảm cúm).'],\n      ['Can you explain ______ to ask for directions politely in English?', ['how', 'what', 'which', 'where'], 0, 'Cách làm -> \"how to ask\".'],\n      ['They set ______ early in the morning to deliver gifts to mountain schools.', ['off', 'down', 'up', 'with'], 0, '\"set off\" = khởi hành.'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 2,\n    title: 'City Life',\n    grammarFocus: 'Double comparatives & Phrasal verbs',\n    vocab: [\n      ['metro', 'tàu điện ngầm / trên cao', 'Taking the ______ helps commuters travel smoothly above busy avenues.'],\n      ['congestion', 'tắc nghẽn giao thông', 'Widening bridges and using buses help reduce traffic ______.'],\n      ['concrete jungle', 'rừng bê tông (đô thị dày đặc nhà)', 'Without green parks, a crowded city can feel like a grey ______.'],\n      ['skyscraper', 'tòa nhà chọc trời', 'Landmark 81 is the tallest glass ______ in Ho Chi Minh City.'],\n      ['construction site', 'công trường xây dựng', 'Wear a hard hat when walking past any active ______.'],\n      ['bustling', 'nhộn nhịp, hối hả', 'The night market is ______ with shoppers, lights, and music.'],\n      ['liveable', 'đáng sống', 'Clean rivers and plenty of trees make a city truly ______ for families.'],\n      ['itchy', 'ngứa', 'Thick urban dust sometimes gives cyclists ______ eyes and coughs.'],\n      ['tram', 'xe điện mặt đất', 'Melbourne is famous for its green vintage ______ gliding along city rails.'],\n      ['amenity', 'tiện nghi đô thị', 'Hospitals, parks, and sports centres are essential city ______.'],\n    ],\n    grammar: [\n      ['The ______ the city gets, the more crowded its public parks become.', ['big', 'bigger', 'biggest', 'more big'], 1, 'So sánh kép: \"The + so sánh hơn..., the + so sánh hơn...\".'],\n      ['The more trees we plant along the streets, the ______ the air will be.', ['fresh', 'fresher', 'freshest', 'more fresh'], 1, 'So sánh kép với tính từ ngắn \"fresh\" -> \"fresher\".'],\n      ['The ______ you travel by metro, the less stress you feel in rush hour.', ['often', 'more often', 'most often', 'oftener'], 1, 'So sánh kép với trạng từ dài -> \"The more often\".'],\n      ['Our neighbourhood is ______ out a plan to build a new cycling lane.', ['carrying', 'getting', 'hanging', 'throwing'], 0, 'Cụm động từ \"carry out\" = tiến hành, thực hiện (kế hoạch).'],\n      ['The busier the intersection is, the ______ drivers need to stay.', ['careful', 'more careful', 'most careful', 'carefully'], 1, '\"need to stay + ADJ\" -> so sánh kép dùng \"the more careful\".'],\n      ['Teenagers often ______ out with friends at the shopping mall at weekends.', ['hang', 'carry', 'come', 'get'], 0, 'Cụm động từ \"hang out (with)\" = đi chơi tụ tập.'],\n      ['The ______ the flat is to the city centre, the higher the rent is.', ['near', 'closer', 'closest', 'more close'], 1, 'Tính từ ngắn \"close\" -> \"closer\".'],\n      ['We had to ______ down on noisy street parties after 10 p.m.', ['cut', 'hang', 'carry', 'come'], 0, '\"cut down on\" = cắt giảm.'],\n      ['The more modern the transport system becomes, the ______ people commute.', ['easy', 'easily', 'more easily', 'most easily'], 2, 'Bổ nghĩa động từ \"commute\" -> trạng từ \"the more easily\".'],\n      ['Don’t ______ away empty cans; drop them into the metal recycling bin!', ['throw', 'carry', 'hang', 'get'], 0, '\"throw away\" = vứt bỏ đi.'],\n      ['The ______ the traffic jam, the longer it takes to get to school.', ['bad', 'worse', 'worst', 'badder'], 1, 'So sánh kép bất quy tắc của \"bad\" là \"worse\".'],\n      ['Let’s ______ on the skytrain at the next station near the museum!', ['get', 'hang', 'carry', 'cut'], 0, '\"get on\" = lên xe (buýt/tàu).'],\n      ['The less electricity you waste, the ______ money your family spends.', ['little', 'less', 'least', 'fewer'], 1, 'Không đếm được (\"money\") dùng so sánh kép \"the less\".'],\n      ['I need to ______ up early tomorrow to catch the airport express.', ['get', 'go', 'turn', 'hang'], 0, '\"get up\" = thức dậy.'],\n      ['The more colourful the street lanterns are, the ______ tourists visit.', ['many', 'more', 'most', 'much'], 1, 'So sánh kép với danh từ đếm được số nhiều -> \"the more tourists\".'],\n      ['After riding past the dusty road, Mai ______ down with a sore throat.', ['came', 'got', 'turned', 'carried'], 0, '\"come down with\" = bị ốm nhẹ.'],\n      ['The ______ we leave for the station, the fewer delays we will face.', ['early', 'earlier', 'earliest', 'more early'], 1, 'Trạng từ ngắn \"early\" -> \"The earlier\".'],\n      ['Please ______ out the instructions before buying a metro smartcard.', ['check', 'hang', 'cut', 'throw'], 0, '\"check out\" = xem xét, kiểm tra kỹ.'],\n      ['The higher the skyscraper is, the ______ the view of the harbour becomes.', ['good', 'better', 'best', 'more good'], 1, 'So sánh hơn bất quy tắc của \"good\" là \"better\".'],\n      ['City authorities decided to ______ down old unsafe wires underground.', ['take', 'hang', 'come', 'carry'], 0, '\"take down\" = tháo dỡ xuống.'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 3,\n    title: 'Healthy Living for Teens',\n    grammarFocus: 'Modal verbs in first conditional sentences',\n    vocab: [\n      ['counsellor', 'cố vấn tâm lý học đường', 'If you feel overwhelmed with exams, talk openly to the school ______.'],\n      ['well-balanced', 'cân bằng hợp lý', 'A ______ life includes time for study, exercise, family, and sleep.'],\n      ['priority', 'ưu tiên hàng đầu', 'Finishing tomorrow’s homework should be your top ______ tonight.'],\n      ['deadline', 'hạn chót nộp bài', 'Plan your schedule early so you never miss a project ______.'],\n      ['distraction', 'sự xao nhãng', 'Social media pop-ups are a major ______ when you try to read.'],\n      ['optimistic', 'lạc quan', 'Staying ______ helps teenagers overcome tough challenges calmly.'],\n      ['physical', 'thuộc về thể chất', 'Daily ______ activity like cycling or swimming boosts your energy.'],\n      ['mental', 'thuộc về tinh thần', 'Getting 8 hours of sleep is vital for good ______ health.'],\n      ['accomplish', 'hoàn thành xuất sắc', 'If you break big goals into small steps, you can ______ anything.'],\n      ['fattening', 'gây béo phì', 'Limit ______ fried snacks and choose fresh fruit instead.'],\n    ],\n    grammar: [\n      ['If you want to sleep soundly at night, you ______ avoid coffee in the evening.', ['should', 'mustn’t', 'might not', 'couldn’t'], 0, 'ĐK loại 1 đưa lời khuyên dùng động từ khuyết thiếu \"should\".'],\n      ['If teens finish their homework early, they ______ relax and watch a film.', ['can', 'mustn’t', 'shouldn’t', 'ought'], 0, 'ĐK loại 1 chỉ khả năng được phép -> \"can\".'],\n      ['If you feel dizzy during PE class, you ______ tell your teacher immediately.', ['must', 'mightn’t', 'can’t', 'won’t'], 0, 'Tình huống an toàn bắt buộc -> \"must\".'],\n      ['If Nam ______ a daily timetable, he may finish all his tasks on time.', ['make', 'makes', 'made', 'will make'], 1, 'Mệnh đề If chia hiện tại đơn -> \"makes\".'],\n      ['You ______ hurt your eyesight if you stare at a dark phone screen for hours.', ['might', 'mustn’t', 'should', 'can’t'], 0, 'Cảnh báo khả năng có thể xảy ra -> \"might\".'],\n      ['If Mai ______ stressed, she shouldn’t keep everything to herself.', ['feel', 'feels', 'felt', 'will feel'], 1, 'Mệnh đề If với \"Mai\" -> \"feels\".'],\n      ['If you hope to win the school marathon, you ______ practise running every week.', ['must', 'mustn’t', 'might not', 'wouldn’t'], 0, 'Điều kiện cần thiết -> \"must\".'],\n      ['Unless we manage our time well, we ______ miss the essay deadline.', ['may', 'shouldn’t', 'mustn’t', 'can’t'], 0, 'Hệ quả có thể xảy ra -> \"may\".'],\n      ['If your eyes get tired, you ______ take a 5-minute break and look at green trees.', ['ought to', 'mustn’t', 'shouldn’t', 'can’t'], 0, '\"ought to\" = nên (tương đương should).'],\n      ['Students ______ bring snacks into the computer room if the teacher forbids it.', ['must', 'mustn’t', 'should', 'can'], 1, 'Điều bị cấm -> \"mustn’t\".'],\n      ['If you eat more green vegetables, your skin ______ look much healthier.', ['might', 'mustn’t', 'shouldn’t', 'needn’t'], 0, 'Kết quả tích cực có thể xảy ra -> \"might\".'],\n      ['What ______ I do if I forget my study plan at home?', ['should', 'mustn’t', 'am', 'did'], 0, 'Hỏi xin lời khuyên ĐK loại 1 -> \"What should I do\".'],\n      ['If they don’t warm up properly, the players ______ pull a muscle.', ['could', 'mustn’t', 'shouldn’t', 'ought'], 0, 'Khả năng chấn thương có thể xảy ra -> \"could\".'],\n      ['You ______ join our morning yoga club if you want to feel calmer.', ['can', 'mustn’t', 'couldn’t', 'shouldn’t'], 0, 'Mời chào khả năng -> \"can\".'],\n      ['If a friend ______ worried, you should listen kindly and encourage them.', ['look', 'looks', 'looked', 'will look'], 1, 'Chủ ngữ số ít \"a friend\" -> \"looks\".'],\n      ['You shouldn’t skip breakfast if you ______ to stay energetic in class.', ['want', 'wants', 'wanted', 'will want'], 0, 'Mệnh đề If với \"you\" -> \"want\".'],\n      ['If Lan keeps exercising twice a week, she ______ join the swim team next month.', ['might', 'mustn’t', 'couldn’t', 'shouldn’t'], 0, 'Khả năng trong tương lai -> \"might\".'],\n      ['If the weather stays sunny, we ______ hold our picnic in the botanical garden.', ['can', 'mustn’t', 'shouldn’t', 'had to'], 0, 'ĐK loại 1 chỉ khả năng -> \"can\".'],\n      ['You ______ stay up past 11 p.m. if you have an early exam tomorrow.', ['shouldn’t', 'must', 'should', 'can'], 0, 'Lời khuyên không nên làm -> \"shouldn’t\".'],\n      ['If everyone turns off phone sounds, the study group ______ focus smoothly.', ['will be able to', 'mustn’t', 'couldn’t', 'shouldn’t'], 0, 'Khả năng hoàn thành thuận lợi -> \"will be able to\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 4,\n    title: 'Remembering the Past',\n    grammarFocus: 'Past continuous & wish + past simple',\n    vocab: [\n      ['heritage', 'di sản', 'Hoi An Ancient Town is a treasured UNESCO cultural ______ site.'],\n      ['monument', 'đài tưởng niệm / công trình lịch sử', 'Visitors take quiet photos at the stone ______ in the city square.'],\n      ['generation', 'thế hệ', 'Folk songs have been passed down from ______ to generation.'],\n      ['barefoot', 'chân trần', 'Decades ago, many rural children walked ______ along village paths.'],\n      ['castle', 'lâu đài cổ', 'We explored the stone towers of an ancient European ______.'],\n      ['communal', 'thuộc cộng đồng', 'Traditional festivals take place inside the wooden ______ yard.'],\n      ['deep-rooted', 'ăn sâu, lâu đời', 'Respecting grandparents and teachers is a ______ Vietnamese value.'],\n      ['complex', 'quần thể kiến trúc', 'The Imperial Citadel is a vast historic ______ in Hue.'],\n      ['takeaway', 'đồ ăn mang về', 'Unlike busy modern ______, grandma’s homemade meals take hours to simmer.'],\n      ['preserve', 'gìn giữ, bảo tồn', 'Young people can help ______ old family photos by scanning them digitally.'],\n    ],\n    grammar: [\n      ['I wish I ______ speak English as fluently as my cousin.', ['can', 'could', 'will', 'may'], 1, 'Cấu trúc ước ở hiện tại: S + wish + S + V(quá khứ đơn) -> \"could\".'],\n      ['At 9 a.m. last Sunday, we ______ old black-and-white family photos.', ['sorted', 'were sorting', 'was sorting', 'are sorting'], 1, 'Thời điểm cụ thể quá khứ + \"we\" -> \"were sorting\".'],\n      ['She wishes she ______ near her grandparents’ village so she could visit daily.', ['live', 'lives', 'lived', 'will live'], 2, '\"wish + S + V2/ed\" -> \"lived\".'],\n      ['While Grandpa ______ stories about his childhood, we listened carefully.', ['told', 'was telling', 'were telling', 'tells'], 1, 'Hành động nền đang diễn ra dùng quá khứ tiếp diễn -> \"was telling\".'],\n      ['I wish there ______ a history museum right in our town.', ['is', 'was', 'were', 'are'], 2, 'Trong câu ước với động từ \"to be\", dùng \"were\" cho mọi ngôi (trang trọng/chuẩn thi).'],\n      ['My parents ______ to school by bike when they were teenagers.', ['went', 'were going', 'used to go', 'are going'], 2, 'Thói quen trong quá khứ: \"used to go\". (Hoặc check câu tiếp diễn).'],\n      ['They wish they ______ have so much homework at weekends.', ['don’t', 'didn’t', 'won’t', 'weren’t'], 1, 'Câu ước phủ định ở hiện tại: \"wish + S + didn’t + V\".'],\n      ['What ______ your aunt doing when you arrived at her house?', ['was', 'were', 'did', 'is'], 0, 'Quá khứ tiếp diễn với \"your aunt\" số ít -> \"was\".'],\n      ['Nam wishes he ______ taller so he could join the senior basketball team.', ['is', 'were', 'will be', 'has been'], 1, 'Câu ước dùng \"were\" cho cả ngôi số ít.'],\n      ['We ______ around the ancient citadel when a gentle rain started.', ['walked', 'was walking', 'were walking', 'are walking'], 2, 'Đang đi bộ thì mưa bắt đầu -> \"were walking\".'],\n      ['I wish our neighbourhood ______ quieter during rush hour.', ['is', 'were', 'will be', 'be'], 1, 'Ước điều không có thật ở hiện tại -> \"were\".'],\n      ['At this time yesterday, the artisan ______ a traditional dragon mask.', ['painted', 'was painting', 'were painting', 'paints'], 1, '\"At this time yesterday\" + số ít -> \"was painting\".'],\n      ['Mai wishes she ______ how to play the traditional moon lute.', ['know', 'knows', 'knew', 'known'], 2, 'Quá khứ đơn của \"know\" trong câu ước -> \"knew\".'],\n      ['While the kids were flying kites, their parents ______ tea under the banyan tree.', ['drank', 'were drinking', 'was drinking', 'drink'], 1, 'Hai hành động diễn ra song song quá khứ -> \"were drinking\".'],\n      ['Do you ever wish you ______ travel back in time to see ancient Ha Noi?', ['can', 'could', 'will', 'must'], 1, 'Câu ước dùng \"could\".'],\n      ['The villagers ______ preparing five-fruit trays all Sunday afternoon.', ['was', 'were', 'did', 'are'], 1, '\"The villagers\" số nhiều -> \"were\".'],\n      ['He wishes his old bicycle ______ broken anymore.', ['isn’t', 'weren’t', 'wasn’t be', 'didn’t'], 1, 'Câu ước phủ định với tính từ dùng \"weren’t\".'],\n      ['When I entered the living room, Grandma ______ an old folk song.', ['hummed', 'was humming', 'were humming', 'hums'], 1, 'Đang ngân nga khi tôi bước vào -> \"was humming\".'],\n      ['I wish I ______ a better camera to photograph this stone temple.', ['have', 'has', 'had', 'will have'], 2, 'Ước ở hiện tại -> \"had\".'],\n      ['They ______ cleaning the communal yard at 8 o’clock yesterday morning.', ['was', 'were', 'did', 'have'], 1, '\"They were cleaning\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 5,\n    title: 'Our Experiences',\n    grammarFocus: 'Present perfect tense (have/has + V3)',\n    vocab: [\n      ['eco-tour', 'du lịch sinh thái', 'Joining a mangrove ______ taught us how trees protect the coast.'],\n      ['snorkelling', 'lặn ống thở ngắm san hô', 'We tried ______ in crystal-clear sea water to watch colourful fish.'],\n      ['memorable', 'đáng nhớ', 'Our campfire night with songs and riddles was the most ______ moment!'],\n      ['exhausting', 'gây kiệt sức', 'Climbing steep rocky trails for five hours was thrilling yet ______.'],\n      ['exhilarating', 'phấn khích tột độ', 'Riding a zip-line across the green canopy felt truly ______.'],\n      ['tribal dance', 'điệu múa dân tộc', 'Tourists clapped along to the joyful ______ around the evening bonfire.'],\n      ['gong show', 'buổi biểu diễn cồng chiêng', 'Attending a highland ______ is a wonderful cultural experience.'],\n      ['helpless', 'bất lực, lúng túng', 'When my compass broke in the fog, I felt a bit ______ at first.'],\n      ['amazing', 'tuyệt vời, kinh ngạc', 'Seeing stars fill the desert sky was an ______ experience!'],\n      ['team building', 'xây dựng tinh thần đồng đội', 'Rope games at summer camp strengthened our class’s ______ spirit.'],\n    ],\n    grammar: [\n      ['Have you ever ______ snorkelling near a coral reef?', ['go', 'went', 'gone', 'going'], 2, 'Hiện tại hoàn thành: \"Have you ever + V3\" -> \"gone\" (hoặc \"been\").'],\n      ['She ______ joined three volunteer eco-tours since last summer.', ['have', 'has', 'did', 'was'], 1, 'Với \"She\" + \"since last summer\" dùng \"has\".'],\n      ['We haven’t seen such a breathtaking waterfall ______!', ['already', 'just', 'before', 'never'], 2, 'Đứng cuối câu phủ định hiện tại hoàn thành -> \"before\".'],\n      ['Nam has ______ finished writing his camp diary; the ink is still wet!', ['yet', 'just', 'never', 'ever'], 1, 'Vừa mới xảy ra đặt giữa \"has ... V3\" -> \"just\".'],\n      ['I ______ never ridden a horse on a mountain trail in my life.', ['has', 'have', 'did', 'am'], 1, '\"I have never + V3\".'],\n      ['They have lived in this coastal town ______ 2016.', ['for', 'since', 'in', 'from'], 1, 'Trước mốc thời gian năm 2016 dùng \"since\".'],\n      ['Has Mai packed her sleeping bag for the trip ______?', ['already', 'just', 'yet', 'ever'], 2, 'Đứng cuối câu hỏi hiện tại hoàn thành dùng \"yet\".'],\n      ['My parents have worked at that community school ______ twelve years.', ['since', 'for', 'in', 'ago'], 1, 'Trước khoảng thời gian (\"twelve years\") dùng \"for\".'],\n      ['This is the most exciting science camp I have ______ attended.', ['never', 'ever', 'yet', 'just'], 1, 'Trong cấu trúc so sánh nhất: \"... the most + adj + N + S + have ever + V3\".'],\n      ['We ______ already visited the Botanical Garden twice this year.', ['have', 'has', 'did', 'were'], 0, 'Chủ ngữ \"We\" -> \"have\".'],\n      ['How long ______ your cousin been a member of the Scout club?', ['have', 'has', 'did', 'is'], 1, '\"your cousin\" số ít dùng \"has\".'],\n      ['He ______ his ankle during yesterday’s hike, so he is resting today.', ['hurt', 'has hurt', 'hurts', 'hurting'], 0, 'Có trạng từ quá khứ xác định \"yesterday’s hike\" -> dùng quá khứ đơn \"hurt\"!'],\n      ['Have the students ______ up their tents yet?', ['put', 'puts', 'putting', 'putted'], 0, 'V3 của \"put\" vẫn là \"put\".'],\n      ['Lan ______ many memorable photos since the festival started.', ['took', 'takes', 'has taken', 'have taken'], 2, '\"since + quá khứ đơn\", mệnh đề chính chia hiện tại hoàn thành -> \"has taken\".'],\n      ['I haven’t eaten grilled corn ______ last winter.', ['for', 'since', 'from', 'ago'], 1, 'Trước mốc \"last winter\" dùng \"since\".'],\n      ['She has ______ a detailed map of every nature trail we explored.', ['draw', 'drew', 'drawn', 'drawing'], 2, 'V3 của \"draw\" là \"drawn\".'],\n      ['No one in my class has ______ climbed Mount Fansipan.', ['never', 'ever', 'yet', 'for'], 1, 'Với \"No one\" mang nghĩa phủ định không dùng thêm \"never\" -> dùng \"ever\".'],\n      ['Look! The team ______ just won first prize in the rope-pulling game!', ['have', 'has', 'did', 'was'], 1, '\"The team\" số ít -> \"has\".'],\n      ['We ______ known each other since Grade 6.', ['have', 'has', 'are', 'did'], 0, '\"We have known\".'],\n      ['Has your brother ever ______ to a gong performance?', ['was', 'been', 'go', 'went'], 1, 'Trải nghiệm đã từng tới đâu: \"Has... ever been to\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 6,\n    title: 'Vietnamese Lifestyle: Then and Now',\n    grammarFocus: 'Verbs + to-infinitive & Verbs + V-ing',\n    vocab: [\n      ['nuclear family', 'gia đình hạt nhân (2 thế hệ)', 'Today, many urban couples and their kids live in a small ______.'],\n      ['extended family', 'đại gia đình (nhiều thế hệ)', 'Grandparents, parents, and aunts living under one roof form an ______.'],\n      ['privacy', 'sự riêng tư', 'Teenagers today often enjoy having their own bedroom for study and ______.'],\n      ['memorise', 'học thuộc lòng', 'In the past, students spent hours trying to ______ long poems by heart.'],\n      ['democratic', 'dân chủ, cởi mở', 'Modern family discussions are more ______ as parents listen to kids’ opinions.'],\n      ['dependent', 'phụ thuộc', 'Young children are still ______ on their parents for food and care.'],\n      ['dye', 'nhuộm (vải/tóc)', 'Craftswomen use indigo leaves to ______ traditional cotton cloth deep blue.'],\n      ['pursue', 'theo đuổi (ước mơ/ngành học)', 'Girls nowadays are free to ______ careers in science, art, or engineering.'],\n      ['generation gap', 'khoảng cách thế hệ', 'Open talks help bridge the ______ between grandparents and teens.'],\n      ['monk', 'nhà sư / thầy tu', 'Long ago, village scholars and a respected ______ taught children to read.'],\n    ],\n    grammar: [\n      ['My parents decided ______ a bigger desk for my study corner.', ['buy', 'buying', 'to buy', 'bought'], 2, 'Sau động từ \"decide\" dùng to-infinitive -> \"to buy\".'],\n      ['Grandma enjoys ______ folk stories about life in the 1970s.', ['tell', 'to tell', 'telling', 'told'], 2, 'Sau \"enjoy\" chỉ dùng V-ing -> \"telling\".'],\n      ['She promised ______ me cook traditional pho this Sunday.', ['teach', 'teaching', 'to teach', 'taught'], 2, 'Cấu trúc \"promise + to V\" -> \"to teach\".'],\n      ['Do you mind ______ down the TV while I revise my English notes?', ['turn', 'turning', 'to turn', 'turned'], 1, '\"mind + V-ing\" -> \"turning\".'],\n      ['In the past, few villagers could afford ______ a bicycle.', ['own', 'owning', 'to own', 'owned'], 2, '\"afford + to V\" (đủ khả năng chi trả) -> \"to own\".'],\n      ['We finished ______ the family photo album before Grandma arrived.', ['make', 'making', 'to make', 'made'], 1, 'Sau \"finish\" chỉ dùng V-ing -> \"making\".'],\n      ['He plans ______ architecture at university next year.', ['study', 'studying', 'to study', 'studied'], 2, '\"plan + to V\" -> \"to study\".'],\n      ['Avoid ______ too fast on wet brick roads after rain.', ['ride', 'riding', 'to ride', 'rode'], 1, '\"avoid + V-ing\" -> \"riding\".'],\n      ['I hope ______ more about how my grandparents spent their childhood.', ['learn', 'learning', 'to learn', 'learned'], 2, '\"hope + to V\" -> \"to learn\".'],\n      ['She suggested ______ a family reunion picnic at the weekend.', ['have', 'having', 'to have', 'had'], 1, '\"suggest + V-ing\" -> \"having\".'],\n      ['They agreed ______ turns washing the dishes every evening.', ['take', 'taking', 'to take', 'took'], 2, '\"agree + to V\" -> \"to take\".'],\n      ['Keep ______ hard, and your English fluency will amaze everyone!', ['practise', 'practising', 'to practise', 'practised'], 1, '\"keep + V-ing\" -> \"practising\".'],\n      ['He refused ______ junk food because he follows a healthy diet.', ['eat', 'eating', 'to eat', 'ate'], 2, '\"refuse + to V\" -> \"to eat\".'],\n      ['My brother fancies ______ an electric guitar this summer.', ['learn', 'learning', 'to learn', 'learned'], 1, '\"fancy + V-ing\" -> \"learning\".'],\n      ['Don’t forget ______ off the hallway light before going upstairs.', ['turn', 'turning', 'to turn', 'turned'], 2, '\"forget + to V\" = quên việc cần làm -> \"to turn\".'],\n      ['I’ll never forget ______ our ancestral village for the first time.', ['visit', 'visiting', 'to visit', 'visited'], 1, '\"forget + V-ing\" = quên kỷ niệm đã trải qua -> \"visiting\".'],\n      ['Would you like ______ some steamed sticky rice with us?', ['try', 'trying', 'to try', 'tried'], 2, '\"Would you like + to V\" -> \"to try\".'],\n      ['We spent two hours ______ old letters from Uncle Minh.', ['read', 'reading', 'to read', 'reads'], 1, '\"spend + thời gian + V-ing\" -> \"reading\".'],\n      ['She wants ______ a modern website for her family’s bakery.', ['design', 'designing', 'to design', 'designed'], 2, '\"want + to V\" -> \"to design\".'],\n      ['Can you imagine ______ in a village without electricity or phones?', ['live', 'living', 'to live', 'lived'], 1, '\"imagine + V-ing\" -> \"living\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 7,\n    title: 'Natural Wonders of the World',\n    grammarFocus: 'Reported speech (Yes/No questions)',\n    vocab: [\n      ['biodiversity', 'đa dạng sinh học', 'Amazon rainforest has incredible ______ with millions of plant and animal species.'],\n      ['coral reef', 'rạn san hô', 'The Great Barrier Reef is the world’s largest living ______.'],\n      ['summit', 'đỉnh núi', 'Mountaineers celebrated when they finally reached the snowy ______ of Everest.'],\n      ['annual', 'hàng năm', 'Millions of tourists make an ______ trip to see cherry blossoms in spring.'],\n      ['hesitate', 'do dự, ngập ngừng', 'Don’t ______ to ask the park guide if you want to know more about caves.'],\n      ['admire', 'ngưỡng mộ, chiêm ngưỡng', 'Visitors stood quietly to ______ the golden sunrise over Angkor Wat.'],\n      ['urgent', 'khẩn cấp', 'Protecting vanishing glaciers requires ______ global action today.'],\n      ['locate', 'nằm ở vị trí', 'Where is Victoria Falls ______? — On the border of Zambia and Zimbabwe.'],\n      ['majestic', 'hùng vĩ, tráng lệ', 'The Grand Canyon offers ______ red rock views stretching for miles.'],\n      ['permission', 'sự cho phép', 'You must get official ______ before trekking deep into Son Doong Cave.'],\n    ],\n    grammar: [\n      ['\"Is Son Doong Cave in Quang Binh?\" the tourist asked. → The tourist asked me ______ Son Doong Cave was in Quang Binh.', ['that', 'if', 'what', 'did'], 1, 'Tường thuật câu hỏi Yes/No dùng \"if / whether\".'],\n      ['\"Do polar bears live in Antarctica?\" Mai asked. → Mai asked her teacher whether polar bears ______ in Antarctica.', ['live', 'lived', 'did live', 'were live'], 1, 'Bỏ trợ động từ \"Do\", lùi thì \"live\" -> \"lived\".'],\n      ['\"Can visitors swim near the waterfall?\" Nick asked. → Nick asked the guide if visitors ______ swim near the waterfall.', ['can', 'could', 'will', 'may'], 1, 'Lùi thì \"can\" -> \"could\".'],\n      ['\"Will the volcano erupt soon?\" the reporter asked. → The reporter wanted to know if the volcano ______ erupt soon.', ['will', 'would', 'did', 'is'], 1, 'Lùi thì \"will\" -> \"would\".'],\n      ['\"Have you ever seen the Northern Lights?\" she asked him. → She asked him whether he ______ ever seen the Northern Lights.', ['have', 'has', 'had', 'did'], 2, 'Hiện tại hoàn thành lùi thành quá khứ hoàn thành \"had\".'],\n      ['\"Are coral reefs endangered by warm seas?\" the student asked. → The student asked if coral reefs ______ endangered by warm seas.', ['are', 'was', 'were', 'had'], 2, '\"coral reefs\" số nhiều lùi thành \"were\".'],\n      ['\"Did you bring a raincoat for the forest trail?\" Mum asked me. → Mum asked me if I ______ a raincoat for the forest trail.', ['brought', 'had brought', 'bring', 'would bring'], 1, 'Quá khứ đơn \"Did... bring\" lùi thành \"had brought\".'],\n      ['\"Is the Grand Canyon deeper than 1,500 metres?\" he asked. → He asked whether the Grand Canyon ______ deeper than 1,500 metres.', ['is', 'was', 'were', 'has been'], 1, 'Lùi thì số ít -> \"was\".'],\n      ['\"Does Mount Fuji belong to Japan?\" the pupil asked. → The pupil asked if Mount Fuji ______ to Japan.', ['belong', 'belongs', 'belonged', 'was belong'], 2, 'Bỏ \"Does\" và chia quá khứ đơn \"belonged\".'],\n      ['\"Are you planning to hike Fansipan next month?\" Tom asked Lan. → Tom asked Lan if she ______ planning to hike Fansipan the following month.', ['is', 'was', 'were', 'had'], 1, 'Lùi thì hiện tại tiếp diễn -> \"was\".'],\n      ['\"Must we stay on the wooden path?\" the hikers asked. → The hikers asked if they ______ stay on the wooden path.', ['must', 'had to', 'will', 'can'], 1, '\"must\" (bắt buộc) thường lùi thành \"had to\" trong câu tường thuật.'],\n      ['\"Was the lake frozen last winter?\" my cousin asked. → My cousin asked if the lake ______ frozen the winter before.', ['was', 'had been', 'is', 'were'], 1, 'Quá khứ \"Was\" lùi thành \"had been\".'],\n      ['She asked us ______ we wanted to join the boat trip around Ha Long Bay.', ['that', 'whether', 'what', 'which'], 1, 'Tường thuật câu hỏi Yes/No -> \"whether\".'],\n      ['\"Do tourists need a guide for that canyon?\" he asked. → He asked me whether tourists ______ a guide for that canyon.', ['need', 'needed', 'did need', 'will need'], 1, 'Lùi thì -> \"needed\".'],\n      ['\"Can you hear the roar of Victoria Falls from here?\" Nam asked. → Nam asked if I could hear the roar of Victoria Falls from ______.', ['here', 'there', 'now', 'this'], 1, 'Đổi \"here\" -> \"there\".'],\n      ['\"Will our class visit Cuc Phuong Park tomorrow?\" Hoa asked. → Hoa asked whether their class would visit Cuc Phuong Park ______.', ['tomorrow', 'yesterday', 'the next day', 'today'], 2, 'Đổi \"tomorrow\" -> \"the next day\".'],\n      ['The ranger asked us ______ we had any plastic bottles in our bags.', ['what', 'if', 'when', 'where'], 1, 'Câu hỏi Yes/No -> \"if\".'],\n      ['\"Have scientists discovered new caves here recently?\" she asked. → She asked whether scientists ______ new caves there recently.', ['discovered', 'have discovered', 'had discovered', 'discover'], 2, 'Lùi thì -> \"had discovered\".'],\n      ['\"May I take photos inside this limestone grotto?\" Nick asked. → Nick asked the guide if he ______ take photos inside that limestone grotto.', ['may', 'might', 'can', 'will'], 1, 'Lùi thì \"May\" -> \"might\".'],\n      ['\"Are there many rare orchids on this island?\" the visitor asked. → The visitor asked whether there ______ many rare orchids on that island.', ['are', 'was', 'were', 'have been'], 2, '\"many rare orchids\" số nhiều -> \"were\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 8,\n    title: 'Tourism',\n    grammarFocus: 'Relative pronouns (who, which, whose)',\n    vocab: [\n      ['itinerary', 'lịch trình chuyến đi', 'Our travel ______ includes visiting three museums and a floating market.'],\n      ['package holiday', 'kỳ nghỉ trọn gói', 'A ______ includes flights, hotel rooms, and guided city tours in one price.'],\n      ['self-guided', 'tự túc (du lịch)', 'We used a map app to enjoy a flexible ______ walking tour of Hue.'],\n      ['ruinous', 'tàn tích, đổ nát cổ xưa', 'Archaeologists study the ______ stone walls of the ancient temple.'],\n      ['homestay', 'nhà dân đón khách du lịch', 'Staying at a village ______ lets travellers share meals with a local family.'],\n      ['brochure', 'tập sách quảng cáo du lịch', 'Pick up a free tourist ______ at the information desk for train times.'],\n      ['domestic', 'nội địa, trong nước', 'Phu Quoc and Da Lat are top ______ destinations for Vietnamese families.'],\n      ['entrance ticket', 'vé vào cửa', 'Show your ______ at the gate before entering the royal palace.'],\n      ['smooth', 'suôn sẻ, thuận lợi', 'Checking passports early helped us have a ______ trip to Singapore.'],\n      ['estimate', 'ước tính', 'Travel guides ______ the boat ride takes roughly 45 minutes.'],\n    ],\n    grammar: [\n      ['The tour guide ______ showed us around Hue Citadel spoke fluent English.', ['which', 'who', 'whose', 'where'], 1, 'Thay cho danh từ chỉ người (\"The tour guide\") làm chủ ngữ -> dùng \"who\".'],\n      ['This is the travel brochure ______ gives details about our weekend itinerary.', ['who', 'whose', 'which', 'whom'], 2, 'Thay cho danh từ chỉ vật (\"the travel brochure\") -> dùng \"which\".'],\n      ['I met a local artisan ______ hand-painted fans are famous worldwide.', ['who', 'which', 'whose', 'that'], 2, 'Chỉ sở hữu trước danh từ (\"whose hand-painted fans\") -> dùng \"whose\".'],\n      ['The homestay ______ we booked online has a lovely view of the rice terraces.', ['who', 'whose', 'which', 'whom'], 2, 'Thay cho vật (\"The homestay\") -> \"which\".'],\n      ['Passengers ______ arrive late may miss the morning ferry.', ['who', 'which', 'whose', 'what'], 0, 'Chỉ người làm chủ ngữ -> \"who\".'],\n      ['Do you know the name of the girl ______ backpack was left on the coach?', ['who', 'which', 'whose', 'whom'], 2, 'Chỉ sở hữu (\"backpack của cô gái\") -> \"whose\".'],\n      ['Let’s visit a floating market ______ opens early at sunrise.', ['who', 'which', 'whose', 'whom'], 1, 'Chỉ vật/địa điểm đóng vai trò chủ ngữ -> \"which\".'],\n      ['The hotel receptionist ______ helped us check in was very polite.', ['which', 'who', 'whose', 'where'], 1, 'Chỉ người -> \"who\".'],\n      ['That is the island ______ beaches look like white sugar.', ['who', 'which', 'whose', 'where'], 2, 'Chỉ sở hữu (\"beaches của hòn đảo\") -> \"whose\".'],\n      ['She lost the camera ______ her uncle gave her before the trip.', ['who', 'whose', 'which', 'whom'], 2, 'Chỉ vật làm tân ngữ -> \"which\".'],\n      ['Tourists ______ prefer adventure often choose mountain trekking.', ['who', 'which', 'whose', 'what'], 0, 'Chỉ người -> \"who\".'],\n      ['We boarded a sightseeing bus ______ had an open top deck.', ['who', 'which', 'whose', 'whom'], 1, 'Chỉ vật -> \"which\".'],\n      ['The boy ______ parents run that cosy café knows every trail here.', ['who', 'which', 'whose', 'whom'], 2, 'Sở hữu cách -> \"whose\".'],\n      ['Have you read the guidebook ______ I lent you last Monday?', ['who', 'which', 'whose', 'what'], 1, 'Chỉ vật -> \"which\".'],\n      ['Ms. Lien is the friendly host ______ cooked crispy pancakes for our group.', ['who', 'which', 'whose', 'where'], 0, 'Chỉ người -> \"who\".'],\n      ['They took a photo of the ancient bridge ______ crosses the Perfume River.', ['who', 'whose', 'which', 'whom'], 2, 'Chỉ vật -> \"which\".'],\n      ['Anyone ______ loses a passport should report it immediately.', ['who', 'which', 'whose', 'whom'], 0, 'Chỉ người -> \"who\".'],\n      ['That’s the historic train ______ interior has been restored beautifully.', ['who', 'which', 'whose', 'that'], 2, 'Sở hữu (\"interior của con tàu\") -> \"whose\".'],\n      ['We bought honey and herbal tea from a shop ______ sits near the waterfall.', ['who', 'which', 'whose', 'whom'], 1, 'Chỉ vật -> \"which\".'],\n      ['The photographer ______ works appeared in the travel magazine lives in Da Nang.', ['who', 'which', 'whose', 'whom'], 2, 'Sở hữu (\"tác phẩm của nhiếp ảnh gia\") -> \"whose\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 9,\n    title: 'World Englishes',\n    grammarFocus: 'Defining relative clauses',\n    vocab: [\n      ['bilingual', 'song ngữ', 'Children raised speaking both Vietnamese and English grow up ______.'],\n      ['fluent', 'trôi chảy, lưu loát', 'Reading storybooks every day makes you more ______ in English.'],\n      ['variety', 'biến thể (ngôn ngữ)', 'British, American, and Australian English are each a distinct ______ of English.'],\n      ['official language', 'ngôn ngữ chính thức', 'English is an ______ in countries like Singapore, India, and Canada.'],\n      ['translate', 'dịch thuật', 'Can you ______ this Vietnamese folk proverb into clear English?'],\n      ['look up', 'tra cứu (từ điển)', 'Whenever you meet an unfamiliar word, ______ its meaning in a dictionary.'],\n      ['concentric', 'đồng tâm', 'Braj Kachru used three ______ circles to describe English speakers globally.'],\n      ['pick up', 'học lỏm / tiếp thu tự nhiên', 'Kids quickly ______ new phrases when listening to English cartoons.'],\n      ['immigrant', 'người nhập cư', 'New ______ communities often share delicious foods and new words with cities.'],\n      ['vocabulary', 'từ vựng', 'Keeping a mini notebook helps expand your active English ______.'],\n    ],\n    grammar: [\n      ['A dictionary is a book ______ explains the meanings and pronunciation of words.', ['who', 'which', 'whose', 'where'], 1, 'Mệnh đề quan hệ xác định thay cho vật \"a book\" -> \"which\".'],\n      ['A polyglot is someone ______ can speak several languages fluently.', ['who', 'which', 'whose', 'whom'], 0, 'Thay cho người làm chủ ngữ -> \"who\".'],\n      ['Is that the English podcast ______ you listen to every morning?', ['who', 'whose', 'which', 'what'], 2, 'Thay cho vật \"podcast\" -> \"which\".'],\n      ['The student ______ notebook is full of colour-coded idioms got an A+.', ['who', 'which', 'whose', 'that'], 2, 'Chỉ sở hữu trước danh từ \"notebook\" -> \"whose\".'],\n      ['Do you remember the teacher ______ taught us how to pronounce \"-ed\" endings?', ['who', 'which', 'whose', 'whom'], 0, 'Chỉ người làm chủ ngữ -> \"who\".'],\n      ['\"Pavement\" is a British word ______ Americans call \"sidewalk\".', ['who', 'which', 'whose', 'where'], 1, 'Thay cho từ/vật -> \"which\".'],\n      ['She wants to visit a country ______ people use English as a second language.', ['who', 'which', 'where', 'whose'], 2, 'Chỉ nơi chốn (\"ở đất nước mà...\") -> \"where\".'],\n      ['The grammar rule ______ we learned today explains defining relative clauses.', ['who', 'which', 'whose', 'whom'], 1, 'Thay cho vật -> \"which\".'],\n      ['Let’s invite a classmate ______ speaks very clear English to host the quiz.', ['which', 'who', 'whose', 'what'], 1, 'Chỉ người -> \"who\".'],\n      ['I downloaded an app ______ checks spelling and suggests better synonyms.', ['who', 'that', 'whose', 'whom'], 1, '\"that\" thay được cho danh từ chỉ vật trong mệnh đề quan hệ xác định.'],\n      ['That’s the bilingual library ______ my sister borrows comic books from.', ['who', 'which', 'whose', 'whom'], 1, 'Có giới từ \"from\" ở cuối nên dùng \"which\" (không dùng where).'],\n      ['The Canadian boy ______ sits next to Nam helped us check our dialogue.', ['who', 'which', 'whose', 'whom'], 0, 'Chỉ người -> \"who\".'],\n      ['Words ______ sound identical but have different spellings are called homophones.', ['who', 'that', 'whose', 'whom'], 1, 'Thay cho \"Words\" -> \"that\" (hoặc which).'],\n      ['Do you know the reason ______ some English words come from French?', ['which', 'why', 'where', 'who'], 1, 'Sau \"the reason\" dùng trạng từ quan hệ \"why\".'],\n      ['We watched a documentary about Singapore, ______ is famous for \"Singlish\"!', ['that', 'which', 'who', 'where'], 1, 'Sau dấu phẩy (mệnh đề không xác định) chỉ dùng \"which\", KHÔNG dùng \"that\"!'],\n      ['The girl ______ parents are both translators speaks three languages.', ['who', 'which', 'whose', 'whom'], 2, 'Sở hữu -> \"whose\".'],\n      ['Tell me the exact day ______ the English Spelling Bee takes place.', ['where', 'when', 'which', 'who'], 1, 'Chỉ thời gian (\"the exact day\") -> \"when\".'],\n      ['This is the best pronunciation video ______ I have watched this week.', ['who', 'that', 'whose', 'what'], 1, 'Sau so sánh nhất (\"the best\") ưu tiên dùng \"that\".'],\n      ['Students ______ read English comics daily build strong vocabulary naturally.', ['who', 'which', 'whose', 'whom'], 0, 'Chỉ người -> \"who\".'],\n      ['\"Lorry\" is the word ______ people in the UK use for \"truck\".', ['who', 'whose', 'which', 'where'], 2, 'Thay cho vật \"the word\" -> \"which\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 10,\n    title: 'Planet Earth',\n    grammarFocus: 'Non-defining relative clauses',\n    vocab: [\n      ['food chain', 'chuỗi thức ăn', 'In a forest ______, plants feed insects, and insects feed small birds.'],\n      ['habitat loss', 'mất môi trường sống', 'Cutting down rainforests causes severe ______ for wild orangutans.'],\n      ['nature reserve', 'khu bảo tồn thiên nhiên', 'Rare cranes fly south to rest inside this protected ______.'],\n      ['polar', 'thuộc vùng cực', 'Icebergs and snowy plains are typical features of ______ habitats.'],\n      ['fertiliser', 'phân bón', 'Using too much chemical ______ can wash into streams and pollute water.'],\n      ['herbivore', 'động vật ăn cỏ', 'A giraffe is a peaceful ______ that feeds on high acacia leaves.'],\n      ['predator', 'động vật săn mồi', 'Owls are skilled nocturnal ______ that hunt mice in the dark.'],\n      ['essential', 'thiết yếu, cực kỳ quan trọng', 'Clean oceans are ______ for regulating Earth’s temperature and oxygen.'],\n      ['fauna', 'hệ động vật', 'National parks help conserve both rare plants and native ______.'],\n      ['flora', 'hệ thực vật', 'Warm tropical islands support rich ______ with thousands of orchids.'],\n    ],\n    grammar: [\n      ['The Amazon Rainforest, ______ produces vast amounts of oxygen, is called Earth’s lungs.', ['that', 'which', 'who', 'what'], 1, 'Mệnh đề quan hệ KHÔNG xác định (có dấu phẩy) không dùng \"that\" -> dùng \"which\".'],\n      ['Dr. Jane Goodall, ______ studied wild chimpanzees for decades, inspires young scientists.', ['that', 'which', 'who', 'whom'], 2, 'Sau dấu phẩy thay cho người làm chủ ngữ dùng \"who\" (không dùng that).'],\n      ['Phong Nha – Ke Bang, ______ boasts ancient limestone caves, is a World Heritage Site.', ['which', 'that', 'where', 'who'], 0, 'Có dấu phẩy + làm chủ ngữ chỉ nơi/vật -> dùng \"which\".'],\n      ['The saola, ______ horns are long and straight, is an extremely rare mammal.', ['which', 'that', 'whose', 'who'], 2, 'Sở hữu (\"sừng của loài sao la\") -> \"whose\".'],\n      ['Polar bears live in the Arctic, ______ thick sea ice is melting rapidly.', ['which', 'where', 'that', 'when'], 1, 'Thay cho trạng từ chỉ nơi chốn (\"ở Bắc Cực\") sau dấu phẩy -> \"where\".'],\n      ['Earth Day, ______ falls on April 22nd, encourages millions to plant trees.', ['that', 'which', 'when', 'who'], 1, 'Thay cho tên sự kiện làm chủ ngữ sau dấu phẩy -> \"which\".'],\n      ['My uncle, ______ works as a marine biologist, gave our class a talk on sea turtles.', ['who', 'that', 'which', 'whose'], 0, 'Chỉ người sau dấu phẩy -> \"who\".'],\n      ['Cuc Phuong National Park, ______ we visited last spring, is famous for thousand-year trees.', ['that', 'which', 'where', 'who'], 1, 'Làm tân ngữ của động từ \"visited\" -> \"which\" (visited + gì -> visited which).'],\n      ['Greenland, ______ is the world’s largest island, is mostly covered in ice.', ['that', 'which', 'where', 'what'], 1, 'Mệnh đề không xác định không được dùng \"that\" -> \"which\".'],\n      ['Choose the sentence with a CORRECT non-defining relative clause:', ['My bike, that is blue, is eco-friendly.', 'My bike, which is blue, is eco-friendly.', 'My bike which is blue, is eco-friendly.', 'My bike, who is blue, is eco-friendly.'], 1, 'Mệnh đề không xác định dùng dấu phẩy hai bên và dùng \"which\" (không dùng \"that\").'],\n      ['Mount Fansipan, ______ height reaches 3,147 metres, attracts thousands of trekkers.', ['which', 'whose', 'that', 'where'], 1, 'Chỉ sở hữu (\"chiều cao của đỉnh Fansipan\") -> \"whose\".'],\n      ['Spring, ______ flowers bloom across the hills, is my favourite season.', ['which', 'that', 'when', 'where'], 2, 'Sau dấu phẩy chỉ thời gian (\"vào mùa xuân\") -> \"when\".'],\n      ['Sea otters, ______ eat sea urchins, help protect underwater kelp forests.', ['that', 'which', 'who', 'whose'], 1, 'Chỉ loài vật sau dấu phẩy -> \"which\".'],\n      ['Ha Long Bay, ______ attracts tourists worldwide, has nearly 2,000 limestone islets.', ['which', 'that', 'where', 'what'], 0, 'Làm chủ ngữ -> \"which\".'],\n      ['Our Biology teacher, ______ garden grows 40 herbs, taught us about food webs.', ['who', 'which', 'whose', 'that'], 2, 'Sở hữu (\"khu vườn của cô giáo\") -> \"whose\".'],\n      ['Global warming harms coral reefs, ______ rely on cool clean ocean water.', ['that', 'which', 'where', 'who'], 1, 'Sau dấu phẩy thay cho vật -> \"which\".'],\n      ['The Mekong Delta, ______ rice fields feed millions, needs careful water management.', ['which', 'that', 'whose', 'where'], 2, 'Sở hữu (\"cánh đồng của ĐBSCL\") -> \"whose\".'],\n      ['Ms. Lan, ______ we met at the eco-conference, runs a recycling project.', ['who', 'that', 'which', 'whose'], 0, 'Thay cho người sau dấu phẩy (who/whom đều đúng, \"that\" sai).'],\n      ['The Sun, ______ light powers plants on Earth, is at the centre of our solar system.', ['which', 'that', 'whose', 'who'], 2, 'Sở hữu (\"ánh sáng của Mặt Trời\") -> \"whose\".'],\n      ['In November, ______ strong winds arrive, migratory birds reach Tram Chim.', ['which', 'when', 'where', 'that'], 1, 'Thời gian sau dấu phẩy -> \"when\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 11,\n    title: 'Electronic Devices',\n    grammarFocus: 'suggest / advise / recommend + V-ing or (that) S + (should) + V',\n    vocab: [\n      ['touchscreen', 'màn hình cảm ứng', 'You can zoom in on maps simply by tapping the tablet’s ______.'],\n      ['portable', 'gọn nhẹ, dễ mang theo', 'A lightweight e-reader is much more ______ than carrying ten heavy textbooks.'],\n      ['camcorder', 'máy quay phim cầm tay', 'Dad used a small ______ to record our family’s holiday adventures.'],\n      ['cardboard', 'vật liệu các-tông', 'Fold a simple ______ VR viewer to experience 3D space videos.'],\n      ['rubber', 'cao su', 'This tablet has a protective ______ case so it won’t break if dropped.'],\n      ['steel', 'thép', 'Modern laptops often use recycled aluminium or ______ frames for strength.'],\n      ['smartwatch', 'đồng hồ thông minh', 'A ______ counts your daily steps and reminds you to drink water.'],\n      ['wireless earbuds', 'tai nghe không dây nhét tai', 'Use ______ to listen to English podcasts clearly while walking.'],\n      ['styluses', 'bút cảm ứng', 'Digital artists use precision ______ to sketch smooth illustrations on tablets.'],\n      ['virtual', 'ảo (kỹ thuật số)', 'With VR headsets, students can take a ______ tour inside ancient pyramids.'],\n    ],\n    grammar: [\n      ['The shop assistant suggested ______ a protective glass screen for the tablet.', ['buy', 'buying', 'to buy', 'bought'], 1, 'Cấu trúc \"suggest + V-ing\" (khi không có mệnh đề that) -> \"buying\".'],\n      ['I recommend that you ______ back up your photos before resetting the phone.', ['should', 'backing', 'to back', 'had'], 0, 'Mệnh đề sau \"recommend that + S + (should) + V nguyên mẫu\".'],\n      ['Doctors advise ______ off bright screens 30 minutes before bedtime.', ['turn', 'to turn', 'turning', 'turned'], 2, 'Khi không có tân ngữ người, \"advise + V-ing\" -> \"turning\".'],\n      ['My cousin advised me ______ a laptop with a long-lasting battery.', ['choose', 'choosing', 'to choose', 'chose'], 2, 'Khi có tân ngữ (\"me\"), cấu trúc là \"advise sb + to V\" -> \"to choose\".'],\n      ['She suggested that Nam ______ a digital voice recorder for interviews.', ['uses', 'using', 'use', 'to use'], 2, 'Cấu trúc giả định sau \"suggest that + S + (should) + V nguyên mẫu\" -> \"use\" (không thêm -s!).'],\n      ['We recommend ______ e-books to save paper and backpack space.', ['read', 'reading', 'to read', 'reads'], 1, '\"recommend + V-ing\" -> \"reading\".'],\n      ['The teacher suggested that we ______ a study timer app to avoid distractions.', ['use', 'using', 'to use', 'used to'], 0, '\"suggest that + we + (should) + V nguyên mẫu\" -> \"use\".'],\n      ['I advise you not ______ strangers your device password.', ['tell', 'telling', 'to tell', 'told'], 2, '\"advise sb not + to V\" -> \"to tell\".'],\n      ['Dad suggested ______ the old tablet rather than buying a brand-new one.', ['repair', 'repairing', 'to repair', 'repaired'], 1, '\"suggest + V-ing\" -> \"repairing\".'],\n      ['The technician recommended that the battery ______ replaced soon.', ['is', 'be', 'was', 'being'], 1, 'Thức giả định bị động: \"recommend that + S + (should) be + V3\" -> \"be\".'],\n      ['Why don’t we ask Minh? He suggested ______ wireless headphones last week.', ['try', 'trying', 'to try', 'tried'], 1, '\"suggest + V-ing\" -> \"trying\".'],\n      ['Our eye doctor advised us ______ the 20-20-20 rule while using computers.', ['follow', 'following', 'to follow', 'followed'], 2, '\"advise + us + to follow\".'],\n      ['I recommend that Mai ______ a light portable charger for the field trip.', ['pack', 'packs', 'packing', 'to pack'], 0, 'Sau \"recommend that Mai\" dùng động từ nguyên mẫu \"pack\".'],\n      ['The guide suggested ______ early in the morning to film the sunrise.', ['go', 'going', 'to go', 'went'], 1, '\"suggest + V-ing\" -> \"going\".'],\n      ['Experts advise ______ old batteries at special e-waste recycling points.', ['drop', 'dropping', 'to drop', 'dropped'], 1, 'Không có tân ngữ người -> \"advise + V-ing\" -> \"dropping\".'],\n      ['Tom recommended that his sister ______ a sturdy rubber case for her e-reader.', ['get', 'gets', 'getting', 'to get'], 0, 'Giả định sau \"recommend that\" -> động từ nguyên mẫu \"get\".'],\n      ['What did the IT teacher suggest ______ to keep laptops cool?', ['do', 'doing', 'to do', 'did'], 1, '\"suggest + V-ing\" -> \"doing\".'],\n      ['My friend advised me ______ my smartwatch during swimming.', ['wear', 'wearing', 'to wear', 'wore'], 2, '\"advise me + to V\" -> \"to wear\".'],\n      ['We suggest that every student ______ an offline dictionary installed.', ['has', 'have', 'having', 'to have'], 1, 'Giả định với \"every student\" vẫn dùng nguyên mẫu \"have\" (không dùng has!).'],\n      ['The brochure recommends ______ the camera lens gently with a microfibre cloth.', ['clean', 'cleaning', 'to clean', 'cleaned'], 1, '\"recommend + V-ing\" -> \"cleaning\".'],\n    ],\n  },\n  {\n    grade: 9,\n    unit: 12,\n    title: 'Career Choices',\n    grammarFocus: 'Adverbial clauses of concession, result, and reason',\n    vocab: [\n      ['software engineer', 'kỹ sư phần mềm', 'If you love coding and solving logic puzzles, becoming a ______ is ideal.'],\n      ['fashion designer', 'nhà thiết kế thời trang', 'A ______ sketches outfits and selects fabrics for seasonal shows.'],\n      ['bartender / barista', 'nhân viên pha chế', 'A friendly ______ prepares lattes and artistic drinks at a café.'],\n      ['mechanic', 'thợ sửa máy / ô tô', 'When an engine makes a strange noise, a skilled ______ checks and fixes it.'],\n      ['surgeon', 'bác sĩ phẫu thuật', 'A hospital ______ must have steady hands and deep medical knowledge.'],\n      ['vocational', 'hướng nghiệp / dạy nghề', 'Some teenagers attend a ______ college to master baking or carpentry quickly.'],\n      ['hands-on', 'thực hành thực tế', 'Cooking and robotics clubs give students valuable ______ experience.'],\n      ['academic', 'học thuật, lý thuyết', 'Universities focus strongly on ______ research and theoretical subjects.'],\n      ['rewarding', 'bổ ích, xứng đáng', 'Teaching young children to read is a deeply ______ career.'],\n      ['repetitive', 'lặp đi lặp lại nhàm chán', 'Assembly-line factory tasks can feel quite ______ after many hours.'],\n    ],\n    grammar: [\n      ['______ the job requires long training, she still dreams of becoming a pilot.', ['Although', 'Because', 'So', 'Since'], 0, 'Mệnh đề nhượng bộ (Mặc dù... nhưng vẫn...) dùng \"Although\".'],\n      ['He is ______ a creative chef that guests travel from far away for his food.', ['so', 'such', 'because', 'though'], 1, 'Cấu trúc chỉ kết quả với cụm danh từ: \"such + a/an + adj + N + that...\".'],\n      ['The career workshop was ______ helpful that every student took detailed notes.', ['so', 'such', 'although', 'since'], 0, 'Cấu trúc chỉ kết quả với tính từ đứng một mình: \"so + adj + that...\".'],\n      ['______ Mai loves working with animals, she plans to study veterinary science.', ['Although', 'Since', 'Though', 'So'], 1, 'Mệnh đề chỉ nguyên nhân (\"Bởi vì Mai yêu động vật\") -> \"Since\".'],\n      ['Though working as a firefighter is risky, it is ______ rewarding.', ['extreme', 'extremely', 'so that', 'such'], 1, 'Trạng từ \"extremely\" bổ nghĩa cho tính từ \"rewarding\".'],\n      ['They organised a school career fair ______ students could meet professionals.', ['so that', 'because', 'although', 'such that'], 0, 'Mệnh đề chỉ mục đích (\"để mà...\") dùng \"so that\".'],\n      ['______ of his strong communication skills, Nam made a great team presenter.', ['Because', 'Although', 'Despite', 'Since'], 0, '\"Because of + cụm danh từ\" (Bởi vì kỹ năng giao tiếp tốt).'],\n      ['______ having only two weeks to prepare, the students nailed their mock interviews.', ['Although', 'Despite', 'Because', 'Since'], 1, '\"Despite + V-ing\" (Mặc dù chỉ có hai tuần).'],\n      ['She practised coding ______ hard that she built her first mobile app at 15.', ['so', 'such', 'too', 'very'], 0, 'Cấu trúc \"so + adv + that\".'],\n      ['He chose a vocational course ______ he wanted to gain hands-on skills early.', ['although', 'because', 'so that', 'unless'], 1, 'Giải thích lý do -> \"because\".'],\n      ['It was ______ an inspiring speech by the astronaut that everyone applauded.', ['so', 'such', 'very', 'too'], 1, '\"such + a/an + adj + N + that\" -> \"such\".'],\n      ['______ being tired after the shift, the nurse smiled warmly at every patient.', ['Although', 'Though', 'In spite of', 'Because of'], 2, '\"In spite of + V-ing\" = Mặc dù.'],\n      ['We couldn’t interview the mechanic ______ he was busy repairing a bus.', ['as', 'although', 'so', 'such'], 0, '\"as\" = bởi vì (tương đương because/since).'],\n      ['The software engineer explained the code ______ clearly that beginners understood it.', ['such', 'so', 'very', 'enough'], 1, '\"so + adv + that\".'],\n      ['Although the pastry course ______ expensive, Lan’s parents supported her passion.', ['is', 'was', 'were', 'be'], 1, 'Đồng bộ thì quá khứ với \"supported\" -> \"was\".'],\n      ['There were ______ many visitors at the job fair that the hall filled up fast.', ['such', 'so', 'too', 'very'], 1, 'Trước \"many/much/few/little + N\" luôn dùng \"so... that\" -> \"so\".'],\n      ['Since my brother ______ fluent in Japanese, he works as a tour guide for Japanese groups.', ['is', 'are', 'were', 'be'], 0, 'Hiện tại đơn với \"my brother\" -> \"is\".'],\n      ['Even though the hours are long, doctors continue serving ______ they care about patients.', ['because', 'although', 'so', 'unless'], 0, 'Chỉ lý do -> \"because\".'],\n      ['They gave us ______ practical advice that we felt confident before the interview.', ['so', 'such', 'too', 'many'], 1, '\"advice\" không đếm được -> \"such + adj + N(không đếm được) + that\".'],\n      ['______ you decide on a career, explore your strengths and hobbies carefully.', ['Before', 'Although', 'Because of', 'Such'], 0, 'Mệnh đề thời gian khuyên nhủ -> \"Before\".'],\n    ],\n  },\n];\n"},{"path":"src/game/game.js","encoding":"utf8","content":"/**\n * ============================================================================\n * B2KS 3D GAME CONTROLLER (Tap-to-move, Isometric Camera, Input Routing)\n * ============================================================================\n * File này kết nối logic game B2KS với hệ thống đồ họa 3D (scene3d.js):\n * - Tap-to-move: chạm trực tiếp lên mặt đất 3D để nhân vật tự đi tới\n * - Điều khiển hướng chuẩn góc nhìn Isometric (WASD / Phím mũi tên / Joystick ảo)\n * - Thao tác vuốt/kéo để xoay hoặc lia camera, chụm ngón tay / cuộn chuột để zoom\n */\n\nimport { createScene3D } from './scene3d.js';\nimport { STREET_WORLD } from './constants.ts';\n\nfunction clamp(val, min, max) {\n  return Math.max(min, Math.min(max, val));\n}\n\nexport function createB2KS3DController({ canvasEl, labelLayerEl, isUnlocked, onZoomSync, onCameraModeSync }) {\n  let scene3d = null;\n  let tapTarget = null;\n  let sceneBounds = { minX: 40, maxX: STREET_WORLD.width - 40, minY: 265, maxY: STREET_WORLD.height - 40 };\n\n  const activePointers = new Map();\n  let tapCandidate = null;\n  let lastPointer = null;\n  let pinchStartDist = 0;\n  let pinchStartZoom = 1.0;\n\n  // Khởi tạo Three.js 3D Engine (qua CDN importmap)\n  createScene3D(canvasEl)\n    .then((inst) => {\n      scene3d = inst;\n      scene3d.resize();\n      if (onZoomSync) onZoomSync(scene3d.camState.targetZoom);\n      if (onCameraModeSync) onCameraModeSync(scene3d.getCameraMode());\n    })\n    .catch((err) => {\n      console.error('[B2KS 3D] Không thể khởi tạo WebGL 3D:', err);\n    });\n\n  // Ngăn menu chuột phải mặc định trên canvas để chuột phải kéo lia camera mượt hơn\n  canvasEl.addEventListener('contextmenu', (e) => {\n    e.preventDefault();\n  });\n\n  // Cuộn chuột để Zoom\n  canvasEl.addEventListener(\n    'wheel',\n    (e) => {\n      if (!scene3d || !isUnlocked()) return;\n      e.preventDefault();\n      const nextZoom = clamp(scene3d.camState.targetZoom - e.deltaY * 0.0012, 0.55, 2.2);\n      scene3d.setZoom(nextZoom);\n      if (onZoomSync) onZoomSync(nextZoom);\n    },\n    { passive: false }\n  );\n\n  // Chạm / Nhấn chuột: Tap-to-move & Vuốt xoay/lia Camera & Pinch Zoom\n  canvasEl.addEventListener('pointerdown', (e) => {\n    if (!isUnlocked()) return;\n    if (typeof window.startAudioOnce === 'function') window.startAudioOnce();\n    try {\n      canvasEl.setPointerCapture(e.pointerId);\n    } catch {\n      // ignore if synthetic event\n    }\n    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });\n\n    if (activePointers.size === 1) {\n      tapCandidate = {\n        id: e.pointerId,\n        startX: e.clientX,\n        startY: e.clientY,\n        moved: false,\n        button: e.button,\n      };\n      lastPointer = { x: e.clientX, y: e.clientY };\n    } else if (activePointers.size === 2 && scene3d) {\n      tapCandidate = null;\n      const pts = Array.from(activePointers.values());\n      pinchStartDist = Math.max(10, Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y));\n      pinchStartZoom = scene3d.camState.targetZoom;\n      lastPointer = {\n        x: (pts[0].x + pts[1].x) * 0.5,\n        y: (pts[0].y + pts[1].y) * 0.5,\n      };\n    }\n  });\n\n  canvasEl.addEventListener('pointermove', (e) => {\n    if (!activePointers.has(e.pointerId)) return;\n    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });\n    if (!scene3d || !isUnlocked()) return;\n\n    if (activePointers.size === 2) {\n      const pts = Array.from(activePointers.values());\n      const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);\n      const midX = (pts[0].x + pts[1].x) * 0.5;\n      const midY = (pts[0].y + pts[1].y) * 0.5;\n\n      const nextZoom = clamp(pinchStartZoom * (dist / pinchStartDist), 0.55, 2.2);\n      scene3d.setZoom(nextZoom);\n      if (onZoomSync) onZoomSync(nextZoom);\n\n      if (lastPointer) {\n        const dx = midX - lastPointer.x;\n        const dy = midY - lastPointer.y;\n        panCameraByScreenDelta(dx, dy);\n      }\n      lastPointer = { x: midX, y: midY };\n      return;\n    }\n\n    if (activePointers.size === 1 && lastPointer) {\n      const dx = e.clientX - lastPointer.x;\n      const dy = e.clientY - lastPointer.y;\n      if (tapCandidate && Math.hypot(e.clientX - tapCandidate.startX, e.clientY - tapCandidate.startY) > 8) {\n        tapCandidate.moved = true;\n      }\n\n      if ((tapCandidate && tapCandidate.moved) || (e.buttons & 2) !== 0) {\n        if ((e.buttons & 2) !== 0 || e.shiftKey) {\n          // Chuột phải hoặc giữ Shift: lia (pan) camera trên mặt đất\n          panCameraByScreenDelta(dx, dy);\n        } else {\n          // Kéo 1 ngón hoặc chuột trái: xoay góc nhìn quanh nhân vật\n          scene3d.camState.targetYaw -= dx * 0.007;\n          const minPitch = scene3d.camState.mode === 'perspective' ? 0.24 : 0.42;\n          scene3d.camState.targetPitch = clamp(scene3d.camState.targetPitch + dy * 0.005, minPitch, 1.15);\n        }\n      }\n      lastPointer = { x: e.clientX, y: e.clientY };\n    }\n  });\n\n  function finishPointer(e, allowTap) {\n    activePointers.delete(e.pointerId);\n    if (allowTap && activePointers.size === 0 && tapCandidate && !tapCandidate.moved && tapCandidate.button !== 2) {\n      if (scene3d && isUnlocked()) {\n        const hit = scene3d.raycastGround(e.clientX, e.clientY);\n        if (hit) {\n          tapTarget = {\n            x: clamp(hit.x2d, sceneBounds.minX, sceneBounds.maxX),\n            y: clamp(hit.y2d, sceneBounds.minY, sceneBounds.maxY),\n          };\n        }\n      }\n    }\n    if (activePointers.size === 1) {\n      const rem = Array.from(activePointers.values())[0];\n      lastPointer = { x: rem.x, y: rem.y };\n      tapCandidate = null;\n    } else if (activePointers.size === 0) {\n      lastPointer = null;\n      tapCandidate = null;\n    }\n  }\n\n  canvasEl.addEventListener('pointerup', (e) => finishPointer(e, true));\n  canvasEl.addEventListener('pointercancel', (e) => finishPointer(e, false));\n\n  function panCameraByScreenDelta(dx, dy) {\n    if (!scene3d) return;\n    const yaw = scene3d.camState.yaw;\n    const scale = 0.05 / Math.max(0.5, scene3d.camState.zoom);\n    const sx = -dx * scale;\n    const sy = -dy * scale;\n    const worldDX = sx * Math.cos(yaw) + sy * Math.sin(yaw);\n    const worldDZ = -sx * Math.sin(yaw) + sy * Math.cos(yaw);\n    scene3d.camState.panX = clamp(scene3d.camState.panX + worldDX, -45, 45);\n    scene3d.camState.panZ = clamp(scene3d.camState.panZ + worldDZ, -45, 45);\n  }\n\n  function updateSceneBounds(sceneName, houseHeight) {\n    if (sceneName === 'neighborhood') {\n      sceneBounds = { minX: 40, maxX: STREET_WORLD.width - 40, minY: 265, maxY: STREET_WORLD.height - 40 };\n    } else if (sceneName === 'private_room') {\n      sceneBounds = { minX: 12, maxX: 748, minY: 16, maxY: 406 };\n    } else {\n      sceneBounds = { minX: 100, maxX: 1020, minY: 110, maxY: (houseHeight || 800) - 55 };\n    }\n  }\n\n  /**\n   * Tính vector di chuyển chuẩn theo góc camera Isometric hiện tại + hỗ trợ Tap-to-move\n   */\n  function computeInputVector({ keys, joyActive, joyVector, me, speed, sceneName, houseHeight }) {\n    updateSceneBounds(sceneName, houseHeight);\n\n    let sx = 0;\n    let sy = 0;\n    if (keys['arrowup'] || keys['w']) sy -= 1;\n    if (keys['arrowdown'] || keys['s']) sy += 1;\n    if (keys['arrowleft'] || keys['a']) sx -= 1;\n    if (keys['arrowright'] || keys['d']) sx += 1;\n    if (joyActive) {\n      sx = joyVector.x;\n      sy = joyVector.y;\n    }\n\n    const inputLen = Math.hypot(sx, sy);\n    if (inputLen > 0.05) {\n      tapTarget = null; // Ưu tiên phím điều hướng / joystick nếu người chơi đang nhấn\n      if (inputLen > 1) {\n        sx /= inputLen;\n        sy /= inputLen;\n      }\n      const yaw = scene3d ? scene3d.camState.yaw : Math.PI / 4;\n      const dx = sx * Math.cos(yaw) + sy * Math.sin(yaw);\n      const dy = -sx * Math.sin(yaw) + sy * Math.cos(yaw);\n      return { dx, dy, moving: true, viaTap: false };\n    }\n\n    if (tapTarget) {\n      const dx = tapTarget.x - me.x;\n      const dy = tapTarget.y - me.y;\n      const dist = Math.hypot(dx, dy);\n      if (dist <= Math.max(8, speed * 1.8)) {\n        tapTarget = null;\n        return { dx: 0, dy: 0, moving: false, viaTap: false };\n      }\n      return { dx: dx / dist, dy: dy / dist, moving: true, viaTap: true };\n    }\n\n    return { dx: 0, dy: 0, moving: false, viaTap: false };\n  }\n\n  return {\n    computeInputVector,\n    clearTapTarget() {\n      tapTarget = null;\n    },\n    setZoom(nextZoom) {\n      if (!scene3d) return nextZoom;\n      scene3d.setZoom(nextZoom);\n      return scene3d.camState.targetZoom;\n    },\n    getZoom() {\n      return scene3d ? scene3d.camState.targetZoom : 1.0;\n    },\n    getCamYaw() {\n      return scene3d ? scene3d.camState.yaw : Math.PI / 4;\n    },\n    getCameraMode() {\n      return scene3d ? scene3d.getCameraMode() : 'ortho';\n    },\n    setCameraMode(mode) {\n      if (!scene3d) return 'ortho';\n      const next = scene3d.setCameraMode(mode);\n      if (onCameraModeSync) onCameraModeSync(next);\n      return next;\n    },\n    toggleCameraMode() {\n      if (!scene3d) return 'ortho';\n      const next = scene3d.toggleCameraMode();\n      if (onCameraModeSync) onCameraModeSync(next);\n      return next;\n    },\n    resetCamera() {\n      if (scene3d) scene3d.resetCamera();\n    },\n    onResize() {\n      if (scene3d) scene3d.resize();\n    },\n    render(renderParams) {\n      if (!scene3d) return;\n      scene3d.renderFrame({\n        ...renderParams,\n        tapTarget,\n        labelLayerEl,\n      });\n    },\n    dispose() {\n      if (scene3d) scene3d.dispose();\n    },\n  };\n}\n"},{"path":"src/game/inventionLab.ts","encoding":"utf8","content":"import { CustomLabItem, LabItemSpec } from '../types/b2ks';\n\nexport type LabSizeTier = 'small' | 'medium' | 'large' | 'giant';\n\nexport const LAB_SIZE_TIERS: Record<LabSizeTier, { label: string; scale: number; badge: string }> = {\n  small: { label: 'Nhỏ (Mini)', scale: 0.72, badge: '🔹 Nhỏ' },\n  medium: { label: 'Vừa (Chuẩn)', scale: 1.0, badge: '🔸 Vừa' },\n  large: { label: 'Lớn', scale: 1.38, badge: '🔶 Lớn' },\n  giant: { label: 'Khổng Lồ', scale: 1.75, badge: '💥 Khổng Lồ' }\n};\n\nexport const RANDOM_LAB_IDEAS = [\n  'a giant golden sports car with two rainbow wings',\n  'a small galaxy pencil with two angel wings',\n  'a huge cyber robot dinosaur with laser crown',\n  'a giant rainbow unicorn castle with glowing stars',\n  'a medium crystal volcano guitar with fire flames',\n  'a large neon submarine with two dragon wings',\n  'a small cute penguin wearing sunglasses on a skateboard',\n  'a giant fire phoenix trophy with golden halo',\n  'a large sakura dragon piano with musical bubbles',\n  'a mini pastel spaceship donut with star sprinkles',\n  'a huge steampunk train with spinning propeller',\n  'a small emerald frog wearing a royal crown'\n];\n\nfunction hashString(str: string): number {\n  let h = 2166136261;\n  for (let i = 0; i < str.length; i++) {\n    h ^= str.charCodeAt(i);\n    h = Math.imul(h, 16777619);\n  }\n  return h >>> 0;\n}\n\nconst ENGLISH_LEXICON = new Set([\n  'a','an','the','with','and','of','in','on','for','to','shaped','like','made','from','that','can','has','have','filled','wearing','holding','carrying','riding',\n  'one','two','three','four','five','pair','twin','double','big','small','tiny','mini','little','medium','normal','large','huge','giant','mega','enormous','colossal',\n  'cute','cool','super','magic','magical','flying','swimming','glowing','shiny','rainbow','sports','fast','turbo',\n  'golden','gold','silver','crystal','wooden','wood','metal','robot','cyber','neon','galaxy','cosmic','space','star','stars',\n  'moon','sun','fire','flame','flames','lava','volcano','ice','frost','frosty','water','ocean','emerald','ruby','sakura','pastel','candy','lightning','electric',\n  'red','blue','green','yellow','pink','purple','orange','black','white','brown','colorful','steampunk',\n  'pencil','pen','marker','eraser','ruler','notebook','backpack','bag','camera','headphones','headset','glasses','sunglasses','umbrella','key','trophy','medal','kite',\n  'bicycle','bike','scooter','skateboard','car','supercar','vehicle','bus','truck','train','motorbike','motorcycle','boat','ship','submarine','plane','airplane','jet','helicopter','rocket','ufo','drone','satellite',\n  'soccer','football','basketball','ball','sphere','orb','planet','saturn',\n  'table','desk','chair','sofa','throne','bed','lamp','lantern','candle','clock','watch','book','bookshelf','box','chest','gift','present','house','treehouse','castle','tent',\n  'guitar','piano','drum','microscope','telescope','compass','potion','sword','shield','wand','crown','bow','hammer','axe','helmet','mirror',\n  'fish','shark','whale','dolphin','octopus','crab','cat','dog','puppy','kitten','bear','panda','rabbit','bunny','fox','penguin','bird','owl','eagle','phoenix','dragon','unicorn','bee','ghost','snowman',\n  'butterfly','turtle','frog','lion','tiger','dinosaur','dino','alien',\n  'cupcake','cake','pancake','icecream','pizza','burger','donut','doughnut','lollipop','watermelon','apple','strawberry','pineapple','teapot','mug','cup','sushi',\n  'mushroom','flower','rose','sunflower','tree','cloud','diamond','gem','heart',\n  'wings','wing','feather','feathers','tail','legs','eyes','wheels','wheel','flowers','bubbles','pearls','gears','antenna','halo','horns','propeller','cape','booster','boosters'\n]);\n\nexport function isValidEnglishLabPrompt(raw: string): { ok: boolean; reason?: string; words?: string[] } {\n  const cleaned = (raw || '').trim();\n  if (!cleaned) return { ok: false, reason: '⚠️ Bạn chưa nhập dòng lệnh mô tả Tiếng Anh!' };\n  if (/[àáạảãâầấậẩẫăằắặẳẵèéẹẻẽêềếệểễìíịỉĩòóọỏõôồốộổỗơờớợởỡùúụủũưừứựửữỳýỵỷỹđ]/i.test(cleaned)) {\n    return { ok: false, reason: '🇬🇧 Vui lòng nhập mô tả hoàn toàn bằng Tiếng Anh (không dùng dấu tiếng Việt)!' };\n  }\n  const words = cleaned.toLowerCase().match(/[a-z]{2,}/g) || [];\n  if (words.length < 2) {\n    return { ok: false, reason: '✍️ Hãy viết ít nhất 2 từ Tiếng Anh mô tả vật phẩm (ví dụ: \"a pencil with two wings\")!' };\n  }\n  const vowelWords = words.filter((w) => /[aeiouy]/.test(w));\n  if (vowelWords.length < 2) {\n    return { ok: false, reason: '🔤 Dòng lệnh chưa đúng từ vựng Tiếng Anh hợp lệ. Hãy thử lại nhé!' };\n  }\n  const known = words.filter((w) => ENGLISH_LEXICON.has(w)).length;\n  if (known === 0 && words.length < 3) {\n    return { ok: false, reason: '💡 Hãy dùng các từ Tiếng Anh mô tả đồ vật hoặc đặc tính (ví dụ: golden pencil, galaxy bicycle, flying ball...)' };\n  }\n  return { ok: true, words };\n}\n\nexport const SHAPE_LIBRARY: { keys: string[]; shape: string }[] = [\n  { keys: ['pencil', 'pen', 'crayon', 'marker'], shape: 'pencil' },\n  { keys: ['bicycle', 'bike', 'cycle', 'tricycle'], shape: 'bicycle' },\n  { keys: ['motorcycle', 'motorbike'], shape: 'motorbike' },\n  { keys: ['car', 'supercar', 'vehicle', 'taxi', 'racecar'], shape: 'car' },\n  { keys: ['truck', 'bus', 'van'], shape: 'truck' },\n  { keys: ['train', 'locomotive', 'subway'], shape: 'train' },\n  { keys: ['soccer', 'football', 'basketball', 'ball', 'orb', 'sphere'], shape: 'ball' },\n  { keys: ['skateboard', 'surfboard', 'hoverboard', 'scooter'], shape: 'skateboard' },\n  { keys: ['unicorn', 'pegasus'], shape: 'unicorn' },\n  { keys: ['dinosaur', 'dino', 'trex', 'raptor'], shape: 'dino' },\n  { keys: ['octopus', 'squid'], shape: 'octopus' },\n  { keys: ['ufo', 'saucer', 'alien', 'spaceship'], shape: 'ufo' },\n  { keys: ['planet', 'saturn'], shape: 'planet' },\n  { keys: ['submarine'], shape: 'submarine' },\n  { keys: ['airplane', 'plane', 'jet'], shape: 'plane' },\n  { keys: ['helicopter', 'chopper', 'drone'], shape: 'helicopter' },\n  { keys: ['ship', 'boat', 'yacht', 'pirate'], shape: 'ship' },\n  { keys: ['guitar', 'violin', 'ukulele'], shape: 'guitar' },\n  { keys: ['piano', 'keyboard', 'organ'], shape: 'piano' },\n  { keys: ['drum'], shape: 'drum' },\n  { keys: ['telescope', 'microscope'], shape: 'telescope' },\n  { keys: ['camera', 'photo'], shape: 'camera' },\n  { keys: ['headphones', 'headset', 'earphones'], shape: 'headphones' },\n  { keys: ['umbrella', 'parasol'], shape: 'umbrella' },\n  { keys: ['backpack', 'bag', 'rucksack'], shape: 'backpack' },\n  { keys: ['shoe', 'sneaker', 'boot'], shape: 'shoe' },\n  { keys: ['trophy', 'cup', 'goblet'], shape: 'trophy' },\n  { keys: ['gift', 'present'], shape: 'gift' },\n  { keys: ['key'], shape: 'key' },\n  { keys: ['kite'], shape: 'kite' },\n  { keys: ['lantern'], shape: 'lantern' },\n  { keys: ['candle'], shape: 'candle' },\n  { keys: ['mug', 'teapot'], shape: 'mug' },\n  { keys: ['pizza'], shape: 'pizza' },\n  { keys: ['burger', 'hamburger', 'sandwich'], shape: 'burger' },\n  { keys: ['donut', 'doughnut'], shape: 'donut' },\n  { keys: ['lollipop', 'candy'], shape: 'lollipop' },\n  { keys: ['watermelon', 'melon'], shape: 'watermelon' },\n  { keys: ['strawberry', 'apple', 'pineapple', 'fruit'], shape: 'apple' },\n  { keys: ['cupcake', 'cake', 'pancake', 'icecream', 'dessert'], shape: 'cake' },\n  { keys: ['mushroom', 'toadstool'], shape: 'mushroom' },\n  { keys: ['flower', 'rose', 'sunflower', 'sakura', 'lotus'], shape: 'flower' },\n  { keys: ['cloud'], shape: 'cloud' },\n  { keys: ['sun'], shape: 'sun' },\n  { keys: ['moon', 'crescent'], shape: 'moon' },\n  { keys: ['star'], shape: 'star' },\n  { keys: ['heart'], shape: 'heart' },\n  { keys: ['diamond', 'gem', 'jewel', 'crystal'], shape: 'diamond' },\n  { keys: ['lightning', 'thunder', 'bolt'], shape: 'lightning' },\n  { keys: ['rainbow'], shape: 'rainbow' },\n  { keys: ['snowman'], shape: 'snowman' },\n  { keys: ['ghost', 'spirit'], shape: 'ghost' },\n  { keys: ['bee', 'bumblebee'], shape: 'bee' },\n  { keys: ['frog', 'turtle'], shape: 'frog' },\n  { keys: ['penguin'], shape: 'penguin' },\n  { keys: ['bunny', 'rabbit'], shape: 'bunny' },\n  { keys: ['fox'], shape: 'fox' },\n  { keys: ['panda', 'bear'], shape: 'panda' },\n  { keys: ['chest', 'treasure', 'box'], shape: 'chest' },\n  { keys: ['potion', 'flask', 'bottle'], shape: 'potion' },\n  { keys: ['wand'], shape: 'wand' },\n  { keys: ['sword', 'blade', 'hammer', 'axe'], shape: 'sword' },\n  { keys: ['shield'], shape: 'shield' },\n  { keys: ['volcano', 'mountain'], shape: 'volcano' },\n  { keys: ['treehouse', 'tree', 'plant'], shape: 'treehouse' },\n  { keys: ['robot', 'mech', 'bot'], shape: 'robot' },\n  { keys: ['phoenix'], shape: 'phoenix' },\n  { keys: ['owl', 'bird', 'eagle'], shape: 'bird' },\n  { keys: ['butterfly', 'dragonfly'], shape: 'butterfly' },\n  { keys: ['whale', 'dolphin', 'shark', 'fish'], shape: 'fish' },\n  { keys: ['throne', 'chair', 'sofa'], shape: 'throne' },\n  { keys: ['clock', 'watch', 'gear', 'compass'], shape: 'clock' },\n  { keys: ['crown', 'tiara'], shape: 'crown' },\n  { keys: ['table', 'desk'], shape: 'table' },\n  { keys: ['cat', 'kitten', 'dog', 'puppy', 'lion', 'tiger'], shape: 'cat' },\n  { keys: ['rocket'], shape: 'rocket' },\n  { keys: ['lamp', 'light'], shape: 'lamp' },\n  { keys: ['dragon'], shape: 'dragon' },\n  { keys: ['castle', 'tower', 'house'], shape: 'castle' },\n  { keys: ['bookshelf', 'shelf', 'book', 'notebook'], shape: 'book' }\n];\n\nfunction matchShapeList(text: string): string[] {\n  if (!text) return [];\n  const results: string[] = [];\n  for (const entry of SHAPE_LIBRARY) {\n    const hit = entry.keys.some((k) => new RegExp(`\\\\b${k}(?:s|es)?\\\\b`, 'i').test(text));\n    if (hit && !results.includes(entry.shape)) {\n      results.push(entry.shape);\n    }\n  }\n  return results;\n}\n\nexport const MATERIAL_PALETTES = [\n  { keys: ['galaxy', 'cosmic', 'space', 'nebula', 'night'], material: 'galaxy', hex: '#4F46E5', accent: '#38BDF8', rarity: 'Vũ Trụ' },\n  { keys: ['rainbow', 'colorful', 'prism'], material: 'rainbow', hex: '#EC4899', accent: '#FACC15', isRainbow: true, rarity: 'Cầu Vồng' },\n  { keys: ['fire', 'lava', 'volcano', 'phoenix', 'flame'], material: 'fire', hex: '#DC2626', accent: '#FBBF24', rarity: 'Rực Lửa' },\n  { keys: ['ice', 'frost', 'frosty', 'snow', 'arctic'], material: 'ice', hex: '#0EA5E9', accent: '#E0F2FE', rarity: 'Băng Giá' },\n  { keys: ['cyber', 'neon', 'laser', 'electric', 'lightning'], material: 'cyber', hex: '#06B6D4', accent: '#F43F5E', rarity: 'Công Nghệ' },\n  { keys: ['gold', 'golden', 'royal', 'treasure'], material: 'gold', hex: '#D97706', accent: '#FEF08A', rarity: 'Hoàng Gia' },\n  { keys: ['emerald', 'forest', 'wood', 'wooden', 'nature', 'green'], material: 'nature', hex: '#16A34A', accent: '#BBF7D0', rarity: 'Thiên Nhiên' },\n  { keys: ['sakura', 'candy', 'strawberry', 'pink', 'cute', 'pastel'], material: 'candy', hex: '#EC4899', accent: '#FBCFE8', rarity: 'Ngọt Ngào' },\n  { keys: ['purple', 'magic', 'magical', 'crystal', 'potion'], material: 'crystal', hex: '#7C3AED', accent: '#DDD6FE', rarity: 'Pha Lê' },\n  { keys: ['blue', 'ocean', 'water', 'marine', 'sky'], material: 'ocean', hex: '#0284C7', accent: '#BAE6FD', rarity: 'Đại Dương' },\n  { keys: ['red', 'ruby'], material: 'ruby', hex: '#E11D48', accent: '#FECDD3', rarity: 'Hồng Ngọc' },\n  { keys: ['yellow', 'sunny', 'sun'], material: 'sun', hex: '#EAB308', accent: '#FEF08A', rarity: 'Ánh Dương' },\n  { keys: ['orange', 'tiger', 'sunset'], material: 'sunset', hex: '#EA580C', accent: '#FED7AA', rarity: 'Hoàng Hôn' },\n  { keys: ['silver', 'metal', 'steampunk', 'robot'], material: 'metal', hex: '#64748B', accent: '#E2E8F0', rarity: 'Cơ Khí' }\n];\n\nconst FALLBACK_COLORS = [\n  { hex: '#0EA5E9', accent: '#BAE6FD' },\n  { hex: '#8B5CF6', accent: '#DDD6FE' },\n  { hex: '#10B981', accent: '#A7F3D0' },\n  { hex: '#F59E0B', accent: '#FEF08A' },\n  { hex: '#EF4444', accent: '#FECACA' },\n  { hex: '#EC4899', accent: '#FBCFE8' },\n  { hex: '#14B8A6', accent: '#99F6E4' }\n];\n\nexport function parsePromptToLabSpec(\n  promptText: string,\n  itemAId: string | null = null,\n  itemBId: string | null = null,\n  resolveShapeFn?: (id: string) => string | null,\n  sizeOverride?: 'auto' | 'small' | 'medium' | 'large' | 'giant'\n): LabItemSpec {\n  const lower = String(promptText || '').toLowerCase();\n  const seed = hashString(`${lower}|${itemAId || ''}|${itemBId || ''}`);\n\n  const mat = MATERIAL_PALETTES.find((m) => m.keys.some((k) => new RegExp(`\\\\b${k}\\\\b`, 'i').test(lower)));\n  const fallbackCol = FALLBACK_COLORS[seed % FALLBACK_COLORS.length];\n\n  const splitMatch = lower.split(/\\b(?:with|having|wearing|holding|carrying|riding|on|inside|made\\s+of|filled\\s+with)\\b/i);\n  const headPhrase = splitMatch[0] || lower;\n  const modPhrase = splitMatch.slice(1).join(' ');\n\n  const headShapes = matchShapeList(headPhrase);\n  const modShapes = matchShapeList(modPhrase);\n  const allShapes = [...headShapes, ...modShapes.filter((s) => !headShapes.includes(s))];\n\n  let primaryShape = headShapes[0] || allShapes[0] || SHAPE_LIBRARY[seed % SHAPE_LIBRARY.length].shape;\n  let secondaryTrait: string | null = allShapes.find((s) => s !== primaryShape) || null;\n\n  if (itemAId && resolveShapeFn) {\n    const shA = resolveShapeFn(itemAId);\n    if (shA) primaryShape = shA;\n  }\n  if (itemBId && resolveShapeFn) {\n    const shB = resolveShapeFn(itemBId);\n    if (shB) secondaryTrait = shB;\n  }\n\n  let sizeTier: 'small' | 'medium' | 'large' | 'giant' = 'medium';\n  if (sizeOverride && sizeOverride !== 'auto') {\n    sizeTier = sizeOverride;\n  } else if (/\\b(giant|mega|colossal|enormous|jumbo)\\b/i.test(lower)) {\n    sizeTier = 'giant';\n  } else if (/\\b(big|large|huge|tall|long)\\b/i.test(lower)) {\n    sizeTier = 'large';\n  } else if (/\\b(tiny|mini|small|little|pocket)\\b/i.test(lower)) {\n    sizeTier = 'small';\n  }\n  const sizeScale = LAB_SIZE_TIERS[sizeTier].scale;\n\n  let wingStyle: LabItemSpec['wingStyle'] = 'feather';\n  if (/\\b(dragon|bat)\\b/i.test(lower)) wingStyle = 'dragon';\n  else if (/\\b(angel|heavenly)\\b/i.test(lower)) wingStyle = 'angel';\n  else if (/\\b(butterfly|fairy)\\b/i.test(lower)) wingStyle = 'butterfly';\n  else if (/\\b(cyber|robot|laser|jet|mech|rocket)\\b/i.test(lower)) wingStyle = 'cyber';\n\n  const wingCount: 2 | 4 = /\\b(four|4)\\s+wings?\\b/i.test(lower) ? 4 : 2;\n  const patterns = ['dots', 'stripes', 'runes', 'circuit', 'sparkles'];\n\n  return {\n    primaryShape,\n    secondaryTrait,\n    color: mat ? mat.hex : fallbackCol.hex,\n    accent: mat ? mat.accent : fallbackCol.accent,\n    isRainbow: Boolean(mat?.isRainbow),\n    material: mat ? mat.material : 'crystal',\n    rarity: mat ? mat.rarity : 'Độc Bản',\n    pattern: patterns[seed % patterns.length],\n    seed,\n    sizeTier,\n    sizeScale,\n    wingCount,\n    wingStyle,\n    hasWings: /\\b(wings?|winged|flying|fly|angel|pegasus|feather|feathers)\\b/i.test(lower),\n    hasWheels: /\\b(wheels?|rolling)\\b/i.test(lower) || (secondaryTrait === 'skateboard' && primaryShape !== 'skateboard'),\n    hasLegs: /\\b(legs?|walk|walking)\\b/i.test(lower) || secondaryTrait === 'table',\n    hasFishTail: /\\b(mermaid|swim|swimming|fins?|fishtail)\\b/i.test(lower) || (secondaryTrait === 'fish' && primaryShape !== 'fish'),\n    hasCrown: /\\b(crown|tiara|king|queen|royal|princess|prince)\\b/i.test(lower) && primaryShape !== 'crown',\n    hasHalo: /\\b(halo|angel|heavenly|holy)\\b/i.test(lower),\n    hasFire: /\\b(fire|flame|flames|lava|blazing|rocket|turbo|booster|boosters)\\b/i.test(lower) && primaryShape !== 'rocket',\n    hasExhaust: /\\b(turbo|rocket|booster|boosters|fast|racecar|supercar)\\b/i.test(lower),\n    hasHeadlights: /\\b(glowing|light|lights|headlights|car|train|truck)\\b/i.test(lower),\n    hasPropeller: /\\b(propeller|spinning|chopper)\\b/i.test(lower),\n    hasCape: /\\b(cape|hero|superhero)\\b/i.test(lower),\n    hasBubbles: /\\b(bubbles?|ocean|water|pearls?|musical)\\b/i.test(lower),\n    hasGlasses: /\\b(glasses|sunglasses|cool)\\b/i.test(lower),\n    hasAntenna: /\\b(antenna|cyber|robot|alien)\\b/i.test(lower) && primaryShape !== 'robot',\n    hasStars: /\\b(stars?|magic|magical|glow|glowing|crystal|rainbow|galaxy|cosmic|space|neon|laser)\\b/i.test(lower)\n  };\n}\n\nexport function buildLabSVGMarkup(spec: Lab