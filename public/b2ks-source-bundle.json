1=\"32\" y1=\"10\" x2=\"32\" y2=\"46\" stroke=\"#E2E8F0\" stroke-width=\"0.9\"/>\n      <line x1=\"33.4\" y1=\"10\" x2=\"33.4\" y2=\"46\" stroke=\"#E2E8F0\" stroke-width=\"0.9\"/>\n    </svg>`;\n  }\n  if (itemId === 'd_aquarium') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <defs>\n        <linearGradient id=\"aq_water\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#BAE6FD\"/><stop offset=\"100%\" stop-color=\"#38BDF8\"/></linearGradient>\n      </defs>\n      <ellipse cx=\"32\" cy=\"58\" rx=\"22\" ry=\"3\" fill=\"#0F172A\" opacity=\"0.18\"/>\n      <rect x=\"11\" y=\"38\" width=\"42\" height=\"17\" rx=\"2\" fill=\"#78350F\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n      <rect x=\"14\" y=\"41\" width=\"17\" height=\"12\" rx=\"1\" fill=\"#92400E\" stroke=\"#451A03\" stroke-width=\"1\"/>\n      <rect x=\"33\" y=\"41\" width=\"17\" height=\"12\" rx=\"1\" fill=\"#92400E\" stroke=\"#451A03\" stroke-width=\"1\"/>\n      <circle cx=\"29\" cy=\"47\" r=\"1.2\" fill=\"#FACC15\"/><circle cx=\"35\" cy=\"47\" r=\"1.2\" fill=\"#FACC15\"/>\n      <rect x=\"12\" y=\"13\" width=\"40\" height=\"25\" rx=\"2\" fill=\"url(#aq_water)\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <rect x=\"11\" y=\"10\" width=\"42\" height=\"4.5\" rx=\"1.5\" fill=\"#0F172A\"/>\n      <rect x=\"13\" y=\"34\" width=\"38\" height=\"3\" fill=\"#FDE68A\"/>\n      <path d=\"M18 35 Q20 26 17 20 M45 35 Q43 25 46 19\" stroke=\"#16A34A\" stroke-width=\"2.8\" fill=\"none\" stroke-linecap=\"round\"/>\n      <ellipse cx=\"29\" cy=\"25\" rx=\"6.5\" ry=\"3.8\" fill=\"#FB923C\" stroke=\"#1E293B\" stroke-width=\"1.3\"/>\n      <polygon points=\"35,25 40,21.5 40,28.5\" fill=\"#FB923C\" stroke=\"#1E293B\" stroke-width=\"1.3\"/>\n      <circle cx=\"25\" cy=\"24\" r=\"1\" fill=\"#0F172A\"/>\n      <ellipse cx=\"39\" cy=\"30\" rx=\"4.5\" ry=\"2.6\" fill=\"#FACC15\" stroke=\"#1E293B\" stroke-width=\"1.1\"/>\n      <circle cx=\"21\" cy=\"18\" r=\"1.6\" fill=\"#FFF\" opacity=\"0.85\"/><circle cx=\"24\" cy=\"21\" r=\"1.2\" fill=\"#FFF\" opacity=\"0.85\"/>\n    </svg>`;\n  }\n  if (itemId === 'tv_30min') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <rect x=\"22\" y=\"49\" width=\"20\" height=\"5\" rx=\"2\" fill=\"#334155\" stroke=\"#1E293B\" stroke-width=\"1.6\"/>\n      <rect x=\"9\" y=\"14\" width=\"46\" height=\"33\" rx=\"6\" fill=\"#FFFFFF\" stroke=\"#1E293B\" stroke-width=\"2.1\"/>\n      <rect x=\"15\" y=\"20\" width=\"34\" height=\"21\" rx=\"6\" fill=\"#EF4444\" stroke=\"#991B1B\" stroke-width=\"1.5\"/>\n      <polygon points=\"28,25 28,36 39,30.5\" fill=\"#FFFFFF\"/>\n    </svg>`;\n  }\n  if (itemId === 'v_icecream') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <polygon points=\"23,32 41,32 32,57\" fill=\"#D97706\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <circle cx=\"32\" cy=\"27\" r=\"11\" fill=\"#F9A8D4\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n      <circle cx=\"32\" cy=\"16\" r=\"8.5\" fill=\"#FEF08A\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n      <circle cx=\"32\" cy=\"8\" r=\"3.5\" fill=\"#EF4444\" stroke=\"#1E293B\" stroke-width=\"1.3\"/>\n    </svg>`;\n  }\n  if (itemId === 'v_movie') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <rect x=\"12\" y=\"24\" width=\"40\" height=\"28\" rx=\"4\" fill=\"#1E293B\" stroke=\"#0F172A\" stroke-width=\"2\"/>\n      <polygon points=\"12,24 52,16 50,10 10,18\" fill=\"#F8FAFC\" stroke=\"#0F172A\" stroke-width=\"1.8\"/>\n      <rect x=\"20\" y=\"32\" width=\"24\" height=\"14\" rx=\"2\" fill=\"#FACC15\" stroke=\"#1E293B\" stroke-width=\"1.4\"/>\n    </svg>`;\n  }\n  if (itemId === 'v_game') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <path d=\"M16 24 L48 24 Q55 34 52 46 Q46 50 41 41 L23 41 Q18 50 12 46 Q9 34 16 24 Z\" fill=\"#334155\" stroke=\"#0F172A\" stroke-width=\"2.1\"/>\n      <rect x=\"18\" y=\"30\" width=\"8\" height=\"3\" fill=\"#F8FAFC\"/><rect x=\"20.5\" y=\"27.5\" width=\"3\" height=\"8\" fill=\"#F8FAFC\"/>\n      <circle cx=\"43\" cy=\"29\" r=\"2.2\" fill=\"#22C55E\"/><circle cx=\"47\" cy=\"33\" r=\"2.2\" fill=\"#EF4444\"/><circle cx=\"39\" cy=\"33\" r=\"2.2\" fill=\"#38BDF8\"/><circle cx=\"43\" cy=\"37\" r=\"2.2\" fill=\"#FACC15\"/>\n    </svg>`;\n  }\n  if (itemId === 'v_dish') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <ellipse cx=\"32\" cy=\"46\" rx=\"22\" ry=\"6\" fill=\"#F8FAFC\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <path d=\"M14 43 A18 18 0 0 1 50 43 Z\" fill=\"#CBD5E1\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <circle cx=\"32\" cy=\"22\" r=\"4\" fill=\"#FACC15\" stroke=\"#1E293B\" stroke-width=\"1.6\"/>\n    </svg>`;\n  }\n  if (itemId === 'food_biscuit') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <circle cx=\"16\" cy=\"26\" r=\"6\" fill=\"#D97706\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n      <circle cx=\"16\" cy=\"38\" r=\"6\" fill=\"#D97706\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n      <circle cx=\"48\" cy=\"26\" r=\"6\" fill=\"#D97706\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n      <circle cx=\"48\" cy=\"38\" r=\"6\" fill=\"#D97706\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n      <rect x=\"16\" y=\"27\" width=\"32\" height=\"10\" fill=\"#F59E0B\" stroke=\"#1E293B\" stroke-width=\"1.8\"/>\n    </svg>`;\n  }\n  if (itemId === 'food_berry') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <path d=\"M32 19 Q46 18 46 32 Q45 49 32 54 Q19 49 18 32 Q18 18 32 19 Z\" fill=\"#E11D48\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <polygon points=\"22,19 28,11 32,17 36,11 42,19\" fill=\"#16A34A\" stroke=\"#1E293B\" stroke-width=\"1.6\"/>\n      <circle cx=\"27\" cy=\"30\" r=\"1.4\" fill=\"#FDE047\"/><circle cx=\"36\" cy=\"32\" r=\"1.4\" fill=\"#FDE047\"/><circle cx=\"31\" cy=\"40\" r=\"1.4\" fill=\"#FDE047\"/>\n    </svg>`;\n  }\n  if (itemId === 'food_star_candy') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <polygon points=\"32,10 38,24 53,26 42,36 45,51 32,44 19,51 22,36 11,26 26,24\" fill=\"#FACC15\" stroke=\"#1E293B\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n      <circle cx=\"32\" cy=\"32\" r=\"5\" fill=\"#FEF08A\"/>\n    </svg>`;\n  }\n  if (itemId === 'pacc_bow') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <polygon points=\"32,32 12,18 12,46\" fill=\"#EC4899\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <polygon points=\"32,32 52,18 52,46\" fill=\"#EC4899\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <circle cx=\"32\" cy=\"32\" r=\"6\" fill=\"#F472B6\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n    </svg>`;\n  }\n  if (itemId === 'pacc_bell') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <ellipse cx=\"32\" cy=\"22\" rx=\"18\" ry=\"6\" fill=\"none\" stroke=\"#EF4444\" stroke-width=\"6\"/>\n      <circle cx=\"32\" cy=\"38\" r=\"11\" fill=\"#FACC15\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <circle cx=\"32\" cy=\"42\" r=\"3\" fill=\"#78350F\"/>\n    </svg>`;\n  }\n  if (itemId === 'pacc_glasses') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <rect x=\"10\" y=\"24\" width=\"18\" height=\"14\" rx=\"4\" fill=\"#0F172A\" stroke=\"#FACC15\" stroke-width=\"2\"/>\n      <rect x=\"36\" y=\"24\" width=\"18\" height=\"14\" rx=\"4\" fill=\"#0F172A\" stroke=\"#FACC15\" stroke-width=\"2\"/>\n      <line x1=\"28\" y1=\"30\" x2=\"36\" y2=\"30\" stroke=\"#FACC15\" stroke-width=\"3\"/>\n    </svg>`;\n  }\n  if (itemId === 'pacc_scarf') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <rect x=\"14\" y=\"20\" width=\"36\" height=\"14\" rx=\"7\" fill=\"#EF4444\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <rect x=\"34\" y=\"28\" width=\"11\" height=\"24\" rx=\"4\" fill=\"#DC2626\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n    </svg>`;\n  }\n  if (itemId === 'pacc_wizard') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <polygon points=\"32,10 18,44 46,44\" fill=\"#4F46E5\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <ellipse cx=\"32\" cy=\"46\" rx=\"22\" ry=\"6\" fill=\"#4338CA\" stroke=\"#1E293B\" stroke-width=\"2\"/>\n      <polygon points=\"32,23 34,28 39,28 35,31 36,36 32,33 28,36 29,31 25,28 30,28\" fill=\"#FACC15\"/>\n    </svg>`;\n  }\n  if (itemId === 'pacc_crown') {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\">\n      <polygon points=\"12,46 16,20 26,32 32,16 38,32 48,20 52,46\" fill=\"#FACC15\" stroke=\"#1E293B\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/>\n      <circle cx=\"32\" cy=\"36\" r=\"3.5\" fill=\"#EF4444\"/>\n    </svg>`;\n  }\n\n  const item = findCatalogItem(itemId);\n  if (item && item.svgMarkup) {\n    return `<svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 64 64\" style=\"overflow:visible;\">${item.svgMarkup}</svg>`;\n  }\n  return `<div style=\"font-size:${Math.round(size * 0.65)}px; line-height:${size}px; text-align:center;\">${item ? item.icon : '📦'}</div>`;\n}\n"},{"path":"src/game/weatherService.ts","encoding":"utf8","content":"import { WeatherCondition, WeatherInfo } from '../types/b2ks';\n\nconst WEATHER_CACHE_KEY = 'b2ks_weather_cache_v1';\nconst WEATHER_COORDS_KEY = 'b2ks_weather_coords_v1';\nconst CACHE_TTL_MS = 15 * 60 * 1000;\n\ninterface CoordsCache {\n  lat: number;\n  lon: number;\n  label: string;\n  isGeo?: boolean;\n  ts: number;\n}\n\nfunction getDefaultCoordsByTimezone(): CoordsCache {\n  try {\n    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';\n    if (tz.includes('Tokyo') || tz.includes('Japan')) {\n      return { lat: 35.6762, lon: 139.6503, label: 'Tokyo', ts: 0 };\n    }\n    if (tz.includes('Seoul')) {\n      return { lat: 37.5665, lon: 126.978, label: 'Seoul', ts: 0 };\n    }\n    if (tz.includes('Singapore')) {\n      return { lat: 1.3521, lon: 103.8198, label: 'Singapore', ts: 0 };\n    }\n    if (tz.includes('Bangkok')) {\n      return { lat: 13.7563, lon: 100.5018, label: 'Bangkok', ts: 0 };\n    }\n    if (tz.includes('London')) {\n      return { lat: 51.5072, lon: -0.1276, label: 'London', ts: 0 };\n    }\n    if (tz.includes('America/Los_Angeles')) {\n      return { lat: 37.7749, lon: -122.4194, label: 'California', ts: 0 };\n    }\n    if (tz.includes('America/New_York')) {\n      return { lat: 40.7128, lon: -74.006, label: 'New York', ts: 0 };\n    }\n  } catch {\n    // ignore timezone detection error\n  }\n  return { lat: 10.8231, lon: 106.6297, label: 'TP.HCM', ts: 0 };\n}\n\nexport function mapWmoCodeToWeather(\n  code: number,\n  isDay: boolean\n): { condition: WeatherCondition; label: string; icon: string } {\n  if (code === 0) {\n    return {\n      condition: 'clear',\n      label: isDay ? 'Nắng đẹp' : 'Trời quang',\n      icon: isDay ? '☀️' : '🌙',\n    };\n  }\n  if (code === 1 || code === 2) {\n    return {\n      condition: 'cloudy',\n      label: isDay ? 'Nắng nhẹ, ít mây' : 'Ít mây',\n      icon: isDay ? '🌤️' : '☁️',\n    };\n  }\n  if (code === 3) {\n    return {\n      condition: 'cloudy',\n      label: 'Nhiều mây',\n      icon: '☁️',\n    };\n  }\n  if (code === 45 || code === 48) {\n    return {\n      condition: 'fog',\n      label: 'Sương mù',\n      icon: '🌫️',\n    };\n  }\n  if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) {\n    return {\n      condition: 'rain',\n      label: code >= 63 || code >= 81 ? 'Mưa rào' : 'Mưa nhẹ',\n      icon: '🌧️',\n    };\n  }\n  if ((code >= 71 && code <= 77) || code === 85 || code === 86) {\n    return {\n      condition: 'snow',\n      label: 'Tuyết rơi',\n      icon: '❄️',\n    };\n  }\n  if (code >= 95) {\n    return {\n      condition: 'thunder',\n      label: 'Mưa dông',\n      icon: '⛈️',\n    };\n  }\n  return {\n    condition: 'clear',\n    label: isDay ? 'Nắng đẹp' : 'Trời quang',\n    icon: isDay ? '☀️' : '🌙',\n  };\n}\n\nexport function getCachedWeatherInfo(): WeatherInfo {\n  try {\n    const raw = localStorage.getItem(WEATHER_CACHE_KEY);\n    if (raw) {\n      const parsed = JSON.parse(raw) as WeatherInfo;\n      if (parsed && typeof parsed.tempC === 'number' && parsed.condition) {\n        return parsed;\n      }\n    }\n  } catch {\n    // ignore corrupt cache\n  }\n  const h = new Date().getHours();\n  const isDay = h >= 6 && h < 18;\n  return {\n    condition: 'clear',\n    label: isDay ? 'Nắng đẹp' : 'Trời quang',\n    icon: isDay ? '☀️' : '🌙',\n    tempC: 29,\n    windKmh: 8,\n    locationLabel: getDefaultCoordsByTimezone().label,\n    isDay,\n    updatedAt: 0,\n  };\n}\n\nasync function getSavedOrGeoCoords(requestGeo: boolean): Promise<CoordsCache> {\n  if (requestGeo && typeof navigator !== 'undefined' && navigator.geolocation) {\n    const geoCoords = await new Promise<CoordsCache | null>((resolve) => {\n      navigator.geolocation.getCurrentPosition(\n        (pos) => {\n          resolve({\n            lat: Number(pos.coords.latitude.toFixed(4)),\n            lon: Number(pos.coords.longitude.toFixed(4)),\n            label: 'Vị trí của bạn',\n            isGeo: true,\n            ts: Date.now(),\n          });\n        },\n        () => resolve(null),\n        { timeout: 4500, maximumAge: 600000 }\n      );\n    });\n    if (geoCoords) {\n      try {\n        localStorage.setItem(WEATHER_COORDS_KEY, JSON.stringify(geoCoords));\n      } catch {\n        // ignore\n      }\n      return geoCoords;\n    }\n  }\n\n  try {\n    const raw = localStorage.getItem(WEATHER_COORDS_KEY);\n    if (raw) {\n      const parsed = JSON.parse(raw) as CoordsCache;\n      if (parsed && typeof parsed.lat === 'number' && typeof parsed.lon === 'number') {\n        return parsed;\n      }\n    }\n  } catch {\n    // ignore\n  }\n  return getDefaultCoordsByTimezone();\n}\n\nexport async function fetchLiveWeatherInfo(force = false, requestGeo = false): Promise<WeatherInfo> {\n  const cached = getCachedWeatherInfo();\n  if (!force && !requestGeo && cached.updatedAt > 0 && Date.now() - cached.updatedAt < CACHE_TTL_MS) {\n    return cached;\n  }\n\n  const coords = await getSavedOrGeoCoords(requestGeo);\n  try {\n    const url = `https://api.open-meteo.com/v1/forecast?latitude=${coords.lat}&longitude=${coords.lon}&current=temperature_2m,weather_code,is_day,wind_speed_10m&timezone=auto`;\n    const res = await fetch(url, { cache: 'no-store' });\n    if (!res.ok) return cached;\n    const data = (await res.json()) as {\n      current?: {\n        temperature_2m?: number;\n        weather_code?: number;\n        is_day?: number;\n        wind_speed_10m?: number;\n      };\n    };\n    const cur = data?.current;\n    if (!cur) return cached;\n\n    const isDay = cur.is_day === 1;\n    const code = Number(cur.weather_code ?? 0);\n    const mapped = mapWmoCodeToWeather(code, isDay);\n    const nextWeather: WeatherInfo = {\n      condition: mapped.condition,\n      label: mapped.label,\n      icon: mapped.icon,\n      tempC: Math.round(Number(cur.temperature_2m ?? 28)),\n      windKmh: Math.round(Number(cur.wind_speed_10m ?? 6)),\n      locationLabel: coords.label,\n      isDay,\n      updatedAt: Date.now(),\n    };\n    try {\n      localStorage.setItem(WEATHER_CACHE_KEY, JSON.stringify(nextWeather));\n    } catch {\n      // ignore\n    }\n    return nextWeather;\n  } catch {\n    return cached;\n  }\n}\n"},{"path":"src/game/worldRenderer.ts","encoding":"utf8","content":"import { B2KSState, BuildingShape, Member, NavDestination, SoccerOnlineRoom, WeatherInfo } from '../types/b2ks';\nimport {\n  formatFamilyBrand,\n  HOUSE_WORLD,\n  PLOTS,\n  PRIVATE_ROOM_WORLD,\n  resolveNeighborhoodLocations,\n  ROOM_DECOR_SLOTS,\n  STREET_WORLD\n} from './constants';\nimport { drawProceduralLabItemOnCanvas } from './inventionLab';\n\nexport interface LightingInfo {\n  phase: 'dawn' | 'day' | 'sunset' | 'night';\n  label: string;\n  skyTop: string;\n  skyBottom: string;\n  overlayAlpha: number;\n  overlayColor: string;\n  isNight: boolean;\n}\n\nexport type StreetVehicleKind = 'car' | 'moto' | 'bus' | 'truck' | 'bike';\n\nexport interface StreetCar {\n  axis: 'h' | 'v';\n  x: number;\n  y: number;\n  speed: number;\n  color: string;\n  dir: number;\n  kind?: StreetVehicleKind;\n}\n\nexport interface HouseRoomDef {\n  id: string;\n  name: string;\n  x: number;\n  y: number;\n  w: number;\n  h: number;\n  wall: string;\n  floor: string;\n  ownerIds: string[];\n  isUnlocked: boolean;\n  isDisabled?: boolean;\n  doorSide: 'left' | 'right';\n  wardrobe: { x: number; y: number } | null;\n}\n\nexport function drawSpeechBubble(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  text: string,\n  isEng: boolean\n) {\n  ctx.save();\n  ctx.font = 'bold 12px Fredoka, sans-serif';\n  const displayTxt = isEng ? `${text} (+5⭐)` : text;\n  const maxW = 200;\n  const words = displayTxt.split(' ');\n  const lines: string[] = [];\n  let curLine = '';\n  words.forEach((w) => {\n    const test = curLine ? curLine + ' ' + w : w;\n    if (ctx.measureText(test).width > maxW) {\n      if (curLine) lines.push(curLine);\n      curLine = w;\n    } else {\n      curLine = test;\n    }\n  });\n  if (curLine) lines.push(curLine);\n\n  const boxW = Math.min(maxW + 20, Math.max(70, ...lines.map((l) => ctx.measureText(l).width + 20)));\n  const boxH = lines.length * 16 + 12;\n  const bx = x - boxW / 2;\n  const by = y - boxH;\n\n  ctx.fillStyle = isEng ? '#D4EDDA' : '#FFFFFF';\n  ctx.strokeStyle = isEng ? '#28A745' : '#2C3E50';\n  ctx.lineWidth = 3;\n  ctx.beginPath();\n  ctx.roundRect(bx, by, boxW, boxH, 10);\n  ctx.fill();\n  ctx.stroke();\n\n  ctx.beginPath();\n  ctx.moveTo(x - 6, y);\n  ctx.lineTo(x + 6, y);\n  ctx.lineTo(x, y + 7);\n  ctx.closePath();\n  ctx.fill();\n  ctx.stroke();\n\n  ctx.fillStyle = '#2C3E50';\n  ctx.textAlign = 'center';\n  lines.forEach((line, idx) => {\n    ctx.fillText(line, x, by + 16 + idx * 16);\n  });\n  ctx.restore();\n}\n\nexport function drawDetailedChibiOnContext(\n  c: CanvasRenderingContext2D,\n  member: Partial<Member> & { x: number; y: number; name: string },\n  isMe: boolean,\n  scale = 1,\n  isMainCanvas = false,\n  isMovingNow = false\n) {\n  c.save();\n  c.translate(member.x, member.y);\n  c.scale(scale, scale);\n\n  const now = Date.now();\n  const isMoving = isMainCanvas && isMovingNow;\n  const phase = now / 78;\n  const walkCycle = isMoving ? Math.sin(phase) : 0;\n  const bob = isMoving ? -Math.abs(Math.sin(phase)) * 3.8 : Math.sin(now / 420) * 0.55;\n  const sway = isMoving ? Math.sin(phase) * 0.045 : 0;\n  const hairSway = isMoving ? Math.sin(phase + 0.6) * 2.2 : Math.sin(now / 520) * 0.6;\n  const isBlinking = isMainCanvas && ((now + member.name.length * 410) % 3400) > 3270;\n\n  const isAdult =\n    member.role === 'Bố' ||\n    member.role === 'Mẹ' ||\n    member.id === 'dad' ||\n    member.id === 'mom';\n  const legBonus = isAdult ? 6 : 0;\n  const torsoBonus = isAdult ? 6 : 0;\n  const upperShift = legBonus + torsoBonus;\n  const torsoHalfW = isAdult ? (member.role === 'Bố' || member.id === 'dad' ? 13 : 12) : 11.5;\n\n  c.lineWidth = 2.4;\n  c.strokeStyle = '#2C3E50';\n\n  // Pulsing ground shadow & subtle walk dust puffs\n  const shadowScale = isMoving ? 1 - Math.abs(bob) * 0.04 : 1;\n  c.fillStyle = 'rgba(0,0,0,0.24)';\n  c.beginPath();\n  c.ellipse(0, 27, (isAdult ? 17.5 : 16) * shadowScale, 6 * shadowScale, 0, 0, Math.PI * 2);\n  c.fill();\n\n  if (isMoving) {\n    const puff = (now % 260) / 260;\n    c.fillStyle = `rgba(255,255,255,${(0.45 * (1 - puff)).toFixed(2)})`;\n    c.beginPath();\n    c.arc(-walkCycle * 6, 26 - puff * 6, 3.2 * (1 - puff * 0.5), 0, Math.PI * 2);\n    c.fill();\n  }\n\n  const leftLegY = 14 + walkCycle * 4.5;\n  const rightLegY = 14 - walkCycle * 4.5;\n  const pStyle = member.pantsStyle || 'pants';\n\n  if (pStyle === 'skirt') {\n    c.fillStyle = '#FFE0BD';\n    c.beginPath(); c.roundRect(-8, leftLegY + 2 - legBonus * 0.4, 6.5, 8 + legBonus * 0.4, 2); c.fill(); c.stroke();\n    c.beginPath(); c.roundRect(1.5, rightLegY + 2 - legBonus * 0.4, 6.5, 8 + legBonus * 0.4, 2); c.fill(); c.stroke();\n    c.fillStyle = member.pantsColor || '#8E44AD';\n    c.beginPath();\n    c.moveTo(-11, 12 - legBonus + bob);\n    c.lineTo(11, 12 - legBonus + bob);\n    c.lineTo(15.5 + sway * 14, 21 - legBonus * 0.25 + bob);\n    c.lineTo(-15.5 + sway * 14, 21 - legBonus * 0.25 + bob);\n    c.closePath();\n    c.fill();\n    c.stroke();\n  } else if (pStyle === 'shorts') {\n    c.fillStyle = '#FFE0BD';\n    c.beginPath(); c.roundRect(-8.5, leftLegY + 3 - legBonus * 0.4, 7, 7 + legBonus * 0.4, 2); c.fill(); c.stroke();\n    c.beginPath(); c.roundRect(1.5, rightLegY + 3 - legBonus * 0.4, 7, 7 + legBonus * 0.4, 2); c.fill(); c.stroke();\n    c.fillStyle = member.pantsColor || '#117864';\n    c.beginPath(); c.roundRect(-10, 12 - legBonus + bob, 9, 7 + legBonus * 0.45, 2); c.fill(); c.stroke();\n    c.beginPath(); c.roundRect(1, 12 - legBonus + bob, 9, 7 + legBonus * 0.45, 2); c.fill(); c.stroke();\n  } else {\n    c.fillStyle = member.pantsColor || '#34495E';\n    c.beginPath(); c.roundRect(-9, leftLegY - legBonus, 7.5, 10 + legBonus, 2); c.fill(); c.stroke();\n    c.beginPath(); c.roundRect(1.5, rightLegY - legBonus, 7.5, 10 + legBonus, 2); c.fill(); c.stroke();\n  }\n\n  // Shoes\n  c.fillStyle = '#E74C3C';\n  c.beginPath(); c.roundRect(-10.5, leftLegY + 7, 9, 5, 2); c.fill(); c.stroke();\n  c.beginPath(); c.roundRect(1.5, rightLegY + 7, 9, 5, 2); c.fill(); c.stroke();\n  c.fillStyle = '#FFFFFF';\n  c.fillRect(-9.5, leftLegY + 10.5, 7, 1.5);\n  c.fillRect(2.5, rightLegY + 10.5, 7, 1.5);\n\n  // Subtle torso/head sway when walking\n  c.rotate(sway);\n\n  const armShiftX = isAdult ? 1.5 : 0;\n  const leftArmY = -2 - upperShift - walkCycle * 4.5;\n  const rightArmY = -2 - upperShift + walkCycle * 4.5;\n  c.fillStyle = member.shirtColor || '#3498DB';\n  c.beginPath(); c.roundRect(-16.5 - armShiftX, leftArmY + bob, 5.5, 8 + torsoBonus * 0.6, 2.5); c.fill(); c.stroke();\n  c.beginPath(); c.roundRect(11 + armShiftX, rightArmY + bob, 5.5, 8 + torsoBonus * 0.6, 2.5); c.fill(); c.stroke();\n  c.fillStyle = '#FFE0BD';\n  c.beginPath(); c.arc(-13.8 - armShiftX, leftArmY + 9 + torsoBonus * 0.6 + bob, 3, 0, Math.PI * 2); c.fill(); c.stroke();\n  c.beginPath(); c.arc(13.8 + armShiftX, rightArmY + 9 + torsoBonus * 0.6 + bob, 3, 0, Math.PI * 2); c.fill(); c.stroke();\n\n  // Torso highlight & depth\n  c.fillStyle = member.shirtColor || '#3498DB';\n  c.beginPath();\n  c.roundRect(-torsoHalfW, -3 - upperShift + bob, torsoHalfW * 2, 18 + torsoBonus, 5);\n  c.fill();\n  c.stroke();\n\n  c.fillStyle = 'rgba(255,255,255,0.16)';\n  c.beginPath();\n  c.roundRect(-torsoHalfW + 2, -1 - upperShift + bob, torsoHalfW * 2 - 4, 6, 3);\n  c.fill();\n\n  const dir = member.dir || 'down';\n  const pat = member.shirtPattern || 'collar';\n  if (dir !== 'up') {\n    if (pat === 'stripe') {\n      c.fillStyle = 'rgba(255,255,255,0.6)';\n      c.fillRect(-(torsoHalfW - 1.5), 4 - upperShift + torsoBonus * 0.35 + bob, (torsoHalfW - 1.5) * 2, 4);\n    } else if (pat === 'vest') {\n      c.fillStyle = '#FFFFFF';\n      c.beginPath();\n      c.moveTo(-4, -3 - upperShift + bob); c.lineTo(0, 7 - upperShift + torsoBonus * 0.4 + bob); c.lineTo(4, -3 - upperShift + bob);\n      c.closePath(); c.fill();\n    } else if (pat === 'star') {\n      c.fillStyle = '#FFE66D';\n      c.font = '10px Arial'; c.textAlign = 'center';\n      c.fillText('★', 0, 9 - upperShift + torsoBonus * 0.35 + bob);\n    } else if (pat === 'heart') {\n      c.fillStyle = '#FFCDD2';\n      c.font = '10px Arial'; c.textAlign = 'center';\n      c.fillText('♥', 0, 9 - upperShift + torsoBonus * 0.35 + bob);\n    } else {\n      c.fillStyle = '#FFFFFF';\n      c.beginPath();\n      c.moveTo(-5, -3 - upperShift + bob); c.lineTo(0, 2 - upperShift + bob); c.lineTo(5, -3 - upperShift + bob);\n      c.closePath(); c.fill();\n    }\n  }\n\n  // Back hair layer\n  const hColor = member.hairColor || '#2C3E50';\n  const hStyle = member.hairStyle || 'short';\n  const headBob = bob - upperShift;\n  c.fillStyle = hColor;\n  if (hStyle === 'long') {\n    c.beginPath();\n    c.roundRect(-19, -25 + headBob, 38, 32, 10);\n    c.fill(); c.stroke();\n  } else if (hStyle === 'wavy') {\n    c.beginPath();\n    c.moveTo(-18, -22 + headBob);\n    c.quadraticCurveTo(-23 + hairSway, -8 + headBob, -18, 8 + headBob);\n    c.lineTo(18, 8 + headBob);\n    c.quadraticCurveTo(23 + hairSway, -8 + headBob, 18, -22 + headBob);\n    c.closePath();\n    c.fill(); c.stroke();\n  } else if (hStyle === 'bob') {\n    c.beginPath();\n    c.roundRect(-19, -24 + headBob, 38, 22, 11);\n    c.fill(); c.stroke();\n  } else if (hStyle === 'curly') {\n    [[-16, -18], [16, -18], [-13, -29], [13, -29], [0, -33]].forEach(([cx, cy]) => {\n      c.beginPath();\n      c.arc(cx + hairSway * 0.3, cy + headBob, 8.5, 0, Math.PI * 2);\n      c.fill(); c.stroke();\n    });\n  } else if (hStyle === 'pigtails') {\n    c.beginPath();\n    c.arc(-19 + hairSway * 0.4, -18 + headBob, 7.8, 0, Math.PI * 2);\n    c.arc(19 + hairSway * 0.4, -18 + headBob, 7.8, 0, Math.PI * 2);\n    c.fill(); c.stroke();\n    c.fillStyle = '#FF6B6B';\n    c.beginPath();\n    c.arc(-14.5, -20 + headBob, 2.8, 0, Math.PI * 2);\n    c.arc(14.5, -20 + headBob, 2.8, 0, Math.PI * 2);\n    c.fill();\n  } else if (hStyle === 'ponytail') {\n    c.beginPath();\n    c.moveTo(4, -33 + headBob);\n    c.quadraticCurveTo(23 + hairSway, -34 + headBob, 22 + hairSway, -12 + headBob);\n    c.quadraticCurveTo(17 + hairSway, -6 + headBob, 14, -14 + headBob);\n    c.closePath();\n    c.fill(); c.stroke();\n    c.fillStyle = '#FACC15';\n    c.fillRect(0, -35 + headBob, 7, 4);\n  } else if (hStyle === 'bun') {\n    c.beginPath();\n    c.arc(-12, -33 + headBob, 7.5, 0, Math.PI * 2);\n    c.arc(12, -33 + headBob, 7.5, 0, Math.PI * 2);\n    c.fill(); c.stroke();\n    c.strokeStyle = '#EC4899';\n    c.lineWidth = 2.6;\n    c.beginPath();\n    c.moveTo(-15, -28 + headBob); c.lineTo(-8, -30 + headBob);\n    c.moveTo(8, -30 + headBob); c.lineTo(15, -28 + headBob);\n    c.stroke();\n    c.strokeStyle = '#2C3E50';\n    c.lineWidth = 2.4;\n  } else if (hStyle === 'braids') {\n    [[-16, -12, 4.4], [-17 + hairSway * 0.4, -4, 4], [-17.5 + hairSway * 0.6, 3, 3.4],\n     [16, -12, 4.4], [17 + hairSway * 0.4, -4, 4], [17.5 + hairSway * 0.6, 3, 3.4]].forEach(([bx, by, br]) => {\n      c.beginPath(); c.arc(bx, by + headBob, br, 0, Math.PI * 2); c.fill(); c.stroke();\n    });\n    c.fillStyle = '#38BDF8';\n    c.beginPath();\n    c.arc(-17 + hairSway * 0.5, 0 + headBob, 2.2, 0, Math.PI * 2);\n    c.arc(17 + hairSway * 0.5, 0 + headBob, 2.2, 0, Math.PI * 2);\n    c.fill();\n  }\n\n  // Side ears\n  if (dir === 'left' || dir === 'right') {\n    const earX = dir === 'left' ? 14.5 : -14.5;\n    c.fillStyle = '#FAD3A5';\n    c.beginPath();\n    c.arc(earX, -17 + headBob, 4.2, 0, Math.PI * 2);\n    c.fill(); c.stroke();\n  }\n\n  // Head\n  c.fillStyle = '#FFE0BD';\n  c.beginPath();\n  c.arc(0, -18 + headBob, 16.5, 0, Math.PI * 2);\n  c.fill();\n  c.stroke();\n\n  if (dir === 'up') {\n    // Full back-of-head hair silhouette when walking away\n    c.fillStyle = hColor;\n    c.beginPath();\n    c.arc(0, -18.5 + headBob, 17, 0, Math.PI * 2);\n    c.fill();\n    c.stroke();\n    if (hStyle === 'spiky') {\n      c.beginPath();\n      c.moveTo(-13, -29 + headBob); c.lineTo(-8, -39 + headBob); c.lineTo(-2, -32 + headBob);\n      c.lineTo(0, -42 + headBob); c.lineTo(3, -32 + headBob); c.lineTo(10, -39 + headBob);\n      c.lineTo(14, -29 + headBob); c.closePath(); c.fill(); c.stroke();\n    }\n    c.strokeStyle = 'rgba(255,255,255,0.28)';\n    c.lineWidth = 2;\n    c.beginPath();\n    c.arc(0, -21 + headBob, 11.5, 1.15 * Math.PI, 1.8 * Math.PI);\n    c.stroke();\n  } else {\n    let eyeOffsetX = 0;\n    if (dir === 'left') eyeOffsetX = -3.2;\n    if (dir === 'right') eyeOffsetX = 3.2;\n\n    // Eyebrows\n    c.strokeStyle = hColor;\n    c.lineWidth = 1.8;\n    c.beginPath();\n    c.moveTo(-8.5 + eyeOffsetX, -24 + headBob); c.lineTo(-4 + eyeOffsetX, -24.5 + headBob);\n    c.moveTo(4 + eyeOffsetX, -24.5 + headBob); c.lineTo(8.5 + eyeOffsetX, -24 + headBob);\n    c.stroke();\n\n    // Eyes (with blinking!)\n    if (isBlinking) {\n      c.strokeStyle = '#2C3E50';\n      c.lineWidth = 2;\n      c.beginPath();\n      c.moveTo(-9 + eyeOffsetX, -18.5 + headBob); c.lineTo(-3 + eyeOffsetX, -18.5 + headBob);\n      c.moveTo(3 + eyeOffsetX, -18.5 + headBob); c.lineTo(9 + eyeOffsetX, -18.5 + headBob);\n      c.stroke();\n    } else {\n      c.fillStyle = '#FFFFFF';\n      c.beginPath(); c.ellipse(-6 + eyeOffsetX, -18.5 + headBob, 3.2, 3.8, 0, 0, Math.PI * 2); c.fill();\n      c.beginPath(); c.ellipse(6 + eyeOffsetX, -18.5 + headBob, 3.2, 3.8, 0, 0, Math.PI * 2); c.fill();\n\n      c.fillStyle = '#2C3E50';\n      c.beginPath(); c.ellipse(-6 + eyeOffsetX, -18.5 + headBob, 2.3, 3, 0, 0, Math.PI * 2); c.fill();\n      c.beginPath(); c.ellipse(6 + eyeOffsetX, -18.5 + headBob, 2.3, 3, 0, 0, Math.PI * 2); c.fill();\n\n      c.fillStyle = '#FFF';\n      c.beginPath(); c.arc(-6.8 + eyeOffsetX, -19.8 + headBob, 1.1, 0, Math.PI * 2); c.fill();\n      c.beginPath(); c.arc(5.2 + eyeOffsetX, -19.8 + headBob, 1.1, 0, Math.PI * 2); c.fill();\n    }\n\n    // Cheeks & smile\n    c.fillStyle = 'rgba(255, 118, 117, 0.55)';\n    c.beginPath(); c.ellipse(-10.5 + eyeOffsetX, -14 + headBob, 3.2, 1.8, 0, 0, Math.PI * 2); c.fill();\n    c.beginPath(); c.ellipse(10.5 + eyeOffsetX, -14 + headBob, 3.2, 1.8, 0, 0, Math.PI * 2); c.fill();\n\n    c.strokeStyle = '#C0392B';\n    c.lineWidth = 2;\n    c.beginPath();\n    c.arc(eyeOffsetX, -13 + headBob, 3.5, 0.12 * Math.PI, 0.88 * Math.PI);\n    c.stroke();\n\n    // Front hair bangs\n    c.fillStyle = hColor;\n    c.strokeStyle = '#2C3E50';\n    c.lineWidth = 2.4;\n    c.beginPath();\n    c.arc(0, -21 + headBob, 17, Math.PI, 0);\n    if (hStyle === 'spiky') {\n      c.lineTo(13, -40 + headBob);\n      c.lineTo(5, -33 + headBob);\n      c.lineTo(0, -42 + headBob);\n      c.lineTo(-5, -33 + headBob);\n      c.lineTo(-13, -39 + headBob);\n    } else if (hStyle === 'sidepart') {\n      c.quadraticCurveTo(10, -28 + headBob, 3, -24 + headBob);\n      c.quadraticCurveTo(-7, -20 + headBob, -16.5, -21 + headBob);\n    } else if (hStyle === 'undercut') {\n      c.lineTo(14, -27 + headBob);\n      c.quadraticCurveTo(3, -31 + headBob, -8, -25 + headBob);\n      c.lineTo(-14, -27 + headBob);\n    } else if (hStyle === 'curly') {\n      c.quadraticCurveTo(11, -28 + headBob, 5, -23 + headBob);\n      c.quadraticCurveTo(0, -29 + headBob, -5, -23 + headBob);\n      c.quadraticCurveTo(-11, -28 + headBob, -16, -22 + headBob);\n    } else {\n      c.lineTo(14, -22 + headBob);\n      c.lineTo(7, -26 + headBob);\n      c.lineTo(0, -21 + headBob);\n      c.lineTo(-7, -26 + headBob);\n      c.lineTo(-14, -22 + headBob);\n    }\n    c.closePath();\n    c.fill();\n    c.stroke();\n\n    if (hStyle === 'wavy') {\n      c.fillStyle = '#FF6B6B';\n      c.beginPath(); c.arc(11, -26 + headBob, 2.8, 0, Math.PI * 2); c.fill();\n    }\n\n    c.strokeStyle = 'rgba(255,255,255,0.32)';\n    c.lineWidth = 2;\n    c.beginPath();\n    c.arc(0, -22 + headBob, 12, 1.2 * Math.PI, 1.75 * Math.PI);\n    c.stroke();\n  }\n\n  if (member.outfit) {\n    c.font = '21px Arial';\n    c.textAlign = 'center';\n    c.fillText(member.outfit, 0, -38 + headBob);\n  }\n\n  if (isMainCanvas) {\n    c.fillStyle = isMe ? '#FF6B6B' : 'rgba(44, 62, 80, 0.9)';\n    c.beginPath();\n    c.roundRect(-34, -59 + headBob, 68, 17, 6);\n    c.fill();\n    c.fillStyle = '#FFF';\n    c.font = 'bold 11px Fredoka, sans-serif';\n    c.textAlign = 'center';\n    c.fillText(member.name, 0, -47 + headBob);\n\n    if (member.speech && Date.now() < member.speech.expiresAt) {\n      drawSpeechBubble(c, 0, -69 + headBob, member.speech.text, member.speech.isEng);\n    }\n  }\n\n  c.restore();\n}\n\nexport function drawWorldDecorItem(\n  c: CanvasRenderingContext2D,\n  decorId: string,\n  x: number,\n  y: number,\n  findAnyCatalogItem: (id: string) => any\n) {\n  c.save();\n  c.translate(x, y);\n  if (decorId === 'd_pc') {\n    c.strokeStyle = '#1E293B';\n    c.lineWidth = 2;\n    c.fillStyle = '#0F172A';\n    c.fillRect(-26, 2, 4, 17);\n    c.fillRect(22, 2, 4, 17);\n    c.fillStyle = '#C98A4B';\n    c.beginPath(); c.roundRect(-29, -4, 58, 7, 2); c.fill(); c.stroke();\n    c.fillStyle = '#0F172A';\n    c.beginPath(); c.roundRect(-18, -26, 28, 18, 3); c.fill(); c.stroke();\n    c.fillStyle = '#38BDF8';\n    c.fillRect(-15, -23, 22, 12);\n    c.fillStyle = '#475569';\n    c.fillRect(-7, -8, 6, 4);\n    c.fillStyle = '#1E293B';\n    c.beginPath(); c.roundRect(14, -20, 11, 16, 2); c.fill(); c.stroke();\n    c.fillStyle = '#22D3EE';\n    c.fillRect(15.5, -18, 2, 12);\n    c.fillStyle = '#F8FAFC';\n    c.fillRect(-14, -7, 15, 3);\n    c.fillStyle = '#EF4444';\n    c.beginPath(); c.roundRect(-10, 4, 20, 13, 3); c.fill(); c.stroke();\n  } else if (decorId === 'd_plant') {\n    c.strokeStyle = '#1E293B';\n    c.lineWidth = 2;\n    c.fillStyle = '#CBD5E1';\n    c.fillRect(-10, 15, 20, 3);\n    c.fillStyle = '#F8FAFC';\n    c.beginPath(); c.moveTo(-11, 2); c.lineTo(11, 2); c.lineTo(8, 16); c.lineTo(-8, 16); c.closePath(); c.fill(); c.stroke();\n    c.fillStyle = '#16A34A';\n    c.beginPath(); c.ellipse(-10, -5, 8, 5.5, -0.45, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.beginPath(); c.ellipse(10, -5, 8, 5.5, 0.45, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.fillStyle = '#22C55E';\n    c.beginPath(); c.ellipse(0, -13, 8, 10, 0, 0, Math.PI * 2); c.fill(); c.stroke();\n  } else if (decorId === 'd_bookshelf') {\n    c.fillStyle = '#78350F';\n    c.strokeStyle = '#1E293B';\n    c.lineWidth = 2;\n    c.fillRect(-18, -26, 36, 44);\n    c.strokeRect(-18, -26, 36, 44);\n    [-21, -7, 7].forEach((sy, row) => {\n      c.fillStyle = '#FEF3C7';\n      c.fillRect(-14, sy, 28, 10);\n      ['#EF4444', '#38BDF8', '#F59E0B', '#22C55E'].forEach((bc, bi) => {\n        c.fillStyle = bc;\n        c.fillRect(-12 + bi * 6 + (row % 2), sy + 1, 5, 9);\n      });\n    });\n  } else if (decorId === 'd_aquarium') {\n    c.fillStyle = '#78350F';\n    c.strokeStyle = '#1E293B';\n    c.lineWidth = 2;\n    c.fillRect(-18, 2, 36, 16);\n    c.strokeRect(-18, 2, 36, 16);\n    c.fillStyle = '#BAE6FD';\n    c.fillRect(-16, -18, 32, 20);\n    c.strokeRect(-16, -18, 32, 20);\n    c.fillStyle = '#0F172A';\n    c.fillRect(-17, -21, 34, 4);\n    c.fillStyle = '#FB923C';\n    c.beginPath(); c.ellipse(-3, -8, 5, 3, 0, 0, Math.PI * 2); c.fill();\n  } else if (decorId === 'd_bear') {\n    c.strokeStyle = '#1E293B';\n    c.lineWidth = 2;\n    c.fillStyle = '#B46522';\n    c.beginPath(); c.arc(-11, -18, 6, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.beginPath(); c.arc(11, -18, 6, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.fillStyle = '#F9A8D4';\n    c.beginPath(); c.arc(-11, -18, 3, 0, Math.PI * 2); c.fill();\n    c.beginPath(); c.arc(11, -18, 3, 0, Math.PI * 2); c.fill();\n    c.fillStyle = '#C97A34';\n    c.beginPath(); c.ellipse(0, 6, 14, 15, 0, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.fillStyle = '#FEF3C7';\n    c.beginPath(); c.ellipse(0, 7, 8, 9, 0, 0, Math.PI * 2); c.fill();\n    c.fillStyle = '#C97A34';\n    c.beginPath(); c.arc(0, -10, 12, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.fillStyle = '#FEF3C7';\n    c.beginPath(); c.ellipse(0, -7, 6, 4.5, 0, 0, Math.PI * 2); c.fill();\n    c.fillStyle = '#0F172A';\n    c.beginPath(); c.arc(-4.5, -13, 1.8, 0, Math.PI * 2); c.arc(4.5, -13, 1.8, 0, Math.PI * 2); c.fill();\n    c.beginPath(); c.arc(0, -8.5, 2.2, 0, Math.PI * 2); c.fill();\n    c.fillStyle = '#E11D48';\n    c.beginPath(); c.ellipse(0, 0, 5.5, 2.6, 0, 0, Math.PI * 2); c.fill();\n  } else if (decorId === 'd_guitar') {\n    c.strokeStyle = '#1E293B';\n    c.lineWidth = 2;\n    c.rotate(-0.22);\n    c.fillStyle = '#D97706';\n    c.beginPath(); c.ellipse(0, 9, 13, 11.5, 0, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.beginPath(); c.ellipse(0, -3, 9.2, 8.8, 0, 0, Math.PI * 2); c.fill(); c.stroke();\n    c.fillStyle = '#0F172A';\n    c.beginPath(); c.arc(0, 2, 4, 0, Math.PI * 2); c.fill();\n    c.fillStyle = '#451A03';\n    c.fillRect(-2.6, -29, 5.2, 22);\n    c.strokeRect(-2.6, -29, 5.2, 22);\n    c.fillStyle = '#78350F';\n    c.beginPath(); c.roundRect(-4.5, -35, 9, 7, 2); c.fill(); c.stroke();\n    c.strokeStyle = '#E2E8F0';\n    c.lineWidth = 1;\n    c.beginPath(); c.moveTo(-1, -28); c.lineTo(-1, 13); c.moveTo(1, -28); c.lineTo(1, 13); c.stroke();\n  } else {\n    const item = findAnyCatalogItem(decorId);\n    if (item && item.labSpec) {\n      drawProceduralLabItemOnCanvas(c, item.labSpec, item);\n    } else {\n      c.font = '32px Arial';\n      c.textAlign = 'center';\n      c.fillText(item ? item.icon : '📦', 0, 10);\n    }\n  }\n  c.restore();\n}\n\nfunction drawBuildingShapeBackdrop(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  shape: BuildingShape,\n  w = 224,\n  h = 148\n) {\n  ctx.save();\n  // Paved courtyard terrace under every building\n  ctx.fillStyle = shape === 'castle' ? 'rgba(203, 213, 225, 0.85)' : shape === 'modern' ? 'rgba(226, 232, 240, 0.86)' : 'rgba(241, 245, 249, 0.78)';\n  ctx.strokeStyle = shape === 'castle' ? '#475569' : 'rgba(100, 116, 139, 0.55)';\n  ctx.lineWidth = 2.2;\n  ctx.beginPath();\n  ctx.roundRect(x - w / 2 - 18, y + 48, w + 36, 34, 10);\n  ctx.fill();\n  ctx.stroke();\n\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 3;\n\n  if (shape === 'classic') {\n    // Brick/stone side pilasters + warm flower planter boxes\n    [-w / 2 - 6, w / 2 - 10].forEach((px) => {\n      ctx.fillStyle = '#E74C3C';\n      ctx.fillRect(x + px, y - 78, 16, h);\n      ctx.strokeRect(x + px, y - 78, 16, h);\n      ctx.fillStyle = '#22C55E';\n      ctx.beginPath();\n      ctx.arc(x + px + 8, y + 60, 9, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.stroke();\n    });\n  } else if (shape === 'modern') {\n    // Sleek steel exoskeleton wing fins + glowing cyan glass terrace canopy\n    [-w / 2 - 14, w / 2 - 4].forEach((fx) => {\n      ctx.fillStyle = '#0F172A';\n      ctx.fillRect(x + fx, y - 108, 18, h + 30);\n      ctx.strokeRect(x + fx, y - 108, 18, h + 30);\n      ctx.fillStyle = '#38BDF8';\n      ctx.fillRect(x + fx + 5, y - 102, 5, h + 16);\n    });\n    // Rooftop solar & glass penthouse bar\n    ctx.fillStyle = '#0F172A';\n    ctx.beginPath();\n    ctx.roundRect(x - w / 2 - 18, y - 118, w + 36, 22, 6);\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#38BDF8';\n    ctx.fillRect(x - w / 2 - 10, y - 110, w + 20, 6);\n  } else if (shape === 'pavilion') {\n    // Crimson wooden veranda pillars + sweeping golden pagoda double-eaves\n    [-w / 2 - 10, w / 2 - 8].forEach((px) => {\n      ctx.fillStyle = '#B91C1C';\n      ctx.fillRect(x + px, y - 78, 18, h);\n      ctx.strokeRect(x + px, y - 78, 18, h);\n      ctx.fillStyle = '#FACC15';\n      ctx.fillRect(x + px - 2, y + 54, 22, 10);\n      ctx.strokeRect(x + px - 2, y + 54, 22, 10);\n    });\n    // Upper tier upturned curved pagoda roof\n    ctx.fillStyle = '#DC2626';\n    ctx.beginPath();\n    ctx.moveTo(x - w / 2 - 26, y - 82);\n    ctx.quadraticCurveTo(x - w / 4, y - 105, x, y - 148);\n    ctx.quadraticCurveTo(x + w / 4, y - 105, x + w / 2 + 26, y - 82);\n    ctx.quadraticCurveTo(x, y - 92, x - w / 2 - 26, y - 82);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#FACC15';\n    ctx.beginPath();\n    ctx.arc(x, y - 150, 9, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n  } else if (shape === 'castle') {\n    // Twin tall ashlar stone fortress turrets with royal indigo conical spires & waving banners\n    [-w / 2 - 22, w / 2 - 10].forEach((tx, ti) => {\n      ctx.fillStyle = '#94A3B8';\n      ctx.fillRect(x + tx, y - 106, 32, h + 32);\n      ctx.strokeRect(x + tx, y - 106, 32, h + 32);\n      // Stone slit window\n      ctx.fillStyle = '#1E293B';\n      ctx.beginPath();\n      ctx.roundRect(x + tx + 11, y - 62, 10, 24, [5, 5, 0, 0]);\n      ctx.fill();\n      // Conical spire\n      ctx.fillStyle = '#4F46E5';\n      ctx.beginPath();\n      ctx.moveTo(x + tx - 5, y - 106);\n      ctx.lineTo(x + tx + 16, y - 152);\n      ctx.lineTo(x + tx + 37, y - 106);\n      ctx.closePath();\n      ctx.fill();\n      ctx.stroke();\n      // Fluttering pennant flag\n      const wave = Math.sin(Date.now() / 190 + ti) * 3;\n      ctx.fillStyle = '#F43F5E';\n      ctx.beginPath();\n      ctx.moveTo(x + tx + 16, y - 152);\n      ctx.lineTo(x + tx + 38, y - 144 + wave);\n      ctx.lineTo(x + tx + 16, y - 136);\n      ctx.closePath();\n      ctx.fill();\n      ctx.stroke();\n    });\n  }\n  ctx.restore();\n}\n\nfunction drawBuildingShapeOverlay(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  shape: BuildingShape,\n  w = 212,\n  topY = -92\n) {\n  ctx.save();\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 2.6;\n  const roofY = y + topY;\n\n  if (shape === 'classic') {\n    // Crisp pitched gable pediment over the front roofline\n    ctx.fillStyle = '#B91C1C';\n    ctx.beginPath();\n    ctx.moveTo(x - w / 2 - 10, roofY + 2);\n    ctx.lineTo(x, roofY - 34);\n    ctx.lineTo(x + w / 2 + 10, roofY + 2);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#FEF08A';\n    ctx.beginPath();\n    ctx.arc(x, roofY - 12, 8, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n  } else if (shape === 'modern') {\n    // Sleek cyan LED strip & diagonal glass curtain sheen\n    ctx.fillStyle = 'rgba(56, 189, 248, 0.22)';\n    ctx.beginPath();\n    ctx.moveTo(x - w / 2 + 18, roofY + 18);\n    ctx.lineTo(x - w / 2 + 46, roofY + 18);\n    ctx.lineTo(x - w / 2 + 16, y + 48);\n    ctx.lineTo(x - w / 2 - 8, y + 48);\n    ctx.closePath();\n    ctx.fill();\n    ctx.fillStyle = '#38BDF8';\n    ctx.fillRect(x - w / 2 - 6, roofY - 4, w + 12, 6);\n    ctx.strokeRect(x - w / 2 - 6, roofY - 4, w + 12, 6);\n  } else if (shape === 'pavilion') {\n    // Upturned pagoda eave rim + swaying red festival lanterns on both corners\n    const sway = Math.sin(Date.now() / 320) * 3;\n    ctx.fillStyle = '#F59E0B';\n    ctx.beginPath();\n    ctx.moveTo(x - w / 2 - 18, roofY + 4);\n    ctx.quadraticCurveTo(x, roofY - 16, x + w / 2 + 18, roofY + 4);\n    ctx.lineTo(x + w / 2 + 10, roofY + 12);\n    ctx.quadraticCurveTo(x, roofY - 4, x - w / 2 - 10, roofY + 12);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n    [-w / 2 - 6, w / 2 + 6].forEach((lx) => {\n      ctx.beginPath();\n      ctx.moveTo(x + lx, roofY + 8);\n      ctx.lineTo(x + lx + sway, roofY + 24);\n      ctx.stroke();\n      ctx.fillStyle = '#EF4444';\n      ctx.beginPath();\n      ctx.ellipse(x + lx + sway, roofY + 31, 7, 9, 0, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.stroke();\n      ctx.fillStyle = '#FACC15';\n      ctx.fillRect(x + lx + sway - 4, roofY + 22, 8, 3);\n    });\n  } else if (shape === 'castle') {\n    // Stone crenellated battlements running across the top roofline + golden heraldic crest\n    ctx.fillStyle = '#CBD5E1';\n    for (let bx = x - w / 2; bx <= x + w / 2 - 18; bx += 26) {\n      ctx.fillRect(bx, roofY - 14, 16, 16);\n      ctx.strokeRect(bx, roofY - 14, 16, 16);\n    }\n    ctx.fillStyle = '#FACC15';\n    ctx.beginPath();\n    ctx.moveTo(x - 13, roofY - 10);\n    ctx.lineTo(x + 13, roofY - 10);\n    ctx.lineTo(x + 11, roofY + 6);\n    ctx.lineTo(x, roofY + 14);\n    ctx.lineTo(x - 11, roofY + 6);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n  }\n  ctx.restore();\n}\n\nexport function drawStreetTownhouse(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  style: string,\n  lighting: LightingInfo,\n  familyName = 'B2KS',\n  shape: BuildingShape = 'classic'\n) {\n  ctx.save();\n  ctx.translate(x, y);\n\n  let wallColor = '#FFF8E7';\n  let trimColor = '#E67E22';\n  let roofColor = '#C0392B';\n  if (style === 'modern') { wallColor = '#FDFEFE'; trimColor = '#2980B9'; roofColor = '#2C3E50'; }\n  if (style === 'pastel') { wallColor = '#E8F8F5'; trimColor = '#16A085'; roofColor = '#F39C12'; }\n  if (shape === 'castle') { wallColor = '#E2E8F0'; trimColor = '#64748B'; roofColor = '#4F46E5'; }\n  if (shape === 'modern') { wallColor = '#F1F5F9'; trimColor = '#0284C7'; roofColor = '#0F172A'; }\n  if (shape === 'pavilion') { wallColor = '#FFFBEB'; trimColor = '#DC2626'; roofColor = '#B91C1C'; }\n\n  ctx.lineWidth = 3.2;\n  ctx.strokeStyle = '#2C3E50';\n\n  // Paved yard front apron\n  ctx.fillStyle = 'rgba(241, 245, 249, 0.78)';\n  ctx.beginPath();\n  ctx.roundRect(-108, 54, 216, 36, 12);\n  ctx.fill();\n\n  ctx.fillStyle = 'rgba(0,0,0,0.22)';\n  ctx.beginPath();\n  ctx.ellipse(0, 72, 102, 15, 0, 0, Math.PI * 2);\n  ctx.fill();\n\n  if (shape === 'castle') {\n    [-112, 82].forEach((tx, ti) => {\n      ctx.fillStyle = '#CBD5E1';\n      ctx.fillRect(tx, -176, 30, 244);\n      ctx.strokeRect(tx, -176, 30, 244);\n      ctx.fillStyle = '#4F46E5';\n      ctx.beginPath();\n      ctx.moveTo(tx - 5, -176); ctx.lineTo(tx + 15, -220); ctx.lineTo(tx + 35, -176); ctx.closePath();\n      ctx.fill(); ctx.stroke();\n      const wave = Math.sin(Date.now() / 200 + ti) * 3;\n      ctx.fillStyle = '#F43F5E';\n      ctx.beginPath();\n      ctx.moveTo(tx + 15, -220); ctx.lineTo(tx + 36, -212 + wave); ctx.lineTo(tx + 15, -205); ctx.closePath();\n      ctx.fill(); ctx.stroke();\n    });\n  } else if (shape === 'pavilion') {\n    [-98, 82].forEach((px) => {\n      ctx.fillStyle = '#B91C1C';\n      ctx.fillRect(px, -170, 16, 240);\n      ctx.strokeRect(px, -170, 16, 240);\n    });\n  }\n\n  ctx.fillStyle = wallColor;\n  ctx.fillRect(-84, -170, 168, 240);\n  ctx.strokeRect(-84, -170, 168, 240);\n\n  [-90, -12].forEach((fy) => {\n    ctx.fillStyle = trimColor;\n    ctx.fillRect(-90, fy, 180, 9);\n    ctx.strokeRect(-90, fy, 180, 9);\n\n    if (shape === 'modern') {\n      // Wide floor