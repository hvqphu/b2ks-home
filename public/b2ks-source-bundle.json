r=\"2.8\" fill=\"${eyeCore}\"/><circle cx=\"47\" cy=\"30\" r=\"2.8\" fill=\"${eyeCore}\"/>\n      <circle cx=\"33.8\" cy=\"29\" r=\"1\" fill=\"#FFF\"/><circle cx=\"47.8\" cy=\"29\" r=\"1\" fill=\"#FFF\"/>\n      <circle cx=\"40\" cy=\"38\" r=\"2.5\" fill=\"${cSec}\"/>\n      ${lashSvg(33, 47, 30)}\n      ${renderAccessorySVG(accId, 40, 42, 30, 14)}\n    `;\n  } else if (speciesId === 'pet_phoenix') {\n    vCx = 40; vNeckY = 41; vTopY = 13;\n    const wingScale = stage >= 3 ? 1.25 : 0.95;\n    art = `\n      <path d=\"M46 57 Q69 54 71 36\" fill=\"none\" stroke=\"${cTrim}\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      <path d=\"M44 61 Q66 64 73 49\" fill=\"none\" stroke=\"${c1}\" stroke-width=\"4.2\" stroke-linecap=\"round\"/>\n      <g transform=\"translate(40,44) scale(${wingScale}) translate(-40,-44)\">\n        <path d=\"M26 42 Q6 24 10 14 Q22 22 31 35 Z\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n        <path d=\"M25 46 Q9 34 12 26 Q22 32 30 41 Z\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"1.6\"/>\n        <path d=\"M54 42 Q74 24 70 14 Q58 22 49 35 Z\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n        <path d=\"M55 46 Q71 34 68 26 Q58 32 50 41 Z\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"1.6\"/>\n      </g>\n      <ellipse cx=\"40\" cy=\"49\" rx=\"13\" ry=\"15\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2.5\"/>\n      <ellipse cx=\"40\" cy=\"51\" rx=\"8\" ry=\"10\" fill=\"${c2}\"/>\n      <polygon points=\"40,4 35,19 40,15 45,19\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"1.8\"/>\n      <polygon points=\"31,18 24,8 36,19\" fill=\"${cSec}\" stroke=\"#2C3E50\" stroke-width=\"1.5\"/>\n      <polygon points=\"49,18 56,8 44,19\" fill=\"${cSec}\" stroke=\"#2C3E50\" stroke-width=\"1.5\"/>\n      <circle cx=\"40\" cy=\"29\" r=\"13.5\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2.5\"/>\n      <circle cx=\"34.5\" cy=\"28\" r=\"2.7\" fill=\"${c2}\"/><circle cx=\"45.5\" cy=\"28\" r=\"2.7\" fill=\"${c2}\"/>\n      <circle cx=\"34.5\" cy=\"28\" r=\"1.4\" fill=\"${eyeCore}\"/><circle cx=\"45.5\" cy=\"28\" r=\"1.4\" fill=\"${eyeCore}\"/>\n      <polygon points=\"40,37 36,31 44,31\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"1.6\"/>\n      ${renderAccessorySVG(accId, 40, 41, 28, 13)}\n    `;\n  } else {\n    vCx = 40; vNeckY = 42; vTopY = 14;\n    const wings = stage >= 2\n      ? `<path d=\"M27 41 L9 24 L13 44 L22 41 L21 49 Z\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n         <path d=\"M53 41 L71 24 L67 44 L58 41 L59 49 Z\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"2\" stroke-linejoin=\"round\"/>`\n      : '';\n    art = `\n      ${wings}\n      <path d=\"M51 56 Q68 56 69 40\" fill=\"none\" stroke=\"${c1}\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      <polygon points=\"69,34 64,42 74,42\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"1.6\"/>\n      <ellipse cx=\"30\" cy=\"64\" rx=\"5.5\" ry=\"3.4\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <ellipse cx=\"50\" cy=\"64\" rx=\"5.5\" ry=\"3.4\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <ellipse cx=\"40\" cy=\"51\" rx=\"15.5\" ry=\"14\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2.5\"/>\n      <ellipse cx=\"40\" cy=\"53\" rx=\"9\" ry=\"10\" fill=\"${c2}\"/>\n      <line x1=\"33\" y1=\"50\" x2=\"47\" y2=\"50\" stroke=\"${cSec}\" stroke-width=\"1.6\"/>\n      <line x1=\"33\" y1=\"55\" x2=\"47\" y2=\"55\" stroke=\"${cSec}\" stroke-width=\"1.6\"/>\n      <path d=\"M29 22 Q20 12 22 6 Q28 11 33 19 Z\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <path d=\"M51 22 Q60 12 58 6 Q52 11 47 19 Z\" fill=\"${cTrim}\" stroke=\"#2C3E50\" stroke-width=\"2\"/>\n      <ellipse cx=\"40\" cy=\"30\" rx=\"16\" ry=\"13.5\" fill=\"${c1}\" stroke=\"#2C3E50\" stroke-width=\"2.5\"/>\n      <ellipse cx=\"40\" cy=\"36\" rx=\"9.5\" ry=\"5.5\" fill=\"${c2}\" stroke=\"#2C3E50\" stroke-width=\"1.6\"/>\n      <circle cx=\"36.5\" cy=\"35\" r=\"1.4\" fill=\"${cSec}\"/><circle cx=\"43.5\" cy=\"35\" r=\"1.4\" fill=\"${cSec}\"/>\n      <circle cx=\"33\" cy=\"27\" r=\"3\" fill=\"${c2}\" stroke=\"#2C3E50\" stroke-width=\"1.3\"/><circle cx=\"47\" cy=\"27\" r=\"3\" fill=\"${c2}\" stroke=\"#2C3E50\" stroke-width=\"1.3\"/>\n      <ellipse cx=\"33\" cy=\"27\" rx=\"1.2\" ry=\"2.2\" fill=\"${eyeCore}\"/><ellipse cx=\"47\" cy=\"27\" rx=\"1.2\" ry=\"2.2\" fill=\"${eyeCore}\"/>\n      ${renderAccessorySVG(accId, 40, 42, 27, 14)}\n    `;\n  }\n\n  return `\n    <svg width=\"${size}\" height=\"${size}\" viewBox=\"0 0 80 80\" xmlns=\"http://www.w3.org/2000/svg\">\n      ${auraRing}\n      <ellipse cx=\"40\" cy=\"68\" rx=\"19\" ry=\"5\" fill=\"rgba(0,0,0,0.16)\"/>\n      <g transform=\"translate(40,42) scale(${stageScale}) translate(-40,-42)\">\n        ${renderVariantBackdropSVG(variant, cTrim, auraColor)}\n        ${art}\n        ${renderVariantForegroundSVG(variant, cTrim, vCx, vNeckY, vTopY)}\n        ${crownSvg}\n      </g>\n      ${stageStars}\n    </svg>\n  `;\n}\n\n/**\n * Draw active companion pet trailing beside/behind owner character on Canvas2D\n * with clearly distinct species silhouettes, variants & evolution stages!\n */\nexport function drawCompanionPetOnContext(\n  ctx: CanvasRenderingContext2D,\n  owner: Member,\n  isMoving: boolean\n) {\n  const pet = getActivePet(owner);\n  if (!pet) return;\n\n  const sp = getPetSpecies(pet.speciesId);\n  const variant: PetVariantId = pet.variant || 'classic';\n  const resolved = getPetResolvedColors(sp, variant);\n  const c1 = resolved.primary;\n  const cSec = resolved.secondary;\n  const c2 = resolved.accent;\n  const cTrim = resolved.trim;\n  const stageDef = sp.stages.find((s) => s.stage === pet.stage) || sp.stages[0];\n  const dir = owner.dir || 'down';\n  const t = Date.now();\n\n  let ox = -30;\n  let oy = 12;\n  if (dir === 'left') { ox = 32; oy = 10; }\n  else if (dir === 'right') { ox = -32; oy = 10; }\n  else if (dir === 'up') { ox = 26; oy = 18; }\n  else { ox = -28; oy = 8; }\n\n  const px = owner.x + ox;\n  const py = owner.y + oy;\n  const bounce = isMoving ? Math.abs(Math.sin(t / 110)) * 5.8 : Math.sin(t / 320) * 1.9;\n  const scale = stageDef.scale * 0.78;\n  const isRightBaseSpecies = sp.id === 'pet_corgi' || sp.id === 'pet_unicorn';\n  const flipX =\n    dir === 'left'\n      ? (isRightBaseSpecies ? -1 : 1)\n      : dir === 'right'\n        ? (isRightBaseSpecies ? 1 : -1)\n        : 1;\n  const faceShiftX =\n    dir === 'left' || dir === 'right'\n      ? (isRightBaseSpecies ? 2.2 : -2.8)\n      : 0;\n\n  ctx.save();\n  ctx.translate(px, py);\n\n  ctx.fillStyle = 'rgba(0,0,0,0.22)';\n  ctx.beginPath();\n  ctx.ellipse(0, 12 * scale, 15 * scale, 5 * scale, 0, 0, Math.PI * 2);\n  ctx.fill();\n\n  ctx.translate(0, -bounce);\n  ctx.scale(scale * flipX, scale);\n\n  if (!pet.hatched) {\n    const wobble = Math.sin(t / 240) * 0.09;\n    ctx.rotate(wobble);\n    ctx.fillStyle = c2;\n    ctx.strokeStyle = '#2C3E50';\n    ctx.lineWidth = 2.6;\n    ctx.beginPath();\n    ctx.ellipse(0, -4, 13, 17, 0, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n\n    ctx.strokeStyle = c1;\n    ctx.lineWidth = 2.4;\n    ctx.beginPath();\n    ctx.moveTo(-10, -4); ctx.lineTo(-4, -8); ctx.lineTo(3, -3); ctx.lineTo(10, -6);\n    ctx.stroke();\n\n    ctx.restore();\n    ctx.save();\n    ctx.font = 'bold 9px Fredoka, sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FEF3C7';\n    ctx.strokeStyle = '#2C3E50';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.roundRect(px - 22, py - 28, 44, 13, 6);\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#92400E';\n    ctx.fillText(`🥚 ${Math.round(pet.hatchProgress)}%`, px, py - 18);\n    ctx.restore();\n    return;\n  }\n\n  // Stage >= 2 or rare variant pulsing aura\n  if (pet.stage >= 2 || resolved.isRare) {\n    ctx.save();\n    ctx.strokeStyle = resolved.auraColor;\n    ctx.globalAlpha = 0.5 + Math.sin(t / 220) * 0.25;\n    ctx.lineWidth = pet.stage >= 3 || resolved.isRare ? 2.8 : 2;\n    ctx.beginPath();\n    ctx.arc(0, -9, pet.stage >= 4 ? 26 : 22, 0, Math.PI * 2);\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  // Variant backdrop morphs (Royal Cape / Golden Sunburst Rays / Cosmic Back Ring)\n  if (variant === 'royal') {\n    ctx.save();\n    ctx.fillStyle = '#4C1D95';\n    ctx.strokeStyle = '#FACC15';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-13, -7);\n    ctx.quadraticCurveTo(-20, 4, -17, 13);\n    ctx.quadraticCurveTo(0, 16, 17, 13);\n    ctx.quadraticCurveTo(20, 4, 13, -7);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n    ctx.restore();\n  } else if (variant === 'golden') {\n    ctx.save();\n    ctx.fillStyle = '#FDE047';\n    ctx.strokeStyle = '#B45309';\n    ctx.lineWidth = 1.2;\n    for (let i = 0; i < 8; i++) {\n      const ang = (i * Math.PI) / 4 + t * 0.0008;\n      ctx.beginPath();\n      ctx.moveTo(Math.cos(ang - 0.14) * 16, -8 + Math.sin(ang - 0.14) * 16);\n      ctx.lineTo(Math.cos(ang) * 26, -8 + Math.sin(ang) * 26);\n      ctx.lineTo(Math.cos(ang + 0.14) * 16, -8 + Math.sin(ang + 0.14) * 16);\n      ctx.closePath();\n      ctx.fill();\n      ctx.stroke();\n    }\n    ctx.restore();\n  } else if (variant === 'cosmic') {\n    ctx.save();\n    ctx.strokeStyle = cTrim;\n    ctx.lineWidth = 2.6;\n    ctx.globalAlpha = 0.72;\n    ctx.beginPath();\n    ctx.ellipse(0, -4, 24, 7.5, -0.3, Math.PI, Math.PI * 2);\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  const flap = Math.sin(t / 120) * 0.35;\n  ctx.strokeStyle = '#2C3E50';\n  ctx.lineWidth = 2.4;\n\n  // Wings (species-specific styling + stage 3+ unlocks wings for all pets!)\n  if (pet.stage >= 3 || sp.id === 'pet_owl' || sp.id === 'pet_phoenix' || (sp.id === 'pet_dragon' && pet.stage >= 2)) {\n    const wingColor =\n      sp.id === 'pet_phoenix' ? cTrim :\n      sp.id === 'pet_dragon' ? cTrim :\n      sp.id === 'pet_unicorn' ? c2 :\n      sp.id === 'pet_kitty' ? cTrim :\n      sp.id === 'pet_owl' ? cSec : c2;\n    [-1, 1].forEach((side) => {\n      ctx.save();\n      ctx.translate(side * 14, -6);\n      ctx.rotate(side * (0.35 - flap));\n      ctx.fillStyle = wingColor;\n      ctx.beginPath();\n      if (sp.id === 'pet_dragon') {\n        ctx.moveTo(0, 0); ctx.lineTo(side * 15, -11); ctx.lineTo(side * 13, 5); ctx.lineTo(side * 5, 2); ctx.closePath();\n      } else {\n        ctx.ellipse(side * 7, 0, sp.id === 'pet_phoenix' ? 12 : 9.5, 5, 0, 0, Math.PI * 2);\n      }\n      ctx.fill();\n      ctx.stroke();\n      ctx.restore();\n    });\n  }\n\n  // Tail by species\n  if (sp.id === 'pet_corgi') {\n    ctx.fillStyle = c2;\n    ctx.beginPath(); ctx.arc(-18, -1, 5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n  } else if (sp.id === 'pet_kitty') {\n    ctx.strokeStyle = c1; ctx.lineWidth = 4.5; ctx.lineCap = 'round';\n    ctx.beginPath(); ctx.moveTo(11, 4); ctx.quadraticCurveTo(22, -4, 18, -16); ctx.stroke();\n    ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 2.4;\n  } else if (sp.id === 'pet_unicorn') {\n    ctx.strokeStyle = cSec; ctx.lineWidth = 4.5; ctx.lineCap = 'round';\n    ctx.beginPath(); ctx.moveTo(-14, 1); ctx.quadraticCurveTo(-24, 0, -21, 10); ctx.stroke();\n    ctx.strokeStyle = cTrim; ctx.lineWidth = 3;\n    ctx.beginPath(); ctx.moveTo(-14, 3); ctx.quadraticCurveTo(-22, 4, -19, 12); ctx.stroke();\n    ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 2.4;\n  } else if (sp.id === 'pet_fox') {\n    const tCount = pet.stage >= 3 ? 3 : pet.stage === 2 ? 2 : 1;\n    for (let ti = 0; ti < tCount; ti++) {\n      const ang = -0.3 + ti * 0.35;\n      ctx.save();\n      ctx.translate(10, 2);\n      ctx.rotate(ang);\n      ctx.fillStyle = ti === 1 ? cSec : c1;\n      ctx.beginPath(); ctx.ellipse(9, -6, 9, 4.5, -0.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n      ctx.fillStyle = c2;\n      ctx.beginPath(); ctx.arc(15, -10, 3.2, 0, Math.PI * 2); ctx.fill();\n      ctx.restore();\n    }\n  } else if (sp.id === 'pet_phoenix') {\n    ctx.strokeStyle = cTrim; ctx.lineWidth = 4.2; ctx.lineCap = 'round';\n    ctx.beginPath(); ctx.moveTo(9, 4); ctx.quadraticCurveTo(23, 2, 22, -13); ctx.stroke();\n    ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 2.4;\n  } else if (sp.id === 'pet_dragon') {\n    ctx.strokeStyle = c1; ctx.lineWidth = 4.5; ctx.lineCap = 'round';\n    ctx.beginPath(); ctx.moveTo(11, 4); ctx.quadraticCurveTo(23, 3, 22, -10); ctx.stroke();\n    ctx.fillStyle = cTrim; ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 1.6;\n    ctx.beginPath(); ctx.moveTo(22, -14); ctx.lineTo(18, -8); ctx.lineTo(26, -8); ctx.closePath(); ctx.fill(); ctx.stroke();\n    ctx.lineWidth = 2.4;\n  } else if (sp.id === 'pet_bunny') {\n    ctx.fillStyle = c2;\n    ctx.beginPath(); ctx.arc(14, 4, 5.2, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n  }\n\n  // Body silhouette\n  if (sp.id === 'pet_corgi') {\n    ctx.fillStyle = c2;\n    ctx.fillRect(-13, 6, 5, 7); ctx.strokeRect(-13, 6, 5, 7);\n    ctx.fillRect(6, 6, 5, 7); ctx.strokeRect(6, 6, 5, 7);\n    ctx.fillStyle = c1;\n    ctx.beginPath(); ctx.ellipse(-2, 1, 17, 10, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n    ctx.fillStyle = c2;\n    ctx.beginPath(); ctx.ellipse(7, 2, 7, 7, 0, 0, Math.PI * 2); ctx.fill();\n  } else if (sp.id === 'pet_unicorn') {\n    ctx.fillStyle = c2;\n    ctx.fillRect(-11, 5, 4.5, 8); ctx.strokeRect(-11, 5, 4.5, 8);\n    ctx.fillRect(4, 5, 4.5, 8); ctx.strokeRect(4, 5, 4.5, 8);\n    ctx.beginPath(); ctx.ellipse(-2, 0, 15, 9.5, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n  } else if (sp.id === 'pet_owl' || sp.id === 'pet_penguin') {\n    ctx.fillStyle = c1;\n    ctx.beginPath(); ctx.ellipse(0, -6, 15, 19, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n    ctx.fillStyle = c2;\n    ctx.beginPath(); ctx.ellipse(0, 1, 10, 11, 0, 0, Math.PI * 2); ctx.fill();\n    if (sp.id === 'pet_penguin') {\n      ctx.fillStyle = cTrim;\n      ctx.beginPath(); ctx.ellipse(-6, 12, 5.5, 2.8, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n      ctx.beginPath(); ctx.ellipse(6, 12, 5.5, 2.8, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n    }\n  } else {\n    ctx.fillStyle = c1;\n    ctx.beginPath(); ctx.ellipse(0, 1, 13.5, 11.5, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n    if (sp.id === 'pet_panda') {\n      ctx.fillStyle = cSec;\n      ctx.fillRect(-12, -4, 24, 6);\n    } else {\n      ctx.fillStyle = c2;\n      ctx.beginPath(); ctx.ellipse(0, 3, 7.5, 7.5, 0, 0, Math.PI * 2); ctx.fill();\n    }\n  }\n\n  // Head & Ears\n  const headX = (isRightBaseSpecies ? 6 : 0) + faceShiftX;\n  const headY = (sp.id === 'pet_owl' || sp.id === 'pet_penguin' ? -15 : -14) + (dir === 'up' ? -1.5 : 0);\n\n  if (sp.id === 'pet_bunny') {\n    ctx.fillStyle = c1;\n    ctx.beginPath(); ctx.ellipse(headX - 6, headY - 16, 4, 10.5, -0.2, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n    ctx.beginPath(); ctx.ellipse(headX + 6, headY - 16, 4, 10.5, 0.2, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n  } else if (sp.id === 'pet_panda') {\n    ctx.fillStyle = cSec;\n    ctx.beginPath(); ctx.arc(headX - 10, headY - 10, 4.8, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n    ctx.beginPath(); ctx.arc(headX + 10, headY - 10, 4.8, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n  } else if (sp.id === 'pet_phoenix') {\n    ctx.fillStyle = cTrim;\n    ctx.beginPath(); ctx.moveTo(headX, headY - 22); ctx.lineTo(headX - 5, headY - 10); ctx.lineTo(headX + 5, headY - 10); ctx.closePath(); ctx.fill(); ctx.stroke();\n  } else if (sp.id !== 'pet_penguin') {\n    ctx.fillStyle = sp.id === 'pet_dragon' ? cTrim : c1;\n    ctx.beginPath();\n    ctx.moveTo(headX - 11, headY - 5); ctx.lineTo(headX - 15, headY - 18); ctx.lineTo(headX - 3, headY - 10); ctx.closePath();\n    ctx.fill(); ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(headX + 11, headY - 5); ctx.lineTo(headX + 15, headY - 18); ctx.lineTo(headX + 3, headY - 10); ctx.closePath();\n    ctx.fill(); ctx.stroke();\n  }\n\n  if (sp.id === 'pet_unicorn') {\n    ctx.fillStyle = cTrim;\n    ctx.beginPath();\n    ctx.moveTo(headX - 3.5, headY - 10); ctx.lineTo(headX, headY - 25); ctx.lineTo(headX + 3.5, headY - 10); ctx.closePath();\n    ctx.fill(); ctx.stroke();\n  }\n\n  if (sp.id !== 'pet_owl' && sp.id !== 'pet_penguin') {\n    ctx.fillStyle = sp.id === 'pet_unicorn' ? c2 : c1;\n    ctx.beginPath();\n    ctx.arc(headX, headY, 12.5, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n  }\n\n  // Face details\n  const gazeShift = dir === 'left' || dir === 'right' ? (isRightBaseSpecies ? 1.8 : -1.8) : 0;\n  if (sp.id === 'pet_panda') {\n    ctx.fillStyle = cSec;\n    ctx.beginPath(); ctx.ellipse(headX + gazeShift - 5, headY - 1, 3.6, 4.4, -0.2, 0, Math.PI * 2); ctx.fill();\n    ctx.beginPath(); ctx.ellipse(headX + gazeShift + 5, headY - 1, 3.6, 4.4, 0.2, 0, Math.PI * 2); ctx.fill();\n  } else if (sp.id === 'pet_owl' || sp.id === 'pet_penguin') {\n    ctx.fillStyle = c2;\n    ctx.beginPath(); ctx.arc(headX + gazeShift - 5, headY - 1, 5.2, 0, Math.PI * 2); ctx.arc(headX + gazeShift + 5, headY - 1, 5.2, 0, Math.PI * 2); ctx.fill();\n    if (sp.id === 'pet_owl') {\n      ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 1.5; ctx.stroke();\n    }\n  }\n\n  if (dir !== 'up') {\n    ctx.fillStyle = variant === 'cosmic' ? '#22D3EE' : sp.id === 'pet_panda' ? '#FFFFFF' : '#1E293B';\n    ctx.beginPath();\n    ctx.arc(headX + gazeShift - 4.8, headY - 1, 2.3, 0, Math.PI * 2);\n    ctx.arc(headX + gazeShift + 4.8, headY - 1, 2.3, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.fillStyle = sp.id === 'pet_panda' && variant !== 'cosmic' ? '#0F172A' : '#FFFFFF';\n    ctx.beginPath();\n    ctx.arc(headX + gazeShift - 4, headY - 1.8, 0.9, 0, Math.PI * 2);\n    ctx.arc(headX + gazeShift + 5.6, headY - 1.8, 0.9, 0, Math.PI * 2);\n    ctx.fill();\n\n    const snoutX = headX + gazeShift * 1.2;\n    if (sp.id === 'pet_owl' || sp.id === 'pet_penguin' || sp.id === 'pet_phoenix') {\n      ctx.fillStyle = cTrim;\n      ctx.beginPath();\n      ctx.moveTo(snoutX, headY + 5); ctx.lineTo(snoutX - 3.2, headY + 1); ctx.lineTo(snoutX + 3.2, headY + 1); ctx.closePath();\n      ctx.fill();\n    } else {\n      ctx.fillStyle = c2;\n      ctx.beginPath();\n      ctx.ellipse(snoutX, headY + 5, 5.5, 3.5, 0, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = cSec;\n      ctx.beginPath();\n      ctx.arc(snoutX, headY + 4, 1.6, 0, Math.PI * 2);\n      ctx.fill();\n    }\n  }\n\n  // Variant Foreground Ornaments in 2D World\n  if (variant === 'pastel') {\n    ctx.fillStyle = '#FFF1F2';\n    ctx.strokeStyle = '#EC4899';\n    ctx.lineWidth = 1.4;\n    [-7, 0, 7].forEach((cxOff, ci) => {\n      ctx.fillStyle = ci === 1 ? '#A7F3D0' : '#FFF1F2';\n      ctx.beginPath(); ctx.arc(headX + cxOff, headY + 11.5, 3.3, 0, Math.PI * 2); ctx.fill(); ctx.stroke();\n    });\n    // Twin candy bobbles\n    ctx.strokeStyle = '#EC4899';\n    ctx.beginPath();\n    ctx.moveTo(headX - 5, headY - 11); ctx.lineTo(headX - 8, headY - 18);\n    ctx.moveTo(headX + 5, headY - 11); ctx.lineTo(headX + 8, headY - 18);\n    ctx.stroke();\n    ctx.fillStyle = '#F9A8D4'; ctx.beginPath(); ctx.arc(headX - 8, headY - 19, 2.8, 0, Math.PI * 2); ctx.fill();\n    ctx.fillStyle = '#67E8F9'; ctx.beginPath(); ctx.arc(headX + 8, headY - 19, 2.8, 0, Math.PI * 2); ctx.fill();\n  } else if (variant === 'royal') {\n    ctx.fillStyle = '#FACC15'; ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 1.4;\n    ctx.beginPath();\n    ctx.moveTo(headX - 6.5, headY - 11); ctx.lineTo(headX - 4.5, headY - 18); ctx.lineTo(headX, headY - 13.5); ctx.lineTo(headX + 4.5, headY - 18); ctx.lineTo(headX + 6.5, headY - 11);\n    ctx.closePath(); ctx.fill(); ctx.stroke();\n  } else if (variant === 'cosmic') {\n    ctx.save();\n    ctx.strokeStyle = cTrim;\n    ctx.lineWidth = 2.6;\n    ctx.beginPath();\n    ctx.ellipse(0, -4, 24, 7.5, -0.3, 0, Math.PI);\n    ctx.stroke();\n    ctx.fillStyle = '#FEF08A';\n    ctx.beginPath(); ctx.arc(Math.cos(t * 0.003) * 20, -4 + Math.sin(t * 0.003) * 6, 2.5, 0, Math.PI * 2); ctx.fill();\n    ctx.restore();\n  } else if (variant === 'golden') {\n    ctx.fillStyle = '#FEF08A'; ctx.strokeStyle = '#B45309'; ctx.lineWidth = 1.2;\n    ctx.beginPath();\n    ctx.moveTo(headX, headY - 21); ctx.lineTo(headX - 4, headY - 12); ctx.lineTo(headX + 4, headY - 12);\n    ctx.closePath(); ctx.fill(); ctx.stroke();\n  }\n\n  // Accessories & Stage crown\n  if (pet.accessoryId === 'pacc_scarf') {\n    ctx.strokeStyle = '#EF4444'; ctx.lineWidth = 4;\n    ctx.beginPath(); ctx.moveTo(headX - 10, headY + 11); ctx.quadraticCurveTo(headX, headY + 15, headX + 10, headY + 11); ctx.stroke();\n  } else if (pet.accessoryId === 'pacc_bell' || pet.stage >= 2) {\n    ctx.strokeStyle = pet.accessoryId === 'pacc_bell' ? '#EF4444' : '#FACC15'; ctx.lineWidth = 3.2;\n    ctx.beginPath(); ctx.moveTo(headX - 9, headY + 11); ctx.quadraticCurveTo(headX, headY + 15, headX + 9, headY + 11); ctx.stroke();\n    if (pet.accessoryId === 'pacc_bell') {\n      ctx.fillStyle = '#FACC15'; ctx.beginPath(); ctx.arc(headX, headY + 15, 3, 0, Math.PI * 2); ctx.fill();\n    }\n  }\n  if (pet.accessoryId === 'pacc_glasses' && dir !== 'up') {\n    ctx.fillStyle = '#0F172A'; ctx.strokeStyle = '#FACC15'; ctx.lineWidth = 1.4;\n    ctx.fillRect(headX + gazeShift - 9, headY - 4, 7, 5); ctx.strokeRect(headX + gazeShift - 9, headY - 4, 7, 5);\n    ctx.fillRect(headX + gazeShift + 2, headY - 4, 7, 5); ctx.strokeRect(headX + gazeShift + 2, headY - 4, 7, 5);\n  }\n  if (pet.accessoryId === 'pacc_bow') {\n    ctx.fillStyle = '#EC4899';\n    ctx.beginPath(); ctx.arc(headX - 4, headY - 12, 3.5, 0, Math.PI * 2); ctx.arc(headX + 4, headY - 12, 3.5, 0, Math.PI * 2); ctx.fill();\n    ctx.fillStyle = '#FACC15'; ctx.beginPath(); ctx.arc(headX, headY - 12, 2, 0, Math.PI * 2); ctx.fill();\n  }\n  if (pet.accessoryId === 'pacc_wizard') {\n    ctx.fillStyle = '#4F46E5'; ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 1.6;\n    ctx.beginPath(); ctx.moveTo(headX - 10, headY - 10); ctx.lineTo(headX, headY - 26); ctx.lineTo(headX + 10, headY - 10); ctx.closePath(); ctx.fill(); ctx.stroke();\n  }\n  if ((pet.stage >= 4 && variant !== 'royal') || pet.accessoryId === 'pacc_crown') {\n    ctx.fillStyle = '#FACC15'; ctx.strokeStyle = '#2C3E50'; ctx.lineWidth = 1.8;\n    ctx.beginPath();\n    ctx.moveTo(headX - 7, headY - 12); ctx.lineTo(headX - 5, headY - 20); ctx.lineTo(headX, headY - 15); ctx.lineTo(headX + 5, headY - 20); ctx.lineTo(headX + 7, headY - 12);\n    ctx.closePath(); ctx.fill(); ctx.stroke();\n  }\n\n  ctx.restore();\n\n  ctx.save();\n  const isHungry = Math.round(pet.hunger ?? 100) <= 0;\n  const genderSymbol = pet.gender === 'female' ? '♀' : pet.gender === 'male' ? '♂' : '';\n  const stageShort = `GĐ${pet.stage}`;\n  const tagText = `${genderSymbol ? `${genderSymbol} ` : ''}${pet.nickname} ${stageShort} Lv.${pet.level}`;\n  ctx.font = 'bold 8.5px Fredoka, sans-serif';\n  ctx.textAlign = 'center';\n  const tw = Math.max(44, ctx.measureText(tagText).width + 10);\n  const tagY = py - 34 * scale - 12;\n  ctx.fillStyle = 'rgba(255,255,255,0.94)';\n  ctx.strokeStyle = isHungry ? '#DC2626' : c1;\n  ctx.lineWidth = 1.6;\n  ctx.beginPath();\n  ctx.roundRect(px - tw / 2, tagY, tw, 13, 6);\n  ctx.fill();\n  ctx.stroke();\n  ctx.fillStyle = '#1E293B';\n  ctx.fillText(tagText, px, tagY + 9);\n\n  if (isHungry) {\n    const bob = Math.sin(t / 180) * 2;\n    ctx.fillStyle = '#DC2626';\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.lineWidth = 1.5;\n    ctx.beginPath();\n    ctx.roundRect(px - 22, tagY - 16 + bob, 44, 13, 6);\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 8px Fredoka, sans-serif';\n    ctx.fillText('❗ ĐÓI!', px, tagY - 6.5 + bob);\n  }\n  ctx.restore();\n}\n"},{"path":"src/game/scene3d.js","encoding":"utf8","content":"/**\n * ============================================================================\n * B2KS 3D LOW-POLY ISOMETRIC SCENE RENDERER (Three.js via CDN)\n * ============================================================================\n * Module này chuyên dựng toàn bộ thế giới 3D phong cách Low-poly Isometric:\n * - Camera trực giao (OrthographicCamera) nghiêng 45 độ + bóng đổ mềm (Soft Shadows)\n * - Bảng màu Pastel tươi sáng, không viền đen (Zero black outlines)\n * - Khu phố 3D (đường nhựa vạch vàng, vỉa hè lát gạch, cỏ xanh mạ, cây, đèn đường, xe cộ, 15+ công trình)\n * - Nội thất Nhà phố 3D nhiều tầng & Phòng riêng 3D\n * - Nhân vật Chibi 3D đầu to thân nhỏ (12 kiểu tóc, trang phục, bóng tròn, xoay hướng mượt)\n * - Thú cưng 3D đồng hành (10 loài + trứng + tiến hóa + phụ kiện)\n */\n\nimport { buildCatalogItem3D, buildProceduralLabItem3D } from './itemModels3d';\nimport { STREET_WORLD } from './constants.ts';\n\nexport {\n  buildCatalogItem3D,\n  buildProceduralLabItem3D,\n  buildTownhouse3D,\n  buildShopBuilding3D,\n  buildOutdoorLandmark3D,\n  buildChibiCharacter3D,\n  buildForeignNpc3D,\n  buildHelperRobot3D,\n};\nexport const WORLD_SCALE = 0.05; // 100px (2D) = 5 đơn vị 3D\nconst CAMERA_MODE_STORAGE_KEY = 'b2ks_camera_mode_v1';\n\nexport const PASTEL_PALETTE = {\n  grassMain: '#63C13B',\n  grassAlt: '#4FA92B',\n  grassSnow: '#D2F2DC',\n  hillFar: '#72CB4E',\n  sidewalk: '#E3BA91',\n  sidewalkTile: '#BA8552',\n  asphalt: '#334155',\n  roadLine: '#FBBF24',\n  crosswalk: '#F8FAFC',\n  wallCream: '#FFF3DA',\n  wallTeal: '#0D9488',\n  tealLight: '#14B8A6',\n  accentOrange: '#F97316',\n  accentYellow: '#FACC15',\n  accentCoral: '#F43F5E',\n  roofTerracotta: '#DC4C3E',\n  woodWarm: '#B47B48',\n  woodDark: '#7C4D2B',\n  glassDay: '#7DD3FC',\n  glassNight: '#FEF08A',\n  skyDay: '#BAE6FD',\n  skyDawn: '#FDBA74',\n  skySunset: '#FB7185',\n  skyNight: '#050A18',\n  skyRain: '#94A3B8',\n};\n\n// Reusable math objects (zero GC allocations in animation loop)\nlet _THREE = null;\nconst _tmpVec3 = { x: 0, y: 0, z: 0 };\n\nfunction createSeededRandom(seed) {\n  let s = (seed || 1) >>> 0;\n  return () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 4294967296;\n  };\n}\n\n/**\n * Phát hiện GPU phần mềm (SwiftShader/llvmpipe) để tự động tối ưu shadow & pixelRatio\n */\nexport function detectSoftwareWebGL() {\n  try {\n    const probe = document.createElement('canvas');\n    const gl = probe.getContext('webgl2') || probe.getContext('webgl');\n    if (!gl) return true;\n    const ext = gl.getExtension('WEBGL_debug_renderer_info');\n    const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\n    const gpu = String(gl.getParameter(param) || '');\n    gl.getExtension('WEBGL_lose_context')?.loseContext();\n    return /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\n  } catch {\n    return false;\n  }\n}\n\n/**\n * Tạo texture cỏ pastel, vỉa hè lát gạch, mặt đường, sân bóng & bóng tròn mềm\n */\nexport function createProceduralTextures(THREE, maxAnisotropy = 1) {\n  // 1. Grass subtle checkerboard / blades texture\n  const grassCanvas = document.createElement('canvas');\n  grassCanvas.width = 256;\n  grassCanvas.height = 256;\n  const gCtx = grassCanvas.getContext('2d');\n  gCtx.fillStyle = PASTEL_PALETTE.grassMain;\n  gCtx.fillRect(0, 0, 256, 256);\n  gCtx.fillStyle = PASTEL_PALETTE.grassAlt;\n  gCtx.globalAlpha = 0.34;\n  gCtx.fillRect(0, 0, 128, 128);\n  gCtx.fillRect(128, 128, 128, 128);\n  gCtx.globalAlpha = 0.42;\n  for (let i = 0; i < 90; i++) {\n    const gx = (i * 73) % 256;\n    const gy = (i * 137) % 256;\n    gCtx.fillStyle = i % 2 === 0 ? '#7EE054' : '#3E9421';\n    gCtx.fillRect(gx, gy, 4, 8);\n  }\n  const grassTex = new THREE.CanvasTexture(grassCanvas);\n  grassTex.wrapS = THREE.RepeatWrapping;\n  grassTex.wrapT = THREE.RepeatWrapping;\n  grassTex.repeat.set(22, 16);\n  grassTex.colorSpace = THREE.SRGBColorSpace;\n  grassTex.anisotropy = maxAnisotropy;\n\n  // 2. Sidewalk warm light-brown brick paving texture\n  const swCanvas = document.createElement('canvas');\n  swCanvas.width = 256;\n  swCanvas.height = 256;\n  const sCtx = swCanvas.getContext('2d');\n  sCtx.fillStyle = PASTEL_PALETTE.sidewalkTile;\n  sCtx.fillRect(0, 0, 256, 256);\n  const brickShades = ['#E8C29B', '#DFB68C', '#E4BE96', '#D9AE82'];\n  const brickH = 64;\n  const brickW = 128;\n  for (let row = 0; row < 4; row++) {\n    const offsetX = row % 2 === 1 ? brickW / 2 : 0;\n    for (let col = -1; col < 3; col++) {\n      const bx = col * brickW + offsetX;\n      const by = row * brickH;\n      sCtx.fillStyle = brickShades[(row * 3 + col + 4) % brickShades.length];\n      sCtx.fillRect(bx + 3, by + 3, brickW - 6, brickH - 6);\n      sCtx.fillStyle = 'rgba(255, 248, 238, 0.28)';\n      sCtx.fillRect(bx + 4, by + 4, brickW - 8, 5);\n    }\n  }\n  const sidewalkTex = new THREE.CanvasTexture(swCanvas);\n  sidewalkTex.wrapS = THREE.RepeatWrapping;\n  sidewalkTex.wrapT = THREE.RepeatWrapping;\n  sidewalkTex.repeat.set(24, 2.2);\n  sidewalkTex.colorSpace = THREE.SRGBColorSpace;\n  sidewalkTex.anisotropy = maxAnisotropy;\n\n  const sidewalkVTex = sidewalkTex.clone();\n  sidewalkVTex.needsUpdate = true;\n  sidewalkVTex.wrapS = THREE.RepeatWrapping;\n  sidewalkVTex.wrapT = THREE.RepeatWrapping;\n  sidewalkVTex.repeat.set(2.2, 16);\n  sidewalkVTex.colorSpace = THREE.SRGBColorSpace;\n  sidewalkVTex.anisotropy = maxAnisotropy;\n\n  // 3. Soft radial contact shadow disc\n  const shCanvas = document.createElement('canvas');\n  shCanvas.width = 64;\n  shCanvas.height = 64;\n  const shCtx = shCanvas.getContext('2d');\n  const grad = shCtx.createRadialGradient(32, 32, 4, 32, 32, 30);\n  grad.addColorStop(0, 'rgba(15, 23, 42, 0.45)');\n  grad.addColorStop(0.6, 'rgba(15, 23, 42, 0.2)');\n  grad.addColorStop(1, 'rgba(15, 23, 42, 0)');\n  shCtx.fillStyle = grad;\n  shCtx.fillRect(0, 0, 64, 64);\n  const shadowTex = new THREE.CanvasTexture(shCanvas);\n  shadowTex.colorSpace = THREE.SRGBColorSpace;\n\n  // 4. Warm honey-oak wood plank floor texture (shared between house rooms & private room)\n  const woodCanvas = document.createElement('canvas');\n  woodCanvas.width = 128;\n  woodCanvas.height = 128;\n  const wCtx = woodCanvas.getContext('2d');\n  wCtx.fillStyle = '#E5AA6C';\n  wCtx.fillRect(0, 0, 128, 128);\n  wCtx.fillStyle = '#DB9B59';\n  wCtx.fillRect(0, 32, 128, 32);\n  wCtx.fillRect(0, 96, 128, 32);\n  wCtx.fillStyle = '#C47D3B';\n  for (let y = 0; y < 128; y += 32) {\n    wCtx.fillRect(0, y, 128, 2);\n    wCtx.fillRect((y * 2 + 24) % 128, y, 2, 32);\n  }\n  const woodTex = new THREE.CanvasTexture(woodCanvas);\n  woodTex.wrapS = THREE.RepeatWrapping;\n  woodTex.wrapT = THREE.RepeatWrapping;\n  woodTex.repeat.set(8, 5);\n  woodTex.colorSpace = THREE.SRGBColorSpace;\n  woodTex.anisotropy = maxAnisotropy;\n\n  return { grassTex, sidewalkTex, sidewalkVTex, shadowTex, woodTex };\n}\n\n/**\n * Helper tạo vật liệu PBR chuẩn Low-Poly (không viền đen, chia roughness rõ khối)\n */\nexport function createMaterialCache(THREE) {\n  const cache = new Map();\n  return {\n    get(color, opts = {}) {\n      const emInt = opts.emissiveIntensity ?? (opts.emissive ? 0.65 : 0);\n      const sideVal = opts.side ?? THREE.FrontSide;\n      const key = `${color}|${opts.roughness ?? 0.72}|${opts.metalness ?? 0.04}|${opts.emissive ?? 0}|${emInt}|${opts.opacity ?? 1}|${opts.flatShading ? 1 : 0}|${sideVal}`;\n      if (cache.has(key)) return cache.get(key);\n      const mat = new THREE.MeshStandardMaterial({\n        color: new THREE.Color(color),\n        roughness: opts.roughness ?? 0.72,\n        metalness: opts.metalness ?? 0.04,\n        flatShading: opts.flatShading ?? false,\n        transparent: opts.transparent ?? (opts.opacity !== undefined && opts.opacity < 1),\n        opacity: opts.opacity ?? 1,\n        emissive: opts.emissive ? new THREE.Color(opts.emissive) : new THREE.Color(0x000000),\n        emissiveIntensity: emInt,\n        side: sideVal,\n      });\n      cache.set(key, mat);\n      return mat;\n    },\n    disposeAll() {\n      cache.forEach((m) => m.dispose());\n      cache.clear();\n    },\n  };\n}\n\nfunction makeBox(THREE, w, h, d, mat, castShadow = true, receiveShadow = true) {\n  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);\n  m.castShadow = castShadow;\n  m.receiveShadow = receiveShadow;\n  return m;\n}\n\nfunction makeCyl(THREE, rt, rb, h, segs, mat, castShadow = true, receiveShadow = true) {\n  const m = new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, segs), mat);\n  m.castShadow = castShadow;\n  m.receiveShadow = receiveShadow;\n  return m;\n}\n\nfunction makeSphere(THREE, r, ws, hs, mat, castShadow = true, receiveShadow = true) {\n  const m = new THREE.Mesh(new THREE.SphereGeometry(r, ws, hs), mat);\n  m.castShadow = castShadow;\n  m.receiveShadow = receiveShadow;\n  return m;\n}\n\nfunction makeCone(THREE, r, h, radialSegs, mat, castShadow = true, receiveShadow = true) {\n  const m = new THREE.Mesh(new THREE.ConeGeometry(r, h, radialSegs), mat);\n  m.castShadow = castShadow;\n  m.receiveShadow = receiveShadow;\n  return m;\n}\n\n/**\n * Dựng 5 loại cây Low-poly 3D chi tiết (nhiều tán, cành nhánh, bồn cây/quả)\n */\nfunction buildTree3D(THREE, mats, kind, x, z, withPlanter = false) {\n  const group = new THREE.Group();\n  group.position.set(x, 0, z);\n  const rand = createSeededRandom(Math.round(x * 13 + z * 7));\n  const scaleVar = 0.9 + rand() * 0.22;\n  group.scale.setScalar(scaleVar);\n\n  if (withPlanter) {\n    const curb = makeCyl(THREE, 0.95, 1.05, 0.28, 8, mats.get('#CBD5E1', { roughness: 0.78 }), false, true);\n    curb.position.y = 0.14;\n    const soil = makeCyl(THREE, 0.78, 0.78, 0.3, 8, mats.get('#78350F', { roughness: 0.92 }), false, true);\n    soil.position.y = 0.15;\n    group.add(curb, soil);\n  }\n\n  const canopyGroup = new THREE.Group();\n  group.add(canopyGroup);\n  group.userData.canopy = canopyGroup;\n  group.userData.swayPhase = x * 0.2 + z * 0.15;\n\n  if (kind === 'pine') {\n    const trunk = makeCyl(THREE, 0.2, 0.34, 1.4, 8, mats.get('#6D3E21', { roughness: 0.88 }));\n    trunk.position.y = 0.7;\n    group.add(trunk);\n\n    const tiers = [\n      { r: 1.52, h: 1.7, y: 1.85, col: '#15803D' },\n      { r: 1.2, h: 1.55, y: 2.75, col: '#16A34A' },\n      { r: 0.88, h: 1.4, y: 3.6, col: '#22C55E' },\n      { r: 0.52, h: 1.05, y: 4.3, col: '#4ADE80' },\n    ];\n    tiers.forEach((t, idx) => {\n      const cone = new THREE.Mesh(\n        new THREE.ConeGeometry(t.r, t.h, 7),\n        mats.get(t.col, { roughness: 0.76, flatShading: true })\n      );\n      cone.position.y = t.y;\n      cone.rotation.y = idx * 0.45;\n      cone.castShadow = true;\n      cone.receiveShadow = true;\n      canopyGroup.add(cone);\n    });\n  } else if (kind === 'sakura') {\n    const barkMat = mats.get('#5C3A2E', { roughness: 0.88 });\n    const trunk = makeCyl(THREE, 0.22, 0.36, 1.65, 8, barkMat);\n    trunk.position.y = 0.82;\n    const brL = makeCyl(THREE, 0.1, 0.15, 0.95, 6, barkMat);\n    brL.position.set(-0.32, 1.55, 0.1);\n    brL.rotation.z = 0.58;\n    const brR = makeCyl(THREE, 0.1, 0.14, 0.9, 6, barkMat);\n    brR.position.set(0.32, 1.6, -0.08);\n    brR.rotation.z = -0.52;\n    group.add(trunk, brL, brR);\n\n    const puffs = [\n      [0, 2.42, 0, 1.24, '#F472B6'],\n      [-0.82, 2.08, 0.36, 0.85, '#F9A8D4'],\n      [0.8, 2.15, -0.28, 0.88, '#EC4899'],\n      [0.18, 2.95, 0.24, 0.8, '#FBCFE8'],\n      [-0.25, 2.65, -0.58, 0.72, '#F472B6'],\n    ];\n    puffs.forEach(([px, py, pz, pr, col]) => {\n      const sph = makeSphere(THREE, pr, 10, 8, mats.get(col, { roughness: 0.74, flatShading: true }));\n      sph.position.set(px, py, pz);\n      canopyGroup.add(sph);\n    });\n  } else if (kind === 'palm') {\n    const trunkMat = mats.get('#A16207', { roughness: 0.86 });\n    const ringMat = mats.get('#78350F', { roughness: 0.88 });\n    for (let i = 0; i < 5; i++) {\n      const seg = makeCyl(THREE, 0.19 - i * 0.018, 0.24 - i * 0.018, 0.68, 8, i % 2 === 0 ? trunkMat : ringMat);\n      seg.position.set(i * 0.09, 0.34 + i * 0.62, 0);\n      seg.rotation.z = -0.09;\n      group.add(seg);\n    }\n    const crownX = 0.42;\n    const crownY = 3.32;\n    const cocoMat = mats.get('#78350F', { roughness: 0.6 });\n    [[-0.18, 0.16], [0.2, -0.12], [0.02, 0.22]].forEach(([cx, cz]) => {\n      const coco = makeSphere(THREE, 0.17, 8, 6, cocoMat);\n      coco.position.set(crownX + cx, crownY - 0.18, cz);\n      canopyGroup.add(coco);\n    });\n    const frondMat = mats.get('#22C55E', { roughness: 0.68, flatShading: true });\n    const tipMat = mats.get('#4ADE80', { roughness: 0.68, flatShading: true });\n    for (let a = 0; a < 7; a++) {\n      const ang = (a * Math.PI * 2) / 7;\n      const frondGroup = new THREE.Group();\n      frondGroup.position.set(crownX, crownY, 0);\n      frondGroup.rotation.y = ang;\n      const inner = makeBox(THREE, 1.0, 0.1, 0.42, frondMat);\n      inner.position.set(0.5, 0.06, 0);\n      inner.rotation.z = -0.14;\n      const outer = makeBox(THREE, 0.78, 0.08, 0.3, tipMat);\n      outer.position.set(1.22, -0.12, 0);\n      outer.rotation.z = -0.45;\n      frondGroup.add(inner, outer);\n      canopyGroup.add(frondGroup);\n    }\n  } else if (kind === 'orange') {\n    const barkMat = mats.get('#78350F', { roughness: 0.86 });\n    const trunk = makeCyl(THREE, 0.21, 0.34, 1.55, 8, barkMat);\n    trunk.position.y = 0.77;\n    const root = makeCyl(THREE, 0.28, 0.46, 0.35, 7, barkMat);\n    root.position.y = 0.17;\n    group.add(trunk, root);\n\n    const leaves = makeSphere(THREE, 1.24, 10, 8, mats.get('#16A34A', { roughness: 0.76, flatShading: true }));\n    leaves.position.y = 2.28;\n    const sub1 = makeSphere(THREE, 0.86, 9, 7, mats.get('#22C55E', { roughness: 0.74, flatShading: true }));\n    sub1.position.set(0.56, 2.48, 0.38);\n    const sub2 = makeSphere(THREE, 0.72, 9, 7, mats.get('#4ADE80', { roughness: 0.72, flatShading: true }));\n    sub2.position.set(-0.55, 2.35, -0.35);\n    canopyGroup.add(leaves, sub1, sub2);\n\n    const orangeMat = mats.get('#F97316', { roughness: 0.42 });\n    [\n      [-0.82, 2.15, 0.78],\n      [0.78, 2.3, 0.86],\n      [0.12, 2.75, 0.96],\n      [-0.45, 1.98, -0.92],\n      [0.52, 2.82, -0.35],\n    ].forEach(([ox, oy, oz]) => {\n      const fruit = makeSphere(THREE, 0.17, 7, 6, orangeMat);\n      fruit.position.set(ox, oy, oz);\n      canopyGroup.add(fruit);\n    });\n  } else {\n    const barkMat = mats.get('#7C4D2B', { roughness: 0.86 });\n    const trunk = makeCyl(THREE, 0.22, 0.36, 1.65, 8, barkMat);\n    trunk.position.y = 0.82;\n    const br = makeCyl(THREE, 0.1, 0.15, 0.85, 6, barkMat);\n    br.position.set(-0.3, 1.48, 0.2);\n    br.rotation.z = 0.52;\n    group.add(trunk, br);\n\n    const puffs = [\n      [0, 2.32, 0, 1.28, '#16A34A'],\n      [-0.64, 2.52, 0.44, 0.86, '#22C55E'],\n      [0.68, 2.22, -0.32, 0.82, '#15803D'],\n      [0.12, 2.9, 0.12, 0.76, '#4ADE80'],\n    ];\n    puffs.forEach(([px, py, pz, pr, col]) => {\n      const sp = makeSphere(THREE, pr, 10, 8, mats.get(col, { roughness: 0.75, flatShading: true }));\n      sp.position.set(px, py, pz);\n      canopyGroup.add(sp);\n    });\n  }\n\n  return group;\n}\n\n/**\n * Dựng cụm hoa 3D pastel có viền gỗ/đá nhẹ\n */\nfunction buildFlowerCluster3D(THREE, mats, x, z, color, kind) {\n  const g = new THREE.Group();\n  g.position.set(x, 0, z);\n  const bed = makeCyl(THREE, 0.68, 0.75, 0.12, 8, mats.get('#A16207', { roughness: 0.85 }), false, true);\n  bed.position.y = 0.06;\n  const soil = makeCyl(THREE, 0.56, 0.56, 0.14, 8, mats.get('#57534E', { roughness: 0.92 }), false, true);\n  soil.position.y = 0.07;\n  g.add(bed, soil);\n\n  const leafMat = mats.get('#22C55E', { roughness: 0.8 });\n  const stemMat = mats.get('#16A34A', { roughness: 0.8 });\n  const petalCol = kind === 'sunflower' ? '#FACC15' : kind === 'lavender' ? '#A855F7' : color;\n  const petalMat = mats.get(petalCol, { roughness: 0.52 });\n  const centerMat = mats.get(kind === 'sunflower' ? '#78350F' : '#FEF08A', { roughness: 0.45 });\n\n  [[-0.26, 0.14, 0.92], [0.24, -0.16, 1.08], [0.02, 0.25, 0.84], [-0.14, -0.22, 0.9]].forEach(([ox, oz, s]) => {\n    const leaf = makeCyl(THREE, 0.18 * s, 0.22 * s, 0.06, 6, leafMat, false, true);\n    leaf.position.set(ox, 0.14, oz);\n    g.add(leaf);\n\n    const stem = makeCyl(THREE, 0.035, 0.04, 0.34 * s, 5, stemMat, false, false);\n    stem.position.set(ox, 0.14 + 0.17 * s, oz);\n    g.add(stem);\n\n    const head = makeSphere(THREE, 0.15 * s, 7, 6, petalMat, true, false);\n    head.scale.y = 0.65;\n    head.position.set(ox, 0.14 + 0.36 * s, oz);\n    g.add(head);\n\n    const core = makeSphere(THREE, 0.065 * s, 6, 5, centerMat, false, false);\n    core.position.set(ox, 0.14 + 0.42 * s, oz);\n    g.add(core);\n  });\n  return g;\n}\n\n/**\n * Dựng đèn đường 3D cổ điển hiện đại (tay đèn đôi trang trí & chóa phản quang)\n */\nfunction buildStreetLamp3D(THREE, mats, x, z, isNight) {\n  const g = new THREE.Group();\n  g.position.set(x, 0, z);\n\n  const poleMat = mats.get('#1E293B', { roughness: 0.4, metalness: 0.45 });\n  const goldMat = mats.get('#F59E0B', { roughness: 0.35, metalness: 0.5 });\n\n  const base = makeCyl(THREE, 0.22, 0.34, 0.36, 8, poleMat);\n  base.position.y = 0.18;\n  const collar = makeCyl(THREE, 0.16, 0.22, 0.14, 8, goldMat);\n  collar.position.y = 0.42;\n  const post = makeCyl(THREE, 0.08, 0.12, 2.65, 8, poleMat);\n  post.position.y = 1.75;\n  const arm = makeBox(THREE, 0.62, 0.09, 0.09, poleMat);\n  arm.position.set(0.28, 2.98, 0);\n  const brace = makeBox(THREE, 0.42, 0.06, 0.06, goldMat);\n  brace.position.set(0.18, 2.8, 0);\n  brace.rotation.z = 0.65;\n  const cap = new THREE.Mesh(new THREE.ConeGeometry(0.28, 0.2, 8), poleMat);\n  cap.position.set(0.54, 3.02, 0);\n  g.add(base, collar, post, arm, brace, cap);\n\n  const bulb = makeSphere(\n    THREE,\n    0.2,\n    10,\n    8,\n    mats.get(isNight ? '#FEF08A' : '#F8FAFC', {\n      roughness: 0.16,\n      emissive: isNight ? '#FDE047' : null,\n      emissiveIntensity: isNight ? 2.8 : 0,\n    }),\n    false,\n    false\n  );\n  bulb.position.set(0.54, 2.82, 0);\n  g.add(bulb);\n\n  if (isNight) {\n    const lightCone = new THREE.Mesh(\n      new THREE.ConeGeometry(1.85, 2.75, 12, 1, true),\n      new THREE.MeshBasicMaterial({\n        color: 0xfef08a,\n        transparent: true,\n        opacity: 0.11,\n        blending: THREE.AdditiveBlending,\n        depthWrite: false,\n        side: THREE.DoubleSide,\n      })\n    );\n    lightCone.position.set(0.54, 1.52, 0);\n    const outerGlow = new THREE.Mesh(\n      new THREE.CircleGeometry(3.4, 20),\n      new THREE.MeshBasicMaterial({\n        color: 0xfde047,\n        transparent: true,\n        opacity: 0.22,\n        blending: THREE.AdditiveBlending,\n        depthWrite: false,\n      })\n    );\n    outerGlow.rotation.x = -Math.PI / 2;\n    outerGlow.position.set(0.54, 0.168, 0);\n    const innerGlow = new THREE.Mesh(\n      new THREE.CircleGeometry(1.45, 16),\n      new THREE.MeshBasicMaterial({\n        color: 0xfef9c3,\n        transparent: true,\n        opacity: 0.36,\n        blending: THREE.AdditiveBlending,\n        depthWrite: false,\n      })\n    );\n    innerGlow.rotation.x = -Math.PI / 2;\n    innerGlow.position.set(0.54, 0.174, 0);\n    g.add(lightCone, outerGlow, innerGlow);\n  }\n  return g;\n}\n\n/**\n * Dựng ghế băng công viên vỉa hè\n */\nfunction buildParkBench3D(THREE, mats, x, z, rotY = 0) {\n  const g = new THREE.Group();\n  g.position.set(x, 0.14, z);\n  g.rotation.y = rotY;\n  const woodMat = mats.get('#D97706', { roughness: 0.72 });\n  const ironMat = mats.get('#334155', { roughness: 0.45, metalness: 0.45 });\n\n  [-0.85, 0.85].forEach((lx) => {\n    const leg = makeBox(THREE, 0.14, 0.44, 0.62, ironMat);\n    leg.position.set(lx, 0.22, 0);\n    const arm = makeBox(THREE, 0.12, 0.24, 0.56, ironMat);\n    arm.position.set(lx, 0.54, 0.02);\n    g.add(leg, arm);\n  });\n  const seat = makeBox(THREE, 2.0, 0.1, 0.58, woodMat);\n  seat.position.set(0, 0.44, 0.06);\n  const back = makeBox(THREE, 2.0, 0.46, 0.1, woodMat);\n  back.position.set(0, 0.76, -0.22);\n  back.rotation.x = -0.14;\n  g.add(seat, back);\n  return g;\n}\n\n/**\n * Helper dựng cửa sổ có khung trắng, bậu cửa & kính phản chiếu rõ khối\n */\nfunction addFramedWindow3D(THREE, mats, parent, x, y, z, w, h, frameMat, winMat, rotY = 0) {\n  const wg = new THREE.Group();\n  wg.position.set(x, y, z);\n  wg.rotation.y = rotY;\n  const frame = makeBox(THREE, w + 0.22, h + 0.22, 0.14, frameMat, false, true);\n  const pane = makeBox(THREE, w, h, 0.18, winMat, false, false);\n  const mullionV = makeBox(THREE, 0.08, h + 0.04, 0.2, frameMat, false, false);\n  const mullionH = makeBox(THREE, w + 0.04, 0.08, 0.2, frameMat, false, false);\n  const sill = makeBox(THREE, w + 0.34, 0.1, 0.28, frameMat, true, true);\n  sill.position.set(0, -h / 2 - 0.12, 0.08);\n  wg.add(frame, pane, mullionV, mullionH, sill);\n  parent.add(wg);\n  return wg;\n}\n\n/**\n * Helper dựng cửa ra vào thụt khung, bậc tam cấp & tay nắm kim loại\n */\nfunction addRecessedDoor3D(THREE, mats, parent, x, y, z, w, h, frameMat, doorMat, handleMat) {\n  const dg = new THREE.Group();\n  dg.position.set(x, y, z);\n  const frame = makeBox(THREE, w + 0.32, h + 0.18, 0.2, frameMat, true, true);\n  const leaf = makeBox(THREE, w, h, 0.24, doorMat, true, true);\n  const step = makeBox(THREE, w + 0.6, 0.14, 0.65, mats.get('#CBD5E1', { roughness: 0.78 }), true, true);\n  step.position.set(0, -h / 2 + 0.06, 0.32);\n  const handle = makeSphere(THREE, 0.08, 8, 6, handleMat || mats.get('#FACC15', { roughness: 0.25, metalness: 0.65 }), false, false);\n  handle.position.set(w * 0.32, -0.08, 0.16);\n  dg.add(frame, leaf, step, handle);\n  parent.add(dg);\n  return dg;\n}\n\n/**\n * Dựng các khối mái/tháp trang trí cho 4 hình dáng building (classic / modern / pavilion / castle)\n */\nfunction addBuildingShapeDecor3D(THREE, mats, group, shape, width, height, depth) {\n  if (shape === 'modern') {\n    const frameMat = mats.get('#0F172A', { roughness: 0.35, metalness: 0.3 });\n    const ledMat = mats.get('#38BDF8', { roughness: 0.2, emissive: '#38BDF8', emissiveIntensity: 0.75 });\n    const leftFin = makeBox(THREE, 0.45, height + 0.8, depth + 0.4, frameMat);\n    leftFin.position.set(-width / 2 - 0.25, (height + 0.8) / 2, 0);\n    const rightFin = makeBox(THREE, 0.45, height + 0.8, depth + 0.4, frameMat);\n    rightFin.position.set(width / 2 + 0.25, (height + 0.8) / 2, 0);\n    const topLed = makeBox(THREE, width + 1.0, 0.22, depth + 0.6, ledMat);\n    topLed.position.set(0, height + 0.45, 0);\n    group.add(leftFin, rightFin, topLed);\n  } else if (shape === 'pavilion') {\n    const pillarMat = mats.get('#DC2626', { roughness: 0.55 });\n    const goldMat = mats.get('#FACC15', { roughness: 0.35, metalness: 0.45 });\n    [-width / 2 - 0.2, width / 2 + 0.2].forEach((px) => {\n      const col = makeCyl(THREE, 0.18, 0.2, height, 8, pillarMat);\n      col.position.set(px, height / 2, depth / 2 - 0.2);\n      const base = makeBox(THREE, 0.5, 0.25, 0.5, goldMat);\n      base.position.set(px, 0.125, depth / 2 - 0.2);\n      group.add(col, base);\n    });\n    const pagoda = new THREE.Mesh(\n      new THREE.ConeGeometry(Math.max(width, depth) * 0.72, 1.5, 4),\n      mats.get('#EF4444', { roughness: 0.55, flatShading: true })\n    );\n    pagoda.rotation.y = Math.PI / 4;\n    pagoda.position.set(0, height + 0.85, 0);\n    pagoda.castShadow = true;\n    const finial = makeSphere(THREE, 0.24, 8, 8, goldMat);\n    finial.position.set(0, height + 1.65, 0);\n    group.add(pagoda, finial);\n  } else if (shape === 'castle') {\n    const stoneMat = mats.get('#CBD5E1', { roughness: 0.82 });\n    const spireMat = mats.get('#6366F1', { roughness: 0.55, flatShading: true });\n    const flagMat = mats.get('#F43F5E', { roughness: 0.5 });\n    [-width / 2 - 0.35, width / 2 + 0.35].forEach((tx) => {\n      const turret = makeCyl(THREE, 0.65, 0.72, height + 1.4, 8, stoneMat);\n      turret.position.set(tx, (height + 1.4) / 2, 0);\n      const spire = new THREE.Mesh(new THREE.ConeGeometry(0.85, 1.6, 8), spireMat);\n      spire.position.set(tx, height + 2.15, 0);\n      spire.castShadow = true;\n      const flag = makeBox(THREE, 0.6, 0.32, 0.06, flagMat);\n      flag.position.set(tx + 0.3, height + 2.85, 0);\n      group.add(turret, spire, flag);\n    });\n    // Battlements across roof\n    for (let bx = -width / 2 + 0.4; bx <= width / 2 - 0.4; bx += 0.9) {\n      const merlon = makeBox(THREE, 0.45, 0.45, 0.45, stoneMat);\n      merlon.position.set(bx, height + 0.22, depth / 2 - 0.2);\n      group.add(merlon);\n    }\n  }\n}\n\n/**\n * Dựng Nhà Phố Gia Đình 3D (nền đá tương phản, phào chỉ tầng, ban công kính, mái hiên, ống khói & vườn hoa)\n */\nfunction buildTownhouse3D(THREE, mats, x, z, style, shape, isNight) {\n  const g = new THREE.Group();\n  g.position.set(x, 0, z);\n\n  let wallCol = '#FFF8EE';\n  let wainscotCol = '#D97706';\n  let trimCol = '#FB923C';\n  let roofCol = '#C2410C';\n  if (style === 'modern') {\n    wallCol = '#F8FAFC';\n    wainscotCol = '#334155';\n    trimCol = '#0EA5E9';\n    roofCol = '#1E293B';\n  } else if (style === 'pastel') {\n    wallCol = '#ECFDF5';\n    wainscotCol = '#0F766E';\n    trimCol = '#2DD4BF';\n    roofCol = '#EAB308';\n  }\n  if (shape === 'castle') {\n    wallCol = '#F1F5F9';\n    wainscotCol = '#475569';\n    trimCol = '#6366F1';\n    roofCol = '#4338CA';\n  } else if (shape === 'modern') {\n    wallCol = '#F8FAFC';\n    wainscotCol = '#1E293B';\n    trimCol = '#0284C7';\n    roofCol = '#0F172A';\n  } else if (shape === 'pavilion') {\n    wallCol = '#FFFBEB';\n    wainscotCol = '#991B1B';\n    trimCol = '#F59E0B';\n    roofCol = '#DC2626';\n  }\n\n  // Front paved courtyard & stone border curb\n  const yard = makeBox(THREE, 11.2, 0.14, 8.0, mats.get('#E2E8F0', { roughness: 0.85 }), false, true);\n  yard.position.set(0, 0.07, 0.85);\n  const path = makeBox(THREE, 2.2, 0.16, 2.5, mats.get('#CBD5E1', { roughness: 0.82 }), false, true);\n  path.position.set(0, 0.08, 3.6);\n  g.add(yard, path);\n\n  // Main 3-story building body + high-contrast lower plinth\n  const W = 8.2;\n  const H = 8.4;\n  const D = 5.4;\n  const plinth = makeBox(THREE, W + 0.3, 0.9, D + 0.3, mats.get(wainscotCol, { roughness: 0.72 }));\n  plinth.position.set(0, 0.52, -0.4);\n  const body = makeBox(THREE, W, H, D, mats.get(wallCol, { roughness: 0.75 }));\n  body.position.set(0, H / 2 + 0.14, -0.4);\n  g.add(plinth, body);\n\n  // Contrasting side chimney stack\n  const chimney = makeBox(THREE, 0.75, 3.2, 0.75, mats.get('#78350F', { roughness: 0.8 }));\n  chimney.position.set(W / 2 - 1.0, H + 0.6, -1.6);\n  const chimCap = makeBox(THREE, 0.98, 0.2, 0.98, mats.get('#451A03', { roughness: 0.7 }));\n  chimCap.position.set(W / 2 - 1.0, H + 2.2, -1.6);\n  g.add(chimney, chimCap);\n\n  const trimMat = mats.get(trimCol, { roughness: 0.52 });\n  const frameMat = mats.get('#FFFFFF', { roughness: 0.45 });\n  const winMat = mats.get(isNight ? PASTEL_PALETTE.glassNight : PASTEL_PALETTE.glassDay, {\n    roughness: 0.14,\n    metalness: 0.18,\n    emissive: isNight ? '#FBBF24' : null,\n    emissiveIntensity: isNight ? 1.95 : 0,\n  });\n\n  // Floor ledges, glass balconies, and framed windows with flower boxes\n  [2.9, 5.7].forEach((fy) => {\n    const band = makeBox(THREE, W + 0.48, 0.3, D + 0.48, trimMat);\n    band.position.set(0, fy, -0.4);\n    g.add(band);\n\n    const railPostMat = mats.get('#1E293B', { roughness: 0.4, metalness: 0.35 });\n    const balcDeck = makeBox(THREE, 5.6, 0.16, 1.05, trimMat);\n    balcDeck.position.set(0, fy + 0.18, D / 2 - 0.05);\n    const balcGlass = makeBox(THREE, 5.3, 0.62, 0.1, mats.get('#7DD3FC', { roughness: 0.2, transparent: true, opacity: 0.55 }));\n    balcGlass.position.set(0, fy + 0.56, D / 2 + 0.4);\n    const balcRail = makeBox(THREE, 5.6, 0.08, 0.14, railPostMat);\n    balcRail.position.set(0, fy + 0.88, D / 2 + 0.4);\n    g.add(balcDeck, balcGlass, balcRail);\n\n    [-2.05, 0, 2.05].forEach((wx) => {\n      addFramedWindow3D(THREE, mats, g, wx, fy + 1.38, D / 2 - 0.38, 1.35, 1.35, frameMat, winMat);\n    });\n  });\n\n  // Ground floor windows & recessed front door with porch columns\n  [-2.55, 2.55].forEach((wx) => {\n    addFramedWindow3D(THREE, mats, g, wx, 1.55, D / 2 - 0.38, 1.35, 1.35, frameMat, winMat);\n    const planter = makeBox(THREE, 1.45, 0.32, 0.45, mats.get('#92400E', { roughness: 0.8 }));\n    planter.position.set(wx, 0.45, D / 2 - 0.18);\n    const bush = makeSphere(THREE, 0.32, 7, 6, mats.get('#22C55E', { roughness: 0.78 }));\n    bush.scale.set(1.8, 0.75, 0.8);\n    bush.position.set(wx, 0.68, D / 2 - 0.18);\n    g.add(planter, bush);\n  });\n\n  addRecessedDoor3D(\n    THREE,\n    mats,\n    g,\n    0,\n    1.28,\n    D / 2 - 0.38,\n    1.6,\n    2.2,\n    frameMat,\n    mats.get(shape === 'castle' ? '#78350F' : '#6D28D9', { roughness: 0.55 })\n  );\n  const canopy = makeBox(THREE, 2.8, 0.24, 1.25, mats.get(roofCol, { roughness: 0.55 }));\n  canopy.position.set(0, 2.6, D / 2 + 0.16);\n  [-1.15, 1.15].forEach((cx) => {\n    const post = makeCyl(THREE, 0.1, 0.12, 2.4, 8, frameMat);\n    post.position.set(cx, 1.34, D / 2 + 0.62);\n    g.add(post);\n  });\n  g.add(canopy);\n\n  // Roof by shape\n  if (shape === 'modern') {\n    const roof = makeBox(THREE, W + 0.9, 0.65, D + 0.9, mats.get(roofCol, { roughness: 0.45 }));\n    roof.position.set(0, H + 0.45, -0.4);\n    const pent = makeBox(THREE, 4.4, 1.15, 3.2, mats.get('#0284C7', { roughness: 0.4 }));\n    pent.position.set(-0.6, H + 1.28, -0.6);\n    g.add(roof, pent);\n  } else if (shape === 'classic') {\n    const eaves = makeBox(THREE, W + 0.9, 0.28, D + 0.9, trimMat);\n    eaves.position.set(0, H + 0.26, -0.4);\n    const roof = new THREE.Mesh(\n      new THREE.ConeGeometry(6.5, 2.75, 4),\n      mats.get(roofCol, { roughness: 0.64, flatShading: true })\n    );\n    roof.rotation.y = Math.PI / 4;\n    roof.position.set(0, H + 1.7, -0.4);\n    roof.castShadow = true;\n    const dormer = makeBox(THREE, 1.5, 1.1, 1.3, mats.get(wallCol, { roughness: 0.72 }));\n    dormer.position.set(0, H + 1.0, 1.4);\n    g.add(eaves, roof, dormer);\n  }\n  addBuildingShapeDecor3D(THREE, mats, g, shape, W, H + 0.14, D);\n  if (isNight) {\n    const porchLamp = makeSphere(\n      THREE,\n      0.18,\n      8,\n      6,\n      mats.get('#FEF08A', { emissive: '#FDE047', emissiveIntensity: 2.4 }),\n      false,\n      false\n    );\n    porchLamp.position.set(0, 2.38, D / 2 + 0.48);\n    const yardGlow = new THREE.Mesh(\n      new THREE.CircleGeometry(3.8, 18),\n      new THREE.MeshBasicMaterial({\n        color: 0xfbbf24,\n        transparent: true,\n        opacity: 0.2,\n        blending: THREE.AdditiveBlending,\n        depthWrite: false,\n      })\n    );\n    yardGlow.rotation.x = -Math.PI / 2;\n    yardGlow.position.set(0, 0.17, 3.6);\n    g.add(porchLamp, yardGlow);\n  }\n  return g;\n}\n\n/**\n * Dựng 10 công trình cửa hàng / khu chức năng 3D sắc nét, tương phản rõ & thể hiện đúng chức năng\n */\nfunction buildShopBuilding3D(THREE, mats, x, z, type, shape, isNight) {\n  const g = new THREE.Group();\n  g.position.set(x, 0, z);\n\n  // Paved terrace + dark curb rim for contrast\n  const curb = makeBox(THREE, 11.2, 0.1, 8.0, mats.get('#94A3B8', { roughness: 0.85 }), false, true);\n  curb.position.set(0, 0.05, 0.5);\n  const terrace = makeBox(THREE, 10.8, 0.16, 7.6, mats.get('#F1F5F9', { roughness: 0.85 }), false, true);\n  terrace.position.set(0, 0.08, 0.5);\n  g.add(curb, terrace);\n\n  const frameMat = mats.get('#FFFFFF', { roughness: 0.45 });\n  const darkFrameMat = mats.get('#1E293B', { roughness: 0.45 });\n  const winMat = mats.get(isNight ? '#FEF08A' : '#7DD3FC', {\n    roughness: 0.14,\n    metalness: 0.15,\n    emissive: isNight ? '#FBBF24' : null,\n    emissiveIntensity: isNight ? 1.9 : 0,\n  });\n\n  if (type === 'supermarket') {\n    const plinth = makeBox(THREE, 9.6, 0.85, 5.5, mats.get('#C2410C', { roughness: 0.7 }));\n    plinth.position.set(0, 0.55, -0.3);\n    const body = makeBox(THREE, 9.2, 4.1, 5.2, mats.get('#FFFDF5', { roughness: 0.76 }));\n    body.position.set(0, 2.25, -0.3);\n    const fascia = makeBox(\n      THREE,\n      9.8,\n      1.15,\n      5.7,\n      mats.get('#EA580C', { roughness: 0.5, emissive: isNight ? '